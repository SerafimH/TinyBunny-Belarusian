# Belarusian translation of Chapter 4: scripts/scene/scene_day_4.rpy

# game/scripts/scene/scene_day_4.rpy:59
translate belarusian d4_setup_mainloop_7fa4cb7f:

    # "[msg]"
    "[msg]"

# game/scripts/scene/scene_day_4.rpy:271
translate belarusian d4_begin_fox_56afeb5b:

    # "Бяша подсел к нам, озабоченно кусая губу."
    "Бяша падсеў да нас, заклапочана кусаючы губу."

# game/scripts/scene/scene_day_4.rpy:274
translate belarusian d4_begin_fox_89386159:

    # voice "voice/byasha/4day/158To.ogg"
    # Bya "Тошик, ты же почти в этом сраном лесу живёшь..."
    voice "voice/byasha/4day/158To.ogg"
    Bya "Тошык, ты ж амаль у гэтым сраным лесе жывеш..."

# game/scripts/scene/scene_day_4.rpy:280
translate belarusian d4_begin_fox_66a8d62c:

    # voice "voice/byasha/4day/158 V.ogg"
    # Bya "Вчера ничего странного не видел, на?"
    voice "voice/byasha/4day/158 V.ogg"
    Bya "Учора нічога дзіўнага не бачыў, на?"

# game/scripts/scene/scene_day_4.rpy:283
translate belarusian d4_begin_fox_e88f2dea:

    # "Мой ответ был чистейшей ложью:"
    "Мой адказ быў найчысцейшай хлуснёй:"

# game/scripts/scene/scene_day_4.rpy:285
translate belarusian d4_begin_fox_108fdaec:

    # voice "voice/anton/4day/4. N.ogg"
    # Ant "Не-ет."
    voice "voice/anton/4day/4. N.ogg"
    Ant "Не-е."

# game/scripts/scene/scene_day_4.rpy:288
translate belarusian d4_begin_fox_5b60843f:

    # voice "voice/romka/4day/69 Ya.ogg"
    # Rom "Я тоже."
    voice "voice/romka/4day/69 Ya.ogg"
    Rom "Я таксама."

# game/scripts/scene/scene_day_4.rpy:292
translate belarusian d4_begin_fox_99b61351:

    # voice "voice/romka/4day/70 po.ogg"
    # Rom "Повезло, что классуха моим родакам нажаловалась из-за оценок."
    voice "voice/romka/4day/70 po.ogg"
    Rom "Пашанцавала, што класуха маім родакам паскардзілася праз адзнакі."

# game/scripts/scene/scene_day_4.rpy:296
translate belarusian d4_begin_fox_fed9ee63:

    # voice "voice/romka/4day/71 Vot.ogg"
    # Rom "Вот меня и не выпустили вечером на репетицию."
    voice "voice/romka/4day/71 Vot.ogg"
    Rom "Вось мяне і не выпусцілі ўвечары на рэпетыцыю."

# game/scripts/scene/scene_day_4.rpy:300
translate belarusian d4_begin_fox_5bee1f04:

    # voice "voice/romka/4day/72 A.ogg"
    # Rom "А то на месте Катьки оказались бы мы."
    voice "voice/romka/4day/72 A.ogg"
    Rom "А то на месцы Кацькі апынуліся б мы."

# game/scripts/scene/scene_day_4.rpy:305
translate belarusian d4_begin_fox_fe36355d:

    # "Бяша судорожно почесал кадык."
    "Бяша сутаргава пачухаў кадык."

# game/scripts/scene/scene_day_4.rpy:313
translate belarusian d4_begin_fox_1e2cf5ee:

    # voice "voice/byasha/4day/159 E.ogg"
    # Bya "Это... Я чё сказать хотел, на..."
    voice "voice/byasha/4day/159 E.ogg"
    Bya "Гэта... Я што сказаць хацеў, на..."

# game/scripts/scene/scene_day_4.rpy:317
translate belarusian d4_begin_fox_7ed291bb:

    # voice "voice/byasha/4day/160 Ya.ogg"
    # Bya "Я кое-что слышал..."
    voice "voice/byasha/4day/160 Ya.ogg"
    Bya "Я сёе-тое чуў..."

# game/scripts/scene/scene_day_4.rpy:329
translate belarusian d4_begin_fox_f1a4703d:

    # voice "voice/byasha/4day/161 E.ogg"
    # Bya "Этим утром я как обычно в школу шёл. Вдруг слышу плач за деревьями. Девчачий. Сечёте, на?"
    voice "voice/byasha/4day/161 E.ogg"
    Bya "Гэтай раніцай я як звычайна ў школу ішоў. Раптам чую плач за дрэвамі. Дзявочы. Цяміце, на?"

# game/scripts/scene/scene_day_4.rpy:333
translate belarusian d4_begin_fox_af1b4cac:

    # voice "voice/byasha/4day/162 Nu.ogg"
    # Bya "Ну я про Катьку же не знал тогда. Да и знал бы — стрёмно оно, братки..."
    voice "voice/byasha/4day/162 Nu.ogg"
    Bya "Ну я ж пра Кацьку не ведаў тады. Ды і ведаў бы — стрэмна яно, браткі..."

# game/scripts/scene/scene_day_4.rpy:337
translate belarusian d4_begin_fox_7b1cef41:

    # voice "voice/byasha/4day/163 Ut.ogg"
    # Bya "Утро у нас не лучше ночи. Темно, на, как... как в жопе."
    voice "voice/byasha/4day/163 Ut.ogg"
    Bya "Раніца ў нас не лепшая за ноч. Цёмна, на, як... як у дупе."

# game/scripts/scene/scene_day_4.rpy:341
translate belarusian d4_begin_fox_75c8247a:

    # voice "voice/byasha/4day/164 v.ogg"
    # Bya "Вдруг это Катька была, а?"
    voice "voice/byasha/4day/164 v.ogg"
    Bya "Раптам гэта Кацька была, а?"

# game/scripts/scene/scene_day_4.rpy:345
translate belarusian d4_begin_fox_51142bc5:

    # voice "voice/byasha/4day/165A.ogg"
    # Bya "А главное, в месте таком паршивом, на, — в буреломе, что неподалёку от кладбища."
    voice "voice/byasha/4day/165A.ogg"
    Bya "А галоўнае, у месцы такім паршывым, на, — у бураломе, што непадалёк ад могілак."

# game/scripts/scene/scene_day_4.rpy:361
translate belarusian d4_begin_fox_65793266:

    # voice "voice/romka/4day/73 Hor.ogg"
    # Rom "Хорош пургу гнать!"
    voice "voice/romka/4day/73 Hor.ogg"
    Rom "Хопіць пургу гнаць!"

# game/scripts/scene/scene_day_4.rpy:366
translate belarusian d4_begin_fox_22445305:

    # voice "voice/byasha/4day/166 Da.ogg"
    # Bya "Да зуб даю, на! Сам слышал."
    voice "voice/byasha/4day/166 Da.ogg"
    Bya "Ды зуб даю, на! Сам чуў."

# game/scripts/scene/scene_day_4.rpy:370
translate belarusian d4_begin_fox_181669a9:

    # voice "voice/anton/4day/5. A.ogg"
    # Ant "А вы уверены, что Катя действительно пропала?"
    voice "voice/anton/4day/5. A.ogg"
    Ant "А вы ўпэўнены, што Каця сапраўды прапала?"

# game/scripts/scene/scene_day_4.rpy:374
translate belarusian d4_begin_fox_032bf4e4:

    # voice "voice/romka/4day/74Vo.ogg"
    # Rom "Вон Лилия Павловна, Катькина матушка, даже на работу не пришла."
    voice "voice/romka/4day/74Vo.ogg"
    Rom "Вунь Лілія Паўлаўна, Кацькіна матуля, нават на працу не прыйшла."

# game/scripts/scene/scene_day_4.rpy:394
translate belarusian d4_begin_fox_332bff32:

    # voice "voice/byasha/4day/167 S.ogg"
    # Bya "Слетела контрольная, на."
    voice "voice/byasha/4day/167 S.ogg"
    Bya "Зляцела кантрольная, на."

# game/scripts/scene/scene_day_4.rpy:412
translate belarusian d4_begin_fox_b2cec123:

    # voice "voice/byasha/4day/168 Ka.ogg"
    # Bya "Как пить дать, пацаны, это Катька в тайге стонала."
    voice "voice/byasha/4day/168 Ka.ogg"
    Bya "Як піць даць, пацаны, гэта Кацька ў тайзе стагнала."

# game/scripts/scene/scene_day_4.rpy:416
translate belarusian d4_begin_fox_3ad865bf:

    # voice "voice/byasha/4day/169 A.ogg"
    # Bya "А значит, и до неё маньячелло добрался!"
    voice "voice/byasha/4day/169 A.ogg"
    Bya "А значыць, і да яе маньячэла дабраўся!"

# game/scripts/scene/scene_day_4.rpy:419
translate belarusian d4_begin_fox_b67c713f:

    # "Я вспомнил Катю — такую красивую и такую подлую."
    "Я ўспомніў Кацю — такую прыгожую і такую подлую."

# game/scripts/scene/scene_day_4.rpy:425
translate belarusian d4_begin_fox_9c6ac6ac:

    # "Первая девочка в классе, у которой на зависть подружкам успела округлиться грудь."
    "Першая дзяўчынка ў класе, у якой на зайздрасць сяброўкам паспелі акругліцца грудзі."

# game/scripts/scene/scene_day_4.rpy:426
translate belarusian d4_begin_fox_7d4cd672:

    # "Первая сплетница, змея и гадина."
    "Першая пляткарка, змяя і гадзюка."

# game/scripts/scene/scene_day_4.rpy:448
translate belarusian d4_begin_fox_618afe2c:

    # "Бяша загибал пальцы:"
    "Бяша загінаў пальцы:"

# game/scripts/scene/scene_day_4.rpy:450
translate belarusian d4_begin_fox_d9f6ea58:

    # voice "voice/byasha/4day/170 Se.ogg"
    # Bya "Сенечка, Вова, Семён, Катя... Четыре человека, на!"
    voice "voice/byasha/4day/170 Se.ogg"
    Bya "Сенечка, Вова, Сямён, Каця... Чатыры чалавекі, на!"

# game/scripts/scene/scene_day_4.rpy:456
translate belarusian d4_begin_fox_e2307988:

    # "Рома хлопнул ладонями по парте."
    "Рома пляснуў далонямі па парце."

# game/scripts/scene/scene_day_4.rpy:462
translate belarusian d4_begin_fox_4b6b9b2a:

    # voice "voice/romka/4day/75 Ta.ogg"
    # Rom "Так, пацаны, отныне смотреть в оба."
    voice "voice/romka/4day/75 Ta.ogg"
    Rom "Так, пацаны, з гэтага часу глядзець ва ўсе вочы."

# game/scripts/scene/scene_day_4.rpy:466
translate belarusian d4_begin_fox_04442c78:

    # voice "voice/romka/4day/76 Da.ogg"
    # Rom "Далеко друг от друга не отходим, как в дурацких ужастиках."
    voice "voice/romka/4day/76 Da.ogg"
    Rom "Далёка адзін ад аднаго не адыходзім, як у дурных фільмах жахаў."

# game/scripts/scene/scene_day_4.rpy:473
translate belarusian d4_begin_fox_fc7b27a2:

    # voice "voice/romka/4day/77 Na.ogg"
    # Rom "На остальных мне плевать, но вас я в обиду не дам."
    voice "voice/romka/4day/77 Na.ogg"
    Rom "На астатніх мне пляваць, але вас я ў крыўду не дам."

# game/scripts/scene/scene_day_4.rpy:480
translate belarusian d4_begin_fox_89c0bd08:

    # voice "voice/romka/4day/78 Kak.ogg"
    # Rom "Как и Полинку..."
    voice "voice/romka/4day/78 Kak.ogg"
    Rom "Як і Палінку..."

# game/scripts/scene/scene_day_4.rpy:486
translate belarusian d4_begin_fox_f8b3341d:

    # "Пусть у вас с ней всё получится."
    "Няхай у вас з ёй усё атрымаецца."

# game/scripts/scene/scene_day_4.rpy:487
translate belarusian d4_begin_fox_f87ba3e1:

    # "Я и думать забыл, что мне когда-то нравилась Полина."
    "Я і думаць забыў, што мне калісьці падабалася Паліна."

# game/scripts/scene/scene_day_4.rpy:488
translate belarusian d4_begin_fox_ad1e32ed:

    # "После вчерашней ночи мои мысли занимала лишь одна девочка – Алиса."
    "Пасля ўчорашняй ночы мае думкі займала толькі адна дзяўчынка — Аліса."

# game/scripts/scene/scene_day_4.rpy:517
translate belarusian d4_begin_fox_f11ae9bd:

    # "Ребята направились в столовую, а я остался царапать ручкой в тетради, выводить пики сосен и две крошечные фигурки, летящие между кронами и полной луной."
    "Хлопцы накіраваліся ў сталовую, а я застаўся драпаць ручкай у сшытку, выводзіць пікі соснаў і дзве малюсенькія фігуркі, што ляцяць паміж кронамі і поўным месяцам."

# game/scripts/scene/scene_day_4.rpy:524
translate belarusian d4_begin_fox_f6fb7f8c:

    # "По предплечьям бежали ордой мурашки, ретиво заскакивая за шиворот."
    "Па перадплеччах беглі ардой мурашкі, заўзята заскокваючы за каўнер."

# game/scripts/scene/scene_day_4.rpy:530
translate belarusian d4_begin_fox_9ae3dd81:

    # "И было вроде так просто взмыть к небесам... Но что-то злое гнуло до земли."
    "І было нібыта так проста ўзвіцца да нябёсаў... Але нешта злое гнула да зямлі."

# game/scripts/scene/scene_day_4.rpy:534
translate belarusian d4_begin_fox_98a408fd:

    # "То ли вес украденного перстня, то ли тяжёлые взгляды исчезнувших детей на доске."
    "Ці то вага скрадзенага пярсцёнка, ці то цяжкія позіркі зніклых дзяцей на дошцы."

# game/scripts/scene/scene_day_4.rpy:538
translate belarusian d4_begin_fox_92e56486:

    # "Кто-то в посёлке был явно к этому причастен, скрывал нечто ужасное за благочестивой маской."
    "Нехта ў пасёлку быў відавочна да гэтага датычны, хаваў нешта жахлівае за набожнай маскай."

# game/scripts/scene/scene_day_4.rpy:554
translate belarusian d4_begin_fox_0b267328:

    # voice "voice/Polina/4day/134 R.ogg"
    # Pol "Рисуешь?"
    voice "voice/Polina/4day/134 R.ogg"
    Pol "Малюеш?"

# game/scripts/scene/scene_day_4.rpy:561
translate belarusian d4_begin_fox_e6134f99:

    # "Я стыдливо прикрыл тетрадь, будто было что-то зазорное в фигурках над лесом."
    "Я сарамліва прыкрыў сшытак, быццам было нешта ганебнае ў фігурках над лесам."

# game/scripts/scene/scene_day_4.rpy:581
translate belarusian d4_begin_polina_1734efad:

    # voice "voice/Polina/4day/Ya.ogg"
    # Pol "Я сама не поверила, но Лилия Павловна на работу не вышла."
    voice "voice/Polina/4day/Ya.ogg"
    Pol "Я сама не паверыла, але Лілія Паўлаўна на працу не выйшла."

# game/scripts/scene/scene_day_4.rpy:585
translate belarusian d4_begin_polina_41d79bf7:

    # voice "voice/Polina/4day/Kon.ogg"
    # Pol "Контрольная отменяется."
    voice "voice/Polina/4day/Kon.ogg"
    Pol "Кантрольная адмяняецца."

# game/scripts/scene/scene_day_4.rpy:594
translate belarusian d4_begin_polina_b67c713f:

    # "Я вспомнил Катю — такую красивую и такую подлую."
    "Я ўспомніў Кацю — такую прыгожую і такую подлую."

# game/scripts/scene/scene_day_4.rpy:601
translate belarusian d4_begin_polina_77575402:

    # "Катя. Первая девочка в классе, у которой на зависть подружкам успела округлиться грудь."
    "Каця. Першая дзяўчынка ў класе, у якой на зайздрасць сяброўкам паспелі акругліцца грудзі."

# game/scripts/scene/scene_day_4.rpy:602
translate belarusian d4_begin_polina_7d4cd672:

    # "Первая сплетница, змея и гадина."
    "Першая пляткарка, змяя і гадзюка."

# game/scripts/scene/scene_day_4.rpy:613
translate belarusian d4_begin_polina_078a6014:

    # "Я продолжил царапать ручкой в тетради, выводить пики сосен и две крошечные фигурки, летящие между кронами и полной луной."
    "Я працягнуў драпаць ручкай у сшытку, выводзіць пікі соснаў і дзве малюсенькія фігуркі, што ляцяць паміж кронамі і поўным месяцам."

# game/scripts/scene/scene_day_4.rpy:614
translate belarusian d4_begin_polina_f6fb7f8c:

    # "По предплечьям бежали ордой мурашки, ретиво заскакивая за шиворот."
    "Па перадплеччах беглі ардой мурашкі, заўзята заскокваючы за каўнер."

# game/scripts/scene/scene_day_4.rpy:620
translate belarusian d4_begin_polina_9ae3dd81:

    # "И было вроде так просто взмыть к небесам... Но что-то злое гнуло до земли."
    "І было нібыта так проста ўзвіцца да нябёсаў... Але нешта злое гнула да зямлі."

# game/scripts/scene/scene_day_4.rpy:627
translate belarusian d4_begin_polina_98a408fd:

    # "То ли вес украденного перстня, то ли тяжёлые взгляды исчезнувших детей на доске."
    "Ці то вага скрадзенага пярсцёнка, ці то цяжкія позіркі зніклых дзяцей на дошцы."

# game/scripts/scene/scene_day_4.rpy:628
translate belarusian d4_begin_polina_92e56486:

    # "Кто-то в посёлке был явно к этому причастен, скрывал нечто ужасное за благочестивой маской."
    "Нехта ў пасёлку быў відавочна да гэтага датычны, хаваў нешта жахлівае за набожнай маскай."

# game/scripts/scene/scene_day_4.rpy:641
translate belarusian d4_begin_polina_c08d8baa:

    # voice "voice/Polina/4day/Achto.ogg"
    # Pol "А что ты рисуешь?"
    voice "voice/Polina/4day/Achto.ogg"
    Pol "А што ты малюеш?"

# game/scripts/scene/scene_day_4.rpy:651
translate belarusian d4_begin_polina_e6134f99:

    # "Я стыдливо прикрыл тетрадь, будто было что-то зазорное в фигурках над лесом."
    "Я сарамліва прыкрыў сшытак, быццам было нешта ганебнае ў фігурках над лесам."

# game/scripts/scene/scene_day_4.rpy:662
translate belarusian d4_polkatya_general_b8abc601:

    # voice "voice/anton/4day/8. Da.ogg"
    # Ant "Да ничего... Так, дурака валяю."
    voice "voice/anton/4day/8. Da.ogg"
    Ant "Ды нічога... Так, дурня валяю."

# game/scripts/scene/scene_day_4.rpy:670
translate belarusian d4_polkatya_general_d06678e2:

    # "Полина облокотилась на парту."
    "Паліна абаперлася локцямі на парту."

# game/scripts/scene/scene_day_4.rpy:671
translate belarusian d4_polkatya_general_67f3ec94:

    # "Я уже и забыл, какая она лёгкая и изящная, словно скрипка."
    "Я ўжо і забыў, якая яна лёгкая і вытанчаная, нібы скрыпка."

# game/scripts/scene/scene_day_4.rpy:674
translate belarusian d4_polkatya_general_7573a2db:

    # "Гнев и ярость, которые обуревали меня вчера во время телефонного разговора - отступили, спрятались в норе. Я уже забыл обижаться на Полину."
    "Гнеў і лютасць, якія апаноўвалі мяне ўчора падчас тэлефоннай размовы, — адступілі, схаваліся ў нары. Я ўжо забыў крыўдзіцца на Паліну."

# game/scripts/scene/scene_day_4.rpy:677
translate belarusian d4_polkatya_general_5633ba56:

    # "Вот бы она тоже могла прыгать с нами, сняв маску притворной повседневности."
    "Вось бы яна таксама магла скакаць з намі, зняўшы маску ўдаванай паўсядзённасці."

# game/scripts/scene/scene_day_4.rpy:688
translate belarusian d4_polkatya_general_172f08c6:

    # "Я улыбнулся, представляя, как юбочка Полины порхает на ветру, как звёзды искрятся со всех сторон, и она удивлённо спрашивает, не сон ли это."
    "Я ўсміхнуўся, уяўляючы, як спаднічка Паліны лунае на ветры, як зоркі іскрацца з усіх бакоў, і яна здзіўлена пытаецца, ці не сон гэта."

# game/scripts/scene/scene_day_4.rpy:689
translate belarusian d4_polkatya_general_1e553341:

    # "А я отвечаю, мол, какая разница..."
    "А я адказваю, маўляў, якая розніца..."

# game/scripts/scene/scene_day_4.rpy:695
translate belarusian d4_polkatya_general_f701ab98:

    # "Лицо Полины снова помрачнело."
    "Твар Паліны зноў спахмурнеў."

# game/scripts/scene/scene_day_4.rpy:704
translate belarusian d4_polkatya_general_66d0b8f8:

    # voice "voice/Polina/4day/134 Uze.ogg"
    # Pol "Уже слышал про Катю?"
    voice "voice/Polina/4day/134 Uze.ogg"
    Pol "Ужо чуў пра Кацю?"

# game/scripts/scene/scene_day_4.rpy:708
translate belarusian d4_polkatya_general_3075cc93:

    # voice "voice/anton/4day/9. Uzas.ogg"
    # Ant "Ужасно."
    voice "voice/anton/4day/9. Uzas.ogg"
    Ant "Жахліва."

# game/scripts/scene/scene_day_4.rpy:713
translate belarusian d4_polkatya_general_2c7f0383:

    # voice "voice/Polina/4day/135 Da.ogg"
    # Pol "Да."
    voice "voice/Polina/4day/135 Da.ogg"
    Pol "Так."

# game/scripts/scene/scene_day_4.rpy:719
translate belarusian d4_polkatya_general_af77b4e4:

    # voice "voice/Polina/4day/01 Uz.ogg"
    # Pol "Ужасно ещё и то, что Катю мне жалеть сложно."
    voice "voice/Polina/4day/01 Uz.ogg"
    Pol "Жахліва яшчэ і тое, што Кацю мне шкадаваць складана."

# game/scripts/scene/scene_day_4.rpy:724
translate belarusian d4_polkatya_general_e321a007:

    # voice "voice/Polina/4day/02 Ya.ogg"
    # Pol "Я правда ищу в себе сострадание, но вспоминаю её поступки, и..."
    voice "voice/Polina/4day/02 Ya.ogg"
    Pol "Я сапраўды шукаю ў сабе спагаду, але ўспамінаю яе ўчынкі, і..."

# game/scripts/scene/scene_day_4.rpy:728
translate belarusian d4_polkatya_general_53c1f636:

    # "Полина покачала головой."
    "Паліна пахітала галавой."

# game/scripts/scene/scene_day_4.rpy:733
translate belarusian d4_polkatya_general_1ddd38e2:

    # voice "voice/Polina/4day/03YaCh.ogg"
    # Pol "Я чудовище, да?"
    voice "voice/Polina/4day/03YaCh.ogg"
    Pol "Я пачвара, так?"

# game/scripts/scene/scene_day_4.rpy:751
translate belarusian d4_polkatya_general_bef1a361:

    # "«Нет, - подумал я, - ты одна из самых красивых девушек, кого я встречал.»"
    "«Не, — падумаў я, — ты адна з самых прыгожых дзяўчат, якіх я сустракаў»."

# game/scripts/scene/scene_day_4.rpy:789
translate belarusian d4_polkatya_general_978c03be:

    # "«Нет, - подумал я, - ты одна из самых красивых девушек, кого я встречал. Но для меня, увы, ты только на втором месте.»"
    "«Не, — падумаў я, — ты адна з самых прыгожых дзяўчат, якіх я сустракаў. Але для мяне, на жаль, ты толькі на другім месцы»."

# game/scripts/scene/scene_day_4.rpy:791
translate belarusian d4_polkatya_general_ca23278e:

    # "Но вслух ничего не сказал."
    "Але ўголас нічога не сказаў."

# game/scripts/scene/scene_day_4.rpy:817
translate belarusian d4_polkatya_general_50d10bd5:

    # voice "voice/Polina/4day/04 Plo.ogg"
    # Pol "Плохо, наверное, что исчезновение анкеты расстроило меня больше, чем пропажа одноклассницы."
    voice "voice/Polina/4day/04 Plo.ogg"
    Pol "Дрэнна, напэўна, што знікненне анкеты засмуціла мяне больш, чым прапажа аднакласніцы."

# game/scripts/scene/scene_day_4.rpy:823
translate belarusian d4_polkatya_general_ea8d365f:

    # "Ноздри словно уловили запах конфет, древесной смолы и фейерверков."
    "Ноздры быццам улавілі пах цукерак, дрэўнай смалы і феерверкаў."

# game/scripts/scene/scene_day_4.rpy:829
translate belarusian d4_polkatya_general_e112d4cb:

    # voice "voice/anton/4day/10. T.ogg"
    # Ant "Ты потеряла анкету?"
    voice "voice/anton/4day/10. T.ogg"
    Ant "Ты згубіла анкету?"

# game/scripts/scene/scene_day_4.rpy:839
translate belarusian d4_polkatya_general_1105aed3:

    # voice "voice/Polina/4day/05da Ektoto.ogg"
    # Pol "Да. И кто-то сейчас читает чужие секреты."
    voice "voice/Polina/4day/05da Ektoto.ogg"
    Pol "Так. І нехта цяпер чытае чужыя сакрэты."

# game/scripts/scene/scene_day_4.rpy:842
translate belarusian d4_polkatya_general_8b1cd88e:

    # "«Лес», - подумал я, вообразив, как скрюченные ветви поддевают страницы и листают их, трогая детский почерк обледенелыми сучками."
    "«Лес», — падумаў я, уявіўшы, як скарлючаныя галіны падчэпліваюць старонкі і гартаюць іх, кранаючы дзіцячы почырк абледзянелымі сучкамі."

# game/scripts/scene/scene_day_4.rpy:845
translate belarusian d4_polkatya_general_5e060315:

    # voice "voice/Polina/4day/06 Na.ogg"
    # Pol "Надеюсь, её найдут."
    voice "voice/Polina/4day/06 Na.ogg"
    Pol "Спадзяюся, яе знойдуць."

# game/scripts/scene/scene_day_4.rpy:848
translate belarusian d4_polkatya_general_ff825d4f:

    # "Я не понял, про Катю она говорит или про тетрадку."
    "Я не зразумеў, пра Кацю яна кажа ці пра сшытак."

# game/scripts/scene/scene_day_4.rpy:851
translate belarusian d4_polkatya_general_c861f3d5:

    # "Хотел уточнить, но увидел, что Полина пристально меня изучает."
    "Хацеў удакладніць, але ўбачыў, што Паліна пільна мяне вывучае."

# game/scripts/scene/scene_day_4.rpy:872
translate belarusian d4_polkatya_general_2882cda2:

    # voice "voice/anton/4day/11. Cht.ogg"
    # Ant "Что?"
    voice "voice/anton/4day/11. Cht.ogg"
    Ant "Што?"

# game/scripts/scene/scene_day_4.rpy:875
translate belarusian d4_polkatya_general_35977029:

    # voice "voice/Polina/4day/07 Ti.ogg"
    # Pol "Ты будто изменился."
    voice "voice/Polina/4day/07 Ti.ogg"
    Pol "Ты быццам змяніўся."

# game/scripts/scene/scene_day_4.rpy:878
translate belarusian d4_polkatya_general_c8d3cc76:

    # "Я пригладил волосы удивлённо."
    "Я здзіўлена прыгладзіў валасы."

# game/scripts/scene/scene_day_4.rpy:880
translate belarusian d4_polkatya_general_904a0f91:

    # voice "voice/anton/4day/12. Pros.ogg"
    # Ant "Просто не выспался."
    voice "voice/anton/4day/12. Pros.ogg"
    Ant "Проста не выспаўся."

# game/scripts/scene/scene_day_4.rpy:886
translate belarusian d4_polkatya_general_00c6c6b0:

    # voice "voice/Polina/4day/08 Se.ogg"
    # Pol "Сегодня ты точно какая-то другая мелодия. Очень древняя, таинственная..."
    voice "voice/Polina/4day/08 Se.ogg"
    Pol "Сёння ты нібы нейкая іншая мелодыя. Вельмі старажытная, таямнічая..."

# game/scripts/scene/scene_day_4.rpy:889
translate belarusian d4_polkatya_general_6bb1fed0:

    # "Я подумал о флейте, струящейся между косматыми деревьями."
    "Я падумаў пра флейту, што бруіцца паміж касматымі дрэвамі."

# game/scripts/scene/scene_day_4.rpy:898
translate belarusian d4_polkatya_general_ce497e09:

    # voice "voice/Polina/4day/09 Nad.ogg"
    # Pol "Надеюсь, ты никому не рассказал про наш вчерашний разговор?"
    voice "voice/Polina/4day/09 Nad.ogg"
    Pol "Спадзяюся, ты нікому не расказаў пра нашу ўчорашнюю размову?"

# game/scripts/scene/scene_day_4.rpy:902
translate belarusian d4_polkatya_general_e3f1692a:

    # voice "voice/anton/4day/13. Cto.ogg"
    # Ant "Что ты!"
    voice "voice/anton/4day/13. Cto.ogg"
    Ant "Што ты!"

# game/scripts/scene/scene_day_4.rpy:904
translate belarusian d4_polkatya_general_f796fec8:

    # "Она кивнула, словно признаваясь, что полностью мне доверяет."
    "Яна кіўнула, нібы прызнаючыся, што цалкам мне давярае."

# game/scripts/scene/scene_day_4.rpy:905
translate belarusian d4_polkatya_general_7ea31629:

    # "Я не знал, заслуживаю ли такого доверия."
    "Я не ведаў, ці заслугоўваю такога даверу."

# game/scripts/scene/scene_day_4.rpy:910
translate belarusian d4_polkatya_general_f029d401:

    # voice "voice/Polina/4day/15 A moz.ogg"
    # Pol "А может, погуляем после уроков?"
    voice "voice/Polina/4day/15 A moz.ogg"
    Pol "А можа, пагуляем пасля ўрокаў?"

# game/scripts/scene/scene_day_4.rpy:915
translate belarusian d4_polkatya_general_ae27c1e8:

    # voice "voice/Polina/4day/16 Ded.ogg"
    # Pol "Дедушка чувствует себя лучше — я могу задержаться вечером."
    voice "voice/Polina/4day/16 Ded.ogg"
    Pol "Дзядуля пачуваецца лепш — я магу затрымацца ўвечары."

# game/scripts/scene/scene_day_4.rpy:924
translate belarusian d4_polkatya_general_34766af2:

    # "Её волосы каскадом спадали на плечи и так удивительно пахли, что я взлетал без всяких чар к переливающимся звёздам какого-то внутреннего космоса."
    "Яе валасы каскадам спадалі на плечы і так дзівосна пахлі, што я ўзлятаў без усялякіх чараў да пераліўных зорак нейкага ўнутранага космасу."

# game/scripts/scene/scene_day_4.rpy:966
translate belarusian d4_school_polina_437c4a4a:

    # "Вдруг я уловил на себе пристальный взгляд Бяши. Он явно следил за нами."
    "Раптам я ўлавіў на сабе пільны погляд Бяшы. Ён відавочна сачыў за намі."

# game/scripts/scene/scene_day_4.rpy:971
translate belarusian d4_school_polina_05fee426:

    # "Я снял очки, чтобы не видеть его гадкую ухмылку."
    "Я зняў акуляры, каб не бачыць яго брыдкай пасмешкі."

# game/scripts/scene/scene_day_4.rpy:990
translate belarusian d4_school_polina_3bb2ed56:

    # "Но перед внутренним взором заблестел Ромкин нож — и мои ладони моментально вспотели."
    "Але перад унутраным зрокам заблішчаў Ромкаў нож — і мае далоні імгненна спацелі."

# game/scripts/scene/scene_day_4.rpy:994
translate belarusian d4_school_polina_830e9a79:

    # voice "voice/Polina/4day/10 Op.ogg"
    # Pol "Опять уснул?"
    voice "voice/Polina/4day/10 Op.ogg"
    Pol "Зноў заснуў?"

# game/scripts/scene/scene_day_4.rpy:1015
translate belarusian d4_school_polina_312e021f:

    # voice "voice/anton/4day/14. Po.ogg"
    # Ant "Полина..."
    voice "voice/anton/4day/14. Po.ogg"
    Ant "Паліна..."

# game/scripts/scene/scene_day_4.rpy:1017
translate belarusian d4_school_polina_d00c2cc0:

    # "«{i}Расскажи ей{/i}, - шепнул голос в голове, - {i}а там будь что будет{/i}»."
    "«{i}Раскажы ёй{/i}, — шапнуў голас у галаве, — {i}а там будзь што будзе{/i}»."

# game/scripts/scene/scene_day_4.rpy:1018
translate belarusian d4_school_polina_eb867b4f:

    # voice "voice/anton/4day/15. k.ogg"
    # Ant "Кажется, Ромка на тебя глаз положил."
    voice "voice/anton/4day/15. k.ogg"
    Ant "Здаецца, Ромка на цябе вока паклаў."

# game/scripts/scene/scene_day_4.rpy:1022
translate belarusian d4_school_polina_a643e3f7:

    # voice "voice/Polina/4day/11 Du.ogg"
    # Pol "Думаешь, я не знаю?"
    voice "voice/Polina/4day/11 Du.ogg"
    Pol "Думаеш, я не ведаю?"

# game/scripts/scene/scene_day_4.rpy:1025
translate belarusian d4_school_polina_7b499e9a:

    # voice "voice/anton/4day/16. Ot.ogg"
    # Ant "Откуда?"
    voice "voice/anton/4day/16. Ot.ogg"
    Ant "Адкуль?"

# game/scripts/scene/scene_day_4.rpy:1029
translate belarusian d4_school_polina_e7d9f45b:

    # voice "voice/Polina/4day/12 Sch.ogg"
    # Pol "Считай, это моя, интуиция."
    voice "voice/Polina/4day/12 Sch.ogg"
    Pol "Лічы, гэта мая інтуіцыя."

# game/scripts/scene/scene_day_4.rpy:1033
translate belarusian d4_school_polina_8ffc70ae:

    # voice "voice/Polina/4day/13 Pya.ogg"
    # Pol "Только вот Пятифанов мне безразличен."
    voice "voice/Polina/4day/13 Pya.ogg"
    Pol "Толькі вось Пяціфанаў мне абыякавы."

# game/scripts/scene/scene_day_4.rpy:1036
translate belarusian d4_school_polina_f6c60b77:

    # "От радости я осмелел."
    "Ад радасці я асмялеў."

# game/scripts/scene/scene_day_4.rpy:1037
translate belarusian d4_school_polina_95cbf125:

    # voice "voice/anton/4day/17. Mn.ogg"
    # Ant "Мне кажется, ему не хватит мозгов, чтобы завоевать тебя."
    voice "voice/anton/4day/17. Mn.ogg"
    Ant "Мне здаецца, яму не хопіць мазгоў, каб заваяваць цябе."

# game/scripts/scene/scene_day_4.rpy:1041
translate belarusian d4_school_polina_ff3d998a:

    # "Полина пленительно улыбнулась."
    "Паліна чароўна ўсміхнулася."

# game/scripts/scene/scene_day_4.rpy:1044
translate belarusian d4_school_polina_b83f8c68:

    # voice "voice/Polina/4day/14Ho.ogg"
    # Pol "Хорошо, что у меня есть ты."
    voice "voice/Polina/4day/14Ho.ogg"
    Pol "Добра, што ў мяне ёсць ты."

# game/scripts/scene/scene_day_4.rpy:1048
translate belarusian d4_school_polina_af0bea69:

    # voice "voice/Polina/4day/15 A.ogg"
    # Pol "А может, погуляем после уроков?"
    voice "voice/Polina/4day/15 A.ogg"
    Pol "А можа, пагуляем пасля ўрокаў?"

# game/scripts/scene/scene_day_4.rpy:1052
translate belarusian d4_school_polina_a74474dc:

    # voice "voice/Polina/4day/16 De.ogg"
    # Pol "Дедушка чувствует себя лучше — я могу задержаться вечером."
    voice "voice/Polina/4day/16 De.ogg"
    Pol "Дзядуля пачуваецца лепш — я магу затрымацца ўвечары."

# game/scripts/scene/scene_day_4.rpy:1061
translate belarusian d4_school_polina_44e3b345:

    # "Мой ответ был равносилен самоубийству."
    "Мой адказ быў раўнасільны самагубству."

# game/scripts/scene/scene_day_4.rpy:1064
translate belarusian d4_school_polina_f1afa199:

    # voice "voice/anton/4day/20. Ko.ogg"
    # Ant "Конечно, давай!"
    voice "voice/anton/4day/20. Ko.ogg"
    Ant "Канечне, давай!"

# game/scripts/scene/scene_day_4.rpy:1070
translate belarusian d4_school_polina_4f77a0ae:

    # voice "voice/Polina/4day/17 To.ogg"
    # Pol "Тогда до встречи."
    voice "voice/Polina/4day/17 To.ogg"
    Pol "Тады да сустрэчы."

# game/scripts/scene/scene_day_4.rpy:1077
translate belarusian d4_school_polina_4704f65d:

    # "Она привстала и снова посмотрела на меня своими пронзительными глазами."
    "Яна прыўстала і зноў паглядзела на мяне сваімі пранізлівымі вачыма."

# game/scripts/scene/scene_day_4.rpy:1078
translate belarusian d4_school_polina_34598843:

    # "Пробормотала, гадая:"
    "Прамармытала, гадаючы:"

# game/scripts/scene/scene_day_4.rpy:1085
translate belarusian d4_school_polina_201fbf08:

    # voice "voice/Polina/4day/18 Ch.ogg"
    # Pol "Что-то из Мусоргского?"
    voice "voice/Polina/4day/18 Ch.ogg"
    Pol "Нешта з Мусаргскага?"

# game/scripts/scene/scene_day_4.rpy:1093
translate belarusian d4_school_polina_104b473b:

    # voice "voice/Polina/4day/19 Ne.ogg"
    # Pol "Нет, пожалуй."
    voice "voice/Polina/4day/19 Ne.ogg"
    Pol "Не, бадай."

# game/scripts/scene/scene_day_4.rpy:1126
translate belarusian d4_school_polina_02e5a0a9:

    # "И ушла, а вместо неё в меня вперился взглядом Ромкин подручный."
    "І пайшла, а замест яе ў мяне ўпіўся поглядам Ромкаў памагаты."

# game/scripts/scene/scene_day_4.rpy:1137
translate belarusian d4_school_polina_e8887df7:

    # "Его указательный палец прошёлся под кадыком, сообщая: «Тебе конец»."
    "Яго ўказальны палец прайшоўся пад кадыком, паведамляючы: «Табе канец»."

# game/scripts/scene/scene_day_4.rpy:1155
translate belarusian d4_school_polina_9895e676:

    # "Прозвенел звонок."
    "Празвінеў званок."

# game/scripts/scene/scene_day_4.rpy:1166
translate belarusian d4_school_polina_69468793:

    # "Оставшиеся занятия пролетели незаметно, и я, наконец, покинул школу."
    "Астатнія заняткі праляцелі непрыкметна, і я нарэшце пакінуў школу."

# game/scripts/scene/scene_day_4.rpy:1168
translate belarusian d4_school_polina_ddf7ccdd:

    # "По пришкольной территории юлой носились крошечные смерчи."
    "Па прышкольнай тэрыторыі ваўчком насіліся малюсенькія смерчы."

# game/scripts/scene/scene_day_4.rpy:1169
translate belarusian d4_school_polina_849bc9d9:

    # "Крупными хлопьями падал белый снег."
    "Буйнымі шматкамі падаў белы снег."

# game/scripts/scene/scene_day_4.rpy:1170
translate belarusian d4_school_polina_5fb46a39:

    # "Переливались фонари. Их свет словно кристаллизировался на морозе, становясь твёрдым и остроконечным."
    "Пераліваліся ліхтары. Іх святло нібы крышталізавалася на марозе, робячыся цвёрдым і востраканцовым."

# game/scripts/scene/scene_day_4.rpy:1174
translate belarusian d4_school_polina_99f3ab4c:

    # "Где-то тявкнула собака, заставляя вспомнить бедную Жульку."
    "Недзе цяўкнуў сабака, прымушаючы ўспомніць бедную Жульку."

# game/scripts/scene/scene_day_4.rpy:1187
translate belarusian d4_school_polina_1b57dfc8:

    # "Полина стояла на крыльце. Ветер теребил её волосы."
    "Паліна стаяла на ганку. Вецер церабіў яе валасы."

# game/scripts/scene/scene_day_4.rpy:1195
translate belarusian d4_school_polina_900a755c:

    # voice "voice/anton/4day/24. Ya.ogg"
    # Ant "Я уже отвык от городского шума. Здесь всегда так тихо."
    voice "voice/anton/4day/24. Ya.ogg"
    Ant "Я ўжо адвык ад гарадскога шуму. Тут заўсёды так ціха."

# game/scripts/scene/scene_day_4.rpy:1199
translate belarusian d4_school_polina_6c01c890:

    # voice "voice/Polina/4day/20 O.ogg"
    # Pol "О, а я мечтаю о какофонии!"
    voice "voice/Polina/4day/20 O.ogg"
    Pol "О, а я мару пра какафонію!"

# game/scripts/scene/scene_day_4.rpy:1202
translate belarusian d4_school_polina_ace25c96:

    # voice "voice/anton/4day/25. O.ogg"
    # Ant "О како... чём?"
    voice "voice/anton/4day/25. O.ogg"
    Ant "Пра кака... што?"

# game/scripts/scene/scene_day_4.rpy:1209
translate belarusian d4_school_polina_6ac016e6:

    # "Моя спутница засмеялась."
    "Мая спадарожніца засмяялася."

# game/scripts/scene/scene_day_4.rpy:1213
translate belarusian d4_school_polina_3fe53318:

    # voice "voice/Polina/4day/21 Kak.ogg"
    # Pol "Какофония – это случайное сочетание звуков."
    voice "voice/Polina/4day/21 Kak.ogg"
    Pol "Какафонія — гэта выпадковае спалучэнне гукаў."

# game/scripts/scene/scene_day_4.rpy:1217
translate belarusian d4_school_polina_2d10daea:

    # voice "voice/Polina/4day/22 De.ogg"
    # Pol "Дедушка учит находить мелодию во всём."
    voice "voice/Polina/4day/22 De.ogg"
    Pol "Дзядуля вучыць знаходзіць мелодыю ва ўсім."

# game/scripts/scene/scene_day_4.rpy:1220
translate belarusian d4_school_polina_e166080a:

    # voice "voice/anton/4day/26. On.ogg"
    # Ant "Он, наверное, классный."
    voice "voice/anton/4day/26. On.ogg"
    Ant "Ён, напэўна, класны."

# game/scripts/scene/scene_day_4.rpy:1224
translate belarusian d4_school_polina_b6f755d5:

    # voice "voice/Polina/4day/23 Ne.ogg"
    # Pol "Не то слово! Скоро я вас познакомлю."
    voice "voice/Polina/4day/23 Ne.ogg"
    Pol "Не тое слова! Хутка я вас пазнаёмлю."

# game/scripts/scene/scene_day_4.rpy:1227
translate belarusian d4_school_polina_2ad96f91:

    # voice "voice/anton/4day/27. Ti.ogg"
    # Ant "Ты меня в гости приглашаешь?"
    voice "voice/anton/4day/27. Ti.ogg"
    Ant "Ты мяне ў госці запрашаеш?"

# game/scripts/scene/scene_day_4.rpy:1231
translate belarusian d4_school_polina_cfd3c3b7:

    # voice "voice/Polina/4day/24 A.ogg"
    # Pol "А ты против?"
    voice "voice/Polina/4day/24 A.ogg"
    Pol "А ты супраць?"

# game/scripts/scene/scene_day_4.rpy:1257
translate belarusian d4_school_polina_fc948e45:

    # "Не давая ответить, противный свист пронёсся по двору."
    "Не даючы адказаць, праціўны свіст пранёсся па двары."

# game/scripts/scene/scene_day_4.rpy:1258
translate belarusian d4_school_polina_50fb5686:

    # "Из снегопада материализовались две фигуры: руки в карманах, головы низко опущены."
    "Са снегападу матэрыялізаваліся дзве постаці: рукі ў кішэнях, галовы нізка апушчаныя."

# game/scripts/scene/scene_day_4.rpy:1259
translate belarusian d4_school_polina_467d5147:

    # "Суровая походка этой парочки сулила мне большие неприятности."
    "Суворая хада гэтай парачкі абяцала мне вялікія непрыемнасці."

# game/scripts/scene/scene_day_4.rpy:1299
translate belarusian d4_school_polina_cf0d5948:

    # voice "voice/romka/4day/214Anu.ogg"
    # Rom "А ну руки убрал от неё! Живо!"
    voice "voice/romka/4day/214Anu.ogg"
    Rom "А ну рукі прыбраў ад яе! Жыва!"

# game/scripts/scene/scene_day_4.rpy:1305
translate belarusian d4_school_polina_6b240421:

    # voice "voice/romka/4day/215Polin.ogg"
    # Rom "Полин, ты как? Он тебя не тронул?"
    voice "voice/romka/4day/215Polin.ogg"
    Rom "Палін, ты як? Ён цябе не крануў?"

# game/scripts/scene/scene_day_4.rpy:1311
translate belarusian d4_school_polina_0d563bf3:

    # voice "voice/byasha/4day/01 M.ogg"
    # Bya "Мы всё видели, на!"
    voice "voice/byasha/4day/01 M.ogg"
    Bya "Мы ўсё бачылі, на!"

# game/scripts/scene/scene_day_4.rpy:1315
translate belarusian d4_school_polina_7da1d3f6:

    # voice "voice/anton/4day/64. Vid.ogg"
    # Ant "Видели что?"
    voice "voice/anton/4day/64. Vid.ogg"
    Ant "Бачылі што?"

# game/scripts/scene/scene_day_4.rpy:1319
translate belarusian d4_school_polina_950f69c3:

    # voice "voice/romka/4day/216Chto.ogg"
    # Rom "Что ты её в лес вести собрался, психопат! Как Катьку."
    voice "voice/romka/4day/216Chto.ogg"
    Rom "Што ты яе ў лес весці сабраўся, псіхапат! Як Кацьку."

# game/scripts/scene/scene_day_4.rpy:1324
translate belarusian d4_school_polina_05cf235d:

    # voice "voice/byasha/4day/02V .ogg"
    # Bya "В последний момент успели, на."
    voice "voice/byasha/4day/02V .ogg"
    Bya "У апошні момант паспелі, на."

# game/scripts/scene/scene_day_4.rpy:1328
translate belarusian d4_school_polina_365ab7f7:

    # "Возмущённый голос Полины птицей вспорхнул над двором:"
    "Абураны голас Паліны птушкай успурхнуў над дваром:"

# game/scripts/scene/scene_day_4.rpy:1329
translate belarusian d4_school_polina_3c42763a:

    # voice "voice/Polina/4day/25 Da.ogg"
    # Pol "Да что вы мелете?"
    voice "voice/Polina/4day/25 Da.ogg"
    Pol "Ды што вы мелеце?"

# game/scripts/scene/scene_day_4.rpy:1347
translate belarusian d4_school_polina_0e7859b8:

    # voice "voice/romka/4day/217Ati.ogg"
    # Rom "А ты не в курсе?"
    voice "voice/romka/4day/217Ati.ogg"
    Rom "А ты не ў курсе?"

# game/scripts/scene/scene_day_4.rpy:1352
translate belarusian d4_school_polina_7cde9c1f:

    # voice "voice/romka/4day/219Kak.ogg"
    # Rom "Как только этот чепушило сюда переехал, сразу народ стал пропадать."
    voice "voice/romka/4day/219Kak.ogg"
    Rom "Як толькі гэты чапушыла сюды пераехаў, адразу народ пачаў прападаць."

# game/scripts/scene/scene_day_4.rpy:1357
translate belarusian d4_school_polina_e44d4252:

    # voice "voice/byasha/4day/03 Ag.ogg"
    # Bya "Ага, я вот сам видел, как он вчера Катю провожать вызвался и в лес уволок!"
    voice "voice/byasha/4day/03 Ag.ogg"
    Bya "Ага, я вось сам бачыў, як ён учора Кацю праводзіць выклікаўся і ў лес павалок!"

# game/scripts/scene/scene_day_4.rpy:1361
translate belarusian d4_school_polina_0e29644e:

    # "Я попытался сопротивляться:"
    "Я паспрабаваў супраціўляцца:"

# game/scripts/scene/scene_day_4.rpy:1362
translate belarusian d4_school_polina_69d6ad23:

    # voice "voice/anton/4day/Vresh.ogg"
    # Ant "Врёшь! Я эту Катьку терпеть не мог!"
    voice "voice/anton/4day/Vresh.ogg"
    Ant "Брэшаш! Я гэтую Кацьку цярпець не мог!"

# game/scripts/scene/scene_day_4.rpy:1366
translate belarusian d4_school_polina_43dadade:

    # voice "voice/romka/4day/220vot.ogg"
    # Rom "Ха! Вот потому её и грохнул."
    voice "voice/romka/4day/220vot.ogg"
    Rom "Ха! Вось таму яе і грохнуў."

# game/scripts/scene/scene_day_4.rpy:1371
translate belarusian d4_school_polina_e19309ba:

    # voice "voice/byasha/4day/04 V.ogg"
    # Bya "Всё сходится, на."
    voice "voice/byasha/4day/04 V.ogg"
    Bya "Усё сыходзіцца, на."

# game/scripts/scene/scene_day_4.rpy:1375
translate belarusian d4_school_polina_caa5feab:

    # "От такой несправедливости я оторопел."
    "Ад такой несправядлівасці я аслупянеў."

# game/scripts/scene/scene_day_4.rpy:1376
translate belarusian d4_school_polina_8b1bcbe6:

    # "Единственным плюсом оказалось то, что актёры из Ромки и Бяши никудышные. И врали они на тройку с минусом."
    "Адзіным плюсам аказалася тое, што акцёры з Ромкі і Бяшы нікчэмныя. І хлусілі яны на тройку з мінусам."

# game/scripts/scene/scene_day_4.rpy:1379
translate belarusian d4_school_polina_431f22b7:

    # voice "voice/romka/4day/221pov.ogg"
    # Rom "Повезло тебе, что мы с ментами не якшаемся."
    voice "voice/romka/4day/221pov.ogg"
    Rom "Пашанцавала табе, што мы з мянтамі не якшаемся."

# game/scripts/scene/scene_day_4.rpy:1384
translate belarusian d4_school_polina_ce89a875:

    # voice "voice/romka/4day/222ato.ogg"
    # Rom "А то бы с радостью тебя, маньяка, сдали."
    voice "voice/romka/4day/222ato.ogg"
    Rom "А то б з радасцю цябе, маньяка, здалі."

# game/scripts/scene/scene_day_4.rpy:1389
translate belarusian d4_school_polina_5bf84e18:

    # voice "voice/byasha/4day/05 N.ogg"
    # Bya "Ничего-ничего! Ща проведём с ним воспитательную беседу, на."
    voice "voice/byasha/4day/05 N.ogg"
    Bya "Нічога-нічога! Зараз правядзём з ім выхаваўчую гутарку, на."

# game/scripts/scene/scene_day_4.rpy:1394
translate belarusian d4_school_polina_d159990e:

    # voice "voice/byasha/4day/06 D.ogg"
    # Bya "Держи его!"
    voice "voice/byasha/4day/06 D.ogg"
    Bya "Трымай яго!"

# game/scripts/scene/scene_day_4.rpy:1409
translate belarusian d4_school_polina_8b4df86c:

    # "Ромка двинулся на меня, ухмыляясь."
    "Ромка рушыў на мяне, крыва ўсміхаючыся."

# game/scripts/scene/scene_day_4.rpy:1412
translate belarusian d4_school_polina_14cc36af:

    # voice "voice/romka/4day/223zna.ogg"
    # Rom "Значит, Катя тебе не нравилась, да?"
    voice "voice/romka/4day/223zna.ogg"
    Rom "Значыць, Каця табе не падабалася, так?"

# game/scripts/scene/scene_day_4.rpy:1417
translate belarusian d4_school_polina_2b895c92:

    # voice "voice/romka/4day/224kone.ogg"
    # Rom "Конечно! Кто ещё мог её порешить?"
    voice "voice/romka/4day/224kone.ogg"
    Rom "Канечне! Хто яшчэ мог яе прыкончыць?"

# game/scripts/scene/scene_day_4.rpy:1440
translate belarusian d4_school_polina_2bf07094:

    # voice "voice/Polina/4day/26 Ti.ogg"
    # Pol "Ты, например."
    voice "voice/Polina/4day/26 Ti.ogg"
    Pol "Ты, напрыклад."

# game/scripts/scene/scene_day_4.rpy:1450
translate belarusian d4_school_polina_d199fc7e:

    # "Я изумлённо посмотрел на Полину."
    "Я здзіўлена паглядзеў на Паліну."

# game/scripts/scene/scene_day_4.rpy:1451
translate belarusian d4_school_polina_340f12aa:

    # "Ромка застыл с поднятыми кулаками."
    "Ромка застыў з паднятымі кулакамі."

# game/scripts/scene/scene_day_4.rpy:1461
translate belarusian d4_school_polina_5bdde07e:

    # voice "voice/romka/4day/225vsm.ogg"
    # Rom "В см-смысле?"
    voice "voice/romka/4day/225vsm.ogg"
    Rom "У сэ-сэнсе?"

# game/scripts/scene/scene_day_4.rpy:1464
translate belarusian d4_school_polina_b62141db:

    # voice "voice/Polina/4day/27 Ka.ogg"
    # Pol "Катя, при всём уважении, никого не любила."
    voice "voice/Polina/4day/27 Ka.ogg"
    Pol "Каця, пры ўсёй павазе, нікога не любіла."

# game/scripts/scene/scene_day_4.rpy:1468
translate belarusian d4_school_polina_b0d3b6ff:

    # voice "voice/Polina/4day/28 Du.ogg"
    # Pol "Думаешь, Рома, она про тебя сплетни не распускала?"
    voice "voice/Polina/4day/28 Du.ogg"
    Pol "Думаеш, Рома, яна пра цябе плёткі не распускала?"

# game/scripts/scene/scene_day_4.rpy:1472
translate belarusian d4_school_polina_a129432f:

    # voice "voice/Polina/4day/29 Chto.ogg"
    # Pol "Что твой отец в тюрьме сидел? Что он тебя бьёт?"
    voice "voice/Polina/4day/29 Chto.ogg"
    Pol "Што твой бацька ў турме сядзеў? Што ён цябе б'е?"

# game/scripts/scene/scene_day_4.rpy:1495
translate belarusian d4_school_polina_e59d3087:

    # "Ромка покраснел и захлопал губами, точно выброшенная на берег рыба."
    "Ромка пачырванеў і запляскаў губамі, нібы выкінутая на бераг рыба."

# game/scripts/scene/scene_day_4.rpy:1496
translate belarusian d4_school_polina_ef5000fb:

    # "Полина продолжала звенящим от гнева голосом:"
    "Паліна працягвала голасам, які звінеў ад гневу:"

# game/scripts/scene/scene_day_4.rpy:1514
translate belarusian d4_school_polina_56580e49:

    # voice "voice/Polina/4day/30 A.ogg"
    # Pol "А ты, Бяша? Сам-то где вчера вечером пропадал?"
    voice "voice/Polina/4day/30 A.ogg"
    Pol "А ты, Бяша? Сам дзе ўчора ўвечары прападаў?"

# game/scripts/scene/scene_day_4.rpy:1518
translate belarusian d4_school_polina_6cab9eb0:

    # voice "voice/Polina/4day/31 Ka.ogg"
    # Pol "Катя говорила, что ты с приветом стал, как на Чёрный Гараж наткнулся."
    voice "voice/Polina/4day/31 Ka.ogg"
    Pol "Каця казала, што ты з прыветам стаў, як на Чорны гараж наткнуўся."

# game/scripts/scene/scene_day_4.rpy:1552
translate belarusian d4_school_polina_0b5bebef:

    # "Бяша попятился, а его лицо в норке капюшона стало белым, как у покойника."
    "Бяша пазадкаваў, а яго твар у норцы капюшона стаў белым, як у нябожчыка."

# game/scripts/scene/scene_day_4.rpy:1591
translate belarusian d4_school_polina_235ab399:

    # voice "voice/Polina/4day/32 Ta.ogg"
    # Pol "Так может, это ты тот психопат, что Катю украл?"
    voice "voice/Polina/4day/32 Ta.ogg"
    Pol "Дык можа, гэта ты той псіхапат, што Кацю скраў?"

# game/scripts/scene/scene_day_4.rpy:1618
translate belarusian d4_school_polina_e518880d:

    # voice "voice/byasha/4day/07 N.ogg"
    # Bya "Нет!"
    voice "voice/byasha/4day/07 N.ogg"
    Bya "Не!"

# game/scripts/scene/scene_day_4.rpy:1621
translate belarusian d4_school_polina_49d52c08:

    # "Бяша почти срывался на визг."
    "Бяша амаль зрываўся на віск."

# game/scripts/scene/scene_day_4.rpy:1642
translate belarusian d4_school_polina_5a96b0bf:

    # "Он повернулся и шаткой походкой побрёл к воротам, на ходу мотая головой."
    "Ён павярнуўся і хісткай хадой пабрыў да варот, на хаду матаючы галавой."

# game/scripts/scene/scene_day_4.rpy:1643
translate belarusian d4_school_polina_aac15a5d:

    # "Ого, - подумал я, - как она ловко справилась с Бяшей."
    "Ого, — падумаў я, — як яна спрытна справілася з Бяшам."

# game/scripts/scene/scene_day_4.rpy:1647
translate belarusian d4_school_polina_9b74f614:

    # voice "voice/Polina/4day/33 Ch.ogg"
    # Pol "Что, один остался, Ромео недоделанный?"
    voice "voice/Polina/4day/33 Ch.ogg"
    Pol "Што, адзін застаўся, Рамэа недароблены?"

# game/scripts/scene/scene_day_4.rpy:1649
translate belarusian d4_school_polina_dd8c0e39:

    # voice "voice/Polina/4day/34 Ka.ogg"
    # Pol "Какую ещё гнусность выдумаешь, чтобы меня удивить, м?"
    voice "voice/Polina/4day/34 Ka.ogg"
    Pol "Якую яшчэ мярзоту выдумаеш, каб мяне здзівіць, м?"

# game/scripts/scene/scene_day_4.rpy:1656
translate belarusian d4_school_polina_e4c64c5a:

    # "Рома затравленно сглотнул."
    "Рома зацкавана глынуў."

# game/scripts/scene/scene_day_4.rpy:1673
translate belarusian d4_school_polina_8ede217e:

    # voice "voice/Polina/4day/35 Ci.ogg"
    # Pol "Цирк устроить хотел? Героем представиться?"
    voice "voice/Polina/4day/35 Ci.ogg"
    Pol "Цырк зладзіць хацеў? Героем прыкінуцца?"

# game/scripts/scene/scene_day_4.rpy:1677
translate belarusian d4_school_polina_dc534fec:

    # voice "voice/Polina/4day/36 To.ogg"
    # Pol "Только вот не ведут себя так герои."
    voice "voice/Polina/4day/36 To.ogg"
    Pol "Толькі вось не паводзяць сябе так героі."

# game/scripts/scene/scene_day_4.rpy:1681
translate belarusian d4_school_polina_b3f76082:

    # voice "voice/Polina/4day/37 E.ogg"
    # Pol "И актёр ты, Рома, липовый."
    voice "voice/Polina/4day/37 E.ogg"
    Pol "І акцёр ты, Рома, ліпавы."

# game/scripts/scene/scene_day_4.rpy:1699
translate belarusian d4_school_polina_1bb9094c:

    # voice "voice/romka/4day/227da.ogg"
    # Rom "Да этот очкарик..."
    voice "voice/romka/4day/227da.ogg"
    Rom "Ды гэты акулярнік..."

# game/scripts/scene/scene_day_4.rpy:1703
translate belarusian d4_school_polina_fc04b1f0:

    # voice "voice/Polina/4day/38 V.ogg"
    # Pol "...во всём лучше тебя." id d4_school_polina_fc04b1f0
    voice "voice/Polina/4day/38 V.ogg"
    Pol "...ва ўсім лепшы за цябе."

# game/scripts/scene/scene_day_4.rpy:1705
translate belarusian d4_school_polina_c66c9d6e:

    # "Затем она сделала что-то совсем фантастическое — взяла меня за руку."
    "Потым яна зрабіла нешта зусім фантастычнае — узяла мяне за руку."

# game/scripts/scene/scene_day_4.rpy:1719
translate belarusian d4_school_polina_646f6536:

    # voice "voice/Polina/4day/39 Po.ogg"
    # Pol "Пойдём, Антон."
    voice "voice/Polina/4day/39 Po.ogg"
    Pol "Хадзем, Антон."

# game/scripts/scene/scene_day_4.rpy:1740
translate belarusian d4_school_polina_0a490a06:

    # "Мы прошли мимо онемевшего Ромки."
    "Мы прайшлі міма анямелага Ромкі."

# game/scripts/scene/scene_day_4.rpy:1741
translate belarusian d4_school_polina_6cb1ffdf:

    # "Было даже жаль его, но — чего скрывать — я ликовал."
    "Было нават шкада яго, але — чаго хаваць — я лікаваў."

# game/scripts/scene/scene_day_4.rpy:1742
translate belarusian d4_school_polina_7dac920b:

    # "Он не остановил нас."
    "Ён не спыніў нас."

# game/scripts/scene/scene_day_4.rpy:1746
translate belarusian d4_school_polina_cfcc1f6a:

    # "Стоял и таращился в набирающую силу метель."
    "Стаяў і тарашчыўся ў мяцеліцу, што набірала сілу."

# game/scripts/scene/scene_day_4.rpy:1776
translate belarusian d4_school_polina_8d971e58:

    # "За воротами я воскликнул, подпрыгнув:"
    "За варотамі я ўсклікнуў, падскочыўшы:"

# game/scripts/scene/scene_day_4.rpy:1779
translate belarusian d4_school_polina_8adc0949:

    # voice "voice/anton/4day/66. Kak.ogg"
    # Ant "Как ты его!"
    voice "voice/anton/4day/66. Kak.ogg"
    Ant "Як ты яго!"

# game/scripts/scene/scene_day_4.rpy:1783
translate belarusian d4_school_polina_7e0ba999:

    # "Полина скромно улыбнулась."
    "Паліна сціпла ўсміхнулася."

# game/scripts/scene/scene_day_4.rpy:1784
translate belarusian d4_school_polina_1e37b43d:

    # voice "voice/Polina/4day/40 Nu.ogg"
    # Pol "Ну знаешь... Как дедушка говорит, с волками жить — по-волчьи выть."
    voice "voice/Polina/4day/40 Nu.ogg"
    Pol "Ну ведаеш... Як дзядуля кажа, з ваўкамі жыць — па-воўчы выць."

# game/scripts/scene/scene_day_4.rpy:1786
translate belarusian d4_school_polina_b7ed3c77:

    # voice "voice/anton/4day/67. On.ogg"
    # Ant "Он у тебя философ."
    voice "voice/anton/4day/67. On.ogg"
    Ant "Ён у цябе філосаф."

# game/scripts/scene/scene_day_4.rpy:1788
translate belarusian d4_school_polina_f4f3acb2:

    # voice "voice/Polina/4day/41 Kra.ogg"
    # Pol "Краевед... Был раньше."
    voice "voice/Polina/4day/41 Kra.ogg"
    Pol "Краязнаўца... Быў раней."

# game/scripts/scene/scene_day_4.rpy:1790
translate belarusian d4_school_polina_45fd9bdd:

    # voice "voice/Polina/4day/42 On.ogg"
    # Pol "Он уже давно на пенсии, а в последнее время ему серьёзно нездоровится."
    voice "voice/Polina/4day/42 On.ogg"
    Pol "Ён ужо даўно на пенсіі, а апошнім часам яму сур'ёзна нядужаецца."

# game/scripts/scene/scene_day_4.rpy:1792
translate belarusian d4_school_polina_95d658dc:

    # "Я понимающе кивнул."
    "Я з разуменнем кіўнуў."

# game/scripts/scene/scene_day_4.rpy:1793
translate belarusian d4_school_polina_205cf682:

    # "Тайком я рассматривал Полину."
    "Крадком я разглядаў Паліну."

# game/scripts/scene/scene_day_4.rpy:1794
translate belarusian d4_school_polina_3b4ac06b:

    # "Она казалась драгоценным камнем, чьи грани переливаются, мерцают, неуловимо меняясь."
    "Яна здавалася каштоўным каменем, чые грані пераліваюцца, мігцяць, няўлоўна мяняючыся."

# game/scripts/scene/scene_day_4.rpy:1795
translate belarusian d4_school_polina_a846539f:

    # "«Что?» – спрашивали невинно её смеющиеся глаза."
    "«Што?» — пыталіся нявінна яе ўсмешлівыя вочы."

# game/scripts/scene/scene_day_4.rpy:1796
translate belarusian d4_school_polina_51ca9cfd:

    # "«То!» – молча отвечал я."
    "«Тое!» — моўчкі адказваў я."

# game/scripts/scene/scene_day_4.rpy:1797
translate belarusian d4_school_polina_cad25acd:

    # voice "voice/Polina/4day/43 Ti.ogg"
    # Pol "Ты храбрый. Мне нравится."
    voice "voice/Polina/4day/43 Ti.ogg"
    Pol "Ты адважны. Мне падабаецца."

# game/scripts/scene/scene_day_4.rpy:1801
translate belarusian d4_school_polina_bc6e6aa2:

    # voice "voice/anton/4day/68. Hr.ogg"
    # Ant "Храбрый? Стоял там, язык проглотив."
    voice "voice/anton/4day/68. Hr.ogg"
    Ant "Адважны? Стаяў там, язык праглынуўшы."

# game/scripts/scene/scene_day_4.rpy:1803
translate belarusian d4_school_polina_9e1a9bd7:

    # voice "voice/Polina/4day/44 No.ogg"
    # Pol "Но стоял же! Не сбежал."
    voice "voice/Polina/4day/44 No.ogg"
    Pol "Але ж стаяў! Не ўцёк."

# game/scripts/scene/scene_day_4.rpy:1805
translate belarusian d4_school_polina_62955535:

    # voice "voice/Polina/4day/45 Ya.ogg"
    # Pol "Я до сих пор поражаюсь, как ты нашёл в себе смелость послать, а тем более ударить Бабурина."
    voice "voice/Polina/4day/45 Ya.ogg"
    Pol "Я дагэтуль дзіўлюся, як ты знайшоў у сабе смеласць паслаць, а тым больш ударыць Бабурына."

# game/scripts/scene/scene_day_4.rpy:1810
translate belarusian d4_school_polina_59c5120f:

    # Ant "Ради тебя я готов на многое."
    Ant "Дзеля цябе я гатовы на многае."

# game/scripts/scene/scene_day_4.rpy:1811
translate belarusian d4_school_polina_8d06aef6:

    # voice "voice/Polina/4day/46 Vot.ogg"
    # Pol "Вот! Я же говорю!"
    voice "voice/Polina/4day/46 Vot.ogg"
    Pol "Вось! Я ж кажу!"

# game/scripts/scene/scene_day_4.rpy:1813
translate belarusian d4_school_polina_2dc6f19e:

    # voice "voice/Polina/4day/47 Ez.ogg"
    # Pol "Изъясняешься словами из романов."
    voice "voice/Polina/4day/47 Ez.ogg"
    Pol "Выказваешся словамі з раманаў."

# game/scripts/scene/scene_day_4.rpy:1815
translate belarusian d4_school_polina_e481f1c0:

    # voice "voice/Polina/4day/48 Ra.ogg"
    # Pol "«Ради тебя, моя госпожа!»"
    voice "voice/Polina/4day/48 Ra.ogg"
    Pol "«Дзеля цябе, мая спадарыня!»"

# game/scripts/scene/scene_day_4.rpy:1819
translate belarusian d4_school_polina_279d72d0:

    # "Полина захихикала."
    "Паліна захіхікала."

# game/scripts/scene/scene_day_4.rpy:1822
translate belarusian d4_school_polina_b665ff3b:

    # "Я надулся притворно, но не сумел удержаться и тоже улыбнулся." id d4_school_polina_b665ff3b
    "Я надзьмуўся прытворна, але не здолеў стрымацца і таксама ўсміхнуўся."

# game/scripts/scene/scene_day_4.rpy:1832
translate belarusian d4_school_solo_ee88ab6e:

    # "Бяша выпрыгнул, как чёртик из табакерки, и резко гаркнул мне в ухо:"
    "Бяша выскачыў, як чорцік з табакеркі, і рэзка гаркнуў мне ў вуха:"

# game/scripts/scene/scene_day_4.rpy:1856
translate belarusian d4_school_solo_a6271feb:

    # voice "voice/byasha/4day/171 Op.ogg"
    # Bya "Опачки!"
    voice "voice/byasha/4day/171 Op.ogg"
    Bya "Опачкі!"

# game/scripts/scene/scene_day_4.rpy:1882
translate belarusian d4_school_solo_d655e8d6:

    # voice "voice/byasha/4day/172 Ach.ogg"
    # Bya "А чё это у вас за шуры-муры, на?"
    voice "voice/byasha/4day/172 Ach.ogg"
    Bya "А што гэта ў вас за шуры-муры, на?"

# game/scripts/scene/scene_day_4.rpy:1890
translate belarusian d4_school_solo_247c070b:

    # voice "voice/romka/4day/247ti.ogg"
    # Rom "Ты чего, очкарик, Полиночку охмуряешь?"
    voice "voice/romka/4day/247ti.ogg"
    Rom "Ты чаго, акулярнік, Паліначку ахмураеш?"

# game/scripts/scene/scene_day_4.rpy:1893
translate belarusian d4_school_solo_dfe0584b:

    # "Полина пришла на помощь, хотя я и не просил."
    "Паліна прыйшла на дапамогу, хоць я і не прасіў."

# game/scripts/scene/scene_day_4.rpy:1894
translate belarusian d4_school_solo_6f7a849b:

    # "Или всё-таки просил – всем своим видом?"
    "Ці ўсё ж такі прасіў — усім сваім выглядам?"

# game/scripts/scene/scene_day_4.rpy:1898
translate belarusian d4_school_solo_4b262130:

    # voice "voice/Polina/4day/174 Ch.ogg"
    # Pol "Что за глупости? Мы просто друзья."
    voice "voice/Polina/4day/174 Ch.ogg"
    Pol "Што за глупства? Мы проста сябры."

# game/scripts/scene/scene_day_4.rpy:1904
translate belarusian d4_school_solo_e2a9668a:

    # voice "voice/romka/4day/248Tvo.ogg"
    # Rom "Твоя подружка, значит? Ходишь вместе за платьями? С этим педиком?"
    voice "voice/romka/4day/248Tvo.ogg"
    Rom "Твая сяброўка, значыць? Ходзіш разам па сукенкі? З гэтым педзікам?"

# game/scripts/scene/scene_day_4.rpy:1912
translate belarusian d4_school_solo_391eb38a:

    # voice "voice/Polina/4day/175 N.ogg"
    # Pol "Никакой он не педик! И вообще отвянь от Петрова!"
    voice "voice/Polina/4day/175 N.ogg"
    Pol "Ніякі ён не педзік! І ўвогуле адчапіся ад Пятрова!"

# game/scripts/scene/scene_day_4.rpy:1916
translate belarusian d4_school_solo_9914cf4c:

    # "Я обязан был что-то предпринять. Но вместо этого сидел, вцепившись в край парты."
    "Я абавязаны быў нешта зрабіць. Але замест гэтага сядзеў, учапіўшыся ў край парты."

# game/scripts/scene/scene_day_4.rpy:1917
translate belarusian d4_school_solo_40db0068:

    # "Ромка хмыкнул презрительно."
    "Ромка хмыкнуў пагардліва."

# game/scripts/scene/scene_day_4.rpy:1922
translate belarusian d4_school_solo_b0144e58:

    # voice "voice/romka/4day/249baba.ogg"
    # Rom "Баба тебя спасла, уродец. Живи пока."
    voice "voice/romka/4day/249baba.ogg"
    Rom "Баба цябе выратавала, вырадак. Жыві пакуль."

# game/scripts/scene/scene_day_4.rpy:1942
translate belarusian d4_school_solo_5bb0e652:

    # "Хохоча, мои враги удалились из класса."
    "Рагочучы, мае ворагі сышлі з класа."

# game/scripts/scene/scene_day_4.rpy:1950
translate belarusian d4_school_solo_ab823c9a:

    # "Полина грустно улыбнулась мне."
    "Паліна сумна ўсміхнулася мне."

# game/scripts/scene/scene_day_4.rpy:1956
translate belarusian d4_school_solo_ba6faf82:

    # voice "voice/Polina/4day/176 Bu.ogg"
    # Pol "Будь сильным."
    voice "voice/Polina/4day/176 Bu.ogg"
    Pol "Будзь моцным."

# game/scripts/scene/scene_day_4.rpy:1960
translate belarusian d4_school_solo_823fc34f:

    # "Подмывало закричать: «Я не могу!»"
    "Карцела закрычаць: «Я не магу!»"

# game/scripts/scene/scene_day_4.rpy:1961
translate belarusian d4_school_solo_c97ac007:

    # "Не могу быть сильным и дать отпор этим мерзавцам."
    "Не магу быць моцным і даць адпор гэтым мярзотнікам."

# game/scripts/scene/scene_day_4.rpy:1965
translate belarusian d4_school_solo_f6460411:

    # "Не могу защитить себя, тебя... да хоть кого-нибудь."
    "Не магу абараніць сябе, цябе... ды хоць каго-небудзь."

# game/scripts/scene/scene_day_4.rpy:1968
translate belarusian d4_school_solo_bbbfc7b1:

    # "Я жалок."
    "Я жалюгодны."

# game/scripts/scene/scene_day_4.rpy:1969
translate belarusian d4_school_solo_998b2133:

    # "Хочу сгинуть в лесу, зарыться в снег. Хочу домой, под одеяло, подальше от людей."
    "Хачу згінуць у лесе, зарыцца ў снег. Хачу дадому, пад коўдру, падалей ад людзей."

# game/scripts/scene/scene_day_4.rpy:1974
translate belarusian d4_school_solo_a509a28d:

    # "Полина ушла, и терзавшие меня мысли окончательно довели до горьких слёз."
    "Паліна пайшла, і думкі, што мучылі мяне, канчаткова давялі да горкіх слёз."

# game/scripts/scene/scene_day_4.rpy:1975
translate belarusian d4_school_solo_a20cefa7:

    # "..."
    "..."

# game/scripts/scene/scene_day_4.rpy:1980
translate belarusian d4_school_solo_1baf3423:

    # "Я снова задержался после уроков, боясь расправы Ромки за дерзость — разговор с Полиной."
    "Я зноў затрымаўся пасля ўрокаў, баючыся расправы Ромкі за дзёрзкасць — размову з Палінай."

# game/scripts/scene/scene_day_4.rpy:1990
translate belarusian d4_school_solo_0f1cb53e:

    # "И брёл из школы в предзакатном свете."
    "І брыў са школы ў перадзаходнім святле."

# game/scripts/scene/scene_day_4.rpy:1995
translate belarusian d4_school_solo_0cecea13:

    # "Скучающий дворник скоблил лопатой асфальт, а старшеклассники выдували сигаретный дым, похожий на диалоговые облака из комиксов."
    "Знуджаны дворнік скабліў лапатай асфальт, а старшакласнікі выдзімалі цыгарэтны дым, падобны да дыялогавых аблокаў з коміксаў."

# game/scripts/scene/scene_day_4.rpy:1996
translate belarusian d4_school_solo_280f1d8a:

    # "Хотелось наполнить эти пустые окошки дружескими словами, но не было ничего дружелюбного в ледяных взглядах ребят."
    "Хацелася напоўніць гэтыя пустыя акенцы сяброўскімі словамі, але не было нічога прыязнага ў ледзяных позірках хлопцаў."

# game/scripts/scene/scene_day_4.rpy:2004
translate belarusian d4_school_solo_06c0fb9c:

    # "Я покидал неприятный мир чёрствых булочек и гадких насмешек."
    "Я пакідаў непрыемны свет чэрствых булачак і брыдкіх кпінаў."

# game/scripts/scene/scene_day_4.rpy:2008
translate belarusian d4_school_solo_ed0ddb1c:

    # "Кто-то толкнул меня на пороге. Разве не учили извиняться?"
    "Хтосьці штурхнуў мяне на парозе. Хіба не вучылі прасіць прабачэння?"

# game/scripts/scene/scene_day_4.rpy:2018
translate belarusian d4_school_solo_8fa9895d:

    # "Я пересёк посёлок и замедлился у моста. Покрутился, выискивая рыжую подругу, но на дороге не было лисиц или других моих новых друзей."
    "Я перасёк пасёлак і запаволіў крок каля маста. Пакруціўся, вышукваючы рудую сяброўку, але на дарозе не было лісіц ці іншых маіх новых сяброў."

# game/scripts/scene/scene_day_4.rpy:2019
translate belarusian d4_school_solo_9515f3cf:

    # "Встретивший меня лес был тих и покладист, будто притворившийся спящим зверь."
    "Лес, які сустрэў мяне, быў ціхі і пакладзісты, нібы звер, што прыкінуўся спячым."

# game/scripts/scene/scene_day_4.rpy:2068
translate belarusian d4_school_solo_a335325d:

    # "Он всё же следил за мной одним глазком, из-под прикрытых век, а я шагал, сунув пальцы за ремни рюкзака, и смотрел под ноги сквозь очки."
    "Ён усё ж сачыў за мной адным вочкам, з-пад прыкрытых павек, а я крочыў, сунуўшы пальцы за рамяні рукзака, і глядзеў пад ногі праз акуляры."

# game/scripts/scene/scene_day_4.rpy:2070
translate belarusian d4_school_solo_e9ec62f5:

    # voice "voice/Child/4day/Katya.ogg"
    # Noname "Ка-а-а-а-тя! Ка-а-а-а-тя!"
    voice "voice/Child/4day/Katya.ogg"
    Noname "Ка-а-а-а-ця! Ка-а-а-а-ця!"

# game/scripts/scene/scene_day_4.rpy:2072
translate belarusian d4_school_solo_9234e4ad:

    # "Вновь чёрные тени маячили меж голых деревьев, неустанно повторяя имя, скорее всего, уже мёртвой девочки."
    "Зноў чорныя цені маячылі між голых дрэў, нястомна паўтараючы імя, хутчэй за ўсё, ужо мёртвай дзяўчынкі."

# game/scripts/scene/scene_day_4.rpy:2073
translate belarusian d4_school_solo_826e93a6:

    # "Закат затухал над соснами, как пламя повёрнутой к минимуму газовой конфорки."
    "Закат згасаў над соснамі, як полымя прыкручанай да мінімуму газавай канфоркі."

# game/scripts/scene/scene_day_4.rpy:2074
translate belarusian d4_school_solo_d72c52f5:

    # "Я пошёл дальше, втянув голову в плечи, не глядя на искорежённые деревья."
    "Я пайшоў далей, уцягнуўшы галаву ў плечы, не гледзячы на пакарэжаныя дрэвы."

# game/scripts/scene/scene_day_4.rpy:2097
translate belarusian d4_school_fox_betray_597d1f5b:

    # voice "voice/anton/4day/18. K.ogg"
    # Ant "Конечно."
    voice "voice/anton/4day/18. K.ogg"
    Ant "Вядома."

# game/scripts/scene/scene_day_4.rpy:2101
translate belarusian d4_school_fox_betray_65ef2e91:

    # voice "voice/anton/4day/19. To.ogg"
    # Ant "Только давай пойдём через запасной выход. Ну тот, возле спортзала."
    voice "voice/anton/4day/19. To.ogg"
    Ant "Толькі давай пойдзем праз запасны выхад. Ну той, каля спартзалы."

# game/scripts/scene/scene_day_4.rpy:2115
translate belarusian d4_school_fox_betray_3e950ccb:

    # voice "voice/Polina/4day/136 Pr.ogg"
    # Pol "Прячешься от кого-то?"
    voice "voice/Polina/4day/136 Pr.ogg"
    Pol "Хаваешся ад кагосьці?"

# game/scripts/scene/scene_day_4.rpy:2126
translate belarusian d4_school_fox_betray_ecb2db4a:

    # "Я покосился на парту впереди."
    "Я пакасіўся на парту наперадзе."

# game/scripts/scene/scene_day_4.rpy:2127
translate belarusian d4_school_fox_betray_da606b95:

    # "Мои товарищи оставили нас вдвоём. Дали время, чтобы я мог их спокойно предать."
    "Мае таварышы пакінулі нас удваіх. Далі час, каб я мог ім спакойна здрадзіць."

# game/scripts/scene/scene_day_4.rpy:2128
translate belarusian d4_school_fox_betray_988a26fa:

    # "Совесть впилась в душу крошечными зубами."
    "Сумленне ўпілося ў душу малюсенькімі зубамі."

# game/scripts/scene/scene_day_4.rpy:2138
translate belarusian d4_school_fox_betray_562cbe33:

    # voice "voice/Polina/4day/137 Tak.ogg"
    # Pol "Так это из-за Ромки?"
    voice "voice/Polina/4day/137 Tak.ogg"
    Pol "Дык гэта праз Ромку?"

# game/scripts/scene/scene_day_4.rpy:2142
translate belarusian d4_school_fox_betray_39a4a75a:

    # voice "voice/Polina/4day/138 Ne.ogg"
    # Pol "Не хочешь, чтобы он узнал?"
    voice "voice/Polina/4day/138 Ne.ogg"
    Pol "Не хочаш, каб ён даведаўся?"

# game/scripts/scene/scene_day_4.rpy:2145
translate belarusian d4_school_fox_betray_eb29b71a:

    # voice "voice/anton/4day/21. T.ogg"
    # Ant "Ты ему нравишься."
    voice "voice/anton/4day/21. T.ogg"
    Ant "Ты яму падабаешся."

# game/scripts/scene/scene_day_4.rpy:2149
translate belarusian d4_school_fox_betray_13d3f97b:

    # voice "voice/Polina/4day/139 Slo.ogg"
    # Pol "Сложно не заметить."
    voice "voice/Polina/4day/139 Slo.ogg"
    Pol "Цяжка не заўважыць."

# game/scripts/scene/scene_day_4.rpy:2153
translate belarusian d4_school_fox_betray_c01227dd:

    # voice "voice/Polina/4day/140 No.ogg"
    # Pol "Но парни всегда забывают о главном: сначала надо спросить мнение девушки."
    voice "voice/Polina/4day/140 No.ogg"
    Pol "Але хлопцы заўсёды забываюць пра галоўнае: спачатку трэба спытаць меркаванне дзяўчыны."

# game/scripts/scene/scene_day_4.rpy:2170
translate belarusian d4_school_fox_betray_3ad7cbcf:

    # voice "voice/Polina/4day/141 Ade.ogg"
    # Pol "А девушка говорит: после уроков у запасного выхода."
    voice "voice/Polina/4day/141 Ade.ogg"
    Pol "А дзяўчына кажа: пасля ўрокаў каля запаснога выхаду."

# game/scripts/scene/scene_day_4.rpy:2182
translate belarusian d4_school_fox_betray_3e728777:

    # "Я улыбнулся облегчённо."
    "Я ўсміхнуўся з палёгкай."

# game/scripts/scene/scene_day_4.rpy:2212
translate belarusian d4_school_fox_betray_b4c675dd:

    # "Совесть снова принялась поедать душу, когда вернувшийся Ромка бросил мне пирожок с брусникой и подмигнул."
    "Сумленне зноў узялося паядаць душу, калі Ромка вярнуўся, кінуў мне піражок з брусніцамі і падміргнуў."

# game/scripts/scene/scene_day_4.rpy:2217
translate belarusian d4_school_fox_betray_c475be34:

    # voice "voice/romka/4day/Esh.ogg"
    # Rom "Ешь, набирайся сил для нашего спектакля!"
    voice "voice/romka/4day/Esh.ogg"
    Rom "Еш, набірайся сіл для нашага спектакля!"

# game/scripts/scene/scene_day_4.rpy:2220
translate belarusian d4_school_fox_betray_22817979:

    # "Но актёр, играющий отрицательную роль – то есть я – на спектакль не пришёл."
    "Але акцёр, які грае адмоўную ролю — то бок я — на спектакль не прыйшоў."

# game/scripts/scene/scene_day_4.rpy:2224
translate belarusian d4_school_fox_betray_6a623c02:

    # "Я отпросился у учительницы за двадцать минут до конца алгебры. Соврал, что болит зуб."
    "Я адпрасіўся ў настаўніцы за дваццаць хвілін да канца алгебры. Зманіў, што баліць зуб."

# game/scripts/scene/scene_day_4.rpy:2239
translate belarusian d4_school_fox_betray_a7dfd1e1:

    # "Спрятался за школьными кустами, как преступник."
    "Схаваўся за школьнымі кустамі, як злачынец."

# game/scripts/scene/scene_day_4.rpy:2240
translate belarusian d4_school_fox_betray_4736b656:

    # "Вскоре появилась Полина."
    "Неўзабаве з'явілася Паліна."

# game/scripts/scene/scene_day_4.rpy:2263
translate belarusian d4_school_fox_betray_3cd74bee:

    # voice "voice/anton/4day/22. Ei.ogg"
    # Ant "Эй, я тут!"
    voice "voice/anton/4day/22. Ei.ogg"
    Ant "Гэй, я тут!"

# game/scripts/scene/scene_day_4.rpy:2266
translate belarusian d4_school_fox_betray_08190bd9:

    # voice "voice/Polina/4day/142 Tib.ogg"
    # Pol "Ты б ещё в сугроб зарылся!"
    voice "voice/Polina/4day/142 Tib.ogg"
    Pol "Ты б яшчэ ў гурбу зарыўся!"

# game/scripts/scene/scene_day_4.rpy:2269
translate belarusian d4_school_fox_betray_1aacb29a:

    # "Я понимал, что подло пытаюсь усидеть на двух стульях: не лишиться поддержки Ромы и тайно завоевать Полину."
    "Я разумеў, што подла спрабую ўседзець на двух крэслах: не страціць падтрымкі Ромы і таемна заваяваць Паліну."

# game/scripts/scene/scene_day_4.rpy:2270
translate belarusian d4_school_fox_betray_d128cee2:

    # "Интересно, какой из стульев хрустнет подо мной первым?"
    "Цікава, якое з крэслаў хрусне пада мной першым?"

# game/scripts/scene/scene_day_4.rpy:2271
translate belarusian d4_school_fox_betray_0850d2bd:

    # voice "voice/anton/4day/23. Poi.ogg"
    # Ant "Пойдём скорее."
    voice "voice/anton/4day/23. Poi.ogg"
    Ant "Хадзем хутчэй."

# game/scripts/scene/scene_day_4.rpy:2275
translate belarusian d4_school_fox_betray_d0b5bff9:

    # voice "voice/Polina/4day/143 Nu.ogg"
    # Pol "Ну пойдём."
    voice "voice/Polina/4day/143 Nu.ogg"
    Pol "Ну хадзем."

# game/scripts/scene/scene_day_4.rpy:2318
translate belarusian d4_school_fox_betray_8212b122:

    # "Мы зашагали вдоль стадиона."
    "Мы закрочылі ўздоўж стадыёна."

# game/scripts/scene/scene_day_4.rpy:2319
translate belarusian d4_school_fox_betray_412703b6:

    # "Солнце светило ярко, но не согревало промёрзшую землю."
    "Сонца свяціла ярка, але не сагравала прамёрзлую зямлю."

# game/scripts/scene/scene_day_4.rpy:2320
translate belarusian d4_school_fox_betray_26d5aba2:

    # "Сумерки затаились в чаще, ожидая нетерпеливо, когда можно будет выползти и поглотить посёлок."
    "Прыцемкі затаіліся ў гушчары, чакаючы нецярпліва, калі можна будзе выпаўзці і паглынуць пасёлак."

# game/scripts/scene/scene_day_4.rpy:2321
translate belarusian d4_school_fox_betray_900a755c:

    # voice "voice/anton/4day/24. Ya.ogg"
    # Ant "Я уже отвык от городского шума. Здесь всегда так тихо."
    voice "voice/anton/4day/24. Ya.ogg"
    Ant "Я ўжо адвык ад гарадскога шуму. Тут заўсёды так ціха."

# game/scripts/scene/scene_day_4.rpy:2324
translate belarusian d4_school_fox_betray_6c01c890:

    # voice "voice/Polina/4day/20 O.ogg"
    # Pol "О, а я мечтаю о какофонии!"
    voice "voice/Polina/4day/20 O.ogg"
    Pol "О, а я мару пра какафонію!"

# game/scripts/scene/scene_day_4.rpy:2326
translate belarusian d4_school_fox_betray_ace25c96:

    # voice "voice/anton/4day/25. O.ogg"
    # Ant "О како... чём?"
    voice "voice/anton/4day/25. O.ogg"
    Ant "Пра кака... што?"

# game/scripts/scene/scene_day_4.rpy:2329
translate belarusian d4_school_fox_betray_6ac016e6:

    # "Моя спутница засмеялась."
    "Мая спадарожніца засмяялася."

# game/scripts/scene/scene_day_4.rpy:2330
translate belarusian d4_school_fox_betray_3fe53318:

    # voice "voice/Polina/4day/21 Kak.ogg"
    # Pol "Какофония – это случайное сочетание звуков."
    voice "voice/Polina/4day/21 Kak.ogg"
    Pol "Какафонія — гэта выпадковае спалучэнне гукаў."

# game/scripts/scene/scene_day_4.rpy:2332
translate belarusian d4_school_fox_betray_2d10daea:

    # voice "voice/Polina/4day/22 De.ogg"
    # Pol "Дедушка учит находить мелодию во всём."
    voice "voice/Polina/4day/22 De.ogg"
    Pol "Дзядуля вучыць знаходзіць мелодыю ва ўсім."

# game/scripts/scene/scene_day_4.rpy:2334
translate belarusian d4_school_fox_betray_b7ed3c77:

    # voice "voice/anton/4day/67. On.ogg"
    # Ant "Он у тебя философ."
    voice "voice/anton/4day/67. On.ogg"
    Ant "Ён у цябе філосаф."

# game/scripts/scene/scene_day_4.rpy:2336
translate belarusian d4_school_fox_betray_f4f3acb2:

    # voice "voice/Polina/4day/41 Kra.ogg"
    # Pol "Краевед... Был раньше."
    voice "voice/Polina/4day/41 Kra.ogg"
    Pol "Краязнаўца... Быў раней."

# game/scripts/scene/scene_day_4.rpy:2338
translate belarusian d4_school_fox_betray_e166080a:

    # voice "voice/anton/4day/26. On.ogg"
    # Ant "Он, наверное, классный."
    voice "voice/anton/4day/26. On.ogg"
    Ant "Ён, напэўна, класны."

# game/scripts/scene/scene_day_4.rpy:2340
translate belarusian d4_school_fox_betray_b6f755d5:

    # voice "voice/Polina/4day/23 Ne.ogg"
    # Pol "Не то слово! Скоро я вас познакомлю."
    voice "voice/Polina/4day/23 Ne.ogg"
    Pol "Не тое слова! Хутка я вас пазнаёмлю."

# game/scripts/scene/scene_day_4.rpy:2342
translate belarusian d4_school_fox_betray_2ad96f91:

    # voice "voice/anton/4day/27. Ti.ogg"
    # Ant "Ты меня в гости приглашаешь?"
    voice "voice/anton/4day/27. Ti.ogg"
    Ant "Ты мяне ў госці запрашаеш?"

# game/scripts/scene/scene_day_4.rpy:2344
translate belarusian d4_school_fox_betray_cfd3c3b7:

    # voice "voice/Polina/4day/24 A.ogg"
    # Pol "А ты против?"
    voice "voice/Polina/4day/24 A.ogg"
    Pol "А ты супраць?"

# game/scripts/scene/scene_day_4.rpy:2346
translate belarusian d4_school_fox_betray_4259214e:

    # voice "voice/anton/4day/28. Net.ogg"
    # Ant "Нет! Конечно, нет!"
    voice "voice/anton/4day/28. Net.ogg"
    Ant "Не! Вядома, не!"

# game/scripts/scene/scene_day_4.rpy:2348
translate belarusian d4_school_fox_betray_205cf682:

    # "Тайком я рассматривал Полину."
    "Крадком я разглядаў Паліну."

# game/scripts/scene/scene_day_4.rpy:2349
translate belarusian d4_school_fox_betray_3b4ac06b:

    # "Она казалась драгоценным камнем, чьи грани переливаются, мерцают, неуловимо меняясь."
    "Яна здавалася каштоўным каменем, грані якога пераліваюцца, мігцяць, няўлоўна мяняючыся."

# game/scripts/scene/scene_day_4.rpy:2350
translate belarusian d4_school_fox_betray_a846539f:

    # "«Что?» – спрашивали невинно её смеющиеся глаза."
    "«Што?» — нявінна пыталіся яе смешлівыя вочы."

# game/scripts/scene/scene_day_4.rpy:2351
translate belarusian d4_school_fox_betray_51ca9cfd:

    # "«То!» – молча отвечал я."
    "«Тое!» — моўчкі адказваў я."

# game/scripts/scene/scene_day_4.rpy:2352
translate belarusian d4_school_fox_betray_fa9b9a35:

    # voice "voice/Polina/4day/TiS.ogg"
    # Pol "Ты смелый. Мне это нравится."
    voice "voice/Polina/4day/TiS.ogg"
    Pol "Ты смелы. Мне гэта падабаецца."

# game/scripts/scene/scene_day_4.rpy:2354
translate belarusian d4_school_fox_betray_9db9a5b0:

    # voice "voice/anton/4day/Smel.ogg"
    # Ant "Смелый?"
    voice "voice/anton/4day/Smel.ogg"
    Ant "Смелы?"

# game/scripts/scene/scene_day_4.rpy:2356
translate belarusian d4_school_fox_betray_b3b62f5a:

    # voice "voice/Polina/4day/144 Ya.ogg"
    # Pol "Я до сих пор вспоминаю, как ты Бабурина осадил!"
    voice "voice/Polina/4day/144 Ya.ogg"
    Pol "Я дагэтуль успамінаю, як ты Бабурына асадзіў!"

# game/scripts/scene/scene_day_4.rpy:2358
translate belarusian d4_school_fox_betray_3c87ae3d:

    # voice "voice/anton/4day/30. Pu.ogg"
    # Ant "Пустяки."
    voice "voice/anton/4day/30. Pu.ogg"
    Ant "Дробязі."

# game/scripts/scene/scene_day_4.rpy:2360
translate belarusian d4_school_fox_betray_b7316e92:

    # voice "voice/Polina/4day/145 Zna.ogg"
    # Pol "Знаешь, как для девочек важно, чтобы их защищали!"
    voice "voice/Polina/4day/145 Zna.ogg"
    Pol "Ведаеш, як для дзяўчынак важна, каб іх абаранялі!"

# game/scripts/scene/scene_day_4.rpy:2362
translate belarusian d4_school_fox_betray_e6c73e99:

    # voice "voice/anton/4day/31. Za.ogg"
    # Ant "Заступиться за тебя — честь."
    voice "voice/anton/4day/31. Za.ogg"
    Ant "Заступіцца за цябе — гонар."

# game/scripts/scene/scene_day_4.rpy:2364
translate belarusian d4_school_fox_betray_bc9bf51a:

    # voice "voice/Polina/4day/146 Vot.ogg"
    # Pol "Вот! Я же говорю!"
    voice "voice/Polina/4day/146 Vot.ogg"
    Pol "Вось! Я ж кажу!"

# game/scripts/scene/scene_day_4.rpy:2366
translate belarusian d4_school_fox_betray_1257c57d:

    # voice "voice/Polina/4day/147 Ez.ogg"
    # Pol "Изъясняешься словами из романов."
    voice "voice/Polina/4day/147 Ez.ogg"
    Pol "Выказваешся словамі з раманаў."

# game/scripts/scene/scene_day_4.rpy:2368
translate belarusian d4_school_fox_betray_e5c0c899:

    # voice "voice/Polina/4day/148 Eto.ogg"
    # Pol "Это честь для меня, моя госпожа!"
    voice "voice/Polina/4day/148 Eto.ogg"
    Pol "Гэта гонар для мяне, мая спадарыня!"

# game/scripts/scene/scene_day_4.rpy:2371
translate belarusian d4_school_fox_betray_279d72d0:

    # "Полина захихикала."
    "Паліна захіхікала."

# game/scripts/scene/scene_day_4.rpy:2373
translate belarusian d4_school_fox_betray_b665ff3b:

    # "Я надулся притворно, но не сумел удержаться и тоже улыбнулся." id d4_school_fox_betray_b665ff3b
    "Я надуўся ўдавана, але не здолеў стрымацца і таксама ўсміхнуўся."

# game/scripts/scene/scene_day_4.rpy:2392
translate belarusian d4_school_fox_voltron_67590f4d:

    # voice "voice/anton/4day/33. Poch.ogg"
    # Ant "Почему бы и нет... Давай."
    voice "voice/anton/4day/33. Poch.ogg"
    Ant "Чаму б і не... Давай."

# game/scripts/scene/scene_day_4.rpy:2397
translate belarusian d4_school_fox_voltron_f8a1f690:

    # voice "voice/Polina/4day/149 Togda.ogg"
    # Pol "Тогда после алгебры на заднем дворе."
    voice "voice/Polina/4day/149 Togda.ogg"
    Pol "Тады пасля алгебры на заднім двары."

# game/scripts/scene/scene_day_4.rpy:2411
translate belarusian d4_school_fox_voltron_4704f65d:

    # "Она привстала и снова посмотрела на меня своими пронзительными глазами."
    "Яна прыўстала і зноў паглядзела на мяне сваімі пранізлівымі вачыма."

# game/scripts/scene/scene_day_4.rpy:2412
translate belarusian d4_school_fox_voltron_34598843:

    # "Пробормотала, гадая:"
    "Прамармытала, гадаючы:"

# game/scripts/scene/scene_day_4.rpy:2415
translate belarusian d4_school_fox_voltron_201fbf08:

    # voice "voice/Polina/4day/18 Ch.ogg"
    # Pol "Что-то из Мусоргского?"
    voice "voice/Polina/4day/18 Ch.ogg"
    Pol "Нешта з Мусаргскага?"

# game/scripts/scene/scene_day_4.rpy:2419
translate belarusian d4_school_fox_voltron_104b473b:

    # voice "voice/Polina/4day/19 Ne.ogg"
    # Pol "Нет, пожалуй."
    voice "voice/Polina/4day/19 Ne.ogg"
    Pol "Не, бадай."

# game/scripts/scene/scene_day_4.rpy:2471
translate belarusian d4_school_fox_voltron_6bf60af3:

    # "И ушла, а вместо неё в проходе вырос Ромка. Он плюхнулся ко мне за парту и зашептал на ухо:"
    "І сышла, а замест яе ў праходзе вырас Ромка. Ён плюхнуўся да мяне за парту і зашаптаў на вуха:"

# game/scripts/scene/scene_day_4.rpy:2474
translate belarusian d4_school_fox_voltron_ee43f8ff:

    # voice "voice/romka/4day/79 Ti.ogg"
    # Rom "Ты с ней говорил?"
    voice "voice/romka/4day/79 Ti.ogg"
    Rom "Ты з ёй гаварыў?"

# game/scripts/scene/scene_day_4.rpy:2500
translate belarusian d4_school_fox_voltron_7f3767b1:

    # "Бяша проковылял к нам, но Рома осадил его сердитым взором:"
    "Бяша пракульгаў да нас, але Рома асадзіў яго сярдзітым позіркам:"

# game/scripts/scene/scene_day_4.rpy:2507
translate belarusian d4_school_fox_voltron_aca3f6e3:

    # voice "voice/romka/4day/80 Bya.ogg"
    # Rom "Бяш, отвали на пару минут."
    voice "voice/romka/4day/80 Bya.ogg"
    Rom "Бяш, адвалі на пару хвілін."

# game/scripts/scene/scene_day_4.rpy:2532
translate belarusian d4_school_fox_voltron_b6c681d8:

    # "Тот обиженно поджал губы и скрылся из класса."
    "Той пакрыўджана падціснуў вусны і знік з класа."

# game/scripts/scene/scene_day_4.rpy:2535
translate belarusian d4_school_fox_voltron_9c12a822:

    # "Рома опять повернулся ко мне:"
    "Рома зноў павярнуўся да мяне:"

# game/scripts/scene/scene_day_4.rpy:2537
translate belarusian d4_school_fox_voltron_e90a36f1:

    # voice "voice/romka/4day/81 Nu.ogg"
    # Rom "Ну? Говорил или нет?"
    voice "voice/romka/4day/81 Nu.ogg"
    Rom "Ну? Гаварыў ці не?"

# game/scripts/scene/scene_day_4.rpy:2541
translate belarusian d4_school_fox_voltron_dd5a53eb:

    # voice "voice/romka/4day/82 Ona.ogg"
    # Rom "Она что-то сказала про меня?"
    voice "voice/romka/4day/82 Ona.ogg"
    Rom "Яна нешта сказала пра мяне?"

# game/scripts/scene/scene_day_4.rpy:2552
translate belarusian d4_school_fox_voltron_a156606b:

    # "Мне хотелось улыбаться печально и обречённо."
    "Мне хацелася ўсміхацца сумна і асуджана."

# game/scripts/scene/scene_day_4.rpy:2553
translate belarusian d4_school_fox_voltron_dc72f573:

    # "Ромка, капитан команды Вольтрона, был влюблён, действительно влюблён!"
    "Ромка, капітан каманды Вальтрона, быў закаханы, сапраўды закаханы!"

# game/scripts/scene/scene_day_4.rpy:2554
translate belarusian d4_school_fox_voltron_fd5f74b1:

    # "В его взгляде кипела надежда, мольба, тревога."
    "У яго позірку кіпелі надзея, мальба, трывога."

# game/scripts/scene/scene_day_4.rpy:2555
translate belarusian d4_school_fox_voltron_1b3d80b0:

    # "И это делало его совсем наивным мальчиком, который оградился от мира спортом, резкими движениями и холодностью."
    "І гэта рабіла яго зусім наіўным хлопчыкам, які адгарадзіўся ад свету спортам, рэзкімі рухамі і халоднасцю."

# game/scripts/scene/scene_day_4.rpy:2559
translate belarusian d4_school_fox_voltron_7c9864d3:

    # "Мог ли я предать его сейчас, когда он так уязвим?"
    "Ці мог я здрадзіць яму цяпер, калі ён такі ўразлівы?"

# game/scripts/scene/scene_day_4.rpy:2560
translate belarusian d4_school_fox_voltron_86355496:

    # "Мог ли сделать правильный выбор в ситуации, где нет ничего правильного?"
    "Ці мог зрабіць правільны выбар у сітуацыі, дзе няма нічога правільнага?"

# game/scripts/scene/scene_day_4.rpy:2562
translate belarusian d4_school_fox_voltron_bf91bec6:

    # "Я проговорил, откашлявшись:"
    "Я прамовіў, адкашляўшыся:"

# game/scripts/scene/scene_day_4.rpy:2565
translate belarusian d4_school_fox_voltron_bb5a383f:

    # voice "voice/anton/4day/35. Ona.ogg"
    # Ant "Она спрашивала, где ты будешь после уроков."
    voice "voice/anton/4day/35. Ona.ogg"
    Ant "Яна пыталася, дзе ты будзеш пасля ўрокаў."

# game/scripts/scene/scene_day_4.rpy:2579
translate belarusian d4_school_fox_voltron_628b18c1:

    # "Лицо его стоило того, чтоб соврать, — оно буквально засветилось от счастья."
    "Твар яго быў варты таго, каб схлусіць, — ён літаральна засвяціўся ад шчасця."

# game/scripts/scene/scene_day_4.rpy:2581
translate belarusian d4_school_fox_voltron_9fff7b06:

    # voice "voice/romka/4day/83 A.ogg"
    # Rom "А ты что?"
    voice "voice/romka/4day/83 A.ogg"
    Rom "А ты што?"

# game/scripts/scene/scene_day_4.rpy:2584
translate belarusian d4_school_fox_voltron_d6a51a75:

    # voice "voice/anton/4day/36. Sk.ogg"
    # Ant "Сказал, что ты будешь на заднем дворе."
    voice "voice/anton/4day/36. Sk.ogg"
    Ant "Сказаў, што ты будзеш на заднім двары."

# game/scripts/scene/scene_day_4.rpy:2587
translate belarusian d4_school_fox_voltron_e6058462:

    # "Ромка взволнованно облизнул губы. Вцепился мне в запястье – я испугался, что сломает."
    "Ромка ўсхвалявана аблізнуў вусны. Учапіўся мне ў запясце — я спалохаўся, што зламае."

# game/scripts/scene/scene_day_4.rpy:2590
translate belarusian d4_school_fox_voltron_4f3f3bbf:

    # voice "voice/romka/4day/85 Nut.ogg"
    # Rom "Ну Тоха! Ну спасибо, друг!"
    voice "voice/romka/4day/85 Nut.ogg"
    Rom "Ну Тоха! Ну дзякуй, сябра!"

# game/scripts/scene/scene_day_4.rpy:2594
translate belarusian d4_school_fox_voltron_37693a38:

    # voice "voice/romka/4day/86 Po.ogg"
    # Rom "Погнали скорее готовиться!"
    voice "voice/romka/4day/86 Po.ogg"
    Rom "Пагналі хутчэй рыхтавацца!"

# game/scripts/scene/scene_day_4.rpy:2598
translate belarusian d4_school_fox_voltron_35adf81b:

    # voice "voice/romka/4day/87 Sh.ogg"
    # Rom "Ща мы ей закатим такую шоу-программу, что прям ого-го!"
    voice "voice/romka/4day/87 Sh.ogg"
    Rom "Зараз мы ёй закацім такую шоу-праграму, што проста ого-го!"

# game/scripts/scene/scene_day_4.rpy:2622
translate belarusian d4_school_fox_voltron_24a9d506:

    # "Он ушёл к ворчащему в коридоре Бяше, а я, оцепенев, уставился на пустой стул Полины. "
    "Ён пайшоў да Бяшы, які бурчаў у калідоры, а я, здранцвеўшы, утаропіўся на пустое крэсла Паліны. "

# game/scripts/scene/scene_day_4.rpy:2624
translate belarusian d4_school_fox_voltron_f57464f1:

    # "Только что я променял одну дружбу на другую."
    "Толькі што я прамяняў адно сяброўства на другое."

# game/scripts/scene/scene_day_4.rpy:2625
translate belarusian d4_school_fox_voltron_b13023a3:

    # "Оставалось лишь надеяться, что я не прогадал."
    "Заставалася толькі спадзявацца, што я не прагадаў."

# game/scripts/scene/scene_day_4.rpy:2638
translate belarusian d4_school_fox_voltron_a5037b9d:

    # "Эхо звонка металось по мрачным закоулкам школы."
    "Рэха званка мяталася па змрочных закутках школы."

# game/scripts/scene/scene_day_4.rpy:2660
translate belarusian d4_school_fox_voltron_bf5dff60:

    # "Наспех застёгивая куртку, я выпорхнул во двор."
    "Наспех зашпільваючы куртку, я выпырхнуў у двор."

# game/scripts/scene/scene_day_4.rpy:2664
translate belarusian d4_school_fox_voltron_b3fd8890:

    # "Синоптики не соврали, пророча метель."
    "Сіноптыкі не схлусілі, прадракаючы мяцеліцу."

# game/scripts/scene/scene_day_4.rpy:2665
translate belarusian d4_school_fox_voltron_a71b184e:

    # "С севера наползало свинцовое облако. В нём клокотал могучий рёв."
    "З поўначы напаўзала свінцовае воблака. У ім клекатаў магутны роў."

# game/scripts/scene/scene_day_4.rpy:2688
translate belarusian d4_school_fox_voltron_e7a699e3:

    # "Дети вставали спиной к ветру и смеялись, когда порывы толкали их по катку."
    "Дзеці станавіліся спінай да ветру і смяяліся, калі парывы штурхалі іх па катку."

# game/scripts/scene/scene_day_4.rpy:2689
translate belarusian d4_school_fox_voltron_472e8069:

    # "Вьюга уносила смех в фиолетовую даль."
    "Завея адносіла смех у фіялетавую далеч."

# game/scripts/scene/scene_day_4.rpy:2710
translate belarusian d4_school_fox_voltron_8dd5c0ea:

    # "Ромка бросился ко мне, как только заметил на привычно пустом пятачке за школой."
    "Ромка кінуўся да мяне, як толькі заўважыў на звыкла пустым пятачку за школай."

# game/scripts/scene/scene_day_4.rpy:2713
translate belarusian d4_school_fox_voltron_508fed88:

    # voice "voice/romka/4day/88 G.ogg"
    # Rom "Готов? Точно не сдрейфишь?"
    voice "voice/romka/4day/88 G.ogg"
    Rom "Гатовы? Дакладна не здрэйфіш?"

# game/scripts/scene/scene_day_4.rpy:2717
translate belarusian d4_school_fox_voltron_712ea98f:

    # voice "voice/romka/4day/89 V.ogg"
    # Rom "Второго шанса не будет."
    voice "voice/romka/4day/89 V.ogg"
    Rom "Другога шансу не будзе."

# game/scripts/scene/scene_day_4.rpy:2720
translate belarusian d4_school_fox_voltron_7bfba25a:

    # "Я не был готов. Абсолютно."
    "Я не быў гатовы. Абсалютна."

# game/scripts/scene/scene_day_4.rpy:2721
translate belarusian d4_school_fox_voltron_1a42f2b0:

    # "Живот покалывал, требовал убираться, не ввязываться в заранее проигрышное дело."
    "Жывот паколваў, патрабаваў вымятацца, не ўвязвацца ў загадзя пройгрышную справу."

# game/scripts/scene/scene_day_4.rpy:2722
translate belarusian d4_school_fox_voltron_efd9a963:

    # "Но бросить Ромку на полпути я уже не мог из принципа."
    "Але кінуць Ромку на паўдарозе я ўжо не мог з прынцыпу."

# game/scripts/scene/scene_day_4.rpy:2723
translate belarusian d4_school_fox_voltron_2606b440:

    # "Тот тем временем, загибая испачканные в чернилах пальцы, судорожно пересчитывал реквизит."
    "Той тым часам, загінаючы запэцканыя ў чарніле пальцы, сутаргава пералічваў рэквізіт."

# game/scripts/scene/scene_day_4.rpy:2725
translate belarusian d4_school_fox_voltron_40b5c4ac:

    # voice "voice/romka/4day/90 B.ogg"
    # Rom "Букет есть."
    voice "voice/romka/4day/90 B.ogg"
    Rom "Букет ёсць."

# game/scripts/scene/scene_day_4.rpy:2729
translate belarusian d4_school_fox_voltron_8443ae50:

    # voice "voice/romka/4day/91 M.ogg"
    # Rom "Маньяк присутствует."
    voice "voice/romka/4day/91 M.ogg"
    Rom "Маньяк прысутнічае."

# game/scripts/scene/scene_day_4.rpy:2733
translate belarusian d4_school_fox_voltron_819ea8a3:

    # voice "voice/romka/4day/92 Ch.ogg"
    # Rom "Чё там ещё?"
    voice "voice/romka/4day/92 Ch.ogg"
    Rom "Што там яшчэ?"

# game/scripts/scene/scene_day_4.rpy:2736
translate belarusian d4_school_fox_voltron_cc90f4d6:

    # voice "voice/anton/4day/37.A.ogg"
    # Ant "А что с моим образом?"
    voice "voice/anton/4day/37.A.ogg"
    Ant "А што з маім вобразам?"

# game/scripts/scene/scene_day_4.rpy:2738
translate belarusian d4_school_fox_voltron_2be82097:

    # voice "voice/anton/4day/37.Gde.ogg"
    # Ant "Где мой топор или там..."
    voice "voice/anton/4day/37.Gde.ogg"
    Ant "Дзе мая сякера ці там..."

# game/scripts/scene/scene_day_4.rpy:2740
translate belarusian d4_school_fox_voltron_ccd9a42e:

    # voice "voice/anton/4day/37.M.ogg"
    # Ant "...маска." id d4_school_fox_voltron_ccd9a42e
    voice "voice/anton/4day/37.M.ogg"
    Ant "...маска."

# game/scripts/scene/scene_day_4.rpy:2743
translate belarusian d4_school_fox_voltron_2be3e561:

    # voice "voice/romka/4day/93 Da.ogg"
    # Rom "Да не гони, Тоха!"
    voice "voice/romka/4day/93 Da.ogg"
    Rom "Ды не гані, Тоха!"

# game/scripts/scene/scene_day_4.rpy:2747
translate belarusian d4_school_fox_voltron_c7288153:

    # voice "voice/romka/4day/94 Na.ogg"
    # Rom "Надень ту заячью, что с собой по жизни таскаешь."
    voice "voice/romka/4day/94 Na.ogg"
    Rom "Надзень тую заячую, што з сабой па жыцці цягаеш."

# game/scripts/scene/scene_day_4.rpy:2751
translate belarusian d4_school_fox_voltron_18c5e83b:

    # voice "voice/romka/4day/95 To.ogg"
    # Rom "Только резче! Нельзя, чтобы Полина нас видела вместе."
    voice "voice/romka/4day/95 To.ogg"
    Rom "Толькі жвавей! Нельга, каб Паліна нас бачыла разам."

# game/scripts/scene/scene_day_4.rpy:2762
translate belarusian d4_school_fox_voltron_8a20785a:

    # "Я с недоверием поглядел на Ромку, но пальцы уже нащупали бегунок на молнии рюкзака и потянули за него в предвкушении."
    "Я з недаверам паглядзеў на Ромку, але пальцы ўжо намацалі бягунок на маланцы рукзака і пацягнулі за яго ў прадчуванні."

# game/scripts/scene/scene_day_4.rpy:2769
translate belarusian d4_school_fox_voltron_7ecade9d:

    # "Вместо того чтобы удивиться, я испытал лишь облегчение, вытащив наружу моё настоящее «лицо»."
    "Замест таго каб здзівіцца, я адчуў толькі палёгку, выцягнуўшы вонкі мой сапраўдны «твар»."

# game/scripts/scene/scene_day_4.rpy:2781
translate belarusian d4_school_fox_voltron_659411f8:

    # "Вместе с ним пришло спокойствие — и колики улеглись."
    "Разам з ім прыйшоў спакой — і колікі суняліся."

# game/scripts/scene/scene_day_4.rpy:2782
translate belarusian d4_school_fox_voltron_2c529c82:

    # "Я вспомнил ощущение полёта, невесомости, счастья."
    "Я ўспомніў адчуванне палёту, бязважкасці, шчасця."

# game/scripts/scene/scene_day_4.rpy:2783
translate belarusian d4_school_fox_voltron_3d865891:

    # "Тут же проблемы Ромки показались до зевоты мелочными и несущественными."
    "Тут жа праблемы Ромкі падаліся да пазяхання дробязнымі і неістотнымі."

# game/scripts/scene/scene_day_4.rpy:2785
translate belarusian d4_school_fox_voltron_24ee1bf9:

    # voice "voice/romka/4day/96 Da.ogg"
    # Rom "Давай, как репетировали."
    voice "voice/romka/4day/96 Da.ogg"
    Rom "Давай, як рэпетавалі."

# game/scripts/scene/scene_day_4.rpy:2789
translate belarusian d4_school_fox_voltron_517b6e3b:

    # voice "voice/romka/4day/97 To.ogg"
    # Rom "Только она появится..."
    voice "voice/romka/4day/97 To.ogg"
    Rom "Толькі яна з'явіцца..."

# game/scripts/scene/scene_day_4.rpy:2793
translate belarusian d4_school_fox_voltron_ca936995:

    # voice "voice/anton/4day/38. Ya.ogg"
    # Ant "Я прегражу ей дорогу."
    voice "voice/anton/4day/38. Ya.ogg"
    Ant "Я перагараджу ёй дарогу."

# game/scripts/scene/scene_day_4.rpy:2799
translate belarusian d4_school_fox_voltron_bbeded7f:

    # voice "voice/romka/4day/98 A.ogg"
    # Rom "Ага, а я из-за тех кустов такой – бац! – и на выручку!"
    voice "voice/romka/4day/98 A.ogg"
    Rom "Ага, а я з-за тых кустоў такі — бац! — і на выручку!"

# game/scripts/scene/scene_day_4.rpy:2803
translate belarusian d4_school_fox_voltron_b5e278e1:

    # voice "voice/romka/4day/99 T.ogg"
    # Rom "Только веди себя посмелее, Тошик."
    voice "voice/romka/4day/99 T.ogg"
    Rom "Толькі паводзь сябе смялей, Тошык."

# game/scripts/scene/scene_day_4.rpy:2807
translate belarusian d4_school_fox_voltron_a3d94a44:

    # voice "voice/romka/4day/100 Ch.ogg"
    # Rom "Чтоб как взаправду."
    voice "voice/romka/4day/100 Ch.ogg"
    Rom "Каб як па-сапраўднаму."

# game/scripts/scene/scene_day_4.rpy:2810
translate belarusian d4_school_fox_voltron_3e83d28c:

    # voice "voice/anton/4day/39. Y.ogg"
    # Ant "Я постараюсь себя не сдерживать."
    voice "voice/anton/4day/39. Y.ogg"
    Ant "Я пастараюся сябе не стрымліваць."

# game/scripts/scene/scene_day_4.rpy:2812
translate belarusian d4_school_fox_voltron_10007d87:

    # "Простой кусочек картона и шерсти нёс в себе энергию, которая могла соперничать с яростью метели."
    "Просты кавалачак кардону і поўсці нёс у сабе энергію, якая магла спаборнічаць з лютасцю мяцеліцы."

# game/scripts/scene/scene_day_4.rpy:2836
translate belarusian d4_school_fox_voltron_18b14bd2:

    # "И я не без удовольствия натянул настоящее лицо поверх очков."
    "І я не без задавальнення нацягнуў сапраўдны твар паверх акуляраў."

# game/scripts/scene/scene_day_4.rpy:2856
translate belarusian d4_school_fox_voltron_d8825a98:

    # "Поправил его, чтобы глаза смотрели точно в прорези."
    "Паправіў яго, каб вочы глядзелі дакладна ў прарэзы."

# game/scripts/scene/scene_day_4.rpy:2857
translate belarusian d4_school_fox_voltron_78e21b39:

    # "Ромка исчез."
    "Ромка знік."

# game/scripts/scene/scene_day_4.rpy:2877
translate belarusian d4_school_fox_voltron_15a5ef0b:

    # "А из-за школы вышла, оглядываясь, Полина."
    "А з-за школы выйшла, азіраючыся, Паліна."

# game/scripts/scene/scene_day_4.rpy:2878
translate belarusian d4_school_fox_voltron_2eb27fef:

    # "Футляр из-под скрипки был неизменно с ней. Сапожки скрипели на свежем снегу."
    "Футляр ад скрыпкі быў нязменна з ёй. Боцікі рыпелі на свежым снезе."

# game/scripts/scene/scene_day_4.rpy:2882
translate belarusian d4_school_fox_voltron_55985140:

    # "Тучи проглотили солнце, и темнота обратила меня в длинноухий силуэт."
    "Хмары праглынулі сонца, і цемра ператварыла мяне ў даўгавухі сілуэт."

# game/scripts/scene/scene_day_4.rpy:2884
translate belarusian d4_school_fox_voltron_1e14ca41:

    # "С сомнением посмотрев в мою сторону, Полина начала огибать площадку."
    "З сумневам паглядзеўшы ў мой бок, Паліна пачала абыходзіць пляцоўку."

# game/scripts/scene/scene_day_4.rpy:2904
translate belarusian d4_school_fox_voltron_ddbaf772:

    # "Хе-хе! Значит, не узнала."
    "Хе-хе! Значыць, не пазнала."

# game/scripts/scene/scene_day_4.rpy:2933
translate belarusian d4_school_fox_voltron_d9529f36:

    # "Я шагнул наперерез, совершенно не заботясь, что мой рост или одежда могли подсказать Полине, кто перед ней."
    "Я ступіў наперарэз, зусім не турбуючыся, што мой рост ці адзенне маглі падказаць Паліне, хто перад ёй."

# game/scripts/scene/scene_day_4.rpy:2934
translate belarusian d4_school_fox_voltron_71849bbf:

    # voice "voice/anton/4day/40. Ti.ogg"
    # Ant "{i}Ты, случаем, не потерялась, деточка?{/i} "
    voice "voice/anton/4day/40. Ti.ogg"
    Ant "{i}Ты, выпадкам, не згубілася, дзіцятка?{/i} "

# game/scripts/scene/scene_day_4.rpy:2964
translate belarusian d4_school_fox_voltron_f3b7c20b:

    # "Хмурясь, она потеснилась к кустам."
    "Хмурачыся, яна пасунулася да кустоў."

# game/scripts/scene/scene_day_4.rpy:2987
translate belarusian d4_school_fox_voltron_6ed23d23:

    # "Из-за них тут же показался чертыхающийся Ромка."
    "З-за іх тут жа, чартыхаючыся, паказаўся Ромка."

# game/scripts/scene/scene_day_4.rpy:3008
translate belarusian d4_school_fox_voltron_48d13521:

    # "Он неуклюже двигался боком, словно краб, и всё так же прятал руку с цветами за спиной."
    "Ён нязграбна рухаўся бокам, нібы краб, і ўсё гэтак жа хаваў руку з кветкамі за спінай."

# game/scripts/scene/scene_day_4.rpy:3010
translate belarusian d4_school_fox_voltron_3a1fc47d:

    # voice "voice/romka/4day/102E.ogg"
    # Rom "Эй, садист проклятый!"
    voice "voice/romka/4day/102E.ogg"
    Rom "Гэй, садыст пракляты!"

# game/scripts/scene/scene_day_4.rpy:3014
translate belarusian d4_school_fox_voltron_6b51b9ea:

    # voice "voice/romka/4day/103 P.ogg"
    # Rom "Пока я здесь, никто не обидит эту д-девушку."
    voice "voice/romka/4day/103 P.ogg"
    Rom "Пакуль я тут, ніхто не пакрыўдзіць гэтую дз-дзяўчыну."

# game/scripts/scene/scene_day_4.rpy:3018
translate belarusian d4_school_fox_voltron_3d5930a5:

    # voice "voice/romka/4day/104 Po.ogg"
    # Rom "Понял... ты?"
    voice "voice/romka/4day/104 Po.ogg"
    Rom "Зразумеў... ты?"

# game/scripts/scene/scene_day_4.rpy:3021
translate belarusian d4_school_fox_voltron_59d82fb7:

    # "Под маской я страдальчески вскинул брови."
    "Пад маскай я пакутліва ўскінуў бровы."

# game/scripts/scene/scene_day_4.rpy:3022
translate belarusian d4_school_fox_voltron_8472bc6a:

    # "Интонация Ромки была фальшивой и откровенно идиотской. На репетиции он отыгрывал во сто крат уверенней."
    "Інтанацыя Ромкі была фальшывай і адкрыта ідыёцкай. На рэпетыцыі ён адыгрываў у сто разоў больш упэўнена."

# game/scripts/scene/scene_day_4.rpy:3034
translate belarusian d4_school_fox_voltron_b3ef2a78:

    # "Но я не подал виду, и, нагло схватив Полину за воротник, подтянул к себе."
    "Але я не падаў выгляду і, нахабна схапіўшы Паліну за каўнер, падцягнуў да сябе."

# game/scripts/scene/scene_day_4.rpy:3035
translate belarusian d4_school_fox_voltron_3653c14e:

    # "Пальцы пробежали по её шелковистым локонам."
    "Пальцы прабеглі па яе шаўкавістых локанах."

# game/scripts/scene/scene_day_4.rpy:3047
translate belarusian d4_school_fox_voltron_b69bd783:

    # "Полина возмущённо ойкнула, но я только ухмыльнулся."
    "Паліна абурана ойкнула, але я толькі ўхмыльнуўся."

# game/scripts/scene/scene_day_4.rpy:3072
translate belarusian d4_school_fox_voltron_00e8fc0b:

    # "Чувства вседозволенности и безнаказанности захлестнули меня."
    "Пачуцці ўседазволенасці і беспакаранасці захліснулі мяне."

# game/scripts/scene/scene_day_4.rpy:3073
translate belarusian d4_school_fox_voltron_3bff19b8:

    # "Я намерился завалить Полинку на землю и тискать до синяков, пока несущий околёсицу Ромка не научится актёрствовать как надо."
    "Я намерыўся заваліць Палінку на зямлю і ціскаць да сінякоў, пакуль Ромка, які вярзе лухту, не навучыцца акцёрстваваць як трэба."

# game/scripts/scene/scene_day_4.rpy:3091
translate belarusian d4_school_fox_voltron_93330d21:

    # voice "voice/romka/4day/106 G.ogg"
    # Rom "Говорю, не тронь!"
    voice "voice/romka/4day/106 G.ogg"
    Rom "Кажу, не чапай!"

# game/scripts/scene/scene_day_4.rpy:3095
translate belarusian d4_school_fox_voltron_e08f2e27:

    # "Но я не послушал и продолжил, пьянея от собственной власти, от того, что растерявшийся Ромка мямлил себе под нос."
    "Але я не паслухаў і працягнуў, п'янеючы ад уласнай улады, ад таго, што разгублены Ромка мямліў сабе пад нос."

# game/scripts/scene/scene_day_4.rpy:3096
translate belarusian d4_school_fox_voltron_45abd46f:

    # "А я мог делать что угодно под покровом заячьей личины."
    "А я мог рабіць што заўгодна пад покрывам заячай лічыны."

# game/scripts/scene/scene_day_4.rpy:3127
translate belarusian d4_school_fox_voltron_1db1ca93:

    # voice "voice/anton/4day/41. Pro.ogg"
    # Bunny "Прояви терпение, рохля! "
    voice "voice/anton/4day/41. Pro.ogg"
    Bunny "Праяві цярпенне, размазня! "

# game/scripts/scene/scene_day_4.rpy:3129
translate belarusian d4_school_fox_voltron_1dc54233:

    # voice "voice/anton/4day/42. S.ogg"
    # Bunny "Сейчас закончу с девчонкой и обязательно возьмусь за тебя."
    voice "voice/anton/4day/42. S.ogg"
    Bunny "Зараз скончу з дзяўчынкай і абавязкова вазьмуся за цябе."

# game/scripts/scene/scene_day_4.rpy:3148
translate belarusian d4_school_fox_voltron_ffc5263e:

    # "У Ромки даже округлились глаза от удивления, и было видно, что он какое-то время пытался сохранить самообладание, чтобы не выйти из роли."
    "У Ромкі нават акругліліся вочы ад здзіўлення, і было відаць, што ён нейкі час спрабаваў захаваць самавалоданне, каб не выйсці з ролі."

# game/scripts/scene/scene_day_4.rpy:3149
translate belarusian d4_school_fox_voltron_0499387a:

    # "Но, прежде чем новоиспечённый герой хоть что-то предпринял, его опередила Полина."
    "Але, перш чым новаспечаны герой хоць нешта зрабіў, яго апярэдзіла Паліна."

# game/scripts/scene/scene_day_4.rpy:3176
translate belarusian d4_school_fox_voltron_f82069f6:

    # voice "voice/Polina/4day/152 Tak.ogg"
    # Pol "Так, что тут происходит? "
    voice "voice/Polina/4day/152 Tak.ogg"
    Pol "Так, што тут адбываецца? "

# game/scripts/scene/scene_day_4.rpy:3180
translate belarusian d4_school_fox_voltron_d81d0d4d:

    # voice "voice/Polina/4day/153 P.ogg"
    # Pol "Пятифан, ты уберёшь своего дружка?"
    voice "voice/Polina/4day/153 P.ogg"
    Pol "Пяціфан, ты прыбярэш свайго сябрука?"

# game/scripts/scene/scene_day_4.rpy:3232
translate belarusian d4_school_fox_voltron_a533d4e9:

    # "Полина наотмашь стукнула меня футляром так, что я мигом протрезвел."
    "Паліна наводмаш стукнула мяне футлярам так, што я мігам працверазеў."

# game/scripts/scene/scene_day_4.rpy:3245
translate belarusian d4_school_fox_voltron_943af9dc:

    # voice "voice/romka/4day/108 Ya.ogg"
    # Rom "Я же... Он мне..."
    voice "voice/romka/4day/108 Ya.ogg"
    Rom "Я ж... Ён мне..."

# game/scripts/scene/scene_day_4.rpy:3256
translate belarusian d4_school_fox_voltron_20a7ad95:

    # voice "voice/Polina/4day/155 D.ogg"
    # Pol "Думаете, я вчера на свет появилась?"
    voice "voice/Polina/4day/155 D.ogg"
    Pol "Думаеце, я ўчора на свет з'явілася?"

# game/scripts/scene/scene_day_4.rpy:3260
translate belarusian d4_school_fox_voltron_d4f0035e:

    # voice "voice/Polina/4day/156 B.ogg"
    # Pol "Бяша, небось? Или..."
    voice "voice/Polina/4day/156 B.ogg"
    Pol "Бяша, мусіць? Ці..."

# game/scripts/scene/scene_day_4.rpy:3263
translate belarusian d4_school_fox_voltron_e212ff99:

    # "Она внимательно посмотрела на меня, словно могла видеть сквозь картонную маску."
    "Яна ўважліва паглядзела на мяне, нібы магла бачыць скрозь кардонную маску."

# game/scripts/scene/scene_day_4.rpy:3264
translate belarusian d4_school_fox_voltron_d0ec6310:

    # "И даже в тусклом освещении я видел, как порозовело её негодующее личико."
    "І нават у цьмяным асвятленні я бачыў, як паружавеў яе абураны тварык."

# game/scripts/scene/scene_day_4.rpy:3266
translate belarusian d4_school_fox_voltron_50212038:

    # voice "voice/Polina/4day/157 An.ogg"
    # Pol "Антон?"
    voice "voice/Polina/4day/157 An.ogg"
    Pol "Антон?"

# game/scripts/scene/scene_day_4.rpy:3270
translate belarusian d4_school_fox_voltron_f74bcc07:

    # voice "voice/Polina/4day/158 Vot.ogg"
    # Pol "Вот не думала, что ты такой."
    voice "voice/Polina/4day/158 Vot.ogg"
    Pol "Вось не думала, што ты такі."

# game/scripts/scene/scene_day_4.rpy:3288
translate belarusian d4_school_fox_voltron_ac8cd650:

    # "Я замычал, ища оправдание, втайне надеясь, что Ромка опередит меня и всё объяснит."
    "Я замычаў, шукаючы апраўданне, употай спадзяючыся, што Ромка апярэдзіць мяне і ўсё растлумачыць."

# game/scripts/scene/scene_day_4.rpy:3289
translate belarusian d4_school_fox_voltron_9d26f6d9:

    # "Но фиговейший из актёров пялился на сугробы и краснел от стыда."
    "Але самы фіговы з акцёраў лупіў вочы на гурбы і чырванеў ад сораму."

# game/scripts/scene/scene_day_4.rpy:3290
translate belarusian d4_school_fox_voltron_ae0f0019:

    # "Спланировать такое шоу и так облажаться!"
    "Спланаваць такое шоу і так аблажацца!"

# game/scripts/scene/scene_day_4.rpy:3291
translate belarusian d4_school_fox_voltron_4fb80ada:

    # "Полина смотрела на нас, сжав кулаки, и вдруг выкрикнула:"
    "Паліна глядзела на нас, сціснуўшы кулакі, і раптам выкрыкнула:"

# game/scripts/scene/scene_day_4.rpy:3330
translate belarusian d4_school_fox_voltron_dfc9e1c8:

    # voice "voice/Polina/4day/159 K.ogg"
    # Pol "Клоуны!"
    voice "voice/Polina/4day/159 K.ogg"
    Pol "Клоуны!"

# game/scripts/scene/scene_day_4.rpy:3366
translate belarusian d4_school_fox_voltron_18738e7a:

    # "Крик-вердикт ещё бился о школьные стены, как попавший в ловушку голубь, а Полина кинулась прочь от нас по заснеженному асфальту."
    "Крык-вердыкт яшчэ біўся аб школьныя сцены, як голуб, што трапіў у пастку, а Паліна кінулася прэч ад нас па заснежаным асфальце."

# game/scripts/scene/scene_day_4.rpy:3370
translate belarusian d4_school_fox_voltron_71f39b98:

    # "Она плеснула тенью, словно шлейфом платья, и скрылась за углом."
    "Яна плюснула ценем, нібы шлейфам сукенкі, і знікла за рогам."

# game/scripts/scene/scene_day_4.rpy:3381
translate belarusian d4_school_fox_voltron_cc710a17:

    # "Голова Ромки обречённо упала на грудь. Облезлый букет шлёпнулся в серую кашу мокрого снега."
    "Галава Ромкі асуджана ўпала на грудзі. Аблезлы букет шлёпнуўся ў шэрую кашу мокрага снегу."

# game/scripts/scene/scene_day_4.rpy:3382
translate belarusian d4_school_fox_voltron_1fdc2fc4:

    # voice "voice/romka/4day/109 E.ogg"
    # Rom "Это фиаско, братан!"
    voice "voice/romka/4day/109 E.ogg"
    Rom "Гэта фіяска, братан!"

# game/scripts/scene/scene_day_4.rpy:3402
translate belarusian d4_school_fox_voltron_51627011:

    # "Я снял маску со вспотевшего лица. Ветер остудил кожу."
    "Я зняў маску са спацелага твару. Вецер астудзіў скуру."

# game/scripts/scene/scene_day_4.rpy:3403
translate belarusian d4_school_fox_voltron_bcac9f74:

    # "С маской я словно стащил слепок посторонних мыслей и эмоций."
    "З маскай я нібы сцягнуў злепак старонніх думак і эмоцый."

# game/scripts/scene/scene_day_4.rpy:3405
translate belarusian d4_school_fox_voltron_f7cf369e:

    # "Ромка скрипел зубами, таращась под ноги."
    "Ромка скрыгатаў зубамі, утаропіўшыся пад ногі."

# game/scripts/scene/scene_day_4.rpy:3407
translate belarusian d4_school_fox_voltron_b23f68fd:

    # "Потерянный и подавленный, не умеющий, как и я, встречать контратакой удары судьбы."
    "Разгублены і прыгнечаны, ён, як і я, не ўмеў сустракаць контратакай удары лёсу."

# game/scripts/scene/scene_day_4.rpy:3408
translate belarusian d4_school_fox_voltron_953e97b7:

    # "Я видел, насколько ему плохо."
    "Я бачыў, наколькі яму кепска."

# game/scripts/scene/scene_day_4.rpy:3410
translate belarusian d4_school_fox_voltron_a8640f29:

    # "Он готов был крушить всё вокруг, биться лбом о бетон."
    "Ён гатовы быў крышыць усё навокал, біцца лбом аб бетон."

# game/scripts/scene/scene_day_4.rpy:3411
translate belarusian d4_school_fox_voltron_4962a73e:

    # "Что угодно, но только не попросить Полину вернуться."
    "Што заўгодна, але толькі не папрасіць Паліну вярнуцца."

# game/scripts/scene/scene_day_4.rpy:3412
translate belarusian d4_school_fox_voltron_4b06b5c7:

    # "Он был сильным и смелым, но так боялся показаться слабым, что это мешало ему жить."
    "Ён быў моцным і смелым, але так баяўся падацца слабым, што гэта перашкаджала яму жыць."

# game/scripts/scene/scene_day_4.rpy:3416
translate belarusian d4_school_fox_voltron_42ee8352:

    # "Решение пришло молниеносно. Я положил ладонь Ромке на плечо."
    "Рашэнне прыйшло маланкава. Я паклаў далонь Ромку на плячо."

# game/scripts/scene/scene_day_4.rpy:3417
translate belarusian d4_school_fox_voltron_ef23fed9:

    # voice "voice/anton/4day/45. Z.ogg"
    # Ant "Жди."
    voice "voice/anton/4day/45. Z.ogg"
    Ant "Чакай."

# game/scripts/scene/scene_day_4.rpy:3448
translate belarusian d4_school_fox_voltron_bedc0abd:

    # "И кинулся по пришкольной территории, пытаясь догнать Полину."
    "І кінуўся па прышкольнай тэрыторыі, спрабуючы дагнаць Паліну."

# game/scripts/scene/scene_day_4.rpy:3449
translate belarusian d4_school_fox_voltron_8bf017d5:

    # "Эхо повторяло стук подошв."
    "Рэха паўтарала стук падэшваў."

# game/scripts/scene/scene_day_4.rpy:3450
translate belarusian d4_school_fox_voltron_f5e278a9:

    # "Скрипичный футляр девочки покачивался, как хвост раздражённого животного."
    "Скрыпічны футляр дзяўчынкі пагойдваўся, як хвост раздражнёнай жывёлы."

# game/scripts/scene/scene_day_4.rpy:3451
translate belarusian d4_school_fox_voltron_121aba66:

    # voice "voice/anton/4day/46. Pol.ogg"
    # Ant "Полин!"
    voice "voice/anton/4day/46. Pol.ogg"
    Ant "Палін!"

# game/scripts/scene/scene_day_4.rpy:3464
translate belarusian d4_school_fox_voltron_f688114e:

    # "Она сбавила шаг, но не обернулась."
    "Яна запаволіла крок, але не азірнулася."

# game/scripts/scene/scene_day_4.rpy:3465
translate belarusian d4_school_fox_voltron_0b2b82f7:

    # voice "voice/anton/4day/47. Nu.ogg"
    # Ant "Ну Полин!"
    voice "voice/anton/4day/47. Nu.ogg"
    Ant "Ну Палін!"

# game/scripts/scene/scene_day_4.rpy:3467
translate belarusian d4_school_fox_voltron_6265d2c6:

    # "Показался её хорошенький профиль."
    "Паказаўся яе прыгожанькі профіль."

# game/scripts/scene/scene_day_4.rpy:3476
translate belarusian d4_school_fox_voltron_5540ef70:

    # voice "voice/Polina/4day/160 Ch.ogg"
    # Pol "Чего?"
    voice "voice/Polina/4day/160 Ch.ogg"
    Pol "Чаго?"

# game/scripts/scene/scene_day_4.rpy:3483
translate belarusian d4_school_fox_voltron_070512c1:

    # "Я поравнялся с ней, осторожно взял за локоть. Она не отдёрнулась – хороший знак."
    "Я параўняўся з ёй, асцярожна ўзяў за локаць. Яна не адхіснулася — добры знак."

# game/scripts/scene/scene_day_4.rpy:3484
translate belarusian d4_school_fox_voltron_62c48d50:

    # voice "voice/anton/4day/48. Ti.ogg"
    # Ant "Ты всё неправильно поняла."
    voice "voice/anton/4day/48. Ti.ogg"
    Ant "Ты ўсё няправільна зразумела."

# game/scripts/scene/scene_day_4.rpy:3488
translate belarusian d4_school_fox_voltron_10f0d5ec:

    # "Полина убрала с лица прядь."
    "Паліна прыбрала з твару пасму."

# game/scripts/scene/scene_day_4.rpy:3489
translate belarusian d4_school_fox_voltron_15d84ae4:

    # "Я подумал, что этот жест она могла подсмотреть в каком-нибудь фильме с Шэрон Стоун."
    "Я падумаў, што гэты жэст яна магла падгледзець у якім-небудзь фільме з Шэран Стоўн."

# game/scripts/scene/scene_day_4.rpy:3490
translate belarusian d4_school_fox_voltron_cbbbab5b:

    # "Голос её оставался строгим."
    "Голас яе заставаўся строгім."

# game/scripts/scene/scene_day_4.rpy:3492
translate belarusian d4_school_fox_voltron_42066b35:

    # voice "voice/Polina/4day/161 Ct.ogg"
    # Pol "Что тут понимать-то?!"
    voice "voice/Polina/4day/161 Ct.ogg"
    Pol "Што тут і разумець?!"

# game/scripts/scene/scene_day_4.rpy:3496
translate belarusian d4_school_fox_voltron_20e1a2db:

    # voice "voice/Polina/4day/162 R.ogg"
    # Pol "Ромка спланировал геройский поступок – в кавычках, конечно."
    voice "voice/Polina/4day/162 R.ogg"
    Pol "Ромка спланаваў геройскі ўчынак — у двукоссі, вядома."

# game/scripts/scene/scene_day_4.rpy:3500
translate belarusian d4_school_fox_voltron_a413457c:

    # voice "voice/Polina/4day/163 At.ogg"
    # Pol "А ты вызвался быть шутом, от которого он меня защитит."
    voice "voice/Polina/4day/163 At.ogg"
    Pol "А ты выклікаўся быць блазнам, ад якога ён мяне абароніць."

# game/scripts/scene/scene_day_4.rpy:3504
translate belarusian d4_school_fox_voltron_2f310fbf:

    # voice "voice/Polina/4day/164 Es.ogg"
    # Pol "Ещё и маску где-то нашёл гадкую такую!"
    voice "voice/Polina/4day/164 Es.ogg"
    Pol "Яшчэ і маску недзе знайшоў брыдкую такую!"

# game/scripts/scene/scene_day_4.rpy:3507
translate belarusian d4_school_fox_voltron_4ebb71b6:

    # "Я вспыхнул: {i}«Ничего она не гадкая!{/i}», но вслух сказал:"
    "Я ўспыхнуў: {i}«Нічога яна не брыдкая!{/i}», але ўголас сказаў:"

# game/scripts/scene/scene_day_4.rpy:3508
translate belarusian d4_school_fox_voltron_89a97bf0:

    # voice "voice/anton/4day/49. Avot.ogg"
    # Ant "А вот и не поняла!"
    voice "voice/anton/4day/49. Avot.ogg"
    Ant "А вось і не зразумела!"

# game/scripts/scene/scene_day_4.rpy:3510
translate belarusian d4_school_fox_voltron_7e5ee5eb:

    # voice "voice/anton/4day/50 T.ogg"
    # Ant "Ты Ромке очень нравишься."
    voice "voice/anton/4day/50 T.ogg"
    Ant "Ты Ромку вельмі падабаешся."

# game/scripts/scene/scene_day_4.rpy:3512
translate belarusian d4_school_fox_voltron_7a2e247f:

    # "В её взгляде проскользнуло любопытство."
    "У яе позірку прамільгнула цікаўнасць."

# game/scripts/scene/scene_day_4.rpy:3513
translate belarusian d4_school_fox_voltron_a50d5f34:

    # "Мне так отчаянно захотелось обнять Полину, украсть, увести в лес."
    "Мне так адчайна захацелася абняць Паліну, скрасці, завесці ў лес."

# game/scripts/scene/scene_day_4.rpy:3514
translate belarusian d4_school_fox_voltron_b6d949d7:

    # "Познакомить с моими новыми друзьями."
    "Пазнаёміць з маімі новымі сябрамі."

# game/scripts/scene/scene_day_4.rpy:3515
translate belarusian d4_school_fox_voltron_6e220332:

    # "Чтобы флейта играла – Полине бы понравилась её мелодия."
    "Каб флейта грала — Паліне б спадабалася яе мелодыя."

# game/scripts/scene/scene_day_4.rpy:3516
translate belarusian d4_school_fox_voltron_c678e495:

    # "Чтобы мы прыгали до небес, выше облаков."
    "Каб мы скакалі да нябёсаў, вышэй за аблокі."

# game/scripts/scene/scene_day_4.rpy:3517
translate belarusian d4_school_fox_voltron_7becb46c:

    # "И там, под приколоченными к небосводу звёздами, я бы рассказал Полине, как нуждаюсь в ней."
    "І там, пад прыбітымі да небасхілу зоркамі, я б расказаў Паліне, як яна мне патрэбна."

# game/scripts/scene/scene_day_4.rpy:3518
translate belarusian d4_school_fox_voltron_82495bbb:

    # "Что она – вода, а я умираю от жажды."
    "Што яна — вада, а я паміраю ад смагі."

# game/scripts/scene/scene_day_4.rpy:3520
translate belarusian d4_school_fox_voltron_3b2f8c60:

    # voice "voice/Polina/4day/166 Ya.ogg"
    # Pol "Я думала, я тебе нравлюсь."
    voice "voice/Polina/4day/166 Ya.ogg"
    Pol "Я думала, я табе падабаюся."

# game/scripts/scene/scene_day_4.rpy:3523
translate belarusian d4_school_fox_voltron_ad8e285b:

    # "Я притворился дурачком."
    "Я прыкінуўся дурнікам."

# game/scripts/scene/scene_day_4.rpy:3524
translate belarusian d4_school_fox_voltron_78388682:

    # voice "voice/anton/4day/50. Mne.ogg"
    # Ant "Мне?"
    voice "voice/anton/4day/50. Mne.ogg"
    Ant "Мне?"

# game/scripts/scene/scene_day_4.rpy:3527
translate belarusian d4_school_fox_voltron_1e161082:

    # "Полина обиженно вырвалась."
    "Паліна пакрыўджана вырвалася."

# game/scripts/scene/scene_day_4.rpy:3541
translate belarusian d4_school_fox_voltron_9791d832:

    # voice "voice/Polina/4day/168 Vs.ogg"
    # Pol "Всё ясно!"
    voice "voice/Polina/4day/168 Vs.ogg"
    Pol "Усё ясна!"

# game/scripts/scene/scene_day_4.rpy:3544
translate belarusian d4_school_fox_voltron_eec5278b:

    # voice "voice/anton/4day/51.Da.ogg"
    # Ant "Да постой же! Нравишься!"
    voice "voice/anton/4day/51.Da.ogg"
    Ant "Ды пастой жа! Падабаешся!"

# game/scripts/scene/scene_day_4.rpy:3547
translate belarusian d4_school_fox_voltron_ed12e6af:

    # voice "voice/anton/4day/51.T.ogg"
    # Ant "Ты всем нравишься."
    voice "voice/anton/4day/51.T.ogg"
    Ant "Ты ўсім падабаешся."

# game/scripts/scene/scene_day_4.rpy:3549
translate belarusian d4_school_fox_voltron_61edf533:

    # voice "voice/anton/4day/51.No.ogg"
    # Ant "Но Ромка – он особенный."
    voice "voice/anton/4day/51.No.ogg"
    Ant "Але Ромка — ён асаблівы."

# game/scripts/scene/scene_day_4.rpy:3552
translate belarusian d4_school_fox_voltron_18455e4f:

    # voice "voice/Polina/4day/169 Os.ogg"
    # Pol "Особенный лжец."
    voice "voice/Polina/4day/169 Os.ogg"
    Pol "Асаблівы хлус."

# game/scripts/scene/scene_day_4.rpy:3555
translate belarusian d4_school_fox_voltron_f4bc68dd:

    # voice "voice/anton/4day/52. On.ogg"
    # Ant "Он целеустремлённый и на самом деле серьёзнее, чем кажется."
    voice "voice/anton/4day/52. On.ogg"
    Ant "Ён мэтанакіраваны і насамрэч сур'ёзнейшы, чым здаецца."

# game/scripts/scene/scene_day_4.rpy:3557
translate belarusian d4_school_fox_voltron_91109821:

    # voice "voice/anton/4day/52.Po.ogg"
    # Ant "Помнишь, ты говорила о побеге? С ним бы ты точно сбежала."
    voice "voice/anton/4day/52.Po.ogg"
    Ant "Памятаеш, ты казала пра ўцёкі? З ім бы ты дакладна ўцякла."

# game/scripts/scene/scene_day_4.rpy:3559
translate belarusian d4_school_fox_voltron_fe5e4b6e:

    # voice "voice/anton/4day/52.V.ogg"
    # Ant "В какой-нибудь большой сверкающий город."
    voice "voice/anton/4day/52.V.ogg"
    Ant "У які-небудзь вялікі зіхатлівы горад."

# game/scripts/scene/scene_day_4.rpy:3561
translate belarusian d4_school_fox_voltron_3472ef45:

    # voice "voice/anton/4day/52.Da.ogg"
    # Ant "Да куда угодно!"
    voice "voice/anton/4day/52.Da.ogg"
    Ant "Ды куды заўгодна!"

# game/scripts/scene/scene_day_4.rpy:3563
translate belarusian d4_school_fox_voltron_abb83b2c:

    # voice "voice/anton/4day/52.On.ogg"
    # Ant "Он обещал защищать тебя."
    voice "voice/anton/4day/52.On.ogg"
    Ant "Ён абяцаў абараняць цябе."

# game/scripts/scene/scene_day_4.rpy:3566
translate belarusian d4_school_fox_voltron_8f027430:

    # "Полина смотрела в темноту за чертогами школы. Там выл ветер и клубился снег."
    "Паліна глядзела ў цемру за чартогамі школы. Там выў вецер і клубіўся снег."

# game/scripts/scene/scene_day_4.rpy:3568
translate belarusian d4_school_fox_voltron_1d10a240:

    # voice "voice/Polina/4day/170 E.ogg"
    # Pol "И что теперь прикажешь?"
    voice "voice/Polina/4day/170 E.ogg"
    Pol "І што цяпер загадаеш?"

# game/scripts/scene/scene_day_4.rpy:3572
translate belarusian d4_school_fox_voltron_c36a703f:

    # voice "voice/Polina/4day/171 Ot.ogg"
    # Pol "От его обещаний детей рожать?"
    voice "voice/Polina/4day/171 Ot.ogg"
    Pol "Ад яго абяцанняў дзяцей нараджаць?"

# game/scripts/scene/scene_day_4.rpy:3575
translate belarusian d4_school_fox_voltron_f7cdd51f:

    # voice "voice/anton/4day/52.Dl.ogg"
    # Ant "Для начала узнать поближе, дать ему шанс."
    voice "voice/anton/4day/52.Dl.ogg"
    Ant "Для пачатку пазнаць бліжэй, даць яму шанс."

# game/scripts/scene/scene_day_4.rpy:3577
translate belarusian d4_school_fox_voltron_4541ab0d:

    # voice "voice/anton/4day/53.Sh.ogg"
    # Ant "Шутки шутками, а настоящий маньяк ещё на свободе."
    voice "voice/anton/4day/53.Sh.ogg"
    Ant "Жарты жартамі, а сапраўдны маньяк яшчэ на волі."

# game/scripts/scene/scene_day_4.rpy:3579
translate belarusian d4_school_fox_voltron_50ed1f2c:

    # voice "voice/anton/4day/53.Po.ogg"
    # Ant "Позволь Ромке проводить тебя сегодня."
    voice "voice/anton/4day/53.Po.ogg"
    Ant "Дазволь Ромку правесці цябе сёння."

# game/scripts/scene/scene_day_4.rpy:3581
translate belarusian d4_school_fox_voltron_766ffc46:

    # "Я говорил, а губы мои немели и деревенело лицо."
    "Я гаварыў, а вусны мае нямелі і дзеравянеў твар."

# game/scripts/scene/scene_day_4.rpy:3582
translate belarusian d4_school_fox_voltron_12607e8e:

    # "Я боялся, что голос выдаст истинные чувства."
    "Я баяўся, што голас выдасць сапраўдныя пачуцці."

# game/scripts/scene/scene_day_4.rpy:3583
translate belarusian d4_school_fox_voltron_af9aa0dd:

    # "Слова были бритвами, которые резали мне грудь и гортань, высыпаясь наружу."
    "Словы былі брытвамі, якія рэзалі мне грудзі і гартань, высыпаючыся вонкі."

# game/scripts/scene/scene_day_4.rpy:3584
translate belarusian d4_school_fox_voltron_133e1c45:

    # "Полина молчала бесконечно долго, а потом ещё дольше."
    "Паліна маўчала бясконца доўга, а потым яшчэ даўжэй."

# game/scripts/scene/scene_day_4.rpy:3589
translate belarusian d4_school_fox_voltron_56d66d09:

    # "Она возмущённо сопела и барабанила пальцами по чёрному футляру."
    "Яна абурана сапла і барабаніла пальцамі па чорным футляры."

# game/scripts/scene/scene_day_4.rpy:3595
translate belarusian d4_school_fox_voltron_3614a427:

    # "Наконец она сказала, вздохнув:"
    "Нарэшце яна сказала, уздыхнуўшы:"

# game/scripts/scene/scene_day_4.rpy:3597
translate belarusian d4_school_fox_voltron_5f391a9e:

    # voice "voice/Polina/4day/172 Pe.ogg"
    # Pol "Передай своему Ромке, что я жду у школьных ворот."
    voice "voice/Polina/4day/172 Pe.ogg"
    Pol "Перадай свайму Ромку, што я чакаю каля школьных варот."

# game/scripts/scene/scene_day_4.rpy:3601
translate belarusian d4_school_fox_voltron_ebdee67b:

    # voice "voice/Polina/4day/173 no.ogg"
    # Pol "Но чтоб не думал себе всякое!"
    voice "voice/Polina/4day/173 no.ogg"
    Pol "Але каб не думаў сабе ўсякага!"

# game/scripts/scene/scene_day_4.rpy:3604
translate belarusian d4_school_fox_voltron_3203d220:

    # "Я изобразил радость: когда надо, я мог притворяться."
    "Я ўдаў радасць: калі трэба, я мог прыкідвацца."

# game/scripts/scene/scene_day_4.rpy:3605
translate belarusian d4_school_fox_voltron_09f89631:

    # voice "voice/anton/4day/54. T.ogg"
    # Ant "Ты не пожалеешь."
    voice "voice/anton/4day/54. T.ogg"
    Ant "Ты не пашкадуеш."

# game/scripts/scene/scene_day_4.rpy:3646
translate belarusian d4_school_fox_voltron_c75837ad:

    # "Я брёл обратно за угол, вслепую шаркая по снегу, потому что веки мои были плотно зажмурены, а сердце билось, как молот, вгоняя в душу гвозди."
    "Я брыў назад за рог, усляпую чоўгаючы па снезе, бо павекі мае былі шчыльна зажмураны, а сэрца білася, як молат, заганяючы ў душу цвікі."

# game/scripts/scene/scene_day_4.rpy:3659
translate belarusian d4_school_fox_voltron_d45d4a5e:

    # "Ромка сидел на корточках, взъерошивая короткие волосы."
    "Ромка сядзеў на кукішках, кудлацячы кароткія валасы."

# game/scripts/scene/scene_day_4.rpy:3661
translate belarusian d4_school_fox_voltron_e7f0bde6:

    # voice "voice/anton/4day/55. Ona.ogg"
    # Ant "Она ждёт тебя у ворот."
    voice "voice/anton/4day/55. Ona.ogg"
    Ant "Яна чакае цябе каля варот."

# game/scripts/scene/scene_day_4.rpy:3666
translate belarusian d4_school_fox_voltron_447f91d3:

    # "Наградой мне было изумление на лице товарища."
    "Узнагародай мне было здзіўленне на твары таварыша."

# game/scripts/scene/scene_day_4.rpy:3672
translate belarusian d4_school_fox_voltron_a0b2083c:

    # "Он вскочил, захлёбываясь словами."
    "Ён усхапіўся, захлынаючыся словамі."

# game/scripts/scene/scene_day_4.rpy:3673
translate belarusian d4_school_fox_voltron_82102c1f:

    # "Совсем не тот замкнутый лидер-молчун, с которым я познакомился на прошлой неделе."
    "Зусім не той замкнёны лідар-маўчун, з якім я пазнаёміўся на мінулым тыдні."

# game/scripts/scene/scene_day_4.rpy:3681
translate belarusian d4_school_fox_voltron_eafae180:

    # voice "voice/romka/4day/111 T.ogg"
    # Rom "Тош, ты спас меня!"
    voice "voice/romka/4day/111 T.ogg"
    Rom "Тош, ты выратаваў мяне!"

# game/scripts/scene/scene_day_4.rpy:3685
translate belarusian d4_school_fox_voltron_3f94f738:

    # voice "voice/romka/4day/112 B.ogg"
    # Rom "Братан, да я теперь твой должник на века."
    voice "voice/romka/4day/112 B.ogg"
    Rom "Братан, ды я цяпер твой даўжнік на вякі."

# game/scripts/scene/scene_day_4.rpy:3689
translate belarusian d4_school_fox_voltron_5374187b:

    # voice "voice/romka/4day/113H.ogg"
    # Rom "Хошь, я тебе тетрис подгоню? А хошь, научу рукопашным приёмам?"
    voice "voice/romka/4day/113H.ogg"
    Rom "Хош, я табе тэтрыс падганю? А хош, навучу рукапашным прыёмам?"

# game/scripts/scene/scene_day_4.rpy:3693
translate belarusian d4_school_fox_voltron_21de0a2d:

    # voice "voice/romka/4day/114 E.ogg"
    # Rom "Или..."
    voice "voice/romka/4day/114 E.ogg"
    Rom "Ці..."

# game/scripts/scene/scene_day_4.rpy:3704
translate belarusian d4_school_fox_voltron_447c29d6:

    # "Я мечтал об одном: чтоб меня оставили в покое."
    "Я марыў пра адно: каб мяне пакінулі ў спакоі."

# game/scripts/scene/scene_day_4.rpy:3705
translate belarusian d4_school_fox_voltron_41c0479e:

    # "Чтобы я мог стоять в тишине и смотреть, как колышется на ветру лес."
    "Каб я мог стаяць у цішыні і глядзець, як калышацца на ветры лес."

# game/scripts/scene/scene_day_4.rpy:3706
translate belarusian d4_school_fox_voltron_49422d7f:

    # "Вдыхать морозный запах хвои сквозь старую маску."
    "Удыхаць марозны пах ігліцы праз старую маску."

# game/scripts/scene/scene_day_4.rpy:3708
translate belarusian d4_school_fox_voltron_640335db:

    # voice "voice/anton/4day/56. Ed.ogg"
    # Ant "Иди уже."
    voice "voice/anton/4day/56. Ed.ogg"
    Ant "Ідзі ўжо."

# game/scripts/scene/scene_day_4.rpy:3711
translate belarusian d4_school_fox_voltron_643a9669:

    # "Хотелось верить, что в случае с Алисой мне не придётся выбирать между чувствами и дружбой."
    "Хацелася верыць, што ў выпадку з Алісай мне не давядзецца выбіраць паміж пачуццямі і сяброўствам."

# game/scripts/scene/scene_day_4.rpy:3713
translate belarusian d4_school_fox_voltron_30bf3170:

    # "Кроме неё у меня уже никого не осталось..."
    "Акрамя яе ў мяне ўжо нікога не засталося..."

# game/scripts/scene/scene_day_4.rpy:3726
translate belarusian d4_school_fox_voltron_2d5d93dd:

    # "...разве что Оля." id d4_school_fox_voltron_2d5d93dd
    "...хіба што Оля."

# game/scripts/scene/scene_day_4.rpy:3727
translate belarusian d4_school_fox_voltron_1c8e7945:

    # "Ну конечно, мой лучик света в этой кромешной чёрной тайге."
    "Ну вядома, мой праменьчык святла ў гэтай апраметнай чорнай тайзе."

# game/scripts/scene/scene_day_4.rpy:3728
translate belarusian d4_school_fox_voltron_7c4c0b5d:

    # "Как я мог забыть о своей маленькой сестрёнке?"
    "Як я мог забыць пра сваю маленькую сястрычку?"

# game/scripts/scene/scene_day_4.rpy:3753
translate belarusian d4_school_fox_voltron_bd182794:

    # voice "voice/anton/4day/57. Ya.ogg"
    # Ant "Я знаю, чего я хочу."
    voice "voice/anton/4day/57. Ya.ogg"
    Ant "Я ведаю, чаго я хачу."

# game/scripts/scene/scene_day_4.rpy:3755
translate belarusian d4_school_fox_voltron_2f59ea75:

    # "Ромка, успевший сделать несколько шагов, остановился и посмотрел на меня."
    "Ромка, які паспеў зрабіць некалькі крокаў, спыніўся і паглядзеў на мяне."

# game/scripts/scene/scene_day_4.rpy:3756
translate belarusian d4_school_fox_voltron_0cd62da7:

    # voice "voice/anton/4day/58. Y.ogg"
    # Ant "Я хочу оказаться вместе с сестрой в «Диснейленде»."
    voice "voice/anton/4day/58. Y.ogg"
    Ant "Я хачу апынуцца разам з сястрой у «Дыснейлендзе»."

# game/scripts/scene/scene_day_4.rpy:3764
translate belarusian d4_school_fox_voltron_6d427f17:

    # "Мой приятель ухмыльнулся, сдвинув шапку на затылок."
    "Мой прыяцель ухмыльнуўся, ссунуўшы шапку на патыліцу."

# game/scripts/scene/scene_day_4.rpy:3768
translate belarusian d4_school_fox_voltron_2888cb1a:

    # voice "voice/romka/4day/116 E.ogg"
    # Rom "И что ты предлагаешь?"
    voice "voice/romka/4day/116 E.ogg"
    Rom "І што ты прапануеш?"

# game/scripts/scene/scene_day_4.rpy:3772
translate belarusian d4_school_fox_voltron_57caefed:

    # voice "voice/romka/4day/117 S.ogg"
    # Rom "Сберкассу обнести?"
    voice "voice/romka/4day/117 S.ogg"
    Rom "Ашчадкасу абнесці?"

# game/scripts/scene/scene_day_4.rpy:3775
translate belarusian d4_school_fox_voltron_f8af47c8:

    # voice "voice/anton/4day/59.Ne.ogg"
    # Ant "Нет, надо просто поймать маньяка."
    voice "voice/anton/4day/59.Ne.ogg"
    Ant "Не, трэба проста злавіць маньяка."

# game/scripts/scene/scene_day_4.rpy:3777
translate belarusian d4_school_fox_voltron_6b654377:

    # voice "voice/anton/4day/60.To.ogg"
    # Ant "Того, кто в ответе за все эти похищения."
    voice "voice/anton/4day/60.To.ogg"
    Ant "Таго, хто адказвае за ўсе гэтыя выкраданні."

# game/scripts/scene/scene_day_4.rpy:3779
translate belarusian d4_school_fox_voltron_44d26a6e:

    # voice "voice/anton/4day/60.E.ogg"
    # Ant "И получить обещанную награду в милиции."
    voice "voice/anton/4day/60.E.ogg"
    Ant "І атрымаць абяцаную ўзнагароду ў міліцыі."

# game/scripts/scene/scene_day_4.rpy:3785
translate belarusian d4_school_fox_voltron_5a2bdf1b:

    # "Ромка скривился, спрятал руки в карманы штанов."
    "Ромка скрывіўся, схаваў рукі ў кішэні штаноў."

# game/scripts/scene/scene_day_4.rpy:3787
translate belarusian d4_school_fox_voltron_a593dc05:

    # voice "voice/romka/4day/118 D.ogg"
    # Rom "Думаешь, тебе этот лейтенант что-то за сотрудничество отстегнёт?"
    voice "voice/romka/4day/118 D.ogg"
    Rom "Думаеш, табе гэты лейтэнант нешта за супрацоўніцтва адваліць?"

# game/scripts/scene/scene_day_4.rpy:3791
translate belarusian d4_school_fox_voltron_7ddf4d7b:

    # voice "voice/romka/4day/119 Po.ogg"
    # Rom "Подарит максимум часы командирские — и будь здоров!"
    voice "voice/romka/4day/119 Po.ogg"
    Rom "Падорыць максімум гадзіннік камандзірскі — і будзь здароў!"

# game/scripts/scene/scene_day_4.rpy:3794
translate belarusian d4_school_fox_voltron_50fff925:

    # "Меня утомило пререкаться с Ромкой."
    "Мяне стаміла спрачацца з Ромкам."

# game/scripts/scene/scene_day_4.rpy:3795
translate belarusian d4_school_fox_voltron_2d4bd537:

    # voice "voice/anton/4day/60. Ti.ogg"
    # Ant "Ты поможешь мне? Да или нет?"
    voice "voice/anton/4day/60. Ti.ogg"
    Ant "Ты дапаможаш мне? Так ці не?"

# game/scripts/scene/scene_day_4.rpy:3798
translate belarusian d4_school_fox_voltron_862d4bdf:

    # voice "voice/romka/4day/120 Ya.ogg"
    # Rom "Я сказал уже: мы команда."
    voice "voice/romka/4day/120 Ya.ogg"
    Rom "Я сказаў ужо: мы каманда."

# game/scripts/scene/scene_day_4.rpy:3802
translate belarusian d4_school_fox_voltron_c4de9798:

    # voice "voice/romka/4day/121 K.ogg"
    # Rom "Куда ты — туда и я."
    voice "voice/romka/4day/121 K.ogg"
    Rom "Куды ты — туды і я."

# game/scripts/scene/scene_day_4.rpy:3805
translate belarusian d4_school_fox_voltron_c50213fe:

    # voice "voice/anton/4day/60.Ho.ogg"
    # Ant "Хорошо."
    voice "voice/anton/4day/60.Ho.ogg"
    Ant "Добра."

# game/scripts/scene/scene_day_4.rpy:3807
translate belarusian d4_school_fox_voltron_090728aa:

    # voice "voice/anton/4day/60.Te.ogg"
    # Ant "Теперь понять бы, с чего начинать."
    voice "voice/anton/4day/60.Te.ogg"
    Ant "Цяпер зразумець бы, з чаго пачынаць."

# game/scripts/scene/scene_day_4.rpy:3810
translate belarusian d4_school_fox_voltron_0fc81ef7:

    # voice "voice/romka/4day/122 S.ogg"
    # Rom "Слушай!"
    voice "voice/romka/4day/122 S.ogg"
    Rom "Слухай!"

# game/scripts/scene/scene_day_4.rpy:3814
translate belarusian d4_school_fox_voltron_f8c3b8e8:

    # voice "voice/romka/4day/123 By.ogg"
    # Rom "Бяша говорил, что слышал плач в буреломе за кладбищем."
    voice "voice/romka/4day/123 By.ogg"
    Rom "Бяша казаў, што чуў плач у бураломе за могілкамі."

# game/scripts/scene/scene_day_4.rpy:3818
translate belarusian d4_school_fox_voltron_b2829d5e:

    # voice "voice/romka/4day/124 G.ogg"
    # Rom "Готов поспорить, это была Катька."
    voice "voice/romka/4day/124 G.ogg"
    Rom "Гатовы паспрачацца, гэта была Кацька."

# game/scripts/scene/scene_day_4.rpy:3827
translate belarusian d4_school_fox_voltron_bed8b679:

    # "Я весь собрался, превратился в нерв."
    "Я ўвесь сабраўся, ператварыўся ў нерв."

# game/scripts/scene/scene_day_4.rpy:3828
translate belarusian d4_school_fox_voltron_01067e00:

    # "Катя – это шажок к Семёну, а от него – к Вове."
    "Каця — гэта крочак да Сямёна, а ад яго — да Вовы."

# game/scripts/scene/scene_day_4.rpy:3829
translate belarusian d4_school_fox_voltron_2b2a41b3:

    # "Поможем милиции арестовать убийцу — и проклятый маньяк перестанет держать наш посёлок в страхе."
    "Дапаможам міліцыі арыштаваць забойцу — і пракляты маньяк перастане трымаць наш пасёлак у страху."

# game/scripts/scene/scene_day_4.rpy:3830
translate belarusian d4_school_fox_voltron_c316a343:

    # "А с ним уйдут взрослые запреты, что не разрешают Оле выходить на улицу."
    "А з ім сыдуць дарослыя забароны, што не дазваляюць Олі выходзіць на вуліцу."

# game/scripts/scene/scene_day_4.rpy:3834
translate belarusian d4_school_fox_voltron_b17762c9:

    # "И я, наконец, научу её прыгать до небес вместе с новыми друзьями."
    "І я, нарэшце, навучу яе скакаць да нябёсаў разам з новымі сябрамі."

# game/scripts/scene/scene_day_4.rpy:3838
translate belarusian d4_school_fox_voltron_70a46197:

    # voice "voice/anton/4day/61.Ka.ogg"
    # Ant "Как тогда будем действовать?"
    voice "voice/anton/4day/61.Ka.ogg"
    Ant "Як тады будзем дзейнічаць?"

# game/scripts/scene/scene_day_4.rpy:3853
translate belarusian d4_school_fox_voltron_00483945:

    # voice "voice/romka/4day/125 T.ogg"
    # Rom "Так сразу не скажу, да и время поджимает."
    voice "voice/romka/4day/125 T.ogg"
    Rom "Так адразу не скажу, ды і час падціскае."

# game/scripts/scene/scene_day_4.rpy:3857
translate belarusian d4_school_fox_voltron_7d63657a:

    # voice "voice/romka/4day/126 Da.ogg"
    # Rom "Давай пересечёмся у дома Полины через час."
    voice "voice/romka/4day/126 Da.ogg"
    Rom "Давай перасячомся каля дома Паліны праз гадзіну."

# game/scripts/scene/scene_day_4.rpy:3861
translate belarusian d4_school_fox_voltron_c9eba42b:

    # voice "voice/romka/4day/127 N.ogg"
    # Rom "Нет, лучше через полтора!"
    voice "voice/romka/4day/127 N.ogg"
    Rom "Не, лепш праз паўтары!"

# game/scripts/scene/scene_day_4.rpy:3865
translate belarusian d4_school_fox_voltron_c4c8c81d:

    # voice "voice/romka/4day/128 Z.ogg"
    # Rom "Знаешь, где она живет?"
    voice "voice/romka/4day/128 Z.ogg"
    Rom "Ведаеш, дзе яна жыве?"

# game/scripts/scene/scene_day_4.rpy:3868
translate belarusian d4_school_fox_voltron_b1700b31:

    # "Я вспомнил номер дома, тайком подсмотренный в анкете Полины."
    "Я ўспомніў нумар дома, потайкі падгледжаны ў анкеце Паліны."

# game/scripts/scene/scene_day_4.rpy:3869
translate belarusian d4_school_fox_voltron_7ce67d99:

    # voice "voice/anton/4day/63. Du.ogg"
    # Ant "Думаю, найду."
    voice "voice/anton/4day/63. Du.ogg"
    Ant "Думаю, знайду."

# game/scripts/scene/scene_day_4.rpy:3872
translate belarusian d4_school_fox_voltron_d49f756b:

    # voice "voice/romka/4day/129 O.ogg"
    # Rom "Отлично! Мне пора."
    voice "voice/romka/4day/129 O.ogg"
    Rom "Выдатна! Мне пара."

# game/scripts/scene/scene_day_4.rpy:3894
translate belarusian d4_school_fox_voltron_f69cf603:

    # "И Ромка умчал, а я остался усмирять галоп в грудной клетке."
    "І Ромка памчаў, а я застаўся ўтаймоўваць галоп у грудной клетцы."

# game/scripts/scene/scene_day_4.rpy:3918
translate belarusian d4_school_fox_voltron_cee8eb89:

    # "Быть может, теперь, с Ромкиной поддержкой, весь этот ужас, наконец, прекратится."
    "Можа быць, цяпер, з Ромкавай падтрымкай, увесь гэты жах, нарэшце, спыніцца."

# game/scripts/scene/scene_day_4.rpy:3941
translate belarusian d4_school_fox_voltron_0b9a6d9e:

    # "Лузгающий семечки Бяша скривился, как только я подошёл к нему."
    "Бяша, які лузаў семкі, скрывіўся, як толькі я падышоў да яго."

# game/scripts/scene/scene_day_4.rpy:3944
translate belarusian d4_school_fox_voltron_4e6ec95c:

    # voice "voice/byasha/4day/178 S.ogg"
    # Bya "Смотрите-ка... тьфу! Явился не запылился, на!"
    voice "voice/byasha/4day/178 S.ogg"
    Bya "Глядзіце толькі... цьфу! З'явіўся не запыліўся, на!"

# game/scripts/scene/scene_day_4.rpy:3948
translate belarusian d4_school_fox_voltron_6f4ec44d:

    # voice "voice/byasha/4day/179 Br.ogg"
    # Bya "Бросили меня тут, на… тьфу… и срулили вдвоём… Тьфу, голубки."
    voice "voice/byasha/4day/179 Br.ogg"
    Bya "Кінулі мяне тут, на... цьфу... і звалілі ўдваіх... Цьфу, галубкі."

# game/scripts/scene/scene_day_4.rpy:3952
translate belarusian d4_school_fox_voltron_ddb6ef0e:

    # voice "voice/byasha/4day/180 Aes.ogg"
    # Bya "А ещё, на, команда Вольтрона называется. Тьфу!"
    voice "voice/byasha/4day/180 Aes.ogg"
    Bya "А яшчэ, на, каманда Вальтрона называецца. Цьфу!"

# game/scripts/scene/scene_day_4.rpy:3961
translate belarusian d4_school_fox_voltron_5cbab9d2:

    # "Бяша нахохлился и демонстративно отвернулся."
    "Бяша натапырыўся і дэманстратыўна адвярнуўся."

# game/scripts/scene/scene_day_4.rpy:3962
translate belarusian d4_school_fox_voltron_13501e1c:

    # "На минуту я задумался, взвешивая про себя, а пригодится ли нам помощь Бяши в поисках Кати? Или этот Ромкин прихвостень только всё испортит?"
    "На хвіліну я задумаўся, узважваючы ў думках, а ці спатрэбіцца нам дапамога Бяшы ў пошуках Каці? Ці гэты Ромкаў прыхвасцень толькі ўсё сапсуе?"

# game/scripts/scene/scene_day_4.rpy:3997
translate belarusian d4_byash_choice_dismiss_c510ea04:

    # "И если я ещё мог поверить в Ромкину дружбу, то его подхалим и прислужник Бяша всегда вызывал у меня отвращение."
    "І калі я яшчэ мог паверыць у Ромкаву дружбу, то яго падхалім і прыслужнік Бяша заўсёды выклікаў у мяне агіду."

# game/scripts/scene/scene_day_4.rpy:3999
translate belarusian d4_byash_choice_dismiss_e5aeffe6:

    # voice "voice/anton/4day/81. Che.ogg"
    # Ant "Чего ты сразу, как девчонка, обижаешься?"
    voice "voice/anton/4day/81. Che.ogg"
    Ant "Чаго ты адразу, як дзяўчынка, крыўдзішся?"

# game/scripts/scene/scene_day_4.rpy:4001
translate belarusian d4_byash_choice_dismiss_d5e3594c:

    # voice "voice/anton/4day/82.Vot.ogg"
    # Ant "Вот уж не подумал, что ты так в роль вживёшься."
    voice "voice/anton/4day/82.Vot.ogg"
    Ant "Вось ужо не падумаў, што ты так у ролю ўжывешся."

# game/scripts/scene/scene_day_4.rpy:4007
translate belarusian d4_byash_choice_dismiss_3d3282d4:

    # "Он ядовито прыснул."
    "Ён ядавіта пырхнуў."

# game/scripts/scene/scene_day_4.rpy:4010
translate belarusian d4_byash_choice_dismiss_fec2877d:

    # voice "voice/byasha/4day/183 Da.ogg"
    # Bya "Да пошли вы, на! Тоже мне друзья."
    voice "voice/byasha/4day/183 Da.ogg"
    Bya "Ды пайшлі вы, на! Таксама мне сябры."

# game/scripts/scene/scene_day_4.rpy:4014
translate belarusian d4_byash_choice_dismiss_7b328d9e:

    # voice "voice/byasha/4day/184 Es.ogg"
    # Bya "Если сгинете — я по вам скучать не буду, на."
    voice "voice/byasha/4day/184 Es.ogg"
    Bya "Калі згінеце — я па вас сумаваць не буду, на."

# game/scripts/scene/scene_day_4.rpy:4018
translate belarusian d4_byash_choice_dismiss_7335fc72:

    # voice "voice/byasha/4day/185 V.ogg"
    # Bya "Вы..."
    voice "voice/byasha/4day/185 V.ogg"
    Bya "Вы..."

# game/scripts/scene/scene_day_4.rpy:4021
translate belarusian d4_byash_choice_dismiss_a3bb252c:

    # voice "voice/anton/4day/70. Da.ogg"
    # Ant "Да иди уже."
    voice "voice/anton/4day/70. Da.ogg"
    Ant "Ды ідзі ўжо."

# game/scripts/scene/scene_day_4.rpy:4049
translate belarusian d4_byash_choice_dismiss_35bc2de8:

    # "И он демонстративно удалился, бросив кулёк с семечками у моих ног."
    "І ён дэманстратыўна аддаліўся, кінуўшы кулёк з семкамі каля маіх ног."

# game/scripts/scene/scene_day_4.rpy:4050
translate belarusian d4_byash_choice_dismiss_aa7f5747:

    # "Я ждал невыносимо долго."
    "Я чакаў невыносна доўга."

# game/scripts/scene/scene_day_4.rpy:4060
translate belarusian d4_byash_choice_dismiss_72f8f763:

    # "Самые длинные полтора часа жизни, словно миксер, размололи мой мозг до жидкой кашицы."
    "Самыя доўгія паўтары гадзіны жыцця, быццам міксер, размалолі мой мозг да вадкай кашыцы."

# game/scripts/scene/scene_day_4.rpy:4061
translate belarusian d4_byash_choice_dismiss_590c2412:

    # "Одни тревожные мысли нахлёстывались на другие."
    "Адны трывожныя думкі накочваліся на другія."

# game/scripts/scene/scene_day_4.rpy:4077
translate belarusian d4_byash_choice_dismiss_3f177ad6:

    # "Пропавшая Катя."
    "Зніклая Каця."

# game/scripts/scene/scene_day_4.rpy:4078
translate belarusian d4_byash_choice_dismiss_595d6386:

    # "Лес."
    "Лес."

# game/scripts/scene/scene_day_4.rpy:4079
translate belarusian d4_byash_choice_dismiss_73616d6f:

    # "Маньяк."
    "Маньяк."

# game/scripts/scene/scene_day_4.rpy:4096
translate belarusian d4_byash_choice_dismiss_be40da98:

    # "И склепы, могилы, кресты..."
    "І склепы, магілы, крыжы..."

# game/scripts/scene/scene_day_4.rpy:4120
translate belarusian d4_byash_choice_dismiss_c1944120:

    # voice "voice/romka/4day/130 A.ogg"
    # Rom "А Бяша где? Зассал поди?"
    voice "voice/romka/4day/130 A.ogg"
    Rom "А Бяша дзе? Зассаў, мабыць?"

# game/scripts/scene/scene_day_4.rpy:4123
translate belarusian d4_byash_choice_dismiss_f3e1a99b:

    # "Необязательно было спрашивать Ромку о свидании. По улыбке до ушей становилось ясно, что прошло оно великолепно."
    "Неабавязкова было пытацца ў Ромкі пра спатканне. Па ўсмешцы да вушэй станавілася ясна, што прайшло яно цудоўна."

# game/scripts/scene/scene_day_4.rpy:4133
translate belarusian d4_byash_choice_dismiss_498dd222:

    # "Ромка шутливо боднул меня в бок."
    "Ромка жартаўліва баднуў мяне ў бок."

# game/scripts/scene/scene_day_4.rpy:4135
translate belarusian d4_byash_choice_dismiss_c9ec9806:

    # voice "voice/romka/4day/131 Nu.ogg"
    # Rom "Ну ходу, кент!"
    voice "voice/romka/4day/131 Nu.ogg"
    Rom "Ну ходу, кент!"

# game/scripts/scene/scene_day_4.rpy:4169
translate belarusian d4_byash_choice_dismiss_43aa68e2:

    # "В это время люди в домах стряпали, смотрели телевизор, переругивались."
    "У гэты час людзі ў дамах кухарылі, глядзелі тэлевізар, пералайваліся."

# game/scripts/scene/scene_day_4.rpy:4171
translate belarusian d4_byash_choice_dismiss_2622c734:

    # "На крыльце курили хмурые мужчины. Скрипел колодезный ворот."
    "На ганку курылі пахмурныя мужчыны. Рыпеў калодзежны калаўрот."

# game/scripts/scene/scene_day_4.rpy:4172
translate belarusian d4_byash_choice_dismiss_34ee9526:

    # "Метель обошла посёлок по дуге."
    "Завея абышла пасёлак па дузе."

# game/scripts/scene/scene_day_4.rpy:4200
translate belarusian d4_byash_choice_dismiss_c1a9f703:

    # "Но не она заботила меня и пугала."
    "Але не яна турбавала мяне і палохала."

# game/scripts/scene/scene_day_4.rpy:4201
translate belarusian d4_byash_choice_dismiss_e0844538:

    # "Лес вырос на нашем пути, и то ли мы вошли в него, то ли он проглотил нас зубастой пастью."
    "Лес вырас на нашым шляху, і ці то мы ўвайшлі ў яго, ці то ён праглынуў нас зубастай пашчай."

# game/scripts/scene/scene_day_4.rpy:4202
translate belarusian d4_byash_choice_dismiss_64456540:

    # "Сосны скрипели, а из тайги тянулись зыбкие тени."
    "Сосны рыпелі, а з тайгі цягнуліся хісткія цені."

# game/scripts/scene/scene_day_4.rpy:4203
translate belarusian d4_byash_choice_dismiss_3164a1eb:

    # "Они выгибались по обе стороны от дороги."
    "Яны выгіналіся па абодва бакі ад дарогі."

# game/scripts/scene/scene_day_4.rpy:4204
translate belarusian d4_byash_choice_dismiss_8953ad87:

    # "Никто из нас не проронил ни слова, ступая на просеку."
    "Ніхто з нас не вымавіў ні слова, ступаючы на просеку."

# game/scripts/scene/scene_day_4.rpy:4205
translate belarusian d4_byash_choice_dismiss_b2210ed3:

    # "Сизая дымка струилась над оврагами, её хвосты завивались в призрачном танце."
    "Шызая смуга струменілася над ярамі, яе хвасты завіваліся ў прывідным танцы."

# game/scripts/scene/scene_day_4.rpy:4206
translate belarusian d4_byash_choice_dismiss_241b0628:

    # "В лесу тошнотворно пахло воском церковных свечей, мутило рассудок."
    "У лесе ванітна пахла воскам царкоўных свечак, муціла розум."

# game/scripts/scene/scene_day_4.rpy:4207
translate belarusian d4_byash_choice_dismiss_9e7c9b8e:

    # "Снег чавкал, проседая под подошвами."
    "Снег чвякаў, прасядаючы пад падэшвамі."

# game/scripts/scene/scene_day_4.rpy:4208
translate belarusian d4_byash_choice_dismiss_e8613c9a:

    # "Кочки напоминали насыпи на могилах, а кресты заменяли перекрученные хилые деревья." id d4_byash_choice_dismiss_e8613c9a
    "Купіны нагадвалі насыпы на магілах, а крыжы замянялі перакручаныя кволыя дрэвы."

# game/scripts/scene/scene_day_4.rpy:4209
translate belarusian d4_byash_choice_dismiss_efbacbcd:

    # "Из заледеневших болот стенала и булькала тьма. Злобно завыл ветер."
    "З заледзянелых балот стагнала і булькала цемра. Злосна завыў вецер."

# game/scripts/scene/scene_day_4.rpy:4210
translate belarusian d4_byash_choice_dismiss_ff9c6091:

    # "Время перестало иметь значение."
    "Час перастаў мець значэнне."

# game/scripts/scene/scene_day_4.rpy:4232
translate belarusian d4_byash_choice_dismiss_ee1f7635:

    # "В какой-то момент мы упёрлись в бурелом."
    "У нейкі момант мы ўперліся ў буралом."

# game/scripts/scene/scene_day_4.rpy:4241
translate belarusian d4_byash_choice_dismiss_7c720dd0:

    # voice "voice/romka/4day/132 Z.ogg"
    # Rom "Значит, так..."
    voice "voice/romka/4day/132 Z.ogg"
    Rom "Значыць, так..."

# game/scripts/scene/scene_day_4.rpy:4245
translate belarusian d4_byash_choice_dismiss_a9f05e41:

    # voice "voice/romka/4day/133 P.ogg"
    # Rom "Поисковая операция начинается."
    voice "voice/romka/4day/133 P.ogg"
    Rom "Пошукавая аперацыя пачынаецца."

# game/scripts/scene/scene_day_4.rpy:4249
translate belarusian d4_byash_choice_dismiss_88a87e57:

    # voice "voice/romka/4day/134 D.ogg"
    # Rom "Далеко не разбредаемся, ищем любые следы Кати или похитителя."
    voice "voice/romka/4day/134 D.ogg"
    Rom "Далёка не разбрыдаемся, шукаем любыя сляды Каці ці выкрадальніка."

# game/scripts/scene/scene_day_4.rpy:4253
translate belarusian d4_byash_choice_dismiss_94160ac3:

    # voice "voice/romka/4day/135 E.ogg"
    # Rom "И желательно, Тоха, поживее."
    voice "voice/romka/4day/135 E.ogg"
    Rom "І пажадана, Тоха, пажвавей."

# game/scripts/scene/scene_day_4.rpy:4257
translate belarusian d4_byash_choice_dismiss_7855db1a:

    # voice "voice/romka/4day/136 U.ogg"
    # Rom "Уже через час станет темно хоть глаз выколи."
    voice "voice/romka/4day/136 U.ogg"
    Rom "Ужо праз гадзіну стане цёмна хоць вока выкалі."

# game/scripts/scene/scene_day_4.rpy:4286
translate belarusian d4_byash_choice_dismiss_ba502f96:

    # "Наши поиски не дали никаких результатов. Проклятый лес умел хоронить секреты."
    "Нашы пошукі не далі ніякіх вынікаў. Пракляты лес умеў хаваць сакрэты."

# game/scripts/scene/scene_day_4.rpy:4302
translate belarusian d4_byash_choice_dismiss_3b4d70e0:

    # "Мы уже собирались идти домой, как хрустнула ветка в овраге позади нас, и в небо взметнулась стая испуганных ворон."
    "Мы ўжо збіраліся ісці дадому, як хруснула галінка ў яры пазаду нас, і ў неба ўзвілася чарада спалоханых варон."

# game/scripts/scene/scene_day_4.rpy:4315
translate belarusian d4_byash_choice_dismiss_273756c8:

    # "Ромка с завидной проворностью выхватил нож, ткнул им в подступающую темноту."
    "Ромка з зайздроснай спрытнасцю выхапіў нож, тыцнуў ім у цемру, што падступала."

# game/scripts/scene/scene_day_4.rpy:4327
translate belarusian d4_byash_choice_dismiss_cd6ab035:

    # voice "voice/romka/4day/138 S.ogg"
    # Rom "Слышал? Там кто-то бродит."
    voice "voice/romka/4day/138 S.ogg"
    Rom "Чуў? Там нехта блукае."

# game/scripts/scene/scene_day_4.rpy:4329
translate belarusian d4_byash_choice_dismiss_cc0bdf99:

    # voice "voice/romka/4day/139 V.ogg"
    # Rom "Возможно, наш маньяк."
    voice "voice/romka/4day/139 V.ogg"
    Rom "Магчыма, наш маньяк."

# game/scripts/scene/scene_day_4.rpy:4334
translate belarusian d4_byash_choice_dismiss_16f779eb:

    # "Словно сама ночь услышала его слова, соткав из сумрака и копоти высокий грозный силуэт."
    "Быццам сама ноч пачула яго словы, саткаўшы са змроку і копаці высокі грозны сілуэт."

# game/scripts/scene/scene_day_4.rpy:4338
translate belarusian d4_byash_choice_dismiss_2fd2cf25:

    # "Существо некоторое время возвышалось над тающими во мгле пнями и корягами, а потом быстро зашагало к нам."
    "Істота некаторы час узвышалася над пнямі і карчамі, што раставалі ў імгле, а потым хутка закрочыла да нас."

# game/scripts/scene/scene_day_4.rpy:4342
translate belarusian d4_byash_choice_dismiss_5ceddc91:

    # "Это явно был не призрак — приближающийся треск сучьев говорил, что оно материально."
    "Гэта відавочна быў не прывід — трэск сукоў, які набліжаўся, казаў, што яно матэрыяльнае."

# game/scripts/scene/scene_day_4.rpy:4353
translate belarusian d4_byash_choice_dismiss_c54ec41f:

    # voice "voice/anton/4day/74. Cht.ogg"
    # Ant "Что дальше, Ром?"
    voice "voice/anton/4day/74. Cht.ogg"
    Ant "Што далей, Ром?"

# game/scripts/scene/scene_day_4.rpy:4357
translate belarusian d4_byash_choice_dismiss_f0ba1c0c:

    # voice "voice/romka/4day/140 A.ogg"
    # Rom "А я почём знаю? Ты же хотел его выцепить!"
    voice "voice/romka/4day/140 A.ogg"
    Rom "А я адкуль ведаю? Ты ж хацеў яго вычапіць!"

# game/scripts/scene/scene_day_4.rpy:4374
translate belarusian d4_byash_choice_dismiss_5b6b6abe:

    # "Нечто уже бежало в нашу сторону, лихо перепрыгивая поваленное дерево."
    "Нешта ўжо бегла ў наш бок, ліха пераскокваючы праз паваленае дрэва."

# game/scripts/scene/scene_day_4.rpy:4392
translate belarusian d4_byash_choice_dismiss_774ff24c:

    # voice "voice/romka/4day/141 N.ogg"
    # Rom "Не стой столбом – хватай дрын какой-нибудь!"
    voice "voice/romka/4day/141 N.ogg"
    Rom "Не стой слупам — хапай дрын які-небудзь!"

# game/scripts/scene/scene_day_4.rpy:4416
translate belarusian d4_byash_choice_dismiss_0eb93be3:

    # "Я с трудом выкорчевал из земли палку размером с биту для {u}лапты{/u}. Вымазанные в саже руки тряслись."
    "Я з цяжкасцю выкарчаваў з зямлі палку памерам з біту для {u}лапты{/u}. Вымазаныя ў сажы рукі дрыжалі."

# game/scripts/scene/scene_day_4.rpy:4418
translate belarusian d4_byash_choice_dismiss_210b39bc:

    # voice "voice/romka/4day/142 Ne.ogg"
    # Rom "Не ссы, я уже махался со взрослыми."
    voice "voice/romka/4day/142 Ne.ogg"
    Rom "Не ссы, я ўжо махаўся з дарослымі."

# game/scripts/scene/scene_day_4.rpy:4422
translate belarusian d4_byash_choice_dismiss_477e0c28:

    # voice "voice/romka/4day/143 G.ogg"
    # Rom "Главное..."
    voice "voice/romka/4day/143 G.ogg"
    Rom "Галоўнае..."

# game/scripts/scene/scene_day_4.rpy:4426
translate belarusian d4_byash_choice_dismiss_b4ed2aff:

    # "Ромка пытался храбриться, но голос его дрожал."
    "Ромка спрабаваў храбрыцца, але голас яго дрыжаў."

# game/scripts/scene/scene_day_4.rpy:4429
translate belarusian d4_byash_choice_dismiss_df78ea88:

    # voice "voice/romka/4day/144 Ne.ogg"
    # Rom "Не вздумай меня тут кинуть одного! Ясно?!"
    voice "voice/romka/4day/144 Ne.ogg"
    Rom "Не ўздумай мяне тут кінуць аднаго! Ясна?!"

# game/scripts/scene/scene_day_4.rpy:4432
translate belarusian d4_byash_choice_dismiss_17045798:

    # "Я молча кивнул и увидел, как запыхавшийся мужчина выхватывает что-то из-за пазухи."
    "Я моўчкі кіўнуў і ўбачыў, як захеканы мужчына выхоплівае нешта з-за пазухі."

# game/scripts/scene/scene_day_4.rpy:4443
translate belarusian d4_byash_choice_dismiss_028b2eee:

    # "Мой боевой товарищ яростно закричал и бросился в атаку."
    "Мой баявы таварыш люта закрычаў і кінуўся ў атаку."

# game/scripts/scene/scene_day_4.rpy:4461
translate belarusian d4_byash_choice_dismiss_dd364f5a:

    # voice "voice/romka/4day/145 A.ogg"
    # Rom "А-а-а-а-а-а-а!" id d4_byash_choice_dismiss_dd364f5a
    voice "voice/romka/4day/145 A.ogg"
    Rom "А-а-а-а-а-а-а!"

# game/scripts/scene/scene_day_4.rpy:4466
translate belarusian d4_byash_choice_dismiss_5448a3e2:

    # "Я последовал за ним, крича скорее от ужаса."
    "Я рушыў за ім, крычучы хутчэй ад жаху."

# game/scripts/scene/scene_day_4.rpy:4482
translate belarusian d4_byash_choice_dismiss_655f972b:

    # voice "voice/anton/4day/75. AAA.ogg"
    # Ant "А-а-а-а-а-а-а!" id d4_byash_choice_dismiss_655f972b
    voice "voice/anton/4day/75. AAA.ogg"
    Ant "А-а-а-а-а-а-а!"

# game/scripts/scene/scene_day_4.rpy:4507
translate belarusian d4_byash_choice_dismiss_8a3c4236:

    # "И тут мы оба встали, как вкопанные. Импровизированная дубина выпала из моих рук."
    "І тут мы абодва сталі, як укапаныя. Імправізаваная дубіна выпала з маіх рук."

# game/scripts/scene/scene_day_4.rpy:4523
translate belarusian d4_byash_choice_dismiss_bd69da37:

    # "В нашу сторону смотрело нарезное дуло пистолета Макарова, вынуждая нас в страхе попятиться."
    "У наш бок глядзела наразное дула пісталета Макарава, прымушаючы нас у страху папяціцца."

# game/scripts/scene/scene_day_4.rpy:4524
translate belarusian d4_byash_choice_dismiss_ccc796ad:

    # voice "voice/tihonov/4day/01 P.ogg"
    # Noname "Пятифанов! А ну брось нож! Чтоб вас!"
    voice "voice/tihonov/4day/01 P.ogg"
    Noname "Пяціфанаў! А ну кінь нож! Каб вас!"

# game/scripts/scene/scene_day_4.rpy:4538
translate belarusian d4_byash_choice_dismiss_887eeed2:

    # "Неизвестный вышел на лунный свет, и только сейчас я узнал старлея Тихонова."
    "Невядомы выйшаў на месяцовае святло, і толькі цяпер я пазнаў старлея Ціханава."

# game/scripts/scene/scene_day_4.rpy:4547
translate belarusian d4_byash_choice_dismiss_4df26078:

    # "Он хмуро оглядел нас, затем смачно харкнул в сторону."
    "Ён пахмурна агледзеў нас, потым смачна харкнуў убок."

# game/scripts/scene/scene_day_4.rpy:4555
translate belarusian d4_byash_choice_dismiss_4967dece:

    # voice "voice/tihonov/4day/02 T.ogg"
    # Tikhonov "Тьфу! Провалиться мне на месте."
    voice "voice/tihonov/4day/02 T.ogg"
    Tikhonov "Цьфу! Праваліцца мне на месцы."

# game/scripts/scene/scene_day_4.rpy:4561
translate belarusian d4_byash_choice_dismiss_d608c8eb:

    # voice "voice/tihonov/4day/03 To.ogg"
    # Tikhonov "Только вас двоих мне здесь и не хватало."
    voice "voice/tihonov/4day/03 To.ogg"
    Tikhonov "Толькі вас дваіх мне тут і не хапала."

# game/scripts/scene/scene_day_4.rpy:4574
translate belarusian d4_byash_choice_dismiss_e5e38909:

    # "Ромка злобно ухмыльнулся."
    "Ромка злосна ўхмыльнуўся."

# game/scripts/scene/scene_day_4.rpy:4578
translate belarusian d4_byash_choice_dismiss_9f939b80:

    # voice "voice/romka/4day/146 T.ogg"
    # Rom "Так я и думал, что это ты, легавый, тот самый маньячелло."
    voice "voice/romka/4day/146 T.ogg"
    Rom "Так я і думаў, што гэта ты, лягавы, той самы маньячэла."

# game/scripts/scene/scene_day_4.rpy:4588
translate belarusian d4_byash_choice_dismiss_0801ef7b:

    # voice "voice/anton/4day/76.Po.ogg"
    # Ant "Пожалуйста, отпустите! Мы ничего не скажем!"
    voice "voice/anton/4day/76.Po.ogg"
    Ant "Калі ласка, адпусціце! Мы нічога не скажам!"

# game/scripts/scene/scene_day_4.rpy:4595
translate belarusian d4_byash_choice_dismiss_4f433560:

    # voice "voice/tihonov/4day/05 Da.ogg"
    # Tikhonov "Да заткнитесь вы оба!"
    voice "voice/tihonov/4day/05 Da.ogg"
    Tikhonov "Ды заткніцеся вы абодва!"

# game/scripts/scene/scene_day_4.rpy:4624
translate belarusian d4_byash_choice_dismiss_38a77443:

    # voice "voice/tihonov/4day/06 Ya.ogg"
    # Tikhonov "Я вшивых четыре часа на морозе провёл, а вы мне всю засаду испортили, паразиты."
    voice "voice/tihonov/4day/06 Ya.ogg"
    Tikhonov "Я вашывых чатыры гадзіны на марозе правёў, а вы мне ўсю засаду сапсавалі, паразіты."

# game/scripts/scene/scene_day_4.rpy:4628
translate belarusian d4_byash_choice_dismiss_4df1e688:

    # "Мы отуплено опустили руки."
    "Мы атупела апусцілі рукі."

# game/scripts/scene/scene_day_4.rpy:4631
translate belarusian d4_byash_choice_dismiss_c00ee4b8:

    # voice "voice/tihonov/4day/07 P.ogg"
    # Tikhonov "Полезай-ка в бобик."
    voice "voice/tihonov/4day/07 P.ogg"
    Tikhonov "Залазь-ка ў бобік."

# game/scripts/scene/scene_day_4.rpy:4640
translate belarusian d4_byash_choice_dismiss_321f79aa:

    # voice "voice/tihonov/4day/08 V.ogg"
    # Tikhonov "В участке расскажете, что вы тут забыли."
    voice "voice/tihonov/4day/08 V.ogg"
    Tikhonov "У пастарунку раскажаце, што вы тут забылі."

# game/scripts/scene/scene_day_4.rpy:4671
translate belarusian d4_byash_choice_call_facf0ecb:

    # voice "voice/anton/4day/63. Nu.ogg"
    # Ant "Ну Бяш, не обижайся..."
    voice "voice/anton/4day/63. Nu.ogg"
    Ant "Ну Бяш, не крыўдуй..."

# game/scripts/scene/scene_day_4.rpy:4673
translate belarusian d4_byash_choice_call_21ae59f3:

    # voice "voice/anton/4day/64. Ro.ogg"
    # Ant "Ромка голову совсем потерял, ты уж не злись на него сильно."
    voice "voice/anton/4day/64. Ro.ogg"
    Ant "Ромка галаву зусім страціў, ты ўжо не злуйся на яго моцна."

# game/scripts/scene/scene_day_4.rpy:4675
translate belarusian d4_byash_choice_call_a806b6bf:

    # voice "voice/anton/4day/65. A.ogg"
    # Ant "А про тебя я помню. Вот, держи от меня подарок."
    voice "voice/anton/4day/65. A.ogg"
    Ant "А пра цябе я памятаю. Вось, трымай ад мяне падарунак."

# game/scripts/scene/scene_day_4.rpy:4695
translate belarusian d4_byash_choice_call_16c5f359:

    # "Я передал Бяше доработанный набросок Вольтрона — огромного трансформера, собранного из пятёрки роботов-львов."
    "Я перадаў Бяшу дапрацаваны накід Вальтрона — велізарнага трансформера, сабранага з пяцёркі робатаў-ільвоў."

# game/scripts/scene/scene_day_4.rpy:4718
translate belarusian d4_byash_choice_call_13086e80:

    # voice "voice/byasha/4day/186 Ni.ogg"
    # Bya "Ничёсе! Это мне, на?"
    voice "voice/byasha/4day/186 Ni.ogg"
    Bya "Нічога сабе! Гэта мне, на?"

# game/scripts/scene/scene_day_4.rpy:4722
translate belarusian d4_byash_choice_call_578118fe:

    # voice "voice/byasha/4day/187 Sp.ogg"
    # Bya "Спасибо, Антоха, уважил!"
    voice "voice/byasha/4day/187 Sp.ogg"
    Bya "Дзякуй, Антоха, уважыў!"

# game/scripts/scene/scene_day_4.rpy:4725
translate belarusian d4_byash_choice_call_734f0566:

    # voice "voice/anton/4day/66. Ch.ogg"
    # Ant "Да чего уж там."
    voice "voice/anton/4day/66. Ch.ogg"
    Ant "Ды чаго ўжо там."

# game/scripts/scene/scene_day_4.rpy:4727
translate belarusian d4_byash_choice_call_359dd249:

    # voice "voice/anton/4day/67. Che.ogg"
    # Ant "Через полтора часа встречаемся у Полининого дома."
    voice "voice/anton/4day/67. Che.ogg"
    Ant "Праз паўтары гадзіны сустракаемся каля Палінінага дома."

# game/scripts/scene/scene_day_4.rpy:4729
translate belarusian d4_byash_choice_call_aa90e1b9:

    # voice "voice/anton/4day/68.Na .ogg"
    # Ant "Намечается срочное дело."
    voice "voice/anton/4day/68.Na .ogg"
    Ant "Намячаецца тэрміновая справа."

# game/scripts/scene/scene_day_4.rpy:4731
translate belarusian d4_byash_choice_call_04cf846b:

    # "Бяша аж порозовел на радостях."
    "Бяша аж паружавеў на радасцях."

# game/scripts/scene/scene_day_4.rpy:4733
translate belarusian d4_byash_choice_call_a6391dff:

    # voice "voice/byasha/4day/188 Ch.ogg"
    # Bya "Чем будем заниматься?"
    voice "voice/byasha/4day/188 Ch.ogg"
    Bya "Чым будзем займацца?"

# game/scripts/scene/scene_day_4.rpy:4736
translate belarusian d4_byash_choice_call_86c41c5b:

    # "Я грустно улыбнулся, оценивая наши шансы."
    "Я сумна ўсміхнуўся, ацэньваючы нашы шансы."

# game/scripts/scene/scene_day_4.rpy:4738
translate belarusian d4_byash_choice_call_90058ddd:

    # voice "voice/anton/4day/69. Po.ogg"
    # Ant "Постараемся не пропасть без вести."
    voice "voice/anton/4day/69. Po.ogg"
    Ant "Пастараемся не прапасці без вестак."

# game/scripts/scene/scene_day_4.rpy:4786
translate belarusian d4_byash_choice_call_72f8f763:

    # "Самые длинные полтора часа жизни, словно миксер, размололи мой мозг до жидкой кашицы."
    "Самыя доўгія паўтары гадзіны жыцця, быццам міксер, размалолі мой мозг да вадкай кашыцы."

# game/scripts/scene/scene_day_4.rpy:4787
translate belarusian d4_byash_choice_call_590c2412:

    # "Одни тревожные мысли нахлёстывались на другие."
    "Адны трывожныя думкі накочваліся на другія."

# game/scripts/scene/scene_day_4.rpy:4798
translate belarusian d4_byash_choice_call_3f177ad6:

    # "Пропавшая Катя."
    "Зніклая Каця."

# game/scripts/scene/scene_day_4.rpy:4799
translate belarusian d4_byash_choice_call_595d6386:

    # "Лес."
    "Лес."

# game/scripts/scene/scene_day_4.rpy:4800
translate belarusian d4_byash_choice_call_73616d6f:

    # "Маньяк."
    "Маньяк."

# game/scripts/scene/scene_day_4.rpy:4814
translate belarusian d4_byash_choice_call_be40da98:

    # "И склепы, могилы, кресты..."
    "І склепы, магілы, крыжы..."

# game/scripts/scene/scene_day_4.rpy:4836
translate belarusian d4_byash_choice_call_d89e1a0b:

    # "Бяша выполз из ранних сумерек в квартале от назначенного места."
    "Бяша выпаўз з ранніх прыцемкаў за квартал ад прызначанага месца."

# game/scripts/scene/scene_day_4.rpy:4841
translate belarusian d4_byash_choice_call_6decf356:

    # voice "voice/byasha/4day/189 Ch.ogg"
    # Bya "Чего унылый такой, на? Свежих анекдотов нет?"
    voice "voice/byasha/4day/189 Ch.ogg"
    Bya "Чаго пануры такі, на? Свежых анекдотаў няма?"

# game/scripts/scene/scene_day_4.rpy:4844
translate belarusian d4_byash_choice_call_b8e91dfb:

    # "Я был рад видеть даже его физиономию."
    "Я быў рады бачыць нават яго фізіяномію."

# game/scripts/scene/scene_day_4.rpy:4876
translate belarusian d4_byash_choice_call_2151100e:

    # voice "voice/romka/4day/157 V.ogg"
    # Rom "Вся банда в сборе?"
    voice "voice/romka/4day/157 V.ogg"
    Rom "Уся банда ў зборы?"

# game/scripts/scene/scene_day_4.rpy:4879
translate belarusian d4_byash_choice_call_f3e1a99b:

    # "Необязательно было спрашивать Ромку о свидании. По улыбке до ушей становилось ясно, что прошло оно великолепно."
    "Неабавязкова было пытацца ў Ромкі пра спатканне. Па ўсмешцы да вушэй станавілася ясна, што прайшло яно цудоўна."

# game/scripts/scene/scene_day_4.rpy:4891
translate belarusian d4_byash_choice_call_498dd222:

    # "Ромка шутливо боднул меня в бок."
    "Ромка жартаўліва баднуў мяне ў бок."

# game/scripts/scene/scene_day_4.rpy:4893
translate belarusian d4_byash_choice_call_75a0477c:

    # voice "voice/romka/4day/158 N.ogg"
    # Rom "Ну айда, джентльмены!"
    voice "voice/romka/4day/158 N.ogg"
    Rom "Ну гайда, джэнтльмены!"

# game/scripts/scene/scene_day_4.rpy:4899
translate belarusian d4_byash_choice_call_3144e38b:

    # voice "voice/byasha/4day/190 Eto.ogg"
    # Bya "Этот – счастливый, тот – несчастный."
    voice "voice/byasha/4day/190 Eto.ogg"
    Bya "Гэты — шчаслівы, той — няшчасны."

# game/scripts/scene/scene_day_4.rpy:4903
translate belarusian d4_byash_choice_call_fb65bfb2:

    # voice "voice/byasha/4day/191Fig.ogg"
    # Bya "Фиг вас поймёшь, на."
    voice "voice/byasha/4day/191Fig.ogg"
    Bya "Фіг вас зразумееш, на."

# game/scripts/scene/scene_day_4.rpy:4907
translate belarusian d4_byash_choice_call_43c2b989:

    # voice "voice/romka/4day/159 A.ogg"
    # Rom "А ты лишний раз, Бяш, не думай."
    voice "voice/romka/4day/159 A.ogg"
    Rom "А ты лішні раз, Бяш, не думай."

# game/scripts/scene/scene_day_4.rpy:4911
translate belarusian d4_byash_choice_call_6b0c0415:

    # voice "voice/romka/4day/160 At.ogg"
    # Rom "А то, глядишь, последняя извилина узлом закрутится."
    voice "voice/romka/4day/160 At.ogg"
    Rom "А то, глядзіш, апошняя звіліна вузлом закруціцца."

# game/scripts/scene/scene_day_4.rpy:4959
translate belarusian d4_byash_choice_call_43aa68e2:

    # "В это время люди в домах стряпали, смотрели телевизор, переругивались."
    "У гэты час людзі ў дамах кухарылі, глядзелі тэлевізар, пералайваліся."

# game/scripts/scene/scene_day_4.rpy:4961
translate belarusian d4_byash_choice_call_2622c734:

    # "На крыльце курили хмурые мужчины. Скрипел колодезный ворот."
    "На ганку курылі пахмурныя мужчыны. Рыпеў калодзежны калаўрот."

# game/scripts/scene/scene_day_4.rpy:4962
translate belarusian d4_byash_choice_call_34ee9526:

    # "Метель обошла посёлок по дуге."
    "Завея абышла пасёлак па дузе."

# game/scripts/scene/scene_day_4.rpy:4992
translate belarusian d4_byash_choice_call_c1a9f703:

    # "Но не она заботила меня и пугала."
    "Але не яна турбавала мяне і палохала."

# game/scripts/scene/scene_day_4.rpy:4993
translate belarusian d4_byash_choice_call_e0844538:

    # "Лес вырос на нашем пути, и то ли мы вошли в него, то ли он проглотил нас зубастой пастью."
    "Лес вырас на нашым шляху, і ці то мы ўвайшлі ў яго, ці то ён праглынуў нас зубастай пашчай."

# game/scripts/scene/scene_day_4.rpy:4994
translate belarusian d4_byash_choice_call_64456540:

    # "Сосны скрипели, а из тайги тянулись зыбкие тени."
    "Сосны рыпелі, а з тайгі цягнуліся хісткія цені."

# game/scripts/scene/scene_day_4.rpy:4995
translate belarusian d4_byash_choice_call_3164a1eb:

    # "Они выгибались по обе стороны от дороги."
    "Яны выгіналіся па абодва бакі ад дарогі."

# game/scripts/scene/scene_day_4.rpy:4996
translate belarusian d4_byash_choice_call_8953ad87:

    # "Никто из нас не проронил ни слова, ступая на просеку."
    "Ніхто з нас не вымавіў ні слова, ступаючы на просеку."

# game/scripts/scene/scene_day_4.rpy:4997
translate belarusian d4_byash_choice_call_b2210ed3:

    # "Сизая дымка струилась над оврагами, её хвосты завивались в призрачном танце."
    "Шызая смуга струменілася над ярамі, яе хвасты завіваліся ў прывідным танцы."

# game/scripts/scene/scene_day_4.rpy:4998
translate belarusian d4_byash_choice_call_241b0628:

    # "В лесу тошнотворно пахло воском церковных свечей, мутило рассудок."
    "У лесе млосна пахла воскам царкоўных свечак, муціла розум."

# game/scripts/scene/scene_day_4.rpy:4999
translate belarusian d4_byash_choice_call_9e7c9b8e:

    # "Снег чавкал, проседая под подошвами."
    "Снег чвякаў, прасядаючы пад падэшвамі."

# game/scripts/scene/scene_day_4.rpy:5000
translate belarusian d4_byash_choice_call_e8613c9a:

    # "Кочки напоминали насыпи на могилах, а кресты заменяли перекрученные хилые деревья." id d4_byash_choice_call_e8613c9a
    "Купіны нагадвалі насыпы на магілах, а крыжы замянялі перакручаныя кволыя дрэвы."

# game/scripts/scene/scene_day_4.rpy:5001
translate belarusian d4_byash_choice_call_efbacbcd:

    # "Из заледеневших болот стенала и булькала тьма. Злобно завыл ветер."
    "З заледзянелых балот стагнала і булькала цемра. Злосна завыў вецер."

# game/scripts/scene/scene_day_4.rpy:5002
translate belarusian d4_byash_choice_call_ff9c6091:

    # "Время перестало иметь значение."
    "Час перастаў мець значэнне."

# game/scripts/scene/scene_day_4.rpy:5015
translate belarusian d4_byash_choice_call_ee1f7635:

    # "В какой-то момент мы упёрлись в бурелом."
    "У нейкі момант мы ўперліся ў буралом."

# game/scripts/scene/scene_day_4.rpy:5023
translate belarusian d4_byash_choice_call_7c720dd0:

    # voice "voice/romka/4day/132 Z.ogg"
    # Rom "Значит, так..."
    voice "voice/romka/4day/132 Z.ogg"
    Rom "Значыць, так..."

# game/scripts/scene/scene_day_4.rpy:5027
translate belarusian d4_byash_choice_call_a9f05e41:

    # voice "voice/romka/4day/133 P.ogg"
    # Rom "Поисковая операция начинается."
    voice "voice/romka/4day/133 P.ogg"
    Rom "Пошукавая аперацыя пачынаецца."

# game/scripts/scene/scene_day_4.rpy:5031
translate belarusian d4_byash_choice_call_88a87e57:

    # voice "voice/romka/4day/134 D.ogg"
    # Rom "Далеко не разбредаемся, ищем любые следы Кати или похитителя."
    voice "voice/romka/4day/134 D.ogg"
    Rom "Далёка не разбрыдаемся, шукаем любыя сляды Каці ці выкрадальніка."

# game/scripts/scene/scene_day_4.rpy:5035
translate belarusian d4_byash_choice_call_e0123235:

    # voice "voice/romka/4day/164 E.ogg"
    # Rom "И желательно, пацаны, поживее."
    voice "voice/romka/4day/164 E.ogg"
    Rom "І пажадана, пацаны, пажвавей."

# game/scripts/scene/scene_day_4.rpy:5039
translate belarusian d4_byash_choice_call_7855db1a:

    # voice "voice/romka/4day/136 U.ogg"
    # Rom "Уже через час станет темно хоть глаз выколи."
    voice "voice/romka/4day/136 U.ogg"
    Rom "Ужо праз гадзіну стане цёмна хоць вока выкалі."

# game/scripts/scene/scene_day_4.rpy:5047
translate belarusian d4_byash_choice_call_2e489ff2:

    # "Мы осторожно стали пробираться через поваленные деревья в слабой надежде найти хоть что-то."
    "Мы асцярожна пачалі прабірацца праз паваленыя дрэвы ў слабой надзеі знайсці хоць што-небудзь."

# game/scripts/scene/scene_day_4.rpy:5060
translate belarusian d4_byash_choice_call_60761302:

    # voice "voice/byasha/4day/192 Hr.ogg"
    # Bya "Хрена лысого мы в таких потёмках найдем, на."
    voice "voice/byasha/4day/192 Hr.ogg"
    Bya "Хрэна лысага мы ў такіх поцемках знойдзем, на."

# game/scripts/scene/scene_day_4.rpy:5072
translate belarusian d4_byash_choice_call_45ea8e7f:

    # voice "voice/byasha/4day/193 Da.ogg"
    # Bya "Давайте уж лучше по домам."
    voice "voice/byasha/4day/193 Da.ogg"
    Bya "Давайце ўжо лепш па дамах."

# game/scripts/scene/scene_day_4.rpy:5081
translate belarusian d4_byash_choice_call_3e82c87e:

    # voice "voice/byasha/4day/194 Opa.ogg"
    # Bya "Опачки! Чё тут у нас?"
    voice "voice/byasha/4day/194 Opa.ogg"
    Bya "Опачкі! Што тут у нас?"

# game/scripts/scene/scene_day_4.rpy:5086
translate belarusian d4_byash_choice_call_c9bf7dbf:

    # voice "voice/byasha/4day/195 A.ogg"
    # Bya "А мне сегодня фартит!"
    voice "voice/byasha/4day/195 A.ogg"
    Bya "А мне сёння фарціць!"

# game/scripts/scene/scene_day_4.rpy:5112
translate belarusian d4_byash_choice_call_e7c2cbb6:

    # voice "voice/byasha/4day/196 Br.ogg"
    # Bya "Братва! Я, кажись, нашёл."
    voice "voice/byasha/4day/196 Br.ogg"
    Bya "Братва! Я, здаецца, знайшоў."

# game/scripts/scene/scene_day_4.rpy:5115
translate belarusian d4_byash_choice_call_b8b74826:

    # voice "voice/byasha/4day/197 Eto.ogg"
    # Bya "Это ж Катькин кошелёк!{w=2.}{nw}"
    voice "voice/byasha/4day/197 Eto.ogg"
    Bya "Гэта ж Кацьчын гаманец!{w=2.}{nw}"

# game/scripts/scene/scene_day_4.rpy:5173
translate belarusian d4_byash_choice_call_b6bb2f48:

    # "А потом я услышал сдавленный вскрик и не понял, кто кричал: Ромка, Бяша или я сам."
    "А потым я пачуў прыдушаны ўскрык і не зразумеў, хто крычаў: Ромка, Бяша ці я сам."

# game/scripts/scene/scene_day_4.rpy:5175
translate belarusian d4_byash_choice_call_055fa90d:

    # "Наконец, я всё увидел воочию и всё равно не поверил своим глазам."
    "Нарэшце я ўсё ўбачыў наяве і ўсё адно не паверыў сваім вачам."

# game/scripts/scene/scene_day_4.rpy:5200
translate belarusian d4_byash_choice_call_7ce2da11:

    # "Абсолютно седой Бяша в ужасе пятился, спотыкаясь, пока, наконец, не рухнул в сугроб."
    "Абсалютна сівы Бяша ў жаху задкаваў, спатыкаючыся, пакуль нарэшце не рухнуў у гурбу."

# game/scripts/scene/scene_day_4.rpy:5202
translate belarusian d4_byash_choice_call_73e86ca6:

    # "Он протянул руку, и я увидел, как дрожат его пальцы, указывающие в пустоту."
    "Ён працягнуў руку, і я ўбачыў, як дрыжаць яго пальцы, што паказваюць у пустату."

# game/scripts/scene/scene_day_4.rpy:5204
translate belarusian d4_byash_choice_call_644b54a7:

    # voice "voice/byasha/4day/199 Be.ogg"
    # Bya "Бе... Бе-бе..."
    voice "voice/byasha/4day/199 Be.ogg"
    Bya "Бе... Бе-бе..."

# game/scripts/scene/scene_day_4.rpy:5231
translate belarusian d4_byash_choice_call_30c17206:

    # voice "voice/byasha/4day/199 Beee.ogg"
    # Bya "Бе-е-е-е-е-е-е!"
    voice "voice/byasha/4day/199 Beee.ogg"
    Bya "Бе-е-е-е-е-е-е!"

# game/scripts/scene/scene_day_4.rpy:5251
translate belarusian d4_byash_choice_call_440858d5:

    # "Бяша взвился, словно ужаленный, и побежал прочь."
    "Бяша ўзвіўся, быццам уджалены, і пабег прэч."

# game/scripts/scene/scene_day_4.rpy:5252
translate belarusian d4_byash_choice_call_7a023706:

    # "Ромка не посмотрел на него."
    "Ромка не паглядзеў на яго."

# game/scripts/scene/scene_day_4.rpy:5275
translate belarusian d4_byash_choice_call_79fd6086:

    # "Он продолжал глядеть вперёд. Не моргая. Не дыша."
    "Ён працягваў глядзець наперад. Не міргаючы. Не дыхаючы."

# game/scripts/scene/scene_day_4.rpy:5280
translate belarusian d4_byash_choice_call_1470b953:

    # "Я не заметил, как зашагал навстречу чему-то неописуемо страшному."
    "Я не заўважыў, як закрочыў насустрач нечаму неапісальна страшнаму."

# game/scripts/scene/scene_day_4.rpy:5333
translate belarusian d4_byash_choice_call_7bf26445:

    # "Нерешительно отодвинул завесу из мохнатой хвои."
    "Нерашуча адсунуў заслону з калматай ігліцы."

# game/scripts/scene/scene_day_4.rpy:5334
translate belarusian d4_byash_choice_call_f79eb936:

    # "За елями показалась небольшая опушка, некогда выжженная точным попаданием молнии."
    "За ялінамі паказаўся невялікі ўзлесак, калісьці выпалены дакладным трапляннем маланкі."

# game/scripts/scene/scene_day_4.rpy:5335
translate belarusian d4_byash_choice_call_7abdc283:

    # "Почерневшие пни ограждали круг."
    "Пачарнелыя пні агароджвалі кола."

# game/scripts/scene/scene_day_4.rpy:5348
translate belarusian d4_byash_choice_call_bdf308e9:

    # "Посередине стоял Чёрный гараж."
    "Пасярэдзіне стаяў Чорны гараж."

# game/scripts/scene/scene_day_4.rpy:5349
translate belarusian d4_byash_choice_call_24d9364e:

    # "Его гладкие стены были выкрашены чёрной краской."
    "Яго гладкія сцены былі пафарбаваны чорнай фарбай."

# game/scripts/scene/scene_day_4.rpy:5350
translate belarusian d4_byash_choice_call_d18dc8d6:

    # "Казалось, они впитали в себя сам мрак."
    "Здавалася, яны ўвабралі ў сябе сам змрок."

# game/scripts/scene/scene_day_4.rpy:5351
translate belarusian d4_byash_choice_call_866ed098:

    # "Я подумал, что Гараж – это не просто металлический короб, который легко можно перевозить с места на место."
    "Я падумаў, што Гараж — гэта не проста металічная каробка, якую лёгка можна перавозіць з месца на месца."

# game/scripts/scene/scene_day_4.rpy:5352
translate belarusian d4_byash_choice_call_bad3be52:

    # "Он нечто живое."
    "Ён нешта жывое."

# game/scripts/scene/scene_day_4.rpy:5391
translate belarusian d4_byash_choice_call_ad1fd0db:

    # "Насекомое с чёрным лоснящимся хитином. Прожорливый падальщик."
    "Насякомае з чорным ліснючым хіцінам. Пражэрлівы трупаед."

# game/scripts/scene/scene_day_4.rpy:5392
translate belarusian d4_byash_choice_call_bcbf95ee:

    # "Мы таращились на него, а он внимательно следил за нами красным мерцающим глазом."
    "Мы вытрашчыліся на яго, а ён уважліва сачыў за намі чырвоным мігатлівым вокам."

# game/scripts/scene/scene_day_4.rpy:5393
translate belarusian d4_byash_choice_call_b07742e7:

    # "Я сказал себе, что это просто лампочка."
    "Я сказаў сабе, што гэта проста лямпачка."

# game/scripts/scene/scene_day_4.rpy:5411
translate belarusian d4_byash_choice_call_9ebff27f:

    # "Генератор жужжал тихонько, но в этом звуке слышалась угроза."
    "Генератар гудзеў ціхенька, але ў гэтым гуку чулася пагроза."

# game/scripts/scene/scene_day_4.rpy:5435
translate belarusian d4_byash_choice_call_3b795bc6:

    # voice "voice/romka/4day/166 ot.ogg"
    # Rom "Открыто."
    voice "voice/romka/4day/166 ot.ogg"
    Rom "Адчынена."

# game/scripts/scene/scene_day_4.rpy:5441
translate belarusian d4_byash_choice_call_e5e1007e:

    # "Я попытался сглотнуть. Рот был сухой, как пустыня."
    "Я паспрабаваў праглынуць сліну. Рот быў сухі, як пустыня."

# game/scripts/scene/scene_day_4.rpy:5442
translate belarusian d4_byash_choice_call_6bec22d8:

    # "Ворота гаража были распахнуты. Внутри клубилась чернота."
    "Вароты гаража былі расчынены насцеж. Унутры клубілася чарната."

# game/scripts/scene/scene_day_4.rpy:5446
translate belarusian d4_byash_choice_call_a303082c:

    # "Я почувствовал прикосновение – Ромка положил ладонь на моё плечо."
    "Я адчуў дотык — Ромка паклаў далонь на маё плячо."

# game/scripts/scene/scene_day_4.rpy:5449
translate belarusian d4_byash_choice_call_5168fe0b:

    # voice "voice/romka/4day/167 po.ogg"
    # Rom "Пойдём?"
    voice "voice/romka/4day/167 po.ogg"
    Rom "Пойдзем?"

# game/scripts/scene/scene_day_4.rpy:5452
translate belarusian d4_byash_choice_call_17830e4e:

    # "Он выглядел сейчас старше своих лет. Да что там — он выглядел дряхлым стариком."
    "Ён выглядаў цяпер старэйшым за свае гады. Ды што там — ён выглядаў нямоглым старым."

# game/scripts/scene/scene_day_4.rpy:5453
translate belarusian d4_byash_choice_call_06b06def:

    # voice "voice/anton/4day/Kuda.ogg"
    # Ant "Куда? Ты что, сбрендил?!"
    voice "voice/anton/4day/Kuda.ogg"
    Ant "Куды? Ты што, здурнеў?!"

# game/scripts/scene/scene_day_4.rpy:5455
translate belarusian d4_byash_choice_call_54004e6a:

    # voice "voice/anton/4day/Davai.ogg"
    # Ant "Давай предупредим лейтенанта Тихонова."
    voice "voice/anton/4day/Davai.ogg"
    Ant "Давай папярэдзім лейтэнанта Ціханава."

# game/scripts/scene/scene_day_4.rpy:5459
translate belarusian d4_byash_choice_call_fe6cb9bd:

    # "Ромка сплюнул себе под ноги."
    "Ромка сплюнуў сабе пад ногі."

# game/scripts/scene/scene_day_4.rpy:5462
translate belarusian d4_byash_choice_call_1cc0b609:

    # voice "voice/romka/4day/169 Ne.ogg"
    # Rom "Не будь ты таким наивным, Тоха."
    voice "voice/romka/4day/169 Ne.ogg"
    Rom "Не будзь ты такім наіўным, Тоха."

# game/scripts/scene/scene_day_4.rpy:5466
translate belarusian d4_byash_choice_call_5185e1b5:

    # voice "voice/romka/4day/170 T.ogg"
    # Rom "Твой Тихонов, вон, даже варежку в лесу отыскать не смог, ха-ха."
    voice "voice/romka/4day/170 T.ogg"
    Rom "Твой Ціханаў, вунь, нават рукавіцу ў лесе адшукаць не змог, ха-ха."

# game/scripts/scene/scene_day_4.rpy:5470
translate belarusian d4_byash_choice_call_280db1d6:

    # voice "voice/romka/4day/171Da.ogg"
    # Rom "Да и западло с ментом сотрудничать, особенно когда я у него на учёте состою..."
    voice "voice/romka/4day/171Da.ogg"
    Rom "Ды і западло з мянтом супрацоўнічаць, асабліва калі я ў яго на ўліку стаю..."

# game/scripts/scene/scene_day_4.rpy:5487
translate belarusian d4_byash_choice_call_740dd6b4:

    # "Хулиган выхватил визитный ножик и серьёзно посмотрел на меня."
    "Хуліган выхапіў візітны ножык і сур'ёзна паглядзеў на мяне."

# game/scripts/scene/scene_day_4.rpy:5488
translate belarusian d4_byash_choice_call_4636615c:

    # voice "voice/romka/4day/172 m.ogg"
    # Rom "Маньяк наверняка вернулся туда, в своё логово."
    voice "voice/romka/4day/172 m.ogg"
    Rom "Маньяк напэўна вярнуўся туды, у сваё логава."

# game/scripts/scene/scene_day_4.rpy:5490
translate belarusian d4_byash_choice_call_c4a3c302:

    # voice "voice/romka/4day/173 E.ogg"
    # Rom "Если получится — возьмём его тёпленьким, пока он не ждёт."
    voice "voice/romka/4day/173 E.ogg"
    Rom "Калі атрымаецца — возьмем яго цёпленькім, пакуль ён не чакае."

# game/scripts/scene/scene_day_4.rpy:5492
translate belarusian d4_byash_choice_call_87bb62e4:

    # voice "voice/romka/4day/174 En.ogg"
    # Rom "Иначе в следующий раз подкараулит уже он."
    voice "voice/romka/4day/174 En.ogg"
    Rom "Інакш наступным разам падпільнуе ўжо ён."

# game/scripts/scene/scene_day_4.rpy:5503
translate belarusian d4_byash_choice_call_9b3d1ffc:

    # "Зверята говорили, что он всего лишь человек из посёлка..."
    "Звяраты казалі, што ён усяго толькі чалавек з пасёлка..."

# game/scripts/scene/scene_day_4.rpy:5504
translate belarusian d4_byash_choice_call_c8100ccc:

    # "Но справимся ли мы без взрослых?"
    "Але ці справімся мы без дарослых?"

# game/scripts/scene/scene_day_4.rpy:5506
translate belarusian d4_byash_choice_call_408a92e1:

    # voice "voice/romka/4day/175 V.ogg"
    # Rom "Второго шанса может не быть, брат."
    voice "voice/romka/4day/175 V.ogg"
    Rom "Другога шансу можа не быць, брат."

# game/scripts/scene/scene_day_4.rpy:5510
translate belarusian d4_byash_choice_call_0cffac99:

    # voice "voice/romka/4day/176 T.ogg"
    # Rom "Так что решайся!"
    voice "voice/romka/4day/176 T.ogg"
    Rom "Так што наважвайся!"

# game/scripts/scene/scene_day_4.rpy:5533
translate belarusian d4_garage_choice_police_3136da68:

    # "Со стороны гаража раздался хриплый смех, от которого волосы на голове тут же встали дыбом."
    "З боку гаража пачуўся хрыплы смех, ад якога валасы на галаве тут жа сталі дыбам."

# game/scripts/scene/scene_day_4.rpy:5545
translate belarusian d4_garage_choice_police_828d56d3:

    # "Но это всего лишь скрипела массивная чёрная дверь на холодном ветру."
    "Але гэта ўсяго толькі рыпелі масіўныя чорныя дзверы на халодным ветры."

# game/scripts/scene/scene_day_4.rpy:5546
translate belarusian d4_garage_choice_police_55f34132:

    # voice "voice/anton/4day/Eto.ogg"
    # Ant "Это точно какая-то ловушка."
    voice "voice/anton/4day/Eto.ogg"
    Ant "Гэта дакладна нейкая пастка."

# game/scripts/scene/scene_day_4.rpy:5559
translate belarusian d4_garage_choice_police_c133d279:

    # voice "voice/anton/4day/Net.ogg"
    # Ant "Нет, Ром, без милиции мы туда не сунемся."
    voice "voice/anton/4day/Net.ogg"
    Ant "Не, Ром, без міліцыі мы туды не сунемся."

# game/scripts/scene/scene_day_4.rpy:5561
translate belarusian d4_garage_choice_police_53899a94:

    # "И без того кислое лицо товарища сморщилось, словно он откусил лимон."
    "І без таго кіслы твар таварыша зморшчыўся, быццам ён адкусіў лімон."

# game/scripts/scene/scene_day_4.rpy:5586
translate belarusian d4_garage_choice_police_9fc03e23:

    # voice "voice/romka/4day/177 x.ogg"
    # Rom "Хрен с тобой!"
    voice "voice/romka/4day/177 x.ogg"
    Rom "Хрэн з табой!"

# game/scripts/scene/scene_day_4.rpy:5613
translate belarusian d4_garage_choice_police_4ba53f9b:

    # voice "voice/romka/4day/178 To.ogg"
    # Rom "Только попомни мои слова: менты хуже душегубов."
    voice "voice/romka/4day/178 To.ogg"
    Rom "Толькі памятай мае словы: мянты горшыя за душагубаў."

# game/scripts/scene/scene_day_4.rpy:5646
translate belarusian mold_test2_a273edf9:

    # "Мы приблизились к постройке."
    "Мы наблізіліся да пабудовы."

# game/scripts/scene/scene_day_4.rpy:5650
translate belarusian mold_test2_bbf3dd62:

    # "Из короба не доносилось ни звука - только гудел генератор."
    "З каробкі не даносілася ні гуку — толькі гудзеў генератар."

# game/scripts/scene/scene_day_4.rpy:5655
translate belarusian mold_test2_3ce16d64:

    # "Ромка постучал костяшками по воротам, убеждаясь, что они не собираются превращаться в хищные челюсти."
    "Ромка пастукаў костачкамі па варотах, пераконваючыся, што яны не збіраюцца ператварацца ў драпежныя сківіцы."

# game/scripts/scene/scene_day_4.rpy:5681
translate belarusian mold_test2_fb7965cb:

    # "Осмелев, он распахнул двери пошире и принялся ощупывать проём в поисках выключателя."
    "Асмялеўшы, ён расчыніў дзверы шырэй і пачаў абмацваць праём у пошуках выключальніка."

# game/scripts/scene/scene_day_4.rpy:5682
translate belarusian mold_test2_a1c06f5c:

    # voice "voice/romka/4day/182 Toh.ogg"
    # Rom "Тоха, помоги-ка мне."
    voice "voice/romka/4day/182 Toh.ogg"
    Rom "Тоха, дапамажы-тка мне."

# game/scripts/scene/scene_day_4.rpy:5710
translate belarusian mold_test2_a20cefa7:

    # "..."
    "..."

# game/scripts/scene/scene_day_4.rpy:5711
translate belarusian mold_test2_db2c1c70:

    # "Гараж оказался самым обыкновенным."
    "Гараж аказаўся самым звычайным."

# game/scripts/scene/scene_day_4.rpy:5712
translate belarusian mold_test2_4e6f3ebe:

    # "Полки с инструментами по бокам, какие-то канистры и тряпки да накрытая чехлом машина."
    "Паліцы з інструментамі па баках, нейкія каністры і анучы ды накрытая чахлом машына."

# game/scripts/scene/scene_day_4.rpy:5713
translate belarusian mold_test2_19701324:

    # "Ни маньяков, ни их жертв."
    "Ні маньякаў, ні іх ахвяр."

# game/scripts/scene/scene_day_4.rpy:5714
translate belarusian mold_test2_b85e32f9:

    # "Я даже усмехнулся от облегчения. И прочёл те же эмоции на лице товарища."
    "Я нават пасміхнуўся ад палёгкі. І прачытаў тыя ж эмоцыі на твары таварыша."

# game/scripts/scene/scene_day_4.rpy:5724
translate belarusian mold_test2_f1a89ef7:

    # "Ромка вошёл в гараж и обогнул по часовой стрелке автомобиль."
    "Ромка зайшоў у гараж і абышоў па гадзіннікавай стрэлцы аўтамабіль."

# game/scripts/scene/scene_day_4.rpy:5728
translate belarusian mold_test2_82b054da:

    # "Пошарил среди пыльных полок. Посмотрел на меня."
    "Пашарыў сярод пыльных паліц. Паглядзеў на мяне."

# game/scripts/scene/scene_day_4.rpy:5751
translate belarusian mold_test2_474ec482:

    # "Я расхрабрился настолько, что перешагнул порог."
    "Я расхрабрыўся настолькі, што пераступіў парог."

# game/scripts/scene/scene_day_4.rpy:5752
translate belarusian mold_test2_696bd909:

    # "В углах, как паутина, налипла тьма. Паук, если он и был, давно покинул гнездо."
    "У кутах, як павуцінне, наліпла цемра. Павук, калі ён і быў, даўно пакінуў гняздо."

# game/scripts/scene/scene_day_4.rpy:5769
translate belarusian d4_garage_lookaround_tools_676b2bfc:

    # "Инструменты."
    "Інструменты."

# game/scripts/scene/scene_day_4.rpy:5772
translate belarusian d4_garage_lookaround_tools_a4cbb095:

    # "Ржавые железяки, похожие на стальные клыки в пасти этого мёрзлого места или на пыточные инструменты средневекового палача."
    "Іржавыя жалязякі, падобныя да сталёвых іклаў у пашчы гэтага мёрзлага месца ці да катавальных інструментаў сярэднявечнага ката."

# game/scripts/scene/scene_day_4.rpy:5773
translate belarusian d4_garage_lookaround_tools_2a7be849:

    # "К таким прикоснёшься, и на пальце сразу расцветёт рана, а в порез просочится инфекция от ржавчины и засохшего жира, и ты сгниёшь заживо."
    "Да такіх дакранешся, і на пальцы адразу расквітнее рана, а ў парэз прасочыцца інфекцыя ад іржы і засохлага тлушчу, і ты згніеш жыўцом."

# game/scripts/scene/scene_day_4.rpy:5774
translate belarusian d4_garage_lookaround_tools_32930ff9:

    # "Там на щипцах что-то багровое. Надо подойти и проверить… краска. Это просто краска."
    "Там на абцугах нешта барвовае. Трэба падысці і праверыць... фарба. Гэта проста фарба."

# game/scripts/scene/scene_day_4.rpy:5781
translate belarusian d4_garage_lookaround_junk_b5062338:

    # "Хлам."
    "Хлам."

# game/scripts/scene/scene_day_4.rpy:5784
translate belarusian d4_garage_lookaround_junk_e813d3dc:

    # "Почему мне это так напоминает алтарь? Точно Гараж – это церковь, а здесь – атрибуты нечеловеческой таёжной религии..."
    "Чаму мне гэта так нагадвае алтар? Нібы Гараж — гэта царква, а тут — атрыбуты нечалавечай таёжнай рэлігіі..."

# game/scripts/scene/scene_day_4.rpy:5785
translate belarusian d4_garage_lookaround_junk_16e4d3e7:

    # "Я не хочу видеть иконы этой звериной веры! Древние письмена и железные реликвии."
    "Я не хачу бачыць абразы гэтай звярынай веры! Старажытныя пісьмёны і жалезныя рэліквіі."

# game/scripts/scene/scene_day_4.rpy:5786
translate belarusian d4_garage_lookaround_junk_d85744f8:

    # "Да нет же, просто хлам!"
    "Ды не ж, проста хлам!"

# game/scripts/scene/scene_day_4.rpy:5787
translate belarusian d4_garage_lookaround_junk_72c5b563:

    # "Никому тут не молятся, не бывает таких храмов! А воск на столешнице потому, что электричество часто отключают, и хозяин работает при свечах."
    "Нікому тут не моляцца, не бывае такіх храмаў! А воск на стальніцы таму, што электрычнасць часта адключаюць, і гаспадар працуе пры свечках."

# game/scripts/scene/scene_day_4.rpy:5794
translate belarusian d4_garage_lookaround_boxes_097ef2fd:

    # "Ящики."
    "Скрыні."

# game/scripts/scene/scene_day_4.rpy:5797
translate belarusian d4_garage_lookaround_boxes_3f7b9637:

    # "Отсечённые конечности, груды фарша и головы, облепленные мясными мухами. Вот, что я увижу, заглянув в ящик."
    "Адсечаныя канечнасці, груды фаршу і галовы, абляпленыя мяснымі мухамі. Вось што я ўбачу, зазірнуўшы ў скрыню."

# game/scripts/scene/scene_day_4.rpy:5798
translate belarusian d4_garage_lookaround_boxes_fdd0eae6:

    # "Как в ночном кошмаре: страшная версия «Поля чудес», в которой ведущий, хохоча и пуская слюну, вынимает из коробки истекающие гноем призы."
    "Як у начным кашмары: страшная версія «Поля цудаў», у якой вядучы, рагочучы і пускаючы сліну, вымае з каробкі прызы, што сцякаюць гноем."

# game/scripts/scene/scene_day_4.rpy:5799
translate belarusian d4_garage_lookaround_boxes_4783b8de:

    # "Но наяву ящик пуст. Если что там и было, это убрали с глаз долой."
    "Але наяве скрыня пустая. Калі што там і было, гэта прыбралі з вачэй далоў."

# game/scripts/scene/scene_day_4.rpy:5806
translate belarusian d4_garage_lookaround_car_26b1bd15:

    # "Автомобиль."
    "Аўтамабіль."

# game/scripts/scene/scene_day_4.rpy:5809
translate belarusian d4_garage_lookaround_car_8b83e655:

    # "Это машина. Что же ещё? Просто автомобиль, накрытый тканью. Внутри никого нет, ни живых, ни мёртвых. Вонь застарелой крови, она..."
    "Гэта машына. Што ж яшчэ? Проста аўтамабіль, накрыты тканінай. Унутры нікога няма, ні жывых, ні мёртвых. Смурод застарэлай крыві, ён..."

# game/scripts/scene/scene_day_4.rpy:5810
translate belarusian d4_garage_lookaround_car_d6fc7477:

    # "Она только у меня в голове. То, что находится под мешковиной, пахнет машинным маслом, не более."
    "Ён толькі ў мяне ў галаве. Тое, што знаходзіцца пад мешкавінай, пахне машынным маслам, не больш."

# game/scripts/scene/scene_day_4.rpy:5817
translate belarusian d4_garage_lookaround_tiski_c931d7de:

    # "Тиски."
    "Ціскі."

# game/scripts/scene/scene_day_4.rpy:5820
translate belarusian d4_garage_lookaround_tiski_b55fe5da:

    # "Что ими сжимали? Что хрустело между металлическими челюстями? Что лилось на верстак из рвущейся плоти? Чугун от длительного использования совсем раскрошился."
    "Што імі сціскалі? Што хрусцела паміж металічнымі сківіцамі? Што лілося на варштат з плоці, якая рвалася? Чыгун ад працяглага выкарыстання зусім раскрышыўся."

# game/scripts/scene/scene_day_4.rpy:5821
translate belarusian d4_garage_lookaround_tiski_8290cfa7:

    # "Но это обыкновенные слесарские тиски, такие же стоят в кабинете труда. Тиски для деталей, а не для жертв. Капли масла, а не крови."
    "Але гэта звычайныя слясарскія ціскі, такія ж стаяць у кабінеце працы. Ціскі для дэталяў, а не для ахвяр. Кроплі масла, а не крыві."

# game/scripts/scene/scene_day_4.rpy:5828
translate belarusian d4_garage_lookaround_shelf_8860abfa:

    # "Верхняя полка."
    "Верхняя паліца."

# game/scripts/scene/scene_day_4.rpy:5831
translate belarusian d4_garage_lookaround_shelf_53fc3d5b:

    # "Тусклый свет не проникает туда. В темноте может быть что угодно. Вдруг, оно смотрит на меня в упор, прячась за кружевом паутины? А если встать на цыпочки…"
    "Цьмянае святло не пранікае туды. У цемры можа быць што заўгодна. Раптам яно глядзіць на мяне ва ўпор, хаваючыся за карункамі павуціння? А калі стаць на дыбачкі..."

# game/scripts/scene/scene_day_4.rpy:5832
translate belarusian d4_garage_lookaround_shelf_5f13944b:

    # "Пыль и рухлядь."
    "Пыл і ламачча."

# game/scripts/scene/scene_day_4.rpy:5840
translate belarusian d4_garage_followup_91dcf95c:

    # voice "voice/romka/4day/183 r.ogg"
    # Rom "Аргх, ржавый хлам!"
    voice "voice/romka/4day/183 r.ogg"
    Rom "Аргх, іржавы хлам!"

# game/scripts/scene/scene_day_4.rpy:5842
translate belarusian d4_garage_followup_eff7be55:

    # voice "voice/romka/4day/184 ok.ogg"
    # Rom "Оказывается, это место капец какое унылое."
    voice "voice/romka/4day/184 ok.ogg"
    Rom "Аказваецца, гэтае месца капец якое нуднае."

# game/scripts/scene/scene_day_4.rpy:5844
translate belarusian d4_garage_followup_c0ee07ab:

    # voice "voice/romka/4day/185 K.ogg"
    # Rom "Какому такому мудаку пришла в голову идея перевозить гараж с места на место?"
    voice "voice/romka/4day/185 K.ogg"
    Rom "Якому такому мудаку прыйшла ў галаву ідэя перавозіць гараж з месца на месца?"

# game/scripts/scene/scene_day_4.rpy:5846
translate belarusian d4_garage_followup_76b71c8e:

    # voice "voice/romka/4day/186 Po.ogg"
    # Rom "Пошли отсюда."
    voice "voice/romka/4day/186 Po.ogg"
    Rom "Пайшлі адсюль."

# game/scripts/scene/scene_day_4.rpy:5848
translate belarusian d4_garage_followup_0432436d:

    # voice "voice/anton/4day/10 Aga.ogg"
    # Ant "Ага!"
    voice "voice/anton/4day/10 Aga.ogg"
    Ant "Ага!"

# game/scripts/scene/scene_day_4.rpy:5850
translate belarusian d4_garage_followup_9f213072:

    # voice "voice/anton/4day/10 Da.ogg"
    # Ant "Давай догоним Бяшу, ему крепко досталось."
    voice "voice/anton/4day/10 Da.ogg"
    Ant "Давай дагонім Бяшу, яму моцна дасталася."

# game/scripts/scene/scene_day_4.rpy:5879
translate belarusian d4_garage_followup_538678fb:

    # "Я вышел под снегопад."
    "Я выйшаў пад снегапад."

# game/scripts/scene/scene_day_4.rpy:5881
translate belarusian d4_garage_followup_f5c1755b:

    # "Ромка уже топал к выходу, когда вдруг остановился и задумчиво поглядел на автомобиль."
    "Ромка ўжо тупаў да выхаду, калі раптам спыніўся і задуменна паглядзеў на аўтамабіль."

# game/scripts/scene/scene_day_4.rpy:5904
translate belarusian d4_garage_followup_004612cf:

    # voice "voice/romka/4day/187 S.ogg"
    # Rom "Слушай, а что это мы с пустыми руками будем возвращаться?"
    voice "voice/romka/4day/187 S.ogg"
    Rom "Слухай, а чаго гэта мы з пустымі рукамі будзем вяртацца?"

# game/scripts/scene/scene_day_4.rpy:5906
translate belarusian d4_garage_followup_4cf153bb:

    # voice "voice/romka/4day/188 D.ogg"
    # Rom "Дай-ка я хоть магнитолу скручу."
    voice "voice/romka/4day/188 D.ogg"
    Rom "Дай-тка я хоць магнітолу скручу."

# game/scripts/scene/scene_day_4.rpy:5908
translate belarusian d4_garage_followup_993097f6:

    # voice "voice/romka/4day/189 O.ogg"
    # Rom "Обожди минуту, я мигом."
    voice "voice/romka/4day/189 O.ogg"
    Rom "Пачакай хвіліну, я мігам."

# game/scripts/scene/scene_day_4.rpy:5937
translate belarusian d4_garage_followup_a29657d2:

    # "Из-под чехла раздался всхлип."
    "З-пад чахла пачуўся ўсхліп."

# game/scripts/scene/scene_day_4.rpy:5970
translate belarusian d4_garage_followup_26d83f60:

    # "От неожиданности я чуть не плюхнулся в сугроб."
    "Ад нечаканасці я ледзь не плюхнуўся ў гурбу."

# game/scripts/scene/scene_day_4.rpy:6000
translate belarusian d4_garage_followup_b1b6222a:

    # voice "voice/romka/4day/190 T.ogg"
    # Rom "Ты слышал? Она там!"
    voice "voice/romka/4day/190 T.ogg"
    Rom "Ты чуў? Яна там!"

# game/scripts/scene/scene_day_4.rpy:6045
translate belarusian d4_garage_followup_46683a49:

    # "Я смотрел, как друг дёргает за ткань. Но подбежать помочь не хватало сил."
    "Я глядзеў, як сябар тузае за тканіну. Але падбегчы дапамагчы не хапала сіл."

# game/scripts/scene/scene_day_4.rpy:6046
translate belarusian d4_garage_followup_1217ed2b:

    # "Ноги словно примёрзли к земле."
    "Ногі нібы прымёрзлі да зямлі."

# game/scripts/scene/scene_day_4.rpy:6050
translate belarusian d4_garage_followup_32710e2a:

    # "Но Ромка справился без меня. Вспоротый с помощью ножа чехол полетел в сторону."
    "Але Ромка справіўся без мяне. Распароты з дапамогай нажа чахол паляцеў убок."

# game/scripts/scene/scene_day_4.rpy:6052
translate belarusian d4_garage_followup_ef9f8b54:

    # "Под ним не было автомобиля."
    "Пад ім не было аўтамабіля."

# game/scripts/scene/scene_day_4.rpy:6087
translate belarusian d4_garage_followup_e7206274:

    # "Там, вырастая из пола, блестела машинным маслом огромная мясорубка."
    "Там, вырастаючы з падлогі, блішчала машынным маслам велізарная мясарубка."

# game/scripts/scene/scene_day_4.rpy:6089
translate belarusian d4_garage_followup_d5fa16a3:

    # "Я видел такую в одной передаче «{u}До шестнадцати и старше{/u}»."
    "Я бачыў такую ў адной перадачы «{u}Да шаснаццаці і старэй{/u}»."

# game/scripts/scene/scene_day_4.rpy:6090
translate belarusian d4_garage_followup_d6668a4d:

    # "Промышленная махина, которой на фабриках перемалывали коровьи туши для колбасы."
    "Прамысловая махіна, якой на фабрыках перамолвалі каровіны тушы для каўбасы."

# game/scripts/scene/scene_day_4.rpy:6124
translate belarusian d4_garage_followup_89fcf962:

    # "В раструбе, напоминающем зёв кровожадного цветка венериной мухоловки, находилась связанная Катя."
    "У раструбе, што нагадваў зеў крыважэрнай кветкі венерынай мухалоўкі, знаходзілася звязаная Каця."

# game/scripts/scene/scene_day_4.rpy:6125
translate belarusian d4_garage_followup_c8eae1aa:

    # "Она очнулась словно от сна и её глаза округлились от страха. Кляп позволял лишь хныкать и мычать."
    "Яна ачулася нібы ад сну, і яе вочы акругліліся ад страху. Кляп дазваляў толькі хныкаць і мыкаць."

# game/scripts/scene/scene_day_4.rpy:6126
translate belarusian d4_garage_followup_459fd937:

    # voice "voice/romka/4day/191 S.ogg"
    # Rom "Скорее сюда!"
    voice "voice/romka/4day/191 S.ogg"
    Rom "Хутчэй сюды!"

# game/scripts/scene/scene_day_4.rpy:6171
translate belarusian d4_garage_followup_51449647:

    # "Я сбросил с себя оторопь, как тяжёлый чехол, и рванул в гараж."
    "Я скінуў з сябе здранцвенне, як цяжкі чахол, і рвануў у гараж."

# game/scripts/scene/scene_day_4.rpy:6181
translate belarusian d4_garage_followup_41478872:

    # "Тем временем Ромка почти взобрался на стальную душегубку, он взял Катю подмышки и..."
    "Тым часам Ромка амаль узлез на сталёвую душагубку, ён узяў Кацю пад пахі і..."

# game/scripts/scene/scene_day_4.rpy:6189
translate belarusian d4_garage_followup_8b7be8cd:

    # "Вероятно, коленом Ромка зацепил какую-то кнопку."
    "Верагодна, каленам Ромка зачапіў нейкую кнопку."

# game/scripts/scene/scene_day_4.rpy:6193
translate belarusian d4_garage_followup_e8b7d976:

    # "Загудел механизм. Звук напоминал ворчание голодного желудка."
    "Загудзеў механізм. Гук нагадваў бурчанне галоднага страўніка."

# game/scripts/scene/scene_day_4.rpy:6194
translate belarusian d4_garage_followup_2ba2fe6c:

    # "Ромка закричал испуганно, явно осознавая, что он наделал:"
    "Ромка закрычаў спалохана, відавочна ўсведамляючы, што ён нарабіў:"

# game/scripts/scene/scene_day_4.rpy:6201
translate belarusian d4_garage_followup_94b1e4b3:

    # voice "voice/romka/4day/192 Ch.ogg"
    # Rom "Чёрт! Выключи! Выключи её!"
    voice "voice/romka/4day/192 Ch.ogg"
    Rom "Чорт! Выключы! Выключы яе!"

# game/scripts/scene/scene_day_4.rpy:6208
translate belarusian d4_garage_followup_2a57e4c5:

    # voice "voice/anton/4day/11 Yas.ogg"
    # Ant "Я сейчас! Держись!"
    voice "voice/anton/4day/11 Yas.ogg"
    Ant "Я зараз! Трымайся!"

# game/scripts/scene/scene_day_4.rpy:6214
translate belarusian d4_garage_followup_131ef294:

    # "Ничего!"
    "Нічога!"

# game/scripts/scene/scene_day_4.rpy:6246
translate belarusian d4_garage_followup_34ee3d7f:

    # "Ни одна чёртова кнопка, ни один тумблер не могли остановить этот жуткий скрежет жерновов."
    "Ніводная чортава кнопка, ніводзін тумблер не маглі спыніць гэты жудасны скрыгат жорнаў."

# game/scripts/scene/scene_day_4.rpy:6294
translate belarusian d4_garage_followup_f29ac563:

    # voice "voice/anton/4day/12 Nera.ogg"
    # Ant "Не работает! Ни хрена не помогает!"
    voice "voice/anton/4day/12 Nera.ogg"
    Ant "Не працуе! Ні хрэна не дапамагае!"

# game/scripts/scene/scene_day_4.rpy:6300
translate belarusian d4_garage_followup_16e3b06a:

    # voice "voice/romka/4day/193 Ta.ogg"
    # Rom "Так помоги мне!"
    voice "voice/romka/4day/193 Ta.ogg"
    Rom "Дык дапамажы мне!"

# game/scripts/scene/scene_day_4.rpy:6305
translate belarusian d4_garage_followup_a66c9835:

    # "Мы согнулись над Катей и рванули её за локоть."
    "Мы сагнуліся над Кацяй і рванулі яе за локаць."

# game/scripts/scene/scene_day_4.rpy:6310
translate belarusian d4_garage_followup_09eda2dc:

    # "Внизу заработали спирали. Сначала медленно, но с каждым витком они набирали скорость."
    "Унізе запрацавалі спіралі. Спачатку павольна, але з кожным вітком яны набіралі хуткасць."

# game/scripts/scene/scene_day_4.rpy:6313
translate belarusian d4_garage_followup_09218290:

    # "Раздался хруст. Так костёр поедает хворост."
    "Пачуўся хруст. Так вогнішча паядае хмыз."

# game/scripts/scene/scene_day_4.rpy:6498
translate belarusian settings_round1_decay_4f64726c:

    # "Модификатор уменьшает силу буста в зависимости от того, где сейчас находится Катя. Катин прогресс пересчитывается в число от 0 до 1, где 0 - нижний край, а 1 - верхний край."
    "Мадыфікатар змяншае сілу буста ў залежнасці ад таго, дзе зараз знаходзіцца Каця. Кацін прагрэс пералічваецца ў лік ад 0 да 1, дзе 0 — ніжні край, а 1 — верхні край."

# game/scripts/scene/scene_day_4.rpy:6499
translate belarusian settings_round1_decay_75cad59a:

    # "Пересчитанный катин прогресс умножается на Decay-модификатор, и полученная доля вычитывается из буста."
    "Пералічаны Кацін прагрэс памнажаецца на Decay-мадыфікатар, і атрыманая доля адымаецца ад буста."

# game/scripts/scene/scene_day_4.rpy:6500
translate belarusian settings_round1_decay_9d2d0204:

    # "К примеру, буст 100, decay 0.5, Катя на 150 пикселях. Катин прогресс = 150/200 = 0.75, итоговый буст = 100 - (1.0 - 0.5 * 0.75) = 75"
    "Напрыклад, буст 100, decay 0.5, Каця на 150 пікселях. Кацін прагрэс = 150/200 = 0.75, выніковы буст = 100 - (1.0 - 0.5 * 0.75) = 75"

# game/scripts/scene/scene_day_4.rpy:6501
translate belarusian settings_round1_decay_2377eb08:

    # "Второй раунд настроен так, что в нём высокий decay, но и зона победы - 180 пикселей. Поднять Катю до самого верха невозможно, но это и не надо - достаточно не дать ей упать несколько секунд."
    "Другі раўнд наладжаны так, што ў ім высокі decay, але і зона перамогі — 180 пікселяў. Падняць Кацю да самага верху немагчыма, але гэта і не трэба — дастаткова не даць ёй упасці некалькі секунд."

# game/scripts/scene/scene_day_4.rpy:6527
translate belarusian settings_round1_trigger_c3bcd39f:

    # "Всего у Кати 200 пикселей для перемещения, начинает она посередине, на 100."
    "Усяго ў Каці 200 пікселяў для перамяшчэння, пачынае яна пасярэдзіне, на 100."

# game/scripts/scene/scene_day_4.rpy:6528
translate belarusian settings_round1_trigger_a662995f:

    # "WIN: в скольки пикселях от верхнего края начинает отсчитываться таймер победы. К примеру, 5 - это в диапазоне от 195 до 200. 160 - от 40 до 200."
    "WIN: за колькі пікселяў ад верхняга краю пачынае адлічвацца таймер перамогі. Напрыклад, 5 — гэта ў дыяпазоне ад 195 да 200. 160 — ад 40 да 200."

# game/scripts/scene/scene_day_4.rpy:6529
translate belarusian settings_round1_trigger_7a0c5f9d:

    # "LOSE: аналогично, только от нижнего края. 5 - от 0 до 5. 40 - от 0 до 40."
    "LOSE: аналагічна, толькі ад ніжняга краю. 5 — ад 0 да 5. 40 — ад 0 да 40."

# game/scripts/scene/scene_day_4.rpy:6530
translate belarusian settings_round1_trigger_56bfdc76:

    # "Для победы Катю надо удержать в зоне поражения какое-то время, поражение же засчитывает мгновенно, как Катя попала в зону LOSE."
    "Для перамогі Кацю трэба ўтрымаць у зоне паражэння нейкі час, паражэнне ж залічваецца імгненна, як Каця трапіла ў зону LOSE."

# game/scripts/scene/scene_day_4.rpy:6574
translate belarusian settings_round1_win_b662cbfa:

    # "Для засчитывания победы игрок должен удержать Катю в победной зоне в течение заданного времени. Если за время отсчёта таймера Катя покинула зону победы - таймер сбрасывается."
    "Для залічэння перамогі гулец павінен утрымаць Кацю ў пераможнай зоне на працягу зададзенага часу. Калі за час адліку таймера Каця пакінула зону перамогі — таймер скідаецца."

# game/scripts/scene/scene_day_4.rpy:6575
translate belarusian settings_round1_win_1d286922:

    # "Для засчитывания поражения игрок должен довести Катю до зоны, поражение засчитывается сразу же."
    "Для залічэння паражэння гулец павінен давесці Кацю да зоны, паражэнне залічваецца адразу ж."

# game/scripts/scene/scene_day_4.rpy:6699
translate belarusian settings_round2_decay_4f64726c:

    # "Модификатор уменьшает силу буста в зависимости от того, где сейчас находится Катя. Катин прогресс пересчитывается в число от 0 до 1, где 0 - нижний край, а 1 - верхний край."
    "Мадыфікатар змяншае сілу буста ў залежнасці ад таго, дзе зараз знаходзіцца Каця. Кацін прагрэс пералічваецца ў лік ад 0 да 1, дзе 0 — ніжні край, а 1 — верхні край."

