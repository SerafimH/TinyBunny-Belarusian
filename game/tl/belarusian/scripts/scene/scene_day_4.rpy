translate belarusian settings_round2_trigger_7a0c5f9d:

    # "LOSE: аналогично, только от нижнего края. 5 - от 0 до 5. 40 - от 0 до 40."
    "LOSE: аналагічна, толькі ад ніжняга краю. 5 — ад 0 да 5. 40 — ад 0 да 40."

# game/scripts/scene/scene_day_4.rpy:6731
translate belarusian settings_round2_trigger_56bfdc76:

    # "Для победы Катю надо удержать в зоне поражения какое-то время, поражение же засчитывает мгновенно, как Катя попала в зону LOSE."
    "Для перамогі Кацю трэба ўтрымаць у зоне паражэння нейкі час, паражэнне ж залічваецца імгненна, як Каця трапіла ў зону LOSE."

# game/scripts/scene/scene_day_4.rpy:6775
translate belarusian settings_round2_win_b662cbfa:

    # "Для засчитывания победы игрок должен удержать Катю в победной зоне в течение заданного времени. Если за время отсчёта таймера Катя покинула зону победы - таймер сбрасывается."
    "Для залічэння перамогі гулец павінен утрымаць Кацю ў пераможнай зоне на працягу зададзенага часу. Калі за час адліку таймера Каця пакінула зону перамогі — таймер скідаецца."

# game/scripts/scene/scene_day_4.rpy:6776
translate belarusian settings_round2_win_1d286922:

    # "Для засчитывания поражения игрок должен довести Катю до зоны, поражение засчитывается сразу же."
    "Для залічэння паражэння гулец павінен давесці Кацю да зоны, паражэнне залічваецца адразу ж."

# game/scripts/scene/scene_day_4.rpy:6900
translate belarusian sK1_good_89d226dd:

    # "Катя взвыла сквозь кляп."
    "Каця завыла праз кляп."

# game/scripts/scene/scene_day_4.rpy:6902
translate belarusian sK1_good_b50ae41a:

    # "Но мясорубка не отпускала — мясорубка питалась."
    "Але мясарубка не адпускала — мясарубка жывілася."

# game/scripts/scene/scene_day_4.rpy:6945
translate belarusian sK1_good_406ad609:

    # "Я закричал, увидев, как лезвия наматывают на себя лохмотья сплюснутых ног."
    "Я закрычаў, убачыўшы, як лёзы намотваюць на сябе лахманы сплюшчаных ног."

# game/scripts/scene/scene_day_4.rpy:6947
translate belarusian sK1_good_ca1e6e79:

    # "Ноги Кати теперь напоминали измочаленные колготы."
    "Ногі Каці цяпер нагадвалі пашматаныя калготы."

# game/scripts/scene/scene_day_4.rpy:6949
translate belarusian sK1_good_d182f8b5:

    # "Кости проткнули кожу и торчали, словно сучки."
    "Косці праткнулі скуру і тырчалі, нібы сучкі."

# game/scripts/scene/scene_day_4.rpy:6951
translate belarusian sK1_good_c145da1c:

    # "В багровом сиропе плавала белая коленная чашечка."
    "У барвовым сіропе плавала белая каленная чашачка."

# game/scripts/scene/scene_day_4.rpy:7007
translate belarusian sK1_good_a349de4b:

    # "Я тянул Катю на себя и чувствовал, что проигрываю."
    "Я цягнуў Кацю на сябе і адчуваў, што прайграю."

# game/scripts/scene/scene_day_4.rpy:7174
translate belarusian d4_save_katya_after_fcf2fddb:

    # "Лезвия раздробили таз. Запенилась кровавая каша."
    "Лёзы раздрабілі таз. Запенілася крывавая каша."

# game/scripts/scene/scene_day_4.rpy:7175
translate belarusian d4_save_katya_after_4d52f0fa:

    # "Катя выла на одной безумной ноте."
    "Каця выла на адной вар'яцкай ноце."

# game/scripts/scene/scene_day_4.rpy:7177
translate belarusian d4_save_katya_after_4982f406:

    # "Глаза вылезли из орбит и белки стали красными от лопнувших сосудов. Лезвия дошли до живота."
    "Вочы вылезлі з арбіт, і бялкі сталі чырвонымі ад сасудаў, што лопнулі. Лёзы дайшлі да жывата."

# game/scripts/scene/scene_day_4.rpy:7181
translate belarusian d4_save_katya_after_2310e943:

    # "Легко выгребли из плоти сизые трубки кишечника."
    "Лёгка выграблі з плоці сізыя трубкі кішэчніка."

# game/scripts/scene/scene_day_4.rpy:7182
translate belarusian d4_save_katya_after_6db0836a:

    # "Так Оля наматывала спагетти на вилку. Вонь внутренностей распространилась по гаражу."
    "Так Оля наматвала спагеці на відэлец. Смурод вантробаў распаўсюдзіўся па гаражы."

# game/scripts/scene/scene_day_4.rpy:7184
translate belarusian d4_save_katya_after_b7557614:

    # "Я больше не пытался помочь Кате – в этом не было ни малейшего смысла."
    "Я больш не спрабаваў дапамагчы Каці — у гэтым не было ні найменшага сэнсу."

# game/scripts/scene/scene_day_4.rpy:7185
translate belarusian d4_save_katya_after_dd0bd106:

    # "Голова одноклассницы свободно болталась. Мутные глаза смотрели в пустоту." id d4_save_katya_after_dd0bd106
    "Галава аднакласніцы свабодна боўталася. Мутныя вочы глядзелі ў пустэчу."

# game/scripts/scene/scene_day_4.rpy:7186
translate belarusian d4_save_katya_after_c94714f8:

    # "Мясорубка перегрызла рёбра и поглотила грудь девочки." id d4_save_katya_after_c94714f8
    "Мясарубка перагрызла рэбры і паглынула грудзі дзяўчынкі."

# game/scripts/scene/scene_day_4.rpy:7187
translate belarusian d4_save_katya_after_89e41806:

    # "От кровяного давления лицо Кати потемнело. Алые струйки сочились из глаз и ушей."
    "Ад крывянога ціску твар Каці пацямнеў. Пунсовыя струменьчыкі сачыліся з вачэй і вушэй."

# game/scripts/scene/scene_day_4.rpy:7227
translate belarusian d4_save_katya_after_ec07fb46:

    # "Катя умерла, но механизм продолжал работу."
    "Каця памерла, але механізм працягваў працу."

# game/scripts/scene/scene_day_4.rpy:7231
translate belarusian d4_save_katya_after_48025163:

    # "Волосы попали в лезвия, и скальп с сочным хлюпаньем отделился от черепа."
    "Валасы трапілі ў лёзы, і скальп з сакавітым хлюпаннем аддзяліўся ад чэрапа."

# game/scripts/scene/scene_day_4.rpy:7235
translate belarusian d4_save_katya_after_85a0bc7b:

    # "Кожа лица съехала вниз, гримаса смерти заставила меня отшатнуться."
    "Скура твару з'ехала ўніз, грымаса смерці прымусіла мяне адхіснуцца."

# game/scripts/scene/scene_day_4.rpy:7239
translate belarusian d4_save_katya_after_5f8165e7:

    # "Я ощутил руки на своём теле и решил, что сейчас меня швырнут в раструб в качестве десерта."
    "Я адчуў рукі на сваім целе і вырашыў, што зараз мяне шпурнуць у раструб у якасці дэсерту."

# game/scripts/scene/scene_day_4.rpy:7240
translate belarusian d4_save_katya_after_04251cf7:

    # "Что я смешаюсь в единый фарш с Катей."
    "Што я змяшаюся ў адзіны фарш з Кацяй."

# game/scripts/scene/scene_day_4.rpy:7241
translate belarusian d4_save_katya_after_7d234027:

    # "Но это Рома тащил меня прочь."
    "Але гэта Рома цягнуў мяне прэч."

# game/scripts/scene/scene_day_4.rpy:7258
translate belarusian d4_save_katya_after_a5f37d8e:

    # "Из металлического хобота механизма шлёпалась в поддон толстая колбаса-кровянка с застрявшими волосами и костями."
    "З металічнага хобата механізма шлёпалася ў паддон тоўстая каўбаса-крывянка з захраслымі валасамі і косткамі."

# game/scripts/scene/scene_day_4.rpy:7264
translate belarusian d4_save_katya_after_4b5c0763:

    # voice "voice/romka/4day/250 Mi.ogg"
    # Rom "Мы сделали всё, что могли..."
    voice "voice/romka/4day/250 Mi.ogg"
    Rom "Мы зрабілі ўсё, што маглі..."

# game/scripts/scene/scene_day_4.rpy:7270
translate belarusian d4_save_katya_after_bf6c7e0d:

    # voice "voice/romka/4day/197 N.ogg"
    # Rom "Надо убираться отсюда."
    voice "voice/romka/4day/197 N.ogg"
    Rom "Трэба зматвацца адсюль."

# game/scripts/scene/scene_day_4.rpy:7284
translate belarusian d4_save_katya_after_f322e321:

    # "Ледяными пальцами я расстегнул молнию на рюкзаке."
    "Ледзянымі пальцамі я расшпіліў маланку на рукзаку."

# game/scripts/scene/scene_day_4.rpy:7285
translate belarusian d4_save_katya_after_434c3169:

    # voice "voice/romka/4day/198 Ti.ogg"
    # Rom "Ты свихнулся?"
    voice "voice/romka/4day/198 Ti.ogg"
    Rom "Ты звар'яцеў?"

# game/scripts/scene/scene_day_4.rpy:7298
translate belarusian d4_save_katya_after_2e662d22:

    # "Я поднял «Полароид». Рукавом вытер слёзы."
    "Я падняў «Палароід». Рукавом выцер слёзы."

# game/scripts/scene/scene_day_4.rpy:7300
translate belarusian d4_save_katya_after_7a0d2766:

    # voice "voice/anton/4day/14 Nam.ogg"
    # Ant "Нам нужны доказательства."
    voice "voice/anton/4day/14 Nam.ogg"
    Ant "Нам патрэбны доказы."

# game/scripts/scene/scene_day_4.rpy:7303
translate belarusian d4_save_katya_after_ef33aa9e:

    # "Лезвия дожёвывали кости."
    "Лёзы дажоўвалі косткі."

# game/scripts/scene/scene_day_4.rpy:7304
translate belarusian d4_save_katya_after_f6f699c2:

    # "На одном из стальных зубов повисла отхваченная косичка."
    "На адным са сталёвых зубоў павісла адхопленая касічка."

# game/scripts/scene/scene_day_4.rpy:7305
translate belarusian d4_save_katya_after_21466eac:

    # "Я прицелился, поймал в объектив резинку с пластмассовой клубничкой."
    "Я прыцэліўся, злавіў у аб'ектыў гумку з пластмасавай клубнічкай."

# game/scripts/scene/scene_day_4.rpy:7338
translate belarusian d4_garage_photo_b3fe7568:

    # "Клац."
    "Клац."

# game/scripts/scene/scene_day_4.rpy:7364
translate belarusian d4_garage_photo_ba7c80e1:

    # "Коса отправилась в нутро мясорубки. И махина замерла, булькнув напоследок."
    "Каса адправілася ў нутро мясарубкі. І махіна замерла, булькнуўшы напрыканцы."

# game/scripts/scene/scene_day_4.rpy:7372
translate belarusian d4_garage_photo_d8357ea0:

    # voice "voice/romka/4day/194 Ka.ogg"
    # Rom "Какого хрена ты стоял, как вкопанный?!"
    voice "voice/romka/4day/194 Ka.ogg"
    Rom "Якога хрэна ты стаяў, як укопаны?!"

# game/scripts/scene/scene_day_4.rpy:7374
translate belarusian d4_garage_photo_fbcf10b5:

    # voice "voice/romka/4day/195 m.ogg"
    # Rom "Мы же могли успеть её спасти..."
    voice "voice/romka/4day/195 m.ogg"
    Rom "Мы ж маглі паспець яе выратаваць..."

# game/scripts/scene/scene_day_4.rpy:7376
translate belarusian d4_garage_photo_19eae413:

    # voice "voice/romka/4day/196 V.ogg"
    # Rom "Вот уж не думал, что ты её так сильно ненавидел."
    voice "voice/romka/4day/196 V.ogg"
    Rom "Вось ужо не думаў, што ты яе так моцна ненавідзеў."

# game/scripts/scene/scene_day_4.rpy:7382
translate belarusian d4_garage_photo_bf6c7e0d:

    # voice "voice/romka/4day/197 N.ogg"
    # Rom "Надо убираться отсюда."
    voice "voice/romka/4day/197 N.ogg"
    Rom "Трэба зматвацца адсюль."

# game/scripts/scene/scene_day_4.rpy:7432
translate belarusian d4_garage_photo_33b01cdb:

    # "Мы вывалились из гаража."
    "Мы вываліліся з гаража."

# game/scripts/scene/scene_day_4.rpy:7446
translate belarusian d4_garage_photo_2edf6182:

    # "Я взял горсть снега и запихнул себе в рот. Прожевал рыхлую субстанцию."
    "Я ўзяў жменю снегу і запхнуў сабе ў рот. Пражаваў рыхлую субстанцыю."

# game/scripts/scene/scene_day_4.rpy:7448
translate belarusian d4_garage_photo_22031de7:

    # "Рома стоял на коленях, утирая лицо снежком."
    "Рома стаяў на каленях, уціраючы твар сняжком."

# game/scripts/scene/scene_day_4.rpy:7480
translate belarusian d4_garage_photo_4adaaefb:

    # "Я отползал от чудовищной мясорубки, цепляясь ногтями за лёд."
    "Я адпаўзаў ад пачварнай мясарубкі, чапляючыся пазногцямі за лёд."

# game/scripts/scene/scene_day_4.rpy:7481
translate belarusian d4_garage_photo_bb753023:

    # "Кашлял, точно пытался отхаркнуть воспоминания об увиденном."
    "Кашляў, нібы спрабаваў адхаркнуць успаміны пра ўбачанае."

# game/scripts/scene/scene_day_4.rpy:7500
translate belarusian d4_garage_photo_2e66c4c3:

    # "Но я знал, что никогда не забуду ни запаха, ни звука ломающихся костей, ни предсмертной агонии Кати."
    "Але я ведаў, што ніколі не забуду ні паху, ні гуку костак, што ламаюцца, ні перадсмяротнай агоніі Каці."

# game/scripts/scene/scene_day_4.rpy:7515
translate belarusian d4_garage_photo_eed0cb29:

    # "Рома пополз ко мне на четвереньках, и на секунду я решил, что он потерял рассудок от ужаса."
    "Рома папоўз да мяне на карачках, і на секунду я вырашыў, што ён страціў розум ад жаху."

# game/scripts/scene/scene_day_4.rpy:7516
translate belarusian d4_garage_photo_df6f281e:

    # "И теперь, как дикий зверёныш, перегрызёт мне глотку."
    "І цяпер, як дзікае звераня, перагрызе мне глотку."

# game/scripts/scene/scene_day_4.rpy:7530
translate belarusian d4_garage_photo_c4ce8133:

    # "Но он взял меня за куртку и принялся снегом оттирать красные капли с рукава."
    "Але ён узяў мяне за куртку і пачаў снегам адціраць чырвоныя кроплі з рукава."

# game/scripts/scene/scene_day_4.rpy:7532
translate belarusian d4_garage_photo_0b52d536:

    # voice "voice/anton/4day/17 Chto.ogg"
    # Ant "Что ты делаешь?"
    voice "voice/anton/4day/17 Chto.ogg"
    Ant "Што ты робіш?"

# game/scripts/scene/scene_day_4.rpy:7535
translate belarusian d4_garage_photo_1578b1e1:

    # voice "voice/romka/4day/200 N.ogg"
    # Rom "Никто не должен узнать."
    voice "voice/romka/4day/200 N.ogg"
    Rom "Ніхто не павінен даведацца."

# game/scripts/scene/scene_day_4.rpy:7538
translate belarusian d4_garage_photo_4201ff68:

    # voice "voice/anton/4day/Ochem.ogg"
    # Ant "О чём ты?"
    voice "voice/anton/4day/Ochem.ogg"
    Ant "Пра што ты?"

# game/scripts/scene/scene_day_4.rpy:7541
translate belarusian d4_garage_photo_7bc52ad8:

    # voice "voice/romka/4day/201 N.ogg"
    # Rom "Никакой милиции, слышишь?"
    voice "voice/romka/4day/201 N.ogg"
    Rom "Ніякай міліцыі, чуеш?"

# game/scripts/scene/scene_day_4.rpy:7545
translate belarusian d4_garage_photo_d1a917c3:

    # voice "voice/romka/4day/202 Ka.ogg"
    # Rom "Катю по частям мы не соберём."
    voice "voice/romka/4day/202 Ka.ogg"
    Rom "Кацю па частках мы не збяром."

# game/scripts/scene/scene_day_4.rpy:7549
translate belarusian d4_garage_photo_92641a8f:

    # voice "voice/romka/4day/203 A.ogg"
    # Rom "А я не хочу сесть в тюрьму, как мой батя."
    voice "voice/romka/4day/203 A.ogg"
    Rom "А я не хачу сесці ў турму, як мой баця."

# game/scripts/scene/scene_day_4.rpy:7552
translate belarusian d4_garage_photo_218252f5:

    # voice "voice/anton/4day/18 no.ogg"
    # Ant "Но ты говорил..."
    voice "voice/anton/4day/18 no.ogg"
    Ant "Але ты казаў..."

# game/scripts/scene/scene_day_4.rpy:7555
translate belarusian d4_garage_photo_27a4a094:

    # voice "voice/romka/4day/204 G.ogg"
    # Rom "Говорил-говорил."
    voice "voice/romka/4day/204 G.ogg"
    Rom "Казаў-казаў."

# game/scripts/scene/scene_day_4.rpy:7558
translate belarusian d4_garage_photo_c7cdd8d4:

    # "Он метнул ненавидящий взгляд в Гараж."
    "Ён кінуў поўны нянавісці погляд у Гараж."

# game/scripts/scene/scene_day_4.rpy:7560
translate belarusian d4_garage_photo_4d1c52ee:

    # voice "voice/romka/4day/205 Ya.ogg"
    # Rom "Я включил мясорубку."
    voice "voice/romka/4day/205 Ya.ogg"
    Rom "Я ўключыў мясарубку."

# game/scripts/scene/scene_day_4.rpy:7563
translate belarusian d4_garage_photo_4e51021c:

    # voice "voice/anton/4day/19 Nech.ogg"
    # Ant "Нечаянно!"
    voice "voice/anton/4day/19 Nech.ogg"
    Ant "Выпадкова!"

# game/scripts/scene/scene_day_4.rpy:7566
translate belarusian d4_garage_photo_4dfaf325:

    # voice "voice/romka/4day/206 Pop.ogg"
    # Rom "Попробуй докажи."
    voice "voice/romka/4day/206 Pop.ogg"
    Rom "Паспрабуй дакажы."

# game/scripts/scene/scene_day_4.rpy:7570
translate belarusian d4_garage_photo_83f2d107:

    # voice "voice/romka/4day/207Em.ogg"
    # Rom "Им только и надо, чтоб на кого-то повесить убийства."
    voice "voice/romka/4day/207Em.ogg"
    Rom "Ім толькі і трэба, каб на кагосьці павесіць забойствы."

# game/scripts/scene/scene_day_4.rpy:7574
translate belarusian d4_garage_photo_26a3fa5e:

    # voice "voice/romka/4day/208Ya.ogg"
    # Rom "Я за решётку пойду, а маньяк будет разгуливать на свободе."
    voice "voice/romka/4day/208Ya.ogg"
    Rom "Я за краты пайду, а маньяк будзе разгульваць на волі."

# game/scripts/scene/scene_day_4.rpy:7578
translate belarusian d4_garage_photo_6d17bb02:

    # voice "voice/romka/4day/209 Bl.ogg"
    # Rom "Блядь! А жизнь ведь только начала налаживаться!.."
    voice "voice/romka/4day/209 Bl.ogg"
    Rom "Блядзь! А жыццё ж толькі пачало наладжвацца!.."

# game/scripts/scene/scene_day_4.rpy:7581
translate belarusian d4_garage_photo_4bcbc43d:

    # voice "voice/anton/4day/20 No.ogg"
    # Ant "Но мы не можем просто так..."
    voice "voice/anton/4day/20 No.ogg"
    Ant "Але мы не можам проста так..."

# game/scripts/scene/scene_day_4.rpy:7584
translate belarusian d4_garage_photo_77792c3a:

    # voice "voice/romka/4day/210 M.ogg"
    # Rom "Можем! Поклянись, что никому не скажешь!"
    voice "voice/romka/4day/210 M.ogg"
    Rom "Можам! Пакляніся, што нікому не скажаш!"

# game/scripts/scene/scene_day_4.rpy:7587
translate belarusian d4_garage_photo_93374c0e:

    # "«А иначе» он не произнёс, но это читалось в его тоне."
    "«А інакш» ён не прамовіў, але гэта чыталася ў яго тоне."

# game/scripts/scene/scene_day_4.rpy:7599
translate belarusian d4_garage_photo_77b833f3:

    # "Я молчал минуту, думая о кровавом бульоне, льющемся из махины."
    "Я маўчаў хвіліну, думаючы пра крывавы бульён, які ліўся з махіны."

# game/scripts/scene/scene_day_4.rpy:7600
translate belarusian d4_garage_photo_44911975:

    # "Рома был прав."
    "Рома меў рацыю."

# game/scripts/scene/scene_day_4.rpy:7601
translate belarusian d4_garage_photo_00f288a8:

    # "Даже если Тихонов поверит нам, Гараж к тому времени может исчезнуть."
    "Нават калі Ціханаў паверыць нам, Гараж да таго часу можа знікнуць."

# game/scripts/scene/scene_day_4.rpy:7602
translate belarusian d4_garage_photo_ba456dd4:

    # "Чудесным образом перенестись на другую поляну в другую часть этого чёртового леса."
    "Цудоўным чынам перанесціся на іншую паляну ў іншую частку гэтага чортавага лесу."

# game/scripts/scene/scene_day_4.rpy:7607
translate belarusian d4_garage_photo_ef0737cd:

    # voice "voice/romka/4day/212 Po.ogg"
    # Rom "Пожалуйста."
    voice "voice/romka/4day/212 Po.ogg"
    Rom "Калі ласка."

# game/scripts/scene/scene_day_4.rpy:7611
translate belarusian d4_garage_photo_a5fc74dc:

    # voice "voice/romka/4day/213 Kt.ogg"
    # Rom "Кто-то должен защищать Полину."
    voice "voice/romka/4day/213 Kt.ogg"
    Rom "Хтосьці павінен абараняць Паліну."

# game/scripts/scene/scene_day_4.rpy:7614
translate belarusian d4_garage_photo_500badc7:

    # "«И Олю», - подумал я, медленно кивая."
    "«І Олю», — падумаў я, павольна ківаючы."

# game/scripts/scene/scene_day_4.rpy:7615
translate belarusian d4_garage_photo_4f9310ee:

    # voice "voice/anton/4day/21 Horo.ogg"
    # Ant "Хорошо."
    voice "voice/anton/4day/21 Horo.ogg"
    Ant "Добра."

# game/scripts/scene/scene_day_4.rpy:7617
translate belarusian d4_garage_photo_6d834150:

    # "Я боялся, что не сдержу слово."
    "Я баяўся, што не стрымаю слова."

# game/scripts/scene/scene_day_4.rpy:7675
translate belarusian d4_garage_photo_dbe02943:

    # "Что мама прочтёт всё на моём лице, увидит нестёртые капли крови, унюхает запах."
    "Што мама прачытае ўсё на маім твары, убачыць нясцёртыя кроплі крыві, унюхае пах."

# game/scripts/scene/scene_day_4.rpy:7676
translate belarusian d4_garage_photo_b4d6321b:

    # "И я расколюсь, просто упаду перед ней на пол и буду рыдать от страха за себя и за родных."
    "І я раскалюся, проста ўпаду перад ёй на падлогу і буду рыдаць ад страху за сябе і за родных."

# game/scripts/scene/scene_day_4.rpy:7677
translate belarusian d4_garage_photo_1ff02d4f:

    # "Я ещё не знал, что ждёт меня в месте, которое я по ошибке называл домом."
    "Я яшчэ не ведаў, што чакае мяне ў месцы, якое я памылкова называў домам."

# game/scripts/scene/scene_day_4.rpy:7798
translate belarusian d4_police_entry_c2152e79:

    # "В дежурной части почему-то пахло {u}чебуреками{/u} вперемешку с сигаретным дымом."
    "У дзяжурнай часці чамусьці пахла {u}чабурэкамі{/u} ўперамешку з цыгарэтным дымам."

# game/scripts/scene/scene_day_4.rpy:7799
translate belarusian d4_police_entry_732fe0c4:

    # "Из глубин участка приглушённо и тоскливо пела Татьяна Буланова."
    "З глыбінь пастарунка прыглушана і тужліва спявала Таццяна Буланава."

# game/scripts/scene/scene_day_4.rpy:7800
translate belarusian d4_police_entry_a83d30ea:

    # "Казалось, под такие слезливые песни невозможно работать — только отпевать покойников у разрытой могилы."
    "Здавалася, пад такія слязлівыя песні немагчыма працаваць — толькі адпяваць нябожчыкаў ля разрытай магілы."

# game/scripts/scene/scene_day_4.rpy:7813
translate belarusian d4_police_lookaround_cage_566172d7:

    # "«Обезьянник»."
    "«Абяз'яннік»."

# game/scripts/scene/scene_day_4.rpy:7816
translate belarusian d4_police_lookaround_cage_7b1c6fe7:

    # "Как-то раз папа упоминал при мне «обезьянник» — камеру, где держат только что пойманных преступников."
    "Неяк раз тата згадваў пры мне «абяз'яннік» — камеру, дзе трымаюць толькі што злоўленых злачынцаў."

# game/scripts/scene/scene_day_4.rpy:7817
translate belarusian d4_police_lookaround_cage_6963cbc3:

    # "Толстые прутья решётки выглядели устрашающе, прямо как в кино. Мне даже захотелось нарисовать это место. На секунду я представил, кого бы мог изобразить внутри клетки. "
    "Тоўстыя пруты кратаў выглядалі застрашліва, проста як у кіно. Мне нават захацелася намаляваць гэтае месца. На секунду я ўявіў, каго б мог адлюстраваць унутры клеткі. "

# game/scripts/scene/scene_day_4.rpy:7818
translate belarusian d4_police_lookaround_cage_fcfe3787:

    # "На ум сразу пришёл Ромка. Надо сказать, он отлично бы сюда вписался!"
    "На думку адразу прыйшоў Ромка. Трэба сказаць, ён выдатна б сюды ўпісаўся!"

# game/scripts/scene/scene_day_4.rpy:7826
translate belarusian d4_police_lookaround_mask_bf306da7:

    # "Противогаз."
    "Процігаз."

# game/scripts/scene/scene_day_4.rpy:7829
translate belarusian d4_police_lookaround_mask_f33d9e0a:

    # "На спинке стула висел старый противогаз с хоботом. Здорово, что в милиции не забывают про тренировки! Только вот почему фильтра не видно?"
    "На спінцы крэсла вісеў стары процігаз з хобатам. Выдатна, што ў міліцыі не забываюць пра трэніроўкі! Толькі вось чаму фільтра не відаць?"

# game/scripts/scene/scene_day_4.rpy:7830
translate belarusian d4_police_lookaround_mask_74ba0416:

    # "Или противогаз здесь используют для чего-то другого?.."
    "Ці процігаз тут выкарыстоўваюць для чагосьці іншага?.."

# game/scripts/scene/scene_day_4.rpy:7844
translate belarusian d4_police_followup_e231e586:

    # "Я мотнул головой, отгоняя мрачные мысли. Стянул шапку и провёл пятернёй по взъерошенным волосам."
    "Я матнуў галавой, адганяючы змрочныя думкі. Сцягнуў шапку і правёў пяцярнёй па ўскудлачаных валасах."

# game/scripts/scene/scene_day_4.rpy:7845
translate belarusian d4_police_followup_2f7e652a:

    # "Снег оттаивал с подошв, оставляя на плитке мокрые следы."
    "Снег адтайваў з падэшваў, пакідаючы на плітцы мокрыя сляды."

# game/scripts/scene/scene_day_4.rpy:7847
translate belarusian d4_police_followup_79697e4b:

    # "Громко тикали часы, а со стенда «Внимание! Розыск» на нас глядели сгинувшие в ночи дети."
    "Гучна цікаў гадзіннік, а са стэнда «Увага! Вышук» на нас глядзелі дзеці, што згінулі ў ночы."

# game/scripts/scene/scene_day_4.rpy:7849
translate belarusian d4_police_followup_a9a18b2d:

    # "Среди ксерокопий преступников был нарисованный мной фоторобот."
    "Сярод ксеракопій злачынцаў быў намаляваны мной фотаробат."

# game/scripts/scene/scene_day_4.rpy:7851
translate belarusian d4_police_followup_ba28b4d1:

    # "Среди ксерокопий преступников не было нарисованного мной фоторобота."
    "Сярод ксеракопій злачынцаў не было намаляванага мной фотаробата."

# game/scripts/scene/scene_day_4.rpy:7873
translate belarusian d4_police_voluntary_ccd92193:

    # voice "voice/tihonov/4day/68 Ba.ogg"
    # Tikhonov "Ба, какие люди!"
    voice "voice/tihonov/4day/68 Ba.ogg"
    Tikhonov "Ба, якія людзі!"

# game/scripts/scene/scene_day_4.rpy:7877
translate belarusian d4_police_voluntary_501d4092:

    # voice "voice/tihonov/4day/69 Chto.ogg"
    # Tikhonov "Что, Пятифанов, сдаваться пришёл? С повинной?"
    voice "voice/tihonov/4day/69 Chto.ogg"
    Tikhonov "Што, Пяціфанаў, здавацца прыйшоў? З павіннай?"

# game/scripts/scene/scene_day_4.rpy:7882
translate belarusian d4_police_voluntary_7418241f:

    # voice "voice/romka/4day/179 o.ogg"
    # Rom "Обхохочешься..."
    voice "voice/romka/4day/179 o.ogg"
    Rom "Памрэш са смеху..."

# game/scripts/scene/scene_day_4.rpy:7886
translate belarusian d4_police_voluntary_1eba100f:

    # voice "voice/tihonov/4day/70 Da.ogg"
    # Tikhonov "Да уж, смешного мало."
    voice "voice/tihonov/4day/70 Da.ogg"
    Tikhonov "Ды ўжо, смешнага мала."

# game/scripts/scene/scene_day_4.rpy:7890
translate belarusian d4_police_voluntary_5d98b101:

    # "Милиционер перевёл тяжёлый взгляд на меня."
    "Міліцыянер перавёў цяжкі позірк на мяне."

# game/scripts/scene/scene_day_4.rpy:7892
translate belarusian d4_police_voluntary_404a0376:

    # voice "voice/tihonov/4day/13 T.ogg"
    # Tikhonov "Ты бы, Петров, друзей осторожнее выбирал, а то, считай, знакомы всего ничего, а ты уже дров наломал."
    voice "voice/tihonov/4day/13 T.ogg"
    Tikhonov "Ты б, Пятроў, сяброў асцярожней выбіраў, а то, лічы, знаёмыя ўсяго нічога, а ты ўжо дроў наламаў."

# game/scripts/scene/scene_day_4.rpy:7896
translate belarusian d4_police_voluntary_0b332af1:

    # voice "voice/tihonov/4day/14 Na.ogg"
    # Tikhonov "На учёт поставлю, как некоторых..."
    voice "voice/tihonov/4day/14 Na.ogg"
    Tikhonov "На ўлік пастаўлю, як некаторых..."

# game/scripts/scene/scene_day_4.rpy:7902
translate belarusian d4_police_voluntary_8152c35a:

    # voice "voice/romka/4day/148 O.ogg"
    # Rom "Ой, знаем мы ваши учёты: лишь бы отчётность закрыть."
    voice "voice/romka/4day/148 O.ogg"
    Rom "Ой, ведаем мы вашы ўлікі: абы справаздачнасць закрыць."

# game/scripts/scene/scene_day_4.rpy:7906
translate belarusian d4_police_voluntary_57f2d703:

    # voice "voice/romka/4day/149 A.ogg"
    # Rom "А настоящие преступники до сих пор на свободе!"
    voice "voice/romka/4day/149 A.ogg"
    Rom "А сапраўдныя злачынцы дагэтуль на волі!"

# game/scripts/scene/scene_day_4.rpy:7911
translate belarusian d4_police_voluntary_c3342bd1:

    # voice "voice/tihonov/4day/15 No.ogg"
    # Tikhonov "Но-но!"
    voice "voice/tihonov/4day/15 No.ogg"
    Tikhonov "Но-но!"

# game/scripts/scene/scene_day_4.rpy:7915
translate belarusian d4_police_voluntary_e62dc1ec:

    # voice "voice/tihonov/4day/16 Sm.ogg"
    # Tikhonov "Смотри! Не образумишься — как папаша твой, по малолетке загремишь." id d4_police_voluntary_e62dc1ec
    voice "voice/tihonov/4day/16 Sm.ogg"
    Tikhonov "Глядзі! Не адумаешся — як папаша твой, па малалетцы загрыміш."

# game/scripts/scene/scene_day_4.rpy:7920
translate belarusian d4_police_voluntary_890c8f6f:

    # voice "voice/romka/4day/150 A.ogg"
    # Rom "Я вас ещё удивлю!"
    voice "voice/romka/4day/150 A.ogg"
    Rom "Я вас яшчэ здзіўлю!"

# game/scripts/scene/scene_day_4.rpy:7924
translate belarusian d4_police_voluntary_f1d59b1e:

    # "Я понял, что пора вмешаться в разговор, пока Тихонов не потерял терпение."
    "Я зразумеў, што пара ўмяшацца ў размову, пакуль Ціханаў не страціў цярпення."

# game/scripts/scene/scene_day_4.rpy:7927
translate belarusian d4_police_voluntary_8338cee2:

    # voice "voice/anton/4day/05 Ko.ogg"
    # Ant "Константин Владимирович, вы должны поехать с нами!"
    voice "voice/anton/4day/05 Ko.ogg"
    Ant "Канстанцін Уладзіміравіч, вы павінны паехаць з намі!"

# game/scripts/scene/scene_day_4.rpy:7931
translate belarusian d4_police_voluntary_dc1014aa:

    # voice "voice/anton/4day/06 M.ogg"
    # Ant "Мы гараж нашли."
    voice "voice/anton/4day/06 M.ogg"
    Ant "Мы гараж знайшлі."

# game/scripts/scene/scene_day_4.rpy:7933
translate belarusian d4_police_voluntary_795405c1:

    # "Я заранее догадался, какой будет ответная реакция."
    "Я загадзя здагадаўся, якой будзе рэакцыя ў адказ."

# game/scripts/scene/scene_day_4.rpy:7935
translate belarusian d4_police_voluntary_469be5c6:

    # voice "voice/tihonov/4day/75 Von.ogg"
    # Tikhonov "Вон как! Гараж, значит."
    voice "voice/tihonov/4day/75 Von.ogg"
    Tikhonov "Вунь як! Гараж, значыць."

# game/scripts/scene/scene_day_4.rpy:7940
translate belarusian d4_police_voluntary_da5019ed:

    # voice "voice/tihonov/4day/76 Da.ogg"
    # Tikhonov "Дай угадаю: а в нём сокровища {u}Стеньки Разина{/u} спрятаны?"
    voice "voice/tihonov/4day/76 Da.ogg"
    Tikhonov "Дай адгадаю: а ў ім скарбы {u}Сценькі Разіна{/u} схаваны?"

# game/scripts/scene/scene_day_4.rpy:7943
translate belarusian d4_police_voluntary_0819c416:

    # voice "voice/anton/4day/78. Net.ogg"
    # Ant "Нет, но..."
    voice "voice/anton/4day/78. Net.ogg"
    Ant "Не, але..."

# game/scripts/scene/scene_day_4.rpy:7946
translate belarusian d4_police_voluntary_06133775:

    # voice "voice/tihonov/4day/22 Pe.ogg"
    # Tikhonov "Петров-Петров... Признавайся, ведь не сам ты это придумал?"
    voice "voice/tihonov/4day/22 Pe.ogg"
    Tikhonov "Пятроў-Пятроў... Прызнавайся, не сам жа ты гэта прыдумаў?"

# game/scripts/scene/scene_day_4.rpy:7950
translate belarusian d4_police_voluntary_71373068:

    # voice "voice/tihonov/4day/23 P.ogg"
    # Tikhonov "Пятифанов подговорил, да? Всё хиханьки да хаханьки."
    voice "voice/tihonov/4day/23 P.ogg"
    Tikhonov "Пяціфанаў падгаварыў, так? Усё хіханькі ды хаханькі."

# game/scripts/scene/scene_day_4.rpy:7956
translate belarusian d4_police_voluntary_44d93692:

    # "Ромка закатил глаза."
    "Ромка закаціў вочы."

# game/scripts/scene/scene_day_4.rpy:7958
translate belarusian d4_police_voluntary_166ae299:

    # voice "voice/romka/4day/180 Ya.ogg"
    # Rom "Я предупреждал..."
    voice "voice/romka/4day/180 Ya.ogg"
    Rom "Я папярэджваў..."

# game/scripts/scene/scene_day_4.rpy:7962
translate belarusian d4_police_voluntary_ad06657e:

    # voice "voice/anton/4day/79. Nek.ogg"
    # Ant "Никто меня не подговаривал!"
    voice "voice/anton/4day/79. Nek.ogg"
    Ant "Ніхто мяне не падгаворваў!"

# game/scripts/scene/scene_day_4.rpy:7965
translate belarusian d4_police_voluntary_6638c248:

    # voice "voice/anton/4day/Yasam.ogg"
    # Ant "Я сам видел! Как вас вижу! В лесу, среди пней..."
    voice "voice/anton/4day/Yasam.ogg"
    Ant "Я сам бачыў! Як вас бачу! У лесе, сярод пнёў..."

# game/scripts/scene/scene_day_4.rpy:7969
translate belarusian d4_police_voluntary_3307c4b0:

    # voice "voice/tihonov/4day/79 Vr.ogg"
    # Tikhonov "Времянка это была, Антон."
    voice "voice/tihonov/4day/79 Vr.ogg"
    Tikhonov "Часоўка гэта была, Антон."

# game/scripts/scene/scene_day_4.rpy:7972
translate belarusian d4_police_voluntary_217a9c5a:

    # voice "voice/anton/4day/07 Ne.ogg"
    # Ant "Нет! Гараж!"
    voice "voice/anton/4day/07 Ne.ogg"
    Ant "Не! Гараж!"

# game/scripts/scene/scene_day_4.rpy:7974
translate belarusian d4_police_voluntary_197e28e1:

    # "Старлей примирительно поднял руки."
    "Старлей прымірэнча падняў рукі."

# game/scripts/scene/scene_day_4.rpy:7976
translate belarusian d4_police_voluntary_8d2bd42c:

    # voice "voice/tihonov/4day/80 Ti.ogg"
    # Tikhonov "Ты хоть знаешь, что такое времянка?"
    voice "voice/tihonov/4day/80 Ti.ogg"
    Tikhonov "Ты хоць ведаеш, што такое часоўка?"

# game/scripts/scene/scene_day_4.rpy:7980
translate belarusian d4_police_voluntary_ed74a94a:

    # voice "voice/anton/4day/08 Nu.ogg"
    # Ant "Ну... Это..."
    voice "voice/anton/4day/08 Nu.ogg"
    Ant "Ну... Гэта..."

# game/scripts/scene/scene_day_4.rpy:7984
translate belarusian d4_police_voluntary_7536e705:

    # voice "voice/tihonov/4day/81 Ne.ogg"
    # Tikhonov "Не знаешь! Как же ты их тогда отличишь?"
    voice "voice/tihonov/4day/81 Ne.ogg"
    Tikhonov "Не ведаеш! Як жа ты іх тады адрозніш?"

# game/scripts/scene/scene_day_4.rpy:7988
translate belarusian d4_police_voluntary_1af7a2b6:

    # voice "voice/tihonov/4day/82 Oh.ogg"
    # Tikhonov "Охотники хибару сколотили для припасов."
    voice "voice/tihonov/4day/82 Oh.ogg"
    Tikhonov "Паляўнічыя халупу збілі для прыпасаў."

# game/scripts/scene/scene_day_4.rpy:7992
translate belarusian d4_police_voluntary_279e8f08:

    # voice "voice/tihonov/4day/83 Mi.ogg"
    # Tikhonov "Мы этих построек штук десять проверили, пока лес обыскивали."
    voice "voice/tihonov/4day/83 Mi.ogg"
    Tikhonov "Мы гэтых пабудоў штук дзесяць праверылі, пакуль лес абшуквалі."

# game/scripts/scene/scene_day_4.rpy:7996
translate belarusian d4_police_voluntary_d882bfe1:

    # voice "voice/tihonov/4day/84 E.ogg"
    # Tikhonov "И вашу, наверное, тоже шмонали... Проверяли то есть."
    voice "voice/tihonov/4day/84 E.ogg"
    Tikhonov "І вашу, напэўна, таксама шманалі... Правяралі, то бок."

# game/scripts/scene/scene_day_4.rpy:8000
translate belarusian d4_police_voluntary_46dd44c0:

    # voice "voice/anton/4day/09 Hi.ogg"
    # Ant "Хибары не едят детей! А Чёрный Гараж ест!"
    voice "voice/anton/4day/09 Hi.ogg"
    Ant "Халупы не ядуць дзяцей! А Чорны гараж есць!"

# game/scripts/scene/scene_day_4.rpy:8006
translate belarusian d4_police_voluntary_4940a9e5:

    # voice "voice/tihonov/4day/85 Ch.ogg"
    # Tikhonov "Чёрный?"
    voice "voice/tihonov/4day/85 Ch.ogg"
    Tikhonov "Чорны?"

# game/scripts/scene/scene_day_4.rpy:8015
translate belarusian d4_police_voluntary_de1ce25d:

    # "Он крепко задумался, барабаня пальцами по столешнице с кипой бумаг."
    "Ён моцна задумаўся, барабанячы пальцамі па стальніцы са стосам папер."

# game/scripts/scene/scene_day_4.rpy:8016
translate belarusian d4_police_voluntary_a127d8a1:

    # "У меня появилась слабая надежда, что лейтенант прислушается к моим словам."
    "У мяне з'явілася слабая надзея, што лейтэнант прыслухаецца да маіх слоў."

# game/scripts/scene/scene_day_4.rpy:8020
translate belarusian d4_police_voluntary_5ded9150:

    # voice "voice/tihonov/4day/86 Na.ogg"
    # Tikhonov "На чёрной-чёрной улице... В чёрной-чёрной подворотне..."
    voice "voice/tihonov/4day/86 Na.ogg"
    Tikhonov "На чорнай-чорнай вуліцы... У чорнай-чорнай падваротні..."

# game/scripts/scene/scene_day_4.rpy:8025
translate belarusian d4_police_voluntary_5056c312:

    # voice "voice/tihonov/4day/87 Che.ogg"
    # Tikhonov "Чёрный-пречёрный гараж..."
    voice "voice/tihonov/4day/87 Che.ogg"
    Tikhonov "Чорны-прачорны гараж..."

# game/scripts/scene/scene_day_4.rpy:8038
translate belarusian d4_police_voluntary_785916d9:

    # voice "voice/tihonov/4day/88 Hv.ogg"
    # Tikhonov "Хвать тебя за шкирку!"
    voice "voice/tihonov/4day/88 Hv.ogg"
    Tikhonov "Хап цябе за шкірку!"

# game/scripts/scene/scene_day_4.rpy:8044
translate belarusian d4_police_voluntary_8bd5b102:

    # voice "voice/romka/4day/181P.ogg"
    # Rom "Приехали..."
    voice "voice/romka/4day/181P.ogg"
    Rom "Прыехалі..."

# game/scripts/scene/scene_day_4.rpy:8054
translate belarusian d4_police_voluntary_77d29e80:

    # voice "voice/tihonov/4day/89 He.ogg"
    # Tikhonov "Хе-хе, видите? Не забыл я ещё детскую страшилку."
    voice "voice/tihonov/4day/89 He.ogg"
    Tikhonov "Хе-хе, бачыце? Не забыў я яшчэ дзіцячую страшылку."

# game/scripts/scene/scene_day_4.rpy:8059
translate belarusian d4_police_voluntary_bcb74a7e:

    # voice "voice/tihonov/4day/90 Po.ogg"
    # Tikhonov "Помню, малым так сестрёнку напугал, гаражом этим. Три дня уснуть не могла, дурёха."
    voice "voice/tihonov/4day/90 Po.ogg"
    Tikhonov "Памятаю, малым так сястрычку напалохаў, гаражом гэтым. Тры дні заснуць не магла, дурнічка."

# game/scripts/scene/scene_day_4.rpy:8066
translate belarusian d4_police_voluntary_e2bf4544:

    # "Тихонов улыбнулся, блеснув крепкими зубами, а я подумал о своей Оле."
    "Ціханаў усміхнуўся, бліснуўшы моцнымі зубамі, а я падумаў пра сваю Олю."

# game/scripts/scene/scene_day_4.rpy:8069
translate belarusian d4_police_voluntary_8e0799f2:

    # voice "voice/tihonov/4day/91 Ba.ogg"
    # Tikhonov "Байка это, ребята. Ей сто лет в обед."
    voice "voice/tihonov/4day/91 Ba.ogg"
    Tikhonov "Байка гэта, хлопцы. Ёй сто гадоў у абед."

# game/scripts/scene/scene_day_4.rpy:8074
translate belarusian d4_police_voluntary_52d86f9d:

    # voice "voice/tihonov/4day/92 V.ogg"
    # Tikhonov "Вы ещё своим детям рассказывать её будете, а те – своим."
    voice "voice/tihonov/4day/92 V.ogg"
    Tikhonov "Вы яшчэ сваім дзецям расказваць яе будзеце, а тыя — сваім."

# game/scripts/scene/scene_day_4.rpy:8078
translate belarusian d4_police_voluntary_945436c5:

    # voice "voice/tihonov/4day/93 Ne.ogg"
    # Tikhonov "Некоторые истории... Особенно дурные... Они, увы, вечны."
    voice "voice/tihonov/4day/93 Ne.ogg"
    Tikhonov "Некаторыя гісторыі... Асабліва благія... Яны, на жаль, вечныя."

# game/scripts/scene/scene_day_4.rpy:8102
translate belarusian d4_police_forced_54925fea:

    # voice "voice/tihonov/4day/09 R.ogg"
    # Tikhonov "Располагайтесь."
    voice "voice/tihonov/4day/09 R.ogg"
    Tikhonov "Размяшчайцеся."

# game/scripts/scene/scene_day_4.rpy:8106
translate belarusian d4_police_forced_1be2271a:

    # voice "voice/tihonov/4day/10 Ati.ogg"
    # Tikhonov "А ты куда, Пятифанов, присел? Тебя вон, персональное место в обезьяннике дожидается."
    voice "voice/tihonov/4day/10 Ati.ogg"
    Tikhonov "А ты куды, Пяціфанаў, прысеў? Цябе вунь персанальнае месца ў абяз'янніку чакае."

# game/scripts/scene/scene_day_4.rpy:8113
translate belarusian d4_police_forced_e1264f7c:

    # voice "voice/romka/4day/147 A.ogg"
    # Rom "А чё я сделал-то?"
    voice "voice/romka/4day/147 A.ogg"
    Rom "А што ж я зрабіў?"

# game/scripts/scene/scene_day_4.rpy:8118
translate belarusian d4_police_forced_3929a55d:

    # voice "voice/tihonov/4day/11 Na.ogg"
    # Tikhonov "На офицера при исполнении с ножом напал."
    voice "voice/tihonov/4day/11 Na.ogg"
    Tikhonov "На афіцэра пры выкананні з нажом напаў."

# game/scripts/scene/scene_day_4.rpy:8122
translate belarusian d4_police_forced_54f83400:

    # voice "voice/tihonov/4day/12 Teb.ogg"
    # Tikhonov "Тебе мало?"
    voice "voice/tihonov/4day/12 Teb.ogg"
    Tikhonov "Табе мала?"

# game/scripts/scene/scene_day_4.rpy:8129
translate belarusian d4_police_forced_5d98b101:

    # "Милиционер перевёл тяжёлый взгляд на меня."
    "Міліцыянер перавёў цяжкі позірк на мяне."

# game/scripts/scene/scene_day_4.rpy:8131
translate belarusian d4_police_forced_404a0376:

    # voice "voice/tihonov/4day/13 T.ogg"
    # Tikhonov "Ты бы, Петров, друзей осторожнее выбирал, а то, считай, знакомы всего ничего, а ты уже дров наломал."
    voice "voice/tihonov/4day/13 T.ogg"
    Tikhonov "Ты б, Пятроў, сяброў асцярожней выбіраў, а то, лічы, знаёмыя ўсяго нічога, а ты ўжо дроў наламаў."

# game/scripts/scene/scene_day_4.rpy:8135
translate belarusian d4_police_forced_0b332af1:

    # voice "voice/tihonov/4day/14 Na.ogg"
    # Tikhonov "На учёт поставлю, как некоторых..."
    voice "voice/tihonov/4day/14 Na.ogg"
    Tikhonov "На ўлік пастаўлю, як некаторых..."

# game/scripts/scene/scene_day_4.rpy:8141
translate belarusian d4_police_forced_8152c35a:

    # voice "voice/romka/4day/148 O.ogg"
    # Rom "Ой, знаем мы ваши учёты: лишь бы отчётность закрыть."
    voice "voice/romka/4day/148 O.ogg"
    Rom "Ой, ведаем мы вашы ўлікі: абы справаздачнасць закрыць."

# game/scripts/scene/scene_day_4.rpy:8145
translate belarusian d4_police_forced_57f2d703:

    # voice "voice/romka/4day/149 A.ogg"
    # Rom "А настоящие преступники до сих пор на свободе!"
    voice "voice/romka/4day/149 A.ogg"
    Rom "А сапраўдныя злачынцы дагэтуль на волі!"

# game/scripts/scene/scene_day_4.rpy:8150
translate belarusian d4_police_forced_c3342bd1:

    # voice "voice/tihonov/4day/15 No.ogg"
    # Tikhonov "Но-но!"
    voice "voice/tihonov/4day/15 No.ogg"
    Tikhonov "Но-но!"

# game/scripts/scene/scene_day_4.rpy:8154
translate belarusian d4_police_forced_e62dc1ec:

    # voice "voice/tihonov/4day/16 Sm.ogg"
    # Tikhonov "Смотри! Не образумишься — как папаша твой, по малолетке загремишь." id d4_police_forced_e62dc1ec
    voice "voice/tihonov/4day/16 Sm.ogg"
    Tikhonov "Глядзі! Не адумаешся — як папаша твой, па малалетцы загрыміш."

# game/scripts/scene/scene_day_4.rpy:8159
translate belarusian d4_police_forced_890c8f6f:

    # voice "voice/romka/4day/150 A.ogg"
    # Rom "Я вас ещё удивлю!"
    voice "voice/romka/4day/150 A.ogg"
    Rom "Я вас яшчэ здзіўлю!"

# game/scripts/scene/scene_day_4.rpy:8164
translate belarusian d4_police_forced_18c80ffb:

    # voice "voice/tihonov/4day/17 Pa.ogg"
    # Tikhonov "Пасть закрой!"
    voice "voice/tihonov/4day/17 Pa.ogg"
    Tikhonov "Пашчу закрый!"

# game/scripts/scene/scene_day_4.rpy:8168
translate belarusian d4_police_forced_df0a3da6:

    # voice "voice/tihonov/4day/18 Ot.ogg"
    # Tikhonov "Отвечайте, что в лесу делали в комендантский час?"
    voice "voice/tihonov/4day/18 Ot.ogg"
    Tikhonov "Адказвайце, што ў лесе рабілі ў каменданцкую гадзіну?"

# game/scripts/scene/scene_day_4.rpy:8171
translate belarusian d4_police_forced_e7086375:

    # voice "voice/anton/4day/77. Ko.ogg"
    # Ant "Константин Владимирович, мы Катю искали..."
    voice "voice/anton/4day/77. Ko.ogg"
    Ant "Канстанцін Уладзіміравіч, мы Кацю шукалі..."

# game/scripts/scene/scene_day_4.rpy:8174
translate belarusian d4_police_forced_795405c1:

    # "Я заранее догадался, какой будет ответная реакция."
    "Я загадзя здагадаўся, якой будзе рэакцыя ў адказ."

# game/scripts/scene/scene_day_4.rpy:8176
translate belarusian d4_police_forced_393eb113:

    # voice "voice/tihonov/4day/19 Pom.ogg"
    # Tikhonov "Помощнички выискались!"
    voice "voice/tihonov/4day/19 Pom.ogg"
    Tikhonov "Памочнічкі знайшліся!"

# game/scripts/scene/scene_day_4.rpy:8180
translate belarusian d4_police_forced_8b135fef:

    # voice "voice/tihonov/4day/20 ta.ogg"
    # Tikhonov "Такими темпами вас самих искать придётся!"
    voice "voice/tihonov/4day/20 ta.ogg"
    Tikhonov "Такімі тэмпамі вас саміх шукаць давядзецца!"

# game/scripts/scene/scene_day_4.rpy:8184
translate belarusian d4_police_forced_1ac2a765:

    # voice "voice/tihonov/4day/21 V.ogg"
    # Tikhonov "В газету захотели попасть? В рубрику «Помним, любим, скорбим»?"
    voice "voice/tihonov/4day/21 V.ogg"
    Tikhonov "У газету захацелі трапіць? У рубрыку «Памятаем, любім, смуткуем»?"

# game/scripts/scene/scene_day_4.rpy:8187
translate belarusian d4_police_forced_0819c416:

    # voice "voice/anton/4day/78. Net.ogg"
    # Ant "Нет, но..."
    voice "voice/anton/4day/78. Net.ogg"
    Ant "Не, але..."

# game/scripts/scene/scene_day_4.rpy:8190
translate belarusian d4_police_forced_06133775:

    # voice "voice/tihonov/4day/22 Pe.ogg"
    # Tikhonov "Петров-Петров... Признавайся, ведь не сам ты это придумал?"
    voice "voice/tihonov/4day/22 Pe.ogg"
    Tikhonov "Пятроў-Пятроў... Прызнавайся, не сам жа ты гэта прыдумаў?"

# game/scripts/scene/scene_day_4.rpy:8194
translate belarusian d4_police_forced_71373068:

    # voice "voice/tihonov/4day/23 P.ogg"
    # Tikhonov "Пятифанов подговорил, да? Всё хиханьки да хаханьки."
    voice "voice/tihonov/4day/23 P.ogg"
    Tikhonov "Пяціфанаў падгаварыў, так? Усё хіханькі ды хаханькі."

# game/scripts/scene/scene_day_4.rpy:8200
translate belarusian d4_police_forced_44d93692:

    # "Ромка закатил глаза."
    "Ромка закаціў вочы."

# game/scripts/scene/scene_day_4.rpy:8202
translate belarusian d4_police_forced_0b3c9119:

    # voice "voice/romka/4day/151Z.ogg"
    # Rom "Завёл старую песню..."
    voice "voice/romka/4day/151Z.ogg"
    Rom "Завёў старую песню..."

# game/scripts/scene/scene_day_4.rpy:8205
translate belarusian d4_police_forced_ad06657e:

    # voice "voice/anton/4day/79. Nek.ogg"
    # Ant "Никто меня не подговаривал!"
    voice "voice/anton/4day/79. Nek.ogg"
    Ant "Ніхто мяне не падгаворваў!"

# game/scripts/scene/scene_day_4.rpy:8207
translate belarusian d4_police_forced_0653b30f:

    # voice "voice/anton/4day/80. Yasam.ogg"
    # Ant "Я сам хотел маньяка поймать."
    voice "voice/anton/4day/80. Yasam.ogg"
    Ant "Я сам хацеў маньяка злавіць."

# game/scripts/scene/scene_day_4.rpy:8212
translate belarusian d4_police_forced_ef71a20f:

    # voice "voice/tihonov/4day/24 Eto.ogg"
    # Tikhonov "Это вам повезло, что вы на меня наткнулись."
    voice "voice/tihonov/4day/24 Eto.ogg"
    Tikhonov "Гэта вам пашанцавала, што вы на мяне наткнуліся."

# game/scripts/scene/scene_day_4.rpy:8216
translate belarusian d4_police_forced_9e337fbf:

    # voice "voice/tihonov/4day/25 A.ogg"
    # Tikhonov "А я ведь предупреждал по-хорошему, чтобы ты дома сидел!"
    voice "voice/tihonov/4day/25 A.ogg"
    Tikhonov "А я ж папярэджваў па-добраму, каб ты дома сядзеў!"

# game/scripts/scene/scene_day_4.rpy:8221
translate belarusian d4_police_forced_e9f1e971:

    # voice "voice/tihonov/4day/26 Na.ogg"
    # Tikhonov "На кой лад тебе этот маньяк вообще сдался?"
    voice "voice/tihonov/4day/26 Na.ogg"
    Tikhonov "На якое ліха табе гэты маньяк наогул здаўся?"

# game/scripts/scene/scene_day_4.rpy:8224
translate belarusian d4_police_forced_921f3934:

    # "Я виновато опустил голову."
    "Я вінавата апусціў галаву."

# game/scripts/scene/scene_day_4.rpy:8225
translate belarusian d4_police_forced_e5a00238:

    # voice "voice/anton/4day/80. Nag.ogg"
    # Ant "Награду хочу."
    voice "voice/anton/4day/80. Nag.ogg"
    Ant "Узнагароду хачу."

# game/scripts/scene/scene_day_4.rpy:8233
translate belarusian d4_police_forced_07338303:

    # "Старлей скрестил руки на груди, тяжело вздохнув."
    "Старлей скрыжаваў рукі на грудзях, цяжка ўздыхнуўшы."

# game/scripts/scene/scene_day_4.rpy:8237
translate belarusian d4_police_forced_0ebfe7e2:

    # voice "voice/tihonov/4day/28 De.ogg"
    # Tikhonov "Денег, значит. И куда тебе столько денег?"
    voice "voice/tihonov/4day/28 De.ogg"
    Tikhonov "Грошай, значыць. І куды табе столькі грошай?"

# game/scripts/scene/scene_day_4.rpy:8240
translate belarusian d4_police_forced_67c1cd43:

    # voice "voice/anton/4day/81. U.ogg"
    # Ant "У родителей долги..."
    voice "voice/anton/4day/81. U.ogg"
    Ant "У бацькоў даўгі..."

# game/scripts/scene/scene_day_4.rpy:8243
translate belarusian d4_police_forced_0e9c22d8:

    # voice "voice/tihonov/4day/29 Da.ogg"
    # Tikhonov "Да вся страна у нас в долгах как в шелках! И дальше что?"
    voice "voice/tihonov/4day/29 Da.ogg"
    Tikhonov "Ды ўся краіна ў нас у даўгах як у шаўках! І далей што?"

# game/scripts/scene/scene_day_4.rpy:8247
translate belarusian d4_police_forced_31c1e23f:

    # voice "voice/tihonov/4day/30 Du.ogg"
    # Tikhonov "Думаешь, твоя пропажа им поможет?"
    voice "voice/tihonov/4day/30 Du.ogg"
    Tikhonov "Думаеш, тваё знікненне ім дапаможа?"

# game/scripts/scene/scene_day_4.rpy:8251
translate belarusian d4_police_forced_abe8bdc3:

    # "Я хныкнул от обиды."
    "Я хныкнуў ад крыўды."

# game/scripts/scene/scene_day_4.rpy:8252
translate belarusian d4_police_forced_6ac6d3b0:

    # voice "voice/anton/4day/01 Da.ogg"
    # Ant "Да им уже ничего не поможет! Они дня без скандала прожить не могут!"
    voice "voice/anton/4day/01 Da.ogg"
    Ant "Ды ім ужо нічога не дапаможа! Яны дня без скандалу пражыць не могуць!"

# game/scripts/scene/scene_day_4.rpy:8254
translate belarusian d4_police_forced_af70f278:

    # voice "voice/anton/4day/02 Pro.ogg"
    # Ant "Просто хочу, чтобы мы с Олей были счастливы."
    voice "voice/anton/4day/02 Pro.ogg"
    Ant "Проста хачу, каб мы з Оляй былі шчаслівыя."

# game/scripts/scene/scene_day_4.rpy:8257
translate belarusian d4_police_forced_ef41af14:

    # "Тихонов призадумался, барабаня пальцами по столешнице с кипой бумаг."
    "Ціханаў прызадумаўся, барабанячы пальцамі па стальніцы са стосам папер."

# game/scripts/scene/scene_day_4.rpy:8259
translate belarusian d4_police_forced_d9b122ef:

    # voice "voice/tihonov/4day/31 Ne.ogg"
    # Tikhonov "Не плачь, пацан. Всё образуется."
    voice "voice/tihonov/4day/31 Ne.ogg"
    Tikhonov "Не плач, пацан. Усё наладзіцца."

# game/scripts/scene/scene_day_4.rpy:8263
translate belarusian d4_police_forced_e2ac7cb2:

    # voice "voice/tihonov/4day/32 E.ogg"
    # Tikhonov "И родители помирится, и маньяка найдём..."
    voice "voice/tihonov/4day/32 E.ogg"
    Tikhonov "І бацькі памірацца, і маньяка знойдзем..."

# game/scripts/scene/scene_day_4.rpy:8268
translate belarusian d4_police_forced_7ecefe32:

    # voice "voice/romka/4day/152 A.ogg"
    # Rom "Ага, и страну поднимем."
    voice "voice/romka/4day/152 A.ogg"
    Rom "Ага, і краіну падымем."

# game/scripts/scene/scene_day_4.rpy:8275
translate belarusian d4_police_forced_1c74d7a7:

    # voice "voice/tihonov/4day/33 P.ogg"
    # Tikhonov "Пятифанов, договоришься у меня!"
    voice "voice/tihonov/4day/33 P.ogg"
    Tikhonov "Пяціфанаў, дагаворышся ў мяне!"

# game/scripts/scene/scene_day_4.rpy:8279
translate belarusian d4_police_forced_4c4b0bac:

    # "Тихонов оскалился, блеснув крепкими зубами, а я подумал, что всё равно не отступлю. Ради своей Оли."
    "Ціханаў выскаліўся, бліснуўшы моцнымі зубамі, а я падумаў, што ўсё роўна не адступлю. Дзеля сваёй Олі."

# game/scripts/scene/scene_day_4.rpy:8281
translate belarusian d4_police_forced_e2bf1d34:

    # voice "voice/tihonov/4day/34 A.ogg"
    # Tikhonov "Ай, чёрт с вами!"
    voice "voice/tihonov/4day/34 A.ogg"
    Tikhonov "Ай, чорт з вамі!"

# game/scripts/scene/scene_day_4.rpy:8285
translate belarusian d4_police_forced_e14ad4bc:

    # voice "voice/tihonov/4day/35 W.ogg"
    # Tikhonov "В этот раз устное предупреждение вам."
    voice "voice/tihonov/4day/35 W.ogg"
    Tikhonov "Гэтым разам вуснае папярэджанне вам."

# game/scripts/scene/scene_day_4.rpy:8289
translate belarusian d4_police_forced_8bd7c624:

    # voice "voice/tihonov/4day/36 No.ogg"
    # Tikhonov "Но в следующий раз — пеняйте на себя."
    voice "voice/tihonov/4day/36 No.ogg"
    Tikhonov "Але наступным разам — наракайце на сябе."

# game/scripts/scene/scene_day_4.rpy:8294
translate belarusian d4_police_forced_69a35833:

    # "Он погрозил пальцем."
    "Ён пагразіў пальцам."

# game/scripts/scene/scene_day_4.rpy:8298
translate belarusian d4_police_forced_549fac86:

    # voice "voice/tihonov/4day/37U .ogg"
    # Tikhonov "Увижу ещё раз, что в потёмках шароёбитесь, – уши откручу!"
    voice "voice/tihonov/4day/37U .ogg"
    Tikhonov "Убачу яшчэ раз, што ў цемры шараёбіцеся, — вушы адкручу!"

# game/scripts/scene/scene_day_4.rpy:8307
translate belarusian d4_police_common_a5cf9b6e:

    # "В последний раз всхлипнула и замолчала Буланова. Наступила гробовая тишина."
    "У апошні раз усхліпнула і замоўкла Буланава. Наступіла магільная цішыня."

# game/scripts/scene/scene_day_4.rpy:8309
translate belarusian d4_police_common_d3bb54f7:

    # "Будто на автопилоте, я побрёл к стенду, оставляя за собой мокрые следы."
    "Нібы на аўтапілоце, я пабрыў да стэнда, пакідаючы за сабой мокрыя сляды."

# game/scripts/scene/scene_day_4.rpy:8316
translate belarusian d4_police_common_b283b919:

    # "Я теперь стоял в упор, разглядывая фотографии Сенечки, Вовы, Семёна и Кати, а они в ответ таращились на меня."
    "Цяпер я стаяў упрытык, разглядаючы фатаграфіі Сенечкі, Вовы, Сямёна і Каці, а яны ў адказ тарашчыліся на мяне."

# game/scripts/scene/scene_day_4.rpy:8325
translate belarusian d4_police_common_1f22e458:

    # "Когда рука Тихонова легла мне на плечо, я невольно вздрогнул."
    "Калі рука Ціханава лягла мне на плячо, я міжволі ўздрыгнуў."

# game/scripts/scene/scene_day_4.rpy:8331
translate belarusian d4_police_common_375d5998:

    # voice "voice/tihonov/4day/38 Eh.ogg"
    # Tikhonov "Эх, Антон. Знал бы ты, как часто я на них смотрю."
    voice "voice/tihonov/4day/38 Eh.ogg"
    Tikhonov "Эх, Антон. Ведаў бы ты, як часта я на іх гляджу."

# game/scripts/scene/scene_day_4.rpy:8341
translate belarusian d4_police_common_2e594aa6:

    # voice "voice/romka/4day/153 L.ogg"
    # Rom "Лучше бы преступника ловили, а не на фотки пялились."
    voice "voice/romka/4day/153 L.ogg"
    Rom "Лепш бы злачынцу лавілі, а не на фоткі пяліліся."

# game/scripts/scene/scene_day_4.rpy:8343
translate belarusian d4_police_common_9f5c5118:

    # "Я думал, Тихонов обозлится, но он проглотил колкость наглеца."
    "Я думаў, Ціханаў раззлуецца, але ён праглынуў з'едлівую заўвагу нахабніка."

# game/scripts/scene/scene_day_4.rpy:8349
translate belarusian d4_police_common_9146a48a:

    # voice "voice/tihonov/4day/39 Po.ogg"
    # Tikhonov "По-вашему, я не хочу на этого козла браслеты надеть?"
    voice "voice/tihonov/4day/39 Po.ogg"
    Tikhonov "Па-вашаму, я не хачу на гэтага казла бранзалеты надзець?"

# game/scripts/scene/scene_day_4.rpy:8351
translate belarusian d4_police_common_dd002174:

    # voice "voice/tihonov/4day/40 Vz.ogg"
    # Tikhonov "Взять под белы рученьки да к стенке поставить?"
    voice "voice/tihonov/4day/40 Vz.ogg"
    Tikhonov "Узяць пад белыя ручанькі ды да сценкі паставіць?"

# game/scripts/scene/scene_day_4.rpy:8353
translate belarusian d4_police_common_f82113f4:

    # voice "voice/tihonov/4day/41 Da.ogg"
    # Tikhonov "Да я с этой мыслью и спать ложусь, и просыпаюсь!"
    voice "voice/tihonov/4day/41 Da.ogg"
    Tikhonov "Ды я з гэтай думкай і спаць кладуся, і прачынаюся!"

# game/scripts/scene/scene_day_4.rpy:8355
translate belarusian d4_police_common_820cdd1e:

    # voice "voice/tihonov/4day/42 Zn.ogg"
    # Tikhonov "Знаете, что мне снится ночами? Вам лучше и не знать."
    voice "voice/tihonov/4day/42 Zn.ogg"
    Tikhonov "Ведаеце, што мне сніцца начамі? Вам лепш і не ведаць."

# game/scripts/scene/scene_day_4.rpy:8383
translate belarusian d4_police_common_2caea3d6:

    # "Словно сгорбившись под весом тяжёлых мыслей, он медленно пошёл к столу и вздохнул."
    "Нібы згорбіўшыся пад вагой цяжкіх думак, ён павольна пайшоў да стала і ўздыхнуў."

# game/scripts/scene/scene_day_4.rpy:8384
translate belarusian d4_police_common_7aa742b4:

    # "Мы слушали молча."
    "Мы слухалі моўчкі."

# game/scripts/scene/scene_day_4.rpy:8391
translate belarusian d4_police_common_8f513653:

    # voice "voice/tihonov/4day/43 De.ogg"
    # Tikhonov "Дело это – глухарь!"
    voice "voice/tihonov/4day/43 De.ogg"
    Tikhonov "Справа гэта — глухар!"

# game/scripts/scene/scene_day_4.rpy:8403
translate belarusian d4_police_common_c371a61c:

    # voice "voice/tihonov/4day/44 Na.ogg"
    # Tikhonov "Нашли мы детские следы, ведущие в лес метров на пятьдесят. Да только там они и обрываются."
    voice "voice/tihonov/4day/44 Na.ogg"
    Tikhonov "Знайшлі мы дзіцячыя сляды, што вядуць у лес метраў на пяцьдзясят. Ды толькі там яны і абрываюцца."

# game/scripts/scene/scene_day_4.rpy:8410
translate belarusian d4_police_common_9048ca91:

    # voice "voice/tihonov/4day/45 A.ogg"
    # Tikhonov "А дальше сплошная чертовщина..."
    voice "voice/tihonov/4day/45 A.ogg"
    Tikhonov "А далей суцэльная чартаўшчына..."

# game/scripts/scene/scene_day_4.rpy:8415
translate belarusian d4_police_common_182ac67d:

    # voice "voice/tihonov/4day/46 Pr.ogg"
    # Tikhonov "Привлекли кинологов. Но собаки след не берут — скулят только жалобно."
    voice "voice/tihonov/4day/46 Pr.ogg"
    Tikhonov "Прыцягнулі кінолагаў. Але сабакі след не бяруць — скуголяць толькі жаласна."

# game/scripts/scene/scene_day_4.rpy:8421
translate belarusian d4_police_common_c3f3c8b0:

    # voice "voice/tihonov/4day/47 S.ogg"
    # Tikhonov "С добровольцами весь лес прочесали — ни единой зацепки."
    voice "voice/tihonov/4day/47 S.ogg"
    Tikhonov "З добраахвотнікамі ўвесь лес прачасалі — ніводнай зачэпкі."

# game/scripts/scene/scene_day_4.rpy:8423
translate belarusian d4_police_common_9c35e3eb:

    # voice "voice/tihonov/4day/48 D.ogg"
    # Tikhonov "Двадцать пять квадратных километров истоптали... Маньяк этот в норах звериных прячется, что ли?"
    voice "voice/tihonov/4day/48 D.ogg"
    Tikhonov "Дваццаць пяць квадратных кіламетраў вытапталі... Маньяк гэты ў норах звярыных хаваецца, ці што?"

# game/scripts/scene/scene_day_4.rpy:8429
translate belarusian d4_police_common_1fc48dcf:

    # voice "voice/tihonov/4day/49 A.ogg"
    voice "voice/tihonov/4day/49 A.ogg"

# game/scripts/scene/scene_day_4.rpy:8433
translate belarusian d4_police_common_ac354877:

    # Tikhonov "А на днях кто-то из местных заявил, что слышит детский смех по ночам."
    Tikhonov "А днямі нехта з мясцовых заявіў, што чуе дзіцячы смех па начах."

# game/scripts/scene/scene_day_4.rpy:8434
translate belarusian d4_police_common_a889a6d2:

    # voice "voice/tihonov/4day/50 M.ogg"
    # Tikhonov "Мол, это пропавшие дети к нему с того света являются и в окошко заглядывают."
    voice "voice/tihonov/4day/50 M.ogg"
    Tikhonov "Маўляў, гэта зніклыя дзеці да яго з таго свету з'яўляюцца і ў акенца заглядваюць."

# game/scripts/scene/scene_day_4.rpy:8436
translate belarusian d4_police_common_4eb59dd3:

    # voice "voice/tihonov/4day/51 S.ogg"
    # Tikhonov "С ума все посходили, ну что тут взять!"
    voice "voice/tihonov/4day/51 S.ogg"
    Tikhonov "З глузду ўсе паз'язджалі, ну што тут узяць!"

# game/scripts/scene/scene_day_4.rpy:8455
translate belarusian d4_police_common_5c8be5e3:

    # voice "voice/tihonov/4day/52 Es.ogg"
    # Tikhonov "Ещё и улики таинственным образом пропадать стали."
    voice "voice/tihonov/4day/52 Es.ogg"
    Tikhonov "Яшчэ і доказы таямнічым чынам прападаць пачалі."

# game/scripts/scene/scene_day_4.rpy:8459
translate belarusian d4_police_common_ac4e5268:

    # "Лейтенант помассировал переносицу."
    "Лейтэнант памасіраваў пераноссе."

# game/scripts/scene/scene_day_4.rpy:8461
translate belarusian d4_police_common_13eb84bf:

    # voice "voice/tihonov/4day/53 A.ogg"
    # Tikhonov "А ведь такое в нашем посёлке не впервой..."
    voice "voice/tihonov/4day/53 A.ogg"
    Tikhonov "А такое ж у нашым пасёлку не ўпершыню..."

# game/scripts/scene/scene_day_4.rpy:8465
translate belarusian d4_police_common_2ba69f66:

    # voice "voice/tihonov/4day/54 Po.ogg"
    # Tikhonov "Помню, лет тридцать назад был похожий случай: так же исчезали ребятишки."
    voice "voice/tihonov/4day/54 Po.ogg"
    Tikhonov "Памятаю, гадоў трыццаць таму быў падобны выпадак: гэтак жа знікалі дзеткі."

# game/scripts/scene/scene_day_4.rpy:8469
translate belarusian d4_police_common_90ba472b:

    # voice "voice/tihonov/4day/55 Ho.ogg"
    # Tikhonov "Хоть на похитителя и не вышли, но всё же тогда следствие лучше сработало: двоих детей удалось спасти."
    voice "voice/tihonov/4day/55 Ho.ogg"
    Tikhonov "Хоць на выкрадальніка і не выйшлі, але ўсё ж тады следства лепш спрацавала: дваіх дзяцей удалося выратаваць."

# game/scripts/scene/scene_day_4.rpy:8473
translate belarusian d4_police_common_035d96be:

    # voice "voice/tihonov/4day/56 V.ogg"
    # Tikhonov "Вот, сохранил на память с той поры."
    voice "voice/tihonov/4day/56 V.ogg"
    Tikhonov "Вось, захаваў на памяць з той пары."

# game/scripts/scene/scene_day_4.rpy:8479
translate belarusian d4_police_common_38166c2d:

    # "Милиционер бережно протянул мне пожелтевшее от времени объявление."
    "Міліцыянер беражліва працягнуў мне пажоўклую ад часу аб'яву."

# game/scripts/scene/scene_day_4.rpy:8498
translate belarusian d4_police_common_76792f09:

    # voice "voice/romka/4day/154 V.ogg"
    # Rom "В смысле?"
    voice "voice/romka/4day/154 V.ogg"
    Rom "У сэнсе?"

# game/scripts/scene/scene_day_4.rpy:8500
translate belarusian d4_police_common_fcf1e790:

    # voice "voice/anton/4day/03 Ta.ogg"
    # Ant "Так это были вы?"
    voice "voice/anton/4day/03 Ta.ogg"
    Ant "Дык гэта былі вы?"

# game/scripts/scene/scene_day_4.rpy:8513
translate belarusian d4_police_common_54a1adff:

    # voice "voice/tihonov/4day/57 T.ogg"
    # Tikhonov "Так точно."
    voice "voice/tihonov/4day/57 T.ogg"
    Tikhonov "Так дакладна."

# game/scripts/scene/scene_day_4.rpy:8515
translate belarusian d4_police_common_b6781ac8:

    # voice "voice/tihonov/4day/58 ya.ogg"
    # Tikhonov "Я ведь в этот участок в первый раз в вашем возрасте попал."
    voice "voice/tihonov/4day/58 ya.ogg"
    Tikhonov "Я ж у гэты пастарунак у першы раз у вашым узросце трапіў."

# game/scripts/scene/scene_day_4.rpy:8517
translate belarusian d4_police_common_5c233b09:

    # voice "voice/tihonov/4day/59 P.ogg"
    # Tikhonov "Помню, зима была, метель..."
    voice "voice/tihonov/4day/59 P.ogg"
    Tikhonov "Памятаю, зіма была, завея..."

# game/scripts/scene/scene_day_4.rpy:8519
translate belarusian d4_police_common_94f17027:

    # voice "voice/tihonov/4day/61 No.ogg"
    # Tikhonov "Но – вот дела – что со мной было, хоть убейте, не помню."
    voice "voice/tihonov/4day/61 No.ogg"
    Tikhonov "Але — вось дык справы — што са мной было, хоць забіце, не памятаю."

# game/scripts/scene/scene_day_4.rpy:8521
translate belarusian d4_police_common_b588a649:

    # voice "voice/tihonov/4day/61 Na.ogg"
    # Tikhonov "Нашёл меня в тайге тогдашний участковый."
    voice "voice/tihonov/4day/61 Na.ogg"
    Tikhonov "Знайшоў мяне ў тайзе тагачасны ўчастковы."

# game/scripts/scene/scene_day_4.rpy:8523
translate belarusian d4_police_common_2294191b:

    # voice "voice/tihonov/4day/62 Go.ogg"
    # Tikhonov "Говорит, лежал я в отключке, весь в сосновых иголках..."
    voice "voice/tihonov/4day/62 Go.ogg"
    Tikhonov "Кажа, ляжаў я ў адключцы, увесь у сасновых іголках..."

# game/scripts/scene/scene_day_4.rpy:8531
translate belarusian d4_police_common_c0849e50:

    # "Тихонов качнул головой, пребывая в тумане обрывочных воспоминаний."
    "Ціханаў хітнуў галавой, знаходзячыся ў тумане ўрыўкавых успамінаў."

# game/scripts/scene/scene_day_4.rpy:8538
translate belarusian d4_police_common_bd981646:

    # voice "voice/tihonov/4day/63 Eto.ogg"
    # Tikhonov "Это благодаря ему я это гиблое дело не бросаю."
    voice "voice/tihonov/4day/63 Eto.ogg"
    Tikhonov "Гэта дзякуючы яму я гэтую гіблую справу не кідаю."

# game/scripts/scene/scene_day_4.rpy:8540
translate belarusian d4_police_common_a90033ad:

    # voice "voice/tihonov/4day/64 Do.ogg"
    # Tikhonov "Долг мой — до правды докопаться."
    voice "voice/tihonov/4day/64 Do.ogg"
    Tikhonov "Абавязак мой — да праўды дакапацца."

# game/scripts/scene/scene_day_4.rpy:8542
translate belarusian d4_police_common_d026205a:

    # voice "voice/anton/4day/04 Viska.ogg"
    # Ant "Вы сказали, что двоих спасли. А второй кто?"
    voice "voice/anton/4day/04 Viska.ogg"
    Ant "Вы сказалі, што дваіх выратавалі. А другі хто?"

# game/scripts/scene/scene_day_4.rpy:8544
translate belarusian d4_police_common_fdbf4fb1:

    # voice "voice/tihonov/4day/65 da.ogg"
    # Tikhonov "Да в жизни не догадаешься! Второй, точнее, вторая..."
    voice "voice/tihonov/4day/65 da.ogg"
    Tikhonov "Ды ў жыцці не здагадаешся! Другі, дакладней, другая..."

# game/scripts/scene/scene_day_4.rpy:8552
translate belarusian d4_police_common_b71a0d28:

    # "Тихонов не успел договорить."
    "Ціханаў не паспеў дагаварыць."

# game/scripts/scene/scene_day_4.rpy:8598
translate belarusian d4_police_common_a1ed1153:

    # "Распахнулась дверь, и вместе с ветром в участок ввалилась запыхавшаяся Лилия Павловна."
    "Насцеж расчыніліся дзверы, і разам з ветрам у пастарунак увалілася задыханая Лілія Паўлаўна."

# game/scripts/scene/scene_day_4.rpy:8600
translate belarusian d4_police_common_c404f2ca:

    # "Я подобрался от неожиданности, встал по стойке смирно, однако учительница вовсе нас не замечала."
    "Я падабраўся ад нечаканасці, стаў па стойцы смірна, аднак настаўніца зусім нас не заўважала."

# game/scripts/scene/scene_day_4.rpy:8601
translate belarusian d4_police_common_a850f3f1:

    # voice "voice/lydia/4day/22 Net.ogg"
    # Lilia_P "Нет её! Не пришла!"
    voice "voice/lydia/4day/22 Net.ogg"
    Lilia_P "Няма яе! Не прыйшла!"

# game/scripts/scene/scene_day_4.rpy:8606
translate belarusian d4_police_common_d8a70ae3:

    # voice "voice/lydia/4day/23 Vi.ogg"
    # Lilia_P "Вы сказали, придёт, сказали, она у подружек, а её нет!"
    voice "voice/lydia/4day/23 Vi.ogg"
    Lilia_P "Вы сказалі, прыйдзе, сказалі, яна ў сябровак, а яе няма!"

# game/scripts/scene/scene_day_4.rpy:8608
translate belarusian d4_police_common_c5bdd01e:

    # voice "voice/lydia/4day/24 Net.ogg"
    # Lilia_P "Нет моей Катеньки..."
    voice "voice/lydia/4day/24 Net.ogg"
    Lilia_P "Няма маёй Каценькі..."

# game/scripts/scene/scene_day_4.rpy:8623
translate belarusian d4_police_common_c6c5a0d1:

    # "Лилия Павловна заплакала навзрыд, прикрыв лицо руками. Мы с Ромкой быстро переглянулись."
    "Лілія Паўлаўна заплакала наўзрыд, прыкрыўшы твар рукамі. Мы з Ромкам хутка пераглянуліся."

# game/scripts/scene/scene_day_4.rpy:8627
translate belarusian d4_police_common_4d58211b:

    # voice "voice/tihonov/4day/66 Us.ogg"
    # Tikhonov "Успокойтесь! Тише!"
    voice "voice/tihonov/4day/66 Us.ogg"
    Tikhonov "Супакойцеся! Цішэй!"

# game/scripts/scene/scene_day_4.rpy:8633
translate belarusian d4_police_common_f9adbb8d:

    # voice "voice/lydia/4day/26 Da.ogg"
    # Lilia_P "Да как же мне успокоиться?! Кровиночка моя..."
    voice "voice/lydia/4day/26 Da.ogg"
    Lilia_P "Ды як жа мне супакоіцца?! Крывіначка мая..."

# game/scripts/scene/scene_day_4.rpy:8647
translate belarusian d4_police_common_1eae7781:

    # "Лейтенант обнял Лилию Павловну за плечи и коротко мотнул головой в нашу сторону:"
    "Лейтэнант абняў Лілію Паўлаўну за плечы і коратка матнуў галавой у наш бок:"

# game/scripts/scene/scene_day_4.rpy:8651
translate belarusian d4_police_common_d7dc1155:

    # voice "voice/tihonov/4day/67 Br.ogg"
    # Tikhonov "Брысь!"
    voice "voice/tihonov/4day/67 Br.ogg"
    Tikhonov "Брысь!"

# game/scripts/scene/scene_day_4.rpy:8670
translate belarusian d4_police_common_6fc5d692:

    # "Пятясь, мы выбрались на порог под немилосердные удары ветра."
    "Задкуючы, мы выбраліся на парог пад нялітасцівыя ўдары ветру."

# game/scripts/scene/scene_day_4.rpy:8685
translate belarusian d4_police_common_51645a36:

    # voice "voice/romka/4day/155 D.ogg"
    # Rom "Дохлый номер! Не помогут нам мусора."
    voice "voice/romka/4day/155 D.ogg"
    Rom "Дохлы нумар! Не дапамогуць нам мусары."

# game/scripts/scene/scene_day_4.rpy:8687
translate belarusian d4_police_common_ba1d3ffb:

    # voice "voice/romka/4day/156 O.ogg"
    # Rom "Одна надежда на нас самих."
    voice "voice/romka/4day/156 O.ogg"
    Rom "Адна надзея на нас саміх."

# game/scripts/scene/scene_day_4.rpy:8690
translate belarusian d4_police_common_b8dff539:

    # "В эту минуту мне казалось, что в мире нет ничего, кроме ветра и долговязых теней, блуждающих в потёмках."
    "У гэтую хвіліну мне здавалася, што ў свеце няма нічога, акрамя ветру і даўгавязых ценяў, якія блукаюць у пацёмках."

# game/scripts/scene/scene_day_4.rpy:8691
translate belarusian d4_police_common_c1be798f:

    # "И что нам самим суждено стать такими же тенями."
    "І што нам самім наканавана стаць такімі ж ценямі."

# game/scripts/scene/scene_day_4.rpy:8696
translate belarusian d4_police_common_31db550c:

    # "Ромка протянул мне руку, прощаясь."
    "Ромка працягнуў мне руку, развітваючыся."

# game/scripts/scene/scene_day_4.rpy:8697
translate belarusian d4_police_common_b2a24a4e:

    # "Я подумал, что как только разожму его ладонь, то сам очнусь в лесу без памяти. Если только меня не сожрут заживо."
    "Я падумаў, што як толькі расцісну яго далонь, то сам ачнуся ў лесе без памяці. Калі толькі мяне не зжаруць жыўцом."

# game/scripts/scene/scene_day_4.rpy:8703
translate belarusian d4_police_common_f8a0086c:

    # "Он отпустил руку и ушёл."
    "Ён адпусціў руку і сышоў."

# game/scripts/scene/scene_day_4.rpy:8708
translate belarusian d4_police_common_52aef795:

    # "А я ёжился на морозе, долго не решаясь покинуть освещённый пятачок перед милицейским участком."
    "А я ёжыўся на марозе, доўга не адважваючыся пакінуць асветлены пятачок перад міліцэйскім пастарункам."

# game/scripts/scene/scene_day_4.rpy:8747
translate belarusian d4_polhouse_begin_devend_59a11abf:

    # "Посёлок выглядел покинутым и каким-то усопшим."
    "Пасёлак выглядаў пакінутым і нейкім спачылым."

# game/scripts/scene/scene_day_4.rpy:8748
translate belarusian d4_polhouse_begin_devend_112cabb8:

    # "Покосившийся штакетник, замусоренные овраги..."
    "Пахілены штакетнік, засмечаныя яры..."

# game/scripts/scene/scene_day_4.rpy:8749
translate belarusian d4_polhouse_begin_devend_bf3619cc:

    # "Летом, наверное, тут зелено и оттого симпатично. Но зимой, под коркой льда, под одеялом снега..."
    "Летам, напэўна, тут зелена і таму сімпатычна. Але зімой, пад скарынкай лёду, пад коўдрай снегу..."

# game/scripts/scene/scene_day_4.rpy:8751
translate belarusian d4_polhouse_begin_devend_1285d3e6:

    # "Я озирался изредка, чтобы убедиться, не идут ли следом мои в обоих смыслах преданные друзья."
    "Я зрэдку азіраўся, каб пераканацца, ці не ідуць следам мае ў абодвух сэнсах адданыя сябры."

# game/scripts/scene/scene_day_4.rpy:8752
translate belarusian d4_polhouse_begin_devend_20ba5488:

    # "Псы лаяли и гремели цепями за заборами, но резко смолкали, когда мы доходили до следующего дома."
    "Псы брахалі і грымелі ланцугамі за платамі, але рэзка змаўкалі, калі мы даходзілі да наступнага дома."

# game/scripts/scene/scene_day_4.rpy:8754
translate belarusian d4_polhouse_begin_devend_043d5998:

    # voice "voice/anton/4day/22 Pre.ogg"
    # Ant "Представь, что это призраки цепями звенят."
    voice "voice/anton/4day/22 Pre.ogg"
    Ant "Уяві, што гэта прывіды ланцугамі звіняць."

# game/scripts/scene/scene_day_4.rpy:8756
translate belarusian d4_polhouse_begin_devend_49828320:

    # voice "voice/Polina/4day/50 O.ogg"
    # Pol "О, я обожаю сказки про призраков. Дедушка часто мне их рассказывает..."
    voice "voice/Polina/4day/50 O.ogg"
    Pol "О, я абажаю казкі пра прывідаў. Дзядуля часта мне іх расказвае..."

# game/scripts/scene/scene_day_4.rpy:8769
translate belarusian d4_polhouse_begin_devend_2bd93050:

    # "Она остановилась у небольшого, но уютного дома с заснеженной крышей. Положила руку на калитку."
    "Яна спынілася каля невялікага, але ўтульнага дома з заснежаным дахам. Паклала руку на брамку."

# game/scripts/scene/scene_day_4.rpy:8773
translate belarusian d4_polhouse_begin_devend_7fe4117d:

    # "Вгляделась в меня, словно хотела залезть в душу."
    "Угледзелася ў мяне, нібы хацела залезці ў душу."

# game/scripts/scene/scene_day_4.rpy:8776
translate belarusian d4_polhouse_begin_devend_c6512ea8:

    # voice "voice/Polina/4day/51 Vo.ogg"
    # Pol "Вот я всё вспоминаю дедушку, говорю, какой он хороший, заботливый, умный, но это только половина правды."
    voice "voice/Polina/4day/51 Vo.ogg"
    Pol "Вось я ўсё ўспамінаю дзядулю, кажу, які ён добры, клапатлівы, разумны, але гэта толькі палова праўды."

# game/scripts/scene/scene_day_4.rpy:8780
translate belarusian d4_polhouse_begin_devend_d929e187:

    # voice "voice/Polina/4day/52 V.ogg"
    # Pol "В последнее время он немного..."
    voice "voice/Polina/4day/52 V.ogg"
    Pol "Апошнім часам ён крыху..."

# game/scripts/scene/scene_day_4.rpy:8783
translate belarusian d4_polhouse_begin_devend_2963308f:

    # "Она сделала паузу, подбирая формулировку."
    "Яна зрабіла паўзу, падбіраючы фармулёўку."

# game/scripts/scene/scene_day_4.rpy:8786
translate belarusian d4_polhouse_begin_devend_33730028:

    # voice "voice/Polina/4day/53 Chu.ogg"
    # Pol "...чудной? Да, пожалуй." id d4_polhouse_begin_devend_33730028
    voice "voice/Polina/4day/53 Chu.ogg"
    Pol "...дзівакаваты? Так, бадай."

# game/scripts/scene/scene_day_4.rpy:8790
translate belarusian d4_polhouse_begin_devend_85904592:

    # voice "voice/Polina/4day/54 Sta.ogg"
    # Pol "Стал таким с годами. Так что ничему не удивляйся."
    voice "voice/Polina/4day/54 Sta.ogg"
    Pol "Стаў такім з гадамі. Так што нічому не здзіўляйся."

# game/scripts/scene/scene_day_4.rpy:8793
translate belarusian d4_polhouse_begin_devend_ab72117d:

    # voice "voice/anton/4day/23 Tak.ogg"
    # Ant "Так точно! Ничему не удивляться!"
    voice "voice/anton/4day/23 Tak.ogg"
    Ant "Так дакладна! Нічому не здзіўляцца!"

# game/scripts/scene/scene_day_4.rpy:8800
translate belarusian d4_polhouse_begin_devend_1ea66c22:

    # voice "voice/Polina/4day/55 Ha.ogg"
    # Pol "Ха-ха! Вольно!"
    voice "voice/Polina/4day/55 Ha.ogg"
    Pol "Ха-ха! Вольна!"

# game/scripts/scene/scene_day_4.rpy:8824
translate belarusian d4_polhouse_begin_devend_6dfaef92:

    # "Мы прошли по расчищенной дорожке к дому."
    "Мы прайшлі па расчышчанай дарожцы да дома."

# game/scripts/scene/scene_day_4.rpy:8828
translate belarusian d4_polhouse_begin_devend_5ecec09e:

    # "Полина отперла замок."
    "Паліна адамкнула замок."

# game/scripts/scene/scene_day_4.rpy:8835
translate belarusian d4_polhouse_begin_devend_ffa859e8:

    # "Длинный коридор был полон теней."
    "Доўгі калідор быў поўны ценяў."

# game/scripts/scene/scene_day_4.rpy:8859
translate belarusian d4_polhouse_begin_devend_2c8a665d:

    # "Дверь, хлопнув, отрезала нас от шума ветра и остальных уличных звуков."
    "Дзверы, грукнуўшы, адрэзалі нас ад шуму ветру і астатніх вулічных гукаў."

# game/scripts/scene/scene_day_4.rpy:8861
translate belarusian d4_polhouse_begin_devend_7cf1775d:

    # "Наступила такая тишина, что я услышал, как стучит сердце Полины."
    "Наступіла такая цішыня, што я пачуў, як стукае сэрца Паліны."

# game/scripts/scene/scene_day_4.rpy:8864
translate belarusian d4_polhouse_begin_devend_73f10f75:

    # "Хотелось накрыть его рукой и ощущать биение ладонью, линиями жизни."
    "Хацелася накрыць яго рукой і адчуваць біццё далонню, лініямі жыцця."

# game/scripts/scene/scene_day_4.rpy:8874
translate belarusian d4_polhouse_begin_devend_44bbce30:

    # voice "voice/Polina/4day/56 Ti.ogg"
    # Pol "Ты всегда так застываешь?"
    voice "voice/Polina/4day/56 Ti.ogg"
    Pol "Ты заўсёды так застываеш?"

# game/scripts/scene/scene_day_4.rpy:8876
translate belarusian d4_polhouse_begin_devend_2a197947:

    # voice "voice/Polina/4day/57 Ka.ogg"
    # Pol "Как будто у тебя в голове стоп-кран нажали."
    voice "voice/Polina/4day/57 Ka.ogg"
    Pol "Быццам у цябе ў галаве стоп-кран націснулі."

# game/scripts/scene/scene_day_4.rpy:8878
translate belarusian d4_polhouse_begin_devend_4993fef0:

    # voice "voice/anton/4day/24 Fa.ogg"
    # Ant "Фантазия рисует всякие картинки."
    voice "voice/anton/4day/24 Fa.ogg"
    Ant "Фантазія малюе ўсякія карцінкі."

# game/scripts/scene/scene_day_4.rpy:8880
translate belarusian d4_polhouse_begin_devend_a3d9ba25:

    # voice "voice/Polina/4day/58 A.ogg"
    # Pol "А, понимаю."
    voice "voice/Polina/4day/58 A.ogg"
    Pol "А, разумею."

# game/scripts/scene/scene_day_4.rpy:8885
translate belarusian d4_polhouse_begin_devend_58cfc42d:

    # "Она сняла курточку и повесила на крючок."
    "Яна зняла куртачку і павесіла на кручок."

# game/scripts/scene/scene_day_4.rpy:8911
translate belarusian d4_polhouse_begin_devend_d62cdfbe:

    # voice "voice/Polina/4day/59 Ra.ogg"
    # Pol "Раздевайся-разувайся."
    voice "voice/Polina/4day/59 Ra.ogg"
    Pol "Распранайся-разбувайся."

# game/scripts/scene/scene_day_4.rpy:8915
translate belarusian d4_polhouse_begin_devend_5d021f91:

    # voice "voice/Polina/4day/60 Ya.ogg"
    # Pol "Я пока в комнате приберусь."
    voice "voice/Polina/4day/60 Ya.ogg"
    Pol "Я пакуль у пакоі прыбяруся."

# game/scripts/scene/scene_day_4.rpy:8919
translate belarusian d4_polhouse_begin_devend_ffd164a0:

    # voice "voice/Polina/4day/61 De.ogg"
    # Pol "Дедушка, бывает, вещи свои оставляет где попало."
    voice "voice/Polina/4day/61 De.ogg"
    Pol "Дзядуля, бывае, рэчы свае пакідае абы-дзе."

# game/scripts/scene/scene_day_4.rpy:8923
translate belarusian d4_polhouse_begin_devend_ae0fc743:

    # voice "voice/Polina/4day/62 Ya.ogg"
    # Pol "Я быстро."
    voice "voice/Polina/4day/62 Ya.ogg"
    Pol "Я хутка."

# game/scripts/scene/scene_day_4.rpy:8941
translate belarusian d4_polhouse_begin_devend_a3535563:

    # "Лёгкая, как бабочка, она упорхнула."
    "Лёгкая, як матылёк, яна выпурхнула."

# game/scripts/scene/scene_day_4.rpy:8942
translate belarusian d4_polhouse_begin_devend_ffa169e9:

    # "Такая же, только стальная, могла порхать у меня в животе уже в обозримом будущем."
    "Такі ж, толькі сталёвы, мог пурхаць у мяне ў жываце ўжо ў агляднай будучыні."

# game/scripts/scene/scene_day_4.rpy:8943
translate belarusian d4_polhouse_begin_devend_2a813ff1:

    # "Я стащил куртку. Расшнуровал ботинки."
    "Я сцягнуў куртку. Расшнураваў чаравікі."

# game/scripts/scene/scene_day_4.rpy:8947
translate belarusian d4_polhouse_begin_devend_01ffdaa9:

    # "Тонкий скрип достиг уха."
    "Тонкі рып дасягнуў вуха."

# game/scripts/scene/scene_day_4.rpy:8962
translate belarusian d4_polhouse_lookaround_ski_d5ceb66d:

    # "Лыжи."
    "Лыжы."

# game/scripts/scene/scene_day_4.rpy:8967
translate belarusian d4_polhouse_lookaround_ski_d2c0e28b:

    # "Лыжи «Турист». Папа рассказывал, что в детстве сам делал лыжи и палки, и даже лыжную мазь сам изготавливал из пчелиного воска, канифоли и хвойной смолы."
    "Лыжы «Турыст». Тата расказваў, што ў дзяцінстве сам рабіў лыжы і палкі, і нават лыжную мазь сам вырабляў з пчалінага воску, каніфолі і хваёвай смалы."

# game/scripts/scene/scene_day_4.rpy:8968
translate belarusian d4_polhouse_lookaround_ski_5b4160a3:

    # "Для здешних суровых зим – то что надо. Но эти лыжи стоит отремонтировать. Скобы крепления совсем истлели. На них какие-то красные пятна. Это просто ржавчина."
    "Для тутэйшых суровых зім — тое што трэба. Але гэтыя лыжы варта адрамантаваць. Скобы мацавання зусім спарахнелі. На іх нейкія чырвоныя плямы. Гэта проста іржа."

# game/scripts/scene/scene_day_4.rpy:8975
translate belarusian d4_polhouse_lookaround_telephone_bed2597b:

    # "Телефон."
    "Тэлефон."

# game/scripts/scene/scene_day_4.rpy:8980
translate belarusian d4_polhouse_lookaround_telephone_e02e5252:

    # "Если встать напротив телефона, кажется, что узор на обоях – это внимательные глаза. Отсюда, значит, мне звонит Полина!"
    "Калі стаць насупраць тэлефона, здаецца, што ўзор на шпалерах — гэта ўважлівыя вочы. Адсюль, значыць, мне тэлефануе Паліна!"

# game/scripts/scene/scene_day_4.rpy:8981
translate belarusian d4_polhouse_lookaround_telephone_c37e9cf7:

    # "Стоит тут под счётчиком, в сумерках, среди теней, накручивает на палец шнур. Может, выключателем балуется, то зажигает свет, то гасит, и говорит со мной из темноты."
    "Стаіць тут пад лічыльнікам, у прыцемках, сярод ценяў, накручвае на палец шнур. Можа, выключальнікам бавіцца, то запальвае святло, то гасіць, і гаворыць са мной з цемры."

# game/scripts/scene/scene_day_4.rpy:8988
translate belarusian d4_polhouse_lookaround_horns_eb268588:

    # "Рога."
    "Рогі."

# game/scripts/scene/scene_day_4.rpy:8993
translate belarusian d4_polhouse_lookaround_horns_a376514e:

    # "Не понимаю, зачем взрослые такое вешают в доме. Кривые острые отростки. Я читал в «Юном натуралисте», что животным не больно, если спиливают уже отвердевшие рога."
    "Не разумею, навошта дарослыя такое вешаюць у доме. Крывыя вострыя адросткі. Я чытаў у «Юным натуралісце», што жывёлам не балюча, калі спілоўваюць ужо ацвярдзелыя рогі."

# game/scripts/scene/scene_day_4.rpy:8994
translate belarusian d4_polhouse_lookaround_horns_683f3c5c:

    # "И всё равно это как срезанными ногтями стену заклеить. Тоже что-то ороговевшее, когда-то бывшее частью живого организма."
    "І ўсё адно гэта як зрэзанымі пазногцямі сцяну заклеіць. Таксама нешта арагавелае, што некалі было часткай жывога арганізма."

# game/scripts/scene/scene_day_4.rpy:9001
translate belarusian d4_polhouse_lookaround_portrait_74ed862e:

    # "Портрет Паганини."
    "Партрэт Паганіні."

# game/scripts/scene/scene_day_4.rpy:9006
translate belarusian d4_polhouse_lookaround_portrait_6e3f5c00:

    # "А эту картину я знаю. Паганини. Тот, который так круто играл на скрипке, что люди решили, будто он продал душу дьяволу."
    "А гэтую карціну я ведаю. Паганіні. Той, які так крута іграў на скрыпцы, што людзі вырашылі, быццам ён прадаў душу д'яблу."

# game/scripts/scene/scene_day_4.rpy:9007
translate belarusian d4_polhouse_lookaround_portrait_73681238:

    # "Портрет нарисовал Николай Фешин — он был известным художником в России, а после революции уехал в Америку и там тоже прославился. Какие длинные у Паганини пальцы."
    "Партрэт намаляваў Мікалай Фешын — ён быў вядомым мастаком у Расіі, а пасля рэвалюцыі з'ехаў у Амерыку і там таксама праславіўся. Якія доўгія ў Паганіні пальцы."

# game/scripts/scene/scene_day_4.rpy:9008
translate belarusian d4_polhouse_lookaround_portrait_41e81c92:

    # "И взгляд такой пронзительный. Куда он смотрит? Может, и правда — продал душу? А Полина, интересно, продала бы?"
    "І позірк такі пранізлівы. Куды ён глядзіць? Можа, і праўда — прадаў душу? А Паліна, цікава, прадала б?"

# game/scripts/scene/scene_day_4.rpy:9015
translate belarusian d4_polhouse_lookaround_mirror_66c831ab:

    # "Зеркало."
    "Люстэрка."

# game/scripts/scene/scene_day_4.rpy:9046
translate belarusian d4_polhouse_lookaround_mirror_9b6bcc6e:

    # "В этом зеркале всё такое резкое и глубокое, взгляд проваливается."
    "У гэтым люстэрку ўсё такое рэзкае і глыбокае, позірк правальваецца."

# game/scripts/scene/scene_day_4.rpy:9051
translate belarusian d4_polhouse_lookaround_mirror_38e46394:

    # "Будто не зеркало, а дверной проём, за которым такая же комната с лыжами, липкими на ощупь обоями."
    "Нібы не люстэрка, а дзвярны праём, за якім такі ж пакой з лыжамі, ліпкімі навобмацак шпалерамі."

# game/scripts/scene/scene_day_4.rpy:9055
translate belarusian d4_polhouse_lookaround_mirror_1b9daf17:

    # "И счётчиком, который к концу месяца почти ничего не накрутил, словно Полина с дедом вечерами сидят в кромешной темноте."
    "І лічыльнікам, які да канца месяца амаль нічога не накруціў, нібы Паліна з дзедам вечарамі сядзяць у непрагляднай цемры."

# game/scripts/scene/scene_day_4.rpy:9076
translate belarusian d4_polhouse_lookaround_mirror_1880689e:

    # "А ещё..."
    "А яшчэ..."

# game/scripts/scene/scene_day_4.rpy:9089
translate belarusian d4_polhouse_lookaround_mirror_d4598a38:

    # "А?! Там кто-то есть или это фабричный дефект зеркала искривляет двери?{w=.7}{nw}"
    "А?! Там нехта ёсць ці гэта фабрычны дэфект люстэрка скрыўляе дзверы?{w=.7}{nw}"

# game/scripts/scene/scene_day_4.rpy:9110
translate belarusian d4_polhouse_lookaround_mirror_49362450:

    # "Всего лишь охотничий трофей."
    "Усяго толькі паляўнічы трафей."

# game/scripts/scene/scene_day_4.rpy:9147
translate belarusian d4_polhouse_lookaround_grandfather_f4582e81:

    # "Комната Деда."
    "Пакой Дзеда."

# game/scripts/scene/scene_day_4.rpy:9176
translate belarusian d4_polhouse_lookaround_grandfather_d3a70eda:

    # "Ого, сколько всякого хлама, как в барахолке старьёвщика!"
    "Ого, колькі ўсякага мотлаху, як у барахолцы рызніка!"

# game/scripts/scene/scene_day_4.rpy:9177
translate belarusian d4_polhouse_lookaround_grandfather_819ae9a2:

    # "Или как на свалке у посёлкового кладбища, куда сбрасывают искусственные цветы, щепки сгнивших крестов и грязные ленты с золотистыми словами соболезнований."
    "Або як на звалцы каля пасялковых могілак, куды скідаюць штучныя кветкі, трэскі згнілых крыжоў і брудныя стужкі з залацістымі словамі спачуванняў."

# game/scripts/scene/scene_day_4.rpy:9178
translate belarusian d4_polhouse_lookaround_grandfather_7c2b6348:

    # "Почему мне кажется, что дед Полины приволок всё это с кладбищенской помойки? Там ведь не бывает детских игрушек… или бубна, как в книжке про северных шаманов."
    "Чаму мне здаецца, што дзед Паліны прывалок усё гэта з могілкавага сметніка? Там жа не бывае дзіцячых цацак... ці бубна, як у кніжцы пра паўночных шаманаў."

# game/scripts/scene/scene_day_4.rpy:9179
translate belarusian d4_polhouse_lookaround_grandfather_169bad4b:

    # "А это… как же оно называется? Ловец снов вроде. Но поймал ловец не сны, а паука-сенокосца."
    "А гэта... як жа яно называецца? Лавец сноў, здаецца. Але злавіў лавец не сны, а павука-касца."

# game/scripts/scene/scene_day_4.rpy:9180
translate belarusian d4_polhouse_lookaround_grandfather_03076bce:

    # "И запашок… Не мудрено, что тут даже среди зимы жужжат мухи. Пахнет топлёным салом и сырой землёй. Если долго здесь находиться, наверное, можно привыкнуть."
    "І душок... Не дзіва, што тут нават сярод зімы гудуць мухі. Пахне топленым салам і сырой зямлёй. Калі доўга тут знаходзіцца, напэўна, можна прывыкнуць."

# game/scripts/scene/scene_day_4.rpy:9200
translate belarusian d4_polhouse_followup_4cfc1bc1:

    # "Снимая обувь, я посмотрел вглубь дома."
    "Здымаючы абутак, я паглядзеў углыб дома."

# game/scripts/scene/scene_day_4.rpy:9202
translate belarusian d4_polhouse_followup_64b5dc8d:

    # "Полумрак маскировал поворот в конце коридора. Что-то двигалось ко мне, волочась по рассохшимся доскам."
    "Паўзмрок маскіраваў паварот у канцы калідора. Нешта рухалася да мяне, валакучыся па рассохлых дошках."

# game/scripts/scene/scene_day_4.rpy:9207
translate belarusian d4_polhouse_followup_65a93fcf:

    # "Кыр-кыр!"
    "Кыр-кыр!"

# game/scripts/scene/scene_day_4.rpy:9212
translate belarusian d4_polhouse_followup_65a93fcf_1:

    # "Кыр-кыр!"
    "Кыр-кыр!"

# game/scripts/scene/scene_day_4.rpy:9217
translate belarusian d4_polhouse_followup_0d42b28c:

    # "Скрип нарастал."
    "Рып нарастаў."

# game/scripts/scene/scene_day_4.rpy:9222
translate belarusian d4_polhouse_followup_cf4f436d:

    # "Я поймал себя на том, что отступаю к дверям."
    "Я злавіў сябе на тым, што адступаю да дзвярэй."

# game/scripts/scene/scene_day_4.rpy:9223
translate belarusian d4_polhouse_followup_b6cbe8db:

    # voice "voice/anton/4day/25 Pol.ogg"
    # Ant "Полина?"
    voice "voice/anton/4day/25 Pol.ogg"
    Ant "Паліна?"

# game/scripts/scene/scene_day_4.rpy:9232
translate belarusian d4_polhouse_followup_0b73b2db:

    # "Из-за угла выкатилось инвалидное кресло. Кряжистый старик выплыл из темноты."
    "З-за вугла выкацілася інваліднае крэсла. Каржакаваты стары выплыў з цемры."

# game/scripts/scene/scene_day_4.rpy:9242
translate belarusian d4_polhouse_followup_d407c379:

    # voice "voice/Hariton/01. Ti.ogg"
    # Ded "Ты, должно быть, одноклассник моей Поли?"
    voice "voice/Hariton/01. Ti.ogg"
    Ded "Ты, мусіць, аднакласнік маёй Полі?"

# game/scripts/scene/scene_day_4.rpy:9247
translate belarusian d4_polhouse_followup_0363cdc6:

    # voice "voice/anton/4day/26 Da.ogg"
    # Ant "Да. Антон Петров."
    voice "voice/anton/4day/26 Da.ogg"
    Ant "Так. Антон Пятроў."

# game/scripts/scene/scene_day_4.rpy:9253
translate belarusian d4_polhouse_followup_53463894:

    # "Рукопожатие было на удивление крепким."
    "Поціск рукі быў на здзіўленне моцным."

# game/scripts/scene/scene_day_4.rpy:9255
translate belarusian d4_polhouse_followup_8cf9fef1:

    # voice "voice/Hariton/02. Ochen.ogg"
    # Ded "Очень приятно! Очень."
    voice "voice/Hariton/02. Ochen.ogg"
    Ded "Вельмі прыемна! Вельмі."

# game/scripts/scene/scene_day_4.rpy:9259
translate belarusian d4_polhouse_followup_a1baa347:

    # voice "voice/Hariton/03. A.ogg"
    # Ded "А я Харитон. Греческое имя, значит «щедрый»."
    voice "voice/Hariton/03. A.ogg"
    Ded "А я Харытон. Грэчаскае імя, значыць «шчодры»."

# game/scripts/scene/scene_day_4.rpy:9263
translate belarusian d4_polhouse_followup_d06ca50f:

    # voice "voice/Hariton/04.At.ogg"
    # Ded "А твоё имя, знаешь, что обозначает?"
    voice "voice/Hariton/04.At.ogg"
    Ded "А тваё імя, ведаеш, што азначае?"

# game/scripts/scene/scene_day_4.rpy:9266
translate belarusian d4_polhouse_followup_bbdc758d:

    # voice "voice/anton/4day/27 Ni.ogg"
    # Ant "Никогда не задумывался."
    voice "voice/anton/4day/27 Ni.ogg"
    Ant "Ніколі не задумваўся."

# game/scripts/scene/scene_day_4.rpy:9269
translate belarusian d4_polhouse_followup_d3f2eaf8:

    # voice "voice/Hariton/05. Ot.ogg"
    # Ded "От латинского «антео» — тот, кто вступает в бой!"
    voice "voice/Hariton/05. Ot.ogg"
    Ded "Ад лацінскага «антэа» — той, хто ўступае ў бой!"

# game/scripts/scene/scene_day_4.rpy:9273
translate belarusian d4_polhouse_followup_a3d31647:

    # "Я одобрительно хмыкнул."
    "Я ўхвальна хмыкнуў."

# game/scripts/scene/scene_day_4.rpy:9274
translate belarusian d4_polhouse_followup_c3884267:

    # "Оказывается, у моего имени «смелые» корни."
    "Аказваецца, у майго імя «смелыя» карані."

# game/scripts/scene/scene_day_4.rpy:9275
translate belarusian d4_polhouse_followup_9ec95159:

    # voice "voice/anton/4day/28 APo.ogg"
    # Ant "А Полина?"
    voice "voice/anton/4day/28 APo.ogg"
    Ant "А Паліна?"

# game/scripts/scene/scene_day_4.rpy:9278
translate belarusian d4_polhouse_followup_57901091:

    # voice "voice/Hariton/05.pol.ogg"
    # Ded "Полина – французского происхождения."
    voice "voice/Hariton/05.pol.ogg"
    Ded "Паліна — французскага паходжання."

# game/scripts/scene/scene_day_4.rpy:9282
translate belarusian d4_polhouse_followup_d1134cb1:

    # voice "voice/Hariton/06.Esli.ogg" 
    # Ded "Если не ошибаюсь... «Солнечная»."
    voice "voice/Hariton/06.Esli.ogg" 
    Ded "Калі не памыляюся... «Сонечная»."

# game/scripts/scene/scene_day_4.rpy:9285
translate belarusian d4_polhouse_followup_4ee1022e:

    # "Ну конечно. Солнце, манящая Франция, небо над Парижем, – всё это про Полину."
    "Ну вядома. Сонца, вабная Францыя, неба над Парыжам — усё гэта пра Паліну."

# game/scripts/scene/scene_day_4.rpy:9286
translate belarusian d4_polhouse_followup_6764cffe:

    # voice "voice/anton/4day/29 Vi.ogg"
    # Ant "Вы так много знаете об именах."
    voice "voice/anton/4day/29 Vi.ogg"
    Ant "Вы так шмат ведаеце пра імёны."

# game/scripts/scene/scene_day_4.rpy:9289
translate belarusian d4_polhouse_followup_42ad5d53:

    # voice "voice/Hariton/06.Ya.ogg"
    # Ded "Я каждой своей кукле особенное имя давал."
    voice "voice/Hariton/06.Ya.ogg"
    Ded "Я кожнай сваёй ляльцы асаблівае імя даваў."

# game/scripts/scene/scene_day_4.rpy:9292
translate belarusian d4_polhouse_followup_405aeaaa:

    # voice "voice/anton/4day/113. Kuk.ogg"
    # Ant "Кукле?"
    voice "voice/anton/4day/113. Kuk.ogg"
    Ant "Ляльцы?"

# game/scripts/scene/scene_day_4.rpy:9295
translate belarusian d4_polhouse_followup_64425a5c:

    # voice "voice/Hariton/07. Pol.ogg"
    # Ded "Полина не рассказывала? Я же кукловодом работал при театре."
    voice "voice/Hariton/07. Pol.ogg"
    Ded "Паліна не расказвала? Я ж лялькаводам працаваў пры тэатры."

# game/scripts/scene/scene_day_4.rpy:9299
translate belarusian d4_polhouse_followup_44a0ec25:

    # voice "voice/Hariton/08.Pot.ogg"
    # Ded "Потом сторож с сигаретой тлеющей уснул, сам погиб, и театр сгорел до основания."
    voice "voice/Hariton/08.Pot.ogg"
    Ded "Потым вартаўнік заснуў з цыгарэтай, што тлела, сам загінуў, і тэатр згарэў дашчэнту."

# game/scripts/scene/scene_day_4.rpy:9303
translate belarusian d4_polhouse_followup_fe142b5d:

    # voice "voice/Hariton/09.Ku.ogg"
    # Ded "Куклы мои сгорели."
    voice "voice/Hariton/09.Ku.ogg"
    Ded "Лялькі мае згарэлі."

# game/scripts/scene/scene_day_4.rpy:9306
translate belarusian d4_polhouse_followup_ebe32bf1:

    # voice "voice/anton/4day/114. Za.ogg"
    # Ant "Жаль."
    voice "voice/anton/4day/114. Za.ogg"
    Ant "Шкада."

# game/scripts/scene/scene_day_4.rpy:9308
translate belarusian d4_polhouse_followup_ba8ac7da:

    # "А про себя подумал: вроде Полина рассказывала, что её дедушка был краеведом..."
    "А пра сябе падумаў: нібыта Паліна расказвала, што яе дзядуля быў краязнаўцам..."

# game/scripts/scene/scene_day_4.rpy:9317
translate belarusian d4_polhouse_followup_d8f1796c:

    # "Он прищурился хитро."
    "Ён прыжмурыўся хітра."

# game/scripts/scene/scene_day_4.rpy:9322
translate belarusian d4_polhouse_followup_5bea44ea:

    # voice "voice/Hariton/07. Az.ogg"
    # Ded "А знаешь ли ты, Петров Антон, что в старину у людей два имени было: настоящее и то, что они называли незнакомцам?"
    voice "voice/Hariton/07. Az.ogg"
    Ded "А ці ведаеш ты, Пятроў Антон, што ў даўніну ў людзей два імёны было: сапраўднае і тое, што яны называлі незнаёмцам?"

# game/scripts/scene/scene_day_4.rpy:9326
translate belarusian d4_polhouse_followup_1e3addd5:

    # voice "voice/Hariton/08.Sh.ogg"
    # Ded "Считалось, что подлинное имя, попав к нехорошим людям, могло обернуться против человека."
    voice "voice/Hariton/08.Sh.ogg"
    Ded "Лічылася, што праўдзівае імя, трапіўшы да нядобрых людзей, магло абярнуцца супраць чалавека."

# game/scripts/scene/scene_day_4.rpy:9330
translate belarusian d4_polhouse_followup_25146d83:

    # voice "voice/Hariton/09.Po.ogg"
    # Ded "По имени насылали хвори и даже смерть."
    voice "voice/Hariton/09.Po.ogg"
    Ded "Па імені насылалі хворасці і нават смерць."

# game/scripts/scene/scene_day_4.rpy:9333
translate belarusian d4_polhouse_followup_70750c1d:

    # voice "voice/anton/4day/115. Ogo.ogg"
    # Ant "Ого!"
    voice "voice/anton/4day/115. Ogo.ogg"
    Ant "Ого!"

# game/scripts/scene/scene_day_4.rpy:9337
translate belarusian d4_polhouse_followup_b2dc1da9:

    # voice "voice/Hariton/10.V.ogg"
    # Ded "Вот тебе и ого!"
    voice "voice/Hariton/10.V.ogg"
    Ded "Вось табе і ого!"

# game/scripts/scene/scene_day_4.rpy:9341
translate belarusian d4_polhouse_followup_9b01818c:

    # voice "voice/Hariton/11.Iz.ogg"
    # Ded "И зверям имена придумывали не просто так."
    voice "voice/Hariton/11.Iz.ogg"
    Ded "І звярам імёны прыдумвалі не проста так."

# game/scripts/scene/scene_day_4.rpy:9346
translate belarusian d4_polhouse_followup_72787d6c:

    # voice "voice/Hariton/12.Za.ogg"
    # Ded "Заяц – от литовского «зайсти» — прыгун, то есть. А волк – старославянское «влек» — тот, кто таскает."
    voice "voice/Hariton/12.Za.ogg"
    Ded "Заяц — ад літоўскага «зайсці» — скакун, то бок. А воўк — стараславянскае «влек» — той, хто цягае."

# game/scripts/scene/scene_day_4.rpy:9358
translate belarusian d4_polhouse_followup_c984bc91:

    # "Харитон подъехал ближе. Скрестил руки на груди."
    "Харытон пад'ехаў бліжэй. Скрыжаваў рукі на грудзях."

# game/scripts/scene/scene_day_4.rpy:9359
translate belarusian d4_polhouse_followup_2903122d:

    # "Я задумался: дома ли Полинины родители?"
    "Я задумаўся: ці дома Палініны бацькі?"

# game/scripts/scene/scene_day_4.rpy:9360
translate belarusian d4_polhouse_followup_fb93035f:

    # "Она ни разу не говорила о маме — только о дедушке."
    "Яна ні разу не гаварыла пра маму — толькі пра дзядулю."

# game/scripts/scene/scene_day_4.rpy:9361
translate belarusian d4_polhouse_followup_b3370c24:

    # "Чтобы поддержать беседу, я спросил:"
    "Каб падтрымаць размову, я спытаў:"

# game/scripts/scene/scene_day_4.rpy:9362
translate belarusian d4_polhouse_followup_7bd08223:

    # voice "voice/anton/4day/116. A.ogg"
    # Ant "А медведь?"
    voice "voice/anton/4day/116. A.ogg"
    Ant "А мядзведзь?"

# game/scripts/scene/scene_day_4.rpy:9365
translate belarusian d4_polhouse_followup_7ccbb995:

    # voice "voice/Hariton/13.O.ogg"
    # Ded "О! Имя медведя неизвестно."
    voice "voice/Hariton/13.O.ogg"
    Ded "О! Імя мядзведзя невядомае."

# game/scripts/scene/scene_day_4.rpy:9369
translate belarusian d4_polhouse_followup_6f856b86:

    # voice "voice/Hariton/14.N.ogg"
    # Ded "Наши предки так боялись этого зверя, что предпочли забыть слово, которым его величали."
    voice "voice/Hariton/14.N.ogg"
    Ded "Нашы продкі так баяліся гэтага звера, што палічылі за лепшае забыць слова, якім яго велічалі."

# game/scripts/scene/scene_day_4.rpy:9373
translate belarusian d4_polhouse_followup_94fff887:

    # voice "voice/Hariton/15.Ono.ogg"
    # Ded "Оно просто сгинуло из языка."
    voice "voice/Hariton/15.Ono.ogg"
    Ded "Яно проста згінула з мовы."

# game/scripts/scene/scene_day_4.rpy:9378
translate belarusian d4_polhouse_followup_84f97a41:

    # voice "voice/Hariton/16. Vm.ogg"
    # Ded "Вместо него осталось более позднее прозвище — «ведающий мёдом»."
    voice "voice/Hariton/16. Vm.ogg"
    Ded "Замест яго засталася пазнейшая мянушка — «той, хто ведае мёд»."

# game/scripts/scene/scene_day_4.rpy:9381
translate belarusian d4_polhouse_followup_7283cb16:

    # voice "voice/anton/4day/117. En.ogg"
    # Ant "Интересно."
    voice "voice/anton/4day/117. En.ogg"
    Ant "Цікава."

# game/scripts/scene/scene_day_4.rpy:9384
translate belarusian d4_polhouse_followup_a5ae4253:

    # "Улыбка старика стала шире. Обнажился частокол металлических коронок."
    "Усмешка старога стала шырэйшай. Агаліўся частакол металічных каронак."

# game/scripts/scene/scene_day_4.rpy:9386
translate belarusian d4_polhouse_followup_9dc48422:

    # "Он поднял руку и поводил ею в воздухе, как граблями, расчёсывая пальцами пустоту."
    "Ён падняў руку і павадзіў ёю ў паветры, як граблямі, расчэсваючы пальцамі пустэчу."

# game/scripts/scene/scene_day_4.rpy:9403
translate belarusian d4_polhouse_followup_039a6521:

    # voice "voice/Hariton/18.Sk.ogg"
    # Ded "Скырлы-скырлы-скырлы..."
    voice "voice/Hariton/18.Sk.ogg"
    Ded "Скырлы-скырлы-скырлы..."

# game/scripts/scene/scene_day_4.rpy:9407
translate belarusian d4_polhouse_followup_d1a60132:

    # "От скрипучего звука я весь сжался."
    "Ад рыпучага гуку я ўвесь сціснуўся."

# game/scripts/scene/scene_day_4.rpy:9411
translate belarusian d4_polhouse_followup_9b95bd0d:

    # voice "voice/Hariton/19.To.ogg"
    # Ded "То я медведь на липовой ноге, на берёзовой клюке."
    voice "voice/Hariton/19.To.ogg"
    Ded "То я мядзведзь на ліпавай назе, на бярозавай клюцы."

# game/scripts/scene/scene_day_4.rpy:9415
translate belarusian d4_polhouse_followup_ccd0329b:

    # voice "voice/Hariton/19.Vse.ogg"
    # Ded "Все по сёлам спят, по деревням спят."
    voice "voice/Hariton/19.Vse.ogg"
    Ded "Усе па сёлах спяць, па вёсках спяць."

# game/scripts/scene/scene_day_4.rpy:9419
translate belarusian d4_polhouse_followup_da3e6bc8:

    # voice "voice/Hariton/19.Odn.ogg"
    # Ded "Одна баба не спит — на моей коже сидит."
    voice "voice/Hariton/19.Odn.ogg"
    Ded "Адна баба не спіць — на маёй скуры сядзіць."

# game/scripts/scene/scene_day_4.rpy:9423
translate belarusian d4_polhouse_followup_0dee785b:

    # voice "voice/Hariton/19.Mo.ogg"
    # Ded "Мою шерстку прядёт, моё мяско жрёт."
    voice "voice/Hariton/19.Mo.ogg"
    Ded "Маю воўначку прадзе, маё мяска жрэ."

# game/scripts/scene/scene_day_4.rpy:9427
translate belarusian d4_polhouse_followup_20bb698d:

    # "Если об этом предупреждала Полина, то я не сдержал слово."
    "Калі пра гэта папярэджвала Паліна, то я не стрымаў слова."

# game/scripts/scene/scene_day_4.rpy:9428
translate belarusian d4_polhouse_followup_a47d498c:

    # "Не то чтобы я удивился — скорей не на шутку встревожился."
    "Не тое каб я здзівіўся — хутчэй не на жарт устрывожыўся."

# game/scripts/scene/scene_day_4.rpy:9439
translate belarusian d4_polhouse_followup_413883f3:

    # voice "voice/Hariton/20.Po.ogg"
    # Ded "По легенде, именно в нашей деревне приключилась эта страшная сказка... Как и многие другие."
    voice "voice/Hariton/20.Po.ogg"
    Ded "Паводле легенды, менавіта ў нашай вёсцы здарылася гэтая страшная казка... Як і многія іншыя."

# game/scripts/scene/scene_day_4.rpy:9448
translate belarusian d4_polhouse_followup_ca715848:

    # voice "voice/Hariton/21Vot.ogg"
    # Ded "Вот, к примеру."
    voice "voice/Hariton/21Vot.ogg"
    Ded "Вось, для прыкладу."

# game/scripts/scene/scene_day_4.rpy:9452
translate belarusian d4_polhouse_followup_57b736ee:

    # voice "voice/Hariton/21.Vpro.ogg"
    # Ded "В прошлом веке простому люду тяжко пришлось."
    voice "voice/Hariton/21.Vpro.ogg"
    Ded "У мінулым стагоддзі простаму люду цяжка давялося."

# game/scripts/scene/scene_day_4.rpy:9454
translate belarusian d4_polhouse_followup_c2633147:

    # voice "voice/Hariton/21.Den.ogg"
    # Ded "Денег у них тогда мало было, а еды и того меньше. Точь-в-точь как сейчас."
    voice "voice/Hariton/21.Den.ogg"
    Ded "Грошай у іх тады мала было, а ежы і таго менш. Дакладна як цяпер."

# game/scripts/scene/scene_day_4.rpy:9460
translate belarusian d4_polhouse_followup_80f649eb:

    # voice "voice/Hariton/22. Po.ogg"
    # Ded "Подались тогда крестьяне разбойничать – тайгу обворовывать. Кто карася ухватит, а кто и гуся."
    voice "voice/Hariton/22. Po.ogg"
    Ded "Падаліся тады сяляне разбойнічаць — тайгу абкрадаць. Хто карася ўхопіць, а хто і гусака."

# game/scripts/scene/scene_day_4.rpy:9466
translate belarusian d4_polhouse_followup_fc313381:

    # voice "voice/Hariton/23.A.ogg"
    # Ded "А главный егерь мало того что не препятствовал, так ещё в первых рядах браконьерствовал."
    voice "voice/Hariton/23.A.ogg"
    Ded "А галоўны егер мала таго што не перашкаджаў, дык яшчэ ў першых радах браканьернічаў."

# game/scripts/scene/scene_day_4.rpy:9468
translate belarusian d4_polhouse_followup_df0a931b:

    # voice "voice/Hariton/24.S.ogg"
    # Ded "Самым зажиточным стал на селе. Погреб того и гляди лопнет."
    voice "voice/Hariton/24.S.ogg"
    Ded "Самым заможным стаў на сяле. Пограб таго і глядзі лопне."

# game/scripts/scene/scene_day_4.rpy:9471
translate belarusian d4_polhouse_followup_0e2271e4:

    # voice "voice/Hariton/25.Tak.ogg"
    # Ded "Так и кричал егерь на всю округу: «Я в лесу хозяин!»"
    voice "voice/Hariton/25.Tak.ogg"
    Ded "Так і крычаў егер на ўсю акругу: «Я ў лесе гаспадар!»"

# game/scripts/scene/scene_day_4.rpy:9481
translate belarusian d4_polhouse_followup_ec371c7c:

    # voice "voice/Hariton/26.Ob.ogg"
    # Ded "Обзавёлся он, значится, семьёй, слугами да каким-никаким имением."
    voice "voice/Hariton/26.Ob.ogg"
    Ded "Абзавёўся ён, значыцца, сям'ёй, слугамі ды якім-ніякім маёнткам."

# game/scripts/scene/scene_day_4.rpy:9488
translate belarusian d4_polhouse_followup_f6322e9f:

    # voice "voice/Hariton/27.E.ogg"
    # Ded "И на радостях пир закатил горой аж до самой ночи. А как двенадцать пробило, собаки залаяли."
    voice "voice/Hariton/27.E.ogg"
    Ded "І на радасцях баль задаў гарой аж да самай ночы. А як дванаццаць прабіла, сабакі забрахалі."

# game/scripts/scene/scene_day_4.rpy:9491
translate belarusian d4_polhouse_followup_9f8c341c:

    # voice "voice/Hariton/29. Ed.ogg"
    # Ded "«Идите, — кричит егерь слугам, — собакам кости бросьте»."
    voice "voice/Hariton/29. Ed.ogg"
    Ded "«Ідзіце, — крычыць егер слугам, — сабакам косці кіньце»."

# game/scripts/scene/scene_day_4.rpy:9498
translate belarusian d4_polhouse_followup_aa83d441:

    # voice "voice/Hariton/30.Ch.ogg"
    # Ded "Через время в ворота застучали."
    voice "voice/Hariton/30.Ch.ogg"
    Ded "Праз нейкі час у браму застукалі."

# game/scripts/scene/scene_day_4.rpy:9501
translate belarusian d4_polhouse_followup_c7117d16:

    # voice "voice/Hariton/31. Ede.ogg"
    # Ded "«Идите, — кричит семье, — гостей прогоните»."
    voice "voice/Hariton/31. Ede.ogg"
    Ded "«Ідзіце, — крычыць сям'і, — гасцей праганіце»."

# game/scripts/scene/scene_day_4.rpy:9507
translate belarusian d4_polhouse_followup_616375d4:

    # voice "voice/Hariton/32.O.ogg"
    # Ded "Остался он за столом один. Никто воротиться не спешит."
    voice "voice/Hariton/32.O.ogg"
    Ded "Застаўся ён за сталом адзін. Ніхто вярнуцца не спяшаецца."

# game/scripts/scene/scene_day_4.rpy:9512
translate belarusian d4_polhouse_followup_7f8afd2a:

    # voice "voice/Hariton/33.Sl.ogg"
    # Ded "Слышит, собаки завыли и смолкли."
    voice "voice/Hariton/33.Sl.ogg"
    Ded "Чуе, сабакі завылі і змоўклі."

# game/scripts/scene/scene_day_4.rpy:9517
translate belarusian d4_polhouse_followup_fc0715cd:

    # voice "voice/Hariton/34.E.ogg"
    # Ded "И тут со страшной силой в дверь забарабанили!"
    voice "voice/Hariton/34.E.ogg"
    Ded "І тут са страшнай сілай у дзверы забарабанілі!"

# game/scripts/scene/scene_day_4.rpy:9519
translate belarusian d4_polhouse_followup_2103ed31:

    # voice "voice/Hariton/34.B.ogg"
    # Ded "Бах-бах-бах!"
    voice "voice/Hariton/34.B.ogg"
    Ded "Бах-бах-бах!"

# game/scripts/scene/scene_day_4.rpy:9521
translate belarusian d4_polhouse_followup_e668ed8f:

    # "Я облизал сухие губы и невольно поглядел за плечо старика, про себя умоляя Полину поскорее прийти и прервать этот странный монолог."
    "Я аблізаў сухія вусны і міжволі зірнуў за плячо старога, пра сябе благаючы Паліну хутчэй прыйсці і перапыніць гэты дзіўны маналог."

# game/scripts/scene/scene_day_4.rpy:9522
translate belarusian d4_polhouse_followup_78b837d8:

    # "Но лишь тени копошились за спиной Харитона."
    "Але толькі цені капашыліся за спінай Харытона."

# game/scripts/scene/scene_day_4.rpy:9526
translate belarusian d4_polhouse_followup_2b4fc4e9:

    # voice "voice/Hariton/35.E.ogg"
    # Ded "Егерь от страха едва живой в погреб помчался."
    voice "voice/Hariton/35.E.ogg"
    Ded "Егер ад страху ледзь жывы ў пограб памчаўся."

# game/scripts/scene/scene_day_4.rpy:9532
translate belarusian d4_polhouse_followup_60a7e4ba:

    # voice "voice/Hariton/35.Z.ogg"
    # Ded "Замком «щёлк». Вдруг голос из-за двери:"
    voice "voice/Hariton/35.Z.ogg"
    Ded "Замком «шчоўк». Раптам голас з-за дзвярэй:"

# game/scripts/scene/scene_day_4.rpy:9535
translate belarusian d4_polhouse_followup_c1663a9b:

    # voice "voice/Hariton/36. M.ogg"
    # Ded "Милый, это я, жена твоя. Отвори."
    voice "voice/Hariton/36. M.ogg"
    Ded "Мілы, гэта я, жонка твая. Адчыні."

# game/scripts/scene/scene_day_4.rpy:9539
translate belarusian d4_polhouse_followup_d50c0488:

    # voice "voice/Hariton/37.V.ogg"
    # Ded "В жизнь не открою."
    voice "voice/Hariton/37.V.ogg"
    Ded "У жыцці не адчыню."

# game/scripts/scene/scene_day_4.rpy:9542
translate belarusian d4_polhouse_followup_a56b6c35:

    # voice "voice/Hariton/38. G.ogg"
    # Ded "Голос стал грубее, напористее:"
    voice "voice/Hariton/38. G.ogg"
    Ded "Голас стаў грубейшым, больш напорыстым:"

# game/scripts/scene/scene_day_4.rpy:9545
translate belarusian d4_polhouse_followup_14e2a997:

    # voice "voice/Hariton/39. Ez.ogg"
    # Ded "Изголодалась я, любимый, дай хоть чего-то из закромов."
    voice "voice/Hariton/39. Ez.ogg"
    Ded "Згаладалася я, любы, дай хоць чаго-небудзь з засекаў."

# game/scripts/scene/scene_day_4.rpy:9549
translate belarusian d4_polhouse_followup_efeb413b:

    # voice "voice/Hariton/40.U.ogg"
    # Ded "«Уйди, уйди! Христом заклинаю!» — закричал егерь и упал молиться."
    voice "voice/Hariton/40.U.ogg"
    Ded "«Сыдзі, сыдзі! Хрыстом заклінаю!» — закрычаў егер і ўпаў маліцца."

# game/scripts/scene/scene_day_4.rpy:9552
translate belarusian d4_polhouse_followup_e66e5784:

    # voice "voice/Hariton/41.T.ogg"
    # Ded "Тогда голос, как гром, грянул:"
    voice "voice/Hariton/41.T.ogg"
    Ded "Тады голас, як гром, грымнуў:"

# game/scripts/scene/scene_day_4.rpy:9571
translate belarusian d4_polhouse_followup_6b5b6034:

    # voice "voice/Hariton/42.C.ogg"
    # Ded "Целиком не выйдешь — хоть кусок мне отрежь!"
    voice "voice/Hariton/42.C.ogg"
    Ded "Цалкам не выйдзеш — хоць кавалак мне адрэж!"

# game/scripts/scene/scene_day_4.rpy:9578
translate belarusian d4_polhouse_followup_555a5356:

    # voice "voice/Hariton/43.Eg.ogg"
    # Ded "Егерь вне себя от ужаса просидел в подвале до первых петухов."
    voice "voice/Hariton/43.Eg.ogg"
    Ded "Егер сам не свой ад жаху прасядзеў у падвале да першых пеўняў."

# game/scripts/scene/scene_day_4.rpy:9580
translate belarusian d4_polhouse_followup_9b40d682:

    # voice "voice/Hariton/44. A.ogg"
    # Ded "А как показаться отважился, то нашёл своих слуг и родных..."
    voice "voice/Hariton/44. A.ogg"
    Ded "А як паказацца адважыўся, то знайшоў сваіх слуг і родных..."

# game/scripts/scene/scene_day_4.rpy:9603
translate belarusian d4_polhouse_followup_9cc6d6f2:

    # voice "voice/Hariton/45.P.ogg"
    # Ded "...повешенными на собственных кишках вдоль тракта." id d4_polhouse_followup_9cc6d6f2
    voice "voice/Hariton/45.P.ogg"
    Ded "...павешанымі на ўласных кішках уздоўж тракту."

# game/scripts/scene/scene_day_4.rpy:9613
translate belarusian d4_polhouse_followup_bd65d54f:

    # voice "voice/Hariton/46. G.ogg"
    # Ded "Глядь — а в имении уже дикие звери хозяйничают."
    voice "voice/Hariton/46. G.ogg"
    Ded "Зірк — а ў маёнтку ўжо дзікія звяры гаспадараць."

# game/scripts/scene/scene_day_4.rpy:9633
translate belarusian d4_polhouse_followup_41badca5:

    # voice "voice/Hariton/47.P.ogg"
    # Ded "Потому что нет у тайги границ: она частично в нашем мире, а отчасти там, где ночь никогда не кончается."
    voice "voice/Hariton/47.P.ogg"
    Ded "Таму што няма ў тайгі межаў: яна часткова ў нашым свеце, а часткай там, дзе ноч ніколі не канчаецца."

# game/scripts/scene/scene_day_4.rpy:9644
translate belarusian d4_polhouse_followup_39bc5074:

    # voice "voice/Hariton/49. E.ogg"
    # Ded "Егерь пытался сломя голову бежать из проклятой деревни, но истинный Хозяин леса настиг его в пути." id d4_polhouse_followup_39bc5074
    voice "voice/Hariton/49. E.ogg"
    Ded "Егер спрабаваў стрымгалоў уцячы з праклятай вёскі, але сапраўдны Гаспадар лесу нагнаў яго ў дарозе."

# game/scripts/scene/scene_day_4.rpy:9670
translate belarusian d4_polhouse_followup_ed49474d:

    # "Мой голос зазвучал неуверенно:"
    "Мой голас загучаў няўпэўнена:"

# game/scripts/scene/scene_day_4.rpy:9671
translate belarusian d4_polhouse_followup_f1c00476:

    # voice "voice/anton/4day/118. E.ogg"
    # Ant "И что же с ним сделал этот Хозяин леса?"
    voice "voice/anton/4day/118. E.ogg"
    Ant "І што ж з ім зрабіў гэты Гаспадар лесу?"

# game/scripts/scene/scene_day_4.rpy:9692
translate belarusian d4_polhouse_followup_31c69c54:

    # "Старик громко расхохотался, склонив голову набок."
    "Стары гучна зарагатаў, схіліўшы галаву набок."

# game/scripts/scene/scene_day_4.rpy:9705
translate belarusian d4_polhouse_followup_166962b1:

    # voice "voice/Hariton/51.S.ogg"
    # Ded "Спроси лучше, чего он не сделал."
    voice "voice/Hariton/51.S.ogg"
    Ded "Спытай лепш, чаго ён не зрабіў."

# game/scripts/scene/scene_day_4.rpy:9712
translate belarusian d4_polhouse_followup_b82f0110:

    # voice "voice/Polina/4day/63 An.ogg"
    # Pol "Антон!"
    voice "voice/Polina/4day/63 An.ogg"
    Pol "Антон!"

# game/scripts/scene/scene_day_4.rpy:9715
translate belarusian d4_polhouse_followup_5f4634f7:

    # "Глаза старика пригвоздили меня к дверному полотну."
    "Вочы старога прыгваздзілі мяне да дзвярнога палатна."

# game/scripts/scene/scene_day_4.rpy:9721
translate belarusian d4_polhouse_followup_8ea76d0d:

    # voice "voice/Polina/4day/64 A.ogg"
    # Pol "Антон, проходи в комнату!"
    voice "voice/Polina/4day/64 A.ogg"
    Pol "Антон, праходзь у пакой!"

# game/scripts/scene/scene_day_4.rpy:9725
translate belarusian d4_polhouse_followup_ed2e6a8b:

    # "Несколько секунд старик молчал."
    "Некалькі секунд стары маўчаў."

# game/scripts/scene/scene_day_4.rpy:9733
translate belarusian d4_polhouse_followup_bc798f8b:

    # "Потом улыбнулся как ни в чём не бывало и откатил коляску."
    "Потым усміхнуўся як ні ў чым не бывала і адкаціў каляску."

# game/scripts/scene/scene_day_4.rpy:9735
translate belarusian d4_polhouse_followup_9621eea7:

    # voice "voice/Hariton/52. N.ogg"
    # Ded "Ну, заболтал я тебя. Ступай."
    voice "voice/Hariton/52. N.ogg"
    Ded "Ну, загаварыў я цябе. Ідзі."

# game/scripts/scene/scene_day_4.rpy:9746
translate belarusian d4_polhouse_followup_6693f96e:

    # "Я стряхнул оцепенение и засеменил по коридору."
    "Я скінуў здранцвенне і задрабніў па калідоры."

# game/scripts/scene/scene_day_4.rpy:9748
translate belarusian d4_polhouse_followup_1dcfecf7:

    # voice "voice/anton/4day/119. Pr.ogg"
    # Ant "Приятно было познакомиться."
    voice "voice/anton/4day/119. Pr.ogg"
    Ant "Прыемна было пазнаёміцца."

# game/scripts/scene/scene_day_4.rpy:9750
translate belarusian d4_polhouse_followup_743f3460:

    # voice "voice/Hariton/53.E.ogg"
    # Ded "И мне, Петров Антон, и мне..."
    voice "voice/Hariton/53.E.ogg"
    Ded "І мне, Пятроў Антон, і мне..."

# game/scripts/scene/scene_day_4.rpy:9764
translate belarusian d4_polhouse_followup_52ef9ebd:

    # "Я с облегчением проскользнул в комнату Полины." id d4_polhouse_followup_52ef9ebd
    "Я з палёгкай праслізнуў у пакой Паліны."

# game/scripts/scene/scene_day_4.rpy:9765
translate belarusian d4_polhouse_followup_6760dbf0:

    # "Она была под стать хозяйке – милая и аккуратная." id d4_polhouse_followup_6760dbf0
    "Ён быў пад пару гаспадыні — мілы і акуратны."

# game/scripts/scene/scene_day_4.rpy:9766
translate belarusian d4_polhouse_followup_b8342ba5:

    # "Сразу бросились в глаза огромная коллекция виниловых пластинок и проигрыватель. Стены украшали фотографии в рамках." id d4_polhouse_followup_b8342ba5
    "Адразу кінуліся ў вочы велізарная калекцыя вінілавых пласцінак і прайгравальнік. Сцены ўпрыгожвалі фатаграфіі ў рамках."

# game/scripts/scene/scene_day_4.rpy:9772
translate belarusian d4_polhouse_followup_2132c864:

    # voice "voice/Polina/4day/65 De.ogg"
    # Pol "Дедушка тебя не сильно донимал?" id d4_polhouse_followup_2132c864
    voice "voice/Polina/4day/65 De.ogg"
    Pol "Дзядуля цябе не моцна даймаў?"

# game/scripts/scene/scene_day_4.rpy:9775
translate belarusian d4_polhouse_followup_a3b1b66c:

    # voice "voice/anton/4day/120. Net.ogg"
    # Ant "Нет. Он очень... интересный." id d4_polhouse_followup_a3b1b66c
    voice "voice/anton/4day/120. Net.ogg"
    Ant "Не. Ён вельмі... цікавы."

# game/scripts/scene/scene_day_4.rpy:9778
translate belarusian d4_polhouse_followup_b9f3e5ba:

    # voice "voice/Polina/4day/66 Ne.ogg"
    # Pol "Небось ты теперь знаешь всё о своём имени." id d4_polhouse_followup_b9f3e5ba
    voice "voice/Polina/4day/66 Ne.ogg"
    Pol "Мабыць, ты цяпер ведаеш усё пра сваё імя."

# game/scripts/scene/scene_day_4.rpy:9782
translate belarusian d4_polhouse_followup_2493dc0f:

    # "Я натянуто засмеялся. Поводил взглядом по фотографиям." id d4_polhouse_followup_2493dc0f
    "Я нацягнута засмяяўся. Павадзіў позіркам па фатаграфіях."

# game/scripts/scene/scene_day_4.rpy:9797
translate belarusian d4_polhouse_lookaround2_player_21cb39c2:

    # "Проигрыватель."
    "Прайгравальнік."

# game/scripts/scene/scene_day_4.rpy:9802
translate belarusian d4_polhouse_lookaround2_player_31e9a4b0:

    # "Немного старомодно, но мне нравится! Посмотрим, что у Полины в коллекции. Грампластинки фирмы «Мелодия» и редкий, югославский, винил фирмы Jugoton."
    "Крыху старамодна, але мне падабаецца! Паглядзім, што ў Паліны ў калекцыі. Грампласцінкі фірмы «Мелодыя» і рэдкі, югаслаўскі, вініл фірмы Jugoton."

# game/scripts/scene/scene_day_4.rpy:9803
translate belarusian d4_polhouse_lookaround2_player_e701c2f6:

    # "Рахманинов, Свиридов, арии Верди в исполнении Хиблы Герзмавы. Одна классика — ни ансамбля «Песняры», ни группы «Секрет»."
    "Рахманінаў, Свірыдаў, арыі Вердзі ў выкананні Хіблы Герзмавы. Адна класіка — ні ансамбля «Песняры», ні гурта «Сакрэт»."

# game/scripts/scene/scene_day_4.rpy:9805
translate belarusian d4_polhouse_lookaround2_player_73e27561:

    # "У неё даже музыка на костях есть – записанная электрорекордером поверх рентгеновских снимков. Игла скользит по фотографии чьих-то рёбер, и играет скрипач Ойстрах."
    "У яе нават музыка на касцях ёсць — запісаная электрарэкордэрам паверх рэнтгенаўскіх здымкаў. Іголка слізгае па фатаграфіі чыіхсьці рэбраў, і грае скрыпач Ойстрах."

# game/scripts/scene/scene_day_4.rpy:9812
translate belarusian d4_polhouse_lookaround2_piano_7cba8de6:

    # "Пианино «Кузбасс»."
    "Піяніна «Кузбас»."

# game/scripts/scene/scene_day_4.rpy:9817
translate belarusian d4_polhouse_lookaround2_piano_d6b8731e:

    # "Пианино «Кузбасс». Ни пылинки на крышке! Здесь она репетирует. Почитаем, что за произведение в нотной тетради."
    "Піяніна «Кузбас». Ні пылінкі на вечку! Тут яна рэпеціруе. Пачытаем, што за твор у нотным сшытку."

# game/scripts/scene/scene_day_4.rpy:9818
translate belarusian d4_polhouse_lookaround2_piano_d18ef9b7:

    # "Гендель, «Каприччио соль минор». Похоже на название пиццы, которую едят черепашки-ниндзя. А я и «Собачий вальс» не сыграю."
    "Гендэль, «Капрычыа соль мінор». Падобна на назву піцы, якую ядуць чарапашкі-ніндзя. А я і «Сабачы вальс» не сыграю."

# game/scripts/scene/scene_day_4.rpy:9825
translate belarusian d4_polhouse_lookaround2_poster_b1ba1448:

    # "Плакат «Сейлор Мун»."
    "Плакат «Сейлар Мун»."

# game/scripts/scene/scene_day_4.rpy:9830
translate belarusian d4_polhouse_lookaround2_poster_3d198f0c:

    # "Плакат «Сейлор Мун». Девчачий мультик! «Трансформеры» намного лучше, и рисовать их интереснее, особенно в момент перевоплощения, когда одно становится другим."
    "Плакат «Сейлар Мун». Дзявочы мульцік! «Трансформеры» нашмат лепшыя, і маляваць іх цікавей, асабліва ў момант пераўвасаблення, калі адно становіцца іншым."

# game/scripts/scene/scene_day_4.rpy:9831
translate belarusian d4_polhouse_lookaround2_poster_6465883c:

    # "Хотя если у Полины ловит канал «2х2», и она предложит посмотреть, я не откажусь. Возмездие во имя Луны!"
    "Хоць калі ў Паліны ловіць канал «2х2», і яна прапануе паглядзець, я не адмоўлюся. Адплата ў імя Месяца!"

# game/scripts/scene/scene_day_4.rpy:9851
translate belarusian d4_polhouse_followup2_099cf71b:

    # voice "voice/anton/4day/121. A.ogg"
    # Ant "А это твои родители?"
    voice "voice/anton/4day/121. A.ogg"
    Ant "А гэта твае бацькі?"

# game/scripts/scene/scene_day_4.rpy:9860
translate belarusian d4_polhouse_followup2_469a401d:

    # "Полина потупилась."
    "Паліна патупілася."

# game/scripts/scene/scene_day_4.rpy:9864
translate belarusian d4_polhouse_followup2_cffc2019:

    # voice "voice/Polina/4day/67 Da.ogg"
    # Pol "Да."
    voice "voice/Polina/4day/67 Da.ogg"
    Pol "Так."

# game/scripts/scene/scene_day_4.rpy:9868
translate belarusian d4_polhouse_followup2_92d29db6:

    # voice "voice/Polina/4day/68 Oni.ogg"
    # Pol "Они погибли много лет назад... Я их практически не помню."
    voice "voice/Polina/4day/68 Oni.ogg"
    Pol "Яны загінулі шмат гадоў таму... Я іх практычна не памятаю."

# game/scripts/scene/scene_day_4.rpy:9871
translate belarusian d4_polhouse_followup2_0c365ee4:

    # voice "voice/anton/4day/122. O.ogg"
    # Ant "О!"
    voice "voice/anton/4day/122. O.ogg"
    Ant "О!"

# game/scripts/scene/scene_day_4.rpy:9873
translate belarusian d4_polhouse_followup2_9a068c29:

    # "Я чувствовал себя ослом. Ведь мог и догадаться, что Полина сирота."
    "Я адчуваў сябе аслом. Бо мог і здагадацца, што Паліна сірата."

# game/scripts/scene/scene_day_4.rpy:9874
translate belarusian d4_polhouse_followup2_fcdf3727:

    # voice "voice/anton/4day/123. Mne.ogg"
    # Ant "Мне очень жаль."
    voice "voice/anton/4day/123. Mne.ogg"
    Ant "Мне вельмі шкада."

# game/scripts/scene/scene_day_4.rpy:9877
translate belarusian d4_polhouse_followup2_6f1c8e5a:

    # voice "voice/Polina/4day/69 Sp.ogg"
    # Pol "Спасибо."
    voice "voice/Polina/4day/69 Sp.ogg"
    Pol "Дзякуй."

# game/scripts/scene/scene_day_4.rpy:9881
translate belarusian d4_polhouse_followup2_a454ba8b:

    # voice "voice/Polina/4day/70 De.ogg"
    # Pol "Дедушка воспитывал меня, как родную дочь. Никогда не устану благодарить его."
    voice "voice/Polina/4day/70 De.ogg"
    Pol "Дзядуля выхоўваў мяне, як родную дачку. Ніколі не стамлюся дзякаваць яму."

# game/scripts/scene/scene_day_4.rpy:9884
translate belarusian d4_polhouse_followup2_14a5cc93:

    # voice "voice/anton/4day/124. Pr.ogg"
    # Ant "Представляю, каково тебе пришлось."
    voice "voice/anton/4day/124. Pr.ogg"
    Ant "Уяўляю, як табе давялося."

# game/scripts/scene/scene_day_4.rpy:9887
translate belarusian d4_polhouse_followup2_2f4d4988:

    # "Полина улыбнулась печально, смахнула с лица непослушные локоны."
    "Паліна сумна ўсміхнулася, змахнула з твару непаслухмяныя локаны."

# game/scripts/scene/scene_day_4.rpy:9890
translate belarusian d4_polhouse_followup2_f04faf16:

    # voice "voice/Polina/4day/71 Da.ogg"
    # Pol "Давай не будем о грустном."
    voice "voice/Polina/4day/71 Da.ogg"
    Pol "Давай не будзем пра сумнае."

# game/scripts/scene/scene_day_4.rpy:9895
translate belarusian d4_polhouse_followup2_0baa9dde:

    # voice "voice/Polina/4day/72 Po.ogg"
    # Pol "Познакомься с Джоанной."
    voice "voice/Polina/4day/72 Po.ogg"
    Pol "Пазнаёмся з Джаанай."

# game/scripts/scene/scene_day_4.rpy:9903
translate belarusian d4_polhouse_followup2_d61bfd97:

    # "Я наклонился, чтобы получше рассмотреть свернувшуюся у батареи кошку."
    "Я нахіліўся, каб лепш разгледзець кошку, што згарнулася каля батарэі."

# game/scripts/scene/scene_day_4.rpy:9904
translate belarusian d4_polhouse_followup2_74fc11b4:

    # voice "voice/anton/4day/125. Pr.ogg"
    # Ant "Привет, Джоанна."
    voice "voice/anton/4day/125. Pr.ogg"
    Ant "Прывітанне, Джаана."

# game/scripts/scene/scene_day_4.rpy:9910
translate belarusian d4_polhouse_followup2_b83e12aa:

    # "Кошка ударила хвостом по ребристой батарее. Зашипела, показав клыки."
    "Кошка ўдарыла хвастом па рабрыстай батарэі. Зашыпела, паказаўшы іклы."

# game/scripts/scene/scene_day_4.rpy:9924
translate belarusian d4_polhouse_followup2_2e614c5b:

    # voice "voice/Polina/4day/73 Pro.ogg"
    # Pol "Прости, она не особо дружелюбна."
    voice "voice/Polina/4day/73 Pro.ogg"
    Pol "Прабач, яна не надта дружалюбная."

# game/scripts/scene/scene_day_4.rpy:9932
translate belarusian d4_polhouse_followup2_f2c79cd4:

    # voice "voice/anton/4day/125.K.ogg"
    # Ant "К такой реакции я привык."
    voice "voice/anton/4day/125.K.ogg"
    Ant "Да такой рэакцыі я прывык."

# game/scripts/scene/scene_day_4.rpy:9934
translate belarusian d4_polhouse_followup2_2d92707c:

    # voice "voice/anton/4day/126.Ch.ogg"
    # Ant "Что за имя — Джоанна?"
    voice "voice/anton/4day/126.Ch.ogg"
    Ant "Што за імя — Джаана?"

# game/scripts/scene/scene_day_4.rpy:9937
translate belarusian d4_polhouse_followup2_1a601426:

    # voice "voice/Polina/4day/74 Te.ogg"
    # Pol "Тебе не надоело говорить про имена?"
    voice "voice/Polina/4day/74 Te.ogg"
    Pol "Табе не надакучыла гаварыць пра імёны?"

# game/scripts/scene/scene_day_4.rpy:9942
translate belarusian d4_polhouse_followup2_3c160cce:

    # voice "voice/Polina/4day/75 D.ogg"
    # Pol "Джоанна — из сериала «{u}Элен и ребята{/u}». Смотрел?"
    voice "voice/Polina/4day/75 D.ogg"
    Pol "Джаана — з серыяла «{u}Элен і хлопцы{/u}». Глядзеў?"

# game/scripts/scene/scene_day_4.rpy:9946
translate belarusian d4_polhouse_followup2_b5a30c93:

    # "Я фыркнул."
    "Я фыркнуў."

# game/scripts/scene/scene_day_4.rpy:9947
translate belarusian d4_polhouse_followup2_0515aaef:

    # voice "voice/anton/4day/128. Et.ogg"
    # Ant "Это для девочек!"
    voice "voice/anton/4day/128. Et.ogg"
    Ant "Гэта для дзяўчынак!"

# game/scripts/scene/scene_day_4.rpy:9950
translate belarusian d4_polhouse_followup2_d0537f32:

    # voice "voice/Polina/4day/76 Oi.ogg"
    # Pol "Ой, подумаешь. Я вот и «Трансформеров» смотрю."
    voice "voice/Polina/4day/76 Oi.ogg"
    Pol "Ой, падумаеш. Я вось і «Трансформераў» гляджу."

# game/scripts/scene/scene_day_4.rpy:9953
translate belarusian d4_polhouse_followup2_1c1075b5:

    # voice "voice/anton/4day/129.Da .ogg"
    # Ant "Да ладно! Кто твой любимчик?"
    voice "voice/anton/4day/129.Da .ogg"
    Ant "Ды ну! Хто твой любімчык?"

# game/scripts/scene/scene_day_4.rpy:9956
translate belarusian d4_polhouse_followup2_18ee82ee:

    # voice "voice/Polina/4day/77 T.ogg"
    # Pol "Ты меня проверяешь? Допустим, Мегатрон."
    voice "voice/Polina/4day/77 T.ogg"
    Pol "Ты мяне правяраеш? Дапусцім, Мегатрон."

# game/scripts/scene/scene_day_4.rpy:9959
translate belarusian d4_polhouse_followup2_4c361ba3:

    # voice "voice/anton/4day/130. A.ogg"
    # Ant "Ага! А говорила, что не любишь плохих парней."
    voice "voice/anton/4day/130. A.ogg"
    Ant "Ага! А казала, што не любіш дрэнных хлопцаў."

# game/scripts/scene/scene_day_4.rpy:9962
translate belarusian d4_polhouse_followup2_64fe3156:

    # voice "voice/Polina/4day/78 Da.ogg"
    # Pol "Да, но вот ему удалось растопить моё сердечко!"
    voice "voice/Polina/4day/78 Da.ogg"
    Pol "Так, але вось яму ўдалося растапіць маё сэрцайка!"

# game/scripts/scene/scene_day_4.rpy:9965
translate belarusian d4_polhouse_followup2_4dae7dd2:

    # "Она комично схватилась за грудь."
    "Яна камічна схапілася за грудзі."

# game/scripts/scene/scene_day_4.rpy:9968
translate belarusian d4_polhouse_followup2_8f34aaf1:

    # voice "voice/anton/4day/131. tiz.ogg" 
    # Ant "Ты знала, что Оптимус и Мегатрон были друзьями и боролись вместе против руководства Кибертрона?"
    voice "voice/anton/4day/131. tiz.ogg" 
    Ant "Ты ведала, што Оптымус і Мегатрон былі сябрамі і змагаліся разам супраць кіраўніцтва Кібертрона?"

# game/scripts/scene/scene_day_4.rpy:9970
translate belarusian d4_polhouse_followup2_42ec4af4:

    # voice "voice/anton/4day/131.No .ogg"
    # Ant "Но после того, как лидером избрали Оптимуса, Мегатрон перешёл на тёмную сторону."
    voice "voice/anton/4day/131.No .ogg"
    Ant "Але пасля таго, як лідарам абралі Оптымуса, Мегатрон перайшоў на цёмны бок."

# game/scripts/scene/scene_day_4.rpy:9973
translate belarusian d4_polhouse_followup2_24acca0c:

    # voice "voice/Polina/4day/80 Bo.ogg"
    # Pol "Боюсь, что у тебя с Пятифановым повторится та же история."
    voice "voice/Polina/4day/80 Bo.ogg"
    Pol "Баюся, што ў цябе з Пяціфанавым паўторыцца тая ж гісторыя."

# game/scripts/scene/scene_day_4.rpy:9976
translate belarusian d4_polhouse_followup2_eb37d98c:

    # "Я удивлённо вскинул брови."
    "Я здзіўлена ўскінуў бровы."

# game/scripts/scene/scene_day_4.rpy:9977
translate belarusian d4_polhouse_followup2_8508f00d:

    # voice "voice/anton/4day/132. Nu.ogg"
    # Ant "Ну лидером меня никто не выбирал."
    voice "voice/anton/4day/132. Nu.ogg"
    Ant "Ну лідарам мяне ніхто не выбіраў."

# game/scripts/scene/scene_day_4.rpy:9980
translate belarusian d4_polhouse_followup2_c7ea9254:

    # voice "voice/Polina/4day/81 Do.ogg"
    # Pol "Допустим, я выбрала."
    voice "voice/Polina/4day/81 Do.ogg"
    Pol "Дапусцім, я выбрала."

# game/scripts/scene/scene_day_4.rpy:9983
translate belarusian d4_polhouse_followup2_1334e9f8:

    # "Я, кажется, снова покраснел."
    "Я, здаецца, зноў пачырванеў."

# game/scripts/scene/scene_day_4.rpy:9987
translate belarusian d4_polhouse_followup2_e72c969c:

    # "Полина села на диван, болтая изящной ножкой, и поправила покрывало."
    "Паліна села на канапу, боўтаючы вытанчанай ножкай, і паправіла пакрывала."

# game/scripts/scene/scene_day_4.rpy:10000
translate belarusian d4_polhouse_followup2_44f3ee71:

    # voice "voice/Polina/4day/02 Chem.ogg"
    # Pol "Чем займёмся?"
    voice "voice/Polina/4day/02 Chem.ogg"
    Pol "Чым зоймемся?"

# game/scripts/scene/scene_day_4.rpy:10003
translate belarusian d4_polhouse_followup2_bc0a0296:

    # "Её поза и игривый взгляд как будто загипнотизировали меня."
    "Яе поза і гуллівы позірк нібыта загіпнатызавалі мяне."

# game/scripts/scene/scene_day_4.rpy:10004
translate belarusian d4_polhouse_followup2_d9e903cd:

    # "Вдобавок приглушённый свет создавал в комнате особую, волнительную атмосферу."
    "У дадатак прыглушанае святло стварала ў пакоі асаблівую, хвалюючую атмасферу."

# game/scripts/scene/scene_day_4.rpy:10006
translate belarusian d4_polhouse_followup2_23a31fd0:

    # "В воздухе чувствовался лёгкий аромат ежевики и чего-то ещё более неуловимого и пленительного."
    "У паветры адчуваўся лёгкі водар ажын і чагосьці яшчэ больш няўлоўнага і вабнага."

# game/scripts/scene/scene_day_4.rpy:10014
translate belarusian d4_polhouse_followup2_9e9895da:

    # "Неожиданно моё привычное смущение сменилось каким-то необычайным задором."
    "Нечакана мая звыклая збянтэжанасць змянілася нейкім незвычайным запалам."

# game/scripts/scene/scene_day_4.rpy:10015
translate belarusian d4_polhouse_followup2_fb3f7f12:

    # "Хотелось красоваться и хвастаться, в общем, делать что угодно, лишь бы Полина смотрела на меня как можно дольше."
    "Хацелася красавацца і хваліцца, увогуле, рабіць што заўгодна, абы Паліна глядзела на мяне як мага даўжэй."

# game/scripts/scene/scene_day_4.rpy:10016
translate belarusian d4_polhouse_followup2_90a3ee96:

    # "Я ощущал себя этаким агентом 007, готовым вот-вот соблазнить роковую красотку одним лишь своим видом."
    "Я адчуваў сябе гэткім агентам 007, гатовым вось-вось спакусіць фатальную прыгажуню адным толькі сваім выглядам."

# game/scripts/scene/scene_day_4.rpy:10017
translate belarusian d4_polhouse_followup2_48ddbd8c:

    # "Будто подражая герою шпионских фильмов, я скрестил руки на груди и, таинственно улыбаясь, решил опереться о стену."
    "Быццам пераймаючы героя шпіёнскіх фільмаў, я скрыжаваў рукі на грудзях і, таямніча ўсміхаючыся, вырашыў абаперціся аб сцяну."

# game/scripts/scene/scene_day_4.rpy:10018
translate belarusian d4_polhouse_followup2_e53e29f5:

    # "В этот миг я сам себе казался обворожительным."
    "У гэты міг я сам сабе здаваўся чароўным."

# game/scripts/scene/scene_day_4.rpy:10029
translate belarusian d4_polhouse_followup2_27947ec8:

    # "Вот только застыть в изящной позе мне помешало бряцанье клавиш: оказывается, я не заметил открытое пианино и уселся на него."
    "Вось толькі застыць у вытанчанай позе мне перашкодзіла бразганне клавіш: аказваецца, я не заўважыў адкрытае піяніна і ўсеўся на яго."

# game/scripts/scene/scene_day_4.rpy:10036
translate belarusian d4_polhouse_followup2_71a1d0ce:

    # "Подпрыгнув от испуга чуть ли не до потолка, я растерял всё своё обаяние."
    "Падскочыўшы ад спалоху ледзь не да столі, я разгубіў усё сваё абаянне."

# game/scripts/scene/scene_day_4.rpy:10042
translate belarusian d4_polhouse_followup2_970d234b:

    # "Следом с грохотом захлопнулась крышка инструмента."
    "Следам з грукатам захлопнулася вечка інструмента."

# game/scripts/scene/scene_day_4.rpy:10047
translate belarusian d4_polhouse_followup2_69a414c2:

    # "Тут же со стула сиганула перепуганная Джоанна."
    "Тут жа з крэсла сіганула перапалоханая Джаана."

# game/scripts/scene/scene_day_4.rpy:10052
translate belarusian d4_polhouse_followup2_51cc3bff:

    # "Кошка рванула вверх по шторе, а затем, сдирая когтями стружку обоев, метнулась по стене в укрытие на шифоньере."
    "Кошка рванула ўверх па шторы, а потым, здзіраючы кіпцюрамі стружку шпалер, кінулася па сцяне ў схованку на шыфан'еры."

# game/scripts/scene/scene_day_4.rpy:10060
translate belarusian d4_polhouse_followup2_ca9829ce:

    # "К моим ногам полетели клочки изорванного постера с «Сейлор Мун», так некстати оказавшегося на пути испуганного животного."
    "Да маіх ног паляцелі шматкі разадранага постара з «Сейлар Мун», які так недарэчы апынуўся на шляху спалоханай жывёліны."

# game/scripts/scene/scene_day_4.rpy:10062
translate belarusian d4_polhouse_followup2_736a014f:

    # "И судя по взгляду Полины, плакат ей очень нравился."
    "І, мяркуючы па позірку Паліны, плакат ёй вельмі падабаўся."

# game/scripts/scene/scene_day_4.rpy:10068
translate belarusian d4_polhouse_followup2_abcc4a4e:

    # voice "voice/anton/4day/40 Pro.ogg"
    # Ant "П-прости. Я не хотел."
    voice "voice/anton/4day/40 Pro.ogg"
    Ant "П-прабач. Я не хацеў."

# game/scripts/scene/scene_day_4.rpy:10080
translate belarusian d4_polhouse_followup2_fa283724:

    # "Она закрыла глаза, губы её скривились, а лоб сморщился."
    "Яна заплюшчыла вочы, вусны яе скрывіліся, а лоб зморшчыўся."

# game/scripts/scene/scene_day_4.rpy:10081
translate belarusian d4_polhouse_followup2_d8630597:

    # "Казалось, сейчас Полина начнёт кричать или заплачет, но она просто выдохнула и совершенно спокойно сказала:"
    "Здавалася, зараз Паліна пачне крычаць ці заплача, але яна проста выдыхнула і зусім спакойна сказала:"

# game/scripts/scene/scene_day_4.rpy:10086
translate belarusian d4_polhouse_followup2_01d5be98:

    # voice "voice/Polina/4day/05Ne.ogg"
    # Pol "Не беда."
    voice "voice/Polina/4day/05Ne.ogg"
    Pol "Не бяда."

# game/scripts/scene/scene_day_4.rpy:10090
translate belarusian d4_polhouse_followup2_f1f2365c:

    # voice "voice/Polina/4day/06 Net.ogg"
    # Pol "Нет такой поломки, которую нельзя починить с помощью изоленты."
    voice "voice/Polina/4day/06 Net.ogg"
    Pol "Няма такой паломкі, якую нельга адрамантаваць з дапамогай ізаленты."

# game/scripts/scene/scene_day_4.rpy:10094
translate belarusian d4_polhouse_followup2_75a3cb8e:

    # voice "voice/Polina/4day/07 Nu.ogg"
    # Pol "Ну, в этом случае с помощью скотча."
    voice "voice/Polina/4day/07 Nu.ogg"
    Pol "Ну, у гэтым выпадку з дапамогай скотчу."

# game/scripts/scene/scene_day_4.rpy:10098
translate belarusian d4_polhouse_followup2_357bcd37:

    # voice "voice/Polina/4day/08Dav.ogg"
    # Pol "Давай помогай."
    voice "voice/Polina/4day/08Dav.ogg"
    Pol "Давай дапамагай."

# game/scripts/scene/scene_day_4.rpy:10149
translate belarusian d4_polhouse_followup2_solved_66d15447:

    # "Последний кусочек плаката лёг на своё место, и показалось, что вместе с ним в комнате воцарилась утраченная гармония."
    "Апошні кавалачак плаката лёг на сваё месца, і падалося, што разам з ім у пакоі запанавала страчаная гармонія."

# game/scripts/scene/scene_day_4.rpy:10152
translate belarusian d4_polhouse_followup2_solved_5449d1a1:

    # voice "voice/anton/4day/42 Eto.ogg"
    # Ant "Это же персонаж из «Сейлор Мун»? Сейлор Юпитер, или как там её?" id d4_polhouse_followup2_solved_5449d1a1
    voice "voice/anton/4day/42 Eto.ogg"
    Ant "Гэта ж персанаж з «Сейлар Мун»? Сейлар Юпітэр, ці як там яе?"

# game/scripts/scene/scene_day_4.rpy:10154
translate belarusian d4_polhouse_followup2_solved_d0291747:

    # voice "voice/Polina/4day/09 Da.ogg"
    # Pol "Да нет же! Это Сейлор Сатурн!"
    voice "voice/Polina/4day/09 Da.ogg"
    Pol "Ды не ж! Гэта Сейлар Сатурн!"

# game/scripts/scene/scene_day_4.rpy:10156
translate belarusian d4_polhouse_followup2_solved_abf7c889:

    # voice "voice/Polina/4day/10 EE.ogg"
    # Pol "Её зовут Хотару, она воин разрушения, который, вместо того, чтобы уничтожить мир, спасла его."
    voice "voice/Polina/4day/10 EE.ogg"
    Pol "Яе завуць Хатару, яна воін разбурэння, які, замест таго, каб знішчыць свет, выратавала яго."

# game/scripts/scene/scene_day_4.rpy:10158
translate belarusian d4_polhouse_followup2_solved_d8082bbb:

    # voice "voice/Polina/4day/11 Mne.ogg"
    # Pol "Мне она всегда больше всех нравилась!"
    voice "voice/Polina/4day/11 Mne.ogg"
    Pol "Мне яна заўсёды больш за ўсіх падабалася!"

# game/scripts/scene/scene_day_4.rpy:10160
translate belarusian d4_polhouse_followup2_solved_b5ebdf04:

    # voice "voice/Polina/4day/12 Vot.ogg"
    # Pol "Во-о-от... А ещё у неё раздвоение личности, представляешь?"
    voice "voice/Polina/4day/12 Vot.ogg"
    Pol "Во-о-ось... А яшчэ ў яе раздваенне асобы, уяўляеш?"

# game/scripts/scene/scene_day_4.rpy:10162
translate belarusian d4_polhouse_followup2_solved_4c8b2a97:

    # voice "voice/Polina/4day/13 Po.ogg"
    # Pol "По крайней мере, было. Джоанна порвала её на дюжину личностей, не меньше!"
    voice "voice/Polina/4day/13 Po.ogg"
    Pol "Прынамсі, было. Джаана парвала яе на тузін асоб, не менш!"

# game/scripts/scene/scene_day_4.rpy:10167
translate belarusian d4_polhouse_followup2_solved_3bf1308d:

    # "Я посмотрел на Полину и осторожно спросил:"
    "Я паглядзеў на Паліну і асцярожна спытаў:"

# game/scripts/scene/scene_day_4.rpy:10168
translate belarusian d4_polhouse_followup2_solved_c7771044:

    # voice "voice/anton/4day/133. Ra.ogg"
    # Ant "Расскажи, как проходят твои вечера?" id d4_polhouse_followup2_solved_c7771044
    voice "voice/anton/4day/133. Ra.ogg"
    Ant "Раскажы, як праходзяць твае вечары?"

# game/scripts/scene/scene_day_4.rpy:10171
translate belarusian d4_polhouse_followup2_solved_14a1dd5f:

    # "Полина пожала плечами, приняв скучающий вид."
    "Паліна паціснула плячыма, прыняўшы знуджаны выгляд."

# game/scripts/scene/scene_day_4.rpy:10173
translate belarusian d4_polhouse_followup2_solved_088813c9:

    # voice "voice/Polina/4day/83 Sm.ogg"
    # Pol "Смотрю телевизор или играю дедушке на скрипке."
    voice "voice/Polina/4day/83 Sm.ogg"
    Pol "Гляджу тэлевізар ці іграю дзядулю на скрыпцы."

# game/scripts/scene/scene_day_4.rpy:10178
translate belarusian d4_polhouse_followup2_solved_530eb663:

    # voice "voice/Polina/4day/84 On.ogg"
    # Pol "Он планирует сделать из меня {u}Давида Ойстраха{/u}."
    voice "voice/Polina/4day/84 On.ogg"
    Pol "Ён плануе зрабіць з мяне {u}Давіда Ойстраха{/u}."

# game/scripts/scene/scene_day_4.rpy:10181
translate belarusian d4_polhouse_followup2_solved_b998c81c:

    # voice "voice/anton/4day/134. Ko.ogg"
    # Ant "Кого?"
    voice "voice/anton/4day/134. Ko.ogg"
    Ant "Каго?"

# game/scripts/scene/scene_day_4.rpy:10184
translate belarusian d4_polhouse_followup2_solved_be98040d:

    # voice "voice/Polina/4day/85 Sk.ogg"
    # Pol "Скрипач был такой великий."
    voice "voice/Polina/4day/85 Sk.ogg"
    Pol "Скрыпач быў такі вялікі."

# game/scripts/scene/scene_day_4.rpy:10187
translate belarusian d4_polhouse_followup2_solved_1c83b9be:

    # voice "voice/anton/4day/135. Ati.ogg"
    # Ant "А ты что же, сама не хочешь играть?"
    voice "voice/anton/4day/135. Ati.ogg"
    Ant "А ты што ж, сама не хочаш іграць?"

# game/scripts/scene/scene_day_4.rpy:10190
translate belarusian d4_polhouse_followup2_solved_6ae7ffd5:

    # voice "voice/Polina/4day/86 Po.ogg"
    # Pol "Почему? Хочу."
    voice "voice/Polina/4day/86 Po.ogg"
    Pol "Чаму? Хачу."

# game/scripts/scene/scene_day_4.rpy:10194
translate belarusian d4_polhouse_followup2_solved_3c096a75:

    # voice "voice/Polina/4day/87 Eto.ogg"
    # Pol "Это мой шанс уехать в город и начать нормальную жизнь."
    voice "voice/Polina/4day/87 Eto.ogg"
    Pol "Гэта мой шанец з'ехаць у горад і пачаць нармальнае жыццё."

# game/scripts/scene/scene_day_4.rpy:10198
translate belarusian d4_polhouse_followup2_solved_228288e8:

    # voice "voice/Polina/4day/88 Ga.ogg"
    # Pol "Гастролировать по странам, знакомиться с новыми людьми."
    voice "voice/Polina/4day/88 Ga.ogg"
    Pol "Гастраляваць па краінах, знаёміцца з новымі людзьмі."

# game/scripts/scene/scene_day_4.rpy:10202
translate belarusian d4_polhouse_followup2_solved_586cb9ca:

    # "От её слов я ощутил укол дурацкой ревности."
    "Ад яе слоў я адчуў укол дурной рэўнасці."

# game/scripts/scene/scene_day_4.rpy:10204
translate belarusian d4_polhouse_followup2_solved_d718df22:

    # voice "voice/anton/4day/136. Po.ogg"
    # Ant "Поиграешь для меня?"
    voice "voice/anton/4day/136. Po.ogg"
    Ant "Паіграеш для мяне?"

# game/scripts/scene/scene_day_4.rpy:10208
translate belarusian d4_polhouse_followup2_solved_a4340c00:

    # voice "voice/Polina/4day/89 Ti.ogg"
    # Pol "Ты точно этого хочешь?"
    voice "voice/Polina/4day/89 Ti.ogg"
    Pol "Ты дакладна гэтага хочаш?"

# game/scripts/scene/scene_day_4.rpy:10211
translate belarusian d4_polhouse_followup2_solved_f8ee852c:

    # voice "voice/anton/4day/137. Oche.ogg"
    # Ant "Очень!"
    voice "voice/anton/4day/137. Oche.ogg"
    Ant "Вельмі!"

# game/scripts/scene/scene_day_4.rpy:10214
translate belarusian d4_polhouse_followup2_solved_ce5011b2:

    # voice "voice/Polina/4day/90 Hor.ogg"
    # Pol "Хорошо... Только учти: я сегодня не в форме."
    voice "voice/Polina/4day/90 Hor.ogg"
    Pol "Добра... Толькі ўлічы: я сёння не ў форме."

# game/scripts/scene/scene_day_4.rpy:10220
translate belarusian d4_polhouse_followup2_solved_9eb47e57:

    # "Она извлекла скрипку из футляра. Лак переливался в свете лампы."
    "Яна дастала скрыпку з футарала. Лак пераліваўся ў святле лямпы."

# game/scripts/scene/scene_day_4.rpy:10223
translate belarusian d4_polhouse_followup2_solved_dc9eaa41:

    # voice "voice/Polina/4day/91 Et.ogg"
    # Pol "Это не обычная скрипка."
    voice "voice/Polina/4day/91 Et.ogg"
    Pol "Гэта не звычайная скрыпка."

# game/scripts/scene/scene_day_4.rpy:10227
translate belarusian d4_polhouse_followup2_solved_8a5115ac:

    # voice "voice/Polina/4day/92 Ee.ogg"
    # Pol "Её смастерил в семнадцатом веке скрипичных дел мастер Гварнери, а сам Ойстрах дал на ней первый концерт."
    voice "voice/Polina/4day/92 Ee.ogg"
    Pol "Яе змайстраваў у сямнаццатым стагоддзі скрыпічных спраў майстар Гварнеры, а сам Ойстрах даў на ёй першы канцэрт."

# game/scripts/scene/scene_day_4.rpy:10230
translate belarusian d4_polhouse_followup2_solved_5907c3c2:

    # voice "voice/anton/4day/138. Ona.ogg"
    # Ant "Она дорогая?"
    voice "voice/anton/4day/138. Ona.ogg"
    Ant "Яна дарагая?"

# game/scripts/scene/scene_day_4.rpy:10233
translate belarusian d4_polhouse_followup2_solved_c8ea64d3:

    # voice "voice/Polina/4day/93 Nu.ogg"
    # Pol "Ну, пару миллионов долларов стоит."
    voice "voice/Polina/4day/93 Nu.ogg"
    Pol "Ну, пару мільёнаў долараў каштуе."

# game/scripts/scene/scene_day_4.rpy:10236
translate belarusian d4_polhouse_followup2_solved_691361d8:

    # "У меня отвисла челюсть. Полина рассмеялась."
    "У мяне адвісла сківіца. Паліна рассмяялася."

# game/scripts/scene/scene_day_4.rpy:10249
translate belarusian d4_polhouse_followup2_solved_d207d23b:

    # voice "voice/Polina/4day/94 Vi.ogg"
    # Pol "Видел бы ты своё лицо!"
    voice "voice/Polina/4day/94 Vi.ogg"
    Pol "Бачыў бы ты свой твар!"

# game/scripts/scene/scene_day_4.rpy:10253
translate belarusian d4_polhouse_followup2_solved_51198c38:

    # voice "voice/Polina/4day/95 Ya.ogg"
    # Pol "Я шучу! Копейки она стоит."
    voice "voice/Polina/4day/95 Ya.ogg"
    Pol "Я жартую! Капейкі яна каштуе."

# game/scripts/scene/scene_day_4.rpy:10257
translate belarusian d4_polhouse_followup2_solved_d4b1420e:

    # voice "voice/Polina/4day/96 E.ogg"
    # Pol "Если бы у меня была скрипка Гварнери, я бы жила в Москве."
    voice "voice/Polina/4day/96 E.ogg"
    Pol "Калі б у мяне была скрыпка Гварнеры, я б жыла ў Маскве."

# game/scripts/scene/scene_day_4.rpy:10260
translate belarusian d4_polhouse_followup2_solved_5c98f4c9:

    # voice "voice/anton/4day/139. A.ogg"
    # Ant "А я и не повёлся!"
    voice "voice/anton/4day/139. A.ogg"
    Ant "А я і не павёўся!"

# game/scripts/scene/scene_day_4.rpy:10263
translate belarusian d4_polhouse_followup2_solved_781bd6d1:

    # voice "voice/Polina/4day/97 Ko.ogg"
    # Pol "Конечно-конечно."
    voice "voice/Polina/4day/97 Ko.ogg"
    Pol "Вядома-вядома."

# game/scripts/scene/scene_day_4.rpy:10271
translate belarusian d4_polhouse_followup2_solved_09c6b58a:

    # "Полина приняла нужную позу, зажала скрипку между плечом и скулой. Поднесла смычок."
    "Паліна прыняла патрэбную позу, заціснула скрыпку паміж плячом і сківіцай. Паднесла смычок."

# game/scripts/scene/scene_day_4.rpy:10272
translate belarusian d4_polhouse_followup2_solved_1e586011:

    # voice "voice/Polina/4day/98 Fa.ogg"
    # Pol "Фа диез минор."
    voice "voice/Polina/4day/98 Fa.ogg"
    Pol "Фа дыез мінор."

# game/scripts/scene/scene_day_4.rpy:10296
translate belarusian d4_polhouse_followup2_solved_0c2d3cd0:

    # "Смычок скользнул по струнам — и музыка наполнила комнату, насытила собой воздух."
    "Смычок слізгануў па струнах — і музыка напоўніла пакой, насыціла сабой паветра."

# game/scripts/scene/scene_day_4.rpy:10297
translate belarusian d4_polhouse_followup2_solved_7961d7fd:

    # "Я присел на подоконник, восторгаясь силой мелодии."
    "Я прысеў на падаконнік, захапляючыся сілай мелодыі."

# game/scripts/scene/scene_day_4.rpy:10298
translate belarusian d4_polhouse_followup2_solved_39ace428:

    # "Как грациозно играла Полина!"
    "Як грацыёзна іграла Паліна!"

# game/scripts/scene/scene_day_4.rpy:10299
translate belarusian d4_polhouse_followup2_solved_30a51d99:

    # "Смычок буквально летал, разрезая пространство и время."
    "Смычок літаральна лётаў, разразаючы прастору і час."

# game/scripts/scene/scene_day_4.rpy:10300
translate belarusian d4_polhouse_followup2_solved_b3549926:

    # "Длинные пальцы перемещались с невероятной скоростью. Призрачная улыбка теплилась на губах скрипачки."
    "Доўгія пальцы перамяшчаліся з неверагоднай хуткасцю. Прывідная ўсмешка цеплілася на вуснах скрыпачкі."

# game/scripts/scene/scene_day_4.rpy:10301
translate belarusian d4_polhouse_followup2_solved_625dec05:

    # "Казалось, музыка, этот таинственный фа диез минор, – ветер, ворвавшийся в дом, принёсший запах моря и далёких городов."
    "Здавалася, музыка, гэты таямнічы фа дыез мінор, — вецер, які ўварваўся ў дом і прынёс пах мора і далёкіх гарадоў."

# game/scripts/scene/scene_day_4.rpy:10302
translate belarusian d4_polhouse_followup2_solved_8687d58f:

    # "И при его порывах я задыхался от восторга."
    "І пры яго парывах я задыхаўся ад захаплення."

# game/scripts/scene/scene_day_4.rpy:10303
translate belarusian d4_polhouse_followup2_solved_0e5c8270:

    # "Мелодия подняла меня до небес, заставив вспомнить ночные прыжки над лесом."
    "Мелодыя падняла мяне да нябёсаў, прымусіўшы ўспомніць начныя скачкі над лесам."

# game/scripts/scene/scene_day_4.rpy:10316
translate belarusian d4_polhouse_followup2_solved_26e91b75:

    # "Но, как и всё хорошее, она закончилась слишком быстро."
    "Але, як і ўсё добрае, яна скончылася занадта хутка."

# game/scripts/scene/scene_day_4.rpy:10318
translate belarusian d4_polhouse_followup2_solved_ee0facbe:

    # "Полина замерла, опустила руку и поклонилась. Качнулся водопад благоухающих волос."
    "Паліна замерла, апусціла руку і пакланілася. Калыхнуўся вадаспад духмяных валасоў."

# game/scripts/scene/scene_day_4.rpy:10331
translate belarusian d4_polhouse_followup2_solved_cec4d6af:

    # "Я вскочил, захлопав в ладоши."
    "Я ўскочыў, запляскаўшы ў далоні."

# game/scripts/scene/scene_day_4.rpy:10339
translate belarusian d4_polhouse_followup2_solved_e73369fd:

    # voice "voice/anton/4day/140. Br.ogg"
    # Ant "Браво! Кто это сочинил?"
    voice "voice/anton/4day/140. Br.ogg"
    Ant "Брава! Хто гэта склаў?"

# game/scripts/scene/scene_day_4.rpy:10342
translate belarusian d4_polhouse_followup2_solved_fbfaf639:

    # voice "voice/Polina/4day/100 Rob.ogg"
    # Pol "Роберт Шуман."
    voice "voice/Polina/4day/100 Rob.ogg"
    Pol "Роберт Шуман."

# game/scripts/scene/scene_day_4.rpy:10355
translate belarusian d4_polhouse_followup2_solved_67ea9b26:

    # voice "voice/anton/4day/141. Vot.ogg"
    # Ant "Вот кто теперь мой любимый композитор! Бра..."
    voice "voice/anton/4day/141. Vot.ogg"
    Ant "Вось хто цяпер мой любімы кампазітар! Бра..."

# game/scripts/scene/scene_day_4.rpy:10365
translate belarusian d4_polhouse_followup2_solved_8322de20:

    # "Слог «во» стал возгласом изумления, когда что-то яростно взвыло под моей ногой."
    "Склад «ва» стаў воклічам здзіўлення, калі нешта люта завыла пад маёй нагой."

# game/scripts/scene/scene_day_4.rpy:10401
translate belarusian d4_polhouse_followup2_solved_f20c5af0:

    # "Джоанна!"
    "Джаана!"

# game/scripts/scene/scene_day_4.rpy:10416
translate belarusian d4_polhouse_followup2_solved_6cd269aa:

    # "В порыве восхищения я позабыл про кошку и нечаянно наступил ей на хвост."
    "У парыве захаплення я забыўся пра котку і незнарок наступіў ёй на хвост."

# game/scripts/scene/scene_day_4.rpy:10426
translate belarusian d4_polhouse_followup2_solved_919a4fcf:

    # "Я не успел озвучить слова извинений."
    "Я не паспеў агучыць словы прабачэння."

# game/scripts/scene/scene_day_4.rpy:10435
translate belarusian d4_polhouse_followup2_solved_7e361cc9:

    # "Джоанна взвилась по моей ноге и вцепилась в бедро. Сквозь штанины острые когти пронзили кожу."
    "Джаана ўзвілася па маёй назе і ўчапілася ў сцягно. Скрозь калашыны вострыя кіпцюры працялі скуру."

# game/scripts/scene/scene_day_4.rpy:10444
translate belarusian d4_polhouse_followup2_solved_f7d47d9a:

    # voice "voice/anton/4day/142. Ai.ogg"
    # Ant "Ай-ай!"
    voice "voice/anton/4day/142. Ai.ogg"
    Ant "Ай-ай!"

# game/scripts/scene/scene_day_4.rpy:10456
translate belarusian d4_polhouse_followup2_solved_c99f2533:

    # "Полина кинулась на помощь, шлёпнула кошку по загривку."
    "Паліна кінулася на дапамогу, шлёпнула котку па загрыўку."

# game/scripts/scene/scene_day_4.rpy:10464
translate belarusian d4_polhouse_followup2_solved_ea3113bc:

    # voice "voice/Polina/4day/101 D.ogg"
    # Pol "Джоанна, гадость какая, брысь!"
    voice "voice/Polina/4day/101 D.ogg"
    Pol "Джаана, брыдота якая, брысь!"

# game/scripts/scene/scene_day_4.rpy:10470
translate belarusian d4_polhouse_followup2_solved_f9fb7489:

    # "Кошка сиганула на ковёр и ретировалась из комнаты, лапой отворив дверь."
    "Котка сіганула на дыван і рэтыравалася з пакоя, лапай адчыніўшы дзверы."

# game/scripts/scene/scene_day_4.rpy:10476
translate belarusian d4_polhouse_followup2_solved_2ab3ddb3:

    # "Я морщился, трогая бедро, явно хорошенько расцарапанное."
    "Я моршчыўся, кранаючы сцягно, яўна як след падрапанае."

# game/scripts/scene/scene_day_4.rpy:10479
translate belarusian d4_polhouse_followup2_solved_da37089e:

    # "Полина сочувственно приобняла меня."
    "Паліна спачувальна прыабняла мяне."

# game/scripts/scene/scene_day_4.rpy:10491
translate belarusian d4_polhouse_followup2_solved_5ad5bb3e:

    # voice "voice/Polina/4day/Bolno.ogg"
    # Pol "Больно?"
    voice "voice/Polina/4day/Bolno.ogg"
    Pol "Балюча?"

# game/scripts/scene/scene_day_4.rpy:10494
translate belarusian d4_polhouse_followup2_solved_9399d2b3:

    # voice "voice/anton/4day/143. Da.ogg"
    # Ant "Да так... Я сам виноват."
    voice "voice/anton/4day/143. Da.ogg"
    Ant "Ды так... Я сам вінаваты."

# game/scripts/scene/scene_day_4.rpy:10497
translate belarusian d4_polhouse_followup2_solved_d04eea9c:

    # voice "voice/Polina/4day/102 Ya.ogg"
    # Pol "Ой, я ей покажу, как бросаться на моих гостей!"
    voice "voice/Polina/4day/102 Ya.ogg"
    Pol "Ой, я ёй пакажу, як кідацца на маіх гасцей!"

# game/scripts/scene/scene_day_4.rpy:10505
translate belarusian d4_polhouse_followup2_solved_f1e9bf87:

    # "Меня волновала не столько боль, сколько ущерб, нанесённый одежде. Мелкие дырочки испещрили штаны."
    "Мяне хваляваў не столькі боль, колькі шкода, нанесеная адзенню. Дробныя дзірачкі ўсеялі штаны."

# game/scripts/scene/scene_day_4.rpy:10506
translate belarusian d4_polhouse_followup2_solved_ee7420ee:

    # "М-да. Мама будет счастлива."
    "М-да. Мама будзе шчаслівая."

# game/scripts/scene/scene_day_4.rpy:10507
translate belarusian d4_polhouse_followup2_solved_e217f887:

    # "Но внимание Полины мне польстило."
    "Але ўвага Паліны мяне пацешыла."

# game/scripts/scene/scene_day_4.rpy:10508
translate belarusian d4_polhouse_followup2_solved_bc2d0299:

    # voice "voice/anton/4day/144.Tv .ogg"
    # Ant "Твоя Джоанна – дама с характером."
    voice "voice/anton/4day/144.Tv .ogg"
    Ant "Твая Джаана — дама з характарам."

# game/scripts/scene/scene_day_4.rpy:10517
translate belarusian d4_polhouse_followup2_solved_e1f6465e:

    # voice "voice/Polina/4day/103 Vi.ogg"
    # Pol "Вы поладите."
    voice "voice/Polina/4day/103 Vi.ogg"
    Pol "Вы паладзіце."

# game/scripts/scene/scene_day_4.rpy:10521
translate belarusian d4_polhouse_followup2_solved_14b68f1c:

    # voice "voice/Polina/4day/104 Es.ogg"
    # Pol "Если ты не умрёшь от потери крови, конечно."
    voice "voice/Polina/4day/104 Es.ogg"
    Pol "Калі ты не памрэш ад страты крыві, вядома."

# game/scripts/scene/scene_day_4.rpy:10524
translate belarusian d4_polhouse_followup2_solved_2651960c:

    # "Она повертелась, осматривая комнату."
    "Яна пакруцілася, аглядаючы пакой."

# game/scripts/scene/scene_day_4.rpy:10546
translate belarusian d4_polhouse_followup2_solved_d6acc62a:

    # voice "voice/Polina/4day/105 Gd.ogg"
    # Pol "Где-то тут был йод."
    voice "voice/Polina/4day/105 Gd.ogg"
    Pol "Дзесьці тут быў ёд."

# game/scripts/scene/scene_day_4.rpy:10548
translate belarusian d4_polhouse_followup2_solved_7c108de9:

    # voice "voice/anton/4day/145. Ne.ogg"
    # Ant "Необязательно..."
    voice "voice/anton/4day/145. Ne.ogg"
    Ant "Неабавязкова..."

# game/scripts/scene/scene_day_4.rpy:10550
translate belarusian d4_polhouse_followup2_solved_4f5cc6eb:

    # voice "voice/Polina/4day/106 Ch.ogg"
    # Pol "Что значит «необязательно»?"
    voice "voice/Polina/4day/106 Ch.ogg"
    Pol "Што значыць «неабавязкова»?"

# game/scripts/scene/scene_day_4.rpy:10553
translate belarusian d4_polhouse_followup2_solved_bf8cb095:

    # voice "voice/Polina/4day/107 Esh.ogg"
    # Pol "Ещё никто не умирал в моей спальне. И я хочу, чтобы так продолжалось впредь."
    voice "voice/Polina/4day/107 Esh.ogg"
    Pol "Яшчэ ніхто не паміраў у маёй спальні. І я хачу, каб так працягвалася надалей."

# game/scripts/scene/scene_day_4.rpy:10556
translate belarusian d4_polhouse_followup2_solved_f80fa462:

    # voice "voice/Polina/4day/108 Sn.ogg"
    # Pol "Снимай пока штаны."
    voice "voice/Polina/4day/108 Sn.ogg"
    Pol "Здымай пакуль штаны."

# game/scripts/scene/scene_day_4.rpy:10583
translate belarusian d4_polhouse_followup2_solved_15565d3c:

    # "Я вообразил себя перед Полиной в одних трусах."
    "Я ўявіў сябе перад Палінай у адных трусах."

# game/scripts/scene/scene_day_4.rpy:10584
translate belarusian d4_polhouse_followup2_solved_e3756644:

    # "Как она, нагнувшись, обрабатывает рану. Образ окатил горячим паром."
    "Як яна, нагнуўшыся, апрацоўвае рану. Вобраз абдаў гарачай парай."

# game/scripts/scene/scene_day_4.rpy:10592
translate belarusian d4_polhouse_followup2_solved_f2f1564d:

    # voice "voice/anton/4day/145. Nen.ogg"
    # Ant "Не надо, Полин. Ну правда."
    voice "voice/anton/4day/145. Nen.ogg"
    Ant "Не трэба, Палін. Ну праўда."

# game/scripts/scene/scene_day_4.rpy:10598
translate belarusian d4_polhouse_followup2_solved_a983db6b:

    # "Не слушая меня, она смочила вату коричневатой жидкостью из пахучего флакончика."
    "Не слухаючы мяне, яна намачыла вату карычняватай вадкасцю з пахучага флакончыка."

# game/scripts/scene/scene_day_4.rpy:10604
translate belarusian d4_polhouse_followup2_solved_d092f618:

    # voice "voice/Polina/4day/109 Pa.ogg"
    # Pol "Пациент, я готова. Спускайте."
    voice "voice/Polina/4day/109 Pa.ogg"
    Pol "Пацыент, я гатова. Спускайце."

# game/scripts/scene/scene_day_4.rpy:10607
translate belarusian d4_polhouse_followup2_solved_c0113c6f:

    # voice "voice/anton/4day/146. Se.ogg"
    # Ant "С-серьёзно. Дома промою..."
    voice "voice/anton/4day/146. Se.ogg"
    Ant "С-сур'ёзна. Дома прамыю..."

# game/scripts/scene/scene_day_4.rpy:10611
translate belarusian d4_polhouse_followup2_solved_6115cee3:

    # "Улыбка стёрлась с её красивых губ. Вертикальная морщинка рассекла переносицу. В голосе появились капризные нотки."
    "Усмешка сцерлася з яе прыгожых вуснаў. Вертыкальная зморшчынка рассекла пераноссе. У голасе з'явіліся капрызныя ноткі."

# game/scripts/scene/scene_day_4.rpy:10613
translate belarusian d4_polhouse_followup2_solved_bc9dbcb0:

    # voice "voice/Polina/4day/110 P.ogg"
    # Pol "Перестань сопротивляться. Дай я тебе помогу."
    voice "voice/Polina/4day/110 P.ogg"
    Pol "Перастань супраціўляцца. Дай я табе дапамагу."

# game/scripts/scene/scene_day_4.rpy:10616
translate belarusian d4_polhouse_followup2_solved_d859306a:

    # "Она погладила меня значительно ниже раны."
    "Яна пагладзіла мяне значна ніжэй за рану."

# game/scripts/scene/scene_day_4.rpy:10618
translate belarusian d4_polhouse_followup2_solved_bbbaabf6:

    # voice "voice/Polina/4day/111 De.ogg"
    # Pol "Девочкам нельзя отказывать."
    voice "voice/Polina/4day/111 De.ogg"
    Pol "Дзяўчынкам нельга адмаўляць."

# game/scripts/scene/scene_day_4.rpy:10634
translate belarusian d4_polhouse_followup2_solved_b1c4b783:

    # "Полина решительно шагнула вперёд и схватилась за пряжку ремня."
    "Паліна рашуча ступіла наперад і схапілася за спражку рэменя."

# game/scripts/scene/scene_day_4.rpy:10644
translate belarusian d4_polhouse_followup2_solved_fb8cd535:

    # "Я увернулся, но не тут-то было."
    "Я ўхіліўся, але дзе там."

# game/scripts/scene/scene_day_4.rpy:10655
translate belarusian d4_polhouse_followup2_solved_ed4fafce:

    # "Девочка очутилась сзади. Поддела ремень пальцами, попробовала стащить штаны."
    "Дзяўчынка апынулася ззаду. Падчапіла рэмень пальцамі, паспрабавала сцягнуць штаны."

# game/scripts/scene/scene_day_4.rpy:10671
translate belarusian d4_polhouse_followup2_solved_06c80266:

    # voice "voice/anton/4day/147. Ah.ogg"
    # Ant "Ах ты ж!"
    voice "voice/anton/4day/147. Ah.ogg"
    Ant "Ах ты ж!"

# game/scripts/scene/scene_day_4.rpy:10674
translate belarusian d4_polhouse_followup2_solved_20f32dda:

    # "Она захихикала."
    "Яна захіхікала."

# game/scripts/scene/scene_day_4.rpy:10685
translate belarusian d4_polhouse_followup2_solved_b7b0bf83:

    # "Я крутанулся, и Полина прижалась ко мне, заливаясь смехом."
    "Я крутануўся, і Паліна прыціснулася да мяне, заліваючыся смехам."

# game/scripts/scene/scene_day_4.rpy:10700
translate belarusian d4_polhouse_followup2_solved_8b37ae41:

    # "Легонько прикусила мою руку, дёрнула за ремень."
    "Злёгку прыкусіла маю руку, тузанула за рэмень."

# game/scripts/scene/scene_day_4.rpy:10722
translate belarusian d4_polhouse_followup2_solved_26f11cd6:

    # "Отступая, я врезался в диван и упал плашмя на его мягкую поверхность. Полина приземлилась сверху."
    "Адступаючы, я ўрэзаўся ў канапу і ўпаў плазам на яе мяккую паверхню. Паліна прызямлілася зверху."

# game/scripts/scene/scene_day_4.rpy:10739
translate belarusian d4_polhouse_followup2_solved_c1aa79a9:

    # "Волосы накрыли моё лицо, защекотали ноздри."
    "Валасы накрылі мой твар, заказыталі ноздры."

# game/scripts/scene/scene_day_4.rpy:10744
translate belarusian d4_polhouse_followup2_solved_b4215656:

    # "Я ощущал, как вибрирует грудная клетка смеющейся Полины."
    "Я адчуваў, як ад смеху вібрыруе грудная клетка Паліны."

# game/scripts/scene/scene_day_4.rpy:10746
translate belarusian d4_polhouse_followup2_solved_3b7f4bf5:

    # "А ещё я чувствовал сквозняк голой кожей бёдер."
    "А яшчэ я адчуваў скразняк голай скурай сцёгнаў."

# game/scripts/scene/scene_day_4.rpy:10749
translate belarusian d4_polhouse_followup2_solved_eb3b2e80:

    # "Ей таки удалось стянуть с меня штаны: я лежал под ней частично нагим и сгорал от смущения."
    "Ёй такі ўдалося сцягнуць з мяне штаны: я ляжаў пад ёй часткова аголеным і згараў ад збянтэжанасці."

# game/scripts/scene/scene_day_4.rpy:10762
translate belarusian d4_polhouse_followup2_solved_6b9f8ff6:

    # "Полина отстранилась. Смех затих."
    "Паліна адхінулася. Смех сціх."

# game/scripts/scene/scene_day_4.rpy:10767
translate belarusian d4_polhouse_followup2_solved_d9b70403:

    # "Она сдула прядь волос и заглянула в мои глаза."
    "Яна здзьмула пасму валасоў і зазірнула ў мае вочы."

# game/scripts/scene/scene_day_4.rpy:10768
translate belarusian d4_polhouse_followup2_solved_d391a2aa:

    # "Уперев кулачок в щёку, прошла задумчивым взглядом по моему лицу."
    "Упёршы кулачок у шчаку, прайшлася задуменным позіркам па маім твары."

# game/scripts/scene/scene_day_4.rpy:10769
translate belarusian d4_polhouse_followup2_solved_be1344b4:

    # voice "voice/anton/4day/148. Ti.ogg"
    # Ant "Ты чего?"
    voice "voice/anton/4day/148. Ti.ogg"
    Ant "Ты чаго?"

# game/scripts/scene/scene_day_4.rpy:10773
translate belarusian d4_polhouse_followup2_solved_7d89b518:

    # voice "voice/Polina/4day/113 Ni.ogg" 
    # Pol "Ничего. Красивый ты."
    voice "voice/Polina/4day/113 Ni.ogg" 
    Pol "Нічога. Прыгожы ты."

# game/scripts/scene/scene_day_4.rpy:10776
translate belarusian d4_polhouse_followup2_solved_e5ea81cc:

    # voice "voice/anton/4day/149. Sk.ogg"
    # Ant "Скажешь тоже."
    voice "voice/anton/4day/149. Sk.ogg"
    Ant "Скажаш такое."

# game/scripts/scene/scene_day_4.rpy:10779
translate belarusian d4_polhouse_followup2_solved_cd73fddc:

    # voice "voice/Polina/4day/114 Che.ogg" 
    # Pol "Честно-честно."
    voice "voice/Polina/4day/114 Che.ogg" 
    Pol "Праўда-праўда."

# game/scripts/scene/scene_day_4.rpy:10783
translate belarusian d4_polhouse_followup2_solved_2868e493:

    # voice "voice/Polina/4day/115 E.ogg" 
    # Pol "И знаешь, мне кажется, что я все эти годы ждала, когда ты в посёлок приедешь."
    voice "voice/Polina/4day/115 E.ogg" 
    Pol "І ведаеш, мне здаецца, што я ўсе гэтыя гады чакала, калі ты ў пасёлак прыедзеш."

# game/scripts/scene/scene_day_4.rpy:10789
translate belarusian d4_polhouse_followup2_solved_6065c27c:

    # "Моё сердце выстукивало бешеный ритм: под рёбрами, в висках, по всему телу."
    "Маё сэрца выстуквала шалёны рытм: пад рэбрамі, у скронях, па ўсім целе."

# game/scripts/scene/scene_day_4.rpy:10790
translate belarusian d4_polhouse_followup2_solved_baaf9502:

    # "Я забыл, что лежу под ней без штанов и трусь голым бедром об её ногу."
    "Я забыў, што ляжу пад ёй без штаноў і труся голым сцягном аб яе нагу."

# game/scripts/scene/scene_day_4.rpy:10792
translate belarusian d4_polhouse_followup2_solved_4f61e1a3:

    # voice "voice/anton/4day/150. Mne.ogg"
    # Ant "Мне хорошо с тобой."
    voice "voice/anton/4day/150. Mne.ogg"
    Ant "Мне добра з табой."

# game/scripts/scene/scene_day_4.rpy:10795
translate belarusian d4_polhouse_followup2_solved_3fa1f655:

    # voice "voice/Polina/4day/116 Em.ogg" 
    # Pol "И мне."
    voice "voice/Polina/4day/116 Em.ogg" 
    Pol "І мне."

# game/scripts/scene/scene_day_4.rpy:10799
translate belarusian d4_polhouse_followup2_solved_0b6e0901:

    # voice "voice/Polina/4day/117 Ya.ogg"
    # Pol "Я встретила человека, который меня понимает."
    voice "voice/Polina/4day/117 Ya.ogg"
    Pol "Я сустрэла чалавека, які мяне разумее."

# game/scripts/scene/scene_day_4.rpy:10803
translate belarusian d4_polhouse_followup2_solved_f7a5e022:

    # voice "voice/Polina/4day/118 Eto.ogg"
    # Pol "Это дороже скрипки Гварнери."
    voice "voice/Polina/4day/118 Eto.ogg"
    Pol "Гэта даражэй за скрыпку Гварнеры."

# game/scripts/scene/scene_day_4.rpy:10806
translate belarusian d4_polhouse_followup2_solved_4acdae70:

    # "Я переместил взгляд на её рот."
    "Я перавёў позірк на яе рот."

# game/scripts/scene/scene_day_4.rpy:10807
translate belarusian d4_polhouse_followup2_solved_21c12443:

    # "Он был так близко, что я видел каждую крошечную морщинку на пересохших, как и у меня, губах."
    "Ён быў так блізка, што я бачыў кожную драбнюткую зморшчынку на перасохлых, як і ў мяне, вуснах."

# game/scripts/scene/scene_day_4.rpy:10834
translate belarusian d4_polhouse_choice_kiss_66efc532:

    # "Полина опустила веки. Затрепетали ресницы."
    "Паліна апусціла павекі. Затрымцелі вейкі."

# game/scripts/scene/scene_day_4.rpy:10844
translate belarusian d4_polhouse_choice_kiss_8a382e0e:

    # "Наши губы соприкоснулись."
    "Нашы вусны датыкнуліся."

# game/scripts/scene/scene_day_4.rpy:10868
translate belarusian d4_polhouse_choice_kiss_fa8dae24:

    # "Голова закружилась. Померещилось, что я падаю в пропасть."
    "Галава закружылася. Прымроілася, што я падаю ў прорву."

# game/scripts/scene/scene_day_4.rpy:10873
translate belarusian d4_polhouse_choice_kiss_3c7cc0fe:

    # "Каждая клеточка моего тела пела от восторга, словно я пробовал на вкус прекраснейшую музыку, но дегустировал нечто более совершенное, чем мелодия Шумана."
    "Кожная клетачка майго цела спявала ад захаплення, нібы я каштаваў на смак найцудоўнейшую музыку, але дэгуставаў нешта больш дасканалае, чым мелодыя Шумана."

# game/scripts/scene/scene_day_4.rpy:10882
translate belarusian d4_polhouse_choice_kiss_c38cc54f:

    # "И тут я увидел зеркало на дверцах платяного шкафа."
    "І тут я ўбачыў люстэрка на дзверцах адзежнай шафы."

# game/scripts/scene/scene_day_4.rpy:10911
translate belarusian d4_polhouse_after_1f462768:

    # "Там отражалась приоткрытая дверь, нутро коридора."
    "Там адлюстроўваліся прыадчыненыя дзверы, нутро калідора."

# game/scripts/scene/scene_day_4.rpy:10917
translate belarusian d4_polhouse_after_46dfc904:

    # "Из щели за нами следил Харитон."
    "Са шчыліны за намі сачыў Харытон."

# game/scripts/scene/scene_day_4.rpy:10918
translate belarusian d4_polhouse_after_7fdc1a90:

    # "Хмурое лицо будто плавало в чёрных водах темноты. Глаза впились в меня – глубже и злее, чем кошачьи когти."
    "Хмуры твар быццам плаваў у чорных водах цемры. Вочы ўпіліся ў мяне — глыбей і злей, чым каціныя кіпцюры."

# game/scripts/scene/scene_day_4.rpy:10920
translate belarusian d4_polhouse_after_2d22ff6b:

    # "Рассекреченный старик дал задний ход, отъехал от двери и канул в варево теней."
    "Рассакрэчаны стары даў задні ход, ад'ехаў ад дзвярэй і кануў у варыва ценяў."

# game/scripts/scene/scene_day_4.rpy:10931
translate belarusian d4_polhouse_after_95c7061b:

    # "Поражённый, я оторвался от Полининых губ. Прервал сладкий поцелуй."
    "Уражаны, я адарваўся ад Палініных вуснаў. Перарваў салодкі пацалунак."

# game/scripts/scene/scene_day_4.rpy:10946
translate belarusian d4_polhouse_after_5b6abd59:

    # "Полина посмотрела на меня непонимающе и раздосадованно спросила:"
    "Паліна паглядзела на мяне недаўменна і з прыкрасцю спытала:"

# game/scripts/scene/scene_day_4.rpy:10949
translate belarusian d4_polhouse_after_5daafc44:

    # voice "voice/Polina/4day/120 V.ogg"
    # Pol "В чём дело?"
    voice "voice/Polina/4day/120 V.ogg"
    Pol "У чым справа?"

# game/scripts/scene/scene_day_4.rpy:10963
translate belarusian d4_polhouse_after_323a4715:

    # "Я выпутался из-под неё, встал, натягивая штаны, с третьего раза застегнул ремень."
    "Я выблытаўся з-пад яе, устаў, нацягваючы штаны, з трэцяга разу зашпіліў рамень."

# game/scripts/scene/scene_day_4.rpy:10965
translate belarusian d4_polhouse_after_a53b7738:

    # voice "voice/anton/4day/152. Ni.ogg"
    # Ant "Ни в чём."
    voice "voice/anton/4day/152. Ni.ogg"
    Ant "Ні ў чым."

# game/scripts/scene/scene_day_4.rpy:10967
translate belarusian d4_polhouse_after_afd404bc:

    # voice "voice/anton/4day/152. Ya.ogg"
    # Ant "Я вспомнил просто... Пообещал маме вернуться к ужину."
    voice "voice/anton/4day/152. Ya.ogg"
    Ant "Я ўспомніў проста... Паабяцаў маме вярнуцца да вячэры."

# game/scripts/scene/scene_day_4.rpy:10974
translate belarusian d4_polhouse_after_de6aa49f:

    # voice "voice/Polina/4day/122 Ni.ogg"
    # Pol "Не уходи."
    voice "voice/Polina/4day/122 Ni.ogg"
    Pol "Не сыходзь."

# game/scripts/scene/scene_day_4.rpy:10977
translate belarusian d4_polhouse_after_4dae55f9:

    # voice "voice/anton/4day/153. Po.ogg"
    # Ant "Полин, послушай..."
    voice "voice/anton/4day/153. Po.ogg"
    Ant "Палін, паслухай..."

# game/scripts/scene/scene_day_4.rpy:10980
translate belarusian d4_polhouse_after_9c435c63:

    # voice "voice/Polina/4day/123 Ne.ogg"
    # Pol "Не уходи, Тош!"
    voice "voice/Polina/4day/123 Ne.ogg"
    Pol "Не сыходзь, Тош!"

# game/scripts/scene/scene_day_4.rpy:10993
translate belarusian d4_polhouse_after_a5276c59:

    # "Голос задрожал. Слёзы потекли по щекам серебристыми ручейками."
    "Голас задрыжаў. Слёзы пацяклі па шчоках серабрыстымі ручайкамі."

# game/scripts/scene/scene_day_4.rpy:10994
translate belarusian d4_polhouse_after_f2aa7b94:

    # "Я оцепенел от неожиданности."
    "Я здранцвеў ад нечаканасці."

# game/scripts/scene/scene_day_4.rpy:10996
translate belarusian d4_polhouse_after_69456865:

    # "Настроение Полины сменилось моментально — так же, как и тема в монологе её деда."
    "Настрой Паліны змяніўся імгненна — гэтак жа, як і тэма ў маналогу яе дзеда."

# game/scripts/scene/scene_day_4.rpy:10997
translate belarusian d4_polhouse_after_52b229ce:

    # "Но ведь дед был старым и чудным..."
    "Але ж дзед быў старым і дзівакаватым..."

# game/scripts/scene/scene_day_4.rpy:11000
translate belarusian d4_polhouse_after_706e8f53:

    # voice "voice/Polina/4day/124 Za.ogg"
    # Pol "Забери меня с собой!"
    voice "voice/Polina/4day/124 Za.ogg"
    Pol "Забяры мяне з сабой!"

# game/scripts/scene/scene_day_4.rpy:11003
translate belarusian d4_polhouse_after_8cdffecd:

    # voice "voice/anton/4day/154. T.ogg"
    # Ant "Ты чего, Полин? Ну перестань!"
    voice "voice/anton/4day/154. T.ogg"
    Ant "Ты чаго, Палін? Ну перастань!"

# game/scripts/scene/scene_day_4.rpy:11006
translate belarusian d4_polhouse_after_f8a79cbd:

    # "Я обеспокоенно склонился к ней."
    "Я занепакоена схіліўся да яе."

# game/scripts/scene/scene_day_4.rpy:11007
translate belarusian d4_polhouse_after_a57a5406:

    # voice "voice/anton/4day/155. Nu.ogg"
    # Ant "Ну хватит, правда. Всё же хорошо."
    voice "voice/anton/4day/155. Nu.ogg"
    Ant "Ну хопіць, праўда. Усё ж добра."

# game/scripts/scene/scene_day_4.rpy:11010
translate belarusian d4_polhouse_after_7cdb5420:

    # voice "voice/Polina/4day/125 Ya.ogg"
    # Pol "Я здесь с ума сойду! Не знаю... Руки на себя наложу!"
    voice "voice/Polina/4day/125 Ya.ogg"
    Pol "Я тут з глузду з'еду! Не ведаю... Рукі на сябе накладу!"

# game/scripts/scene/scene_day_4.rpy:11013
translate belarusian d4_polhouse_after_a76f4545:

    # voice "voice/anton/4day/156. Ne.ogg"
    # Ant "Не говори так!"
    voice "voice/anton/4day/156. Ne.ogg"
    Ant "Не кажы так!"

# game/scripts/scene/scene_day_4.rpy:11020
translate belarusian d4_polhouse_after_a9949f79:

    # "Она повалилась на кровать, ладонями прикрыла лицо. Всхлипы превратились в сдавленное рыдание."
    "Яна павалілася на ложак, далонямі прыкрыла твар. Усхліпы ператварыліся ў здаўленае рыданне."

# game/scripts/scene/scene_day_4.rpy:11024
translate belarusian d4_polhouse_after_068c5bd5:

    # "Я растерянно топтался на месте, не зная, что предпринять."
    "Я разгублена таптаўся на месцы, не ведаючы, што рабіць."

# game/scripts/scene/scene_day_4.rpy:11026
translate belarusian d4_polhouse_after_55698400:

    # voice "voice/Polina/4day/128 Da.ogg"
    # Pol "Давай сбежим! Завтра же соберём вещи и уедем в город!"
    voice "voice/Polina/4day/128 Da.ogg"
    Pol "Давай уцячом! Заўтра ж збяром рэчы і з'едзем у горад!"

# game/scripts/scene/scene_day_4.rpy:11028
translate belarusian d4_polhouse_after_317df19b:

    # voice "voice/anton/4day/157.Na .ogg"
    # Ant "Нам по двенадцать лет..."
    voice "voice/anton/4day/157.Na .ogg"
    Ant "Нам па дванаццаць гадоў..."

# game/scripts/scene/scene_day_4.rpy:11030
translate belarusian d4_polhouse_after_7f151696:

    # voice "voice/Polina/4day/129 E.ogg"
    # Pol "И что?"
    voice "voice/Polina/4day/129 E.ogg"
    Pol "І што?"

# game/scripts/scene/scene_day_4.rpy:11041
translate belarusian d4_polhouse_after_3751328f:

    # voice "voice/Polina/4day/130 Te.ogg"
    # Pol "Тебе нравится жить в хибаре у леса?"
    voice "voice/Polina/4day/130 Te.ogg"
    Pol "Табе падабаецца жыць у халупе каля лесу?"

# game/scripts/scene/scene_day_4.rpy:11043
translate belarusian d4_polhouse_after_c0f84a92:

    # voice "voice/Polina/4day/131 A.ogg"
    # Pol "А мне, думаешь, по нраву гнить, заточённой в четырёх стенах?"
    voice "voice/Polina/4day/131 A.ogg"
    Pol "А мне, думаеш, даспадобы гніць, зняволенай у чатырох сценах?"

# game/scripts/scene/scene_day_4.rpy:11049
translate belarusian d4_polhouse_after_e53beb4d:

    # "Её кулачки били по дивану, тело выгибалось."
    "Яе кулачкі білі па канапе, цела выгіналася."

# game/scripts/scene/scene_day_4.rpy:11051
translate belarusian d4_polhouse_after_f226a3c9:

    # voice "voice/Polina/4day/132 Es.ogg"
    # Pol "Если ты мужчина, уведи меня из этого места!"
    voice "voice/Polina/4day/132 Es.ogg"
    Pol "Калі ты мужчына, выведзі мяне з гэтага месца!"

# game/scripts/scene/scene_day_4.rpy:11057
translate belarusian d4_polhouse_after_3161afc0:

    # "«{i}Пора уходить{/i}», - отчеканил внутренний голос, и я был с ним солидарен."
    "«{i}Пара сыходзіць{/i}», — адчаканіў унутраны голас, і я быў з ім салідарны."

# game/scripts/scene/scene_day_4.rpy:11058
translate belarusian d4_polhouse_after_447df643:

    # voice "voice/anton/4day/158. Pr.ogg"
    # Ant "Прости. Тебе надо отдохнуть. Поговорим позже."
    voice "voice/anton/4day/158. Pr.ogg"
    Ant "Прабач. Табе трэба адпачыць. Пагаворым пазней."

# game/scripts/scene/scene_day_4.rpy:11083
translate belarusian d4_polhouse_after_41207962:

    # "Я вышел в коридор, бурча. Возможно, поступил, как трус, но я не мог больше выносить её истерику."
    "Я выйшаў у калідор, буркаючы. Магчыма, паступіў, як баязлівец, але я не мог больш трываць яе істэрыку."

# game/scripts/scene/scene_day_4.rpy:11088
translate belarusian d4_polhouse_after_5dfd699c:

    # "Надел куртку, сунул ноги в ботинки."
    "Надзеў куртку, сунуў ногі ў чаравікі."

# game/scripts/scene/scene_day_4.rpy:11093
translate belarusian d4_polhouse_after_b572d2bc:

    # voice "voice/Hariton/18. Skir.ogg"
    # Ded "Скырлы-скырлы."
    voice "voice/Hariton/18. Skir.ogg"
    Ded "Скырлы-скырлы."

# game/scripts/scene/scene_day_4.rpy:11097
translate belarusian d4_polhouse_after_981fd212:

    # "Я уставился в темноту, думая о медведе-людоеде."
    "Я ўтаропіўся ў цемру, думаючы пра мядзведзя-людажэра."

# game/scripts/scene/scene_day_4.rpy:11103
translate belarusian d4_polhouse_after_a9cf2854:

    # "Плач Полины раздавался за стеной. А на меня надвигалось нечто скрипящее."
    "Плач Паліны раздаваўся за сцяной. А на мяне насоўвалася нешта рыпучае."

# game/scripts/scene/scene_day_4.rpy:11109
translate belarusian d4_polhouse_after_170bd781:

    # "Коляска старика притормозила в двух метрах, на границе света и мрака."
    "Каляска старога прытармазіла за два метры, на мяжы святла і змроку."

# game/scripts/scene/scene_day_4.rpy:11117
translate belarusian d4_polhouse_after_25f39b58:

    # voice "voice/Hariton/54.Uho.ogg"
    # Ded "Уходишь? Так быстро?"
    voice "voice/Hariton/54.Uho.ogg"
    Ded "Сыходзіш? Так хутка?"

# game/scripts/scene/scene_day_4.rpy:11122
translate belarusian d4_polhouse_after_46a9c60b:

    # "Я промямлил, шнуруя обувь:"
    "Я прамямліў, шнуруючы абутак:"

# game/scripts/scene/scene_day_4.rpy:11123
translate belarusian d4_polhouse_after_97afd4ad:

    # voice "voice/anton/4day/159. Pro.ogg"
    # Ant "Простите, мама будет беспокоиться."
    voice "voice/anton/4day/159. Pro.ogg"
    Ant "Прабачце, мама будзе хвалявацца."

# game/scripts/scene/scene_day_4.rpy:11125
translate belarusian d4_polhouse_after_313b906e:

    # voice "voice/Hariton/55.Ti.ogg"
    # Ded "Ты знаешь настоящее имя своей матери, Петров Антон?"
    voice "voice/Hariton/55.Ti.ogg"
    Ded "Ты ведаеш сапраўднае імя сваёй маці, Пятроў Антон?"

# game/scripts/scene/scene_day_4.rpy:11127
translate belarusian d4_polhouse_after_c1084334:

    # "Тени клубились, двигаясь за плечами Харитона. Я жаждал покинуть это странное место как можно скорее."
    "Цені клубіліся, рухаючыся за плячыма Харытона. Я прагнуў пакінуць гэтае дзіўнае месца як мага хутчэй."

# game/scripts/scene/scene_day_4.rpy:11128
translate belarusian d4_polhouse_after_7886a00f:

    # voice "voice/anton/4day/160. Ne.ogg"
    # Ant "Нет, простите."
    voice "voice/anton/4day/160. Ne.ogg"
    Ant "Не, прабачце."

# game/scripts/scene/scene_day_4.rpy:11131
translate belarusian d4_polhouse_after_8d1c695d:

    # "Взволнованный, я извинялся направо и налево."
    "Усхваляваны, я прасіў прабачэння направа і налева."

# game/scripts/scene/scene_day_4.rpy:11145
translate belarusian d4_polhouse_after_d0ed4461:

    # voice "voice/Hariton/56.Poch.ogg"
    # Ded "Почему плачет Полина? Что случилось?"
    voice "voice/Hariton/56.Poch.ogg"
    Ded "Чаму плача Паліна? Што здарылася?"

# game/scripts/scene/scene_day_4.rpy:11149
translate belarusian d4_polhouse_after_c8a9c3e8:

    # "Блеснули железные зубы."
    "Бліснулі жалезныя зубы."

# game/scripts/scene/scene_day_4.rpy:11153
translate belarusian d4_polhouse_after_9eedf1cb:

    # voice "voice/Hariton/57.Po.ogg"
    # Ded "Пойдём на кухню, чай пить будем."
    voice "voice/Hariton/57.Po.ogg"
    Ded "Хадзем на кухню, гарбату піць будзем."

# game/scripts/scene/scene_day_4.rpy:11157
translate belarusian d4_polhouse_after_23d8fa77:

    # voice "voice/Hariton/58.Ya.ogg"
    # Ded "Я тортик разрезал."
    voice "voice/Hariton/58.Ya.ogg"
    Ded "Я торцік разрэзаў."

# game/scripts/scene/scene_day_4.rpy:11160
translate belarusian d4_polhouse_after_a8fc982f:

    # voice "voice/anton/4day/161. Men.ogg"
    # Ant "Меня ждут."
    voice "voice/anton/4day/161. Men.ogg"
    Ant "Мяне чакаюць."

# game/scripts/scene/scene_day_4.rpy:11164
translate belarusian d4_polhouse_after_5c6e8ef6:

    # voice "voice/Hariton/59.Pod.ogg"
    # Ded "Подождут и перестанут. Ну, пойдём, пойдём."
    voice "voice/Hariton/59.Pod.ogg"
    Ded "Пачакаюць і перастануць. Ну, хадзем, хадзем."

# game/scripts/scene/scene_day_4.rpy:11169
translate belarusian d4_polhouse_after_a710729b:

    # "Он хныкнул капризно."
    "Ён хныкнуў капрызна."

# game/scripts/scene/scene_day_4.rpy:11172
translate belarusian d4_polhouse_after_e5d92289:

    # "Наконец справившись со шнурками, я вскочил на ноги. Старик улыбался надсадно."
    "Нарэшце справіўшыся са шнуркамі, я ўскочыў на ногі. Стары ўсміхаўся надсадна."

# game/scripts/scene/scene_day_4.rpy:11176
translate belarusian d4_polhouse_after_df687039:

    # "Я повернулся к нему спиной. Пальцы сражались с замком."
    "Я павярнуўся да яго спінай. Пальцы змагаліся з замком."

# game/scripts/scene/scene_day_4.rpy:11191
translate belarusian d4_polhouse_after_ad773283:

    # voice "voice/Hariton/Skirl.ogg"
    # Ded "Скырлы-скырлы."
    voice "voice/Hariton/Skirl.ogg"
    Ded "Скырлы-скырлы."

# game/scripts/scene/scene_day_4.rpy:11193
translate belarusian d4_polhouse_after_c21d89ef:

    # "Мне не позволят уйти. Наедут сзади коляской, утащат."
    "Мне не дазволяць сысці. Наедуць ззаду каляскай, зацягнуць."

# game/scripts/scene/scene_day_4.rpy:11229
translate belarusian d4_polhouse_after_22ce1b93:

    # voice "voice/Hariton/Skirl2.ogg"
    # Ded "Скырлы-скырлы."
    voice "voice/Hariton/Skirl2.ogg"
    Ded "Скырлы-скырлы."

# game/scripts/scene/scene_day_4.rpy:11243
translate belarusian d4_polhouse_after_53b7a7e2:

    # "Дверь отворилась, впустив в душный коридор зимний мороз."
    "Дзверы адчыніліся, упусціўшы ў душны калідор зімовы мароз."

# game/scripts/scene/scene_day_4.rpy:11252
translate belarusian d4_polhouse_after_85b40682:

    # voice "voice/Hariton/62.Kak.ogg"
    # Ded "Как твоё настоящее имя?"
    voice "voice/Hariton/62.Kak.ogg"
    Ded "Якое тваё сапраўднае імя?"

# game/scripts/scene/scene_day_4.rpy:11261
translate belarusian d4_polhouse_after_853e32f6:

    # voice "voice/anton/4day/162. D.ogg"
    # Ant "До свидания!"
    voice "voice/anton/4day/162. D.ogg"
    Ant "Да пабачэння!"

# game/scripts/scene/scene_day_4.rpy:11278
translate belarusian d4_polhouse_after_702671f5:

    # "Я вылетел на крыльцо, на дорожку, петляющую между домов."
    "Я вылецеў на ганак, на дарожку, што пятляла паміж дамамі."

# game/scripts/scene/scene_day_4.rpy:11279
translate belarusian d4_polhouse_after_d9b27dd2:

    # "Пока я гостил у Полины, мрак вороньими крылами объял посёлок."
    "Пакуль я гасцяваў у Паліны, змрок варонінымі крыламі агарнуў пасёлак."

# game/scripts/scene/scene_day_4.rpy:11280
translate belarusian d4_polhouse_after_89b1a8ac:

    # "Из-за ветра он казался живым и мыслящим существом. Слабо горели вмурованные в ночь фонари."
    "Праз вецер ён здаваўся жывой істотай, здольнай мысліць. Слаба гарэлі ўмураваныя ў ноч ліхтары."

# game/scripts/scene/scene_day_4.rpy:11284
translate belarusian d4_polhouse_after_b059ad7a:

    # "Я утёр лоб."
    "Я выцер лоб."

# game/scripts/scene/scene_day_4.rpy:11285
translate belarusian d4_polhouse_after_93896a59:

    # "Ну и ну! Что за концерт устроила Полина?"
    "Ну і ну! Што за канцэрт зладзіла Паліна?"

# game/scripts/scene/scene_day_4.rpy:11286
translate belarusian d4_polhouse_after_723a79b9:

    # "А старик, подглядывавший за нами? Не мудрено, что она так отчаянно хотела сбежать."
    "А стары, які падглядваў за намі? Не дзіва, што яна так адчайна хацела ўцячы."

# game/scripts/scene/scene_day_4.rpy:11310
translate belarusian d4_polhouse_after_devend_4f08874b:

    # "Едва я вспомнил металлические зубы Харитона, как мурашки зарыскали по моей коже."
    "Ледзь я ўспомніў металічныя зубы Харытона, як мурашкі зашнырылі па маёй скуры."

# game/scripts/scene/scene_day_4.rpy:11316
translate belarusian d4_polhouse_after_devend_64fdf902:

    # voice "voice/romka/4day/228ei.ogg"
    # Noname "Эй!"
    voice "voice/romka/4day/228ei.ogg"
    Noname "Гэй!"

# game/scripts/scene/scene_day_4.rpy:11318
translate belarusian d4_polhouse_after_devend_98b406c9:

    # "Я встрепенулся и окинул взором улицу. У забора маячил неясный силуэт."
    "Я ўстрапянуўся і акінуў позіркам вуліцу. Каля плота маячыў няясны сілуэт."

# game/scripts/scene/scene_day_4.rpy:11319
translate belarusian d4_polhouse_after_devend_a8a8006b:

    # voice "voice/anton/4day/163. Kto.ogg"
    # Ant "Кто здесь?"
    voice "voice/anton/4day/163. Kto.ogg"
    Ant "Хто тут?"

# game/scripts/scene/scene_day_4.rpy:11330
translate belarusian d4_polhouse_after_devend_04a14c51:

    # "Человек шагнул ко мне, встал в кольце фонарного света. Душа, кувыркнувшись, ухнула в пятки."
    "Чалавек ступіў да мяне, стаў у коле ліхтарнага святла. Душа, перакуліўшыся, ухнула ў пяткі."

# game/scripts/scene/scene_day_4.rpy:11331
translate belarusian d4_polhouse_after_devend_f3cc1ec1:

    # "Я узнал Ромку."
    "Я пазнаў Ромку."

# game/scripts/scene/scene_day_4.rpy:11341
translate belarusian d4_polhouse_after_devend_3ee8509f:

    # "Щёки одноклассника были мокрыми, а глаза покраснели."
    "Шчокі аднакласніка былі мокрымі, а вочы пачырванелі."

# game/scripts/scene/scene_day_4.rpy:11343
translate belarusian d4_polhouse_after_devend_7e7524ce:

    # "Он плакал, прячась в темноте."
    "Ён плакаў, хаваючыся ў цемры."

# game/scripts/scene/scene_day_4.rpy:11347
translate belarusian d4_polhouse_after_devend_8e0099b4:

    # voice "voice/romka/4day/229nu.ogg"
    # Rom "Ну, привет."
    voice "voice/romka/4day/229nu.ogg"
    Rom "Ну, прывітанне."

# game/scripts/scene/scene_day_4.rpy:11369
translate belarusian d4_madrom_fox_191229ac:

    # voice "voice/anton/4day/164. Chto.ogg"
    # Ant "Что ты тут делаешь?"
    voice "voice/anton/4day/164. Chto.ogg"
    Ant "Што ты тут робіш?"

# game/scripts/scene/scene_day_4.rpy:11371
translate belarusian d4_madrom_fox_77912aa8:

    # voice "voice/romka/4day/230 Da.ogg"
    # Rom "Да вот... Ты не пришёл на наш спектакль, и я волновался, что с тобой что-то случилось."
    voice "voice/romka/4day/230 Da.ogg"
    Rom "Ды вось... Ты не прыйшоў на наш спектакль, і я хваляваўся, што з табой нешта здарылася."

# game/scripts/scene/scene_day_4.rpy:11379
translate belarusian d4_madrom_fox_1890e12c:

    # voice "voice/romka/4day/231 Kak.ogg"
    # Rom "Как с Семёном и Катей."
    voice "voice/romka/4day/231 Kak.ogg"
    Rom "Як з Сямёнам і Кацяй."

# game/scripts/scene/scene_day_4.rpy:11390
translate belarusian d4_madrom_fox_1e7c2304:

    # "Раздался щелчок, сверкнул нож-бабочка."
    "Раздаўся пстрык, бліснуў нож-матылёк."

# game/scripts/scene/scene_day_4.rpy:11412
translate belarusian d4_madrom_fox_7c327fa3:

    # "Обескровленные губы Ромы растянулись в страшной гримасе. Зрачки сверкали, словно две монеты."
    "Абяскроўленыя вусны Ромы расцягнуліся ў страшнай грымасе. Зрэнкі зіхацелі, нібы дзве манеты."

# game/scripts/scene/scene_day_4.rpy:11421
translate belarusian d4_madrom_fox_b6f92996:

    # voice "voice/anton/4day/165. Rom.ogg"
    # Ant "Ром, убери нож."
    voice "voice/anton/4day/165. Rom.ogg"
    Ant "Ром, прыбяры нож."

# game/scripts/scene/scene_day_4.rpy:11435
translate belarusian d4_madrom_fox_6329e7ff:

    # voice "voice/romka/4day/232 Za.ogg"
    # Rom "Зачем?"
    voice "voice/romka/4day/232 Za.ogg"
    Rom "Навошта?"

# game/scripts/scene/scene_day_4.rpy:11439
translate belarusian d4_madrom_fox_a206eaea:

    # voice "voice/romka/4day/233 Kak.ogg"
    # Rom "Как без ножа я смогу разрезать тебя от пупка до глотки и проверить, что внутри у предателей?"
    voice "voice/romka/4day/233 Kak.ogg"
    Rom "Як без нажа я змагу разрэзаць цябе ад пупка да глоткі і праверыць, што ўнутры ў здраднікаў?"

# game/scripts/scene/scene_day_4.rpy:11442
translate belarusian d4_madrom_fox_efd6bde8:

    # voice "voice/anton/4day/166. Roma.ogg"
    # Ant "Рома!"
    voice "voice/anton/4day/166. Roma.ogg"
    Ant "Рома!"

# game/scripts/scene/scene_day_4.rpy:11447
translate belarusian d4_madrom_fox_17a07128:

    # "Я отступал, боясь повернуться к нему беззащитными лопатками. Рома шёл на меня, скалясь."
    "Я адступаў, баючыся павярнуцца да яго безабароннымі лапаткамі. Рома ішоў на мяне, скалячыся."

# game/scripts/scene/scene_day_4.rpy:11450
translate belarusian d4_madrom_fox_07b15211:

    # voice "voice/romka/4day/234 Bil.ogg"
    # Rom "Был у неё дома, да?"
    voice "voice/romka/4day/234 Bil.ogg"
    Rom "Быў у яе дома, так?"

# game/scripts/scene/scene_day_4.rpy:11454
translate belarusian d4_madrom_fox_16c7dfec:

    # voice "voice/romka/4day/235 Prav.ogg"
    # Rom "Правая рука Вольтрона, говорит центр управления! Как слышно?.."
    voice "voice/romka/4day/235 Prav.ogg"
    Rom "Правая рука Вальтрона, гаворыць цэнтр кіравання! Як чуваць?.."

# game/scripts/scene/scene_day_4.rpy:11458
translate belarusian d4_madrom_fox_bad92ade:

    # voice "voice/romka/4day/236 Ti.ogg"
    # Rom "Ты был у моей Полины?"
    voice "voice/romka/4day/236 Ti.ogg"
    Rom "Ты быў у маёй Паліны?"

# game/scripts/scene/scene_day_4.rpy:11462
translate belarusian d4_madrom_fox_32a05dc4:

    # voice "voice/romka/4day/237 Ris.ogg"
    # Rom "Рисовал её? Трогал?"
    voice "voice/romka/4day/237 Ris.ogg"
    Rom "Маляваў яе? Чапаў?"

# game/scripts/scene/scene_day_4.rpy:11473
translate belarusian d4_madrom_fox_94249f5c:

    # voice "voice/anton/4day/167. Vse.ogg"
    # Ant "Всё не так!"
    voice "voice/anton/4day/167. Vse.ogg"
    Ant "Усё не так!"

# game/scripts/scene/scene_day_4.rpy:11475
translate belarusian d4_madrom_fox_f2de6231:

    # "Я врал, конечно. Всё было именно так и даже больше."
    "Я хлусіў, вядома. Усё было менавіта так і нават больш."

# game/scripts/scene/scene_day_4.rpy:11492
translate belarusian d4_madrom_notfox_2caf7c22:

    # voice "voice/romka/4day/239Razve.ogg"
    # Rom "Разве я не предупреждал тебя, а?"
    voice "voice/romka/4day/239Razve.ogg"
    Rom "Хіба я не папярэджваў цябе, га?"

# game/scripts/scene/scene_day_4.rpy:11496
translate belarusian d4_madrom_notfox_116c2fd7:

    # voice "voice/romka/4day/240raz.ogg"
    # Rom "Разве не говорил, что убью, если увижу рядом с ней?"
    voice "voice/romka/4day/240raz.ogg"
    Rom "Хіба не казаў, што заб'ю, калі ўбачу побач з ёй?"

# game/scripts/scene/scene_day_4.rpy:11509
translate belarusian d4_madrom_notfox_1e7c2304:

    # "Раздался щелчок, сверкнул нож-бабочка."
    "Раздаўся пстрык, бліснуў нож-матылёк."

# game/scripts/scene/scene_day_4.rpy:11529
translate belarusian d4_madrom_notfox_7c327fa3:

    # "Обескровленные губы Ромы растянулись в страшной гримасе. Зрачки сверкали, словно две монеты."
    "Абяскроўленыя вусны Ромы расцягнуліся ў страшнай грымасе. Зрэнкі зіхацелі, нібы дзве манеты."

# game/scripts/scene/scene_day_4.rpy:11538
translate belarusian d4_madrom_notfox_b6f92996:

    # voice "voice/anton/4day/165. Rom.ogg"
    # Ant "Ром, убери нож."
    voice "voice/anton/4day/165. Rom.ogg"
    Ant "Ром, прыбяры нож."

# game/scripts/scene/scene_day_4.rpy:11553
translate belarusian d4_madrom_notfox_96fd1c35:

    # voice "voice/romka/4day/241dum.ogg"
    # Rom "Думаешь, я псих? Я покажу тебе, что делают психи!"
    voice "voice/romka/4day/241dum.ogg"
    Rom "Думаеш, я псіх? Я пакажу табе, што робяць псіхі!"

# game/scripts/scene/scene_day_4.rpy:11555
translate belarusian d4_madrom_notfox_ab854db6:

    # voice "voice/anton/4day/166. Roma.ogg"
    voice "voice/anton/4day/166. Roma.ogg"

# game/scripts/scene/scene_day_4.rpy:11558
translate belarusian d4_madrom_notfox_eaf261e9:

    # Ant "Рома!"
    Ant "Рома!"

# game/scripts/scene/scene_day_4.rpy:11560
translate belarusian d4_madrom_notfox_636d5e10:

    # "Я отступал, боясь повернуться к нему беззащитными лопатками."
    "Я адступаў, баючыся павярнуцца да яго безабароннымі лапаткамі."

# game/scripts/scene/scene_day_4.rpy:11564
translate belarusian d4_madrom_notfox_560e93b7:

    # "Ромка шёл на меня, скалясь."
    "Ромка ішоў на мяне, скалячыся."

# game/scripts/scene/scene_day_4.rpy:11588
translate belarusian d4_madrom_common_4188d081:

    # voice "voice/romka/4day/244zalkii_pr.ogg"
    # Rom "Жалкий ублюдок!"
    voice "voice/romka/4day/244zalkii_pr.ogg"
    Rom "Жалюгодны вырадак!"

# game/scripts/scene/scene_day_4.rpy:11594
translate belarusian d4_madrom_common_985d6a4e:

    # "В уголках его рта выступила пена."
    "У кутках яго рота выступіла пена."

# game/scripts/scene/scene_day_4.rpy:11599
translate belarusian d4_madrom_common_4bbc0f07:

    # "Он судорожно утёр лицо рукавом, ещё сильнее размазав слёзы по щекам."
    "Ён сутаргава выцер твар рукавом, яшчэ мацней размазаўшы слёзы па шчоках."

# game/scripts/scene/scene_day_4.rpy:11601
translate belarusian d4_madrom_common_868ea046:

    # "Остекленевшие глаза заволокло туманом ненависти."
    "Ашклянелыя вочы зацягнула туманам нянавісці."

# game/scripts/scene/scene_day_4.rpy:11636
translate belarusian d4_madrom_amulet_a4fd4910:

    # "Амулет-коготь, который мне дала Полина, снова пришёл на выручку."
    "Амулет-кіпцюр, які мне дала Паліна, зноў прыйшоў на выручку."

# game/scripts/scene/scene_day_4.rpy:11637
translate belarusian d4_madrom_amulet_2d540a26:

    # "Время словно замедлилось, стало как янтарь, в котором застыл не только я, но и Ромка с его опасным ножом."
    "Час нібы запаволіўся, стаў як бурштын, у якім застыў не толькі я, але і Ромка з яго небяспечным нажом."

# game/scripts/scene/scene_day_4.rpy:11648
translate belarusian d4_madrom_amulet_bf92b9ff:

    # "«{i}Беги!{/i} — просигналил внутренний голос. — {i}Спасай свою шкуру!{/i}»"
    "«{i}Бяжы!{/i} — прасігналіў унутраны голас. — {i}Ратуй сваю шкуру!{/i}»"

# game/scripts/scene/scene_day_4.rpy:11650
translate belarusian d4_madrom_amulet_63e5ee3f:

    # voice "voice/romka/4day/244 zalkiigrya.ogg"
    # Rom "Жалкий грязный ублюдок!"
    voice "voice/romka/4day/244 zalkiigrya.ogg"
    Rom "Жалюгодны брудны вырадак!"

# game/scripts/scene/scene_day_4.rpy:11655
translate belarusian d4_madrom_amulet_7d648ca1:

    # "Вдруг он завыл. Горестный вой взвился к звёздам."
    "Раптам ён завыў. Гаротнае выццё ўзвілося да зорак."

# game/scripts/scene/scene_day_4.rpy:11662
translate belarusian d4_madrom_amulet_cb870638:

    # "Ромка сунул себе в рот рукоять ножа, как сигару, зажал зубами. Лезвие торчало наружу стальным клыком."
    "Ромка сунуў сабе ў рот рукаяць нажа, як цыгару, заціснуў зубамі. Лязо тырчала вонкі сталёвым іклом."

# game/scripts/scene/scene_day_4.rpy:11679
translate belarusian d4_madrom_amulet_01a5b9ab:

    # "А затем он упал на четвереньки."
    "А затым ён упаў на карачкі."

# game/scripts/scene/scene_day_4.rpy:11680
translate belarusian d4_madrom_amulet_133441c7:

    # "Его тень по-звериному нахохлилась."
    "Яго цень па-звярынаму натапырыўся."

# game/scripts/scene/scene_day_4.rpy:11681
translate belarusian d4_madrom_amulet_84427fc2:

    # "Слюна капала на снег."
    "Сліна капала на снег."

# game/scripts/scene/scene_day_4.rpy:11691
translate belarusian d4_madrom_amulet_15a05e51:

    # "Обезумевший Ромка зарычал и бросился ко мне, отталкиваясь всеми четырьмя конечностями."
    "Звар'яцелы Ромка зарычаў і кінуўся да мяне, адштурхоўваючыся ўсімі чатырма канечнасцямі."

# game/scripts/scene/scene_day_4.rpy:11692
translate belarusian d4_madrom_amulet_aa3f305e:

    # "{i}Беги!{/i}"
    "{i}Бяжы!{/i}"

# game/scripts/scene/scene_day_4.rpy:11721
translate belarusian d4_madrom_amulet_b8ab2285:

    # "Я побежал, не разбирая дороги."
    "Я пабег, не разбіраючы дарогі."

# game/scripts/scene/scene_day_4.rpy:11722
translate belarusian d4_madrom_amulet_08f3ebf5:

    # "Ботинки вязли в сугробах. Мелькал штакетник."
    "Чаравікі вязлі ў сумётах. Мільгаў штыкетнік."

# game/scripts/scene/scene_day_4.rpy:11723
translate belarusian d4_madrom_amulet_0b9364a6:

    # "Шум поднялся такой, словно за мной гнался не ровесник, а какой-то зверь. Большой до ужаса."
    "Шум падняўся такі, нібы за мной гнаўся не равеснік, а нейкі звер. Вялікі да жаху."

# game/scripts/scene/scene_day_4.rpy:11724
translate belarusian d4_madrom_amulet_d6be2aad:

    # "Ветер бил по лицу, обжигал, будто листья крапивы."
    "Вецер біў па твары, абпальваў, быццам лісце крапівы."

# game/scripts/scene/scene_day_4.rpy:11725
translate belarusian d4_madrom_amulet_ab2c2074:

    # "Я задыхался."
    "Я задыхаўся."

# game/scripts/scene/scene_day_4.rpy:11767
translate belarusian d4_madrom_amulet_9411523c:

    # "На повороте стоял припаркованный трактор, но водителя я не увидел."
    "На павароце стаяў прыпаркаваны трактар, але кіроўцы я не ўбачыў."

# game/scripts/scene/scene_day_4.rpy:11786
translate belarusian d4_madrom_amulet_808f5cda:

    # "Что-то юркое перепрыгнуло тропинку. Приземлилось в паре метров от меня."
    "Нешта юркае пераскочыла сцежку. Прызямлілася за пару метраў ад мяне."

# game/scripts/scene/scene_day_4.rpy:11800
translate belarusian d4_madrom_amulet_5b76c8ea:

    # "Снежная баррикада перекрыла путь. Я вскарабкался на неё, скатился, ринулся в переулок."
    "Снежная барыкада перакрыла шлях. Я ўдзёрся на яе, скаціўся, рынуўся ў завулак."

# game/scripts/scene/scene_day_4.rpy:11813
translate belarusian d4_madrom_amulet_23c49d5c:

    # "Фонари мигали панически."
    "Ліхтары міргалі панічна."

# game/scripts/scene/scene_day_4.rpy:11840
translate belarusian d4_madrom_amulet_991837c0:

    # "Я заметил сельмаг и кинулся к нему."
    "Я заўважыў сельмаг і кінуўся да яго."

# game/scripts/scene/scene_day_4.rpy:11872
translate belarusian d4_madrom_amulet_74e37624:

    # "Дёрнул ручку — заперто!"
    "Тузануў ручку — замкнёна!"

# game/scripts/scene/scene_day_4.rpy:11921
translate belarusian d4_madrom_amulet_03b561a9:

    # "В стекле отразился переулок. Что-то огромное и жуткое двигалось оттуда, окутанное метелью, точно похоронным саваном."
    "У шкле адбіўся завулак. Нешта вялізнае і жудаснае рухалася адтуль, ахутанае завірухай, нібы пахавальным саванам."

# game/scripts/scene/scene_day_4.rpy:11962
translate belarusian d4_madrom_amulet_f402ff67:

    # "Я метнулся на расчищенную полоску асфальта."
    "Я мятнуўся на расчышчаную палоску асфальту."

# game/scripts/scene/scene_day_4.rpy:11963
translate belarusian d4_madrom_amulet_afc97422:

    # "Собаки во дворах не лаяли, а жалобно скулили."
    "Сабакі ў дварах не брахалі, а жаласна скавыталі."

# game/scripts/scene/scene_day_4.rpy:11997
translate belarusian d4_madrom_amulet_18c1e7bb:

    # "Я обогнул крайний дом и выбежал за посёлок. Лес нависал чёрной монолитной глыбой."
    "Я абагнуў крайні дом і выбег за пасёлак. Лес навісаў чорнай маналітнай глыбай."

# game/scripts/scene/scene_day_4.rpy:11998
translate belarusian d4_madrom_amulet_f99dd214:

    # "У меня был выбор: просека, на которой я был бы как на ладони, или прямой маршрут через лес, через рвы и бурелом."
    "У мяне быў выбар: просека, на якой я быў бы як на далоні, або прамы маршрут праз лес, праз равы і буралом."

# game/scripts/scene/scene_day_4.rpy:11999
translate belarusian d4_madrom_amulet_d463625f:

    # "И я предпочёл второй вариант."
    "І я аддаў перавагу другому варыянту."

# game/scripts/scene/scene_day_4.rpy:12016
translate belarusian d4_madrom_amulet_7eebc283:

    # "Прыгнул вбок, – нога скользнула по льду, — рухнул в овраг."
    "Скокнуў убок, — нага слізганула па лёдзе, — рухнуў у яр."

# game/scripts/scene/scene_day_4.rpy:12022
translate belarusian d4_madrom_amulet_ec37a520:

    # "Брыкаясь, перевернулся на спину и стал отползать, ожидая, что Ромка вот-вот появится сверху."
    "Брыкаючыся, перавярнуўся на спіну і стаў адпаўзаць, чакаючы, што Ромка вось-вось з'явіцца зверху."

# game/scripts/scene/scene_day_4.rpy:12030
translate belarusian d4_madrom_amulet_32383a75:

    # "Нечеловеческий вопль пронёсся дворами, ввинтился в уши."
    "Нечалавечы крык пранёсся дварамі, увінціўся ў вушы."

# game/scripts/scene/scene_day_4.rpy:12047
translate belarusian d4_madrom_amulet_43043837:

    # "Прошла минута. Вторая."
    "Прайшла хвіліна. Другая."

# game/scripts/scene/scene_day_4.rpy:12057
translate belarusian d4_madrom_amulet_b1b81c57:

    # "Я трясся, всматриваясь в край оврага, в чернильные мазки сосен."
    "Я тросся, углядаючыся ў край яра, у чарнільныя мазкі соснаў."

# game/scripts/scene/scene_day_4.rpy:12069
translate belarusian d4_madrom_amulet_0aac583d:

    # "В приближающуюся тень."
    "У цень, што набліжаўся."

# game/scripts/scene/scene_day_4.rpy:12097
translate belarusian d4_madrom_amulet_afc77b8e:

    # "Мальчик в маске волка вышел из леса и остановился передо мной."
    "Хлопчык у масцы ваўка выйшаў з лесу і спыніўся перада мной."

# game/scripts/scene/scene_day_4.rpy:12116
translate belarusian d4_madrom_amulet_04411df6:

    # voice "voice/Wolf/341 Drr.ogg"
    # Wolf "Др-р-руг."
    voice "voice/Wolf/341 Drr.ogg"
    Wolf "Сяб-р-р-р."

# game/scripts/scene/scene_day_4.rpy:12154
translate belarusian d4_madrom_amulet_2192a2ef:

    # "Он разжал кулак – нож-бабочка упал на снег."
    "Ён расціснуў кулак — нож-матылёк упаў на снег."

# game/scripts/scene/scene_day_4.rpy:12207
translate belarusian d4_madrom_amulet_616c76f1:

    # voice "voice/Wolf/337 Te.ogg"
    # Wolf "Тебе ничего не угр-р-рожает. Мы же говор-р-рили."
    voice "voice/Wolf/337 Te.ogg"
    Wolf "Табе нічога не пагр-р-ражае. Мы ж гавар-р-рылі."

# game/scripts/scene/scene_day_4.rpy:12225
translate belarusian d4_madrom_amulet_2ca06f2a:

    # "Не веря своим глазам, я поднялся на ноги."
    "Не верачы сваім вачам, я падняўся на ногі."

# game/scripts/scene/scene_day_4.rpy:12226
translate belarusian d4_madrom_amulet_2fb35cd4:

    # "Волчонок махнул рукой в сторону просеки."
    "Ваўчаня махнула рукой у бок просекі."

# game/scripts/scene/scene_day_4.rpy:12229
translate belarusian d4_madrom_amulet_2c23b345:

    # voice "voice/Wolf/338 Vs.ogg"
    # Wolf "Всё в пор-р-рядке. Иди."
    voice "voice/Wolf/338 Vs.ogg"
    Wolf "Усё ў пар-р-радку. Ідзі."

# game/scripts/scene/scene_day_4.rpy:12261
translate belarusian d4_madrom_amulet_7f815e67:

    # "Я был слишком испуган, чтобы задавать вопросы."
    "Я быў занадта напалоханы, каб задаваць пытанні."

# game/scripts/scene/scene_day_4.rpy:12277
translate belarusian d4_madrom_amulet_9751db70:

    # "Потому я молча ушёл, хромая вдоль колышущихся деревьев, и постарался не думать о сгустках тьмы, что провожали меня, хоронясь за кустами."
    "Таму я моўчкі пайшоў, кульгаючы ўздоўж дрэў, якія калыхаліся, і пастараўся не думаць пра згусткі цемры, што праводзілі мяне, хаваючыся за кустамі."

# game/scripts/scene/scene_day_4.rpy:12282
translate belarusian d4_madrom_amulet_1ff02d4f:

    # "Я ещё не знал, что ждёт меня в месте, которое я по ошибке называл домом."
    "Я яшчэ не ведаў, што чакае мяне ў месцы, якое я памылкова называў домам."

# game/scripts/scene/scene_day_4.rpy:12306
translate belarusian d4_madrom_no_amulet_a81a6c21:

    # "Железная бабочка начала своё медленное движение вверх и вдруг, как на ускоренной плёнке, нырнула вперёд: это Ромка резко качнулся ко мне."
    "Жалезны матылёк пачаў свой павольны рух уверх і раптам, як на паскоранай плёнцы, нырнуў наперад: гэта Ромка рэзка хіснуўся да мяне."

# game/scripts/scene/scene_day_4.rpy:12339
translate belarusian d4_madrom_no_amulet_1bc88855:

    # "Его лицо приобрело цвет воска, а глаза пылали, как фосфорные."
    "Яго твар набыў колер воску, а вочы палалі, як фосфарныя."

# game/scripts/scene/scene_day_4.rpy:12340
translate belarusian d4_madrom_no_amulet_7a7c84aa:

    # "Я ощутил толчок и опустил взор."
    "Я адчуў штуршок і апусціў позірк."

# game/scripts/scene/scene_day_4.rpy:12358
translate belarusian d4_madrom_no_amulet_a54e5e28:

    # "Бабочка была не настоящей."
    "Матылёк быў не сапраўдным."

# game/scripts/scene/scene_day_4.rpy:12359
translate belarusian d4_madrom_no_amulet_fe8cdc8f:

    # "Из магазина приколов, игрушка, в которой лезвие погружается в рукоять."
    "З крамы прыколаў, цацка, у якой лязо ўваходзіць у рукаяць."

# game/scripts/scene/scene_day_4.rpy:12360
translate belarusian d4_madrom_no_amulet_f2c325d0:

    # "Затем я понял, что ошибся, что не вижу лезвие потому, что оно погрузилось в мою грудь."
    "Затым я зразумеў, што памыліўся, што не бачу ляза таму, што яно ўвайшло ў мае грудзі."

# game/scripts/scene/scene_day_4.rpy:12361
translate belarusian d4_madrom_no_amulet_192b116c:

    # "Что оно сейчас внутри."
    "Што яно цяпер унутры."

# game/scripts/scene/scene_day_4.rpy:12362
translate belarusian d4_madrom_no_amulet_8795b942:

    # "Между рёбер."
    "Паміж рэбраў."

# game/scripts/scene/scene_day_4.rpy:12363
translate belarusian d4_madrom_no_amulet_0c7f5323:

    # "Холодное."
    "Халоднае."

# game/scripts/scene/scene_day_4.rpy:12364
translate belarusian d4_madrom_no_amulet_53500477:

    # "Острое."
    "Вострае."

# game/scripts/scene/scene_day_4.rpy:12388
translate belarusian d4_madrom_no_amulet_8dcecca6:

    # "Как звук, запоздавший за светом, пришла боль."
    "Як гук, што спазніўся за святлом, прыйшоў боль."

# game/scripts/scene/scene_day_4.rpy:12389
translate belarusian d4_madrom_no_amulet_bf4f8256:

    # "Удивительно, но она не была очень сильной, зато была ужасно неприятной, сосущей, и отдавала куда-то в затылок."
    "Дзіўна, але ён не быў вельмі моцным, затое быў жахліва непрыемным, шчымлівым, і аддаваў кудысьці ў патыліцу."

# game/scripts/scene/scene_day_4.rpy:12395
translate belarusian d4_madrom_no_amulet_c9b33c9c:

    # "Я схватил Ромку за предплечье."
    "Я схапіў Ромку за перадплечча."

# game/scripts/scene/scene_day_4.rpy:12414
translate belarusian d4_madrom_no_amulet_7192edba:

    # "Он вырвал нож: как в замедленной съёмке, за лезвием взлетел пунктир алых капель." id d4_madrom_no_amulet_7192edba
    "Ён вырваў нож: як у запаволенай здымцы, за лязом узляцеў пункцір пунсовых кропель."

# game/scripts/scene/scene_day_4.rpy:12453
translate belarusian d4_madrom_no_amulet_8cedabd2:

    # "Кожа на костяном каркасе Ромкиного лица гротескно растянулась, рот распахнулся, между передними зубами натянулись нити слюны."
    "Скура на касцяным каркасе Ромкавага твару гратэскна расцягнулася, рот разявіўся, паміж пярэднімі зубамі нацягнуліся ніці сліны."

# game/scripts/scene/scene_day_4.rpy:12454
translate belarusian d4_madrom_no_amulet_1f4b58fc:

    # "Я хотел сказать, чтобы он прекратил, но слова застряли в горле."
    "Я хацеў сказаць, каб ён перастаў, але словы захраслі ў горле."

# game/scripts/scene/scene_day_4.rpy:12455
translate belarusian d4_madrom_no_amulet_2f2f3e8f:

    # "Мир пошатнулся."
    "Свет пахіснуўся."

# game/scripts/scene/scene_day_4.rpy:12473
translate belarusian d4_madrom_no_amulet_79c86c43:

    # "Я упал на колени."
    "Я ўпаў на калені."

# game/scripts/scene/scene_day_4.rpy:12474
translate belarusian d4_madrom_no_amulet_c2186774:

    # "Стало сложно дышать."
    "Стала цяжка дыхаць."

# game/scripts/scene/scene_day_4.rpy:12475
translate belarusian d4_madrom_no_amulet_d501fb3a:

    # "Словно воздух в лёгком превратился в вязкое тесто."
    "Нібы паветра ў лёгкім ператварылася ў вязкае цеста."

# game/scripts/scene/scene_day_4.rpy:12476
translate belarusian d4_madrom_no_amulet_ccbc8d0e:

    # "Рот наполнился кровью."
    "Рот напоўніўся крывёй."

# game/scripts/scene/scene_day_4.rpy:12486
translate belarusian d4_madrom_no_amulet_65537d7f:

    # "Она выплеснулась на снег."
    "Яна выплюхнулася на снег."

# game/scripts/scene/scene_day_4.rpy:12498
translate belarusian d4_madrom_no_amulet_2e470940:

    # "Неспособный держать голову ровно, я смотрел в эту красную лужицу." id d4_madrom_no_amulet_2e470940
    "Няздольны трымаць галаву роўна, я глядзеў у гэтую чырвоную лужынку."

# game/scripts/scene/scene_day_4.rpy:12512
translate belarusian d4_madrom_no_amulet_8a8b44ec:

    # "Потом я упал в неё лицом."
    "Потым я ўпаў у яе тварам."

# game/scripts/scene/scene_day_4.rpy:12513
translate belarusian d4_madrom_no_amulet_0f008cb0:

    # "Кровь согрела щёку."
    "Кроў сагрэла шчаку."

# game/scripts/scene/scene_day_4.rpy:12514
translate belarusian d4_madrom_no_amulet_460779a6:

    # "Я полежу, и всё пройдёт."
    "Я паляжу, і ўсё пройдзе."

# game/scripts/scene/scene_day_4.rpy:12515
translate belarusian d4_madrom_no_amulet_118a61f1:

    # "Ничего страшного, зашьют врачи..."
    "Нічога страшнага, зашыюць дактары..."

# game/scripts/scene/scene_day_4.rpy:12522
translate belarusian d4_madrom_no_amulet_f856258c:

    # "Ромка схватил меня сзади и резко перевернул на спину."
    "Ромка схапіў мяне ззаду і рэзка перавярнуў на спіну."

# game/scripts/scene/scene_day_4.rpy:12524
translate belarusian d4_madrom_no_amulet_b2823586:

    # "Я увидел его перекошенное лицо и глаза фанатика."
    "Я ўбачыў яго перакошаны твар і вочы фанатыка."

# game/scripts/scene/scene_day_4.rpy:12536
translate belarusian d4_madrom_no_amulet_df62c03b:

    # "Взяв бабочку обеими руками, зарычав, Рома обрушил оружие вниз."
    "Узяўшы матылёк абедзвюма рукамі, зарычаўшы, Рома абрынуў зброю ўніз."

# game/scripts/scene/scene_day_4.rpy:12552
translate belarusian d4_madrom_no_amulet_000cb936:

    # "В мой живот."
    "У мой жывот."

# game/scripts/scene/scene_day_4.rpy:12560
translate belarusian d4_madrom_no_amulet_186822b8:

    # "Боль поглотила разум."
    "Боль паглынуў розум."

# game/scripts/scene/scene_day_4.rpy:12561
translate belarusian d4_madrom_no_amulet_186b6dbf:

    # "Я не мог пошевелиться."
    "Я не мог паварушыцца."

# game/scripts/scene/scene_day_4.rpy:12562
translate belarusian d4_madrom_no_amulet_ebce3b7d:

    # "Не мог даже зажмуриться, хотя на зрачках осели горячие росинки."
    "Не мог нават зажмурыцца, хоць на зрэнках аселі гарачыя расінкі."

# game/scripts/scene/scene_day_4.rpy:12567
translate belarusian d4_madrom_no_amulet_6d7de680:

    # "Нож взмыл вверх."
    "Нож узляцеў уверх."

# game/scripts/scene/scene_day_4.rpy:12589
translate belarusian d4_madrom_no_amulet_187351c0:

    # "Пронзил какой-то пузырь внутри меня."
    "Працяў нейкі пузыр унутры мяне."

# game/scripts/scene/scene_day_4.rpy:12593
translate belarusian d4_madrom_no_amulet_09165ca5:

    # "Взмыл."
    "Узляцеў."

# game/scripts/scene/scene_day_4.rpy:12615
translate belarusian d4_madrom_no_amulet_482c6661:

    # "Опустился."
    "Апусціўся."

# game/scripts/scene/scene_day_4.rpy:12616
translate belarusian d4_madrom_no_amulet_09165ca5_1:

    # "Взмыл."
    "Узляцеў."

# game/scripts/scene/scene_day_4.rpy:12622
translate belarusian d4_madrom_no_amulet_f8d2aa4b:

    # "Ромка кричал и колол."
    "Ромка крычаў і калоў."

# game/scripts/scene/scene_day_4.rpy:12623
translate belarusian d4_madrom_no_amulet_fc59eecd:

    # "Кричал и резал."
    "Крычаў і рэзаў."

# game/scripts/scene/scene_day_4.rpy:12630
translate belarusian d4_madrom_no_amulet_378f99f6:

    # "Кровь плескалась мне в лицо, взлетала широкими багровыми лентами."
    "Кроў плёскалася мне ў твар, узлятала шырокімі барвовымі стужкамі."

# game/scripts/scene/scene_day_4.rpy:12636
translate belarusian d4_madrom_no_amulet_2af9be22:

    # "В голове словно вспыхнули десятки огоньков, но сразу же начали гаснуть один за другим."
    "У галаве нібы ўспыхнулі дзясяткі агеньчыкаў, але адразу ж пачалі гаснуць адзін за адным."

# game/scripts/scene/scene_day_4.rpy:12642
translate belarusian d4_madrom_no_amulet_833b00c3:

    # "И те области мозга, в которых погибали эти странные светлячки, погружались во мрак."
    "І тыя вобласці мозгу, у якіх гінулі гэтыя дзіўныя светлячкі, апускаліся ў змрок."

# game/scripts/scene/scene_day_4.rpy:12648
translate belarusian d4_madrom_no_amulet_4bbc7fca:

    # "Фигура Ромки размывалась."
    "Фігура Ромкі размывалася."

# game/scripts/scene/scene_day_4.rpy:12653
translate belarusian d4_madrom_no_amulet_62938336:

    # "Я перестал следить за ножом."
    "Я перастаў сачыць за нажом."

# game/scripts/scene/scene_day_4.rpy:12712
translate belarusian d4_madrom_no_amulet_7c38ab6f:

    # "Я поднял взгляд – по залитому кровью лицу своего убийцы, вверх, в темнеющее небо."
    "Я падняў позірк — па залітым крывёй твары свайго забойцы, уверх, у неба, што цямнела."

# game/scripts/scene/scene_day_4.rpy:12716
translate belarusian d4_madrom_no_amulet_55f75919:

    # "За долю секунды я увидел жизнь, которую не проживу."
    "За долю секунды я ўбачыў жыццё, якое не пражыву."

# game/scripts/scene/scene_day_4.rpy:12720
translate belarusian d4_madrom_no_amulet_f0346e44:

    # "Миллион упущенных возможностей."
    "Мільён упушчаных магчымасцей."

# game/scripts/scene/scene_day_4.rpy:12721
translate belarusian d4_madrom_no_amulet_9e2db832:

    # "Как зритель в пустом кинозале, я смотрел на экран." id d4_madrom_no_amulet_9e2db832
    "Як глядач у пустой кіназале, я глядзеў на экран."

# game/scripts/scene/scene_day_4.rpy:12733
translate belarusian d4_madrom_no_amulet_ea9fc573:

    # "Я видел Олю, которая повзрослеет, но я не узнаю об этом."
    "Я бачыў Олю, якая пасталее, але я не даведаюся пра гэта."

# game/scripts/scene/scene_day_4.rpy:12734
translate belarusian d4_madrom_no_amulet_bf6db4be:

    # "Я видел её детей, которых не подержу на руках."
    "Я бачыў яе дзяцей, якіх не патрымаю на руках."

# game/scripts/scene/scene_day_4.rpy:12762
translate belarusian d4_madrom_no_amulet_95227c14:

    # "Стареющих родителей в доме на краю леса."
    "Бацькоў, якія старэюць, у доме на краі лесу."

# game/scripts/scene/scene_day_4.rpy:12775
translate belarusian d4_madrom_no_amulet_00b5f09a:

    # "Я видел яркий свет в галереях и выставочных залах, чьи стены не украсят мои картины."
    "Я бачыў яркае святло ў галерэях і выставачных залах, чые сцены не ўпрыгожаць мае карціны."

# game/scripts/scene/scene_day_4.rpy:12787
translate belarusian d4_madrom_no_amulet_9cb43253:

    # "Мостовые городов, по которым не прошагаю."
    "Брукаванкі гарадоў, па якіх не пракрочу."

# game/scripts/scene/scene_day_4.rpy:12788
translate belarusian d4_madrom_no_amulet_af3f9321:

    # "Двадцать первый век, который настанет не для меня."
    "Дваццаць першы век, які настане не для мяне."

# game/scripts/scene/scene_day_4.rpy:12793
translate belarusian d4_madrom_no_amulet_e677661f:

    # "И просто целую вселенную, состоящую из людей и вещей, навсегда мной утраченных."
    "І проста цэлы сусвет, які складаецца з людзей і рэчаў, назаўжды мной страчаных."

# game/scripts/scene/scene_day_4.rpy:12802
translate belarusian d4_madrom_no_amulet_0d917b00:

    # "Ослепительно запылало: то ли в небе, то ли под опускающимися веками."
    "Асляпляльна запалала: ці то ў небе, ці то пад павекамі, што апускаліся."

# game/scripts/scene/scene_day_4.rpy:12803
translate belarusian d4_madrom_no_amulet_87018947:

    # "Нож колол и колол, но боль прошла."
    "Нож калоў і калоў, але боль прайшоў."

# game/scripts/scene/scene_day_4.rpy:12804
translate belarusian d4_madrom_no_amulet_df81be10:

    # "Тело больше не имело значения."
    "Цела больш не мела значэння."

# game/scripts/scene/scene_day_4.rpy:12810
translate belarusian d4_madrom_no_amulet_aad70355:

    # "Фильм закончился."
    "Фільм скончыўся."

# game/scripts/scene/scene_day_4.rpy:12811
translate belarusian d4_madrom_no_amulet_52700098:

    # "Я растворился в бесконечной темноте."
    "Я растварыўся ў бясконцай цемры."

# game/scripts/scene/scene_day_4.rpy:12852
translate belarusian d4_home_devend_fce5f2d1:

    # "Дом темнел на фоне белого поля."
    "Дом цямнеў на фоне белага поля."

# game/scripts/scene/scene_day_4.rpy:12857
translate belarusian d4_home_devend_9f3ead3f:

    # "Входная дверь была открыта и чуть покачивалась от ветра."
    "Уваходныя дзверы былі адчынены і ледзь пагойдваліся ад ветру."

# game/scripts/scene/scene_day_4.rpy:12859
translate belarusian d4_home_devend_02c65b2c:

    # "Мне показалось, что иней покрывает мою кожу."
    "Мне здалося, што іней пакрывае маю скуру."

# game/scripts/scene/scene_day_4.rpy:12860
translate belarusian d4_home_devend_d261f3b2:

    # "Я стиснул кулаки."
    "Я сціснуў кулакі."

# game/scripts/scene/scene_day_4.rpy:12865
translate belarusian d4_home_devend_575521e9:

    # "В ладонь впились острые уголки фотографии с останками Кати."
    "У далонь упіліся вострыя куткі фатаграфіі з астанкамі Каці."

# game/scripts/scene/scene_day_4.rpy:12886
translate belarusian d4_home_devend_4e315b85:

    # "Мрак просачивался в прихожую, а с ним, медленно планируя на ковёр, влетали снежинки."
    "Змрок прасочваўся ў пярэдні пакой, а з ім, павольна планіруючы на дыван, уляталі сняжынкі."

# game/scripts/scene/scene_day_4.rpy:12887
translate belarusian d4_home_devend_23dba9c5:

    # "Будто стая падальщиков, почуявших добычу."
    "Быццам зграя сцярвятнікаў, што ўчулі здабычу."

# game/scripts/scene/scene_day_4.rpy:12891
translate belarusian d4_home_devend_4b0be9a7:

    # "Я вообразил три мясорубки в разных частях дома и трёх близких людей, перемалываемых лезвиями."
    "Я ўявіў тры мясарубкі ў розных частках дома і трох блізкіх людзей, якіх перамолваюць лёзы."

# game/scripts/scene/scene_day_4.rpy:12898
translate belarusian d4_home_devend_1ecdc1bb:

    # "Я осторожно перешагнул порог."
    "Я асцярожна пераступіў парог."

# game/scripts/scene/scene_day_4.rpy:12911
translate belarusian d4_home_devend_87c5d423:

    # "Вдруг услышал, как кто-то говорит на кухне, но это был всего лишь радиоприёмник."
    "Раптам пачуў, як нехта гаворыць на кухні, але гэта быў усяго толькі радыёпрымач."

# game/scripts/scene/scene_day_4.rpy:12920
translate belarusian d4_home_devend_6a300ca5:

    # Radio "...циклон, о котором мы предупреждали, движется к региону. Завтра синоптики обещают ветер с порывами до пятнадцати метров." id d4_home_devend_6a300ca5
    Radio "...цыклон, пра які мы папярэджвалі, рухаецца да рэгіёна. Заўтра сіноптыкі абяцаюць вецер з парывамі да пятнаццаці метраў."

# game/scripts/scene/scene_day_4.rpy:12924
translate belarusian d4_home_devend_4a893069:

    # Radio "МЧС призвало жителей соблюдать меры предосторожности. Дороги перекрыты, холодная воздушная масса арктического происхождения несёт с собой буран..."
    Radio "МНС заклікала жыхароў захоўваць меры засцярогі. Дарогі перакрыты, халодная паветраная маса арктычнага паходжання нясе з сабой буран..."

# game/scripts/scene/scene_day_4.rpy:12932
translate belarusian d4_home_devend_c84cb48a:

    # "Сверху тоже доносились голоса."
    "Зверху таксама даносіліся галасы."

# game/scripts/scene/scene_day_4.rpy:12935
translate belarusian d4_home_devend_3db7cbd2:

    # "Впервые звуки ссоры подействовали успокаивающе."
    "Упершыню гукі сваркі падзейнічалі супакойліва."

# game/scripts/scene/scene_day_4.rpy:12941
translate belarusian d4_home_devend_7a473da3:

    # "Заскрипели протяжно ступеньки."
    "Заскрыпелі працягла прыступкі."

# game/scripts/scene/scene_day_4.rpy:12952
translate belarusian d4_home_devend_42d94d1b:

    # "Я делал шаг, а сердце за это время успевало ударить пять-шесть раз."
    "Я рабіў крок, а сэрца за гэты час паспявала ўдарыць пяць-шэсць разоў."

# game/scripts/scene/scene_day_4.rpy:12955
translate belarusian d4_home_devend_33efb15d:

    # "Дверь родительской комнаты была отворена."
    "Дзверы бацькоўскага пакоя былі адчынены."

# game/scripts/scene/scene_day_4.rpy:12961
translate belarusian d4_home_devend_c8a9b4bb:

    # "В пятне света выступал театр теней. Чёрные силуэты исполняли танец ненависти."
    "У пляме святла выступаў тэатр ценяў. Чорныя сілуэты выконвалі танец нянавісці."

# game/scripts/scene/scene_day_4.rpy:12963
translate belarusian d4_home_devend_71bd040c:

    # "Мамины кисти взметались к потолку, когда она шипела на отца, а он нависал, скрестив руки на широкой груди."
    "Маміны кісці ўскідаліся да столі, калі яна шыпела на бацьку, а ён навісаў, скрыжаваўшы рукі на шырокіх грудзях."

# game/scripts/scene/scene_day_4.rpy:12970
translate belarusian d4_home_devend_a71dc98a:

    # voice "voice/karina/4day/125 Me.ogg"
    # Mam "Мы все в опасности. И всё из-за тебя!"
    voice "voice/karina/4day/125 Me.ogg"
    Mam "Мы ўсе ў небяспецы. І ўсё праз цябе!"

# game/scripts/scene/scene_day_4.rpy:12976
translate belarusian d4_home_devend_d1c5bb75:

    # voice "voice/karina/4day/126 E.ogg"
    # Mam "И не ври! Ты видел его в посёлке!"
    voice "voice/karina/4day/126 E.ogg"
    Mam "І не хлусі! Ты бачыў яго ў пасёлку!"

# game/scripts/scene/scene_day_4.rpy:12978
translate belarusian d4_home_devend_fcd4b10f:

    # voice "voice/karina/4day/127 On.ogg"
    # Mam "Он вычислил, где мы живём!"
    voice "voice/karina/4day/127 On.ogg"
    Mam "Ён вылічыў, дзе мы жывём!"

# game/scripts/scene/scene_day_4.rpy:12980
translate belarusian d4_home_devend_2654c723:

    # voice "voice/father/day4/74 Eto.ogg"
    # Pap "Это был не он."
    voice "voice/father/day4/74 Eto.ogg"
    Pap "Гэта быў не ён."

# game/scripts/scene/scene_day_4.rpy:12982
translate belarusian d4_home_devend_7339df07:

    # voice "voice/karina/4day/128 Ya.ogg"
    # Mam "Я читала в газетах, на что способны твои дружки."
    voice "voice/karina/4day/128 Ya.ogg"
    Mam "Я чытала ў газетах, на што здольныя твае дружкі."

# game/scripts/scene/scene_day_4.rpy:12990
translate belarusian d4_home_devend_b869dfdc:

    # "Я сунул фотографию в карман и пробежал к спальне."
    "Я сунуў фатаграфію ў кішэню і прабег да спальні."

# game/scripts/scene/scene_day_4.rpy:12992
translate belarusian d4_home_devend_f5e59a6f:

    # "Я пробежал к спальне."
    "Я прабег да спальні."

# game/scripts/scene/scene_day_4.rpy:12996
translate belarusian d4_home_devend_a7a24b0b:

    # "Родители снова ссорились, выясняли отношения, сыпали взаимными обвинениями."
    "Бацькі зноў сварыліся, высвятлялі адносіны, сыпалі ўзаемнымі абвінавачваннямі."

# game/scripts/scene/scene_day_4.rpy:13007
translate belarusian d4_home_devend_27b57de3:

    # "Отец низко, по-звериному, зарычал."
    "Бацька нізка, па-звярынаму, зарычаў."

# game/scripts/scene/scene_day_4.rpy:13019
translate belarusian d4_home_devend_e514b770:

    # voice "voice/olya/4day/01 P.ogg"
    # Oly "Пусть они прекратят."
    voice "voice/olya/4day/01 P.ogg"
    Oly "Няхай яны перастануць."

# game/scripts/scene/scene_day_4.rpy:13023
translate belarusian d4_home_devend_aafa097a:

    # "Оля стояла в коридоре, прижав ладошки к ушам."
    "Оля стаяла ў калідоры, прыціснуўшы далонькі да вушэй."

# game/scripts/scene/scene_day_4.rpy:13026
translate belarusian d4_home_devend_bb17906b:

    # "Я отогнал видение, в котором сестру поглощали лезвия мясорубки."
    "Я адагнаў відзеж, у якім сястру паглыналі лёзы мясарубкі."

# game/scripts/scene/scene_day_4.rpy:13028
translate belarusian d4_home_devend_ab56e0f4:

    # "Я отогнал видение, в котором сестру за мои грехи убивал ножом Ромка."
    "Я адагнаў відзеж, у якім сястру за мае грахі забіваў нажом Ромка."

# game/scripts/scene/scene_day_4.rpy:13037
translate belarusian d4_home_devend_526f22af:

    # "Опухшее от слёз личико заставило меня похолодеть."
    "Апухлы ад слёз тварык прымусіў мяне пахаладзець."

# game/scripts/scene/scene_day_4.rpy:13040
translate belarusian d4_home_devend_32928d7e:

    # "И почти вытолкнуло из мыслей кровавый образ Кати."
    "І амаль выштурхнуў з думак крывавы вобраз Каці."

# game/scripts/scene/scene_day_4.rpy:13042
translate belarusian d4_home_devend_2ae3d40f:

    # "И почти вытолкнуло из мыслей образ скалящегося деда Харитона и скачущего на четвереньках Пятифана."
    "І амаль выштурхнуў з думак вобраз дзеда Харытона, што скаліўся, і Пяціфана, які скакаў на карачках."

# game/scripts/scene/scene_day_4.rpy:13044
translate belarusian d4_home_devend_2ffe2945:

    # voice "voice/anton/4day/168. Chto.ogg"
    # Ant "Что случилось?"
    voice "voice/anton/4day/168. Chto.ogg"
    Ant "Што здарылася?"

# game/scripts/scene/scene_day_4.rpy:13051
translate belarusian d4_home_devend_24d8a805:

    # voice "voice/olya/4day/02 O.ogg"
    # Oly "Они разведутся."
    voice "voice/olya/4day/02 O.ogg"
    Oly "Яны развядуцца."

# game/scripts/scene/scene_day_4.rpy:13062
translate belarusian d4_home_devend_a338feb1:

    # "Я обнял сестру и прижал к себе."
    "Я абняў сястру і прыціснуў да сябе."

# game/scripts/scene/scene_day_4.rpy:13063
translate belarusian d4_home_devend_d3c89123:

    # "Язык отказывался повиноваться, искать утешение."
    "Язык адмаўляўся слухацца, шукаць суцяшэнне."

# game/scripts/scene/scene_day_4.rpy:13065
translate belarusian d4_home_devend_8cb648bb:

    # "Крики будто звучали сразу отовсюду: справа и слева, снизу и сверху. Били по макушке."
    "Крыкі быццам гучалі адразу адусюль: справа і злева, знізу і зверху. Білі па макаўцы."

# game/scripts/scene/scene_day_4.rpy:13072
translate belarusian d4_home_devend_1a68a870:

    # "Ругань падала нам на головы, и мы прикрыли их руками, как спасающиеся от бомбёжки беженцы."
    "Лаянка падала нам на галовы, і мы прыкрылі іх рукамі, як бежанцы, што ратуюцца ад бамбёжкі."

# game/scripts/scene/scene_day_4.rpy:13075
translate belarusian d4_home_devend_5c22eb8e:

    # voice "voice/olya/4day/03 Ya.ogg"
    # Oly "Я хочу уйти!"
    voice "voice/olya/4day/03 Ya.ogg"
    Oly "Я хачу сысці!"

# game/scripts/scene/scene_day_4.rpy:13078
translate belarusian d4_home_devend_8da83c29:

    # voice "voice/anton/4day/169. V.ogg"
    # Ant "В свою комнату?"
    voice "voice/anton/4day/169. V.ogg"
    Ant "У свой пакой?"

# game/scripts/scene/scene_day_4.rpy:13081
translate belarusian d4_home_devend_9fca7395:

    # voice "voice/olya/4day/04 Ne.ogg"
    # Oly "Нет! Дальше!"
    voice "voice/olya/4day/04 Ne.ogg"
    Oly "Не! Далей!"

# game/scripts/scene/scene_day_4.rpy:13085
translate belarusian d4_home_devend_4efba16f:

    # voice "voice/olya/4day/05 O.ogg"
    # Oly "Отведи меня в Небыляндию! Ты обещал!"
    voice "voice/olya/4day/05 O.ogg"
    Oly "Адвядзі мяне ў Небыляндыю! Ты абяцаў!"

# game/scripts/scene/scene_day_4.rpy:13099
translate belarusian d4_home_devend_88ec629f:

    # "Я осторожно отнял её руки от ушей и повёл мимо вибрирующей яростью спальни родителей."
    "Я асцярожна адняў яе рукі ад вушэй і павёў міма спальні бацькоў, што вібравала лютасцю."

# game/scripts/scene/scene_day_4.rpy:13109
translate belarusian d4_home_devend_bb44ce1f:

    # voice "voice/karina/4day/129 Ez.ogg"
    # Mam "Из-за тебя!"
    voice "voice/karina/4day/129 Ez.ogg"
    Mam "Праз цябе!"

# game/scripts/scene/scene_day_4.rpy:13119
translate belarusian d4_home_devend_b67bf11f:

    # voice "voice/father/day4/79 Ra.ogg"
    # Pap "Ради кого..."
    voice "voice/father/day4/79 Ra.ogg"
    Pap "Дзеля каго..."

# game/scripts/scene/scene_day_4.rpy:13127
translate belarusian d4_home_devend_82fece35:

    # voice "voice/karina/4day/130 To.ogg"
    # Mam "Только себя!"
    voice "voice/karina/4day/130 To.ogg"
    Mam "Толькі сябе!"

# game/scripts/scene/scene_day_4.rpy:13133
translate belarusian d4_home_devend_38717d0b:

    # voice "voice/father/day4/80 Ni.ogg"
    # Pap "Никогда в жизни!"
    voice "voice/father/day4/80 Ni.ogg"
    Pap "Ніколі ў жыцці!"

# game/scripts/scene/scene_day_4.rpy:13136
translate belarusian d4_home_devend_2732c8d6:

    # "В эти минуты я презирал их сильнее, чем они презирали друг друга."
    "У гэтыя хвіліны я пагарджаў імі мацней, чым яны пагарджалі адно адным."

# game/scripts/scene/scene_day_4.rpy:13149
translate belarusian d4_home_devend_2dc351ab:

    # "В комнате я заперся на шпингалет и прислонился к дверям. Колени подгибались."
    "У пакоі я замкнуўся на шпінгалет і прыхінуўся да дзвярэй. Калені падгіналіся."

# game/scripts/scene/scene_day_4.rpy:13153
translate belarusian d4_home_devend_eea08eb0:

    # voice "voice/anton/4day/170. Pos.ogg"
    # Ant "Послушай, Оля. Мне тоже здесь плохо."
    voice "voice/anton/4day/170. Pos.ogg"
    Ant "Паслухай, Оля. Мне таксама тут дрэнна."

# game/scripts/scene/scene_day_4.rpy:13157
translate belarusian d4_home_devend_ee4aff83:

    # voice "voice/olya/4day/06 Ti.ogg"
    # Oly "Ты хотя бы в школу ходишь!"
    voice "voice/olya/4day/06 Ti.ogg"
    Oly "Ты хаця б у школу ходзіш!"

# game/scripts/scene/scene_day_4.rpy:13162
translate belarusian d4_home_devend_47394893:

    # "Я невесело хохотнул."
    "Я нявесела рагатнуў."

# game/scripts/scene/scene_day_4.rpy:13163
translate belarusian d4_home_devend_4313de47:

    # voice "voice/anton/4day/171. Eta.ogg"
    # Ant "Эта школа — кошмар! Меня там все ненавидят!"
    voice "voice/anton/4day/171. Eta.ogg"
    Ant "Гэтая школа — кашмар! Мяне там усе ненавідзяць!"

# game/scripts/scene/scene_day_4.rpy:13165
translate belarusian d4_home_devend_4ba292b1:

    # voice "voice/anton/4day/173. To.ogg"
    # Ant "Только одна девочка надо мной не смеётся. Зато жалеет, как побитого пса."
    voice "voice/anton/4day/173. To.ogg"
    Ant "Толькі адна дзяўчынка з мяне не смяецца. Затое шкадуе, як пабітага пса."

# game/scripts/scene/scene_day_4.rpy:13169
translate belarusian d4_home_devend_e6c76c16:

    # voice "voice/olya/4day/07Tine.ogg"
    # Oly "Ты не пёс! Ты..."
    voice "voice/olya/4day/07Tine.ogg"
    Oly "Ты не пёс! Ты..."

# game/scripts/scene/scene_day_4.rpy:13173
translate belarusian d4_home_devend_f44df905:

    # voice "voice/anton/4day/174. Ya.ogg"
    # Ant "Я не понимаю, кто я."
    voice "voice/anton/4day/174. Ya.ogg"
    Ant "Я не разумею, хто я."

# game/scripts/scene/scene_day_4.rpy:13175
translate belarusian d4_home_devend_4bf03a4a:

    # voice "voice/anton/4day/175.No.ogg"
    # Ant "Но там, снаружи, ничем не лучше, чем в доме."
    voice "voice/anton/4day/175.No.ogg"
    Ant "Але там, звонку, нічым не лепш, чым у доме."

# game/scripts/scene/scene_day_4.rpy:13179
translate belarusian d4_home_devend_e87b4a64:

    # voice "voice/olya/4day/08 Gd.ogg"
    # Oly "Где же лучше? Давай пойдём туда! Полетим, поплывём!"
    voice "voice/olya/4day/08 Gd.ogg"
    Oly "Дзе ж лепш? Давай пойдзем туды! Паляцім, паплывём!"

# game/scripts/scene/scene_day_4.rpy:13183
translate belarusian d4_home_devend_b2b40cf0:

    # voice "voice/anton/4day/173. Es.ogg"
    # Ant "Если б можно было... я бы всё на свете отдал, чтобы уйти и забрать тебя с собой."
    voice "voice/anton/4day/173. Es.ogg"
    Ant "Калі б можна было... я б усё на свеце аддаў, каб сысці і забраць цябе з сабой."

# game/scripts/scene/scene_day_4.rpy:13185
translate belarusian d4_home_devend_cf4ad8f0:

    # "Верхняя губа Оли дрогнула."
    "Верхняя губа Олі здрыганулася."

# game/scripts/scene/scene_day_4.rpy:13188
translate belarusian d4_home_devend_2e8d1e5a:

    # voice "voice/olya/4day/09K.ogg"
    # Oly "Клянёшься?"
    voice "voice/olya/4day/09K.ogg"
    Oly "Клянешся?"

# game/scripts/scene/scene_day_4.rpy:13192
translate belarusian d4_home_devend_9f2c25fd:

    # "Я горько улыбнулся и сказал:"
    "Я горка ўсміхнуўся і сказаў:"

# game/scripts/scene/scene_day_4.rpy:13193
translate belarusian d4_home_devend_049fb58f:

    # voice "voice/anton/4day/174. Chto.ogg"
    # Ant "Чтоб мне умереть!"
    voice "voice/anton/4day/174. Chto.ogg"
    Ant "Каб мне памерці!"

# game/scripts/scene/scene_day_4.rpy:13200
translate belarusian d4_home_devend_7913295c:

    # voice "voice/olya/4day/10 Po.ogg"
    # Oly "Почему тебя не было так долго?"
    voice "voice/olya/4day/10 Po.ogg"
    Oly "Чаму цябе не было так доўга?"

# game/scripts/scene/scene_day_4.rpy:13205
translate belarusian d4_home_devend_5eefda11:

    # voice "voice/anton/4day/176. ya.ogg"
    # Ant "Я был в гостях... у одних странных людей."
    voice "voice/anton/4day/176. ya.ogg"
    Ant "Я быў у гасцях... у адных дзіўных людзей."

# game/scripts/scene/scene_day_4.rpy:13209
translate belarusian d4_home_devend_81ba83d6:

    # voice "voice/olya/4day/12 oni.ogg"
    # Oly "Они тоже разводятся?"
    voice "voice/olya/4day/12 oni.ogg"
    Oly "Яны таксама разводзяцца?"

# game/scripts/scene/scene_day_4.rpy:13214
translate belarusian d4_home_devend_9b3b85df:

    # voice "voice/anton/4day/175.  Y.ogg"
    # Ant "Я пытался помочь одной девочке."
    voice "voice/anton/4day/175.  Y.ogg"
    Ant "Я спрабаваў дапамагчы адной дзяўчынцы."

# game/scripts/scene/scene_day_4.rpy:13218
translate belarusian d4_home_devend_f5818d1d:

    # voice "voice/olya/4day/11 T.ogg"
    # Oly "Ты помог ей?" id d4_home_devend_f5818d1d
    voice "voice/olya/4day/11 T.ogg"
    Oly "Ты дапамог ёй?"

# game/scripts/scene/scene_day_4.rpy:13222
translate belarusian d4_home_devend_e693c21f:

    # voice "voice/anton/4day/177. Ne.ogg"
    # Ant "Не думаю."
    voice "voice/anton/4day/177. Ne.ogg"
    Ant "Не думаю."

# game/scripts/scene/scene_day_4.rpy:13246
translate belarusian d4_home_devend_2338354b:

    # "Заслонив письменный стол, я осторожно выдвинул ящик и бросил туда фотографию с окровавленной Катиной косой."
    "Засланіўшы пісьмовы стол, я асцярожна высунуў шуфляду і кінуў туды фатаграфію з акрываўленай Кацінай касой."

# game/scripts/scene/scene_day_4.rpy:13258
translate belarusian d4_home_devend_635b3606:

    # "Оля попыталась заглянуть мне за спину, но я резко закрыл его."
    "Оля паспрабавала зазірнуць мне за спіну, але я рэзка зачыніў яе."

# game/scripts/scene/scene_day_4.rpy:13276
translate belarusian d4_beasts_4550171d:

    # "И одновременно с этим что-то стукнуло о карниз снаружи."
    "І адначасова з гэтым нешта стукнула аб карніз звонку."

# game/scripts/scene/scene_day_4.rpy:13279
translate belarusian d4_beasts_7c780c94:

    # "Что-то стукнуло о карниз снаружи."
    "Нешта стукнула аб карніз звонку."

# game/scripts/scene/scene_day_4.rpy:13283
translate belarusian d4_beasts_c3ac3642:

    # "Оля вздрогнула и бросила взгляд на окно."
    "Оля ўздрыгнула і кінула позірк на акно."

# game/scripts/scene/scene_day_4.rpy:13292
translate belarusian d4_beasts_7a101568:

    # "«Бам!» — снежок повторно шлёпнулся в раму."
    "«Бам!» — сняжок паўторна ляпнуўся ў раму."

# game/scripts/scene/scene_day_4.rpy:13295
translate belarusian d4_beasts_5d024f0c:

    # voice "voice/olya/4day/14 Ti.ogg"
    # Oly "Ты ждёшь кого-то?"
    voice "voice/olya/4day/14 Ti.ogg"
    Oly "Ты чакаеш кагосьці?"

# game/scripts/scene/scene_day_4.rpy:13298
translate belarusian d4_beasts_7fe9a557:

    # "Я не ответил."
    "Я не адказаў."

# game/scripts/scene/scene_day_4.rpy:13305
translate belarusian d4_beasts_8a307fc4:

    # "Отпустил её запястье – она всхлипнула испуганно."
    "Адпусціў яе запясце — яна ўсхліпнула спалохана."

# game/scripts/scene/scene_day_4.rpy:13310
translate belarusian d4_beasts_68da4db8:

    # "Я прошёл по комнате, морщась от каждого родительского вскрика. Билась посуда – папа с мамой переместились на кухню."
    "Я прайшоў па пакоі, моршчачыся ад кожнага бацькоўскага ўскрыку. Біўся посуд — тата з мамай перамясціліся на кухню."

# game/scripts/scene/scene_day_4.rpy:13359
translate belarusian d4_beasts_72054b3a:

    # "Я отдёрнул штору и рывком распахнул окно."
    "Я адшморгнуў штору і рыўком расчыніў акно."

# game/scripts/scene/scene_day_4.rpy:13376
translate belarusian d4_beasts_6e481126:

    # "Совушка, Медвежутка, Волчик и, конечно, пленительная Алиса, – все были в сборе и махали нам снизу."
    "Савушка, Мядзведжутка, Воўчык і, вядома, чароўная Аліса — усе былі ў зборы і махалі нам знізу."

# game/scripts/scene/scene_day_4.rpy:13383
translate belarusian d4_beasts_9ba68ee9:

    # "Оля ойкнула, завидев девочку-птицу."
    "Оля ойкнула, убачыўшы дзяўчынку-птушку."

# game/scripts/scene/scene_day_4.rpy:13385
translate belarusian d4_beasts_5ab8fd51:

    # voice "voice/olya/4day/16 Ya.ogg"
    # Oly "Я же говорила."
    voice "voice/olya/4day/16 Ya.ogg"
    Oly "Я ж казала."

# game/scripts/scene/scene_day_4.rpy:13387
translate belarusian d4_beasts_15db6a80:

    # voice "voice/anton/4day/178. Da.ogg"
    # Ant "Да, знаю. Я тебе всегда верил."
    voice "voice/anton/4day/178. Da.ogg"
    Ant "Так, ведаю. Я табе заўсёды верыў."

# game/scripts/scene/scene_day_4.rpy:13389
translate belarusian d4_beasts_b52b0021:

    # voice "voice/olya/4day/17 K.ogg"
    # Oly "Кто они?"
    voice "voice/olya/4day/17 K.ogg"
    Oly "Хто яны?"

# game/scripts/scene/scene_day_4.rpy:13391
translate belarusian d4_beasts_438664f7:

    # "Помимо страха, в голосе звучало любопытство."
    "Акрамя страху, у голасе гучала цікаўнасць."

# game/scripts/scene/scene_day_4.rpy:13395
translate belarusian d4_beasts_710e860f:

    # voice "voice/Alisa/4day/05Chob.ogg"
    # Alis "Чтобы в такую погоду дома сидеть, надо быть очень скучными детьми!"
    voice "voice/Alisa/4day/05Chob.ogg"
    Alis "Каб у такое надвор'е дома сядзець, трэба быць вельмі нуднымі дзецьмі!"

# game/scripts/scene/scene_day_4.rpy:13399
translate belarusian d4_beasts_4549cb9c:

    # voice "voice/Owl/4day/06 U.ogg"
    # Owl "У нас столько игр неигранных – ух-ух-ух!"
    voice "voice/Owl/4day/06 U.ogg"
    Owl "У нас столькі гульняў негуляных — ух-ух-ух!"

# game/scripts/scene/scene_day_4.rpy:13403
translate belarusian d4_beasts_0d2e6d3d:

    # voice "voice/Bear/4day/22 Dav.ogg"
    # Bear "Давайте только не во все игры играть, а то у меня лапка болит."
    voice "voice/Bear/4day/22 Dav.ogg"
    Bear "Давайце толькі не ва ўсе гульні гуляць, а то ў мяне лапка баліць."

# game/scripts/scene/scene_day_4.rpy:13405
translate belarusian d4_beasts_ed60f675:

    # voice "voice/Bear/4day/23 Po.ogg"
    # Bear "По чуть-чуть — и потом отдохнём."
    voice "voice/Bear/4day/23 Po.ogg"
    Bear "Патрошку — і потым адпачнём."

# game/scripts/scene/scene_day_4.rpy:13409
translate belarusian d4_beasts_cc4a3f79:

    # voice "voice/Wolf/317 Dr.ogg"
    # Wolf "Др-р-р-рузья!"
    voice "voice/Wolf/317 Dr.ogg"
    Wolf "Сяб-р-р-р-ры!"

# game/scripts/scene/scene_day_4.rpy:13414
translate belarusian d4_beasts_ec4ca3d6:

    # voice "voice/Alisa/4day/05Vihod.ogg"
    # Animals "Выходите скорее играть и танцевать!"
    voice "voice/Alisa/4day/05Vihod.ogg"
    Animals "Выходзьце хутчэй гуляць і танцаваць!"

# game/scripts/scene/scene_day_4.rpy:13420
translate belarusian d4_beasts_773288f4:

    # "При виде Алисы сердце забилось сильнее, а внутренний голос буквально кричал: {i}«Наконец-то! Она здесь!»{i}"
    "Пры выглядзе Алісы сэрца забілася мацней, а ўнутраны голас літаральна крычаў: {i}«Нарэшце! Яна тут!»{/i}"

# game/scripts/scene/scene_day_4.rpy:13422
translate belarusian d4_beasts_0b1b6abd:

    # voice "voice/olya/4day/18 A.ogg"
    # Oly "А они знают, как попасть в Небыляндию?"
    voice "voice/olya/4day/18 A.ogg"
    Oly "А яны ведаюць, як трапіць у Небыляндыю?"

# game/scripts/scene/scene_day_4.rpy:13424
translate belarusian d4_beasts_e64091b2:

    # "Я прикидывал, глядя на зверят."
    "Я прыкідваў, гледзячы на зверанят."

# game/scripts/scene/scene_day_4.rpy:13436
translate belarusian d4_beasts_c1f62110:

    # voice "voice/anton/4day/179. Mo.ogg"
    # Ant "Может быть. Пойдём и узнаем!"
    voice "voice/anton/4day/179. Mo.ogg"
    Ant "Можа быць. Пойдзем і даведаемся!"

# game/scripts/scene/scene_day_4.rpy:13464
translate belarusian d4_beasts_1fa7fb3c:

    # "Фигурки лесных друзей обещали избавление от горя, гнева и ужасов ночи."
    "Фігуркі лясных сяброў абяцалі збавенне ад гора, гневу і жахаў ночы."

# game/scripts/scene/scene_day_4.rpy:13478
translate belarusian d4_beasts_8fac9ee2:

    # "Я проследил, чтобы Оля закуталась потеплее."
    "Я прасачыў, каб Оля захуталася цяплей."

# game/scripts/scene/scene_day_4.rpy:13492
translate belarusian d4_beasts_fcaa9b90:

    # "Мама лаяла на отца отрывисто, как дикое животное из передачи {u}Николая Дроздова.{/u}"
    "Мама брахала на бацьку адрывіста, як дзікая жывёліна з перадачы {u}Мікалая Драздова.{/u}"

# game/scripts/scene/scene_day_4.rpy:13508
translate belarusian d4_beasts_758afeb5:

    # "Мы просеменили мимо гремящей кухни и выскользнули под снегопад."
    "Мы прабеглі дробнымі крокамі міма грымлівай кухні і выслізнулі пад снегапад."

# game/scripts/scene/scene_day_4.rpy:13558
translate belarusian d4_beasts_89508a77:

    # "Ко мне тут же подбежала Алиса и обняла меня, уткнувшись холодным носом в шею."
    "Да мяне тут жа падбегла Аліса і абняла мяне, уткнуўшыся халодным носам у шыю."

# game/scripts/scene/scene_day_4.rpy:13561
translate belarusian d4_beasts_375b0991:

    # voice "voice/Alisa/4day/55 Kak.ogg"
    # Alis "Как же долго-о-о!"
    voice "voice/Alisa/4day/55 Kak.ogg"
    Alis "Як жа доўга-а-а!"

# game/scripts/scene/scene_day_4.rpy:13563
translate belarusian d4_beasts_cbb7c71a:

    # voice "voice/Alisa/4day/56 Poka.ogg"
    # Alis "Пока мы вас, домоседов, ждали, то чуть не состарились."
    voice "voice/Alisa/4day/56 Poka.ogg"
    Alis "Пакуль мы вас, дамаседаў, чакалі, то ледзь не састарыліся."

# game/scripts/scene/scene_day_4.rpy:13573
translate belarusian d4_beasts_3aa41bd2:

    # "Она прижалась ещё сильнее."
    "Яна прыціснулася яшчэ мацней."

# game/scripts/scene/scene_day_4.rpy:13586
translate belarusian d4_beasts_8e13c15e:

    # voice "voice/Bear/4day/25 Okaz.ogg"
    # Bear "Оказывается, ждать так утомительно."
    voice "voice/Bear/4day/25 Okaz.ogg"
    Bear "Аказваецца, чакаць так стомна."

# game/scripts/scene/scene_day_4.rpy:13588
translate belarusian d4_beasts_01f81188:

    # voice "voice/Bear/4day/26 Fuh.ogg"
    # Bear "Фух! Дайте хоть минуточку в себя прийти."
    voice "voice/Bear/4day/26 Fuh.ogg"
    Bear "Фух! Дайце хоць хвіліначку ў сябе прыйсці."

# game/scripts/scene/scene_day_4.rpy:13602
translate belarusian d4_beasts_8b1dc4f1:

    # voice "voice/Owl/4day/06 Od.ogg"
    # Owl "Однажды я тоже долго собиралась – уху, – а когда закончила, то и вовсе забыла куда."
    voice "voice/Owl/4day/06 Od.ogg"
    Owl "Аднойчы я таксама доўга збіралася — уху, — а калі скончыла, то і зусім забылася куды."

# game/scripts/scene/scene_day_4.rpy:13621
translate belarusian d4_beasts_362ff3c7:

    # "Оля смотрела на Сову с подозрением."
    "Оля глядзела на Саву з падазрэннем."

# game/scripts/scene/scene_day_4.rpy:13633
translate belarusian d4_beasts_bc8a8f8c:

    # "Но хихикнула, когда та вдруг перекувыркнулась через себя и лихо встала на снег, даже не пошатнувшись."
    "Але хіхікнула, калі тая раптам перакулілася праз сябе і хвацка ўстала на снег, нават не пахіснуўшыся."

# game/scripts/scene/scene_day_4.rpy:13652
translate belarusian d4_beasts_803dc86e:

    # "Остальные звери, как по команде, перестали дурачиться и тоже заворожённо посмотрели на Олю."
    "Астатнія звяры, як па камандзе, перасталі дурэць і таксама зачаравана паглядзелі на Олю."

# game/scripts/scene/scene_day_4.rpy:13654
translate belarusian d4_beasts_239ffaec:

    # voice "voice/Owl/4day/04 Eto.ogg"
    # Owl "Это же та девочка, что не хотела со мной дружить!"
    voice "voice/Owl/4day/04 Eto.ogg"
    Owl "Гэта ж тая дзяўчынка, што не хацела са мной сябраваць!"

# game/scripts/scene/scene_day_4.rpy:13676
translate belarusian d4_beasts_6873312f:

    # voice "voice/olya/4day/20 M.ogg"
    # Oly "Меня зовут Оля."
    voice "voice/olya/4day/20 M.ogg"
    Oly "Мяне завуць Оля."

# game/scripts/scene/scene_day_4.rpy:13680
translate belarusian d4_beasts_aaa07375:

    # voice "voice/olya/4day/21 R.ogg"
    # Oly "Раньше я... Ну... Я просто тебя боялась."
    voice "voice/olya/4day/21 R.ogg"
    Oly "Раней я... Ну... Я проста цябе баялася."

# game/scripts/scene/scene_day_4.rpy:13706
translate belarusian d4_beasts_69b50d39:

    # voice "voice/Alisa/4day/57 Teb.ogg"
    # Alis "Тебя испугала наша Совушка?"
    voice "voice/Alisa/4day/57 Teb.ogg"
    Alis "Цябе спалохала наша Савушка?"

# game/scripts/scene/scene_day_4.rpy:13711
translate belarusian d4_beasts_71254f44:

    # voice "voice/Bear/4day/27 Moz.ogg"
    # Bear "Может быть, у неё совофобия?"
    voice "voice/Bear/4day/27 Moz.ogg"
    Bear "Можа быць, у яе савафобія?"

# game/scripts/scene/scene_day_4.rpy:13716
translate belarusian d4_beasts_a6109cce:

    # voice "voice/Owl/4day/05 A.ogg"
    # Owl "А это лечится?"
    voice "voice/Owl/4day/05 A.ogg"
    Owl "А гэта лечыцца?"

# game/scripts/scene/scene_day_4.rpy:13724
translate belarusian d4_beasts_ad669580:

    # voice "voice/Alisa/4day/58 Glavn.ogg"
    # Alis "Главное, чтобы ребёнок не боялся веселиться."
    voice "voice/Alisa/4day/58 Glavn.ogg"
    Alis "Галоўнае, каб дзіця не баялася весяліцца."

# game/scripts/scene/scene_day_4.rpy:13735
translate belarusian d4_beasts_06166f74:

    # voice "voice/Alisa/4day/59 Inach.ogg"
    # Alis "Иначе с нами можно умереть от страха. Аха-ха-ха-ха!"
    voice "voice/Alisa/4day/59 Inach.ogg"
    Alis "Інакш з намі можна памерці ад страху. Аха-ха-ха-ха!"

# game/scripts/scene/scene_day_4.rpy:13740
translate belarusian d4_beasts_cd49beaa:

    # "Я поразился, поняв, что губы мои складываются в улыбку."
    "Я ўразіўся, зразумеўшы, што губы мае складваюцца ва ўсмешку."

# game/scripts/scene/scene_day_4.rpy:13743
translate belarusian d4_beasts_46eac13e:

    # "И это после всего, что я видел в гостях у Полины!"
    "І гэта пасля ўсяго, што я бачыў у гасцях у Паліны!"

# game/scripts/scene/scene_day_4.rpy:13745
translate belarusian d4_beasts_ae6290b7:

    # "И это после всего, что я видел в Гараже!"
    "І гэта пасля ўсяго, што я бачыў у Гаражы!"

# game/scripts/scene/scene_day_4.rpy:13747
translate belarusian d4_beasts_62bf107d:

    # "Встречаясь с Алисой, я будто переходил через реку, журчание которой глушило все дурные мысли."
    "Сустракаючыся з Алісай, я быццам пераходзіў праз раку, цурчанне якой глушыла ўсе благія думкі."

# game/scripts/scene/scene_day_4.rpy:13768
translate belarusian d4_beasts_3a30babc:

    # voice "voice/olya/4day/22 Ka.ogg"
    # Oly "Какие у вас красивые костюмы!"
    voice "voice/olya/4day/22 Ka.ogg"
    Oly "Якія ў вас прыгожыя касцюмы!"

# game/scripts/scene/scene_day_4.rpy:13780
translate belarusian d4_beasts_53a09897:

    # "Девочка-лисичка разжала свои объятия и присела рядом с Олей."
    "Дзяўчынка-лісічка разняла свае абдымкі і прысела побач з Оляй."

# game/scripts/scene/scene_day_4.rpy:13781
translate belarusian d4_beasts_daf56785:

    # voice "voice/Alisa/4day/60 Oo.ogg"
    # Alis "О, какая очаровашка!"
    voice "voice/Alisa/4day/60 Oo.ogg"
    Alis "О, якая харашуня!"

# game/scripts/scene/scene_day_4.rpy:13783
translate belarusian d4_beasts_5eefb190:

    # voice "voice/Alisa/4day/61 Anto.ogg"
    # Alis "Антоша, почему ты прятал от нас это милое создание раньше?"
    voice "voice/Alisa/4day/61 Anto.ogg"
    Alis "Антоша, чаму ты хаваў ад нас гэтае мілае стварэнне раней?"

# game/scripts/scene/scene_day_4.rpy:13787
translate belarusian d4_beasts_d66dc5ae:

    # "Я покосился на дом, опасаясь, что родители могли заметить нас и как всегда испортить всё веселье."
    "Я пакасіўся на дом, асцерагаючыся, што бацькі маглі заўважыць нас і, як заўсёды, сапсаваць усю весялосць."

# game/scripts/scene/scene_day_4.rpy:13788
translate belarusian d4_beasts_736d69df:

    # "И сказал, обняв сестру:"
    "І сказаў, абняўшы сястру:"

# game/scripts/scene/scene_day_4.rpy:13789
translate belarusian d4_beasts_8daf294a:

    # voice "voice/anton/4day/180.Da.ogg"
    # Ant "Давайте отойдём подальше."
    voice "voice/anton/4day/180.Da.ogg"
    Ant "Давайце адыдзем падалей."

# game/scripts/scene/scene_day_4.rpy:13791
translate belarusian d4_beasts_605ec087:

    # voice "voice/Alisa/4day/62 Zapr.ogg"
    # Alis "Запросто!"
    voice "voice/Alisa/4day/62 Zapr.ogg"
    Alis "Запраста!"

# game/scripts/scene/scene_day_4.rpy:13809
translate belarusian d4_beasts_e8e78cf8:

    # voice "voice/Alisa/4day/63 Ol.ogg"
    # Alis "Оля, а ты знаешь, как найти в нашем лесу Деда Мороза?"
    voice "voice/Alisa/4day/63 Ol.ogg"
    Alis "Оля, а ты ведаеш, як знайсці ў нашым лесе Дзеда Мароза?"

# game/scripts/scene/scene_day_4.rpy:13824
translate belarusian d4_beasts_18b2a729:

    # "Глаза сестрёнки округлились."
    "Вочы сястрычкі акругліліся."

# game/scripts/scene/scene_day_4.rpy:13830
translate belarusian d4_beasts_892d6ca4:

    # voice "voice/olya/4day/23 K.ogg"
    # Oly "Как?"
    voice "voice/olya/4day/23 K.ogg"
    Oly "Як?"

# game/scripts/scene/scene_day_4.rpy:13834
translate belarusian d4_beasts_492495ad:

    # voice "voice/Alisa/4day/64 Nu.ogg"
    # Alis "Нужно идти по сладкой тропинке."
    voice "voice/Alisa/4day/64 Nu.ogg"
    Alis "Трэба ісці па салодкай сцяжынцы."

# game/scripts/scene/scene_day_4.rpy:13858
translate belarusian d4_beasts_2be8123e:

    # "Алиса наклонилась и вынула из снега конфету."
    "Аліса нахілілася і выняла са снегу цукерку."

# game/scripts/scene/scene_day_4.rpy:13860
translate belarusian d4_beasts_9a8b951e:

    # "Оля всплеснула ладошками."
    "Оля ўспляснула далонькамі."

# game/scripts/scene/scene_day_4.rpy:13861
translate belarusian d4_beasts_0b0b8933:

    # "Посмотрела на меня вопросительно — я кивнул."
    "Паглядзела на мяне пытальна — я кіўнуў."

# game/scripts/scene/scene_day_4.rpy:13868
translate belarusian d4_beasts_c251c651:

    # "Сестра захрустела конфетой."
    "Сястра захрумсцела цукеркай."

# game/scripts/scene/scene_day_4.rpy:13873
translate belarusian d4_beasts_d1ea2144:

    # voice "voice/Owl/4day/10 Un.ogg"
    # Owl "У нас что – уху – в лесу завёлся Дед Мороз?"
    voice "voice/Owl/4day/10 Un.ogg"
    Owl "У нас што — уху — у лесе завёўся Дзед Мароз?"

# game/scripts/scene/scene_day_4.rpy:13875
translate belarusian d4_beasts_41c48d8b:

    # voice "voice/Owl/4day/11 Po.ogg"
    # Owl "Почему — ух-ху — ты мне не рассказывала?"
    voice "voice/Owl/4day/11 Po.ogg"
    Owl "Чаму — ух-ху — ты мне не расказвала?"

# game/scripts/scene/scene_day_4.rpy:13877
translate belarusian d4_beasts_2928f633:

    # voice "voice/Alisa/4day/65 ya.ogg"
    # Alis "Я рассказывала. Сегодня днём."
    voice "voice/Alisa/4day/65 ya.ogg"
    Alis "Я расказвала. Сёння ўдзень."

# game/scripts/scene/scene_day_4.rpy:13881
translate belarusian d4_beasts_6fe04525:

    # voice "voice/Owl/4day/23 No.ogg"
    # Owl "Но ведь днём я сплю."
    voice "voice/Owl/4day/23 No.ogg"
    Owl "Але ж удзень я сплю."

# game/scripts/scene/scene_day_4.rpy:13883
translate belarusian d4_beasts_f6ae455f:

    # voice "voice/Alisa/4day/66 Aga.ogg"
    # Alis "Ага. Вот я и рассказывала, пока ты спала."
    voice "voice/Alisa/4day/66 Aga.ogg"
    Alis "Ага. Вось я і расказвала, пакуль ты спала."

# game/scripts/scene/scene_day_4.rpy:13890
translate belarusian d4_beasts_f6789ae1:

    # "Слушая их ребяческую болтовню, я почему-то вспомнил Ромку."
    "Слухаючы іх дзіцячую балбатню, я чамусьці ўспомніў Ромку."

# game/scripts/scene/scene_day_4.rpy:13891
translate belarusian d4_beasts_9a10adf9:

    # "Как во время погони тот истошно закричал всего за пару минут до появления Волчка."
    "Як падчас пагоні той нема закрычаў усяго за пару хвілін да з'яўлення Воўчыка."

# game/scripts/scene/scene_day_4.rpy:13893
translate belarusian d4_beasts_38a49572:

    # voice "voice/anton/4day/181. Chto.ogg"
    # Ant "Что случилось с Ромкой?"
    voice "voice/anton/4day/181. Chto.ogg"
    Ant "Што здарылася з Ромкам?"

# game/scripts/scene/scene_day_4.rpy:13918
translate belarusian d4_beasts_4a996991:

    # voice "voice/Wolf/319 Pov.ogg"
    # Wolf "Повер-р-рь, он в пор-р-рядке!"
    voice "voice/Wolf/319 Pov.ogg"
    Wolf "Павер-р-р, ён у пар-р-радку!"

# game/scripts/scene/scene_day_4.rpy:13923
translate belarusian d4_beasts_a599268c:

    # voice "voice/Alisa/4day/67 Ziv.ogg"
    # Alis "Жив-здоров твой Ромка."
    voice "voice/Alisa/4day/67 Ziv.ogg"
    Alis "Жывы-здаровы твой Ромка."

# game/scripts/scene/scene_day_4.rpy:13925
translate belarusian d4_beasts_e2c73089:

    # voice "voice/Alisa/4day/68 Tol.ogg"
    # Alis "Только такой вредина, как он, вряд ли получит от Деда Мороза подарок."
    voice "voice/Alisa/4day/68 Tol.ogg"
    Alis "Толькі такі шкоднік, як ён, наўрад ці атрымае ад Дзеда Мароза падарунак."

# game/scripts/scene/scene_day_4.rpy:13927
translate belarusian d4_beasts_1ec6dbdc:

    # voice "voice/Alisa/4day/69 mak.ogg"
    # Alis "Максимум — горсть угля."
    voice "voice/Alisa/4day/69 mak.ogg"
    Alis "Максімум — жменю вугалю."

# game/scripts/scene/scene_day_4.rpy:13941
translate belarusian d4_beasts_cc957c9a:

    # voice "voice/Bear/4day/48Nu.ogg"
    # Bear "Ну или по шапке."
    voice "voice/Bear/4day/48Nu.ogg"
    Bear "Ну ці па шапцы."

# game/scripts/scene/scene_day_4.rpy:13961
translate belarusian d4_beasts_f89250af:

    # "Медвежутка комично погрозил перебинтованной лапой, и зверята дружно расхохотались."
    "Мядзведжутка камічна пагразіў перабінтаванай лапай, і звераняты дружна зарагаталі."

# game/scripts/scene/scene_day_4.rpy:13978
translate belarusian d4_beasts_ff855682:

    # "Моя едва проснувшаяся тревога тут же забылась, улеглась."
    "Мая трывога, што ледзь прачнулася, тут жа забылася, улеглася."

# game/scripts/scene/scene_day_4.rpy:14036
translate belarusian d4_beasts_c40d2344:

    # "Алиса кинулась прочь, вильнув рыжим хвостом, точно факелом."
    "Аліса кінулася прэч, вільнуўшы рудым хвастом, нібы факелам."

# game/scripts/scene/scene_day_4.rpy:14077
translate belarusian d4_beasts_ba4fdb03:

    # "Оля инстинктивно двинулась за ней и засмеялась, вынув из сугроба вторую конфету."
    "Оля інстынктыўна рушыла за ёй і засмяялася, выняўшы з гурбы другую цукерку."

# game/scripts/scene/scene_day_4.rpy:14080
translate belarusian d4_beasts_8185603f:

    # voice "voice/Bear/4day/30 Vi.ogg"
    # Bear "Вы такие бодрые, на вас аж смотреть противно."
    voice "voice/Bear/4day/30 Vi.ogg"
    Bear "Вы такія бадзёрыя, на вас аж глядзець брыдка."

# game/scripts/scene/scene_day_4.rpy:14082
translate belarusian d4_beasts_e32bd85e:

    # voice "voice/olya/4day/26 Ati.ogg"
    # Oly "А ты давай не зевай."
    voice "voice/olya/4day/26 Ati.ogg"
    Oly "А ты давай не зявай."

# game/scripts/scene/scene_day_4.rpy:14117
translate belarusian d4_beasts_ed66e184:

    # voice "voice/olya/4day/26 Lu.ogg"
    # Oly "Лучше беги с нами к Деду Морозу, пока все подарки не разобрали."
    voice "voice/olya/4day/26 Lu.ogg"
    Oly "Лепш бяжы з намі да Дзеда Мароза, пакуль усе падарункі не разабралі."

# game/scripts/scene/scene_day_4.rpy:14121
translate belarusian d4_beasts_dffeea20:

    # voice "voice/Bear/4day/31 Ska.ogg"
    # Bear "Скажешь тоже!"
    voice "voice/Bear/4day/31 Ska.ogg"
    Bear "Скажаш такое!"

# game/scripts/scene/scene_day_4.rpy:14125
translate belarusian d4_beasts_4752a6a7:

    # voice "voice/Bear/4day/32 Skoree.ogg"
    # Bear "Скорее уж мне на голову свалится три кило конфет, чем я поверю в байки лисицы."
    voice "voice/Bear/4day/32 Skoree.ogg"
    Bear "Хутчэй ужо мне на галаву зваліцца тры кіло цукерак, чым я паверу ў байкі лісіцы."

# game/scripts/scene/scene_day_4.rpy:14137
translate belarusian d4_beasts_994b4462:

    # "Когда сладости стали падать на макушку медведя, я сам не удержался от смеха – так забавно он ойкал и втягивал шею."
    "Калі ласункі пачалі падаць на макаўку мядзведзя, я сам не ўтрымаўся ад смеху — так пацешна ён ойкаў і ўцягваў шыю."

# game/scripts/scene/scene_day_4.rpy:14151
translate belarusian d4_beasts_ad5e3f00:

    # "Угощения переливались на снегу. Медведь чихнул и достал из уха «Мишки на севере»."
    "Пачастункі пераліваліся на снезе. Мядзведзь чхнуў і дастаў з вуха «Мішкі на поўначы»."

# game/scripts/scene/scene_day_4.rpy:14152
translate belarusian d4_beasts_117ca0d7:

    # voice "voice/Bear/4day/34 Yab.ogg"
    # Bear "Я бы вздремнул часок, а уж потом пересчитал все эти шоколадки."
    voice "voice/Bear/4day/34 Yab.ogg"
    Bear "Я б драмануў гадзінку, а ўжо потым пералічыў усе гэтыя шакаладкі."

# game/scripts/scene/scene_day_4.rpy:14154
translate belarusian d4_beasts_fd14cdf3:

    # voice "voice/Bear/4day/35Umen.ogg"
    # Bear "У меня такое подозрение, что тут не больше килограмма."
    voice "voice/Bear/4day/35Umen.ogg"
    Bear "У мяне такое падазрэнне, што тут не больш за кілаграм."

# game/scripts/scene/scene_day_4.rpy:14180
translate belarusian d4_beasts_2ad0cc1f:

    # "Со стороны леса донёсся крик Алисы:"
    "З боку лесу данёсся крык Алісы:"

# game/scripts/scene/scene_day_4.rpy:14186
translate belarusian d4_beasts_3b2eb4e0:

    # voice "voice/Alisa/4day/70 Ne.ogg"
    # Alis "Не в этой жизни!"
    voice "voice/Alisa/4day/70 Ne.ogg"
    Alis "Не ў гэтым жыцці!"

# game/scripts/scene/scene_day_4.rpy:14188
translate belarusian d4_beasts_f5baba14:

    # voice "voice/Alisa/4day/71 Dav.ogg"
    # Alis "Давайте скорее, Дед Мороз уже заждался нас во дворце!"
    voice "voice/Alisa/4day/71 Dav.ogg"
    Alis "Давайце хутчэй, Дзед Мароз ужо зачакаўся нас у палацы!"

# game/scripts/scene/scene_day_4.rpy:14210
translate belarusian d4_beasts_d0467c37:

    # "Я пожал плечами. И побежал, потому что от бега злые тиски страха ослабевали."
    "Я паціснуў плячыма. І пабег, таму што ад бегу злыя ціскі страху слабелі."

# game/scripts/scene/scene_day_4.rpy:14218
translate belarusian d4_beasts_6a214df4:

    # "Что-то круглое пролетело возле моего виска. Я решил, что это снежок, но Оля воскликнула:"
    "Нешта круглае праляцела каля маёй скроні. Я вырашыў, што гэта сняжок, але Оля ўсклікнула:"

# game/scripts/scene/scene_day_4.rpy:14227
translate belarusian d4_beasts_991ff062:

    # voice "voice/olya/4day/29Z.ogg"
    # Oly "Зефир!"
    voice "voice/olya/4day/29Z.ogg"
    Oly "Зефір!"

# game/scripts/scene/scene_day_4.rpy:14233
translate belarusian d4_beasts_abae0784:

    # voice "voice/anton/4day/182. Ne.ogg"
    # Ant "Не подбирай, он испачкался."
    voice "voice/anton/4day/182. Ne.ogg"
    Ant "Не падбірай, ён запэцкаўся."

# game/scripts/scene/scene_day_4.rpy:14242
translate belarusian d4_beasts_c97140b0:

    # voice "voice/Alisa/4day/72 Ti.ogg"
    # Alis "Ты что, веришь в микробов?"
    voice "voice/Alisa/4day/72 Ti.ogg"
    Alis "Ты што, верыш у мікробаў?"

# game/scripts/scene/scene_day_4.rpy:14249
translate belarusian d4_beasts_ee81f823:

    # voice "voice/anton/4day/184.  A.ogg"
    # Ant "А ты нет?"
    voice "voice/anton/4day/184.  A.ogg"
    Ant "А ты не?"

# game/scripts/scene/scene_day_4.rpy:14251
translate belarusian d4_beasts_b21e5ca2:

    # voice "voice/Alisa/4day/73 Ra.ogg"
    # Alis "Раньше верила."
    voice "voice/Alisa/4day/73 Ra.ogg"
    Alis "Раней верыла."

# game/scripts/scene/scene_day_4.rpy:14270
translate belarusian d4_beasts_24369c6e:

    # "Стройные сосны-великаны встречали нас шорохом своих лап."
    "Стройныя сосны-волаты сустракалі нас шолахам сваіх лап."

# game/scripts/scene/scene_day_4.rpy:14272
translate belarusian d4_beasts_1971fd45:

    # "Снег снова валил снизу вверх, в бескрайнее чёрное небо."
    "Снег зноў валіў знізу ўверх, у бяскрайняе чорнае неба."

# game/scripts/scene/scene_day_4.rpy:14273
translate belarusian d4_beasts_ff2050de:

    # "Сугробы полыхали, точно расплавленное серебро."
    "Гурбы палыхалі, нібы расплаўленае срэбра."

# game/scripts/scene/scene_day_4.rpy:14281
translate belarusian d4_beasts_00b0fe4e:

    # voice "voice/olya/4day/30 Ka.ogg"
    # Oly "Как же красиво! А я думала, в лесу страшно."
    voice "voice/olya/4day/30 Ka.ogg"
    Oly "Як жа прыгожа! А я думала, у лесе страшна."

# game/scripts/scene/scene_day_4.rpy:14284
translate belarusian d4_beasts_e1135d56:

    # voice "voice/Alisa/4day/01Nas.ogg"
    # Alis "Нас родители пугали лесом, снегом и совой..."
    voice "voice/Alisa/4day/01Nas.ogg"
    Alis "Лесам, снегам і савою нас бацькі пужалі..."

# game/scripts/scene/scene_day_4.rpy:14286
translate belarusian d4_beasts_5dab2bff:

    # voice "voice/Alisa/4day/02Nu.ogg"
    # Alis "...ну а мы с совой играли в снежной чаще под луной." id d4_beasts_5dab2bff
    voice "voice/Alisa/4day/02Nu.ogg"
    Alis "...ды з савой пад месяцам мы ў снежным гушчары гулялі."

# game/scripts/scene/scene_day_4.rpy:14289
translate belarusian d4_beasts_6c00ba40:

    # "Я старался не упускать из виду Олю, но это было довольно сложно: сестра то кидалась за кусты, подбирая всё новые конфеты, то, смеясь, выпрыгивала на тропинку."
    "Я стараўся не выпускаць з вачэй Олю, але гэта было даволі складана: сястра то кідалася за кусты, падбіраючы ўсё новыя цукеркі, то, смяючыся, выскоквала на сцяжынку."

# game/scripts/scene/scene_day_4.rpy:14311
translate belarusian d4_beasts_c822571e:

    # "Совушка пронеслась над нами, села на ветку и заухала, мотая головой."
    "Савушка пранеслася над намі, села на галінку і заўхкала, матаючы галавой."

# game/scripts/scene/scene_day_4.rpy:14333
translate belarusian d4_beasts_fb23c5ff:

    # "Волчик вскопал мордой снег, вытянул горсть жвачек и проглотил, не снимая обёртки."
    "Воўчык ускапаў мордай снег, выцягнуў жменю жуек і праглынуў, не здымаючы абгорткі."

# game/scripts/scene/scene_day_4.rpy:14337
translate belarusian d4_beasts_c9b0f154:

    # voice "voice/olya/4day/32 U.ogg"
    # Oly "У тебя будет несварение!"
    voice "voice/olya/4day/32 U.ogg"
    Oly "У цябе будзе нястраўнасць!"

# game/scripts/scene/scene_day_4.rpy:14358
translate belarusian d4_beasts_6610ed3d:

    # "Волк испугался и выплюнул жвачный ком."
    "Воўк спалохаўся і выплюнуў камяк жуйкі."

# game/scripts/scene/scene_day_4.rpy:14374
translate belarusian d4_beasts_5519c83d:

    # voice "voice/Alisa/4day/75 Vra.ogg"
    # Alis "Враки-враки — злые собаки!"
    voice "voice/Alisa/4day/75 Vra.ogg"
    Alis "Байкі-байкі — злыя сабакі!"

# game/scripts/scene/scene_day_4.rpy:14378
translate belarusian d4_beasts_e740c1ae:

    # voice "voice/Alisa/4day/76 Net.ogg"
    # Alis "Нет никаких несварений."
    voice "voice/Alisa/4day/76 Net.ogg"
    Alis "Няма ніякіх нястраўнасцей."

# game/scripts/scene/scene_day_4.rpy:14380
translate belarusian d4_beasts_e475c2b4:

    # voice "voice/Alisa/4day/76 Vs.ogg"
    # Alis "Вся эта чушь случается только со взрослыми."
    voice "voice/Alisa/4day/76 Vs.ogg"
    Alis "Уся гэтая лухта здараецца толькі з дарослымі."

# game/scripts/scene/scene_day_4.rpy:14392
translate belarusian d4_beasts_fbd85b32:

    # "Алиса встала как вкопанная и важно отодвинула полог переплетённых веток — так в театре открывают занавес."
    "Аліса стала як укапаная і важна адсунула полаг пераплеценых галін — так у тэатры адкрываюць заслону."

# game/scripts/scene/scene_day_4.rpy:14418
translate belarusian d4_palace_dev_1602a5aa:

    # "За преградой была поляна, а на ней серебрился дворец изо льда."
    "За перашкодай была паляна, а на ёй серабрыўся палац з лёду."

# game/scripts/scene/scene_day_4.rpy:14420
translate belarusian d4_palace_dev_b6dfd695:

    # voice "voice/olya/4day/33 O.ogg"
    # Oly "О! Это всё взаправду?"
    voice "voice/olya/4day/33 O.ogg"
    Oly "О! Гэта ўсё па-сапраўднаму?"

# game/scripts/scene/scene_day_4.rpy:14440
translate belarusian d4_palace_dev_6994304a:

    # voice "voice/Bear/4day/37 Ush.ogg"
    # Bear "Ущипнуть тебя?"
    voice "voice/Bear/4day/37 Ush.ogg"
    Bear "Ушчыкнуць цябе?"

# game/scripts/scene/scene_day_4.rpy:14451
translate belarusian d4_palace_dev_e73085e0:

    # voice "voice/anton/4day/185. Ne.ogg"
    # Ant "Не надо её щипать."
    voice "voice/anton/4day/185. Ne.ogg"
    Ant "Не трэба яе шчыкаць."

# game/scripts/scene/scene_day_4.rpy:14467
translate belarusian d4_palace_dev_86e727a2:

    # "Мы смотрели на сверкающее чудо: башенки и стены были выложены из снежного и ледяного мрамора."
    "Мы глядзелі на зіхатлівы цуд: вежачкі і сцены былі выкладзены са снежнага і ледзянога мармуру."

# game/scripts/scene/scene_day_4.rpy:14471
translate belarusian d4_palace_dev_15b3e364:

    # "Где-то ласково звенели колокольчики. Отчётливо пахло шоколадом и жжёным сахаром."
    "Дзесьці ласкава звінелі званочкі. Выразна пахла шакаладам і паленым цукрам."

# game/scripts/scene/scene_day_4.rpy:14472
translate belarusian d4_palace_dev_48e4a5d3:

    # voice "voice/Alisa/4day/78 Mi.ogg"
    # Alis "Милости прошу к нашему шалашу!"
    voice "voice/Alisa/4day/78 Mi.ogg"
    Alis "Ласкава прашу да нашага шалаша!"

# game/scripts/scene/scene_day_4.rpy:14478
translate belarusian d4_palace_dev_8db649a8:

    # "Дважды приглашать не пришлось. Мы вошли в замок, вертясь и жмурясь от слепящих искр."
    "Двойчы запрашаць не давялося. Мы ўвайшлі ў замак, круцячыся і жмурачыся ад сляпучых іскраў."

# game/scripts/scene/scene_day_4.rpy:14525
translate belarusian d4_palace_dev_bf0e276b:

    # "Дед Мороз сидел на сверкающем троне."
    "Дзед Мароз сядзеў на зіхатлівым троне."

# game/scripts/scene/scene_day_4.rpy:14544
translate belarusian d4_palace_dev_77bcdeff:

    # "Пушистые помпоны покачивались на раздвоенной шапке. Белоснежная борода скрывала спокойную улыбку."
    "Пушыстыя пампоны пагойдваліся на раздвоенай шапцы. Беласнежная барада хавала спакойную ўсмешку."

# game/scripts/scene/scene_day_4.rpy:14545
translate belarusian d4_palace_dev_6cde7907:

    # "Он был таким, как я его себе воображал давным-давно, когда ещё верил в мамины сказки: высоким, сильным и косматым, излучающим одновременно мороз и тепло."
    "Ён быў такім, якім я яго сабе ўяўляў даўным-даўно, калі яшчэ верыў у маміны казкі: высокім, дужым і касматым — ён адначасова выпраменьваў мароз і цяпло."

# game/scripts/scene/scene_day_4.rpy:14546
translate belarusian d4_palace_dev_8e451b1f:

    # "И голос его, густой и глубокий, окутал меня, словно дым праздничного костра:"
    "І голас яго, густы і глыбокі, ахутаў мяне, нібы дым святочнага вогнішча:"

# game/scripts/scene/scene_day_4.rpy:14563
translate belarusian d4_palace_dev_84f7f9a7:

    # voice "voice/kozel/4day/68.A.ogg"
    # Frost "Антон и Ольга!"
    voice "voice/kozel/4day/68.A.ogg"
    Frost "Антон і Вольга!"

# game/scripts/scene/scene_day_4.rpy:14565
translate belarusian d4_palace_dev_3af8592c:

    # voice "voice/kozel/4day/OH.ogg"
    # Frost "Ох и намучались же вы, ребятки, пока сюда добирались!"
    voice "voice/kozel/4day/OH.ogg"
    Frost "Ох і намучыліся ж вы, дзеткі, пакуль сюды дабіраліся!"

# game/scripts/scene/scene_day_4.rpy:14578
translate belarusian d4_palace_dev_2ebaafc3:

    # voice "voice/olya/4day/34 Cho.ogg"
    # Oly "Что ты, дедушка, мы быстро дошли."
    voice "voice/olya/4day/34 Cho.ogg"
    Oly "Што ты, дзядуля, мы хутка дайшлі."

# game/scripts/scene/scene_day_4.rpy:14582
translate belarusian d4_palace_dev_c1fffc83:

    # "Сестра говорила с хозяином замка иначе, чем с другими взрослыми: звонко, беззаботно. Словно он был её ровесник."
    "Сястра размаўляла з гаспадаром замка інакш, чым з іншымі дарослымі: звонка, бесклапотна. Нібы ён быў яе равеснікам."

# game/scripts/scene/scene_day_4.rpy:14601
translate belarusian d4_palace_dev_5aac4ce4:

    # voice "voice/kozel/4day/69.Z.ogg"
    # Frost "Знаю, всё знаю!"
    voice "voice/kozel/4day/69.Z.ogg"
    Frost "Ведаю, усё ведаю!"

# game/scripts/scene/scene_day_4.rpy:14603
translate belarusian d4_palace_dev_cd45da57:

    # voice "voice/kozel/4day/70.Mne.ogg"
    # Frost "Мне мои друзья докладывают..."
    voice "voice/kozel/4day/70.Mne.ogg"
    Frost "Мне мае сябры дакладваюць..."

# game/scripts/scene/scene_day_4.rpy:14605
translate belarusian d4_palace_dev_8cd167df:

    # voice "voice/kozel/4day/71.Kto.ogg"
    # Frost "Кто был покладистым весь год, того подарок утром ждёт."
    voice "voice/kozel/4day/71.Kto.ogg"
    Frost "Хто год увесь быў паслухмяны, таму на ранак дар жаданы."

# game/scripts/scene/scene_day_4.rpy:14607
translate belarusian d4_palace_dev_d8665549:

    # voice "voice/kozel/4day/73.A.ogg"
    # Frost "А кто ленился и грустил, пускай он дедушку простит."
    voice "voice/kozel/4day/73.A.ogg"
    Frost "А хто лянуецца, сумуе, няхай дзядулю ён даруе."

# game/scripts/scene/scene_day_4.rpy:14609
translate belarusian d4_palace_dev_353d04b1:

    # voice "voice/kozel/4day/75.Len.ogg"
    # Frost "Лентяям и грустяям конфет не запасаем."
    voice "voice/kozel/4day/75.Len.ogg"
    Frost "Гультаям і сумаям цукерак не запасаем."

# game/scripts/scene/scene_day_4.rpy:14624
translate belarusian d4_palace_dev_e012ce6c:

    # voice "voice/olya/4day/35 A.ogg"
    # Oly "А я не ленилась!"
    voice "voice/olya/4day/35 A.ogg"
    Oly "А я не ленавалася!"

# game/scripts/scene/scene_day_4.rpy:14629
translate belarusian d4_palace_dev_83cf0c0c:

    # voice "voice/kozel/4day/76.Eo.ogg"
    # Frost "И о том знаю."
    voice "voice/kozel/4day/76.Eo.ogg"
    Frost "І пра тое ведаю."

# game/scripts/scene/scene_day_4.rpy:14646
translate belarusian d4_palace_dev_fc254435:

    # "Он обвёл нас пристальным взором."
    "Ён абвёў нас пільным позіркам."

# game/scripts/scene/scene_day_4.rpy:14647
translate belarusian d4_palace_dev_1eaf3347:

    # "Маска Деда Мороза скрывала настоящее лицо."
    "Маска Дзеда Мароза хавала сапраўдны твар."

# game/scripts/scene/scene_day_4.rpy:14648
translate belarusian d4_palace_dev_ab69f723:

    # "Всё это время я молчал и смотрел, мой взгляд будто примёрз к старику."
    "Увесь гэты час я маўчаў і глядзеў, мой позірк быццам прымёрз да старога."

# game/scripts/scene/scene_day_4.rpy:14665
translate belarusian d4_palace_dev_a4968ca0:

    # "Я мог принять живущих в лесу детей и фантастические прыжки до луны, но Дед Мороз в ледяном замке ошарашил настолько, что я лишился дара речи."
    "Я мог прыняць дзяцей, што жывуць у лесе, і фантастычныя скачкі да месяца, але Дзед Мароз у ледзяным замку агаломшыў настолькі, што я страціў дар мовы."

# game/scripts/scene/scene_day_4.rpy:14666
translate belarusian d4_palace_dev_38fdbdf6:

    # voice "voice/kozel/4day/77.Est.ogg"
    # Frost "Есть у меня для вас кое-что особенное."
    voice "voice/kozel/4day/77.Est.ogg"
    Frost "Ёсць у мяне для вас сёе-тое асаблівае."

# game/scripts/scene/scene_day_4.rpy:14674
translate belarusian d4_palace_dev_a7d83461:

    # "В его огромной руке появился мешок. В нос ударил запах какао, халвы и мандаринов."
    "У яго вялізнай руцэ з'явіўся мяшок. У нос ударыў пах какавы, халвы і мандарынаў."

# game/scripts/scene/scene_day_4.rpy:14688
translate belarusian d4_palace_dev_b44c206b:

    # voice "voice/anton/4day/186. Spa.ogg"
    # Ant "Спасибо, но мы уже ели конфеты."
    voice "voice/anton/4day/186. Spa.ogg"
    Ant "Дзякуй, але мы ўжо елі цукеркі."

# game/scripts/scene/scene_day_4.rpy:14696
translate belarusian d4_palace_dev_1667d9cf:

    # "Дед Мороз поглядел на меня внимательно."
    "Дзед Мароз паглядзеў на мяне ўважліва."

# game/scripts/scene/scene_day_4.rpy:14705
translate belarusian d4_palace_dev_d2c4ce21:

    # voice "voice/kozel/4day/78.Raz.ogg"
    # Frost "Ха-ха-ха! Разве то конфеты были? Так, одно название."
    voice "voice/kozel/4day/78.Raz.ogg"
    Frost "Ха-ха-ха! Хіба то цукеркі былі? Так, адна назва."

# game/scripts/scene/scene_day_4.rpy:14707
translate belarusian d4_palace_dev_5cd5b1c3:

    # voice "voice/kozel/4day/79.Vot.ogg"
    # Frost "Вот у меня конфеты волшебные, прямиком из Небыляндии привезённые. Ха-ха-ха!"
    voice "voice/kozel/4day/79.Vot.ogg"
    Frost "Вось у мяне цукеркі чароўныя, наўпрост з Небыляндыі прывезеныя. Ха-ха-ха!"

# game/scripts/scene/scene_day_4.rpy:14728
translate belarusian d4_palace_dev_5a59b04a:

    # voice "voice/olya/4day/36 Ez.ogg"
    # Oly "Из Небыляндии?!"
    voice "voice/olya/4day/36 Ez.ogg"
    Oly "З Небыляндыі?!"

# game/scripts/scene/scene_day_4.rpy:14732
translate belarusian d4_palace_dev_32544e26:

    # voice "voice/kozel/4day/80.Sra.ogg"
    # Frost "Сразу бы вам их дал – заслужили."
    voice "voice/kozel/4day/80.Sra.ogg"
    Frost "Адразу б вам іх даў — заслужылі."

# game/scripts/scene/scene_day_4.rpy:14750
translate belarusian d4_palace_dev_22c37a39:

    # voice "voice/kozel/4day/81.No.ogg"
    # Frost "Но есть правила, ха-ха-ха."
    voice "voice/kozel/4day/81.No.ogg"
    Frost "Але ёсць правілы, ха-ха-ха."

# game/scripts/scene/scene_day_4.rpy:14752
translate belarusian d4_palace_dev_551e0fcd:

    # voice "voice/kozel/4day/82.Nad.ogg"
    # Frost "Надобно вам три дедушкины загадки отгадать. Попробуете?"
    voice "voice/kozel/4day/82.Nad.ogg"
    Frost "Трэба вам тры дзядулевы загадкі адгадаць. Паспрабуеце?"

# game/scripts/scene/scene_day_4.rpy:14764
translate belarusian d4_palace_dev_b932e836:

    # "Я не успел разлепить пересохшие губы:"
    "Я не паспеў разляпіць перасохлыя вусны:"

# game/scripts/scene/scene_day_4.rpy:14770
translate belarusian d4_palace_dev_972c4901:

    # voice "voice/olya/4day/37 Da.ogg"
    # Oly "Да!"
    voice "voice/olya/4day/37 Da.ogg"
    Oly "Так!"

# game/scripts/scene/scene_day_4.rpy:14780
translate belarusian d4_palace_dev_d1ff0ad1:

    # voice "voice/kozel/4day/83.To.ogg"
    # Frost "Тогда слушайте первую..."
    voice "voice/kozel/4day/83.To.ogg"
    Frost "Тады слухайце першую..."

# game/scripts/scene/scene_day_4.rpy:14784
translate belarusian d4_palace_dev_8132fbc4:

    # voice "voice/kozel/4day/84.Vn.ogg"
    # Frost "В нём живут машины и хранятся шины."
    voice "voice/kozel/4day/84.Vn.ogg"
    Frost "У ім жывуць машыны і захоўваюцца шыны."

# game/scripts/scene/scene_day_4.rpy:14791
translate belarusian d4_palace_dev_7739df92:

    # "Я посмотрел по сторонам, на детей в масках."
    "Я паглядзеў па баках, на дзяцей у масках."

# game/scripts/scene/scene_day_4.rpy:14795
translate belarusian d4_palace_dev_b436b27e:

    # "Они замерли в углах, но их тени плясали на стенах."
    "Яны замерлі ў кутах, але іх цені танцавалі на сценах."

# game/scripts/scene/scene_day_4.rpy:14802
translate belarusian d4_palace_dev_3494720e:

    # "Что-то тихо гудело, и я подумал, робея: это ворчат их желудки."
    "Нешта ціха гуло, і я боязка падумаў: гэта бурчаць іх страўнікі."

# game/scripts/scene/scene_day_4.rpy:14818
translate belarusian d4_palace_dev_79b38e74:

    # voice "voice/olya/4day/38 G.ogg"
    # Oly "Гараж!"
    voice "voice/olya/4day/38 G.ogg"
    Oly "Гараж!"

# game/scripts/scene/scene_day_4.rpy:14821
translate belarusian d4_palace_dev_0d2f076b:

    # voice "voice/kozel/4day/85.Ver.ogg"
    # Frost "Верно, хе-хей!"
    voice "voice/kozel/4day/85.Ver.ogg"
    Frost "Правільна, хе-хей!"

# game/scripts/scene/scene_day_4.rpy:14839
translate belarusian d4_palace_dev_0b9a72e7:

    # voice "voice/kozel/4day/85.Tep.ogg"
    # Frost "Теперь вторая загадка. Подключайся, Антон."
    voice "voice/kozel/4day/85.Tep.ogg"
    Frost "Цяпер другая загадка. Далучайся, Антон."

# game/scripts/scene/scene_day_4.rpy:14841
translate belarusian d4_palace_dev_177e22ac:

    # voice "voice/kozel/4day/85.Ves.ogg"
    # Frost "Весь день ходит, как тень, посудой гремит, на всех шипит."
    voice "voice/kozel/4day/85.Ves.ogg"
    Frost "Увесь дзень ходзіць, як цень, посудам грыміць, на ўсіх шыпіць."

# game/scripts/scene/scene_day_4.rpy:14856
translate belarusian d4_palace_dev_1212c1f7:

    # "Я вопросительно вскинул бровь:"
    "Я пытальна ўзняў брыво:"

# game/scripts/scene/scene_day_4.rpy:14858
translate belarusian d4_palace_dev_19c6d4f3:

    # voice "voice/anton/4day/187. Ma.ogg"
    # Ant "Мама?"
    voice "voice/anton/4day/187. Ma.ogg"
    Ant "Мама?"

# game/scripts/scene/scene_day_4.rpy:14861
translate belarusian d4_palace_dev_07a3503c:

    # "Оля потянула руку:"
    "Оля пацягнула руку:"

# game/scripts/scene/scene_day_4.rpy:14866
translate belarusian d4_palace_dev_5b9624b3:

    # voice "voice/olya/4day/39M.ogg"
    # Oly "Можно я?! Можно я?!"
    voice "voice/olya/4day/39M.ogg"
    Oly "Можна я?! Можна я?!"

# game/scripts/scene/scene_day_4.rpy:14872
translate belarusian d4_palace_dev_9bf2a448:

    # voice "voice/olya/4day/40 Eto.ogg"
    # Oly "Это кошка!"
    voice "voice/olya/4day/40 Eto.ogg"
    Oly "Гэта котка!"

# game/scripts/scene/scene_day_4.rpy:14893
translate belarusian d4_palace_dev_589e2b51:

    # voice "voice/kozel/4day/87.Verno.ogg"
    # Frost "Верно, хо-хо! Осталась последняя загадка — и подарки ваши."
    voice "voice/kozel/4day/87.Verno.ogg"
    Frost "Правільна, хо-хо! Засталася апошняя загадка — і падарункі вашы."

# game/scripts/scene/scene_day_4.rpy:14895
translate belarusian d4_palace_dev_4da636f1:

    # voice "voice/kozel/4day/88.Tol.ogg"
    # Frost "Только вот незадача, ребятушки..." id d4_palace_dev_4da636f1
    voice "voice/kozel/4day/88.Tol.ogg"
    Frost "Толькі вось бяда, дзетачкі..."

# game/scripts/scene/scene_day_4.rpy:14897
translate belarusian d4_palace_dev_7f3253fe:

    # voice "voice/kozel/4day/89.Zapa.ogg"
    # Frost "Запамятовал я, о чём же была эта загадка."
    voice "voice/kozel/4day/89.Zapa.ogg"
    Frost "Падзабыўся я, пра што ж была гэтая загадка."

# game/scripts/scene/scene_day_4.rpy:14899
translate belarusian d4_palace_dev_7c6c2e2f:

    # voice "voice/kozel/4day/90.Moz.ogg"
    # Frost "А может, наши друзья-зверята нам подскажут?"
    voice "voice/kozel/4day/90.Moz.ogg"
    Frost "А можа, нашы сябры-звяраняты нам падкажуць?"

# game/scripts/scene/scene_day_4.rpy:14917
translate belarusian d4_palace_dev_bd2c187b:

    # "Ряженые дети с гоготом и топотом окружили нас со всех сторон, чтобы через мгновение закружиться в бешеном хороводе, смутно напоминающем пляску у моего окна в ту злополучную ночь."
    "Ражаныя дзеці з рогатам і тупатам акружылі нас з усіх бакоў, каб праз імгненне закружыцца ў шалёным карагодзе, які цьмяна нагадваў скокі каля майго акна ў тую злашчасную ноч."

# game/scripts/scene/scene_day_4.rpy:14918
translate belarusian d4_palace_dev_61c24f43:

    # voice "voice/Alisa/4day/04Ded.ogg"
    # Animals "Дед Мороз сидит на троне, пряча в бороду смешок."
    voice "voice/Alisa/4day/04Ded.ogg"
    Animals "Дзед Мароз сядзіць на троне, у барадзе таіць смяшок."

# game/scripts/scene/scene_day_4.rpy:14920
translate belarusian d4_palace_dev_60612709:

    # voice "voice/Alisa/4day/04Netomy.ogg"
    # Animals "Не томи нас слишком долго, развяжи скорей..."
    voice "voice/Alisa/4day/04Netomy.ogg"
    Animals "Не тамі нас надта доўга, развяжы хутчэй..."

# game/scripts/scene/scene_day_4.rpy:14927
translate belarusian d4_palace_dev_b5c9c21d:

    # voice "voice/olya/4day/41 M.ogg"
    # Oly "...мешок!" id d4_palace_dev_b5c9c21d
    voice "voice/olya/4day/41 M.ogg"
    Oly "...мяшок!"

# game/scripts/scene/scene_day_4.rpy:14960
translate belarusian d4_palace_dev_1d060bb8:

    # "Дед Мороз засмеялся, довольный."
    "Дзед Мароз засмяяўся, задаволены."

# game/scripts/scene/scene_day_4.rpy:14962
translate belarusian d4_palace_dev_886e66f9:

    # voice "voice/kozel/4day/91.Ub.ogg"
    # Frost "Убедили старика! Получайте!"
    voice "voice/kozel/4day/91.Ub.ogg"
    Frost "Пераканалі старога! Атрымлівайце!"

# game/scripts/scene/scene_day_4.rpy:14966
translate belarusian d4_palace_dev_4635e5d8:

    # "И он высыпал из багрового мешка гору угощений, каких я не видел даже в рекламе."
    "І ён высыпаў з барвовага мяшка гару пачастункаў, якіх я не бачыў нават у рэкламе."

# game/scripts/scene/scene_day_4.rpy:14977
translate belarusian d4_palace_dev_d309a71f:

    # "Жвачки самых разных форм и расцветок, вкусно пахнущие, с торчащими вкладышами."
    "Жуйкі самых розных формаў і расфарбовак — яны смачна пахлі, а з іх тырчалі ўкладышы."

# game/scripts/scene/scene_day_4.rpy:14992
translate belarusian d4_palace_dev_6b361560:

    # "Леденцы размером с кулак и мандарины размером с Олину голову."
    "Ледзянцы памерам з кулак і мандарыны памерам з Оліну галаву."

# game/scripts/scene/scene_day_4.rpy:14993
translate belarusian d4_palace_dev_7665e7fb:

    # "А ещё «Сникерсы», «Марсы», «Баунти» и «Киндер-сюрпризы», которые мы так давно не пробовали."
    "А яшчэ «Снікерсы», «Марсы», «Баўнці» і «Кіндэр-сюрпрызы», якіх мы так даўно не каштавалі."

# game/scripts/scene/scene_day_4.rpy:14994
translate belarusian d4_palace_dev_b262b4ea:

    # voice "voice/olya/4day/42 Oi.ogg"
    # Oly "Ой, спасибо!"
    voice "voice/olya/4day/42 Oi.ogg"
    Oly "Ой, дзякуй!"

# game/scripts/scene/scene_day_4.rpy:15027
translate belarusian d4_palace_dev_94780613:

    # "Я вытер рукавом выступившие слёзы радости, когда мой внутренний голос убедил меня отбросить все сомнения."
    "Я выцер рукавом слёзы радасці, што выступілі на вачах, калі мой унутраны голас пераканаў мяне адкінуць усе сумневы."

# game/scripts/scene/scene_day_4.rpy:15028
translate belarusian d4_palace_dev_3d92ef02:

    # "Именно этого я хотел для себя и сестры."
    "Менавіта гэтага я хацеў для сябе і сястры."

# game/scripts/scene/scene_day_4.rpy:15029
translate belarusian d4_palace_dev_4f4bd7eb:

    # "Настоящая Небыляндия... Без унижений и запретов."
    "Сапраўдная Небыляндыя... Без прыніжэнняў і забарон."

# game/scripts/scene/scene_day_4.rpy:15030
translate belarusian d4_palace_dev_76ef1714:

    # "Наконец-то мы будем счастливы."
    "Нарэшце мы будзем шчаслівыя."

# game/scripts/scene/scene_day_4.rpy:15042
translate belarusian d4_palace_dev_526a9959:

    # "Дед Мороз распрямился, покидая трон, и воздел руки над угощениями."
    "Дзед Мароз выпрастаўся, пакідаючы трон, і ўзняў рукі над пачастункамі."

# game/scripts/scene/scene_day_4.rpy:15055
translate belarusian d4_palace_dev_100e3433:

    # "Звери по бокам тоже подняли лапы."
    "Звяры па баках таксама паднялі лапы."

# game/scripts/scene/scene_day_4.rpy:15056
translate belarusian d4_palace_dev_e69f1563:

    # "Их глаза блестели ярче драгоценных камней. Пасть волка была мокрой от слюны."
    "Іх вочы блішчалі ярчэй за каштоўныя камяні. Пашча ваўка была мокрай ад сліны."

# game/scripts/scene/scene_day_4.rpy:15065
translate belarusian d4_palace_dev_13f18634:

    # voice "voice/kozel/4day/92.Da.ogg"
    # Frost "Да будет пир на весь мир!"
    voice "voice/kozel/4day/92.Da.ogg"
    Frost "Хай будзе баль на ўвесь свет!"

# game/scripts/scene/scene_day_4.rpy:15080
translate belarusian d4_palace_dev_469db1f3:

    # "Звери, толкаясь и рыча, бросились поедать конфеты, одну за другой. Рты у них были вымазаны чем-то тёмным." id d4_palace_dev_469db1f3
    "Звяры, штурхаючыся і рыкаючы, кінуліся паядаць цукеркі, адну за адной. Раты ў іх былі вымазаны нечым цёмным."

# game/scripts/scene/scene_day_4.rpy:15085
translate belarusian d4_palace_dev_fc8c3b8f:

    # "Сестра схватила первую попавшуюся конфету и содрала фантик." id d4_palace_dev_fc8c3b8f
    "Сястра схапіла першую-лепшую цукерку і садрала фанцік."

# game/scripts/scene/scene_day_4.rpy:15088
translate belarusian d4_palace_dev_choice_9f556e45:

    # "При виде этого я почувствовал, что внутри меня будто качнулся маятник."
    "Убачыўшы гэта, я адчуў, што ўнутры мяне быццам гайдануўся маятнік."

# game/scripts/scene/scene_day_4.rpy:15118
translate belarusian d4_beasts_choice_refuse_16cd2758:

    # "Я вцепился в Олино запястье так, что она пискнула то ли от боли, то ли от неожиданности."
    "Я ўчапіўся ў Оліна запясце так, што яна піскнула ці то ад болю, ці то ад нечаканасці."

# game/scripts/scene/scene_day_4.rpy:15125
translate belarusian d4_beasts_choice_refuse_5d7973be:

    # voice "voice/anton/4day/188. Ne.ogg"
    # Ant "Не ешь."
    voice "voice/anton/4day/188. Ne.ogg"
    Ant "Не еш."

# game/scripts/scene/scene_day_4.rpy:15130
translate belarusian d4_beasts_choice_refuse_0861aedf:

    # "По залу прошёлся настороженный шёпот. Шевельнулись ушки масок."
    "Па зале прайшоўся насцярожаны шэпт. Варухнуліся вушкі масак."

# game/scripts/scene/scene_day_4.rpy:15147
translate belarusian d4_beasts_choice_refuse_f7aa3fcd:

    # "Тени перебежали с места на место."
    "Цені перабеглі з месца на месца."

# game/scripts/scene/scene_day_4.rpy:15167
translate belarusian d4_beasts_choice_refuse_23f49535:

    # voice "voice/Owl/4day/13 Chto.ogg"
    # Owl "Что такое? Что случилось?"
    voice "voice/Owl/4day/13 Chto.ogg"
    Owl "Што такое? Што здарылася?"

# game/scripts/scene/scene_day_4.rpy:15182
translate belarusian d4_beasts_choice_refuse_42c78e1d:

    # voice "voice/Alisa/4day/80 Niche.ogg"
    # Alis "Ничего страшного!"
    voice "voice/Alisa/4day/80 Niche.ogg"
    Alis "Нічога страшнага!"

# game/scripts/scene/scene_day_4.rpy:15184
translate belarusian d4_beasts_choice_refuse_9f3050f7:

    # voice "voice/Alisa/4day/81 Prosto.ogg"
    # Alis "Просто Тоша верит в несуществующий диабет."
    voice "voice/Alisa/4day/81 Prosto.ogg"
    Alis "Проста Тоша верыць у неіснуючы дыябет."

# game/scripts/scene/scene_day_4.rpy:15201
translate belarusian d4_beasts_choice_refuse_5475bff9:

    # voice "voice/Wolf/325 Ro.ogg"
    # Wolf "Р-р-росказни р-р-родителей!"
    voice "voice/Wolf/325 Ro.ogg"
    Wolf "Бр-р-рахня бацькоў!"

# game/scripts/scene/scene_day_4.rpy:15218
translate belarusian d4_beasts_choice_refuse_e0e46c4e:

    # voice "voice/Bear/4day/41Raz.ogg"
    # Bear "Разбудите меня, когда он перестанет валять дурака."
    voice "voice/Bear/4day/41Raz.ogg"
    Bear "Разбудзіце мяне, калі ён перастане дурня валяць."

# game/scripts/scene/scene_day_4.rpy:15231
translate belarusian d4_beasts_choice_refuse_09ffec4a:

    # "Дед Мороз склонился надо мной."
    "Дзед Мароз схіліўся нада мной."

# game/scripts/scene/scene_day_4.rpy:15232
translate belarusian d4_beasts_choice_refuse_81707acc:

    # "От него пахло карамелью и совсем чуть-чуть сыростью."
    "Ад яго пахла карамеллю і зусім крыху сырасцю."

# game/scripts/scene/scene_day_4.rpy:15234
translate belarusian d4_beasts_choice_refuse_1fdc838e:

    # voice "voice/kozel/4day/93.Dav.ogg"
    # Frost "Давайте не будем портить праздник, друзья!"
    voice "voice/kozel/4day/93.Dav.ogg"
    Frost "Давайце не будзем псаваць свята, сябры!"

# game/scripts/scene/scene_day_4.rpy:15236
translate belarusian d4_beasts_choice_refuse_c88a31f2:

    # voice "voice/kozel/4day/94.Se.ogg"
    # Frost "Сегодня каждый должен веселиться! Ешьте и пляшите!"
    voice "voice/kozel/4day/94.Se.ogg"
    Frost "Сёння кожны павінен весяліцца! Ешце і скачыце!"

# game/scripts/scene/scene_day_4.rpy:15258
translate belarusian d4_beasts_choice_refuse_124e4976:

    # "Оля попыталась отнять руку, но я не разжал хватки."
    "Оля паспрабавала забраць руку, але я не расціснуў хваткі."

# game/scripts/scene/scene_day_4.rpy:15271
translate belarusian d4_beasts_choice_refuse_6435fb94:

    # "Я смотрел на сладости, на высокого старика, и принюхивался к просачивающемуся запашку."
    "Я глядзеў на ласункі, на высокага старога і прынюхваўся да душку, які прасочваўся."

# game/scripts/scene/scene_day_4.rpy:15272
translate belarusian d4_beasts_choice_refuse_c271353c:

    # "Гниль, маскированная приторным ароматом. Вонь дикого зверя."
    "Гніль, замаскіраваная саладжавым водарам. Смурод дзікага звера."

# game/scripts/scene/scene_day_4.rpy:15273
translate belarusian d4_beasts_choice_refuse_6fce4674:

    # "Казалось, какое-то сильное наваждение перестало действовать. Вернулся холод, усталость и страх."
    "Здавалася, нейкае моцнае насланнё перастала дзейнічаць. Вярнуліся холад, стомленасць і страх."

# game/scripts/scene/scene_day_4.rpy:15287
translate belarusian d4_beasts_choice_refuse_dec212e6:

    # voice "voice/anton/4day/189. Spa.ogg"
    # Ant "Спасибо, но мы сыты."
    voice "voice/anton/4day/189. Spa.ogg"
    Ant "Дзякуй, але мы сытыя."

# game/scripts/scene/scene_day_4.rpy:15314
translate belarusian d4_beasts_choice_refuse_c867455f:

    # voice "voice/anton/4day/190Emi.ogg"
    # Ant "И... мы пойдём, наверное. Мама с папой переживают уже."
    voice "voice/anton/4day/190Emi.ogg"
    Ant "І... мы пойдзем, напэўна. Мама з татам хвалююцца ўжо."

# game/scripts/scene/scene_day_4.rpy:15327
translate belarusian d4_beasts_choice_refuse_00fe4461:

    # "Я потянул сестру к выходу, но Алиса встала наперерез."
    "Я пацягнуў сястру да выхаду, але Аліса стала наперарэз."

# game/scripts/scene/scene_day_4.rpy:15347
translate belarusian d4_beasts_choice_refuse_6e44fe19:

    # "В руках она держала фарфоровую тарелку."
    "У руках яна трымала фарфоравую талерку."

# game/scripts/scene/scene_day_4.rpy:15356
translate belarusian d4_beasts_choice_refuse_9360c70a:

    # "Мне померещилось, что блюдо наполнено опарышами, но, как только взгляд метнулся к подношению, вместо тошнотворно-шевелящейся массы там оказались мармеладные змейки."
    "Мне прымроілася, што талерка напоўнена апарышамі, але, як толькі позірк кінуўся да паднашэння, замест масы, што млосна варушылася, там апынуліся мармеладныя змейкі."

# game/scripts/scene/scene_day_4.rpy:15398
translate belarusian d4_beasts_choice_refuse_52add1bd:

    # voice "voice/Alisa/4day/82 Pro.ogg"
    # Alis "Прошу, Антон. Мы же друзья, правда?"
    voice "voice/Alisa/4day/82 Pro.ogg"
    Alis "Прашу, Антон. Мы ж сябры, праўда?"

# game/scripts/scene/scene_day_4.rpy:15401
translate belarusian d4_beasts_choice_refuse_64a7ec8f:

    # voice "voice/Alisa/4day/83 Me.ogg"
    # Alis "Мы даже больше чем друзья."
    voice "voice/Alisa/4day/83 Me.ogg"
    Alis "Мы нават больш чым сябры."

# game/scripts/scene/scene_day_4.rpy:15403
translate belarusian d4_beasts_choice_refuse_48001039:

    # voice "voice/Alisa/4day/84 Vs.ogg"
    # Alis "Вспомни, что я обещала?"
    voice "voice/Alisa/4day/84 Vs.ogg"
    Alis "Успомні, што я абяцала?"

# game/scripts/scene/scene_day_4.rpy:15405
translate belarusian d4_beasts_choice_refuse_1168c6fe:

    # voice "voice/Alisa/4day/85 Ni.ogg"
    # Alis "Никто не причинит тебе зла, пока я рядом." id d4_beasts_choice_refuse_1168c6fe
    voice "voice/Alisa/4day/85 Ni.ogg"
    Alis "Ніхто не зробіць табе зла, пакуль я побач."

# game/scripts/scene/scene_day_4.rpy:15407
translate belarusian d4_beasts_choice_refuse_ec8ea7b9:

    # voice "voice/Alisa/4day/86 Nite.ogg"
    # Alis "Ни тебе, ни Оле."
    voice "voice/Alisa/4day/86 Nite.ogg"
    Alis "Ні табе, ні Олі."

# game/scripts/scene/scene_day_4.rpy:15409
translate belarusian d4_beasts_choice_refuse_90bf5e82:

    # voice "voice/Alisa/4day/87 Tak.ogg"
    # Alis "Так что съешь, пожалуйста, всего одну."
    voice "voice/Alisa/4day/87 Tak.ogg"
    Alis "Так што з'еш, калі ласка, усяго адну."

# game/scripts/scene/scene_day_4.rpy:15411
translate belarusian d4_beasts_choice_refuse_553cb373:

    # voice "voice/Alisa/4day/88  S.ogg"
    # Alis "Съешь, а?"
    voice "voice/Alisa/4day/88  S.ogg"
    Alis "З'еш, а?"

# game/scripts/scene/scene_day_4.rpy:15430
translate belarusian d4_beasts_choice_refuse_b0fca83a:

    # voice "voice/olya/4day/44 An.ogg"
    # Oly "Антон, пусти! Ну пусти!"
    voice "voice/olya/4day/44 An.ogg"
    Oly "Антон, пусці! Ну пусці!"

# game/scripts/scene/scene_day_4.rpy:15434
translate belarusian d4_beasts_choice_refuse_cc9a7989:

    # voice "voice/olya/4day/45 T.ogg"
    voice "voice/olya/4day/45 T.ogg"

# game/scripts/scene/scene_day_4.rpy:15436
translate belarusian d4_beasts_choice_refuse_af5a51b1:

    # Oly "Теперь и ты всё мне запрещаешь, прям как мама!"
    Oly "Цяпер і ты ўсё мне забараняеш, проста як мама!"

# game/scripts/scene/scene_day_4.rpy:15438
translate belarusian d4_beasts_choice_refuse_d5cf7410:

    # "Оля билась в истерике, силясь разжать мою хватку."
    "Оля білася ў істэрыцы, намагаючыся расціснуць маю хватку."

# game/scripts/scene/scene_day_4.rpy:15457
translate belarusian d4_beasts_choice_refuse_2a17ef02:

    # voice "voice/anton/4day/190Eto.ogg"
    # Ant "Это неправильно..."
    voice "voice/anton/4day/190Eto.ogg"
    Ant "Гэта няправільна..."

# game/scripts/scene/scene_day_4.rpy:15460
translate belarusian d4_beasts_choice_refuse_509ddf27:

    # voice "voice/anton/4day/191 V.ogg"
    # Ant "Всё здесь какое-то неправильное."
    voice "voice/anton/4day/191 V.ogg"
    Ant "Усё тут нейкае няправільнае."

# game/scripts/scene/scene_day_4.rpy:15478
translate belarusian d4_beasts_choice_refuse_e4227c9e:

    # voice "voice/Alisa/4day/89 Vot.ogg"
    # Alis "Вот как?"
    voice "voice/Alisa/4day/89 Vot.ogg"
    Alis "Вось як?"

# game/scripts/scene/scene_day_4.rpy:15480
translate belarusian d4_beasts_choice_refuse_b6c71aa2:

    # voice "voice/Alisa/4day/90 At.ogg"
    # Alis "А ты не задумывался, что из неправильного тут только твоё мировоззрение?"
    voice "voice/Alisa/4day/90 At.ogg"
    Alis "А ты не задумваўся, што з няправільнага тут толькі твой светапогляд?"

# game/scripts/scene/scene_day_4.rpy:15482
translate belarusian d4_beasts_choice_refuse_38874dbe:

    # voice "voice/Alisa/4day/91 Kak.ogg"
    # Alis "Как ты думаешь, что делают те таблетки, которые ты глотаешь круглые сутки, м?"
    voice "voice/Alisa/4day/91 Kak.ogg"
    Alis "Як ты думаеш, што робяць тыя таблеткі, якія ты глытаеш круглыя суткі, м?"

# game/scripts/scene/scene_day_4.rpy:15484
translate belarusian d4_beasts_choice_refuse_df4bed80:

    # voice "voice/Alisa/4day/92 Oni.ogg"
    # Alis "Они искажают реальность, путают мысли, уводят тебя со снежной тропинки."
    voice "voice/Alisa/4day/92 Oni.ogg"
    Alis "Яны скажаюць рэальнасць, блытаюць думкі, зводзяць цябе са снежнай сцяжынкі."

# game/scripts/scene/scene_day_4.rpy:15526
translate belarusian d4_beasts_choice_refuse_42b2c7c1:

    # "Я с подозрением посмотрел на Алису, пытаясь найти, чем ей возразить..."
    "Я з падазрэннем паглядзеў на Алісу, спрабуючы знайсці, чым ёй запярэчыць..."

# game/scripts/scene/scene_day_4.rpy:15527
translate belarusian d4_beasts_choice_refuse_69587d6b:

    # "...но не смог." id d4_beasts_choice_refuse_69587d6b
    "...але не змог."

# game/scripts/scene/scene_day_4.rpy:15537
translate belarusian d4_beasts_choice_refuse_c744cd2e:

    # "Вспомнилась окровавленная варежка Вовы."
    "Успомнілася акрываўленая рукавічка Вовы."

# game/scripts/scene/scene_day_4.rpy:15538
translate belarusian d4_beasts_choice_refuse_1d0a2b44:

    # "Это было лишь иллюзией."
    "Гэта было толькі ілюзіяй."

# game/scripts/scene/scene_day_4.rpy:15602
translate belarusian d4_beasts_choice_refuse_46df7aeb:

    # "Вспомнился обрубленный палец Семёна в пакете."
    "Успомніўся адсечаны палец Сямёна ў пакеце."

# game/scripts/scene/scene_day_4.rpy:15603
translate belarusian d4_beasts_choice_refuse_1d0a2b44_1:

    # "Это было лишь иллюзией."
    "Гэта было толькі ілюзіяй."

# game/scripts/scene/scene_day_4.rpy:15669
translate belarusian d4_beasts_choice_refuse_86ddc5fa:

    # "Вспомнились окровавленная варежка Вовы, обрубленный палец Семёна в пакете."
    "Успомніліся акрываўленая рукавічка Вовы, адсечаны палец Сямёна ў пакеце."

# game/scripts/scene/scene_day_4.rpy:15670
translate belarusian d4_beasts_choice_refuse_9da3bb8c:

    # "Всё это было лишь иллюзией."
    "Усё гэта было толькі ілюзіяй."

# game/scripts/scene/scene_day_4.rpy:15688
translate belarusian d4_beasts_choice_refuse_17af32f0:

    # voice "voice/anton/4day/191. Kto.ogg"
    # Ant "К-кто вы?"
    voice "voice/anton/4day/191. Kto.ogg"
    Ant "Х-хто вы?"

# game/scripts/scene/scene_day_4.rpy:15722
translate belarusian d4_beasts_choice_refuse_daf5eedc:

    # voice "voice/kozel/4day/96.Ana.ogg"
    # Frost "А на кого мы похожи?"
    voice "voice/kozel/4day/96.Ana.ogg"
    Frost "А на каго мы падобныя?"

# game/scripts/scene/scene_day_4.rpy:15724
translate belarusian d4_beasts_choice_refuse_e09cf1ab:

    # "На кошмары, терзающие мой больной рассудок."
    "На кашмары, што катуюць мой хворы розум."

# game/scripts/scene/scene_day_4.rpy:15739
translate belarusian d4_beasts_choice_refuse_af4905bc:

    # voice "voice/kozel/4day/97.Sname.ogg"
    # Frost "С нами вас никто больше не накажет, не запрёт в комнате, не бросит в одиночестве."
    voice "voice/kozel/4day/97.Sname.ogg"
    Frost "З намі вас ніхто больш не пакарае, не замкне ў пакоі, не кіне ў адзіноце."

# game/scripts/scene/scene_day_4.rpy:15741
translate belarusian d4_beasts_choice_refuse_a94d9441:

    # voice "voice/kozel/4day/98.Ot.ogg"
    # Frost "Отныне никто не заставит вас делать то, что вам не хочется."
    voice "voice/kozel/4day/98.Ot.ogg"
    Frost "Адгэтуль ніхто не прымусіць вас рабіць тое, чаго вам не хочацца."

# game/scripts/scene/scene_day_4.rpy:15761
translate belarusian d4_beasts_choice_refuse_2e241738:

    # voice "voice/anton/4day/otkuda.ogg"
    # Ant "Откуда вы знаете, чего нам не хочется?"
    voice "voice/anton/4day/otkuda.ogg"
    Ant "Адкуль вы ведаеце, чаго нам не хочацца?"

# game/scripts/scene/scene_day_4.rpy:15766
translate belarusian d4_beasts_choice_refuse_6104c4c6:

    # "Старик потрепал за ушком громко чавкающего Волчика."
    "Стары патрапаў за вушкам Воўчыка, які гучна плямкаў."

# game/scripts/scene/scene_day_4.rpy:15777
translate belarusian d4_beasts_choice_refuse_a44fea29:

    # voice "voice/kozel/4day/99.Ya.ogg"
    # Frost "Я знаю."
    voice "voice/kozel/4day/99.Ya.ogg"
    Frost "Я ведаю."

# game/scripts/scene/scene_day_4.rpy:15779
translate belarusian d4_beasts_choice_refuse_3dfd0733:

    # voice "voice/kozel/4day/100.Mne.ogg"
    # Frost "Мне шепчут ветра и тени, холодные звёзды и безграничные небеса."
    voice "voice/kozel/4day/100.Mne.ogg"
    Frost "Мне шэпчуць вятры і цені, халодныя зоркі і бязмежныя нябёсы."

# game/scripts/scene/scene_day_4.rpy:15781
translate belarusian d4_beasts_choice_refuse_a35ce320:

    # voice "voice/kozel/4day/102.On.ogg"
    # Frost "Они говорят, что дети не хотят взрослеть."
    voice "voice/kozel/4day/102.On.ogg"
    Frost "Яны кажуць, што дзеці не хочуць сталець."

# game/scripts/scene/scene_day_4.rpy:15783
translate belarusian d4_beasts_choice_refuse_146e2dd3:

    # voice "voice/kozel/4day/103.Pre.ogg"
    # Frost "Превращаться в тех, кто живёт запретами, угрозами, наказаниями."
    voice "voice/kozel/4day/103.Pre.ogg"
    Frost "Ператварацца ў тых, хто жыве забаронамі, пагрозамі, пакараннямі."

# game/scripts/scene/scene_day_4.rpy:15785
translate belarusian d4_beasts_choice_refuse_a3566ee7:

    # "Каждое следующее слово он говорил всё громче."
    "Кожнае наступнае слова ён казаў усё гучней."

# game/scripts/scene/scene_day_4.rpy:15787
translate belarusian d4_beasts_choice_refuse_f741df14:

    # voice "voice/kozel/4day/104.Oz.ogg"
    # Frost "Ожиданием старости и смерти."
    voice "voice/kozel/4day/104.Oz.ogg"
    Frost "Чаканнем старасці і смерці."

# game/scripts/scene/scene_day_4.rpy:15789
translate belarusian d4_beasts_choice_refuse_35ba5222:

    # voice "voice/kozel/4day/105.De.ogg"
    voice "voice/kozel/4day/105.De.ogg"

# game/scripts/scene/scene_day_4.rpy:15791
translate belarusian d4_beasts_choice_refuse_6e433b24:

    # Frost "Дети живут мечтами."
    Frost "Дзеці жывуць марамі."

# game/scripts/scene/scene_day_4.rpy:15792
translate belarusian d4_beasts_choice_refuse_55cacc8a:

    # voice "voice/kozel/4day/106.O.ogg"
    # Frost "О, я отлично знаю детские мечты о счастливой и беззаботной жизни."
    voice "voice/kozel/4day/106.O.ogg"
    Frost "О, я выдатна ведаю дзіцячыя мары пра шчаслівае і бесклапотнае жыццё."

# game/scripts/scene/scene_day_4.rpy:15795
translate belarusian d4_beasts_choice_refuse_1ede2e4b:

    # voice "voice/kozel/4day/107.Toi.ogg"
    # Frost "Той, в которой есть чудеса и дикая свобода."
    voice "voice/kozel/4day/107.Toi.ogg"
    Frost "Тое, у якім ёсць цуды і дзікая свабода."

# game/scripts/scene/scene_day_4.rpy:15797
translate belarusian d4_beasts_choice_refuse_a617c634:

    # "Голос его был громом, от которого волосы на голове вставали дыбом."
    "Голас яго быў громам, ад якога валасы на галаве станавіліся дыбам."

# game/scripts/scene/scene_day_4.rpy:15798
translate belarusian d4_beasts_choice_refuse_6112722c:

    # voice "voice/kozel/4day/108.Sto.ogg"
    voice "voice/kozel/4day/108.Sto.ogg"

# game/scripts/scene/scene_day_4.rpy:15800
translate belarusian d4_beasts_choice_refuse_72b51145:

    # Frost "Всё это будет вашим — стоит только захотеть."
    Frost "Усё гэта будзе вашым — варта толькі захацець."

# game/scripts/scene/scene_day_4.rpy:15801
translate belarusian d4_beasts_choice_refuse_93c86371:

    # voice "voice/kozel/4day/110.S.ogg"
    # Frost "Стоит только попросить."
    voice "voice/kozel/4day/110.S.ogg"
    Frost "Варта толькі папрасіць."

# game/scripts/scene/scene_day_4.rpy:15803
translate belarusian d4_beasts_choice_refuse_59da6d7d:

    # "И совсем шёпотом:"
    "І зусім шэптам:"

# game/scripts/scene/scene_day_4.rpy:15805
translate belarusian d4_beasts_choice_refuse_b1397791:

    # voice "voice/kozel/4day/111.St.ogg"
    # Frost "Стоит только согласиться..."
    voice "voice/kozel/4day/111.St.ogg"
    Frost "Варта толькі пагадзіцца..."

# game/scripts/scene/scene_day_4.rpy:15846
translate belarusian d4_beasts_choice_refuse_cbdf6955:

    # voice "voice/olya/4day/47 So.ogg"
    # Oly "Согласиться..."
    voice "voice/olya/4day/47 So.ogg"
    Oly "Пагадзіцца..."

# game/scripts/scene/scene_day_4.rpy:15849
translate belarusian d4_beasts_choice_refuse_e3244562:

    # "Словно эхо, повторила зачарованная Оля."
    "Нібы рэха, паўтарыла зачараваная Оля."

# game/scripts/scene/scene_day_4.rpy:15861
translate belarusian d4_beasts_choice_refuse_053a3bd9:

    # voice "voice/kozel/4day/112.Da.ogg"
    # Frost "Да, моя дорогая."
    voice "voice/kozel/4day/112.Da.ogg"
    Frost "Так, мая дарагая."

# game/scripts/scene/scene_day_4.rpy:15863
translate belarusian d4_beasts_choice_refuse_1139145d:

    # voice "voice/kozel/4day/113.Vk.ogg"
    # Frost "Вкусить это."
    voice "voice/kozel/4day/113.Vk.ogg"
    Frost "Пакаштаваць гэта."

# game/scripts/scene/scene_day_4.rpy:15880
translate belarusian d4_beasts_choice_refuse_e3041117:

    # "Старец ткнул перстом в сторону лисицы."
    "Старац тыцнуў перстам у бок лісіцы."

# game/scripts/scene/scene_day_4.rpy:15881
translate belarusian d4_beasts_choice_refuse_1cf6ee97:

    # voice "voice/Alisa/4day/93 ya.ogg"
    # Alis "Я прошу тебя ради всех нас, ради меня, ради сестры..."
    voice "voice/Alisa/4day/93 ya.ogg"
    Alis "Я прашу цябе дзеля ўсіх нас, дзеля мяне, дзеля сястры..."

# game/scripts/scene/scene_day_4.rpy:15898
translate belarusian d4_beasts_choice_refuse_549bd4a5:

    # voice "voice/Alisa/4day/94 Zai.ogg"
    # Alis "Зайчик, отведай хотя бы кусочек." id d4_beasts_choice_refuse_549bd4a5
    voice "voice/Alisa/4day/94 Zai.ogg"
    Alis "Зайчык, скаштуй хаця б кавалачак."

# game/scripts/scene/scene_day_4.rpy:15900
translate belarusian d4_beasts_choice_refuse_57e9bc3a:

    # voice "voice/Alisa/4day/95 E.ogg"
    # Alis "И тогда ты всё поймешь." id d4_beasts_choice_refuse_57e9bc3a
    voice "voice/Alisa/4day/95 E.ogg"
    Alis "І тады ты ўсё зразумееш."

# game/scripts/scene/scene_day_4.rpy:15962
translate belarusian d4_beasts_choice2_refuse_ce438f89:

    # "У меня возникло чувство, что ледяной ветер дует из дыр её глаз, из тёмных глазных провалов других зверей и долговязого старика."
    "У мяне ўзнікла адчуванне, што ледзяны вецер дзьме з дзірак яе вачэй, з цёмных вачных правалаў іншых звяроў і даўгавязага старога."

# game/scripts/scene/scene_day_4.rpy:15964
translate belarusian d4_beasts_choice2_refuse_fd9558e1:

    # "Морда совы нервно подёргивалась."
    "Морда савы нервова паторгвалася."

# game/scripts/scene/scene_day_4.rpy:15965
translate belarusian d4_beasts_choice2_refuse_85148a9d:

    # "Пасть волка истекала слюной."
    "Пашча ваўка сцякала слінай."

# game/scripts/scene/scene_day_4.rpy:15967
translate belarusian d4_beasts_choice2_refuse_24754e1e:

    # "Медведь переминался с лапы на лапу, враз избавившись от сонливости."
    "Мядзведзь перамінаўся з лапы на лапу, ураз пазбавіўшыся ад санлівасці."

# game/scripts/scene/scene_day_4.rpy:15985
translate belarusian d4_beasts_choice2_refuse_b525ce9d:

    # "А сзади нависал тот, кто всё это время притворялся Дедом Морозом."
    "А ззаду навісаў той, хто ўвесь гэты час прыкідваўся Дзедам Марозам."

# game/scripts/scene/scene_day_4.rpy:16003
translate belarusian d4_beasts_choice2_refuse_f44e26fc:

    # voice "voice/anton/4day/192. Yaska.ogg"
    # Ant "Я сказал: мы уходим."
    voice "voice/anton/4day/192. Yaska.ogg"
    Ant "Я сказаў: мы сыходзім."

# game/scripts/scene/scene_day_4.rpy:16009
translate belarusian d4_beasts_choice2_refuse_c87fa6d8:

    # "Я покрепче стиснул руку сестры. Конфета выпала из её пальцев, шмякнувшись о пол."
    "Я мацней сціснуў руку сястры. Цукерка выпала з яе пальцаў, ляпнуўшыся аб падлогу."

# game/scripts/scene/scene_day_4.rpy:16018
translate belarusian d4_beasts_choice2_refuse_1fac5dde:

    # "Теперь и Оля испуганно озиралась."
    "Цяпер і Оля спалохана азіралася."

# game/scripts/scene/scene_day_4.rpy:16027
translate belarusian d4_beasts_choice2_refuse_962fbd05:

    # voice "voice/Alisa/4day/YaSkazal.ogg"
    # Alis "Я сказал: мы уходим!"
    voice "voice/Alisa/4day/YaSkazal.ogg"
    Alis "Я сказаў: мы сыходзім!"

# game/scripts/scene/scene_day_4.rpy:16029
translate belarusian d4_beasts_choice2_refuse_78822135:

    # "Алиса передразнивала меня, и вопреки всему я испытал острую обиду."
    "Аліса перакрыўляла мяне, і насуперак усяму я адчуў вострую крыўду."

# game/scripts/scene/scene_day_4.rpy:16032
translate belarusian d4_beasts_choice2_refuse_55bc746e:

    # voice "voice/Alisa/4day/96 oh.ogg"
    # Alis "Ох, ну какой же ты всё-таки..."
    voice "voice/Alisa/4day/96 oh.ogg"
    Alis "Ох, ну які ж ты ўсё-такі..."

# game/scripts/scene/scene_day_4.rpy:16038
translate belarusian d4_beasts_choice2_refuse_11fd4757:

    # voice "voice/Alisa/4day/96 Du.ogg"
    # Alis "...дурачок." id d4_beasts_choice2_refuse_11fd4757
    voice "voice/Alisa/4day/96 Du.ogg"
    Alis "...дурачок."

# game/scripts/scene/scene_day_4.rpy:16057
translate belarusian d4_beasts_choice2_refuse_0616de1d:

    # "Я услышал мелодию флейты, но теперь она напоминала свист хлыста или агонию рыбы, выброшенной на лёд."
    "Я пачуў мелодыю флейты, але цяпер яна нагадвала свіст хлыста або агонію рыбы, выкінутай на лёд."

# game/scripts/scene/scene_day_4.rpy:16059
translate belarusian d4_beasts_choice2_refuse_c5358f32:

    # "Музыка трепыхалась и била по ушам."
    "Музыка трапяталася і біла па вушах."

# game/scripts/scene/scene_day_4.rpy:16064
translate belarusian d4_beasts_choice2_refuse_02820830:

    # "А затем ледяной терем заполнил детский плач, перерастающий в звериный лай, хруст костей и звук лопающихся шкур."
    "А потым ледзяны церам запоўніў дзіцячы плач, які перарастаў у звярыны брэх, хруст касцей і гук шкур, што лопаліся."

# game/scripts/scene/scene_day_4.rpy:16083
translate belarusian d4_beasts_choice2_refuse_f231ce12:

    # "Вдребезги разбилась фарфоровая тарелка, до краёв наполненная опарышами."
    "Ушчэнт разбілася фарфоравая талерка, да краёў напоўненая апарышамі."

# game/scripts/scene/scene_day_4.rpy:16113
translate belarusian d4_beasts_choice2_refuse_bce776aa:

    # "Рыжая шуба Алисы лопнула по швам, выпустив смердящий пар."
    "Рудая шуба Алісы лопнула па швах, выпусціўшы смярдзючую пару."

# game/scripts/scene/scene_day_4.rpy:16122
translate belarusian d4_beasts_choice2_refuse_aee3844a:

    # "Её искорёженная морда оскалилась — и вонь шибанула мне в ноздри."
    "Яе пакарэжаная морда ашчэрылася — і смурод шыбануў мне ў ноздры."

# game/scripts/scene/scene_day_4.rpy:16140
translate belarusian d4_beasts_choice2_refuse_54d659fe:

    # "Лиса кричала, а кровь текла по её щекам, будто слёзы, заставляя шерсть слипаться. Облысевший хвост бил позвонками о стены."
    "Ліса крычала, а кроў цякла па яе шчоках, нібы слёзы, прымушаючы поўсць зліпацца. Аблыселы хвост біў пазванкамі аб сцены."

# game/scripts/scene/scene_day_4.rpy:16156
translate belarusian d4_beasts_choice2_refuse_a59f651a:

    # "Я заслонил собой плачущую сестру."
    "Я засланіў сабой сястру, што плакала."

# game/scripts/scene/scene_day_4.rpy:16157
translate belarusian d4_beasts_choice2_refuse_bef2ec97:

    # "Ужас ввинчивался в живот, бежал по кишкам, подступал к горлу."
    "Жах увінчваўся ў жывот, бег па кішках, падступаў да горла."

# game/scripts/scene/scene_day_4.rpy:16158
translate belarusian d4_beasts_choice2_refuse_ebf6be37:

    # "Хотелось сорвать очки, чтобы всего этого не видеть, выдавить глаза, чтобы навсегда ослепнуть."
    "Хацелася сарваць акуляры, каб усяго гэтага не бачыць, выціснуць вочы, каб назаўжды аслепнуць."

# game/scripts/scene/scene_day_4.rpy:16184
translate belarusian d4_beasts_choice2_refuse_be1c6b2a:

    # "Обернувшись к Сове, я скривился от отвращения."
    "Абярнуўшыся да Савы, я скрывіўся ад агіды."

# game/scripts/scene/scene_day_4.rpy:16186
translate belarusian d4_beasts_choice2_refuse_189bfd7c:

    # "Черви копошились в перьях её маски. Сгнивший клюв щёлкал, как садовые ножницы."
    "Чарвякі капашыліся ў пер'і яе маскі. Згнілая дзюба шчоўкала, як садовыя нажніцы."

# game/scripts/scene/scene_day_4.rpy:16205
translate belarusian d4_beasts_choice2_refuse_df6e86d7:

    # "Я отшатнулся, едва не врезавшись в волка."
    "Я адхіснуўся, ледзь не ўрэзаўшыся ў ваўка."

# game/scripts/scene/scene_day_4.rpy:16206
translate belarusian d4_beasts_choice2_refuse_241f171c:

    # "Его морда вытягивалась, кости хрустели."
    "Яго морда выцягвалася, косці хрусцелі."

# game/scripts/scene/scene_day_4.rpy:16207
translate belarusian d4_beasts_choice2_refuse_b4d9f208:

    # "Зубы торчали из гноящихся дёсен, словно осколки стекла, а разбухший язык неустанно их облизывал."
    "Зубы тырчалі з дзёсен, што гнаіліся, нібы аскепкі шкла, а разбухлы язык нястомна іх аблізваў."

# game/scripts/scene/scene_day_4.rpy:16249
translate belarusian d4_beasts_choice2_refuse_c5e51060:

    # "Краем глаза я заметил, как медведь загородил проход. Каждый миллиметр его плоти сочился алой сукровицей. Личинки заклеили слезящиеся глаза."
    "Краем вока я заўважыў, як мядзведзь загарадзіў праход. Кожны міліметр яго плоці сачыўся пунсовай сукравіцай. Лічынкі заклеілі вочы, што слязіліся."

# game/scripts/scene/scene_day_4.rpy:16282
translate belarusian d4_beasts_choice2_refuse_55abac6d:

    # "Я притянул шокированную Олю к себе, в панике ища выход."
    "Я прыцягнуў шакіраваную Олю да сябе, у паніцы шукаючы выхад."

# game/scripts/scene/scene_day_4.rpy:16292
translate belarusian d4_beasts_choice2_refuse_3213d126:

    # "Нога угодила в груду сладостей, но это были уже не конфеты."
    "Нага трапіла ў груду ласункаў, але гэта былі ўжо не цукеркі."

# game/scripts/scene/scene_day_4.rpy:16296
translate belarusian d4_beasts_choice2_refuse_fb3f6838:

    # "На полу лежали человеческие останки."
    "На падлозе ляжалі чалавечыя парэшткі."

# game/scripts/scene/scene_day_4.rpy:16299
translate belarusian d4_beasts_choice2_refuse_484a684b:

    # "Рёбра в лохмотьях мяса и выкорчеванные челюсти."
    "Рэбры ў шматках мяса і выкарчаваныя сківіцы."

# game/scripts/scene/scene_day_4.rpy:16300
translate belarusian d4_beasts_choice2_refuse_4af5c2b0:

    # "Бисер зубов и заплесневелые кости таза."
    "Бісер зубоў і заплеснелыя косці таза."

# game/scripts/scene/scene_day_4.rpy:16321
translate belarusian d4_beasts_choice2_refuse_9cbbef12:

    # "Крошечные черепа и плавающие в реках крови скальпы."
    "Малюсенькія чарапы і скальпы, што плавалі ў рэках крыві."

# game/scripts/scene/scene_day_4.rpy:16322
translate belarusian d4_beasts_choice2_refuse_1b099c1f:

    # voice "voice/kozel/4day/114.Esh.ogg"
    # Noname "Ешь!"
    voice "voice/kozel/4day/114.Esh.ogg"
    Noname "Еш!"

# game/scripts/scene/scene_day_4.rpy:16351
translate belarusian d4_beasts_choice2_refuse_8510d9be:

    # "Надо мной возвышалась рогатая уродина, сжимая в длинных когтистых руках костяную флейту."
    "Нада мной узвышалася рагатая пачвара, сціскаючы ў доўгіх кіпцюрыстых руках касцяную флейту."

# game/scripts/scene/scene_day_4.rpy:16367
translate belarusian d4_beasts_choice2_refuse_45302f53:

    # "Гигантский, сбросивший обличие старца, Козёл."
    "Гіганцкі Казёл, які скінуў аблічча старца."

# game/scripts/scene/scene_day_4.rpy:16369
translate belarusian d4_beasts_choice2_refuse_98bc1a52:

    # "Чёрный, источающий ненависть и злобу, он испепелял раскалёнными углями глазищ."
    "Чорны, выпраменьваючы нянавісць і злосць, ён спапяляў распаленымі вуглямі вачышчаў."

# game/scripts/scene/scene_day_4.rpy:16375
translate belarusian d4_beasts_choice2_refuse_b70dc29e:

    # "Его рога царапали потолок."
    "Яго рогі драпалі столь."

# game/scripts/scene/scene_day_4.rpy:16463
translate belarusian d4_beasts_choice2_refuse_3f42e7e8:

    # "Лёд откалывался и таял, стекая в грязные лужи, а под ним обнажались металлические стены."
    "Лёд адколваўся і раставаў, сцякаючы ў брудныя лужыны, а пад ім агаляліся металічныя сцены."

# game/scripts/scene/scene_day_4.rpy:16464
translate belarusian d4_beasts_choice2_refuse_97ad0eea:

    # "Я понял, что мы обречены в тесном чреве темницы, оцеплённые воющими чудовищами."
    "Я зразумеў, што мы асуджаныя ў цесным чэраве цямніцы, ачэпленыя пачварамі, што вылі."

# game/scripts/scene/scene_day_4.rpy:16465
translate belarusian d4_beasts_choice2_refuse_e1741870:

    # "И оставалось лишь крепче прижимать к себе сестру и смотреть, как сужается круг, как мерзкие лапы тянутся из кровавого марева."
    "І заставалася толькі мацней прыціскаць да сябе сястру і глядзець, як звужаецца кола, як агідныя лапы цягнуцца з крывавага марыва."

# game/scripts/scene/scene_day_4.rpy:16481
translate belarusian d4_beasts_choice2_refuse_665517fa:

    # voice "voice/Wolf/327 Poz.ogg"
    # Wolf "Позволь, Хозяин, я разор-р-рву их на части!"
    voice "voice/Wolf/327 Poz.ogg"
    Wolf "Дазволь, Гаспадар, я разар-р-рву іх на часткі!"

# game/scripts/scene/scene_day_4.rpy:16489
translate belarusian d4_beasts_choice2_refuse_d369c89e:

    # voice "voice/Wolf/328 Ya.ogg"
    # Wolf "Я выр-р-рву их глазные яблоки и тр-р-рахну их в сочащиеся р-р-раны!"
    voice "voice/Wolf/328 Ya.ogg"
    Wolf "Я выр-р-рву іх вочныя яблыкі і тр-р-рахну іх у р-р-раны, што сачацца!"

# game/scripts/scene/scene_day_4.rpy:16497
translate belarusian d4_beasts_choice2_refuse_c69e8c93:

    # voice "voice/Wolf/329 Y.ogg"
    # Wolf "Я... Я..."
    voice "voice/Wolf/329 Y.ogg"
    Wolf "Я... Я..."

# game/scripts/scene/scene_day_4.rpy:16505
translate belarusian d4_beasts_choice2_refuse_f50465c0:

    # "Пасть рычащего волка клацнула, словно капкан, — и густая белая пена брызнула в нашу сторону."
    "Пашча ваўка, які рыкаў, клацнула, нібы капкан, — і густая белая пена пырснула ў наш бок."

# game/scripts/scene/scene_day_4.rpy:16522
translate belarusian d4_beasts_choice2_refuse_1bd8c6a4:

    # "Тут же заживо гниющий медведь грубо оттолкнул бешеного собрата."
    "Тут жа мядзведзь, які гніў жыўцом, груба адштурхнуў шалёнага сабрата."

# game/scripts/scene/scene_day_4.rpy:16533
translate belarusian d4_beasts_choice2_refuse_52a78413:

    # voice "voice/Bear/4day/45 Dudki.ogg"
    # Bear "Дудки! Мой черёд веселиться."
    voice "voice/Bear/4day/45 Dudki.ogg"
    Bear "Дудкі! Мая чарга весяліцца."

# game/scripts/scene/scene_day_4.rpy:16545
translate belarusian d4_beasts_choice2_refuse_19696ed1:

    # voice "voice/Bear/4day/46 Kak.ogg"
    # Bear "Как же я утомился слушать их сраный гундёж!"
    voice "voice/Bear/4day/46 Kak.ogg"
    Bear "Як жа я стаміўся слухаць іх сранае гундосанне!"

# game/scripts/scene/scene_day_4.rpy:16557
translate belarusian d4_beasts_choice2_refuse_ab6fd684:

    # voice "voice/Bear/4day/47 YaZiv.ogg"
    # Bear "О, я живьём сорву кожу с этой грёбаной козявки прямо на глазах её братца."
    voice "voice/Bear/4day/47 YaZiv.ogg"
    Bear "О, я жыўцом сарву скуру з гэтай грэбанай казяўкі проста на вачах яе браткі."

# game/scripts/scene/scene_day_4.rpy:16569
translate belarusian d4_beasts_choice2_refuse_b720ed44:

    # voice "voice/Bear/4day/48 Ya.ogg"
    # Bear "Я заставлю его съесть собственную сестру. Накормлю его досыта её потрохами."
    voice "voice/Bear/4day/48 Ya.ogg"
    Bear "Я прымушу яго з'есці ўласную сястру. Накармлю яго дасыта яе вантробамі."

# game/scripts/scene/scene_day_4.rpy:16581
translate belarusian d4_beasts_choice2_refuse_5795d50f:

    # voice "voice/Bear/4day/49 Po.ogg"
    # Bear "Пожалуйста, Хозяин..."
    voice "voice/Bear/4day/49 Po.ogg"
    Bear "Калі ласка, Гаспадар..."

# game/scripts/scene/scene_day_4.rpy:16593
translate belarusian d4_beasts_choice2_refuse_aaa1e26a:

    # "Казалось, сейчас его морда треснет, расколется, как яйцо, из которого проклюнется что-то ещё более мерзкое, страшное..."
    "Здавалася, зараз яго морда трэсне, расколецца, як яйка, з якога праклюнецца нешта яшчэ больш брыдкае, страшнае..."

# game/scripts/scene/scene_day_4.rpy:16608
translate belarusian d4_beasts_choice2_refuse_8b388ac1:

    # "В оскалившегося медведя вцепились совиные когти-крючья, не давая тому приблизиться."
    "У ашчэранага мядзведзя ўчапіліся савіныя кіпцюры-крукі, не даючы таму наблізіцца."

# game/scripts/scene/scene_day_4.rpy:16637
translate belarusian d4_beasts_choice2_refuse_ebf7ba0a:

    # voice "voice/Owl/4day/Ona.ogg"
    # Owl "Она моя! Моя, выблядки!"
    voice "voice/Owl/4day/Ona.ogg"
    Owl "Яна мая! Мая, выблядкі!"

# game/scripts/scene/scene_day_4.rpy:16654
translate belarusian d4_beasts_choice2_refuse_5ba69117:

    # voice "voice/Owl/4day/Lapi.ogg"
    # Owl "Лапы прочь от девчонки!"
    voice "voice/Owl/4day/Lapi.ogg"
    Owl "Лапы прэч ад дзяўчынкі!"

# game/scripts/scene/scene_day_4.rpy:16697
translate belarusian d4_beasts_choice2_refuse_fc53d2d8:

    # "Клокочущий зверинец свалился в кучу, барахтаясь в кишках и талом жире."
    "Звярынец, што клякатаў, зваліўся ў кучу, барахтаючыся ў кішках і талым тлушчы."

# game/scripts/scene/scene_day_4.rpy:16699
translate belarusian d4_beasts_choice2_refuse_6741ebcc:

    # "Они выли, дрались, кусались, вырывали друг дружке клочки шерсти и горсти перьев, готовые растерзать друг друга, как свора голодных псов из-за объедков."
    "Яны вылі, біліся, кусаліся, вырывалі адно аднаму шматкі поўсці і жмені пер'я, гатовыя разадраць адно аднаго, як зграя галодных псоў з-за аб'едкаў."

# game/scripts/scene/scene_day_4.rpy:16725
translate belarusian d4_beasts_choice2_refuse_3ea19181:

    # "Вдруг визг флейты отдёрнул их, словно поводок."
    "Раптам віск флейты адцягнуў іх, нібы павадок."

# game/scripts/scene/scene_day_4.rpy:16756
translate belarusian d4_beasts_choice2_refuse_7eb5656f:

    # "Хозяин стаи околдовал страшил своей душераздирающей музыкой, вновь обратив их в неподвижные молчащие марионетки, верно ждущие команды «фас»."
    "Гаспадар зграі зачараваў страшыдлаў сваёй душараздзіральнай музыкай, зноў ператварыўшы іх у нерухомыя маўклівыя марыянеткі, якія аддана чакалі каманды «фас»."

# game/scripts/scene/scene_day_4.rpy:16769
translate belarusian d4_beasts_choice2_refuse_bda71c81:

    # "Козёл перестал обгладывать флейту из берцовой кости."
    "Казёл перастаў абглодваць флейту з галёначнай косці."

# game/scripts/scene/scene_day_4.rpy:16771
translate belarusian d4_beasts_choice2_refuse_241d583c:

    # "В последний раз смолкла дьявольская мелодия — хор вопящих младенцев, угодивших под каток."
    "У апошні раз змоўкла д'ябальская мелодыя — хор немаўлят, што лямантавалі, трапіўшы пад каток."

# game/scripts/scene/scene_day_4.rpy:16778
translate belarusian d4_beasts_choice2_refuse_95821f91:

    # "Кусок сырого человеческого мяса шлёпнулся у моих дрожащих ног."
    "Кавалак сырога чалавечага мяса шлёпнуўся каля маіх дрыготкіх ног."

# game/scripts/scene/scene_day_4.rpy:16801
translate belarusian d4_beasts_choice2_refuse_7612253d:

    # voice "voice/kozel/4day/115.EshEli.ogg"
    # Master "Ешь. Или будешь съеденным."
    voice "voice/kozel/4day/115.EshEli.ogg"
    Master "Еш. Або будзеш з'едзеным."

# game/scripts/scene/scene_day_4.rpy:16808
translate belarusian d4_beasts_choice2_refuse_52cd3889:

    # "Вне себя от ужаса, я обернулся на Олю: та лежала в стороне, присыпанная снегом."
    "Сам не свой ад жаху, я абярнуўся на Олю: тая ляжала ўбаку, прысыпаная снегам."

# game/scripts/scene/scene_day_4.rpy:16809
translate belarusian d4_beasts_choice2_refuse_31f5f9ae:

    # "Совсем как мёртвая Белоснежка в мультфильме."
    "Зусім як мёртвая Беласнежка ў мультфільме."

# game/scripts/scene/scene_day_4.rpy:16810
translate belarusian d4_beasts_choice2_refuse_f403aa40:

    # "Возможно, она потеряла сознание от душераздирающего зрелища."
    "Магчыма, яна страціла прытомнасць ад душараздзіральнага відовішча."

# game/scripts/scene/scene_day_4.rpy:16851
translate belarusian d4_beasts_choice2_refuse_fa524e37:

    # "Мне хотелось разрыдаться в истерике, сойти с ума, умереть быстро и безболезненно прямо здесь и сейчас..."
    "Мне хацелася разрыдацца ў істэрыцы, звар'яцець, памерці хутка і бязбольна проста тут і цяпер..."

# game/scripts/scene/scene_day_4.rpy:16852
translate belarusian d4_beasts_choice2_refuse_c2a5f507:

    # "Но, увы, я не мог."
    "Але, на жаль, я не мог."

# game/scripts/scene/scene_day_4.rpy:16853
translate belarusian d4_beasts_choice2_refuse_069871b1:

    # "Я по-прежнему оставался в камере пыток, выбирая между ужасным исходом в желудках чудовищ и каннибализмом."
    "Я па-ранейшаму заставаўся ў камеры катаванняў, выбіраючы паміж жудасным канцом у страўніках пачвар і канібалізмам."

# game/scripts/scene/scene_day_4.rpy:16882
translate belarusian d4_beasts_choice3_refuse_a997034c:

    # "Шерстяные мясорубки не сводили с меня свои алчные, вечно голодные глазёнки, готовые обглодать и перемолоть все мои кости, если я посмею отказаться от предложения их Хозяина."
    "Шарсцяныя мясарубкі не зводзілі з мяне сваіх прагных, вечна галодных вочак, гатовыя абгрызці і перамалоць усе мае косці, калі я пасмею адмовіцца ад прапановы іх Гаспадара."

# game/scripts/scene/scene_day_4.rpy:16883
translate belarusian d4_beasts_choice3_refuse_413ed66e:

    # "Но стоит мне согласиться — я так же, как и они, навсегда утрачу свою волю и разум."
    "Але варта мне пагадзіцца — я гэтак жа, як і яны, назаўсёды страчу сваю волю і розум."

# game/scripts/scene/scene_day_4.rpy:16884
translate belarusian d4_beasts_choice3_refuse_3311f8fd:

    # "Превращусь в вечно голодную тварь, пляшущую под дудку кровожадного безумца."
    "Ператваруся ў вечна галодную пачвару, якая скача пад дудку крыважэрнага вар'ята."

# game/scripts/scene/scene_day_4.rpy:16885
translate belarusian d4_beasts_choice3_refuse_01045f27:

    # "И наверняка погублю Олю и всех, кого я так люблю..."
    "І напэўна загублю Олю і ўсіх, каго я так люблю..."

# game/scripts/scene/scene_day_4.rpy:16892
translate belarusian d4_beasts_choice3_refuse_bd7d872b:

    # "Губы мои тряслись, тошнота выворачивала наизнанку, но я нашёл в себе силы закричать:"
    "Вусны мае трэсліся, млоснасць выварочвала навыварат, але я знайшоў у сабе сілы закрычаць:"

# game/scripts/scene/scene_day_4.rpy:16898
translate belarusian d4_beasts_choice3_refuse_f131fd89:

    # voice "voice/anton/4day/193. Niko.ogg"
    # Ant "Никогда и ни за что! Я человек!"
    voice "voice/anton/4day/193. Niko.ogg"
    Ant "Ніколі і ні за што! Я чалавек!"

# game/scripts/scene/scene_day_4.rpy:16901
translate belarusian d4_beasts_choice3_refuse_f2bd10e5:

    # "Эти слова могли бы стать моей эпитафией, но я понимал, что никому уже не суждено найти мои останки."
    "Гэтыя словы маглі б стаць маёй эпітафіяй, але я разумеў, што нікому ўжо не суджана знайсці мае астанкі."

# game/scripts/scene/scene_day_4.rpy:16902
translate belarusian d4_beasts_choice3_refuse_9837c682:

    # "Настала гробовая тишина."
    "Настала магільная цішыня."

# game/scripts/scene/scene_day_4.rpy:16931
translate belarusian d4_beasts_choice3_refuse_e017039d:

    # voice "voice/kozel/4day/116.Este.ogg"
    # Master "Ешьте их! Бе-е-е-ейте их! Рвите на части!"
    voice "voice/kozel/4day/116.Este.ogg"
    Master "Ешце іх! Бе-е-е-ейце іх! Рвіце на часткі!"

# game/scripts/scene/scene_day_4.rpy:16981
translate belarusian d4_beasts_choice3_refuse_783a2c62:

    # "Рогатая тень накрыла нас."
    "Рагаты цень накрыў нас."

# game/scripts/scene/scene_day_4.rpy:16982
translate belarusian d4_beasts_choice3_refuse_c77abe06:

    # voice "voice/kozel/4day/119.Sl.ogg"
    # Master "Сладкое мясо!"
    voice "voice/kozel/4day/119.Sl.ogg"
    Master "Салодкае мяса!"

# game/scripts/scene/scene_day_4.rpy:17011
translate belarusian d4_beasts_choice3_refuse_45c71d44:

    # "Внезапно Алиса метнулась к козлищу и встала между нами, крошечная на фоне огромного монстра."
    "Раптам Аліса кінулася да казлішча і стала паміж намі, малюсенькая на фоне вялізнага монстра."

# game/scripts/scene/scene_day_4.rpy:17012
translate belarusian d4_beasts_choice3_refuse_a65d984c:

    # "Хвост волочился за лисой, рисуя алый след. Блохи скакали по её спине и проступившим костям."
    "Хвост валокся за лісой, малюючы пунсовы след. Блохі скакалі па яе спіне і касцях, што праступілі."

# game/scripts/scene/scene_day_4.rpy:17014
translate belarusian d4_beasts_choice3_refuse_a0fb8e77:

    # voice "voice/Alisa/4day/98 podo.ogg"
    # Alis "Подожди! Не спеши так, не стоит."
    voice "voice/Alisa/4day/98 podo.ogg"
    Alis "Пачакай! Не спяшайся так, не варта."

# game/scripts/scene/scene_day_4.rpy:17016
translate belarusian d4_beasts_choice3_refuse_03b90b2a:

    # voice "voice/Alisa/4day/99 Zai.ogg"
    # Alis "Зайчик нам ещё пригодится. Зайчик нас покормит вкусненько."
    voice "voice/Alisa/4day/99 Zai.ogg"
    Alis "Зайчык нам яшчэ спатрэбіцца. Зайчык нас пакорміць смачненька."

# game/scripts/scene/scene_day_4.rpy:17018
translate belarusian d4_beasts_choice3_refuse_5b77d29e:

    # voice "voice/Alisa/4day/101 Dlya.ogg"
    # Alis "Для медведя и лисы..."
    voice "voice/Alisa/4day/101 Dlya.ogg"
    Alis "Для мядзведзя і лісы..."

# game/scripts/scene/scene_day_4.rpy:17021
translate belarusian d4_beasts_choice3_refuse_11cb0e52:

    # voice "voice/kozel/4day/120.Za.ogg"
    # Master "...Зайчик, кушать принеси." id d4_beasts_choice3_refuse_11cb0e52
    voice "voice/kozel/4day/120.Za.ogg"
    Master "...Зайчык, есці прынясі."

# game/scripts/scene/scene_day_4.rpy:17023
translate belarusian d4_beasts_choice3_refuse_d915096d:

    # "Пламя в его глазницах замерцало."
    "Полымя ў яго вачніцах замігцела."

# game/scripts/scene/scene_day_4.rpy:17024
translate belarusian d4_beasts_choice3_refuse_7c205de3:

    # "Замершие истуканы недовольно оскалились."
    "Застылыя істуканы незадаволена ашчэрыліся."

# game/scripts/scene/scene_day_4.rpy:17071
translate belarusian d4_beasts_choice3_refuse_0611b9f8:

    # voice "voice/Bear/4day/51 Da.ogg"
    # Bear "Да разве это Зайчик?"
    voice "voice/Bear/4day/51 Da.ogg"
    Bear "Ды хіба гэта Зайчык?"

# game/scripts/scene/scene_day_4.rpy:17074
translate belarusian d4_beasts_choice3_refuse_b9c59f44:

    # voice "voice/Wolf/332 Raz.ogg"
    # Wolf "Разор-р-рвать и сожр-р-рать!"
    voice "voice/Wolf/332 Raz.ogg"
    Wolf "Разар-р-рваць і зжэр-р-рці!"

# game/scripts/scene/scene_day_4.rpy:17077
translate belarusian d4_beasts_choice3_refuse_97a893bf:

    # voice "voice/Owl/4day/Samozv.ogg"
    # Owl "Самозванец! Уху-уху!"
    voice "voice/Owl/4day/Samozv.ogg"
    Owl "Самазванец! Уху-уху!"

# game/scripts/scene/scene_day_4.rpy:17080
translate belarusian d4_beasts_choice3_refuse_ec867ba6:

    # voice "voice/Owl/4day/Kozan.ogg"
    # Owl "Кожаный мешок с требухой."
    voice "voice/Owl/4day/Kozan.ogg"
    Owl "Скураны мяшок з трыбухой."

# game/scripts/scene/scene_day_4.rpy:17104
translate belarusian d4_beasts_choice3_refuse_5bd4cea2:

    # voice "voice/Alisa/4day/102 Zat.ogg"
    # Alis "Заткнитесь, пустомели!"
    voice "voice/Alisa/4day/102 Zat.ogg"
    Alis "Заткніцеся, пустамелі!"

# game/scripts/scene/scene_day_4.rpy:17106
translate belarusian d4_beasts_choice3_refuse_df7ade10:

    # voice "voice/Alisa/4day/103 Razv.ogg"
    # Alis "Разве вы не чуете? Разве вы не помните?"
    voice "voice/Alisa/4day/103 Razv.ogg"
    Alis "Хіба вы не чуеце? Хіба вы не памятаеце?"

# game/scripts/scene/scene_day_4.rpy:17108
translate belarusian d4_beasts_choice3_refuse_34952e2a:

    # voice "voice/Alisa/4day/104 Kogda.ogg"
    # Alis "Когда он чуть не укусил луну на снежной поляне."
    voice "voice/Alisa/4day/104 Kogda.ogg"
    Alis "Калі ён ледзь не ўкусіў месяц на снежнай паляне."

# game/scripts/scene/scene_day_4.rpy:17110
translate belarusian d4_beasts_choice3_refuse_1cc67b9a:

    # "Людоеды замолкли, разочарованно сглатывая слюну."
    "Людаеды замоўклі, расчаравана праглынаючы сліну."

# game/scripts/scene/scene_day_4.rpy:17112
translate belarusian d4_beasts_choice3_refuse_f334c70a:

    # "Алиса тем временем крутанулась и..."
    "Аліса тым часам крутнулася і..."

# game/scripts/scene/scene_day_4.rpy:17150
translate belarusian d4_beasts_choice3_refuse_990b8d86:

    # "...вновь предстала милым ребёнком в маске лисицы, которую я впервые повстречал январским утром." id d4_beasts_choice3_refuse_990b8d86
    "...зноў паўстала мілым дзіцем у масцы лісіцы, якую я ўпершыню сустрэў студзеньскай раніцай."

# game/scripts/scene/scene_day_4.rpy:17160
translate belarusian d4_beasts_choice3_refuse_65663d5d:

    # "Она двинулась ко мне скользящей походкой, растворяя весь ужас вокруг запахом апельсинов, порохом петард и волшебством."
    "Яна рушыла да мяне слізгальнай хадой, раствараючы ўвесь жах навокал пахам апельсінаў, порахам петард і чараўніцтвам."

# game/scripts/scene/scene_day_4.rpy:17164
translate belarusian d4_beasts_choice3_refuse_e1922f08:

    # "Её ласковые лапки нежно коснулись моей щеки, убрали слипшуюся прядь с моего лица."
    "Яе ласкавыя лапкі пяшчотна дакрануліся да маёй шчакі, прыбралі зліплую пасму з майго твару."

# game/scripts/scene/scene_day_4.rpy:17174
translate belarusian d4_beasts_choice3_refuse_9d88dd15:

    # "И, заключив меня в объятия, Алиса сладко зашептала:"
    "І, узяўшы мяне ў абдымкі, Аліса салодка зашаптала:"

# game/scripts/scene/scene_day_4.rpy:17175
translate belarusian d4_beasts_choice3_refuse_8b3e23e4:

    # voice "voice/Alisa/4day/105 Tosha.ogg"
    # Alis "Тоша, ты хочешь спастись?"
    voice "voice/Alisa/4day/105 Tosha.ogg"
    Alis "Тоша, ты хочаш выратавацца?"

# game/scripts/scene/scene_day_4.rpy:17178
translate belarusian d4_beasts_choice3_refuse_3f7b8045:

    # "Я молчал, стиснув зубы, боясь отвести взгляд, чтобы не разрушить мимолётное видение."
    "Я маўчаў, сціснуўшы зубы, баючыся адвесці позірк, каб не разбурыць мімалётны відзеж."

# game/scripts/scene/scene_day_4.rpy:17179
translate belarusian d4_beasts_choice3_refuse_a86dcc2d:

    # voice "voice/Alisa/4day/106 Moi.ogg"
    # Alis "Мой милый, скажи, ты хочешь спасти свою сестру?"
    voice "voice/Alisa/4day/106 Moi.ogg"
    Alis "Мой мілы, скажы, ты хочаш выратаваць сваю сястру?"

# game/scripts/scene/scene_day_4.rpy:17220
translate belarusian d4_beasts_choice3_refuse_a061ae89:

    # "Слёзы брызнули из глаз, и я заревел."
    "Слёзы пырснулі з вачэй, і я зароў."

# game/scripts/scene/scene_day_4.rpy:17222
translate belarusian d4_beasts_choice3_refuse_13b314a7:

    # voice "voice/anton/4day/195. Da.ogg"
    # Ant "Д-да..."
    voice "voice/anton/4day/195. Da.ogg"
    Ant "Т-так..."

# game/scripts/scene/scene_day_4.rpy:17225
translate belarusian d4_beasts_choice3_refuse_abbbf4c8:

    # "Хватая лисичку за подол шубки, я продолжал всхлипывать и дрожать."
    "Хапаючы лісічку за падол шубкі, я працягваў усхліпваць і дрыжаць."

# game/scripts/scene/scene_day_4.rpy:17227
translate belarusian d4_beasts_choice3_refuse_f61a8d75:

    # voice "voice/Alisa/4day/107 Ska.ogg"
    # Alis "Скажи громче, чтобы все слышали."
    voice "voice/Alisa/4day/107 Ska.ogg"
    Alis "Скажы гучней, каб усе чулі."

# game/scripts/scene/scene_day_4.rpy:17237
translate belarusian d4_beasts_choice3_refuse_eafcb284:

    # "Не помня себя от горя, я закричал, умываясь слезами:"
    "Не помнячы сябе ад гора, я закрычаў, умываючыся слязамі:"

# game/scripts/scene/scene_day_4.rpy:17239
translate belarusian d4_beasts_choice3_refuse_cbe37d72:

    # voice "voice/anton/4day/196.Daa.ogg"
    # Ant "ДА!"
    voice "voice/anton/4day/196.Daa.ogg"
    Ant "ТАК!"

# game/scripts/scene/scene_day_4.rpy:17266
translate belarusian d4_beasts_choice3_refuse_f4ee5986:

    # "Тут же мой рот наполнил металлический привкус крови."
    "Адразу ж мой рот напоўніў металічны прысмак крыві."

# game/scripts/scene/scene_day_4.rpy:17288
translate belarusian d4_beasts_choice3_refuse_30472b40:

    # "Чёрные пальцы лисицы пропихивали кусок человечины глубже в мою глотку."
    "Чорныя пальцы лісіцы прапіхвалі кавалак чалавечыны глыбей у маю глотку."

# game/scripts/scene/scene_day_4.rpy:17308
translate belarusian d4_beasts_choice3_refuse_50d4e61a:

    # "Я упал на четвереньки, давясь и кашляя кровью, не в силах срыгнуть ставший в горле кусок плоти."
    "Я ўпаў на карачкі, давячыся і кашляючы крывёй, не ў сілах вырыгнуць кавалак плоці, што стаў у горле."

# game/scripts/scene/scene_day_4.rpy:17309
translate belarusian d4_beasts_choice3_refuse_cd201783:

    # "Меня вновь обступали со всех сторон разлагающиеся твари."
    "Мяне зноў абступалі з усіх бакоў пачвары, што раскладаліся."

# game/scripts/scene/scene_day_4.rpy:17329
translate belarusian d4_beasts_choice3_refuse_62ee8d41:

    # voice "voice/Owl/4day/Kakoe.ogg"
    # Owl "Какое посмешище."
    voice "voice/Owl/4day/Kakoe.ogg"
    Owl "Якое пасмешышча."

# game/scripts/scene/scene_day_4.rpy:17342
translate belarusian d4_beasts_choice3_refuse_abd8aa04:

    # voice "voice/Owl/4day/Pozvol.ogg"
    # Owl "Позволь, Хозяин, я откушу от девчонки самую малость."
    voice "voice/Owl/4day/Pozvol.ogg"
    Owl "Дазволь, Гаспадар, я адкушу ад дзяўчынкі самую крышачку."

# game/scripts/scene/scene_day_4.rpy:17369
translate belarusian d4_beasts_choice3_refuse_01244402:

    # "Бурлящая злоба утопила моё сознание, и что-то чужеродное и первобытное вырвалось из меня свирепым рыком:"
    "Кіпучая злосць утапіла маю свядомасць, і нешта чужароднае і першабытнае вырвалася з мяне лютым рыкам:"

# game/scripts/scene/scene_day_4.rpy:17377
translate belarusian d4_beasts_choice3_refuse_f1e82cec:

    # voice "voice/anton/4day/198. Tolko.ogg"
    # Bunny "Только попробуй — и я вырву твой поганый язык и засуну глубоко в клоаку, ты, безмозглая курица! "
    voice "voice/anton/4day/198. Tolko.ogg"
    Bunny "Толькі паспрабуй — і я вырву твой паганы язык і засуну глыбока ў клааку, ты, бязмозглая курыца! "

# game/scripts/scene/scene_day_4.rpy:17408
translate belarusian d4_beasts_choice3_refuse_25aae670:

    # "Зловещая сова ошеломлённо отпрыгнула под улюлюканье лисы."
    "Злавесная сава ашаломлена адскочыла пад улюлюканне лісы."

# game/scripts/scene/scene_day_4.rpy:17413
translate belarusian d4_beasts_choice3_refuse_c5a73fda:

    # "Мой голос смолк, а затем меня сложило пополам."
    "Мой голас змоўк, а потым мяне склала напалам."

# game/scripts/scene/scene_day_4.rpy:17421
translate belarusian d4_beasts_choice3_refuse_5bd19a19:

    # "Изо рта брызнула рвотная каша с непережёванным «угощением»."
    "З рота пырснула ванітная каша з неперажаваным «пачастункам»."

# game/scripts/scene/scene_day_4.rpy:17422
translate belarusian d4_beasts_choice3_refuse_cbe7e2da:

    # voice "voice/kozel/4day/122.Ti.ogg"
    # Master "Ты права. Зайчик..."
    voice "voice/kozel/4day/122.Ti.ogg"
    Master "Ты маеш рацыю. Зайчык..."

# game/scripts/scene/scene_day_4.rpy:17444
translate belarusian d4_beasts_choice3_refuse_2b091a86:

    # voice "voice/kozel/4day/124.Dih2.ogg"
    voice "voice/kozel/4day/124.Dih2.ogg"

# game/scripts/scene/scene_day_4.rpy:17449
translate belarusian d4_beasts_choice3_refuse_1ec87298:

    # "Палец ткнулся в меня. Казалось, что это нож вонзился в солнечное сплетение по самую рукоять."
    "Палец ткнуўся ў мяне. Здавалася, што гэта нож уваткнуўся ў сонечнае спляценне па самую рукаятку."

# game/scripts/scene/scene_day_4.rpy:17450
translate belarusian d4_beasts_choice3_refuse_c83db7cd:

    # voice "voice/kozel/4day/123.Tv.ogg"
    # Master "Твой черёд угощать нас."
    voice "voice/kozel/4day/123.Tv.ogg"
    Master "Твая чарга частаваць нас."

# game/scripts/scene/scene_day_4.rpy:17470
translate belarusian d4_beasts_choice3_refuse_4b63b882:

    # voice "voice/kozel/4day/Dob.ogg"
    # Master "Добудь к следующей ночи мяса, а иначе..."
    voice "voice/kozel/4day/Dob.ogg"
    Master "Здабудзь да наступнай ночы мяса, а інакш..."

# game/scripts/scene/scene_day_4.rpy:17502
translate belarusian d4_beasts_choice3_refuse_c0585745:

    # voice "voice/Wolf/342 Inche.ogg"
    # Wolf "Иначе..."
    voice "voice/Wolf/342 Inche.ogg"
    Wolf "Інакш..."

# game/scripts/scene/scene_day_4.rpy:17519
translate belarusian d4_beasts_choice3_refuse_eea69925:

    # voice "voice/Bear/4day/59 Enache.ogg"
    # Bear "Иначе..."
    voice "voice/Bear/4day/59 Enache.ogg"
    Bear "Інакш..."

# game/scripts/scene/scene_day_4.rpy:17555
translate belarusian d4_beasts_choice3_refuse_0e566ede:

    # "Алиса молча отступила в тень, а Козёл приблизил ко мне зловонную пасть и прорычал:"
    "Аліса моўчкі адступіла ў цень, а Казёл наблізіў да мяне смярдзючую пашчу і прагарчаў:"

# game/scripts/scene/scene_day_4.rpy:17588
translate belarusian d4_beasts_choice3_refuse_6985d7b0:

    # voice "voice/kozel/4day/125.ME.ogg"
    # Master "Иначе... мы съедим всю твою семью."
    voice "voice/kozel/4day/125.ME.ogg"
    Master "Інакш... мы з'ядзім усю тваю сям'ю."

# game/scripts/scene/scene_day_4.rpy:17597
translate belarusian d4_beasts_choice3_refuse_15b5cb8c:

    # "Он рубанул копытом в пол, и я побежал прочь, как ошпаренный, забыв про всё."
    "Ён рубануў капытом у падлогу, і я пабег прэч, як апараны, забыўшы пра ўсё."

# game/scripts/scene/scene_day_4.rpy:17620
translate belarusian d4_beasts_choice3_refuse_64493087:

    # "В спину неслось многоголосое: «Съедим! Сожрём! Живьём!»"
    "У спіну няслося шматгалосае: «З'ядзім! Зжаром! Жыўцом!»"

# game/scripts/scene/scene_day_4.rpy:17659
translate belarusian d4_beasts_choice3_refuse_9ec5d5cf:

    # "Лёд падал мне на плечи кусками, в них вмёрзли дохлые грызуны."
    "Лёд падаў мне на плечы кавалкамі, у іх умёрзлі дохлыя грызуны."

# game/scripts/scene/scene_day_4.rpy:17661
translate belarusian d4_beasts_choice3_refuse_ab816d48:

    # "Я вырвался на волю, туда, где сосны шевелили ветками и сыпали снегом, словно кашевары, сдабривающие солью яства."
    "Я вырваўся на волю, туды, дзе сосны варушылі галінкамі і сыпалі снегам, нібы кашавары, што прыпраўляюць соллю стравы."

# game/scripts/scene/scene_day_4.rpy:17662
translate belarusian d4_beasts_choice3_refuse_aff4a46b:

    # "Ветер драл мои волосы."
    "Вецер драў мае валасы."

# game/scripts/scene/scene_day_4.rpy:17664
translate belarusian d4_beasts_choice3_refuse_412dadaa:

    # "Я повернулся и похолодел."
    "Я павярнуўся і пахаладзеў."

# game/scripts/scene/scene_day_4.rpy:17731
translate belarusian d4_beasts_choice3_refuse_fcde6f34:

    # "На моих глазах Гараж исчезал, растворялся слоями, тускнел и становился прозрачным, а потом порыв ветра смёл фантом чёрных стен."
    "На маіх вачах Гараж знікаў, раствараўся пластамі, цьмянеў і станавіўся празрыстым, а потым парыў ветру змёў фантом чорных сцен."

# game/scripts/scene/scene_day_4.rpy:17733
translate belarusian d4_beasts_choice3_refuse_1ee64e2d:

    # "И только сейчас я понял, что давно выпустил руку сестры, и она осталась в логове чудищ."
    "І толькі цяпер я зразумеў, што даўно выпусціў руку сястры, і яна засталася ў логаве пачвар."

# game/scripts/scene/scene_day_4.rpy:17736
translate belarusian d4_beasts_choice3_refuse_aa93c097:

    # "На месте, где минуту назад стоял дворец, рос сугроб."
    "На месцы, дзе хвіліну таму стаяў палац, рос сумёт."

# game/scripts/scene/scene_day_4.rpy:17738
translate belarusian d4_beasts_choice3_refuse_ea144750:

    # "Из его верхушки торчала девчачья кисть, как крест из могильной насыпи."
    "З яго вяршыні тырчала дзяўчачая кісць, як крыж з магільнага насыпу."

# game/scripts/scene/scene_day_4.rpy:17739
translate belarusian d4_beasts_choice3_refuse_d9b08cc9:

    # "Вне себя от ужаса, я бросился к сугробу и принялся расчищать снег."
    "Не цямячы сябе ад жаху, я кінуўся да сумёта і ўзяўся расчышчаць снег."

# game/scripts/scene/scene_day_4.rpy:17774
translate belarusian d4_beasts_choice3_refuse_cb5bb596:

    # "Под белой массой оголялось плечо и бледное Олино личико."
    "Пад белай масай агаляліся плячо і бледны Олін тварык."

# game/scripts/scene/scene_day_4.rpy:17776
translate belarusian d4_beasts_choice3_refuse_8ea511d4:

    # "Её посиневшие губы дрогнули."
    "Яе пасінелыя вусны дрыгнулі."

# game/scripts/scene/scene_day_4.rpy:17777
translate belarusian d4_beasts_choice3_refuse_7e8f590e:

    # "Жива!"
    "Жывая!"

# game/scripts/scene/scene_day_4.rpy:17778
translate belarusian d4_beasts_choice3_refuse_1c884de6:

    # voice "voice/anton/4day/200. Ya.ogg"
    # Ant "Я сейчас!"
    voice "voice/anton/4day/200. Ya.ogg"
    Ant "Я зараз!"

# game/scripts/scene/scene_day_4.rpy:17782
translate belarusian d4_beasts_choice3_refuse_a88bafa3:

    # "При мысли, что то же самое я говорил Кате, у меня пересохло в горле."
    "Ад думкі, што тое ж самае я казаў Каці, у мяне перасохла ў горле."

# game/scripts/scene/scene_day_4.rpy:17789
translate belarusian d4_beasts_choice3_refuse_dcb95226:

    # "Я копал и умолял её держаться."
    "Я капаў і маліў яе трымацца."

# game/scripts/scene/scene_day_4.rpy:17790
translate belarusian d4_beasts_choice3_refuse_9d725fa4:

    # "Уже дошёл до живота."
    "Ужо дайшоў да жывата."

# game/scripts/scene/scene_day_4.rpy:17796
translate belarusian d4_beasts_choice3_refuse_7780ba78:

    # voice "voice/olya/4day/69Hol.ogg"
    # Oly "Холодно..."
    voice "voice/olya/4day/69Hol.ogg"
    Oly "Холадна..."

# game/scripts/scene/scene_day_4.rpy:17798
translate belarusian d4_beasts_choice3_refuse_b875e0ff:

    # "Голосок был слабым."
    "Галасок быў слабым."

# game/scripts/scene/scene_day_4.rpy:17799
translate belarusian d4_beasts_choice3_refuse_9bb50de1:

    # voice "voice/anton/4day/201. Niche.ogg"
    # Ant "Ничего."
    voice "voice/anton/4day/201. Niche.ogg"
    Ant "Нічога."

# game/scripts/scene/scene_day_4.rpy:17801
translate belarusian d4_beasts_choice3_refuse_6e666fe7:

    # voice "voice/anton/4day/201. Otn.ogg"
    # Ant "Отнесу тебя домой, согрею, шоколадом напою, — ты только не засыпай, слышишь?"
    voice "voice/anton/4day/201. Otn.ogg"
    Ant "Аднясу цябе дадому, сагрэю, шакаладам напаю, — ты толькі не засынай, чуеш?"

# game/scripts/scene/scene_day_4.rpy:17803
translate belarusian d4_beasts_choice3_refuse_18e3b99a:

    # voice "voice/anton/4day/202. Tito.ogg"
    # Ant "Ты только..."
    voice "voice/anton/4day/202. Tito.ogg"
    Ant "Ты толькі..."

# game/scripts/scene/scene_day_4.rpy:17808
translate belarusian d4_beasts_choice3_refuse_48b6b4e6:

    # "Мои пальцы напоролись на что-то липкое и горячее."
    "Мае пальцы напароліся на нешта ліпкае і гарачае."

# game/scripts/scene/scene_day_4.rpy:17809
translate belarusian d4_beasts_choice3_refuse_6430601d:

    # "Я разгрёб снег – он сделался красным и рыхлым."
    "Я разгроб снег — ён зрабіўся чырвоным і рыхлым."

# game/scripts/scene/scene_day_4.rpy:17816
translate belarusian d4_beasts_choice3_refuse_47984faa:

    # voice "voice/olya/4day/50 Cho.ogg"
    # Oly "Что это? Что это там?"
    voice "voice/olya/4day/50 Cho.ogg"
    Oly "Што гэта? Што гэта там?"

# game/scripts/scene/scene_day_4.rpy:17821
translate belarusian d4_beasts_choice3_refuse_71e470a7:

    # "Я сглотнул."
    "Я глытнуў."

# game/scripts/scene/scene_day_4.rpy:17822
translate belarusian d4_beasts_choice3_refuse_7b2f9d83:

    # voice "voice/olya/4day/51Poch.ogg"
    # Oly "Почему ты не отвечаешь?"
    voice "voice/olya/4day/51Poch.ogg"
    Oly "Чаму ты не адказваеш?"

# game/scripts/scene/scene_day_4.rpy:17830
translate belarusian d4_beasts_choice3_refuse_4d57b057:

    # "А что я мог ответить?"
    "А што я мог адказаць?"

# game/scripts/scene/scene_day_4.rpy:17845
translate belarusian d4_beasts_choice3_refuse_11b3ed5d:

    # "Ниже пояса тело Оли обрывалось. Из туловища вывалились кольца кишечника."
    "Ніжэй пояса цела Олі абрывалася. З тулава вываліліся кольцы кішэчніка."

# game/scripts/scene/scene_day_4.rpy:17867
translate belarusian d4_beasts_choice3_refuse_fa17375e:

    # "Оля склонила голову и уставилась на безобразные обрубки."
    "Оля схіліла галаву і ўтаропілася на пачварныя абрубкі."

# game/scripts/scene/scene_day_4.rpy:17897
translate belarusian d4_beasts_choice3_refuse_078c17ed:

    # "Она истошно завопила."
    "Яна несамавіта залямантавала."

# game/scripts/scene/scene_day_4.rpy:17969
translate belarusian d4_beasts_choice_take_devend_66d4ecfe:

    # "Я вынул из груды сладостей на полу самую аппетитную конфету."
    "Я выняў з груды прысмакаў на падлозе самую апетытную цукерку."

# game/scripts/scene/scene_day_4.rpy:17982
translate belarusian d4_beasts_choice_take_devend_53bc90e1:

    # Narr_color "Надкусил — молочный шоколад таял во рту."
    Narr_color "Надкусіў — малочны шакалад раставаў у роце."

# game/scripts/scene/scene_day_4.rpy:18003
translate belarusian d4_beasts_choice_take_devend_08ff04bf:

    # voice "voice/kozel/4day/127.S.ogg"
    # Frost_Color "С выбором вас поздравляю, веселитесь в этот час!"
    voice "voice/kozel/4day/127.S.ogg"
    Frost_Color "З выбарам я вас віншую, весяліцеся ў гэты час!"

# game/scripts/scene/scene_day_4.rpy:18015
translate belarusian d4_beasts_choice_take_devend_98e8b7e3:

    # voice "voice/kozel/4day/127Ya.ogg"
    # Frost_Color "Я желанья исполняю сокровенные для вас!"
    voice "voice/kozel/4day/127Ya.ogg"
    Frost_Color "Запаветныя жаданні — я здзяйсняю іх для вас!"

# game/scripts/scene/scene_day_4.rpy:18040
translate belarusian d4_beasts_choice_take_devend_27f9b16d:

    # voice "voice/olya/4day/53 A.ogg"
    # Olya_Color "Антон, смотри!"
    voice "voice/olya/4day/53 A.ogg"
    Olya_Color "Антон, глядзі!"

# game/scripts/scene/scene_day_4.rpy:18044
translate belarusian d4_beasts_choice_take_devend_54f9f06d:

    # Narr_color "Личико сестры было перемазано шоколадом, и я уже собирался сделать ей замечание."
    Narr_color "Тварык сястры быў перапэцканы шакаладам, і я ўжо збіраўся зрабіць ёй заўвагу."

# game/scripts/scene/scene_day_4.rpy:18050
translate belarusian d4_beasts_choice_take_devend_55c6ea22:

    # Narr_color "Но слова застряли в горле."
    Narr_color "Але словы захраслі ў горле."

# game/scripts/scene/scene_day_4.rpy:18076
translate belarusian d4_beasts_choice_take_devend_0103e7e7:

    # Narr_color "Гигантская ель устремлялась к звёздам и исчезала где-то в космосе – её венчала круглая Луна."
    Narr_color "Гіганцкая яліна імкнулася да зорак і знікала дзесьці ў космасе — яе вянчаў круглы Месяц."

# game/scripts/scene/scene_day_4.rpy:18077
translate belarusian d4_beasts_choice_take_devend_6ada7549:

    # Narr_color "Огромные шары сияли на ветвях, гирлянды переливались всеми цветами радуги."
    Narr_color "Велізарныя шары ззялі на галінах, гірлянды пераліваліся ўсімі колерамі вясёлкі."

# game/scripts/scene/scene_day_4.rpy:18084
translate belarusian d4_beasts_choice_take_devend_22f3c2c1:

    # Narr_color "Крыша исчезла, и над нами раскинулись мириады созвездий."
    Narr_color "Дах знік, і над намі раскінуліся мірыяды сузор'яў."

# game/scripts/scene/scene_day_4.rpy:18106
translate belarusian d4_beasts_choice_take_devend_a8a2c098:

    # Narr_color "Музыка, смех, аромат хвои и сладостей!"
    Narr_color "Музыка, смех, водар ігліцы і прысмакаў!"

# game/scripts/scene/scene_day_4.rpy:18109
translate belarusian d4_beasts_choice_take_devend_06bfd58f:

    # Narr_color "А рядом плясали Медвежутка, Волчик и Совушка!"
    Narr_color "А побач вытанцоўвалі Мядзведжутка, Воўчык і Савушка!"

# game/scripts/scene/scene_day_4.rpy:18111
translate belarusian d4_beasts_choice_take_devend_ee73c3fd:

    # Narr_color "И снежинки падали задом наперёд!"
    Narr_color "І сняжынкі падалі задам наперад!"

# game/scripts/scene/scene_day_4.rpy:18115
translate belarusian d4_beasts_choice_take_devend_16ce1472:

    # Narr_color "Я засмеялся. Потрогал пышную позолоченную мишуру."
    Narr_color "Я засмяяўся. Памацаў пышную пазалочаную мішуру."

# game/scripts/scene/scene_day_4.rpy:18116
translate belarusian d4_beasts_choice_take_devend_2d285326:

    # Narr_color "Всё по-настоящему!"
    Narr_color "Усё па-сапраўднаму!"

# game/scripts/scene/scene_day_4.rpy:18144
translate belarusian d4_beasts_choice_take_devend_47891a70:

    # voice "voice/olya/4day/54 E.ogg"
    # Olya_Color "Это что, это она?"
    voice "voice/olya/4day/54 E.ogg"
    Olya_Color "Гэта што, гэта яна?"

# game/scripts/scene/scene_day_4.rpy:18154
translate belarusian d4_beasts_choice_take_devend_dde37a40:

    # voice "voice/Alisa/4day/109 Vi.ogg"
    # Alis_Color "Вы тут не про Небыляндию, случайно, говорите?"
    voice "voice/Alisa/4day/109 Vi.ogg"
    Alis_Color "Вы тут не пра Небыляндыю, выпадкова, гаворыце?"

# game/scripts/scene/scene_day_4.rpy:18158
translate belarusian d4_beasts_choice_take_devend_c18eab2a:

    # voice "voice/olya/4day/55 Et.ogg"
    # Olya_Color "Это и есть Небыляндия?"
    voice "voice/olya/4day/55 Et.ogg"
    Olya_Color "Гэта і ёсць Небыляндыя?"

# game/scripts/scene/scene_day_4.rpy:18168
translate belarusian d4_beasts_choice_take_devend_19456adc:

    # Narr_color "Алиса манерно поклонилась."
    Narr_color "Аліса манерна пакланілася."

# game/scripts/scene/scene_day_4.rpy:18182
translate belarusian d4_beasts_choice_take_devend_5d59eb1f:

    # Narr_color "Шары переливались и мерцали, и моя душа мерцала им в унисон."
    Narr_color "Шары пераліваліся і мігцелі, і мая душа мігцела ім ва ўнісон."

# game/scripts/scene/scene_day_4.rpy:18183
translate belarusian d4_beasts_choice_take_devend_4a06f805:

    # Narr_color "Я становился зимним волшебным лесом, мягкой ласковой хвоей, всеми созвездиями сразу."
    Narr_color "Я станавіўся зімовым чароўным лесам, мяккай ласкавай ігліцай, усімі сузор'ямі адразу."

# game/scripts/scene/scene_day_4.rpy:18228
translate belarusian d4_beasts_choice_take_devend_357bf83f:

    # voice "voice/Alisa/4day/110 Dobro.ogg"
    # Alis_Color "Добро пожаловать домой!"
    voice "voice/Alisa/4day/110 Dobro.ogg"
    Alis_Color "Сардэчна запрашаем дадому!"

# game/scripts/scene/scene_day_4.rpy:18230
translate belarusian d4_beasts_choice_take_devend_10e8c83f:

    # Narr_color "Вот где всегда был мой дом."
    Narr_color "Вось дзе заўсёды быў мой дом."

# game/scripts/scene/scene_day_4.rpy:18231
translate belarusian d4_beasts_choice_take_devend_8f2e04c3:

    # Narr_color "Снег искрился и слепил."
    Narr_color "Снег іскрыўся і сляпіў."

# game/scripts/scene/scene_day_4.rpy:18250
translate belarusian d4_beasts_choice_take_devend_8bd57f33:

    # Narr_color "Оля закружилась в танце. Схватила по конфете в каждую руку."
    Narr_color "Оля закружылася ў танцы. Схапіла па цукерцы ў кожную руку."

# game/scripts/scene/scene_day_4.rpy:18272
translate belarusian d4_beasts_choice_take_devend_c550b507:

    # Narr_color "Волчонок жонглировал «Киндер-сюрпризами»."
    Narr_color "Ваўчаня жангліравала «Кіндэр-сюрпрызамі»."

# game/scripts/scene/scene_day_4.rpy:18279
translate belarusian d4_beasts_choice_take_devend_fe2b7f12:

    # voice "voice/olya/4day/56 T.ogg"
    # Olya_Color "Ты видел?"
    voice "voice/olya/4day/56 T.ogg"
    Olya_Color "Ты бачыў?"

# game/scripts/scene/scene_day_4.rpy:18286
translate belarusian d4_beasts_choice_take_devend_d6ff85ac:

    # Narr_color "Приставки, «Тетрисы», куклы и трансформеры лежали под елью, словно их грузовиками свозили сюда."
    Narr_color "Прыстаўкі, «Тэтрысы», лялькі і трансформеры ляжалі пад ялінай, нібы іх грузавікамі звозілі сюды."

# game/scripts/scene/scene_day_4.rpy:18287
translate belarusian d4_beasts_choice_take_devend_00147dd7:

    # voice "voice/olya/4day/57 Et.ogg"
    # Olya_Color "О! Это всё наше?"
    voice "voice/olya/4day/57 Et.ogg"
    Olya_Color "О! Гэта ўсё наша?"

# game/scripts/scene/scene_day_4.rpy:18311
translate belarusian d4_beasts_choice_take_devend_1b531a90:

    # Narr_color "Я понял, что тоже танцую, и ответил, не прерывая движений:"
    Narr_color "Я зразумеў, што таксама танцую, і адказаў, не перарываючы рухаў:"

# game/scripts/scene/scene_day_4.rpy:18312
translate belarusian d4_beasts_choice_take_devend_73cbd79c:

    # voice "voice/anton/4day/204.Mn.ogg"
    # Ant_Color "Многовато для нас одних. Я бы поделился с кем-нибудь. А ты?"
    voice "voice/anton/4day/204.Mn.ogg"
    Ant_Color "Шматавата для нас адных. Я б падзяліўся з кім-небудзь. А ты?"

# game/scripts/scene/scene_day_4.rpy:18314
translate belarusian d4_beasts_choice_take_devend_4774a691:

    # voice "voice/olya/4day/58 Nu.ogg"
    # Olya_Color "Хм... Ну-у-у, если с кем-то хорошим."
    voice "voice/olya/4day/58 Nu.ogg"
    Olya_Color "Хм... Ну-у-у, калі з кімсьці добрым."

# game/scripts/scene/scene_day_4.rpy:18316
translate belarusian d4_beasts_choice_take_devend_293eefa7:

    # Narr_color "Какие-то дети стояли у кромки опушки, зачарованно глазея на праздник."
    Narr_color "Нейкія дзеці стаялі каля краю ўзлеску, зачаравана пазіраючы на свята."

# game/scripts/scene/scene_day_4.rpy:18322
translate belarusian d4_beasts_choice_take_devend_43afc1b0:

    # voice "voice/anton/4day/204. Ei.ogg"
    # Ant_Color "Эй!"
    voice "voice/anton/4day/204. Ei.ogg"
    Ant_Color "Гэй!"

# game/scripts/scene/scene_day_4.rpy:18338
translate belarusian d4_beasts_choice_take_devend_74749d13:

    # Narr_color "Я прыгнул через всю поляну и плавно приземлился возле них."
    Narr_color "Я скокнуў праз усю паляну і плаўна прызямліўся каля іх."

# game/scripts/scene/scene_day_4.rpy:18339
translate belarusian d4_beasts_choice_take_devend_6b167378:

    # voice "voice/anton/4day/205. Ho.ogg"
    # Ant_Color "Хотите с нами?"
    voice "voice/anton/4day/205. Ho.ogg"
    Ant_Color "Хочаце з намі?"

# game/scripts/scene/scene_day_4.rpy:18349
translate belarusian d4_beasts_choice_take_devend_02fb7e8c:

    # voice "voice/Child/4day/Amozno.ogg"
    # Children_Color "А можно?"
    voice "voice/Child/4day/Amozno.ogg"
    Children_Color "А можна?"

# game/scripts/scene/scene_day_4.rpy:18351
translate belarusian d4_beasts_choice_take_devend_ff9769b5:

    # voice "voice/anton/4day/206. Spr.ogg"
    # Ant_Color "Спрашиваете!"
    voice "voice/anton/4day/206. Spr.ogg"
    Ant_Color "Пытаецеся!"

# game/scripts/scene/scene_day_4.rpy:18357
translate belarusian d4_beasts_choice_take_devend_61db897b:

    # Narr_color "Дети взялись за руки. Я повёл их цепочку к подаркам."
    Narr_color "Дзеці ўзяліся за рукі. Я павёў іх ланцужок да падарункаў."

# game/scripts/scene/scene_day_4.rpy:18366
translate belarusian d4_beasts_choice_take_devend_40131396:

    # Narr_color "Не было ничего лучше, чем вести кого-то по тропинке к мечте."
    Narr_color "Не было нічога лепшага, чым весці кагосьці па сцяжынцы да мары."

# game/scripts/scene/scene_day_4.rpy:18382
translate belarusian d4_beasts_choice_take_devend_49461f10:

    # Narr_color "Праздник наступил по-настоящему."
    Narr_color "Свята настала па-сапраўднаму."

# game/scripts/scene/scene_day_4.rpy:18395
translate belarusian d4_beasts_choice_take_devend_3aeb1411:

    # Narr_color "В каждом празднике, как в красивом яблоке, была червоточинка – его скоротечность."
    Narr_color "У кожным свяце, як у прыгожым яблыку, была чарвяточынка — яго хуткаплыннасць."

# game/scripts/scene/scene_day_4.rpy:18403
translate belarusian d4_beasts_choice_take_devend_7f47709e:

    # Narr_color "Но здесь, под лапами величественной ели, праздник не кончался."
    Narr_color "Але тут, пад лапамі велічнай яліны, свята не канчалася."

# game/scripts/scene/scene_day_4.rpy:18404
translate belarusian d4_beasts_choice_take_devend_d16cb81c:

    # voice "voice/Alisa/4day/111 TiS.ogg"
    # Alis_Color "Ты счастлив, Тоша?"
    voice "voice/Alisa/4day/111 TiS.ogg"
    Alis_Color "Ты шчаслівы, Тоша?"

# game/scripts/scene/scene_day_4.rpy:18406
translate belarusian d4_beasts_choice_take_devend_188c437e:

    # voice "voice/anton/4day/207. Ya.ogg"
    # Ant_Color "Я счастлив!"
    voice "voice/anton/4day/207. Ya.ogg"
    Ant_Color "Я шчаслівы!"

# game/scripts/scene/scene_day_4.rpy:18504
translate belarusian d4_beasts_choice_take_devend_8c6d6639:

    # Narr_color "В небе взрывались грандиозные фейерверки, озаряя танцующих."
    Narr_color "У небе выбухалі грандыёзныя феерверкі, азараючы тых, хто танцаваў."

# game/scripts/scene/scene_day_4.rpy:18505
translate belarusian d4_beasts_choice_take_devend_aacfb3c7:

    # Narr_color "Глаза увлажнились. Напружинились мышцы."
    Narr_color "Вочы ўвільгатнелі. Напружыліся мышцы."

# game/scripts/scene/scene_day_4.rpy:18534
translate belarusian d4_beasts_choice_take_devend_129c97d0:

    # Narr_color "Я запрокинул голову к луне и закричал от переполняющих меня эмоций."
    Narr_color "Я закінуў галаву да месяца і закрычаў ад эмоцый, што перапаўнялі мяне."

# game/scripts/scene/scene_day_4.rpy:18535
translate belarusian d4_beasts_choice_take_devend_c29124a4:

    # voice "voice/Alisa/4day/112 TiScha.ogg"
    # Alis_Color "Ты счастлив, Зайчик?"
    voice "voice/Alisa/4day/112 TiScha.ogg"
    Alis_Color "Ты шчаслівы, Зайчык?"

# game/scripts/scene/scene_day_4.rpy:18555
translate belarusian d4_beasts_choice_take_devend_483db378:

    # Narr_color "Я прыгнул до звёзд и кувыркнулся."
    Narr_color "Я скокнуў да зорак і кульнуўся."

# game/scripts/scene/scene_day_4.rpy:18580
translate belarusian d4_beasts_choice_take_devend_a712df1a:

    # Narr_color "Мой крик слышала вся Небыляндия:"
    Narr_color "Мой крык чула ўся Небыляндыя:"

# game/scripts/scene/scene_day_4.rpy:18593
translate belarusian d4_beasts_choice_take_devend_86b66b5c:

    # voice "voice/anton/4day/210. Sha.ogg"
    # Ant_Color "Счастлив!"
    voice "voice/anton/4day/210. Sha.ogg"
    Ant_Color "Шчаслівы!"

# game/scripts/scene/scene_day_4.rpy:18667
translate belarusian d4_beasts_choice_take_devend_01df1769:

    # "Я проснулся с улыбкой впервые за долгие дни, проведённые в новом доме."
    "Я прачнуўся з усмешкай упершыню за доўгія дні, праведзеныя ў новым доме."

# game/scripts/scene/scene_day_4.rpy:18668
translate belarusian d4_beasts_choice_take_devend_9dd2b6f0:

    # "В этот раз счастье не отпускало. И, наслаждаясь им всем телом, я сладостно потянулся."
    "Гэтым разам шчасце не адпускала. І, упіваючыся ім усім целам, я салодка пацягнуўся."

# game/scripts/scene/scene_day_4.rpy:18669
translate belarusian d4_beasts_choice_take_devend_4b60ada1:

    # "За окном, радуясь яркому январскому солнцу, весело пели красногрудые красавцы-снегири."
    "За акном, радуючыся яркаму студзеньскаму сонцу, весела спявалі чырвонагрудыя прыгажуны-снегіры."

# game/scripts/scene/scene_day_4.rpy:18670
translate belarusian d4_beasts_choice_take_devend_32d67ece:

    # "Их чириканье дарило мне надежду, что однажды лысый лес за окном вновь обратится в райскую кущу, на радость родителям и сестрёнке."
    "Іх чырыканне дарыла мне надзею, што аднойчы лысы лес за акном зноў ператворыцца ў райскую кушчу, на радасць бацькам і сястрычцы."

# game/scripts/scene/scene_day_4.rpy:18674
translate belarusian d4_beasts_choice_take_devend_75ae0c94:

    # voice "voice/olya/4day/Hahaha.ogg"
    # "Детский топот ног и собачий лай наполнили коридор."
    voice "voice/olya/4day/Hahaha.ogg"
    "Дзіцячы тупат ног і сабачы брэх напоўнілі калідор."

# game/scripts/scene/scene_day_4.rpy:18688
translate belarusian d4_beasts_choice_take_devend_fce1ee67:

    # "Дверь в мою спальню широко распахнулась, обдав меня тёплым ветерком и ароматом свежезаваренного кофе."
    "Дзверы ў маю спальню шырока расчыніліся, абдаўшы мяне цёплым ветрыкам і водарам свежазаваранай кавы."

# game/scripts/scene/scene_day_4.rpy:18702
translate belarusian d4_beasts_choice_take_devend_68fe269f:

    # "На пороге стояла светящаяся от счастья Оля, а в её руках непрерывно ёрзала, виляя хвостом, умилительная Жулька."
    "На парозе стаяла Оля, якая свяцілася ад шчасця, а ў яе руках бесперапынна круцілася, віляючы хвастом, замілавальная Жулька."

# game/scripts/scene/scene_day_4.rpy:18705
translate belarusian d4_beasts_choice_take_devend_c39db5d0:

    # voice "voice/olya/4day/60 To.ogg"
    # Oly "Тоша, гляди, гляди! Папа разрешил ей остаться!"
    voice "voice/olya/4day/60 To.ogg"
    Oly "Тоша, глядзі, глядзі! Тата дазволіў ёй застацца!"

# game/scripts/scene/scene_day_4.rpy:18708
translate belarusian d4_beasts_choice_take_devend_b6cb706d:

    # "На глазах сестры выступили слёзы радости."
    "На вачах сястры выступілі слёзы радасці."

# game/scripts/scene/scene_day_4.rpy:18716
translate belarusian d4_beasts_choice_take_devend_34a728f5:

    # voice "voice/olya/4day/61Um.ogg"
    # Oly "У меня теперь есть собака!"
    voice "voice/olya/4day/61Um.ogg"
    Oly "У мяне цяпер ёсць сабака!"

# game/scripts/scene/scene_day_4.rpy:18722
translate belarusian d4_beasts_choice_take_devend_e22b065f:

    # "От столь потрясающей новости я даже подскочил с кровати."
    "Ад такой ашаламляльнай навіны я нават падскочыў з ложка."

# game/scripts/scene/scene_day_4.rpy:18726
translate belarusian d4_beasts_choice_take_devend_fe749e65:

    # voice "voice/anton/4day/211. Da.ogg"
    # Ant "Да ведь это же Жулька!"
    voice "voice/anton/4day/211. Da.ogg"
    Ant "Дык гэта ж Жулька!"

# game/scripts/scene/scene_day_4.rpy:18730
translate belarusian d4_beasts_choice_take_devend_ea636bf4:

    # voice "voice/olya/4day/62 S.ogg"
    # Oly "Сам ты Жулька! Её зовут Принцесса."
    voice "voice/olya/4day/62 S.ogg"
    Oly "Сам ты Жулька! Яе завуць Прынцэса."

# game/scripts/scene/scene_day_4.rpy:18734
translate belarusian d4_beasts_choice_take_devend_2d996e58:

    # voice "voice/olya/4day/63 Da.ogg"
    # Oly "Да, Ваше высочество?"
    voice "voice/olya/4day/63 Da.ogg"
    Oly "Так, Ваша высокасць?"

# game/scripts/scene/scene_day_4.rpy:18743
translate belarusian d4_beasts_choice_take_devend_8eeadfd5:

    # "Собака одобрительно тявкнула."
    "Сабака ўхвальна цяўкнуў."

# game/scripts/scene/scene_day_4.rpy:18758
translate belarusian d4_beasts_choice_take_devend_35def0c0:

    # voice "voice/father/day4/81Tuk.ogg"
    # Pap "Тук-тук! Можно к вам?"
    voice "voice/father/day4/81Tuk.ogg"
    Pap "Тук-тук! Можна да вас?"

# game/scripts/scene/scene_day_4.rpy:18774
translate belarusian d4_beasts_choice_take_devend_268ab008:

    # "К моей полной неожиданности, улыбающийся папа переступил порог и, что более удивительно, в обнимку с мамой."
    "Зусім нечакана для мяне тата, усміхаючыся, пераступіў парог і, што яшчэ больш дзіўна, у абдымку з мамай."

# game/scripts/scene/scene_day_4.rpy:18775
translate belarusian d4_beasts_choice_take_devend_51d18933:

    # voice "voice/father/day4/82 Kak.ogg"
    # Pap "Как тебе пополнение?"
    voice "voice/father/day4/82 Kak.ogg"
    Pap "Як табе папаўненне?"

# game/scripts/scene/scene_day_4.rpy:18777
translate belarusian d4_beasts_choice_take_devend_f6b2183e:

    # voice "voice/father/day4/83 Mn.ogg"
    # Pap "Мне эта дурёха под колёса бросилась, еле вырулил."
    voice "voice/father/day4/83 Mn.ogg"
    Pap "Мне гэтая дурнічка пад колы кінулася, ледзь выруліў."

# game/scripts/scene/scene_day_4.rpy:18779
translate belarusian d4_beasts_choice_take_devend_0b7103eb:

    # voice "voice/father/day4/84M.ogg"
    # Pap "Машину поцарапал. Думал, голыми руками удавлю."
    voice "voice/father/day4/84M.ogg"
    Pap "Машыну падрапаў. Думаў, голымі рукамі задушу."

# game/scripts/scene/scene_day_4.rpy:18781
translate belarusian d4_beasts_choice_take_devend_323adb41:

    # voice "voice/father/day4/84 A.ogg"
    # Pap "А заглянул ей в глаза... Они такие... Как бы сказать..."
    voice "voice/father/day4/84 A.ogg"
    Pap "А зазірнуў ёй у вочы... Яны такія... Як бы сказаць..."

# game/scripts/scene/scene_day_4.rpy:18783
translate belarusian d4_beasts_choice_take_devend_abab32c6:

    # voice "voice/karina/4day/131 Um.ogg"
    # Mam "...умные." id d4_beasts_choice_take_devend_abab32c6
    voice "voice/karina/4day/131 Um.ogg"
    Mam "...разумныя."

# game/scripts/scene/scene_day_4.rpy:18785
translate belarusian d4_beasts_choice_take_devend_62b284ed:

    # voice "voice/father/day4/85 Vo.ogg"
    # Pap "Во! А сама дрожит вся."
    voice "voice/father/day4/85 Vo.ogg"
    Pap "Во! А сама дрыжыць уся."

# game/scripts/scene/scene_day_4.rpy:18789
translate belarusian d4_beasts_choice_take_devend_777f481e:

    # voice "voice/father/day4/85 Nu.ogg" 
    # Pap "Ну, говорю, ладно: доедешь со мной до дома и сиденье не обгадишь — тогда оставайся."
    voice "voice/father/day4/85 Nu.ogg" 
    Pap "Ну, кажу, добра: даедзеш са мной да дома і сядзенне не абгадзіш — тады заставайся."

# game/scripts/scene/scene_day_4.rpy:18793
translate belarusian d4_beasts_choice_take_devend_c3d03b4b:

    # voice "voice/olya/4day/64 Pr.ogg"
    # Oly "Принцессы не гадют!"
    voice "voice/olya/4day/64 Pr.ogg"
    Oly "Прынцэсы не гадзюць!"

# game/scripts/scene/scene_day_4.rpy:18824
translate belarusian d4_beasts_choice_take_devend_712c5bf8:

    # "Мы дружно засмеялись, точно как раньше, когда любая незначительная мелочь могла рассмешить в два счёта."
    "Мы дружна засмяяліся, зусім як раней, калі любая нязначная дробязь магла рассмяшыць на раз-два."

# game/scripts/scene/scene_day_4.rpy:18835
translate belarusian d4_beasts_choice_take_devend_0e22e1cd:

    # voice "voice/karina/4day/133 Che.ogg"
    # Mam "Чего замолчал? Давай, продолжай."
    voice "voice/karina/4day/133 Che.ogg"
    Mam "Чаго замаўчаў? Давай, працягвай."

# game/scripts/scene/scene_day_4.rpy:18838
translate belarusian d4_beasts_choice_take_devend_7f69b738:

    # "Мама хитро посмотрела на папу. Тот, покраснев, отвёл взгляд. Словно дети, ей-богу."
    "Мама хітра паглядзела на тату. Той, пачырванеўшы, адвёў позірк. Нібы дзеці, далібог."

# game/scripts/scene/scene_day_4.rpy:18839
translate belarusian d4_beasts_choice_take_devend_c8e40f10:

    # voice "voice/father/day4/87 A.ogg"
    # Pap "А ещё из хороших новостей: ваш папа получил повышение."
    voice "voice/father/day4/87 A.ogg"
    Pap "А яшчэ з добрых навін: ваш тата атрымаў павышэнне."

# game/scripts/scene/scene_day_4.rpy:18842
translate belarusian d4_beasts_choice_take_devend_76b2ded0:

    # voice "voice/father/day4/88 Gre.ogg"
    # Pap "Грешно, конечно, радоваться, ведь старший бухгалтер пропал всё-таки."
    voice "voice/father/day4/88 Gre.ogg"
    Pap "Грэшна, вядома, радавацца, бо старшы бухгалтар знік усё ж такі."

# game/scripts/scene/scene_day_4.rpy:18845
translate belarusian d4_beasts_choice_take_devend_8219fb01:

    # voice "voice/father/day4/88 No.ogg"
    # Pap "Но, как говорится, нет худа без добра."
    voice "voice/father/day4/88 No.ogg"
    Pap "Але, як кажуць, няма ліха без дабра."

# game/scripts/scene/scene_day_4.rpy:18847
translate belarusian d4_beasts_choice_take_devend_18b403dc:

    # voice "voice/anton/4day/213. Eto.ogg"
    # Ant "Это значит, тебя чаще не будет дома?"
    voice "voice/anton/4day/213. Eto.ogg"
    Ant "Гэта значыць, цябе часцей не будзе дома?"

# game/scripts/scene/scene_day_4.rpy:18850
translate belarusian d4_beasts_choice_take_devend_bfdf91f7:

    # voice "voice/karina/4day/134 Eto.ogg"
    # Mam "Это значит двойную надбавку плюс премии."
    voice "voice/karina/4day/134 Eto.ogg"
    Mam "Гэта значыць падвойную надбаўку плюс прэміі."

# game/scripts/scene/scene_day_4.rpy:18852
translate belarusian d4_beasts_choice_take_devend_02848bab:

    # voice "voice/father/day4/89 Pra.ogg"
    # Pap "Правильно, Карина!"
    voice "voice/father/day4/89 Pra.ogg"
    Pap "Правільна, Карына!"

# game/scripts/scene/scene_day_4.rpy:18854
translate belarusian d4_beasts_choice_take_devend_aa2d6521:

    # voice "voice/father/day4/89 Ta.ogg"
    # Pap "Так что готовьтесь: на следующей неделе нас всех ждёт семейное путешествие."
    voice "voice/father/day4/89 Ta.ogg"
    Pap "Так што рыхтуйцеся: на наступным тыдні нас усіх чакае сямейнае падарожжа."

# game/scripts/scene/scene_day_4.rpy:18856
translate belarusian d4_beasts_choice_take_devend_aba3e762:

    # "От этих слов моё сердце забилось сильнее."
    "Ад гэтых слоў маё сэрца забілася мацней."

# game/scripts/scene/scene_day_4.rpy:18857
translate belarusian d4_beasts_choice_take_devend_29600eb8:

    # voice "voice/anton/4day/214. Kuda.ogg"
    # Ant "К-куда?"
    voice "voice/anton/4day/214. Kuda.ogg"
    Ant "К-куды?"

# game/scripts/scene/scene_day_4.rpy:18865
translate belarusian d4_beasts_choice_take_devend_e117af81:

    # "Оля даже выпустила дворняжку из крепких объятий."
    "Оля нават выпусціла дварняжку з моцных абдымкаў."

# game/scripts/scene/scene_day_4.rpy:18870
translate belarusian d4_beasts_choice_take_devend_bc12e151:

    # voice "voice/olya/4day/66 Neu.ogg"
    # Oly "Ах! Неужели в «Макдоналдс»?"
    voice "voice/olya/4day/66 Neu.ogg"
    Oly "Ах! Няўжо ў «Макдональдс»?"

# game/scripts/scene/scene_day_4.rpy:18874
translate belarusian d4_beasts_choice_take_devend_53edb999:

    # voice "voice/father/day4/90 S.ogg"
    # Pap "Скажешь тоже, Оль."
    voice "voice/father/day4/90 S.ogg"
    Pap "Скажаш жа, Оль."

# game/scripts/scene/scene_day_4.rpy:18878
translate belarusian d4_beasts_choice_take_devend_99fc744a:

    # voice "voice/father/day4/90 Mi.ogg"
    # Pap "Бери выше! Мы давно уже планировали эту поездку, да всё не получалось."
    voice "voice/father/day4/90 Mi.ogg"
    Pap "Бяры вышэй! Мы даўно ўжо планавалі гэтую паездку, ды ўсё не атрымлівалася."

# game/scripts/scene/scene_day_4.rpy:18880
translate belarusian d4_beasts_choice_take_devend_430a3ba3:

    # voice "voice/karina/4day/135 Ve.ogg"
    # Mam "Вы уж простите нас, ребятки."
    voice "voice/karina/4day/135 Ve.ogg"
    Mam "Вы ўжо даруйце нам, дзеткі."

# game/scripts/scene/scene_day_4.rpy:18882
translate belarusian d4_beasts_choice_take_devend_7e20c7ee:

    # "Мама кулачком смахнула слезу."
    "Мама кулачком змахнула слязу."

# game/scripts/scene/scene_day_4.rpy:18885
translate belarusian d4_beasts_choice_take_devend_787d9a18:

    # voice "voice/father/day4/90Da.ogg"
    # Pap "Да ладно тебе, Карин. Всё в прошлом."
    voice "voice/father/day4/90Da.ogg"
    Pap "Ды годзе табе, Карын. Усё ў мінулым."

# game/scripts/scene/scene_day_4.rpy:18894
translate belarusian d4_beasts_choice_take_devend_41e9ccd8:

    # voice "voice/father/day4/91 V.ogg" 
    # Pap "В общем, собирайте чемоданы, — летим в «Диснейленд»!"
    voice "voice/father/day4/91 V.ogg" 
    Pap "Словам, збірайце чамаданы, — ляцім у «Дыснейленд»!"

# game/scripts/scene/scene_day_4.rpy:18898
translate belarusian d4_beasts_choice_take_devend_0b553c41:

    # "От радости мы с сестрой запрыгали до потолка. К нам присоединилась раззадоренная громкими речами собачонка."
    "Ад радасці мы з сястрой заскакалі да столі. Да нас далучыўся раззадораны гучнымі прамовамі сабачка."

# game/scripts/scene/scene_day_4.rpy:18906
translate belarusian d4_beasts_choice_take_devend_5f6000a8:

    # AntOly "Ура!"
    AntOly "Ура!"

# game/scripts/scene/scene_day_4.rpy:18929
translate belarusian d4_beasts_choice_take_devend_1f112f81:

    # AntOly "«Диснейленд»! «Диснейленд»!"
    AntOly "«Дыснейленд»! «Дыснейленд»!"

# game/scripts/scene/scene_day_4.rpy:18940
translate belarusian d4_beasts_choice_take_devend_0489bd48:

    # "Наш восторженный визг целиком заполнил дом, пронёсся по чердаку и водосточной трубе, облетел двор и скрылся в сверкающем белизной лесу."
    "Наш захоплены віск цалкам напоўніў дом, пранёсся па гарышчы і вадасцёкавай трубе, абляцеў двор і схаваўся ў лесе, што зіхацеў белізной."

# game/scripts/scene/scene_day_4.rpy:18941
translate belarusian d4_beasts_choice_take_devend_8914d320:

    # "А вместе с ним ушло и страшное слово на букву «р»."
    "А разам з ім сышло і страшнае слова на літару «р»."

# game/scripts/scene/scene_day_4.rpy:18945
translate belarusian d4_beasts_choice_take_devend_2205018c:

    # "Я поклялся, что навсегда запомню этот день, когда с родителей наконец-то спали маски пренебрежения, а под ними оказались лица людей, которых мы всегда знали и любили."
    "Я пакляўся, што назаўсёды запомню гэты дзень, калі з бацькоў нарэшце спалі маскі пагардлівасці, а пад імі аказаліся твары людзей, якіх мы заўсёды ведалі і любілі."

# game/scripts/scene/scene_day_4.rpy:18962
translate belarusian d4_beasts_choice_take_devend_25ff058c:

    # "Лилия Павловна всё ещё не вернулась в школу из-за пропажи Кати, поэтому сегодня я выспался и шёл засветло только к третьему уроку."
    "Лілія Паўлаўна ўсё яшчэ не вярнулася ў школу з-за знікнення Каці, таму сёння я выспаўся і ішоў завідна толькі да трэцяга ўрока."

# game/scripts/scene/scene_day_4.rpy:18968
translate belarusian d4_beasts_choice_take_devend_1f27a777:

    # "Проложенная тропинка вела к чернеющим домикам на фоне белоснежной равнины, где из дымоходов уже валил сизый дым, пахнущий берёзовыми и сосновыми поленьями."
    "Пракладзеная сцяжынка вяла да домікаў, што чарнелі на фоне беласнежнай раўніны, дзе з комінаў ужо валіў шызы дым, які пах бярозавымі і хваёвымі паленамі."

# game/scripts/scene/scene_day_4.rpy:18969
translate belarusian d4_beasts_choice_take_devend_999688ea:

    # "Крепкий ночной мороз окончательно спал, задремав под солнечными лучами, и на белых шапках крыш заиграли ледяные искры."
    "Моцны начны мароз канчаткова спаў, задрамаўшы пад сонечнымі промнямі, і на белых шапках дахаў зайгралі ледзяныя іскры."

# game/scripts/scene/scene_day_4.rpy:18973
translate belarusian d4_beasts_choice_take_devend_d2065a21:

    # "Я остановился, уверенный, что сегодня никто не в силах испортить моё настроение."
    "Я спыніўся, упэўнены, што сёння ніхто не ў сілах сапсаваць мой настрой."

# game/scripts/scene/scene_day_4.rpy:18976
translate belarusian d4_beasts_choice_take_devend_93aa11e9:

    # "Ни мой персональный мучитель Пятифанов, ни его гадкий прихвостень Бяша."
    "Ні мой персанальны мучыцель Пяціфанаў, ні яго брыдкі прыхвасцень Бяша."

# game/scripts/scene/scene_day_4.rpy:18977
translate belarusian d4_beasts_choice_take_devend_82a28b7b:

    # "Ни сверкающий нож, грозивший вспороть мне брюхо, как дохлой рыбе."
    "Ні зіхоткі нож, які пагражаў распароць мне бруха, як дохлай рыбе."

# game/scripts/scene/scene_day_4.rpy:18980
translate belarusian d4_beasts_choice_take_devend_e9b16592:

    # "Даже пренебрежение и жалость, с которыми на меня порой смотрела Полина, словно остались в прошлом. Забылись, как дурной сон."
    "Нават пагардлівасць і жаль, з якімі на мяне часам глядзела Паліна, нібыта засталіся ў мінулым. Забыліся, як благі сон."

# game/scripts/scene/scene_day_4.rpy:18983
translate belarusian d4_beasts_choice_take_devend_e9572dcc:

    # "Ни грусти, ни жалости к себе из-за Полины, которая наверняка уже вовсю делилась с Ромкой грандиозными планами покорения Вены."
    "Ні смутку, ні жалю да сябе з-за Паліны, якая напэўна ўжо на поўную дзялілася з Ромкам грандыёзнымі планамі пакарэння Вены."

# game/scripts/scene/scene_day_4.rpy:18985
translate belarusian d4_beasts_choice_take_devend_c8754a5f:

    # "Всё кануло в небытие."
    "Усё канула ў нябыт."

# game/scripts/scene/scene_day_4.rpy:18989
translate belarusian d4_beasts_choice_take_devend_9040afed:

    # "Откуда-то протяжно замычала корова."
    "Аднекуль працяжна замычала карова."

# game/scripts/scene/scene_day_4.rpy:18990
translate belarusian d4_beasts_choice_take_devend_6d2f523c:

    # "Я выпал из секундной неги и двинулся дальше, хрустя снежной периной под подошвами."
    "Я выпаў з секунднай негі і рушыў далей, храбусцячы снежнай пярынай пад падэшвамі."

# game/scripts/scene/scene_day_4.rpy:18992
translate belarusian d4_beasts_choice_take_devend_c4585769:

    # "Высоко над головой плыли косматые облака, в чьих очертаниях угадывались милые сердцу силуэты зверят."
    "Высока над галавой плылі калматыя аблокі, у абрысах якіх угадваліся мілыя сэрцу сілуэты звяранят."

# game/scripts/scene/scene_day_4.rpy:19000
translate belarusian d4_beasts_choice_take_devend_a7103825:

    # "Внезапно мне на голову приземлился пушистый снежок, и девичий смех, напоминающий звон колокольчика на весеннем ветру, коснулся моих ушей."
    "Раптам мне на галаву прызямлілася пухнатая снежка, і дзявочы смех, што нагадваў звон званочка на вясновым ветры, крануўся маіх вушэй."

# game/scripts/scene/scene_day_4.rpy:19002
translate belarusian d4_beasts_choice_take_devend_7e4e0d94:

    # "Я обернулся в ожидании увидеть её, мою дорогую проводницу в сказочный мир грёз — горячо любимую и обожаемую Алису."
    "Я азірнуўся ў чаканні ўбачыць яе, маю дарагую правадніцу ў казачны свет мрояў — горача любімую і абагаўлёную Алісу."

# game/scripts/scene/scene_day_4.rpy:19012
translate belarusian d4_beasts_choice_take_devend_6e60a630:

    # "Но вместо девочки-лисицы на протоптанной дорожке позади стояла Полина с неизменным скрипичным футляром в руке."
    "Але замест дзяўчынкі-лісіцы на пратаптанай дарожцы ззаду стаяла Паліна з нязменным скрыпічным футаралам у руцэ."

# game/scripts/scene/scene_day_4.rpy:19028
translate belarusian d4_beasts_choice_take_devend_a2464e88:

    # voice "voice/Polina/4day/178 Op.ogg"
    # Pol "Опять, Петров, ворон считаешь."
    voice "voice/Polina/4day/178 Op.ogg"
    Pol "Зноў, Пятроў, варон лічыш."

# game/scripts/scene/scene_day_4.rpy:19043
translate belarusian d4_beasts_choice_take_devend_8332352e:

    # "Она заразительно засмеялась и, подбежав, вдруг бросилась мне на шею. Я опешил, утонув в сладком аромате её духов."
    "Яна заразліва засмяялася і, падбегшы, раптам кінулася мне на шыю. Я аслупянеў, патануўшы ў салодкім водары яе парфумы."

# game/scripts/scene/scene_day_4.rpy:19053
translate belarusian d4_beasts_choice_take_devend_d8f95a7b:

    # "Только вчера я был потрясён её внезапной истерикой, и мне казалось, что лучше держаться от Полины подальше."
    "Толькі ўчора я быў узрушаны яе раптоўнай істэрыкай, і мне здавалася, што лепш трымацца ад Паліны падалей."

# game/scripts/scene/scene_day_4.rpy:19054
translate belarusian d4_beasts_choice_take_devend_c62bb6f5:

    # "От её резких, как качели, перепадов настроения, от чудаковатого деда..."
    "Ад яе рэзкіх, як арэлі, перападаў настрою, ад дзівакаватага дзеда..."

# game/scripts/scene/scene_day_4.rpy:19055
translate belarusian d4_beasts_choice_take_devend_48624517:

    # "Но стоило ей обнять меня, как я сразу позабыл весь кошмар и уже не хотел, чтоб скрипачка меня отпускала."
    "Але варта было ёй абняць мяне, як я адразу забыў увесь кашмар і ўжо не хацеў, каб скрыпачка мяне адпускала."

# game/scripts/scene/scene_day_4.rpy:19057
translate belarusian d4_beasts_choice_take_devend_c225322e:

    # voice "voice/anton/4day/216. Chto.ogg"
    # Ant "Ч-что с тобой?"
    voice "voice/anton/4day/216. Chto.ogg"
    Ant "Ш-што з табой?"

# game/scripts/scene/scene_day_4.rpy:19060
translate belarusian d4_beasts_choice_take_devend_ca7f805e:

    # "Она смущённо улыбнулась. Я увидел блеск в её васильковых глазах."
    "Яна збянтэжана ўсміхнулася. Я ўбачыў бляск у яе валошкавых вачах."

# game/scripts/scene/scene_day_4.rpy:19062
translate belarusian d4_beasts_choice_take_devend_4bf2414b:

    # voice "voice/Polina/4day/179 De.ogg"
    # Pol "Дедушка мой, он..."
    voice "voice/Polina/4day/179 De.ogg"
    Pol "Дзядуля мой, ён..."

# game/scripts/scene/scene_day_4.rpy:19066
translate belarusian d4_beasts_choice_take_devend_853efe52:

    # voice "voice/Polina/4day/180 On.ogg"
    # Pol "Он снова может ходить, представляешь?"
    voice "voice/Polina/4day/180 On.ogg"
    Pol "Ён зноў можа хадзіць, уяўляеш?"

# game/scripts/scene/scene_day_4.rpy:19070
translate belarusian d4_beasts_choice_take_devend_61494940:

    # voice "voice/Polina/4day/181 V.ogg"
    # Pol "В это даже сельский врач не верил, а он будто назло ему встал и пошёл."
    voice "voice/Polina/4day/181 V.ogg"
    Pol "У гэта нават сельскі доктар не верыў, а ён быццам назло яму ўстаў і пайшоў."

# game/scripts/scene/scene_day_4.rpy:19074
translate belarusian d4_beasts_choice_take_devend_769c0dd5:

    # voice "voice/Polina/4day/182 O.ogg"
    # Pol "О, это самый счастливый день в моей жизни, Антон!"
    voice "voice/Polina/4day/182 O.ogg"
    Pol "О, гэта самы шчаслівы дзень у маім жыцці, Антон!"

# game/scripts/scene/scene_day_4.rpy:19080
translate belarusian d4_beasts_choice_take_devend_2a0a2c13:

    # "Она зарылась лицом в мою грудь, сцепила руки на шее, словно я был для неё больше, чем просто друг."
    "Яна зарылася тварам у мае грудзі, счапіла рукі на шыі, нібыта я быў для яе больш, чым проста сябар."

# game/scripts/scene/scene_day_4.rpy:19081
translate belarusian d4_beasts_choice_take_devend_302def22:

    # "Я взволнованно начал озираться."
    "Я ўсхвалявана пачаў азірацца."

# game/scripts/scene/scene_day_4.rpy:19082
translate belarusian d4_beasts_choice_take_devend_88957670:

    # voice "voice/anton/4day/217. Pol.ogg"
    # Ant "Полин, э-э-э... Нас могут увидеть."
    voice "voice/anton/4day/217. Pol.ogg"
    Ant "Палін, э-э-э... Нас могуць убачыць."

# game/scripts/scene/scene_day_4.rpy:19086
translate belarusian d4_beasts_choice_take_devend_6169e973:

    # voice "voice/Polina/4day/183 Iz.ogg"
    # Pol "Из-за Пятифанова беспокоишься?"
    voice "voice/Polina/4day/183 Iz.ogg"
    Pol "З-за Пяціфанава непакоішся?"

# game/scripts/scene/scene_day_4.rpy:19090
translate belarusian d4_beasts_choice_take_devend_f868a8c7:

    # voice "voice/Polina/4day/184 B.ogg"
    # Pol "Брось ты это дело — его и след простыл."
    voice "voice/Polina/4day/184 B.ogg"
    Pol "Кінь ты гэтую справу — яго і след прастыў."

# game/scripts/scene/scene_day_4.rpy:19100
translate belarusian d4_beasts_choice_take_devend_2361350f:

    # "Я недоверчиво отодвинул Полину, пытаясь понять, розыгрыш это или правда."
    "Я недаверліва адсунуў Паліну, спрабуючы зразумець, розыгрыш гэта ці праўда."

# game/scripts/scene/scene_day_4.rpy:19103
translate belarusian d4_beasts_choice_take_devend_4972a937:

    # voice "voice/Polina/4day/185 Nu.ogg"
    # Pol "Ну ты чего, не веришь, что ли?"
    voice "voice/Polina/4day/185 Nu.ogg"
    Pol "Ну ты чаго, не верыш, ці што?"

# game/scripts/scene/scene_day_4.rpy:19107
translate belarusian d4_beasts_choice_take_devend_26262b0c:

    # voice "voice/Polina/4day/186 K.ogg"
    # Pol "К нам вчера буквально ночью старший лейтенант Тихонов приезжал."
    voice "voice/Polina/4day/186 K.ogg"
    Pol "Да нас учора літаральна ўночы старшы лейтэнант Ціханаў прыязджаў."

# game/scripts/scene/scene_day_4.rpy:19111
translate belarusian d4_beasts_choice_take_devend_7551beaa:

    # voice "voice/Polina/4day/187 T.ogg"
    # Pol "Так и так, Бяша потерялся, а вместе с ним и дружок его Ромка."
    voice "voice/Polina/4day/187 T.ogg"
    Pol "Так і так, Бяша згубіўся, а разам з ім і сябрук яго Ромка."

# game/scripts/scene/scene_day_4.rpy:19117
translate belarusian d4_beasts_choice_take_devend_1452c88b:

    # "Мимо нас прямиком в зимний лес прокатили лыжники."
    "Міма нас проста ў зімовы лес пракацілі лыжнікі."

# game/scripts/scene/scene_day_4.rpy:19127
translate belarusian d4_beasts_choice_take_devend_4071b33b:

    # "Полина склонилась ко мне поделиться шепотком, не выпуская спортсменов из виду."
    "Паліна схілілася да мяне падзяліцца шапатком, не выпускаючы спартсменаў з вачэй."

# game/scripts/scene/scene_day_4.rpy:19132
translate belarusian d4_beasts_choice_take_devend_b06d6b9a:

    # voice "voice/Polina/4day/188 K.ogg"
    # Pol "Как я поняла, во всех этих исчезновениях Тихонов подозревает Пятифанова."
    voice "voice/Polina/4day/188 K.ogg"
    Pol "Як я зразумела, ва ўсіх гэтых знікненнях Ціханаў падазрае Пяціфанава."

# game/scripts/scene/scene_day_4.rpy:19141
translate belarusian d4_beasts_choice_take_devend_1c8de83e:

    # voice "voice/anton/4day/218. Da.ogg"
    # Ant "Да ладно!"
    voice "voice/anton/4day/218. Da.ogg"
    Ant "Ды ну!"

# game/scripts/scene/scene_day_4.rpy:19149
translate belarusian d4_beasts_choice_take_devend_68707aa7:

    # voice "voice/Polina/4day/189 Ya.ogg"
    # Pol "Я сама в шоке."
    voice "voice/Polina/4day/189 Ya.ogg"
    Pol "Я сама ў шоку."

# game/scripts/scene/scene_day_4.rpy:19151
translate belarusian d4_beasts_choice_take_devend_a2c1d04d:

    # voice "voice/Polina/4day/190 po.ogg"
    # Pol "По слухам, у Ромки того, совсем шарики за ролики заехали."
    voice "voice/Polina/4day/190 po.ogg"
    Pol "Па чутках, у Ромкі таго, зусім шарыкі за ролікі заехалі."

# game/scripts/scene/scene_day_4.rpy:19153
translate belarusian d4_beasts_choice_take_devend_0e8cb505:

    # voice "voice/Polina/4day/191 Da.ogg"
    # Pol "Да я, в принципе, и не удивлена..."
    voice "voice/Polina/4day/191 Da.ogg"
    Pol "Ды я, у прынцыпе, і не здзіўлена..."

# game/scripts/scene/scene_day_4.rpy:19156
translate belarusian d4_beasts_choice_take_devend_d94ef132:

    # voice "voice/anton/4day/219. Cto.ogg"
    # Ant "Что ты имеешь в виду?"
    voice "voice/anton/4day/219. Cto.ogg"
    Ant "Што ты маеш на ўвазе?"

# game/scripts/scene/scene_day_4.rpy:19159
translate belarusian d4_beasts_choice_take_devend_0bbc1b2a:

    # voice "voice/Polina/4day/192 A.ogg"
    # Pol "А ты не знал? Он из проблемной семьи."
    voice "voice/Polina/4day/192 A.ogg"
    Pol "А ты не ведаў? Ён з праблемнай сям'і."

# game/scripts/scene/scene_day_4.rpy:19161
translate belarusian d4_beasts_choice_take_devend_b2cf902a:

    # voice "voice/Polina/4day/193 D.ogg"
    # Pol "Даже думать не хочу, что творилось у них дома."
    voice "voice/Polina/4day/193 D.ogg"
    Pol "Нават думаць не хачу, што тварылася ў іх дома."

# game/scripts/scene/scene_day_4.rpy:19165
translate belarusian d4_beasts_choice_take_devend_443744bd:

    # "Ромка всегда казался мне чрезмерно жестоким, без повода озлобленным на всех подряд."
    "Ромка заўсёды здаваўся мне празмерна жорсткім, без нагоды азлобленым на ўсіх запар."

# game/scripts/scene/scene_day_4.rpy:19166
translate belarusian d4_beasts_choice_take_devend_5f2c7350:

    # "Теперь чернота, что была у него внутри, выплеснулась через край и загубила множество невинных детских душ, даже его собственную."
    "Цяпер чарната, што была ў яго ўнутры, выплюхнулася цераз край і загубіла мноства нявінных дзіцячых душ, нават яго ўласную."

# game/scripts/scene/scene_day_4.rpy:19167
translate belarusian d4_beasts_choice_take_devend_251e5e68:

    # "В это было сложно поверить, но, глядя на Ромку, я чувствовал, что приблизительно так всё и кончится."
    "У гэта было цяжка паверыць, але, гледзячы на Ромку, я адчуваў, што прыблізна так усё і скончыцца."

# game/scripts/scene/scene_day_4.rpy:19178
translate belarusian d4_beasts_choice_take_devend_454fd863:

    # voice "voice/Polina/4day/194 V.ogg"
    # Pol "Вот, а ты ещё мне его сватал."
    voice "voice/Polina/4day/194 V.ogg"
    Pol "Вось, а ты яшчэ мне яго сватаў."

# game/scripts/scene/scene_day_4.rpy:19182
translate belarusian d4_beasts_choice_take_devend_f421ab9d:

    # voice "voice/Polina/4day/195 K.ogg"
    # Pol "Как вспомню... Бр-р-р!"
    voice "voice/Polina/4day/195 K.ogg"
    Pol "Як успомню... Бр-р-р!"

# game/scripts/scene/scene_day_4.rpy:19185
translate belarusian d4_beasts_choice_take_devend_e0105ab2:

    # voice "voice/anton/4day/220. Proste.ogg"
    # Ant "Прости, пожалуйста."
    voice "voice/anton/4day/220. Proste.ogg"
    Ant "Прабач, калі ласка."

# game/scripts/scene/scene_day_4.rpy:19187
translate belarusian d4_beasts_choice_take_devend_d33b61a3:

    # "Она махнула рукой и улыбнулась."
    "Яна махнула рукой і ўсміхнулася."

# game/scripts/scene/scene_day_4.rpy:19189
translate belarusian d4_beasts_choice_take_devend_28d169ac:

    # voice "voice/Polina/4day/196 K.ogg"
    # Pol "Кто старое помянет..."
    voice "voice/Polina/4day/196 K.ogg"
    Pol "Хто старое памяне..."

# game/scripts/scene/scene_day_4.rpy:19208
translate belarusian d4_beasts_choice_take_devend_2128be7e:

    # voice "voice/Polina/4day/197 Vo.ogg"
    # Pol "Вот бы ещё и бездомные дворняги тоже исчезли."
    voice "voice/Polina/4day/197 Vo.ogg"
    Pol "Вось бы яшчэ і бяздомныя дварнякі таксама зніклі."

# game/scripts/scene/scene_day_4.rpy:19212
translate belarusian d4_beasts_choice_take_devend_ae597115:

    # voice "voice/Polina/4day/198 Ne.ogg"
    # Pol "Не жизнь была б, а песня."
    voice "voice/Polina/4day/198 Ne.ogg"
    Pol "Не жыццё было б, а песня."

# game/scripts/scene/scene_day_4.rpy:19221
translate belarusian d4_beasts_choice_take_devend_9dcc3c4a:

    # "Я с подозрением взглянул на Полину."
    "Я з падазрэннем зірнуў на Паліну."

# game/scripts/scene/scene_day_4.rpy:19239
translate belarusian d4_beasts_choice_take_devend_36a661c4:

    # voice "voice/Polina/4day/199 Da.ogg"
    # Pol "Ха-ха! Да шучу я!"
    voice "voice/Polina/4day/199 Da.ogg"
    Pol "Ха-ха! Ды жартую я!"

# game/scripts/scene/scene_day_4.rpy:19246
translate belarusian d4_beasts_choice_take_devend_96a64b51:

    # voice "voice/Polina/4day/200 Po.ogg"
    # Pol "Пойдём скорее, а то опоздаем."
    voice "voice/Polina/4day/200 Po.ogg"
    Pol "Хадзем хутчэй, а то спознімся."

# game/scripts/scene/scene_day_4.rpy:19255
translate belarusian d4_beasts_choice_take_devend_e3199064:

    # "Полина схватила мою ладонь и, весело смеясь, побежала по просёлочной дороге."
    "Паліна схапіла маю далонь і, весела смеючыся, пабегла па прасёлкавай дарозе."

# game/scripts/scene/scene_day_4.rpy:19276
translate belarusian d4_beasts_choice_take_devend_6b0a1f64:

    # "И с каждым шагом, с каждым смешком и шуткой позабытое тепло обволакивало моё сердце."
    "І з кожным крокам, з кожным смяшком і жартам забытае цяпло агортвала маё сэрца."

# game/scripts/scene/scene_day_4.rpy:19282
translate belarusian d4_beasts_choice_take_devend_8817b151:

    # "Всеобъемлющая влюблённость вернулась ко мне, и казалось, что уже никогда меня не покинет."
    "Усеабдымная закаханасць вярнулася да мяне, і здавалася, што ўжо ніколі мяне не пакіне."

# game/scripts/scene/scene_day_4.rpy:19298
translate belarusian d4_beasts_choice_take_devend_51a25aed:

    # "Перед входом в класс я попытался отпустить руку Полины, стесняясь, что одноклассники будут дразнить нас женихом и невестой."
    "Перад уваходам у клас я паспрабаваў адпусціць руку Паліны, саромеючыся, што аднакласнікі будуць дражніць нас жаніхом і нявестай."

# game/scripts/scene/scene_day_4.rpy:19307
translate belarusian d4_beasts_choice_take_devend_2cb39d8d:

    # "Но Полине было словно всё равно, и она только сильнее сжала мою ладонь, отворяя дверь."
    "Але Паліне было нібыта ўсё адно, і яна толькі мацней сціснула маю далонь, адчыняючы дзверы."

# game/scripts/scene/scene_day_4.rpy:19316
translate belarusian d4_beasts_choice_take_devend_613cf513:

    # "И действительно: избавившись от коварной Катьки, бессердечного Ромки и ехидного Бяши, наш класс словно бы излечился от паразитов, стал дружелюбнее и отзывчивее."
    "І сапраўды: пазбавіўшыся ад падступнай Кацькі, бессардэчнага Ромкі і з'едлівага Бяшы, наш клас нібыта вылечыўся ад паразітаў, стаў больш прыязным і спагадлівым."

# game/scripts/scene/scene_day_4.rpy:19317
translate belarusian d4_beasts_choice_take_devend_a1961258:

    # "Никто больше не смотрел на меня залитыми злобой глазами, некому было харкнуть в меня кусочком жёваной бумажки через полый корпус шариковой ручки."
    "Ніхто больш не глядзеў на мяне залітымі злосцю вачыма, не было каму харкнуць у мяне кавалачкам жаванай паперкі праз полы корпус шарыкавай ручкі."

# game/scripts/scene/scene_day_4.rpy:19332
translate belarusian d4_beasts_choice_take_devend_00055050:

    # "Я сел за свою одинокую парту, когда рядом уселась Полина. Меня это нисколько не удивило."
    "Я сеў за сваю адзінокую парту, калі побач уселася Паліна. Мяне гэта ніколькі не здзівіла."

# game/scripts/scene/scene_day_4.rpy:19352
translate belarusian d4_beasts_choice_take_devend_b02bad6b:

    # "Она была такой очаровательной, что я мог бы назвать её своей музой."
    "Яна была такой чароўнай, што я мог бы назваць яе сваёй музай."

# game/scripts/scene/scene_day_4.rpy:19363
translate belarusian d4_beasts_choice_take_devend_16c3b87e:

    # "Подхваченный волной вдохновения, я вытащил из рюкзака альбом для рисования."
    "Падхоплены хваляй натхнення, я выцягнуў з рукзака альбом для малявання."

# game/scripts/scene/scene_day_4.rpy:19373
translate belarusian d4_beasts_choice_take_devend_23882562:

    # "Облизнул грифель карандаша, не выпуская из поля зрения свою модель."
    "Аблізнуў грыфель алоўка, не выпускаючы з поля зроку сваю мадэль."

# game/scripts/scene/scene_day_4.rpy:19377
translate belarusian d4_beasts_choice_take_devend_55bc1f67:

    # "Она вновь улыбнулась мне."
    "Яна зноў усміхнулася мне."

# game/scripts/scene/scene_day_4.rpy:19379
translate belarusian d4_beasts_choice_take_devend_efca3a5a:

    # voice "voice/Polina/4day/201 Ch.ogg"
    # Pol "Что ты задумал?"
    voice "voice/Polina/4day/201 Ch.ogg"
    Pol "Што ты задумаў?"

# game/scripts/scene/scene_day_4.rpy:19393
translate belarusian d4_beasts_choice_take_devend_8b1ed9e0:

    # voice "voice/anton/4day/221. Spok.ogg"
    # Ant "Спокойствие! Работает профессионал."
    voice "voice/anton/4day/221. Spok.ogg"
    Ant "Спакой! Працуе прафесіянал."

# game/scripts/scene/scene_day_4.rpy:19401
translate belarusian d4_beasts_choice_take_devend_84ec3c27:

    # "Я наметил будущие контуры обворожительного силуэта."
    "Я намеціў будучыя контуры чароўнага сілуэта."

# game/scripts/scene/scene_day_4.rpy:19406
translate belarusian d4_beasts_choice_take_devend_fa3c6cb4:

    # voice "voice/anton/4day/222. Znae.ogg"
    # Ant "Знаешь, я часто наблюдал за тобой отсюда."
    voice "voice/anton/4day/222. Znae.ogg"
    Ant "Ведаеш, я часта назіраў за табой адсюль."

# game/scripts/scene/scene_day_4.rpy:19417
translate belarusian d4_beasts_choice_take_devend_028accea:

    # "Она бросила взгляд на свою бывшую парту. Смущённо убрала за ушко локон."
    "Яна кінула позірк на сваю былую парту. Збянтэжана прыбрала за вушка локан."

# game/scripts/scene/scene_day_4.rpy:19420
translate belarusian d4_beasts_choice_take_devend_29de6df2:

    # voice "voice/Polina/4day/202 P.ogg"
    # Pol "Правда?"
    voice "voice/Polina/4day/202 P.ogg"
    Pol "Праўда?"

# game/scripts/scene/scene_day_4.rpy:19435
translate belarusian d4_beasts_choice_take_devend_dc6c2fe3:

    # "Несколькими широкими линиями я обозначил миленькие скулы."
    "Некалькімі шырокімі лініямі я акрэсліў міленькія скулы."

# game/scripts/scene/scene_day_4.rpy:19440
translate belarusian d4_beasts_choice_take_devend_4f6db853:

    # "Мне никогда ещё не удавалось с такой точностью взять пропорции чьего-либо лица."
    "Мне ніколі яшчэ не ўдавалася з такой дакладнасцю ўзяць прапорцыі чыйго-небудзь твару."

# game/scripts/scene/scene_day_4.rpy:19441
translate belarusian d4_beasts_choice_take_devend_0c81f832:

    # voice "voice/anton/4day/223. Po.ogg"
    # Ant "Полина..."
    voice "voice/anton/4day/223. Po.ogg"
    Ant "Паліна..."

# game/scripts/scene/scene_day_4.rpy:19450
translate belarusian d4_beasts_choice_take_devend_25f6adff:

    # voice "voice/Polina/4day/203 Cht.ogg"
    # Pol "Что, Антон?"
    voice "voice/Polina/4day/203 Cht.ogg"
    Pol "Што, Антон?"

# game/scripts/scene/scene_day_4.rpy:19453
translate belarusian d4_beasts_choice_take_devend_2bd5bd45:

    # "Она замерла, боясь неверным движением помешать мне, развеять волшебство."
    "Яна замерла, баючыся няправільным рухам перашкодзіць мне, развеяць чараўніцтва."

# game/scripts/scene/scene_day_4.rpy:19463
translate belarusian d4_beasts_choice_take_devend_afd10d4d:

    # voice "voice/anton/4day/244.Na.ogg"
    # Ant "Наклонись, пожалуйста, сюда."
    voice "voice/anton/4day/244.Na.ogg"
    Ant "Нахіліся, калі ласка, сюды."

# game/scripts/scene/scene_day_4.rpy:19465
translate belarusian d4_beasts_choice_take_devend_2871abde:

    # voice "voice/anton/4day/244.Vot.ogg"
    # Ant "Вот так, да. Хорошо."
    voice "voice/anton/4day/244.Vot.ogg"
    Ant "Вось так, так. Добра."

# game/scripts/scene/scene_day_4.rpy:19479
translate belarusian d4_beasts_choice_take_devend_52b18d53:

    # "Задыхаясь от волнения, Полина расслабила узелок шейного платка."
    "Задыхаючыся ад хвалявання, Паліна паслабіла вузялок шыйной хусткі."

# game/scripts/scene/scene_day_4.rpy:19480
translate belarusian d4_beasts_choice_take_devend_24710dbc:

    # voice "voice/anton/4day/225. Yav.ogg"
    # Ant "Я всегда хотел тебя... нарисовать."
    voice "voice/anton/4day/225. Yav.ogg"
    Ant "Я заўсёды хацеў цябе... намаляваць."

# game/scripts/scene/scene_day_4.rpy:19482
translate belarusian d4_beasts_choice_take_devend_c5569c6a:

    # "Наши глаза встретились."
    "Нашы вочы сустрэліся."

# game/scripts/scene/scene_day_4.rpy:19492
translate belarusian d4_beasts_choice_take_devend_2eaf5093:

    # voice "voice/Polina/4day/205 O.ogg"
    # Pol "О, Антон."
    voice "voice/Polina/4day/205 O.ogg"
    Pol "О, Антон."

# game/scripts/scene/scene_day_4.rpy:19498
translate belarusian d4_beasts_choice_take_devend_6f509d93:

    # "Карандаш носился над бумагой, яростно штрихуя тени на её груди."
    "Аловак насіўся над паперай, люта штрыхуючы цені на яе грудзях."

# game/scripts/scene/scene_day_4.rpy:19499
translate belarusian d4_beasts_choice_take_devend_8a1c2278:

    # voice "voice/anton/4day/226. Ska.ogg"
    # Ant "Скажи, ты согласна стать героиней моего комикса?"
    voice "voice/anton/4day/226. Ska.ogg"
    Ant "Скажы, ты згодна стаць гераіняй майго комікса?"

# game/scripts/scene/scene_day_4.rpy:19514
translate belarusian d4_beasts_choice_take_devend_e52f61fa:

    # "Сладкая дрожь пробежала по её телу. Она томно закатила глаза от удовольствия."
    "Салодкія дрыжыкі прабеглі па яе целе. Яна млосна закаціла вочы ад задавальнення."

# game/scripts/scene/scene_day_4.rpy:19516
translate belarusian d4_beasts_choice_take_devend_2238a926:

    # voice "voice/Polina/4day/206 Da.ogg"
    # Pol "Да! Да!"
    voice "voice/Polina/4day/206 Da.ogg"
    Pol "Так! Так!"

# game/scripts/scene/scene_day_4.rpy:19520
translate belarusian d4_beasts_choice_take_devend_f5494d58:

    # voice "voice/Polina/4day/207 K.ogg"
    # Pol "Как долго я ждала этих слов, милый!"
    voice "voice/Polina/4day/207 K.ogg"
    Pol "Як доўга я чакала гэтых слоў, мілы!"

# game/scripts/scene/scene_day_4.rpy:19540
translate belarusian d4_wake_up_devend_39d70300:

    # "От напряжения грифель карандаша не выдержал и, щёлкнув, разлетелся на мелкие осколки."
    "Ад напружання грыфель алоўка не вытрымаў і, шчоўкнуўшы, разляцеўся на дробныя аскепкі."

# game/scripts/scene/scene_day_4.rpy:19573
translate belarusian d4_wake_up_devend_cec102ee:

    # "Я не мог поверить, глядя на рисунок."
    "Я не мог паверыць, гледзячы на малюнак."

# game/scripts/scene/scene_day_4.rpy:19624
translate belarusian d4_wake_up_devend_e6aaafef:

    # "Ужасная мазня смотрела на меня. Там, где секунду назад было лицо Полины, сейчас красовалось бесформенное месиво."
    "Жудасная мазня глядзела на мяне. Там, дзе секунду таму быў твар Паліны, цяпер красавалася бясформеннае месіва."

# game/scripts/scene/scene_day_4.rpy:19625
translate belarusian d4_wake_up_devend_a20cefa7:

    # "..."
    "..."

# game/scripts/scene/scene_day_4.rpy:19643
translate belarusian d4_wake_up_devend_999eb8cb:

    # "Я не сразу понял, что сижу за партой в пустом классе."
    "Я не адразу зразумеў, што сяджу за партай у пустым класе."

# game/scripts/scene/scene_day_4.rpy:19645
translate belarusian d4_wake_up_devend_885977c8:

    # "Пылинки летали в лунном свете."
    "Пылінкі ляталі ў месячным святле."

# game/scripts/scene/scene_day_4.rpy:19646
translate belarusian d4_wake_up_devend_49cad19b:

    # "За окном была ночь, и куда-то подевались одноклассники, Полина, ощущение эйфории."
    "За акном была ноч, і кудысьці падзеліся аднакласнікі, Паліна, адчуванне эйфарыі."

# game/scripts/scene/scene_day_4.rpy:19647
translate belarusian d4_wake_up_devend_d8474f85:

    # "На доске кто-то написал мелом считалочку, но стёр часть слов, и читалось лишь:"
    "На дошцы нехта напісаў крэйдай лічылку, але сцёр частку слоў, і чыталася толькі:"

# game/scripts/scene/scene_day_4.rpy:19648
translate belarusian d4_wake_up_devend_3691f083:

    # "раз-два..."
    "раз-два..."

# game/scripts/scene/scene_day_4.rpy:19649
translate belarusian d4_wake_up_devend_fa6b925e:

    # "...Зайчик..." id d4_wake_up_devend_fa6b925e
    "...Зайчык..."

# game/scripts/scene/scene_day_4.rpy:19650
translate belarusian d4_wake_up_devend_61ff1306:

    # "...мясо..." id d4_wake_up_devend_61ff1306
    "...мяса..."

# game/scripts/scene/scene_day_4.rpy:19651
translate belarusian d4_wake_up_devend_19012565:

    # "Дурацкая ухмылка сползла с моих губ."
    "Дурацкая ўсмешка спаўзла з маіх вуснаў."

# game/scripts/scene/scene_day_4.rpy:19652
translate belarusian d4_wake_up_devend_d8c361de:

    # "Я встал, ущипнув себя за запястье. Тишина была оглушительной."
    "Я ўстаў, ушчыпнуўшы сябе за запясце. Цішыня была аглушальнай."

# game/scripts/scene/scene_day_4.rpy:19653
translate belarusian d4_wake_up_devend_cef95e6b:

    # "Во рту стоял привкус блевоты, а в ушах звенело, как от нескончаемого вопля, полного отчаянья и ужаса."
    "У роце стаяў прысмак блявоціны, а ў вушах звінела, як ад бясконцага ляманту, поўнага адчаю і жаху."

# game/scripts/scene/scene_day_4.rpy:19668
translate belarusian d4_wake_up_devend_1707b594:

    # voice "voice/anton/4day/228. Ei.ogg"
    # Ant "Эй? Кто-нибудь?"
    voice "voice/anton/4day/228. Ei.ogg"
    Ant "Гэй? Хто-небудзь?"

# game/scripts/scene/scene_day_4.rpy:19672
translate belarusian d4_wake_up_devend_fb32e943:

    # "В коридоре роились тени."
    "У калідоры раіліся цені."

# game/scripts/scene/scene_day_4.rpy:19682
translate belarusian d4_wake_up_devend_7fe27bf1:

    # "Я шёл мимо заколоченных классов, мимо пятен гнили на стенах и серебристой паутины."
    "Я ішоў міма забітых дошкамі класаў, міма плям гнілі на сценах і серабрыстага павуціння."

# game/scripts/scene/scene_day_4.rpy:19683
translate belarusian d4_wake_up_devend_b63c0781:

    # "Пауки быстро перемещались под потолком."
    "Павукі хутка перамяшчаліся пад столлю."

# game/scripts/scene/scene_day_4.rpy:19684
translate belarusian d4_wake_up_devend_8311e97a:

    # "Лампы тревожно мерцали."
    "Лямпы трывожна мігцелі."

# game/scripts/scene/scene_day_4.rpy:19690
translate belarusian d4_wake_up_devend_c65f54c3:

    # "Ошеломлённый, я встал напротив доски объявлений."
    "Агаломшаны, я стаў насупраць дошкі аб'яў."

# game/scripts/scene/scene_day_4.rpy:19691
translate belarusian d4_wake_up_devend_21880413:

    # "К портретам Семёна и Кати добавились сотни других фотографий."
    "Да партрэтаў Сямёна і Каці дадаліся сотні іншых фатаграфій."

# game/scripts/scene/scene_day_4.rpy:19692
translate belarusian d4_wake_up_devend_92784406:

    # "Чёрно-белые распечатки клеили одну поверх другой. Жуткий коллаж из детских лиц глядел провалами глаз."
    "Чорна-белыя раздрукоўкі клеілі адну паверх другой. Жудасны калаж з дзіцячых твараў глядзеў праваламі вачэй."

# game/scripts/scene/scene_day_4.rpy:19699
translate belarusian d4_wake_up_devend_cc1dbefb:

    # "Не в силах выносить пытку этих внимательных дыр, я выбежал из школы."
    "Не ў сілах трываць катаванне гэтых уважлівых дзірак, я выбег са школы."

# game/scripts/scene/scene_day_4.rpy:19725
translate belarusian d4_wake_up_devend_6339484f:

    # "По двору – на дорогу, где шуршала пороша."
    "Па двары — на дарогу, дзе шамацела пароша."

# game/scripts/scene/scene_day_4.rpy:19746
translate belarusian d4_wake_up_devend_850d519b:

    # "Ни людей, ни машин, ни птиц..."
    "Ні людзей, ні машын, ні птушак..."

# game/scripts/scene/scene_day_4.rpy:19747
translate belarusian d4_wake_up_devend_115ab510:

    # "Низкие облака задевали дымоходы."
    "Нізкія хмары чаплялі коміны."

# game/scripts/scene/scene_day_4.rpy:19748
translate belarusian d4_wake_up_devend_becdc878:

    # "Окна словно закрасили чернилами."
    "Вокны быццам зафарбавалі чарнілам."

# game/scripts/scene/scene_day_4.rpy:19749
translate belarusian d4_wake_up_devend_43e47e3b:

    # "Фотографии пропавших облепили столбы и заборы бумажной шкурой. Не только детей, но и взрослых."
    "Фатаграфіі зніклых абляпілі слупы і платы папяровай шкурай. Не толькі дзяцей, але і дарослых."

# game/scripts/scene/scene_day_4.rpy:19750
translate belarusian d4_wake_up_devend_b950abca:

    # "Кажется, все жители посёлка стали чёрно-белыми призраками на снимках с пометкой «РАЗЫСКИВАЕТСЯ»."
    "Здаецца, усе жыхары пасёлка сталі чорна-белымі прывідамі на здымках з пазнакай «АДШУКВАЕЦЦА»."

# game/scripts/scene/scene_day_4.rpy:19751
translate belarusian d4_wake_up_devend_9c4654ea:

    # "Я брёл в тишине по умершей улице."
    "Я брыў у цішыні па памерлай вуліцы."

# game/scripts/scene/scene_day_4.rpy:19752
translate belarusian d4_wake_up_devend_3a25123c:

    # "В некоторых домах были выбиты стёкла. Ветер хозяйничал, рыская по комнатам."
    "У некаторых дамах былі выбіты шыбы. Вецер гаспадарыў, шастаючы па пакоях."

# game/scripts/scene/scene_day_4.rpy:19753
translate belarusian d4_wake_up_devend_0475d2f7:

    # "Входные двери качались от его порывов."
    "Уваходныя дзверы гайдаліся ад яго парываў."

# game/scripts/scene/scene_day_4.rpy:19754
translate belarusian d4_wake_up_devend_86a5abb7:

    # "На штакетинах висели детские курточки, их рукава шевелились, тянулись ко мне."
    "На штыкецінах віселі дзіцячыя куртачкі, іх рукавы варушыліся, цягнуліся да мяне."

# game/scripts/scene/scene_day_4.rpy:19755
translate belarusian d4_wake_up_devend_e4177609:

    # "Пустой посёлок. Пустая оболочка."
    "Пусты пасёлак. Пустая абалонка."

# game/scripts/scene/scene_day_4.rpy:19756
translate belarusian d4_wake_up_devend_c5409ea9:

    # "Что здесь случилось?"
    "Што тут здарылася?"

# game/scripts/scene/scene_day_4.rpy:19778
translate belarusian d4_wake_up_devend_a849d7c5:

    # "В переулке затарахтел, опрокидываясь, мусорный бак."
    "У завулку затарахцеў, перакульваючыся, смеццевы бак."

# game/scripts/scene/scene_day_4.rpy:19787
translate belarusian d4_wake_up_devend_29def6b7:

    # "Что-то промелькнуло в оконных проёмах обугленного сельмага."
    "Нешта прамільгнула ў аконных праёмах абвугленага сельмага."

# game/scripts/scene/scene_day_4.rpy:19811
translate belarusian d4_wake_up_devend_f555d830:

    # "Я побежал прочь от закопчённого фасада."
    "Я пабег прэч ад закапцелага фасада."

# game/scripts/scene/scene_day_4.rpy:19815
translate belarusian d4_wake_up_devend_e464d36d:

    # "За колодцем утробно зарычало."
    "За калодзежам нутрана зарычала."

# game/scripts/scene/scene_day_4.rpy:19816
translate belarusian d4_wake_up_devend_239747bb:

    # "Я ускорился, стараясь не замечать тьмы во дворах, в кровавых собачьих будках, в покосившихся сараях."
    "Я паскорыўся, стараючыся не заўважаць цемры ў дварах, у крывавых сабачых будках, у пахіленых хлявах."

# game/scripts/scene/scene_day_4.rpy:19817
translate belarusian d4_wake_up_devend_1fa3da8c:

    # "Луна показалась из-за облаков."
    "Месяц паказаўся з-за хмар."

# game/scripts/scene/scene_day_4.rpy:19818
translate belarusian d4_wake_up_devend_82fec4c0:

    # "В изнуряющей тишине что-то пронеслось над головой."
    "У знясільнай цішыні нешта пранеслася над галавой."

# game/scripts/scene/scene_day_4.rpy:19826
translate belarusian d4_wake_up_devend_774d5484:

    # "Словно кукурузник перелетел с кровли на кровлю. Меня накрыла огромная тень."
    "Быццам кукурузнік пераляцеў са страхі на страху. Мяне накрыў вялізны цень."

# game/scripts/scene/scene_day_4.rpy:19827
translate belarusian d4_wake_up_devend_23e91c6a:

    # "Я рванул направо в надежде, что меня не заметили."
    "Я рвануў направа ў надзеі, што мяне не заўважылі."

# game/scripts/scene/scene_day_4.rpy:19830
translate belarusian d4_wake_up_devend_85b854b7:

    # "Небольшой зелёный дом впереди — моё убежище."
    "Невялікі зялёны дом наперадзе — мой прытулак."

# game/scripts/scene/scene_day_4.rpy:19835
translate belarusian d4_wake_up_devend_e522e3dd:

    # "Сходя с ума от страха, я рванул к ближайшей избе. Вот где я найду убежище!"
    "Вар'яцеючы ад страху, я рвануў да найбліжэйшай хаты. Вось дзе я знайду прытулак!"

# game/scripts/scene/scene_day_4.rpy:19836
translate belarusian d4_wake_up_devend_a5790e6a:

    # "В глаза не сразу бросилось, что это был дом Полины, где сегодня днём она молила меня в истерике остаться."
    "У вочы не адразу кінулася, што гэта быў дом Паліны, дзе сёння ўдзень яна маліла мяне ў істэрыцы застацца."

# game/scripts/scene/scene_day_4.rpy:19838
translate belarusian d4_wake_up_devend_1b97b0a3:

    # "Сходя с ума от страха, я рванул к ближайшей избе."
    "Вар'яцеючы ад страху, я рвануў да найбліжэйшай хаты."

# game/scripts/scene/scene_day_4.rpy:19853
translate belarusian d4_wake_up_devend_2ff418ac:

    # "Я толкнул калитку и пригнувшись, засеменил к крыльцу."
    "Я штурхнуў брамку і, прыгнуўшыся, дробнымі крокамі пабег да ганка."

# game/scripts/scene/scene_day_4.rpy:19868
translate belarusian d4_wake_up_devend_4e7e05dc:

    # "Дёрнул за ручку. Двери оказались не заперты."
    "Тузануў за ручку. Дзверы аказаліся незамкнёнымі."

# game/scripts/scene/scene_day_4.rpy:19909
translate belarusian d4_wake_up_devend_100cb105:

    # "Инвалидное кресло выехало из темноты, едва не задев меня, покатилось, стуча колёсами по ступенькам, и застыло у яблони."
    "Інваліднае крэсла выехала з цемры, ледзь не зачапіўшы мяне, пакацілася, стукаючы коламі па прыступках, і застыла каля яблыні."

# game/scripts/scene/scene_day_4.rpy:19910
translate belarusian d4_wake_up_devend_34e45cd9:

    # "Я проводил его округлившимися глазами. Снова посмотрел в дом."
    "Я правёў яго акругленымі вачыма. Зноў паглядзеў у дом."

# game/scripts/scene/scene_day_4.rpy:19911
translate belarusian d4_wake_up_devend_a2b73e19:

    # "Коридор терялся во мраке. Пустые рамы на стенах. Стекло на полу."
    "Калідор губляўся ў змроку. Пустыя рамы на сценах. Шкло на падлозе."

# game/scripts/scene/scene_day_4.rpy:19912
translate belarusian d4_wake_up_devend_88aee1a0:

    # voice "voice/anton/4day/229. Est.ogg"
    # Ant "Есть тут кто?"
    voice "voice/anton/4day/229. Est.ogg"
    Ant "Ёсць тут хто?"

# game/scripts/scene/scene_day_4.rpy:19934
translate belarusian d4_wake_up_devend_54e52a0e:

    # "Ответом было рычание."
    "Адказам было рычанне."

# game/scripts/scene/scene_day_4.rpy:19941
translate belarusian d4_wake_up_devend_93aa12f4:

    # "Из-за угла в конце коридора высунулась косматая лапа, а следом — страшная морда с горящими глазами."
    "З-за вугла ў канцы калідора высунулася калматая лапа, а следам — страшная пыса з вачыма, што палалі."

# game/scripts/scene/scene_day_4.rpy:19960
translate belarusian d4_wake_up_devend_6d398adf:

    # "Огромный разожравшийся зверь выполз на брюхе, извиваясь, как гадюка. Он едва вмещался в коридорное жерло."
    "Вялізны распасены звер выпаўз на бруху, звіваючыся, як гадзюка. Ён ледзь змяшчаўся ў калідорнае жарало."

# game/scripts/scene/scene_day_4.rpy:19961
translate belarusian d4_wake_up_devend_aff6d299:

    # "Протискивался, скобля когтями половицы."
    "Праціскваўся, скрабучы кіпцюрамі масніцы."

# game/scripts/scene/scene_day_4.rpy:19966
translate belarusian d4_wake_up_devend_b04dce9a:

    # "Челюсти клацнули капканом в сантиметре от моего лица."
    "Сківіцы клацнулі капканам за сантыметр ад майго твару."

# game/scripts/scene/scene_day_4.rpy:19967
translate belarusian d4_wake_up_devend_fe4a7e3c:

    # "Чудовище застряло в проходе."
    "Пачвара захрасла ў праходзе."

# game/scripts/scene/scene_day_4.rpy:19973
translate belarusian d4_wake_up_devend_9637991f:

    # "Лапы били по стенам, слюна брызгала из пасти."
    "Лапы білі па сценах, сліна пырскала з пашчы."

# game/scripts/scene/scene_day_4.rpy:19993
translate belarusian d4_wake_up_devend_ad5b4acb:

    # "Я развернулся — уносить ноги из кошмара!"
    "Я развярнуўся — выносіць ногі з кашмару!"

# game/scripts/scene/scene_day_4.rpy:20022
translate belarusian d4_wake_up_devend_05bd5442:

    # "Горбатый филин — крупнее взрослого человека — приземлился у калитки, закрывая дорогу. Клюв щёлкал неустанно."
    "Гарбаты пугач — буйнейшы за дарослага чалавека — прызямліўся каля брамкі, загароджваючы дарогу. Дзюба шчоўкала няспынна."

# game/scripts/scene/scene_day_4.rpy:20033
translate belarusian d4_wake_up_devend_dbcede49:

    # "Сбоку вспучился сугроб, и нечто, похожее на гигантскую землеройку, полезло наружу."
    "Збоку ўспучылася гурба, і нешта, падобнае да гіганцкай землярыйкі, палезла вонкі."

# game/scripts/scene/scene_day_4.rpy:20039
translate belarusian d4_wake_up_devend_80f555d4:

    # "Я упал на колени, словно молился этим древним созданиям."
    "Я ўпаў на калені, быццам маліўся гэтым старажытным стварэнням."

# game/scripts/scene/scene_day_4.rpy:20044
translate belarusian d4_wake_up_devend_b98a2c92:

    # "Из тёмной норы выползла скалящаяся в улыбке тварь, драпированная грязным лисьим мехом."
    "З цёмнай нары выпаўзла ашчэраная ва ўсмешцы пачвара, драпіраваная брудным лісіным футрам."

# game/scripts/scene/scene_day_4.rpy:20053
translate belarusian d4_wake_up_devend_2e6eea9e:

    # "Её хвост — лишь позвоночник в ошмётках сухожилий — волочился сзади."
    "Яе хвост — толькі пазваночнік у шматках сухажылляў — валачыўся ззаду."

# game/scripts/scene/scene_day_4.rpy:20101
translate belarusian d4_wake_up_devend_de2b4964:

    # "Тела существ ужасно исказились, и я решил, что схожу с ума."
    "Целы істот жудасна сказіліся, і я вырашыў, што вар'яцею."

# game/scripts/scene/scene_day_4.rpy:20120
translate belarusian d4_wake_up_devend_f224fe36:

    # "Они то казались мне маленькими, размером с ребёнка, то вытягивались выше любой опустевшей избы."
    "Яны то здаваліся мне маленькімі, памерам з дзіця, то выцягваліся вышэй за любую апусцелую хату."

# game/scripts/scene/scene_day_4.rpy:20121
translate belarusian d4_wake_up_devend_4ed39e21:

    # "Людоеды нависли надо мной, а в их чревах непрерывно что-то копошилось, как будто искало выход наружу."
    "Людажэры навіслі нада мной, а ў іх чэравах няспынна нешта капашылася, нібыта шукала выхад вонкі."

# game/scripts/scene/scene_day_4.rpy:20122
translate belarusian d4_wake_up_devend_050144a9:

    # "И чем дольше они взирали на меня, тем шире становились их перекошенные улыбки, их лики смерти."
    "І чым даўжэй яны пазіралі на мяне, тым шырэйшымі станавіліся іх перакошаныя ўсмешкі, іх абліччы смерці."

# game/scripts/scene/scene_day_4.rpy:20139
translate belarusian d4_wake_up_devend_d841615f:

    # voice "voice/Alisa/4day/113 Kak.ogg"
    # Alis "Как же славно мы пировали!"
    voice "voice/Alisa/4day/113 Kak.ogg"
    Alis "Як жа слаўна мы балявалі!"

# game/scripts/scene/scene_day_4.rpy:20142
translate belarusian d4_wake_up_devend_d3e9efd3:

    # "Изуродованное чучело лисы облизнулось."
    "Знявечанае пудзіла лісы аблізнулася."

# game/scripts/scene/scene_day_4.rpy:20147
translate belarusian d4_wake_up_devend_7ab71cdb:

    # "Язык показался мне чёрной сколопендрой, длиннее моего предплечья."
    "Язык здаўся мне чорнай скалапендрай, даўжэйшай за маё перадплечча."

# game/scripts/scene/scene_day_4.rpy:20155
translate belarusian d4_wake_up_devend_a574b151:

    # "Мерзкое насекомое пробежало между бритвенно-острыми зубами и провалилось в бездонную пасть, способную проглотить весь мир."
    "Агіднае насякомае прабегла паміж вострымі, як брытва, зубамі і правалілася ў бяздонную пашчу, здольную праглынуць увесь свет."

# game/scripts/scene/scene_day_4.rpy:20174
translate belarusian d4_wake_up_devend_84ba963f:

    # voice "voice/Owl/4day/Sladkoe.ogg"
    # Owl "Ух-ху-ху, сладкое мясо, сочное мясо."
    voice "voice/Owl/4day/Sladkoe.ogg"
    Owl "Ух-ху-ху, салодкае мяса, сакавітае мяса."

# game/scripts/scene/scene_day_4.rpy:20194
translate belarusian d4_wake_up_devend_1a4478ad:

    # voice "voice/Bear/4day/55kak.ogg"
    # Bear "Как пожирали, так и будем впредь."
    voice "voice/Bear/4day/55kak.ogg"
    Bear "Як пажыралі, так і будзем надалей."

# game/scripts/scene/scene_day_4.rpy:20225
translate belarusian d4_wake_up_devend_f18b01ec:

    # voice "voice/Bear/4day/56 Vahaha.ogg" 
    # Bear "Ба-ха-ха-ха!"
    voice "voice/Bear/4day/56 Vahaha.ogg" 
    Bear "Ба-ха-ха-ха!"

# game/scripts/scene/scene_day_4.rpy:20228
translate belarusian d4_wake_up_devend_9bfefbc8:

    # "В их речи не было ничего человеческого — лишь звериный рык да птичий свист."
    "У іх гаворцы не было нічога чалавечага — толькі звярыны рык ды птушыны свіст."

# game/scripts/scene/scene_day_4.rpy:20230
translate belarusian d4_wake_up_devend_bfde5f6a:

    # "Но я понимал каждое слово, как если бы мы говорили на одном языке."
    "Але я разумеў кожнае слова, быццам мы размаўлялі на адной мове."

# game/scripts/scene/scene_day_4.rpy:20236
translate belarusian d4_wake_up_devend_ce8bd162:

    # voice "voice/Alisa/4day/114 Kakzal.ogg"
    # Alis "Как жаль, что ты не поспел за нами, Зайчик."
    voice "voice/Alisa/4day/114 Kakzal.ogg"
    Alis "Як шкада, што ты не паспеў за намі, Зайчык."

# game/scripts/scene/scene_day_4.rpy:20238
translate belarusian d4_wake_up_devend_68edb37f:

    # voice "voice/Alisa/4day/115 Nesm.ogg"
    # Alis "Не смог укусить Луну."
    voice "voice/Alisa/4day/115 Nesm.ogg"
    Alis "Не змог укусіць Месяц."

# game/scripts/scene/scene_day_4.rpy:20245
translate belarusian d4_wake_up_devend_4ecff3f3:

    # voice "voice/anton/4day/Viobedale.ogg"
    # Bunny "Вы объедали меня! Предатели! "
    voice "voice/anton/4day/Viobedale.ogg"
    Bunny "Вы аб'ядалі мяне! Здраднікі! "

# game/scripts/scene/scene_day_4.rpy:20252
translate belarusian d4_wake_up_devend_b4a08618:

    # voice "voice/Alisa/4day/26 T.ogg"
    # Alis "Ты сам не захотел есть свою семью."
    voice "voice/Alisa/4day/26 T.ogg"
    Alis "Ты сам не захацеў есці сваю сям'ю."

# game/scripts/scene/scene_day_4.rpy:20261
translate belarusian d4_wake_up_devend_4b965a58:

    # voice "voice/anton/4day/No.ogg"
    # Bunny "Но..."
    voice "voice/anton/4day/No.ogg"
    Bunny "Але..."

# game/scripts/scene/scene_day_4.rpy:20270
translate belarusian d4_wake_up_devend_eb18b181:

    # voice "voice/Owl/4day/Zalk.ogg"
    # Owl "Ух-ху-ху, жалкое мясо! Никчёмное мясо!"
    voice "voice/Owl/4day/Zalk.ogg"
    Owl "Ух-ху-ху, жалю годнае мяса! Нікчэмнае мяса!"

# game/scripts/scene/scene_day_4.rpy:20275
translate belarusian d4_wake_up_devend_6425b0f4:

    # voice "voice/Bear/4day/57 Kak.ogg"
    # Bear "Как ты ничтожен, братец."
    voice "voice/Bear/4day/57 Kak.ogg"
    Bear "Які ты мізэрны, братка."

# game/scripts/scene/scene_day_4.rpy:20277
translate belarusian d4_wake_up_devend_e0071985:

    # voice "voice/Bear/4day/58 Men.ogg"
    # Bear "Меня от тебя тошнит."
    voice "voice/Bear/4day/58 Men.ogg"
    Bear "Мяне ад цябе ванітуе."

# game/scripts/scene/scene_day_4.rpy:20309
translate belarusian d4_wake_up_devend_6d419ed4:

    # voice "voice/Wolf/339 Pzorr.ogg"
    # Wolf "Позор-р-р! Позор-р-р!"
    voice "voice/Wolf/339 Pzorr.ogg"
    Wolf "Сор-р-рам! Сор-р-рам!"

# game/scripts/scene/scene_day_4.rpy:20354
translate belarusian d4_wake_up_devend_7c8ba111:

    # "Неописуемый ужас объял меня, когда хохочущие звери потянули ко мне свои когтистые лапы."
    "Неапісальны жах ахапіў мяне, калі звяры, рагочучы, пацягнулі да мяне свае кіпцюрыстыя лапы."

# game/scripts/scene/scene_day_4.rpy:20356
translate belarusian d4_wake_up_devend_0d855b25:

    # "Как вдруг нечто, притворяющееся лисой, громко залаяло:"
    "Як раптам нешта, што прыкідвалася лісой, гучна забрахала:"

# game/scripts/scene/scene_day_4.rpy:20361
translate belarusian d4_wake_up_devend_978d76b9:

    # voice "voice/Alisa/4day/116 Glup.ogg"
    # Alis "Глупцы! Его черёд нести угощения."
    voice "voice/Alisa/4day/116 Glup.ogg"
    Alis "Дурні! Яго чарга несці пачастункі."

# game/scripts/scene/scene_day_4.rpy:20371
translate belarusian d4_wake_up_devend_f7a92ccd:

    # voice "voice/Wolf/341 Darmo.ogg"
    # Wolf "Дар-р-рмоед!"
    voice "voice/Wolf/341 Darmo.ogg"
    Wolf "Дар-р-рмаед!"

# game/scripts/scene/scene_day_4.rpy:20376
translate belarusian d4_wake_up_devend_6b180c7e:

    # voice "voice/Owl/4day/Espolnit.ogg"
    # Owl "Ух-ху-ху, пусть исполнит предназначение!"
    voice "voice/Owl/4day/Espolnit.ogg"
    Owl "Ух-ху-ху, няхай споўніць прызначэнне!"

# game/scripts/scene/scene_day_4.rpy:20381
translate belarusian d4_wake_up_devend_70213413:

    # voice "voice/Alisa/4day/117 KZ.ogg"
    # Alis "К завтрашней ночи ждём мясца, а иначе..."
    voice "voice/Alisa/4day/117 KZ.ogg"
    Alis "Да заўтрашняй ночы чакаем мяска, а інакш..."

# game/scripts/scene/scene_day_4.rpy:20386
translate belarusian d4_wake_up_devend_16fcb524:

    # voice "voice/Owl/4day/Enache.ogg"
    # Owl "...иначе..." id d4_wake_up_devend_16fcb524
    voice "voice/Owl/4day/Enache.ogg"
    Owl "...інакш..."

# game/scripts/scene/scene_day_4.rpy:20391
translate belarusian d4_wake_up_devend_d3234aa7:

    # voice "voice/Bear/4day/59 Enache.ogg"
    # Bear "...иначе..." id d4_wake_up_devend_d3234aa7
    voice "voice/Bear/4day/59 Enache.ogg"
    Bear "...інакш..."

# game/scripts/scene/scene_day_4.rpy:20402
translate belarusian d4_wake_up_devend_858b4f79:

    # voice "voice/Wolf/342 Enache.ogg"
    # Wolf "...иначе..." id d4_wake_up_devend_858b4f79
    voice "voice/Wolf/342 Enache.ogg"
    Wolf "...інакш..."

# game/scripts/scene/scene_day_4.rpy:20417
translate belarusian d4_wake_up_devend_567d2de3:

    # voice "voice/Alisa/4day/118 Ena.ogg"
    # Alis "...иначе мы съедим всю твою семью!" id d4_wake_up_devend_567d2de3
    voice "voice/Alisa/4day/118 Ena.ogg"
    Alis "...інакш мы з'ядзім усю тваю сям'ю!"

# game/scripts/scene/scene_day_4.rpy:20444
translate belarusian d4_wake_up_devend_fe15ae9b:

    # "Монстры образовали вокруг меня кольцо и завертелись в хороводе."
    "Монстры ўтварылі вакол мяне кола і закруціліся ў карагодзе."

# game/scripts/scene/scene_day_4.rpy:20456
translate belarusian d4_wake_up_devend_438cd1fe:

    # "Я закричал."
    "Я закрычаў."

# game/scripts/scene/scene_day_4.rpy:20462
translate belarusian d4_wake_up_devend_64696460:

    # "Мелькали глазища, клыки, когти, сливались в вереницу пятен и клякс."
    "Мільгалі вачышчы, іклы, кіпцюры, зліваліся ў чараду плям і кляксаў."

# game/scripts/scene/scene_day_4.rpy:20463
translate belarusian d4_wake_up_devend_7a66fd90:

    # voice  "voice/Alisa/4day/HorRaz.ogg"
    # Chorus "Раз-два, прилети сова."
    voice  "voice/Alisa/4day/HorRaz.ogg"
    Chorus "Раз-два, прыляці сава."

# game/scripts/scene/scene_day_4.rpy:20465
translate belarusian d4_wake_up_devend_9de4f08f:

    # voice "voice/Alisa/4day/HorTri.ogg"
    # Chorus "Три-четыре-пять, время поиграть."
    voice "voice/Alisa/4day/HorTri.ogg"
    Chorus "Тры-чатыры-пяць, час нам пагуляць."

# game/scripts/scene/scene_day_4.rpy:20467
translate belarusian d4_wake_up_devend_30a4ca58:

    # voice "voice/Alisa/4day/HorShest.ogg"
    # Chorus "Шесть да шесть, дыбом волчья шерсть."
    voice "voice/Alisa/4day/HorShest.ogg"
    Chorus "Шэсць ды шэсць, дыбам воўчая поўсць."

# game/scripts/scene/scene_day_4.rpy:20469
translate belarusian d4_wake_up_devend_157c9fcf:

    # voice "voice/Alisa/4day/HorSem.ogg"
    # Chorus "Семь-восемь, бьём копытом оземь."
    voice "voice/Alisa/4day/HorSem.ogg"
    Chorus "Сем-восем, б'ём капытам аб зем."

# game/scripts/scene/scene_day_4.rpy:20483
translate belarusian d4_wake_up_devend_451c73d2:

    # "Морда лисы вылезла из мельтешащих пятен, в которые превратились туши зверей:"
    "Пыса лісы вылезла з мільготкіх плям, у якія ператварыліся тушы звяроў:"

# game/scripts/scene/scene_day_4.rpy:20484
translate belarusian d4_wake_up_devend_e0c0598b:

    # voice "voice/Alisa/4day/119 Dlya.ogg"
    # Alis "Для медведя, для лисы..."
    voice "voice/Alisa/4day/119 Dlya.ogg"
    Alis "Для мядзведзя, для лісы..."

# game/scripts/scene/scene_day_4.rpy:20486
translate belarusian d4_wake_up_devend_94a9ebb5:

    # voice "voice/Alisa/4day/119 Zaich.ogg"
    # Alis "Зайчик, кушать принеси!"
    voice "voice/Alisa/4day/119 Zaich.ogg"
    Alis "Зайчык, есці прынясі!"

# game/scripts/scene/scene_day_4.rpy:20498
translate belarusian d4_wake_up_devend_1af0a61a:

    # "Вопль отчаянья — мой вопль — загудел по закоулкам вымершего посёлка:"
    "Лямант адчаю — мой лямант — загудзеў па закавулках вымерлага пасёлка:"

# game/scripts/scene/scene_day_4.rpy:20499
translate belarusian d4_wake_up_devend_4ced1c03:

    # voice "voice/anton/4day/231.Prinesu.ogg"
    # Ant "Принесу, принесу, принесу!"
    voice "voice/anton/4day/231.Prinesu.ogg"
    Ant "Прынясу, прынясу, прынясу!"

# game/scripts/scene/scene_day_4.rpy:20508
translate belarusian d4_wake_up_devend_7f4b675f:

    # "Круг разомкнулся — и я бросился наутёк."
    "Кола разамкнулася — і я кінуўся наўцёкі."

# game/scripts/scene/scene_day_4.rpy:20536
translate belarusian d4_wake_up_devend_2554faca:

    # "{sc=1}Будто нёсся в охотничьи силки. Моя голова трещала, в ней танцевали, врезаясь друг в друга, падая,\nподнимаясь, снова пускаясь в пляс уродливые образы.{/sc}"
    "{sc=1}Быццам нёсся ў паляўнічыя сілкі. Мая галава трашчала, у ёй танцавалі, уразаючыся адзін у аднаго, падаючы,\nпадымаючыся, зноў пускаючыся ў скокі пачварныя вобразы.{/sc}"

# game/scripts/scene/scene_day_4.rpy:20556
translate belarusian d4_wake_up_devend_4be07d7e:

    # "{sc=10}Раз-два...{/sc}"
    "{sc=10}Раз-два...{/sc}"

# game/scripts/scene/scene_day_4.rpy:20557
translate belarusian d4_wake_up_devend_93d30539:

    # "{sc=3}Взмахивали крыльями, лезли мне в лицо клювами и слюнявыми пастями.{/sc}"
    "{sc=3}Узмахвалі крыламі, лезлі мне ў твар дзюбамі і слінявымі пашчамі.{/sc}"

# game/scripts/scene/scene_day_4.rpy:20577
translate belarusian d4_wake_up_devend_1b11f2c5:

    # "{sc=10}Три-четыре...{/sc}"
    "{sc=10}Тры-чатыры...{/sc}"

# game/scripts/scene/scene_day_4.rpy:20578
translate belarusian d4_wake_up_devend_13f451a0:

    # "{sc=3}Орали и прыгали, так, что кровь вот-вот пойдёт из ушей: от грохота и криков или от внутреннего\nдавления, раскалывающего череп.{/sc}"
    "{sc=3}Гарлалі і скакалі так, што кроў вось-вось пойдзе з вушэй: ад грукату і крыкаў ці ад унутранага\nціску, які расколвае чэрап.{/sc}"

# game/scripts/scene/scene_day_4.rpy:20599
translate belarusian d4_wake_up_devend_1c7aa597:

    # "{sc=10}Пять-шесть...{/sc}"
    "{sc=10}Пяць-шэсць...{/sc}"

# game/scripts/scene/scene_day_4.rpy:20600
translate belarusian d4_wake_up_devend_826e0dd1:

    # "{sc=3}Шапка сбилась на глаза, отчего казалось, что небо скособочилось, будто готовая рухнуть крыша.{/sc}"
    "{sc=3}Шапка збілася на вочы, ад чаго здавалася, што неба скасабочылася, быццам гатовы абрынуцца дах.{/sc}"

# game/scripts/scene/scene_day_4.rpy:20620
translate belarusian d4_wake_up_devend_279de400:

    # "{sc=10}Семь-восемь...{/sc}"
    "{sc=10}Сем-восем...{/sc}"

# game/scripts/scene/scene_day_4.rpy:20621
translate belarusian d4_wake_up_devend_bc437a53:

    # "{sc=3}Снег, как побелка, сыпался сверху.{/sc}"
    "{sc=3}Снег, як пабелка, сыпаўся зверху.{/sc}"

# game/scripts/scene/scene_day_4.rpy:20663
translate belarusian d4_wake_up_devend_68cf6b29:

    # "{sc=5}Преследуемый стаей, я бежал по пустым улицам, по окоченевшему миру.{/sc}"
    "{sc=5}Гнаны зграяй, я бег па пустых вуліцах, па акалелым свеце.{/sc}"

# game/scripts/scene/scene_day_4.rpy:20664
translate belarusian d4_wake_up_devend_3c49cce9:

    # "{sc=3}Оглядывался и никого не видел за спиной.{/sc}"
    "{sc=3}Азіраўся і нікога не бачыў за спінай.{/sc}"

# game/scripts/scene/scene_day_4.rpy:20709
translate belarusian d4_wake_up_devend_1ad5505c:

    # "{sc=5}Зажмуривался и шарахался от их ритуальных плясок в моём пылающем сознании.{/sc}"
    "{sc=5}Зажмурваўся і шарахаўся ад іх рытуальных скокаў у маёй свядомасці, што палала.{/sc}"

# game/scripts/scene/scene_day_4.rpy:20808
translate belarusian d4_wake_up_devend_c79d0687:

    # "{sc=5}Прижал ладони к ушам, чтобы заглушить шум.{/sc}"
    "{sc=5}Прыціснуў далоні да вушэй, каб заглушыць шум.{/sc}"

# game/scripts/scene/scene_day_4.rpy:20812
translate belarusian d4_wake_up_devend_1bfa6818:

    # "{sc=3}Чтобы голова не развалилась.{/sc}"
    "{sc=3}Каб галава не развалілася.{/sc}"

# game/scripts/scene/scene_day_4.rpy:20824
translate belarusian d4_wake_up_devend_775cd18a:

    # "Рассвет я встретил в дебрях леса."
    "Світанак я сустрэў у нетрах лесу."
