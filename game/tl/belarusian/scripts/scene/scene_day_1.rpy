# game/scripts/scene/scene_day_1.rpy:4302
translate belarusian staruha1_91d43b2c:

    # "Взбесившийся телевизор закольцевал последнее слово диктора, оно повторялось опять и опять, впивалось в уши."
    "Ашалелы тэлевізар закальцаваў апошняе слова дыктара, яно паўтаралася зноў і зноў, упівалася ў вушы."

# game/scripts/scene/scene_day_1.rpy:4317
translate belarusian staruha1_38917f01:

    # "По спине бежали мурашки."
    "Па спіне беглі мурашкі."

# game/scripts/scene/scene_day_1.rpy:4322
translate belarusian staruha1_3bab20a9:

    # "Кассета закончилась и теперь перематывалась к началу."
    "Касета скончылася і цяпер перамотвавалася да пачатку."

# game/scripts/scene/scene_day_1.rpy:4323
translate belarusian staruha1_ed58293f:

    # "Шорох плёнки напоминал шелест листвы на ветру и тихое рычание зверя."
    "Шоргат плёнкі нагадваў шэлест лістоты на ветры і ціхае рыканне звера."

# game/scripts/scene/scene_day_1.rpy:4324
translate belarusian staruha1_53afe686:

    # "Я вышел из ступора, ткнул пальцем в кнопку."
    "Я выйшаў са ступару, тыцнуў пальцам у кнопку."

# game/scripts/scene/scene_day_1.rpy:4328
translate belarusian staruha1_44dde67d:

    # "Магнитофон выплюнул кассету – на миг почудилось, что она испачкана в слюнях."
    "Магнітафон выплюнуў касету — на імгненне здалося, што яна запэцканая ў слінах."

# game/scripts/scene/scene_day_1.rpy:4329
translate belarusian staruha1_5eeedd75:

    # "Но это лишь свет люстры заставлял чёрный пластик переливаться."
    "Але гэта толькі святло люстры прымушала чорны пластык пералівацца."

# game/scripts/scene/scene_day_1.rpy:4333
translate belarusian staruha1_0e9459fe:

    # "И тут я заметил обложку."
    "І тут я заўважыў вокладку."

# game/scripts/scene/scene_day_1.rpy:4334
translate belarusian staruha1_4ce74a47:

    # "Ёлки! Я же на «Питера Пэна» записал!"
    "Ёлкі! Я ж на «Пітэра Пэна» запісаў!"

# game/scripts/scene/scene_day_1.rpy:4335
translate belarusian staruha1_d431cb1a:

    # "Поторопился."
    "Паспяшаўся."

# game/scripts/scene/scene_day_1.rpy:4336
translate belarusian staruha1_42bb60a2:

    # "Мало того, что испортил Олин мультфильм, так ещё и такой жутью."
    "Мала таго, што сапсаваў Олін мультфільм, дык яшчэ і такой жудасцю."

# game/scripts/scene/scene_day_1.rpy:4337
translate belarusian staruha1_1b990135:

    # "Нельзя, чтобы сестра это увидела. Слёз будет – океан."
    "Нельга, каб сястра гэта ўбачыла. Слёз будзе — акіян."

# game/scripts/scene/scene_day_1.rpy:4343
translate belarusian staruha1_868b716e:

    # "Я украдкой посмотрел на дверь."
    "Я крадком паглядзеў на дзверы."

# game/scripts/scene/scene_day_1.rpy:4344
translate belarusian staruha1_d54fe912:

    # "В коридоре задребезжали стаканы, скрипнули половицы."
    "У калідоры задрынчалі шклянкі, рыпнулі масніцы."

# game/scripts/scene/scene_day_1.rpy:4349
translate belarusian staruha1_9be6a57c:

    # "Оля материализовалась в дверном проёме."
    "Оля матэрыялізавалася ў дзвярным праёме."

# game/scripts/scene/scene_day_1.rpy:4351
translate belarusian staruha1_b5ce6583:

    # voice "voice/olya/67 O.ogg"
    # Oly "Ты не смотришь без меня?"
    voice "voice/olya/67 O.ogg"
    Oly "Ты не глядзіш без мяне?"

# game/scripts/scene/scene_day_1.rpy:4356
translate belarusian staruha1_08ef4c3b:

    # "В руках у сестры был поднос с неровно нарезанным хлебом и целой банкой сгущёнки."
    "У руках у сястры быў паднос з няроўна нарэзаным хлебам і цэлай бляшанкай згушчонкі."

# game/scripts/scene/scene_day_1.rpy:4357
translate belarusian staruha1_0c88b13d:

    # voice "voice/anton/1day/076. Em net.ogg"
    # Ant "Эм, нет..."
    voice "voice/anton/1day/076. Em net.ogg"
    Ant "Эм, не..."

# game/scripts/scene/scene_day_1.rpy:4359
translate belarusian staruha1_06f9c0a2:

    # voice "voice/anton/1day/076. Ya poka.ogg"
    # Ant "Я пока кассету ищу."
    voice "voice/anton/1day/076. Ya poka.ogg"
    Ant "Я пакуль касету шукаю."

# game/scripts/scene/scene_day_1.rpy:4361
translate belarusian staruha1_73c4fbbd:

    # voice "voice/anton/1day/077. A ti tochno.ogg"
    # Ant "А ты точно хочешь «Питера Пэна» смотреть?"
    voice "voice/anton/1day/077. A ti tochno.ogg"
    Ant "А ты дакладна хочаш «Пітэра Пэна» глядзець?"

# game/scripts/scene/scene_day_1.rpy:4369
translate belarusian staruha1_1f887c01:

    # voice "voice/olya/77 O.ogg"
    # Oly "Хочу-хочу!"
    voice "voice/olya/77 O.ogg"
    Oly "Хачу-хачу!"

# game/scripts/scene/scene_day_1.rpy:4371
translate belarusian staruha1_cd7ec80c:

    # voice "voice/olya/78 O.ogg"
    # Oly "Включай скорее, а то мама скоро сядет свой бразильский сериал смотреть."
    voice "voice/olya/78 O.ogg"
    Oly "Уключай хутчэй, а то мама хутка сядзе свой бразільскі серыял глядзець."

# game/scripts/scene/scene_day_1.rpy:4376
translate belarusian staruha1_a1e871f5:

    # "Ну же, думай, горе-сыщик."
    "Ну ж бо, думай, гора-сышчык."

# game/scripts/scene/scene_day_1.rpy:4378
translate belarusian staruha1_b3b2ca7a:

    # voice "voice/anton/1day/078. Chestno mne.ogg"
    # Ant "Честно, мне как-то «Питер Пэн» совсем не понравился."
    voice "voice/anton/1day/078. Chestno mne.ogg"
    Ant "Шчыра, мне неяк «Пітэр Пэн» зусім не спадабаўся."

# game/scripts/scene/scene_day_1.rpy:4380
translate belarusian staruha1_b6e6913f:

    # voice "voice/anton/1day/078. Mozet luche.ogg"
    # Ant "Может, лучше «Русалочку»?"
    voice "voice/anton/1day/078. Mozet luche.ogg"
    Ant "Можа, лепш «Русалачку»?"

# game/scripts/scene/scene_day_1.rpy:4386
translate belarusian staruha1_dd920f8f:

    # voice "voice/olya/79 O.ogg"
    # Oly "«Русалочку» я уже насмотрелась."
    voice "voice/olya/79 O.ogg"
    Oly "«Русалачку» я ўжо наглядзелася."

# game/scripts/scene/scene_day_1.rpy:4392
translate belarusian staruha1_9dde161c:

    # voice "voice/olya/80 O.ogg"
    # Oly "А ты обещал!"
    voice "voice/olya/80 O.ogg"
    Oly "А ты абяцаў!"

# game/scripts/scene/scene_day_1.rpy:4398
translate belarusian staruha1_8856d89c:

    # "Вот до чего ж упрямая."
    "Вось да чаго ж упартая."

# game/scripts/scene/scene_day_1.rpy:4399
translate belarusian staruha1_e2a87a01:

    # voice "voice/anton/1day/079. Pridumal davai.ogg"
    # Ant "Придумал! Давай сначала пару серий «Черепашек-ниндзя», согласна?"
    voice "voice/anton/1day/079. Pridumal davai.ogg"
    Ant "Прыдумаў! Давай спачатку пару серый «Чарапашак-ніндзя», згодна?"

# game/scripts/scene/scene_day_1.rpy:4401
translate belarusian staruha1_11b67096:

    # "Оля насупила брови, но, похоже, сдалась."
    "Оля насупіла бровы, але, падобна, здалася."

# game/scripts/scene/scene_day_1.rpy:4402
translate belarusian staruha1_a99f2ef6:

    # "Она отставила поднос и демонстративно скрестила руки на груди."
    "Яна адставіла паднос і дэманстратыўна скрыжавала рукі на грудзях."

# game/scripts/scene/scene_day_1.rpy:4407
translate belarusian staruha1_dba5325d:

    # voice "voice/olya/81 O.ogg"
    # Oly "Если так сильно просишь..."
    voice "voice/olya/81 O.ogg"
    Oly "Калі так моцна просіш..."

# game/scripts/scene/scene_day_1.rpy:4409
translate belarusian staruha1_85175668:

    # voice "voice/olya/82 O.ogg"
    # Oly "Откроешь сгущёнку? Порезаться боюсь — края острые..."
    voice "voice/olya/82 O.ogg"
    Oly "Адкрыеш згушчонку? Парэзацца баюся — краі вострыя..."

# game/scripts/scene/scene_day_1.rpy:4417
translate belarusian staruha1_4ada3618:

    # "Стоило подняться, как перед глазами запрыгали разноцветные точки, а онемевшие ноги закололо иголочками."
    "Варта было падняцца, як перад вачыма заскакалі рознакаляровыя кропкі, а знямелыя ногі закалола іголачкамі."

# game/scripts/scene/scene_day_1.rpy:4418
translate belarusian staruha1_8cdadb27:

    # "И только добравшись до дивана, я сообразил, что банка была уже открыта."
    "І толькі дабраўшыся да канапы, я сцяміў, што бляшанка была ўжо адкрыта."

# game/scripts/scene/scene_day_1.rpy:4419
translate belarusian staruha1_66be10ff:

    # "Оля схитрила, обвела меня вокруг пальца."
    "Оля схітравала, абвяла мяне вакол пальца."

# game/scripts/scene/scene_day_1.rpy:4423
translate belarusian staruha1_1c08f12e:

    # "Под ложечкой засосало."
    "Пад лыжачкай засмактала."

# game/scripts/scene/scene_day_1.rpy:4430
translate belarusian staruha1_4af10802:

    # "Я намеревался рвануть к телевизору, но сестра опередила."
    "Я намерваўся ірвануць да тэлевізара, але сястра апярэдзіла."

# game/scripts/scene/scene_day_1.rpy:4431
translate belarusian staruha1_1a3faae6:

    # "Схватив пульт, она победоносно рассмеялась:"
    "Схапіўшы пульт, яна пераможна засмяялася:"

# game/scripts/scene/scene_day_1.rpy:4435
translate belarusian staruha1_79aa84d3:

    # voice "voice/olya/83 O.ogg"
    # Oly "Повёлся, повёлся!"
    voice "voice/olya/83 O.ogg"
    Oly "Павёўся, павёўся!"

# game/scripts/scene/scene_day_1.rpy:4440
translate belarusian staruha1_428b2a53:

    # voice "voice/olya/84 O.ogg"
    # Oly "Владычица пульта приказывает смотреть «Питера Пэна»!"
    voice "voice/olya/84 O.ogg"
    Oly "Уладарка пульта загадвае глядзець «Пітэра Пэна»!"

# game/scripts/scene/scene_day_1.rpy:4454
translate belarusian staruha1_1e3a9b47:

    # "Не успел я и рта раскрыть, как видик послушно съел злосчастную кассету."
    "Не паспеў я і рота разявіць, як відзік паслухмяна з'еў злашчасную касету."

# game/scripts/scene/scene_day_1.rpy:4455
translate belarusian staruha1_5bfc0a95:

    # "Сейчас она включит, а там..."
    "Зараз яна ўключыць, а там..."

# game/scripts/scene/scene_day_1.rpy:4456
translate belarusian staruha1_928647b4:

    # "Чёрные кресты на безымянных могилах и опустошённые склепы, кровавые ошмётки на снегу и безумная невеста лесной твари."
    "Чорныя крыжы на безыменных магілах і спустошаныя склепы, крывавыя шматкі на снезе і шалёная нявеста лясной пачвары."

# game/scripts/scene/scene_day_1.rpy:4457
translate belarusian staruha1_1a9daf32:

    # "Лучше сказать правду."
    "Лепш сказаць праўду."

# game/scripts/scene/scene_day_1.rpy:4464
translate belarusian staruha1_60691403:

    # voice "voice/anton/1day/080. Olja_st.ogg"
    # Ant "Оля, стой!"
    voice "voice/anton/1day/080. Olja_st.ogg"
    Ant "Оля, стой!"

# game/scripts/scene/scene_day_1.rpy:4466
translate belarusian staruha1_feeaf301:

    # voice "voice/anton/1day/080. YA tebe.ogg"
    # Ant "Я тебе конец кассеты нечаянно стёр."
    voice "voice/anton/1day/080. YA tebe.ogg"
    Ant "Я табе канец касеты ненаўмысна сцёр."

# game/scripts/scene/scene_day_1.rpy:4468
translate belarusian staruha1_9977b8c2:

    # voice "voice/anton/1day/081. Otdai.ogg"
    # Ant "Отдай её мне и возьми любые две мои."
    voice "voice/anton/1day/081. Otdai.ogg"
    Ant "Аддай яе мне і вазьмі любыя дзве мае."

# game/scripts/scene/scene_day_1.rpy:4473
translate belarusian staruha1_a4af54a9:

    # voice "voice/olya/85 O.ogg"
    # Oly "Ты чего?"
    voice "voice/olya/85 O.ogg"
    Oly "Ты чаго?"

# game/scripts/scene/scene_day_1.rpy:4475
translate belarusian staruha1_07ecc6bb:

    # voice "voice/olya/86 O.ogg"
    # Oly "Не мог ты стереть: мы с папой всем кассетам зубики пластмассовые выломали. Отвёрткой."
    voice "voice/olya/86 O.ogg"
    Oly "Не мог ты сцерці: мы з татам усім касетам зубікі пластмасавыя выламалі. Адвёрткай."

# game/scripts/scene/scene_day_1.rpy:4477
translate belarusian staruha1_745daf1d:

    # voice "voice/olya/87 O.ogg"
    # Oly "Теперь ни на один мой мультфильм ничего записать нельзя."
    voice "voice/olya/87 O.ogg"
    Oly "Цяпер ні на адзін мой мультфільм нічога запісаць нельга."

# game/scripts/scene/scene_day_1.rpy:4484
translate belarusian staruha1_108c1e6e:

    # "Сестра ловко нажала треугольную кнопку «Play» на пульте."
    "Сястра спрытна націснула трохкутную кнопку «Play» на пульце."

# game/scripts/scene/scene_day_1.rpy:4490
translate belarusian staruha1_73bb2191:

    # "Я внутренне сжался, ожидая услышать потусторонний голос диктора."
    "Я ўнутрана сціснуўся, чакаючы пачуць патойбочны голас дыктара."

# game/scripts/scene/scene_day_1.rpy:4494
translate belarusian staruha1_a753a88d:

    # "Но на экране появилась дуэль Питера Пэна с капитаном Крюком."
    "Але на экране з'явілася дуэль Пітэра Пэна з капітанам Крукам."

# game/scripts/scene/scene_day_1.rpy:4498
translate belarusian staruha1_cdd33e71:

    # voice "voice/anton/1day/082. YA oble.ogg"
    # "Я облегчённо выдохнул."
    voice "voice/anton/1day/082. YA oble.ogg"
    "Я з палёгкай выдыхнуў."

# game/scripts/scene/scene_day_1.rpy:4500
translate belarusian staruha1_6792d83b:

    # "Голова опустилась на ладони, тяжёлая, словно чугунный шар."
    "Галава апусцілася на далоні, цяжкая, нібы чыгунны шар."

# game/scripts/scene/scene_day_1.rpy:4504
translate belarusian staruha1_7b2040f7:

    # "Оля довольно улыбнулась."
    "Оля задаволена ўсміхнулася."

# game/scripts/scene/scene_day_1.rpy:4509
translate belarusian staruha1_cb568e4a:

    # "Отправила кассету мотаться на начало, а сама принялась обильно поливать хлеб сгущёнкой."
    "Адправіла касету матацца на пачатак, а сама прынялася шчодра паліваць хлеб згушчонкай."

# game/scripts/scene/scene_day_1.rpy:4510
translate belarusian staruha1_c01efde7:

    # "А когда начался мультфильм, она забыла про всё на свете."
    "А калі пачаўся мультфільм, яна забылася пра ўсё на свеце."

# game/scripts/scene/scene_day_1.rpy:4516
translate belarusian staruha1_70139da0:

    # "Словно и правда переместилась в сказочную Небыляндию, о которой всегда мечтала."
    "Быццам і праўда перамясцілася ў казачную Небыляндыю, пра якую заўсёды марыла."

# game/scripts/scene/scene_day_1.rpy:4517
translate belarusian staruha1_4302db11:

    # "Что греха таить, и я часто представлял себя там, в стране, где не взрослеют, не ссорятся из-за пустяков, не слушают ночами ругань за стеной и звон посуды."
    "Што граху таіць, і я часта ўяўляў сябе там, у краіне, дзе не сталеюць, не сварацца з-за дробязяў, не слухаюць начамі лаянку за сцяной і звон посуду."

# game/scripts/scene/scene_day_1.rpy:4521
translate belarusian staruha1_e30d1d4b:

    # "Но сейчас страна Питера Пэна была особенно далека от меня."
    "Але цяпер краіна Пітэра Пэна была асабліва далёкай ад мяне."

# game/scripts/scene/scene_day_1.rpy:4527
translate belarusian staruha1_683b6537:

    # "Мысли тянулись, натыкались на рогатую тень, подстерегающую среди деревьев, а замогильный голос диктора преследовал, низко скользя над кустами и оврагами."
    "Думкі цягнуліся, натыкаліся на рагаты цень, які падпільноваў сярод дрэў, а магільны голас дыктара пераследаваў, нізка слізгаючы над кустамі і ярамі."

# game/scripts/scene/scene_day_1.rpy:4528
translate belarusian staruha1_7feb8ae3:

    # "Так крылатый хищник преследует жертву."
    "Так крылаты драпежнік пераследуе ахвяру."

# game/scripts/scene/scene_day_1.rpy:4538
translate belarusian bunny1_continue1_2546306e:

    # "Я будто задремал с открытыми глазами."
    "Я быццам задрамаў з адплюшчанымі вачыма."

# game/scripts/scene/scene_day_1.rpy:4539
translate belarusian bunny1_continue1_3cd674a2:

    # "В реальность вернул резкий оклик сестры:"
    "У рэальнасць вярнуў рэзкі воклік сястры:"

# game/scripts/scene/scene_day_1.rpy:4548
translate belarusian bunny1_continue1_78084487:

    # voice "voice/olya/88 O.ogg"
    # Oly "Тоша, скорей штору задёрни!"
    voice "voice/olya/88 O.ogg"
    Oly "Тоша, хутчэй штору зашпіль!"

# game/scripts/scene/scene_day_1.rpy:4550
translate belarusian bunny1_continue1_6fbecfd4:

    # voice "voice/anton/1day/083. Zaczem.ogg"
    # Ant "Зачем?"
    voice "voice/anton/1day/083. Zaczem.ogg"
    Ant "Навошта?"

# game/scripts/scene/scene_day_1.rpy:4552
translate belarusian bunny1_continue1_ad9504d8:

    # voice "voice/anton/1day/083.Nikto zh.ogg"
    # Ant "Никто же на тебя не смотрит."
    voice "voice/anton/1day/083.Nikto zh.ogg"
    Ant "Ніхто ж на цябе не глядзіць."

# game/scripts/scene/scene_day_1.rpy:4559
translate belarusian bunny1_continue1_a6724e9e:

    # voice "voice/olya/89 O.ogg"
    # Oly "Уже темно, а когда темнеет, прилетает сова..."
    voice "voice/olya/89 O.ogg"
    Oly "Ужо цёмна, а калі цямнее, прылятае сава..."

# game/scripts/scene/scene_day_1.rpy:4561
translate belarusian bunny1_continue1_c84cb72c:

    # voice "voice/olya/90 O.ogg"
    # Oly "Я... Я боюсь."
    voice "voice/olya/90 O.ogg"
    Oly "Я... Я баюся."

# game/scripts/scene/scene_day_1.rpy:4567
translate belarusian bunny1_continue1_cc540e57:

    # "Превозмогая усталость, я слез с кровати и задёрнул штору."
    "Пераадольваючы стомленасць, я злез з ложка і зашпіліў штору."

# game/scripts/scene/scene_day_1.rpy:4591
translate belarusian bunny1_continue1_48fcfe43:

    # "Старался при этом не смотреть наружу, на пики сосен, на тайгу, которая в сумерках словно приближалась к дому."
    "Намагаўся пры гэтым не глядзець вонкі, на пікі соснаў, на тайгу, якая ў прыцемках быццам набліжалася да дому."

# game/scripts/scene/scene_day_1.rpy:4592
translate belarusian bunny1_continue1_83fca773:

    # "Хотя, конечно, это лишь корябающие снег тени создавали впечатление, что сосны двигаются."
    "Хоць, вядома, гэта толькі цені, якія драпалі снег, стваралі ўражанне, што сосны рухаюцца."

# game/scripts/scene/scene_day_1.rpy:4598
translate belarusian bunny1_continue1_fd624474:

    # voice "voice/olya/91 O.ogg"
    # Oly "Тоша, мама думает, что я напридумывала про сову."
    voice "voice/olya/91 O.ogg"
    Oly "Тоша, мама думае, што я напрыдумляла пра саву."

# game/scripts/scene/scene_day_1.rpy:4600
translate belarusian bunny1_continue1_2212844c:

    # voice "voice/olya/92 O.ogg"
    # Oly "И папа считает, что раз я маленькая, то, значит, врушка."
    voice "voice/olya/92 O.ogg"
    Oly "І тата лічыць, што раз я маленькая, дык, значыць, хлусіха."

# game/scripts/scene/scene_day_1.rpy:4607
translate belarusian bunny1_continue1_d7571d5f:

    # voice "voice/olya/93 O.ogg"
    # Oly "А сова есть!"
    voice "voice/olya/93 O.ogg"
    Oly "А сава ёсць!"

# game/scripts/scene/scene_day_1.rpy:4609
translate belarusian bunny1_continue1_c0861d20:

    # voice "voice/olya/94 O.ogg"
    # Oly "Вот честное-пречестное – есть она!"
    voice "voice/olya/94 O.ogg"
    Oly "Вось чэснае-прачэснае — ёсць яна!"

# game/scripts/scene/scene_day_1.rpy:4611
translate belarusian bunny1_continue1_839efd02:

    # voice "voice/olya/95 O.ogg"
    # Oly "Ты же мне веришь?"
    voice "voice/olya/95 O.ogg"
    Oly "Ты ж мне верыш?"

# game/scripts/scene/scene_day_1.rpy:4613
translate belarusian bunny1_continue1_1bee3d1f:

    # voice "voice/olya/96 O.ogg"
    # Oly "Что она там и каждую ночь прилетает, и... и..."
    voice "voice/olya/96 O.ogg"
    Oly "Што яна там і кожную ноч прылятае, і... і..."

# game/scripts/scene/scene_day_1.rpy:4621
translate belarusian bunny1_continue1_ee3c480a:

    # "Я порывисто взял Олю за руку, посмотрел в глаза."
    "Я парывіста ўзяў Олю за руку, паглядзеў у вочы."

# game/scripts/scene/scene_day_1.rpy:4622
translate belarusian bunny1_continue1_32fb0a4b:

    # "Словно пытался передать ей каплю смелости и уверенности."
    "Нібы спрабаваў перадаць ёй кроплю смеласці і ўпэўненасці."

# game/scripts/scene/scene_day_1.rpy:4623
translate belarusian bunny1_continue1_6a702ede:

    # "Но есть ли эти качества во мне самом?"
    "Але ці ёсць гэтыя якасці ўва мне самім?"

# game/scripts/scene/scene_day_1.rpy:4627
translate belarusian bunny1_continue1_4952c164:

    # voice "voice/anton/1day/084. YA tebe.ogg"
    # Ant "Я тебе верю, слышишь?"
    voice "voice/anton/1day/084. YA tebe.ogg"
    Ant "Я табе веру, чуеш?"

# game/scripts/scene/scene_day_1.rpy:4629
translate belarusian bunny1_continue1_480e7756:

    # voice "voice/anton/1day/084.Ty tol.ogg"
    # Ant "Ты только родителям больше не рассказывай про сову."
    voice "voice/anton/1day/084.Ty tol.ogg"
    Ant "Ты толькі бацькам больш не расказвай пра саву."

# game/scripts/scene/scene_day_1.rpy:4631
translate belarusian bunny1_continue1_50774e45:

    # voice "voice/anton/1day/085. U nih.ogg"
    # Ant "У них и так хлопот по горло, они только рассердятся."
    voice "voice/anton/1day/085. U nih.ogg"
    Ant "У іх і так клопатаў па горла, яны толькі раззлуюцца."

# game/scripts/scene/scene_day_1.rpy:4633
translate belarusian bunny1_continue1_c26607e6:

    # voice "voice/anton/1day/085. Ty mne.ogg"
    # Ant "Ты мне говори, если что случится."
    voice "voice/anton/1day/085. Ty mne.ogg"
    Ant "Ты мне кажы, калі што здарыцца."

# game/scripts/scene/scene_day_1.rpy:4635
translate belarusian bunny1_continue1_fc6dea4a:

    # voice "voice/anton/1day/086. I v ok.ogg"
    # Ant "И в окно не смотри."
    voice "voice/anton/1day/086. I v ok.ogg"
    Ant "І ў акно не глядзі."

# game/scripts/scene/scene_day_1.rpy:4642
translate belarusian bunny1_continue1_9e03c5ac:

    # voice "voice/olya/97 O.ogg"
    # Oly "Но она хочет, чтобы я смотрела."
    voice "voice/olya/97 O.ogg"
    Oly "Але яна хоча, каб я глядзела."

# game/scripts/scene/scene_day_1.rpy:4648
translate belarusian bunny1_continue1_cf5d4907:

    # voice "voice/anton/1day/087. Pereho.ogg"
    # Ant "Перехочет!"
    voice "voice/anton/1day/087. Pereho.ogg"
    Ant "Перахоча!"

# game/scripts/scene/scene_day_1.rpy:4650
translate belarusian bunny1_continue1_0613450c:

    # voice "voice/anton/1day/088. Pritvo.ogg"
    # Ant "Притворись, что её нет и не было никогда, что она выдумка, как родители говорят."
    voice "voice/anton/1day/088. Pritvo.ogg"
    Ant "Прыкінься, што яе няма і не было ніколі, што яна выдумка, як бацькі кажуць."

# game/scripts/scene/scene_day_1.rpy:4652
translate belarusian bunny1_continue1_f9288c4a:

    # voice "voice/anton/1day/089. Ei zhda.ogg"
    # Ant "Ей ждать надоест — она улетит."
    voice "voice/anton/1day/089. Ei zhda.ogg"
    Ant "Ёй чакаць надакучыць — яна паляціць."

# game/scripts/scene/scene_day_1.rpy:4665
translate belarusian bunny1_continue1_72ee245a:

    # "Безумие, но после всех событий я всё больше верил, что олина сова существует"
    "Шалёнства, але пасля ўсіх падзей я ўсё больш верыў, што Оліна сава існуе"

# game/scripts/scene/scene_day_1.rpy:4666
translate belarusian bunny1_continue1_a20cefa7:

    # "..."
    "..."

# game/scripts/scene/scene_day_1.rpy:4683
translate belarusian bunny1_continue1_e948ae28:

    # "Мы следили за приключениями Питера Пэна, будто не было ничего: ни леса, который похищал детей, ни родителей, которые поедали друг друга по кусочку."
    "Мы сачылі за прыгодамі Пітэра Пэна, быццам не было нічога: ні лесу, які выкрадаў дзяцей, ні бацькоў, якія з'ядалі адно аднаго па кавалачку."

# game/scripts/scene/scene_day_1.rpy:4687
translate belarusian bunny1_continue1_876adcc1:

    # "Капитан Крюк улепётывал от крокодила, капитан Пэн направлялся в Лондон на золотом паруснике."
    "Капітан Крук уцякаў ад кракадзіла, капітан Пэн накіроўваўся ў Лондан на залатым парусніку."

# game/scripts/scene/scene_day_1.rpy:4688
translate belarusian bunny1_continue1_9ad12e1e:

    # "Чудом я пересидел сестру."
    "Цудам я перадзяжурыў сястру."

# game/scripts/scene/scene_day_1.rpy:4689
translate belarusian bunny1_continue1_66a86ae1:

    # "Олины веки слиплись, она засопела, опустив подбородок на изголовье кровати."
    "Оліны павекі зліпліся, яна засапла, апусціўшы падбародак на ўзгалоўе ложка."

# game/scripts/scene/scene_day_1.rpy:4696
translate belarusian bunny1_continue1_aef16085:

    # "Хор пел финальную песенку, в диснеевском мире сияла серебристая луна."
    "Хор спяваў фінальную песеньку, у дыснэеўскім свеце ззяў серабрысты месяц."

# game/scripts/scene/scene_day_1.rpy:4713
translate belarusian bunny1_continue1_49dfb0ed:

    # "Из-под этой нарисованной луны внезапно выглянула другая."
    "З-пад гэтага намаляванага месяца раптоўна выглянуў іншы."

# game/scripts/scene/scene_day_1.rpy:4714
translate belarusian bunny1_continue1_8e10eb4b:

    # "Страшная и мёртвенная, висящая над таёжным бором."
    "Страшны і мёртвенны, які вісеў над таёжным борам."

# game/scripts/scene/scene_day_1.rpy:4715
translate belarusian bunny1_continue1_0a6cf9f1:

    # "Жуткий репортаж записался аккурат на титры мультфильма."
    "Жудасны рэпартаж запісаўся акурат на тытры мультфільма."

# game/scripts/scene/scene_day_1.rpy:4716
translate belarusian bunny1_continue1_8259563a:

    # "Во рту у меня пересохло. Пульс участился."
    "У роце ў мяне перасохла. Пульс пачасціўся."

# game/scripts/scene/scene_day_1.rpy:4720
translate belarusian bunny1_continue1_b7753ff1:

    # "Я быстро посмотрел на Олю."
    "Я хутка паглядзеў на Олю."

# game/scripts/scene/scene_day_1.rpy:4729
translate belarusian bunny1_continue1_9d0263ec:

    # "Она причмокнула губами во сне."
    "Яна прыцмокнула вуснамі ў сне."

# game/scripts/scene/scene_day_1.rpy:4737
translate belarusian bunny1_continue1_b8170dc7:

    # "Я стиснул пульт, готовый в любой момент нажать кнопку «Stop»."
    "Я сціснуў пульт, гатовы ў любы момант націснуць кнопку «Stop»."

# game/scripts/scene/scene_day_1.rpy:4744
translate belarusian bunny1_continue1_03b4ea1b:

    # "Промотал запись и оценил сохранность репортажа, а затем бережно вытащил кассету."
    "Праматаў запіс і ацаніў захаванасць рэпартажу, а затым беражліва выцягнуў касету."

# game/scripts/scene/scene_day_1.rpy:4748
translate belarusian bunny1_continue1_4a5e5fd0:

    # "Защитный зубец оказался на месте."
    "Ахоўны зубец аказаўся на месцы."

# game/scripts/scene/scene_day_1.rpy:4784
translate belarusian bunny1_continue1_61f50140:

    # "Я встал осторожно и покинул детскую."
    "Я ўстаў асцярожна і пакінуў дзіцячую."

# game/scripts/scene/scene_day_1.rpy:4806
translate belarusian bunny1_continue1_a383bafe:

    # "Не знаю, провиденье это или проклятье, но кассету я успел спрятать рядом с варежкой как раз перед тем, как заглянула в комнату мама."
    "Не ведаю, провід гэта ці праклён, але касету я паспеў схаваць побач з рукавічкай якраз перад тым, як зазірнула ў пакой мама."

# game/scripts/scene/scene_day_1.rpy:4808
translate belarusian bunny1_continue1_f8c71d2f:

    # "Не знаю, провиденье это или проклятье, но кассету я успел спрятать как раз перед тем, как заглянула в комнату мама."
    "Не ведаю, провід гэта ці праклён, але касету я паспеў схаваць якраз перад тым, як зазірнула ў пакой мама."

# game/scripts/scene/scene_day_1.rpy:4835
translate belarusian bunny1_continue1_5941a37e:

    # "Я смотрел в окно, изучая поле, когда мама заглянула ко мне."
    "Я глядзеў у акно, вывучаючы поле, калі мама зазірнула да мяне."

# game/scripts/scene/scene_day_1.rpy:4845
translate belarusian bunny1_continue1_959324ab:

    # voice "voice/karina/84 K.ogg"
    # Mam "Довольно баловства."
    voice "voice/karina/84 K.ogg"
    Mam "Годзе свавольстваў."

# game/scripts/scene/scene_day_1.rpy:4864
translate belarusian bunny1_continue1_3d705e5e:

    # voice "voice/karina/85 K.ogg"
    # Mam "Завтра первый день в школе."
    voice "voice/karina/85 K.ogg"
    Mam "Заўтра першы дзень у школе."

# game/scripts/scene/scene_day_1.rpy:4866
translate belarusian bunny1_continue1_8c795458:

    # voice "voice/karina/86 K.ogg"
    # Mam "Ложись, тебе надо выспаться."
    voice "voice/karina/86 K.ogg"
    Mam "Кладзіся, табе трэба выспацца."

# game/scripts/scene/scene_day_1.rpy:4874
translate belarusian bunny1_continue1_742bcd81:

    # voice "voice/karina/87 K.ogg"
    # Mam "Не хочешь же ты, чтобы тебя все дразнили соней?"
    voice "voice/karina/87 K.ogg"
    Mam "Не хочаш жа ты, каб цябе ўсе дражнілі соняй?"

# game/scripts/scene/scene_day_1.rpy:4888
translate belarusian bunny1_continue1_3195a5c0:

    # "Как же у взрослых всё просто."
    "Як жа ў дарослых усё проста."

# game/scripts/scene/scene_day_1.rpy:4892
translate belarusian bunny1_continue1_b218e965:

    # "Словно мой крепкий сон будет залогом того, что я понравлюсь одноклассникам."
    "Нібы мой моцны сон будзе зарукай таго, што я спадабаюся аднакласнікам."

# game/scripts/scene/scene_day_1.rpy:4896
translate belarusian bunny1_continue1_db4e6ed0:

    # "Натянув одеяло под горло, я слушал, как бормочет дом, как в тёмных углах шуршит кто-то невидимый."
    "Нацягнуўшы коўдру пад горла, я слухаў, як мармыча дом, як у цёмных кутах шаргаціць нехта нябачны."

# game/scripts/scene/scene_day_1.rpy:4901
translate belarusian bunny1_continue1_a3bf972d:

    # "Внутренний голос задался вопросом: хочу ли я снова услышать ту странную флейту?"
    "Унутраны голас задаўся пытаннем: ці хачу я зноў пачуць тую дзіўную флейту?"

# game/scripts/scene/scene_day_1.rpy:4902
translate belarusian bunny1_continue1_f63e7633:

    # "Да или нет?"
    "Так ці не?"

# game/scripts/scene/scene_day_1.rpy:4906
translate belarusian bunny1_continue1_3a64e1ff:

    # "Возможно, я взрослею и не могу до конца понять себя и свои желания."
    "Магчыма, я сталею і не магу да канца зразумець сябе і свае жаданні."

# game/scripts/scene/scene_day_1.rpy:4910
translate belarusian bunny1_continue1_ebc18c29:

    # "Лес стенал за преградой стен."
    "Лес стагнаў за перашкодай сцен."

# game/scripts/scene/scene_day_1.rpy:4914
translate belarusian bunny1_continue1_33a370e7:

    # "Что-то бесплотное бродило по полям."
    "Нешта бясплотнае блукала па палях."

# game/scripts/scene/scene_day_1.rpy:4918
translate belarusian bunny1_continue1_b59bf7ec:

    # "Шевелились ветви, будто звали."
    "Варушыліся галіны, нібы клікалі."

# game/scripts/scene/scene_day_1.rpy:4919
translate belarusian bunny1_continue1_81673061:

    # "И ветер выл и выл в ночи."
    "І вецер выў і выў у ночы."

# game/scripts/scene/scene_day_1.rpy:4920
translate belarusian bunny1_continue1_3e28a353:

    # "Мысли, как назойливые мухи, что лезли в голову, становились вялыми и путанными."
    "Думкі, як надакучлівыя мухі, што лезлі ў галаву, станавіліся млявымі і блытанымі."

# game/scripts/scene/scene_day_1.rpy:4925
translate belarusian bunny1_continue1_11b59288:

    # "Я сам не заметил, как провалился в сон."
    "Я сам не заўважыў, як праваліўся ў сон."

