# Belarusian translation of Chapter 3: scripts/scene/scene_day_3.rpy

# game/scripts/scene/scene_day_3.rpy:166
translate belarusian day_3_5511b3fc:

    # Pupils "Это тот, который Бабурина ненавидел."
    Pupils "Гэта той, які Бабурына ненавідзеў."

# game/scripts/scene/scene_day_3.rpy:169
translate belarusian day_3_d4ab69a7:

    # Pupils "Думаешь, это он сделал?"
    Pupils "Думаеш, гэта ён зрабіў?"

# game/scripts/scene/scene_day_3.rpy:171
translate belarusian day_3_68633620:

    # Pupils "Я слышала, он со странностями."
    Pupils "Я чула, ён з дзівацтвамі."

# game/scripts/scene/scene_day_3.rpy:181
translate belarusian day_3_b22bad13:

    # "В ушах звучал крик Ромки, которым он с Бяшей напутствовал удирающего Семёна."
    "У вушах гучаў крык Ромкі, якім ён з Бяшам праводзіў Сямёна, што ўцякаў."

# game/scripts/scene/scene_day_3.rpy:182
translate belarusian day_3_0d0b8162:

    # voice "voice/romka/3day/Gorlo tebe pererezu.ogg"
    # Rom "Горло тебе перережу, слышишь!"
    voice "voice/romka/3day/Gorlo tebe pererezu.ogg"
    Rom "Горла табе перарэжу, чуеш!"

# game/scripts/scene/scene_day_3.rpy:186
translate belarusian day_3_4fabca73:

    # "«Свинья!»"
    "«Свіння!»"

# game/scripts/scene/scene_day_3.rpy:196
translate belarusian day_3_8b7d551a:

    # "Неужели Ромка грозился всерьёз?"
    "Няўжо Ромка пагражаў сур'ёзна?"

# game/scripts/scene/scene_day_3.rpy:197
translate belarusian day_3_c7844405:

    # "Нагнать бывшего приятеля в чаще и..."
    "Дагнаць былога прыяцеля ў гушчары і..."

# game/scripts/scene/scene_day_3.rpy:198
translate belarusian day_3_858a5533:

    # "... и что?"
    "... і што?"

# game/scripts/scene/scene_day_3.rpy:199
translate belarusian day_3_f44b3bb2:

    # "Убить просто так?"
    "Забіць проста так?"

# game/scripts/scene/scene_day_3.rpy:200
translate belarusian day_3_a9a10155:

    # "Нет, в голове не укладывается."
    "Не, у галаве не ўкладваецца."

# game/scripts/scene/scene_day_3.rpy:201
translate belarusian day_3_a558dadc:

    # "Я судорожно протёр стёкла очков..."
    "Я сутаргава працёр шкло акуляраў..."

# game/scripts/scene/scene_day_3.rpy:202
translate belarusian day_3_c0a4862c:

    # "Очки!"
    "Акуляры!"

# game/scripts/scene/scene_day_3.rpy:204
translate belarusian day_3_8c6ca273:

    # "Их сжимал в кулаке Семён, уворачиваясь от затрещин своих дружков."
    "Іх сціскаў у кулаку Сямён, ухіляючыся ад патылічнікаў сваіх дружкоў."

# game/scripts/scene/scene_day_3.rpy:205
translate belarusian day_3_32cf139f:

    # "Теперь бывших."
    "Цяпер былых."

# game/scripts/scene/scene_day_3.rpy:209
translate belarusian day_3_1edc4309:

    # "Их сжимал в кулаке Семён, когда меня били."
    "Іх сціскаў у кулаку Сямён, калі мяне білі."

# game/scripts/scene/scene_day_3.rpy:211
translate belarusian day_3_900569a0:

    # "А уже через несколько часов пропажа лежала на моём карнизе."
    "А ўжо праз некалькі гадзін згуба ляжала на маім карнізе."

# game/scripts/scene/scene_day_3.rpy:225
translate belarusian day_3_f09a2181:

    # "Сложно представить, что Сёма вдруг засовестился и вернул мне очки таким странным образом."
    "Складана ўявіць, што Сёма раптам засаромеўся і вярнуў мне акуляры такім дзіўным чынам."

# game/scripts/scene/scene_day_3.rpy:229
translate belarusian day_3_17592673:

    # "Шокированный, я шёл к классу под гадкие шепотки."
    "Шакаваны, я ішоў да класа пад брыдкія шаптанні."

# game/scripts/scene/scene_day_3.rpy:231
translate belarusian day_3_109ec4c6:

    # "А перед глазами всё стояла фотография."
    "А перад вачыма ўсё стаяў фотаздымак."

# game/scripts/scene/scene_day_3.rpy:236
translate belarusian day_3_72bb47e4:

    # "Сёма пропал. Семёна нет."
    "Сёма знік. Сямёна няма."

# game/scripts/scene/scene_day_3.rpy:239
translate belarusian day_3_9a1ce771:

    # "Его толстые пальцы не дотянутся до моего горла, его печатка не врежется в мою скулу, он больше не унизит меня и не оскорбит."
    "Яго тоўстыя пальцы не дацягнуцца да майго горла, яго пячатка не ўрэжацца ў маю сківіцу, ён больш не прынізіць мяне і не абразіць."

# game/scripts/scene/scene_day_3.rpy:240
translate belarusian day_3_a856b955:

    # "Не этого ли я желал?"
    "Ці не гэтага я жадаў?"

# game/scripts/scene/scene_day_3.rpy:241
translate belarusian day_3_9ccd61e3:

    # "С другой стороны..."
    "З іншага боку..."

# game/scripts/scene/scene_day_3.rpy:243
translate belarusian day_3_1350441a:

    # "Разве мне и правда хотелось, чтобы Сёма стал мутным пятном на доске объявлений?"
    "Хіба мне і праўда хацелася, каб Сёма стаў мутнай плямай на дошцы аб'яў?"

# game/scripts/scene/scene_day_3.rpy:244
translate belarusian day_3_c6777f58:

    # "Чей-то сын, чей-то внук, над которым измывались так же, как надо мной."
    "Чыйсьці сын, чыйсьці ўнук, з якога здзекаваліся так жа, як з мяне."

# game/scripts/scene/scene_day_3.rpy:246
translate belarusian day_3_d8806ea7:

    # "Хотел ли я, чтобы незримый соратник разобрался с ним так жестоко?"
    "Ці хацеў я, каб нябачны паплечнік расправіўся з ім так жорстка?"

# game/scripts/scene/scene_day_3.rpy:250
translate belarusian day_3_2561a66e:

    # "Я не знал ответа."
    "Я не ведаў адказу."

# game/scripts/scene/scene_day_3.rpy:251
translate belarusian day_3_5ec9a56f:

    # "Или боялся его."
    "Ці баяўся яго."

# game/scripts/scene/scene_day_3.rpy:258
translate belarusian day_3_ffb6db5d:

    # "И всё же в школе было и хорошее."
    "І ўсё ж у школе было і добрае."

# game/scripts/scene/scene_day_3.rpy:259
translate belarusian day_3_3be390e9:

    # "Полина — девочка со скрипкой, — она была похожа на горный ручей, на колодезную воду, которую пьёшь, прихватив губами цинковый ободок ведра, и не можешь напиться."
    "Паліна — дзяўчынка са скрыпкай, — яна была падобная да горнага ручая, да калодзежнай вады, якую п'еш, прыхапіўшы вуснамі цынкавы абадок вядра, і не можаш напіцца."

# game/scripts/scene/scene_day_3.rpy:262
translate belarusian day_3_f1913717:

    # "Воспоминания о вчерашней прогулке слегка остудили мой пыл."
    "Успаміны пра ўчорашнюю прагулку крыху астудзілі мой запал."

# game/scripts/scene/scene_day_3.rpy:263
translate belarusian day_3_637a0ed4:

    # "Полинина ненависть к собакам, пускай в её случае и была оправданной, всё же настораживала меня."
    "Палініна нянавісць да сабак, хай у яе выпадку і была апраўданай, усё ж насцярожвала мяне."

# game/scripts/scene/scene_day_3.rpy:264
translate belarusian day_3_cdb1227d:

    # "Разве может в сердце такой очаровательной девочки найтись место для столь отвратительной червоточины?"
    "Хіба можа ў сэрцы такой чароўнай дзяўчынкі знайсціся месца для такой агіднай чарвяточыны?"

# game/scripts/scene/scene_day_3.rpy:265
translate belarusian day_3_da36f171:

    # "Я тут же вспомнил о неожиданно вскрывшемся тёмном прошлом отца."
    "Я адразу ўзгадаў пра цёмнае мінулае бацькі, што нечакана адкрылася."

# game/scripts/scene/scene_day_3.rpy:266
translate belarusian day_3_42d7861a:

    # "Человек, которого я считал своим кумиром, стал причиной нашего переезда в эту мрачную глухомань..."
    "Чалавек, якога я лічыў сваім кумірам, стаў прычынай нашага пераезду ў гэту змрочную глухмень..."

# game/scripts/scene/scene_day_3.rpy:267
translate belarusian day_3_449e789d:

    # "…если, конечно, можно верить маминым крикам из-за стены."
    "…калі, вядома, можна верыць маміным крыкам з-за сцяны."

# game/scripts/scene/scene_day_3.rpy:268
translate belarusian day_3_e0cfce2b:

    # "И всё же Полина пыталась защитить меня от шайки хулиганов, пускай и безуспешно."
    "І ўсё ж Паліна спрабавала абараніць мяне ад шайкі хуліганаў, хай сабе і беспаспяхова."

# game/scripts/scene/scene_day_3.rpy:269
translate belarusian day_3_2b92bdcc:

    # "Она молила Ромку оставить меня в покое, собирала, глотая слёзы, мои разбросанные по лесу учебники и тетради."
    "Яна маліла Ромку пакінуць мяне ў спакоі, збірала, глытаючы слёзы, мае раскіданыя па лесе падручнікі і сшыткі."

# game/scripts/scene/scene_day_3.rpy:270
translate belarusian day_3_ddb3c473:

    # "А когда подонки пытались её уволочь – сопротивлялась что было сил в её хрупком теле."
    "А калі падонкі спрабавалі яе павалачы — супраціўлялася што было сіл у яе кволым целе."

# game/scripts/scene/scene_day_3.rpy:271
translate belarusian day_3_aedce036:

    # "В конце-концов, именно она нашла мой потерянный в таёжном лесу дом и сказала папе, что меня, избитого, бросили одного в потёмках."
    "У рэшце рэшт, менавіта яна знайшла мой згублены ў тайговым лесе дом і сказала тату, што мяне, збітага, кінулі аднаго ў цемры."

# game/scripts/scene/scene_day_3.rpy:272
translate belarusian day_3_59cbb314:

    # "Возможно, я сужу её слишком строго."
    "Магчыма, я суджу яе занадта строга."

# game/scripts/scene/scene_day_3.rpy:274
translate belarusian day_3_6f9d7488:

    # "Что, если нарисовать историю с её участием? Будто герой спасает её от ужасных чудовищ?"
    "Што, калі намаляваць гісторыю з яе ўдзелам? Быццам герой ратуе яе ад жудасных пачвар?"

# game/scripts/scene/scene_day_3.rpy:280
translate belarusian day_3_d90e0be1:

    # "Едва я подумал про монстров, как парочка одноклассников съехала по перилам, скалясь, словно инопланетяне из фильма «Чужие»."
    "Толькі я падумаў пра монстраў, як парачка аднакласнікаў з'ехала па парэнчах, скалячыся, нібы іншапланецяне з фільма «Чужыя»."

# game/scripts/scene/scene_day_3.rpy:283
translate belarusian day_3_b0b21915:

    # "Личинки боязни незамедлительно отложились внутри."
    "Лічынкі боязі неадкладна адклаліся ўнутры."

# game/scripts/scene/scene_day_3.rpy:286
translate belarusian day_3_b9600458:

    # "Попадаться на глаза Ромке и Бяше после вчерашнего не было ни малейшего желания. Особенно из-за внезапного исчезновения Семёна."
    "Трапляцца на вочы Ромку і Бяшу пасля ўчорашняга не было ні найменшага жадання. Асабліва з-за раптоўнага знікнення Сямёна."

# game/scripts/scene/scene_day_3.rpy:301
translate belarusian day_3_5d8c2d3a:

    # "Полина хотела было заговорить со мной, но, заметив эту парочку, вдруг помрачнела и прошагала мимо, задержав на мне виноватый взгляд."
    "Паліна хацела было загаварыць са мной, але, заўважыўшы гэтую парачку, раптам спахмурнела і пракрочыла міма, затрымаўшы на мне вінаваты позірк."

# game/scripts/scene/scene_day_3.rpy:338
translate belarusian day_3_5ed7bbfb:

    # "Войдя в класс, я прошёл к последней парте."
    "Увайшоўшы ў клас, я прайшоў да апошняй парты."

# game/scripts/scene/scene_day_3.rpy:340
translate belarusian day_3_8908134a:

    # "В тишине, потому что одноклассники резко притихли."
    "У цішыні, таму што аднакласнікі рэзка прыціхлі."

# game/scripts/scene/scene_day_3.rpy:341
translate belarusian day_3_f03289a8:

    # "Их взгляды буквально пихали меня, трогали, исследовали."
    "Іх позіркі літаральна штурхалі мяне, мацалі, даследавалі."

# game/scripts/scene/scene_day_3.rpy:345
translate belarusian day_3_637d6879:

    # "Они смотрели на меня с убивающей смесью жалости, насмешки и презрения. Так учёный смотрит на гадкого неизвестного науке червяка."
    "Яны глядзелі на мяне са знішчальнай сумессю жалю, насмешкі і пагарды. Так вучоны глядзіць на гідкага невядомага навуцы чарвяка."

# game/scripts/scene/scene_day_3.rpy:347
translate belarusian day_3_8edde09d:

    # "Я стиснул кулаки и уставился на свою парту, чуть ли не до потолка заваленную стопками библиотечных учебников."
    "Я сціснуў кулакі і ўтаропіўся на сваю парту, ледзь не да самай столі заваленую стосамі бібліятэчных падручнікаў."

# game/scripts/scene/scene_day_3.rpy:348
translate belarusian day_3_f30a1f3b:

    # "Словно это я пропал в том заснеженном лесу, и теперь моё место наконец сгодилось для чего-то действительно нужного."
    "Быццам гэта я знік у тым заснежаным лесе, і цяпер маё месца нарэшце згадзілася для нечага сапраўды патрэбнага."

# game/scripts/scene/scene_day_3.rpy:349
translate belarusian day_3_31a45392:

    # "Впереди стоял пустой стул Семёна. Где-то в другом классе пылился точно такой же стул, покинутый Вовой."
    "Наперадзе стаяла пустое крэсла Сямёна. Недзе ў іншым класе пылілася дакладна такое ж крэсла, пакінутае Вовам."

# game/scripts/scene/scene_day_3.rpy:366
translate belarusian d3_look_projector_65dfeeda:

    # "Фильмоскоп."
    "Фільмаскоп."

# game/scripts/scene/scene_day_3.rpy:369
translate belarusian d3_look_projector_9dacffb3:

    # "Старенький и дешёвый проектор для рулонных диафильмов. Я называл такую модель «танчик» — из-за внешнего сходства."
    "Старэнькі і танны праектар для рулонных дыяфільмаў. Я называў такую мадэль «танчык» — з-за знешняга падабенства."

# game/scripts/scene/scene_day_3.rpy:371
translate belarusian d3_look_projector_ca727c97:

    # "Когда-то у меня было много классных сказок, которые мы смотрели с папой в темноте."
    "Калісьці ў мяне было шмат класных казак, якія мы глядзелі з татам у цемры."

# game/scripts/scene/scene_day_3.rpy:372
translate belarusian d3_look_projector_f423b508:

    # "Помню «Крошку Енота» и того, кто сидит в пруду. «Маугли» Редьярда Киплинга, и многие другие."
    "Памятаю «Крошку Енота» і таго, хто сядзіць у сажалцы. «Маўглі» Рэдзьярда Кіплінга, і многія іншыя."

# game/scripts/scene/scene_day_3.rpy:373
translate belarusian d3_look_projector_5694109a:

    # "Тут же меня накрыло воспоминание, как гудел проектор фильмоскопа, как пылал жаром его корпус, а яркий луч бил в стену, превращая её в экран."
    "Тут жа мяне накрыў успамін, як гудзеў праектар фільмаскопа, як палаў жарам яго корпус, а яркі прамень біў у сцяну, ператвараючы яе ў экран."

# game/scripts/scene/scene_day_3.rpy:374
translate belarusian d3_look_projector_88d5a840:

    # "Жаль, что в школе диафильмы были в основном про полезные минералы и ОБЖ."
    "Шкада, што ў школе дыяфільмы былі ў асноўным пра карысныя мінералы і АБЖ."

# game/scripts/scene/scene_day_3.rpy:384
translate belarusian d3_look_esenin_f0ef6cfe:

    # "Портреты классиков."
    "Партрэты класікаў."

# game/scripts/scene/scene_day_3.rpy:387
translate belarusian d3_look_esenin_f950332c:

    # "Я посмотрел на портреты классиков. Взгляд остановился на фотографии Есенина."
    "Я паглядзеў на партрэты класікаў. Позірк спыніўся на фотаздымку Ясеніна."

# game/scripts/scene/scene_day_3.rpy:388
translate belarusian d3_look_esenin_fe2bd8d4:

    # "В прошлом году мне задали выучить любое стихотворение, и папа предложил про пса Джима, — за авторством Сергея Александровича."
    "У мінулым годзе мне задалі вывучыць любы верш, і тата прапанаваў пра сабаку Джыма, — аўтарства Сяргея Аляксандравіча."

# game/scripts/scene/scene_day_3.rpy:389
translate belarusian d3_look_esenin_0b99237b:

    # "Всех четверостиший я уже и не помню, но конец почему-то врезался мне в память:"
    "Усіх чатырохрадкоўяў я ўжо і не памятаю, але канец чамусьці ўрэзаўся мне ў памяць:"

# game/scripts/scene/scene_day_3.rpy:390
translate belarusian d3_look_esenin_43a2a40a:

    # "«Она придёт, даю тебе поруку.\nИ без меня, в её уставясь взгляд,"
    "«Яна прыйдзе, даю табе паруку.\nІ без мяне, у яе ўпіўшы пагляд,"

# game/scripts/scene/scene_day_3.rpy:391
translate belarusian d3_look_esenin_aeca221d:

    # "Ты за меня лизни ей нежно руку\nЗа всё, в чём был и не был виноват»."
    "Ты за мяне лізні ёй нежна руку\nЗа ўсё, у чым вінаваты і не вінават»."

# game/scripts/scene/scene_day_3.rpy:403
translate belarusian d3_look_box_8c9fbcf5:

    # "Коробка бомбочек «Корсар»."
    "Каробка бомбачак «Карсар»."

# game/scripts/scene/scene_day_3.rpy:407
translate belarusian d3_look_box_257a8197:

    # "Такая вещь была у каждого моего знакомого мальчишки. Пороховые петарды, которые оглушительно взрываются."
    "Такая рэч была ў кожнага майго знаёмага хлапчука. Парахавыя петарды, якія аглушальна выбухаюць."

# game/scripts/scene/scene_day_3.rpy:408
translate belarusian d3_look_box_50b0bace:

    # "Особенно в закрытой арке. Говорят, их собирают в Китае, и они могут оторвать пальцы, если зажать их в кулаке."
    "Асабліва ў закрытай арцы. Кажуць, іх збіраюць у Кітаі, і яны могуць адарваць пальцы, калі заціснуць іх у кулаку."

# game/scripts/scene/scene_day_3.rpy:409
translate belarusian d3_look_box_e95053b2:

    # "Особенно эти чёрные «Корсары». Пластмассовых солдатиков они, конечно, не взорвут, а вот подделки из пластилина — вполне."
    "Асабліва гэтыя чорныя «Карсары». Пластмасавых салдацікаў яны, вядома, не падарвуць, а вось падробкі з пластыліну — цалкам."

# game/scripts/scene/scene_day_3.rpy:436
translate belarusian day_3_continue_e0da213a:

    # "Немного помешкав, я сел за парту Бабурина, куда изначально меня планировала посадить Лилия Павловна."
    "Трохі памарудзіўшы, я сеў за парту Бабурына, куды першапачаткова мяне планавала пасадзіць Лілія Паўлаўна."

# game/scripts/scene/scene_day_3.rpy:439
translate belarusian day_3_continue_d2330cc3:

    # "Одноклассники вдруг продолжили разговор — будто кто-то снял фильм с паузы."
    "Аднакласнікі раптам працягнулі размову — быццам нехта зняў фільм з паўзы."

# game/scripts/scene/scene_day_3.rpy:443
translate belarusian day_3_continue_fb76a43b:

    # voice "voice/kate/79 KA.ogg"
    # Kate "Бабушка Бабурина такой кипиш устроила, когда он домой не явился."
    voice "voice/kate/79 KA.ogg"
    Kate "Бабуля Бабурына такі кіпіш учыніла, калі ён дадому не з'явіўся."

# game/scripts/scene/scene_day_3.rpy:445
translate belarusian day_3_continue_eaa2ce90:

    # voice "voice/kate/80 KA.ogg"
    # Kate "Сначала в школу прибежала, потом ментов вызвала."
    voice "voice/kate/80 KA.ogg"
    Kate "Спачатку ў школу прыбегла, потым мянтоў выклікала."

# game/scripts/scene/scene_day_3.rpy:447
translate belarusian day_3_continue_ed023b1f:

    # voice "voice/kate/81 KA.ogg"
    # Kate "Да-да-да!"
    voice "voice/kate/81 KA.ogg"
    Kate "Так-так-так!"

# game/scripts/scene/scene_day_3.rpy:456
translate belarusian day_3_continue_7a51cda3:

    # "Катя с хитрецой посмотрела на меня, а потом склонилась к соседке и зашептала."
    "Каця з хітрынкай паглядзела на мяне, а потым схілілася да суседкі і зашаптала."

# game/scripts/scene/scene_day_3.rpy:458
translate belarusian day_3_continue_46e6ac74:

    # "Переглянулись девочки со второй парты — она и с ними поделилась — зашушукала, быстро закивала."
    "Пераглянуліся дзяўчынкі з другой парты — яна і з імі падзялілася — зашушукала, хутка заківала."

# game/scripts/scene/scene_day_3.rpy:460
translate belarusian day_3_continue_3aaca832:

    # "Я ловил на себе её взгляд, взгляд её соседки, взгляды других девочек и мальчиков."
    "Я лавіў на сабе яе позірк, позірк яе суседкі, позіркі іншых дзяўчынак і хлопчыкаў."

# game/scripts/scene/scene_day_3.rpy:461
translate belarusian day_3_continue_4108be6a:

    # "Каждый из них считал нужным посмотреть на меня, словно они..."
    "Кожны з іх лічыў патрэбным паглядзець на мяне, нібыта яны..."

# game/scripts/scene/scene_day_3.rpy:464
translate belarusian day_3_continue_f1b4e522:

    # "... искали следы крови на моих пальцах."
    "... шукалі сляды крыві на маіх пальцах."

# game/scripts/scene/scene_day_3.rpy:465
translate belarusian day_3_continue_37a04f83:

    # "Так хотелось оправдаться, закричать: «Вы чего?! Я невиновен!»"
    "Так хацелася апраўдацца, закрычаць: «Вы чаго?! Я невінаваты!»"

# game/scripts/scene/scene_day_3.rpy:471
translate belarusian day_3_continue_2389ad1f:

    # "Ромка посмотрел как-то тяжело, тревожно."
    "Ромка паглядзеў неяк цяжка, трывожна."

# game/scripts/scene/scene_day_3.rpy:472
translate belarusian day_3_continue_0e7e9f4e:

    # "Похоже, он, как и все, был сбит с толку пропажей Семёна, огорошен случившимся."
    "Падобна, ён, як і ўсе, быў збіты з панталыку знікненнем Сямёна, агаломшаны тым, што адбылося."

# game/scripts/scene/scene_day_3.rpy:473
translate belarusian day_3_continue_bb1f63ef:

    # "И вдруг его взгляд упёрся мне в переносицу."
    "І раптам яго позірк упёрся мне ў пераноссе."

# game/scripts/scene/scene_day_3.rpy:480
translate belarusian day_3_continue_f8129103:

    # "Хулиганы повернулись и молча уставились на меня."
    "Хуліганы павярнуліся і моўчкі ўтаропіліся на мяне."

# game/scripts/scene/scene_day_3.rpy:481
translate belarusian day_3_continue_b47fa530:

    # "Чистая ненависть сочилась из их глаз."
    "Чыстая нянавісць сачылася з іх вачэй."

# game/scripts/scene/scene_day_3.rpy:482
translate belarusian day_3_continue_087559fd:

    # "Но за что?"
    "Але за што?"

# game/scripts/scene/scene_day_3.rpy:483
translate belarusian day_3_continue_bbaa86c7:

    # "Что я такого им сделал? У них пропал друг, а они всё никак не могут забыть обо мне."
    "Што я такога ім зрабіў? У іх знік сябар, а яны ўсё ніяк не могуць забыць пра мяне."

# game/scripts/scene/scene_day_3.rpy:486
translate belarusian day_3_continue_e00966ca:

    # "Вдруг Бяшин взгляд упёрся мне в переносицу."
    "Раптам Бяшаў позірк упёрся мне ў пераноссе."

# game/scripts/scene/scene_day_3.rpy:488
translate belarusian day_3_continue_908c02b2:

    # "Казалось, он вот-вот ткнёт в меня пальцем и оглушительно закричит:"
    "Здавалася, ён вось-вось тыцне ў мяне пальцам і аглушальна закрычыць:"

# game/scripts/scene/scene_day_3.rpy:489
translate belarusian day_3_continue_412828f5:

    # "«Смотрите, эти очки вчера стащил Бабурин! Они вернулись к Антону! Убийца!»"
    "«Глядзіце, гэтыя акуляры ўчора сцягнуў Бабурын! Яны вярнуліся да Антона! Забойца!»"

# game/scripts/scene/scene_day_3.rpy:490
translate belarusian day_3_continue_0de233fe:

    # "Но он молчал, словно не находил в моих очках ничего примечательного."
    "Але ён маўчаў, быццам не знаходзіў у маіх акулярах нічога адметнага."

# game/scripts/scene/scene_day_3.rpy:495
translate belarusian day_3_continue_c9430732:

    # "Возможно, я схожу с ума, или Бяша что-то знает. Знает и не хочет об этом говорить."
    "Магчыма, я вар'яцею, або Бяша нешта ведае. Ведае і не хоча пра гэта гаварыць."

# game/scripts/scene/scene_day_3.rpy:498
translate belarusian day_3_continue_4a0bb051:

    # "Возможно, я схожу с ума, или Ромка что-то знает. Знает и не хочет об этом говорить."
    "Магчыма, я вар'яцею, або Ромка нешта ведае. Ведае і не хоча пра гэта гаварыць."

# game/scripts/scene/scene_day_3.rpy:499
translate belarusian day_3_continue_9b40204c:

    # "А может, ему просто всё равно. Как и всем прочим."
    "А можа, яму проста ўсё роўна. Як і ўсім астатнім."

# game/scripts/scene/scene_day_3.rpy:502
translate belarusian day_3_continue_96b3e2b2:

    # "Но тут Ромка подозрительно глянул на Катю, как будто сообщая, что ни капли ей не верит."
    "Але тут Ромка падазрона зірнуў на Кацю, быццам паведамляючы, што ні кроплі ёй не верыць."

# game/scripts/scene/scene_day_3.rpy:503
translate belarusian day_3_continue_b6c3bf3e:

    # "Мне искренне хотелось, чтобы Ромка меня поддержал."
    "Мне шчыра хацелася, каб Ромка мяне падтрымаў."

# game/scripts/scene/scene_day_3.rpy:504
translate belarusian day_3_continue_25a065e5:

    # "Как и Бяша, что развалился неподалёку, уткнувшись в парту подбородком."
    "Як і Бяша, што разваліўся непадалёк, упёршыся ў парту падбародкам."

# game/scripts/scene/scene_day_3.rpy:505
translate belarusian day_3_continue_cf5e8e6d:

    # "Но они молчали."
    "Але яны маўчалі."

# game/scripts/scene/scene_day_3.rpy:506
translate belarusian day_3_continue_c9f5c197:

    # "Меня настигла пугающая мысль, что эта парочка может легко меня предать, столкнуть в пропасть."
    "Мяне напаткала страшная думка, што гэта парачка можа лёгка мне здрадзіць, спіхнуць у прорву."

# game/scripts/scene/scene_day_3.rpy:507
translate belarusian day_3_continue_4d64e2a4:

    # "Как они уже поступили с Семёном."
    "Як яны ўжо зрабілі з Сямёнам."

# game/scripts/scene/scene_day_3.rpy:512
translate belarusian day_3_continue_9508a23b:

    # "Затем Рома тут же посмотрел на меня многозначительно, будто напоминал о своём обещании."
    "Затым Рома адразу паглядзеў на мяне шматзначна, быццам нагадваў пра сваё абяцанне."

# game/scripts/scene/scene_day_3.rpy:513
translate belarusian day_3_continue_4a9d59a0:

    # "Я помнил: ноющий висок не позволял забыть: держись подальше от Полины."
    "Я памятаў: ныючая скронь не дазваляла забыць: трымайся далей ад Паліны."

# game/scripts/scene/scene_day_3.rpy:518
translate belarusian day_3_continue_d5038291:

    # "Словно в поисках защиты, я до боли сжал линейку."
    "Быццам у пошуках абароны, я да болю сціснуў лінейку."

# game/scripts/scene/scene_day_3.rpy:523
translate belarusian day_3_continue_30aadd60:

    # voice "voice/kate/87 KA.ogg"
    # Kate "Не надо быть {u}Коломбо{/u}, чтобы догадаться..."
    voice "voice/kate/87 KA.ogg"
    Kate "Не трэба быць {u}Каломба{/u}, каб здагадацца..."

# game/scripts/scene/scene_day_3.rpy:526
translate belarusian day_3_continue_b43836a4:

    # voice "voice/kate/88 KA.ogg"
    # Kate "Кто на Бабурина зуб имел?"
    voice "voice/kate/88 KA.ogg"
    Kate "Хто на Бабурына зуб меў?"

# game/scripts/scene/scene_day_3.rpy:530
translate belarusian day_3_continue_639517e8:

    # voice "voice/kate/89 KA.ogg"
    # Kate "Кто его вчера ударил? Поиздевался, а после..."
    voice "voice/kate/89 KA.ogg"
    Kate "Хто яго ўчора ўдарыў? Паздзекаваўся, а пасля..."

# game/scripts/scene/scene_day_3.rpy:537
translate belarusian day_3_continue_780031dd:

    # "Металлическая линейка выпала из моих ослабевших пальцев, и её звон заставил детей встрепенуться."
    "Металічная лінейка выпала з маіх аслабелых пальцаў, і яе звон прымусіў дзяцей страпянуцца."

# game/scripts/scene/scene_day_3.rpy:547
translate belarusian day_3_continue_cc951a04:

    # "Катя осеклась и как-то боязливо съёжилась."
    "Каця асеклася і неяк баязліва скурчылася."

# game/scripts/scene/scene_day_3.rpy:548
translate belarusian day_3_continue_171dde4b:

    # "Заскрипели стулья: одноклассники отодвигались от меня поближе к выходу, к учительскому месту."
    "Заскрыпелі крэслы: аднакласнікі адсоўваліся ад мяне бліжэй да выхаду, да настаўніцкага месца."

# game/scripts/scene/scene_day_3.rpy:549
translate belarusian day_3_continue_6779d25a:

    # "И не я один уловил перемены: Ромка и Бяша тоже заметили и презрительно поморщились."
    "І не я адзін улавіў перамены: Ромка і Бяша таксама заўважылі і пагардліва скрывіліся."

# game/scripts/scene/scene_day_3.rpy:552
translate belarusian day_3_continue_005bbb2c:

    # "Плохо, что они не боялись меня, как остальные."
    "Дрэнна, што яны не баяліся мяне, як астатнія."

# game/scripts/scene/scene_day_3.rpy:554
translate belarusian day_3_continue_d6de9ec2:

    # "Хорошо, что они явно были за меня."
    "Добра, што яны відавочна былі за мяне."

# game/scripts/scene/scene_day_3.rpy:556
translate belarusian day_3_continue_b7e30369:

    # voice "voice/byasha/3day/71 Da.ogg"
    # Bya "Да прикуси ты."
    voice "voice/byasha/3day/71 Da.ogg"
    Bya "Ды прыкусі ты."

# game/scripts/scene/scene_day_3.rpy:563
translate belarusian day_3_continue_6e461953:

    # voice "voice/byasha/3day/72 Ba.ogg"
    # Bya "Бабурин, небось, с бабкой посрался и сдымил, на."
    voice "voice/byasha/3day/72 Ba.ogg"
    Bya "Бабурын, пэўна, з бабкай пасраўся і здыміў, на."

# game/scripts/scene/scene_day_3.rpy:565
translate belarusian day_3_continue_daa17f1d:

    # voice "voice/byasha/3day/73 Sc.ogg"
    # Bya "Скоро найдётся."
    voice "voice/byasha/3day/73 Sc.ogg"
    Bya "Хутка знойдзецца."

# game/scripts/scene/scene_day_3.rpy:568
translate belarusian day_3_continue_82562d22:

    # voice "voice/kate/90 KA.ogg"
    # Kate "Найдётся, ага."
    voice "voice/kate/90 KA.ogg"
    Kate "Знойдзецца, ага."

# game/scripts/scene/scene_day_3.rpy:570
translate belarusian day_3_continue_13930f3c:

    # voice "voice/kate/91 KA.ogg"
    # Kate "В овраге со вспоротым брюхом!"
    voice "voice/kate/91 KA.ogg"
    Kate "У яры са ўспоратым брухам!"

# game/scripts/scene/scene_day_3.rpy:575
translate belarusian day_3_continue_71e470a7:

    # "Я сглотнул."
    "Я праглынуў сліну."

# game/scripts/scene/scene_day_3.rpy:580
translate belarusian day_3_continue_82dd24de:

    # "Вообразил Сёму на снежной подушке: лицо белое, как рыбье брюхо, расколотое широкой трещиной рта, а падающие хлопья оседают на стеклянных глазах и заполняют гортань."
    "Уявіў Сёму на снежнай падушцы: твар белы, як рыбіна бруха, расколаты шырокай расколінай рота, а шматкі, што падаюць, асядаюць на шкляных вачах і запаўняюць гартань."

# game/scripts/scene/scene_day_3.rpy:581
translate belarusian day_3_continue_6a5efe49:

    # "«Видишь, — словно говорит он мне презрительно, — это всё твоя вина!»"
    "«Бачыш, — нібы кажа ён мне пагардліва, — гэта ўсё твая віна!»"

# game/scripts/scene/scene_day_3.rpy:584
translate belarusian day_3_continue_a7b9dc2f:

    # "Но разве только Семён издевался надо мной и получил сполна?"
    "Але хіба толькі Сямён здзекаваўся з мяне і атрымаў спаўна?"

# game/scripts/scene/scene_day_3.rpy:585
translate belarusian day_3_continue_f1031f9d:

    # Ant_m "Разве не все они должны исчезнуть: Ромка, Бяша, Катька, остальные зубоскалы?"
    Ant_m "Хіба не ўсе яны павінны знікнуць: Ромка, Бяша, Кацька, астатнія зубаскалы?"

# game/scripts/scene/scene_day_3.rpy:592
translate belarusian day_3_continue_541ffce5:

    # "Конечно, Семён услужил мне своим исчезновением. Благодаря ему взоры одноклассников были полны трепета."
    "Вядома, Сямён паслужыў мне сваім знікненнем. Дзякуючы яму позіркі аднакласнікаў былі поўныя трапятання."

# game/scripts/scene/scene_day_3.rpy:593
translate belarusian day_3_continue_1e1c68af:

    # "Но была и обратная сторона медали."
    "Але быў і адваротны бок медаля."

# game/scripts/scene/scene_day_3.rpy:594
translate belarusian day_3_continue_8f21df61:

    # "Что, если мне вскоре придётся заплатить за услугу?"
    "Што, калі мне неўзабаве давядзецца заплаціць за паслугу?"

# game/scripts/scene/scene_day_3.rpy:601
translate belarusian day_3_continue_0dbc0223:

    # "Дверь скрипнула — в класс вошла Полина."
    "Дзверы рыпнулі — у клас увайшла Паліна."

# game/scripts/scene/scene_day_3.rpy:606
translate belarusian day_3_continue_24f6ba17:

    # "Я весь подобрался, чтобы не выглядеть перед ней затравленным зверьком."
    "Я ўвесь падабраўся, каб не выглядаць перад ёй зацкаваным звярком."

# game/scripts/scene/scene_day_3.rpy:609
translate belarusian day_3_continue_1187af25:

    # "Полина, не взглянув на меня, села за парту."
    "Паліна, не зірнуўшы на мяне, села за парту."

# game/scripts/scene/scene_day_3.rpy:615
translate belarusian day_3_continue_eeee4e0c:

    # "Полина нашла меня взглядом, коротко кивнула и села за парту."
    "Паліна знайшла мяне позіркам, коратка кіўнула і села за парту."

# game/scripts/scene/scene_day_3.rpy:620
translate belarusian day_3_continue_b4b956a0:

    # "Катя вновь ринулась к соседкам, как крыса к угощениям, и зашушукала, косясь то на Полину, то на меня."
    "Каця зноў кінулася да суседак, як пацук да пачастункаў, і зашушукала, косячыся то на Паліну, то на мяне."

# game/scripts/scene/scene_day_3.rpy:624
translate belarusian day_3_continue_72c7f978:

    # "По классу запрыгали записки."
    "Па класе заскакалі запіскі."

# game/scripts/scene/scene_day_3.rpy:628
translate belarusian day_3_continue_2159143a:

    # "Задребезжала трель звонка, извещая о начале урока."
    "Задражэла трэль званка, абвяшчаючы пачатак урока."

# game/scripts/scene/scene_day_3.rpy:637
translate belarusian day_3_continue_ae58b388:

    # voice "voice/lydia/3day/01 Tak.ogg"
    # Teacher "Так, заканчиваем бардак. Дети, встаньте."
    voice "voice/lydia/3day/01 Tak.ogg"
    Teacher "Так, заканчваем бардак. Дзеці, устаньце."

# game/scripts/scene/scene_day_3.rpy:640
translate belarusian day_3_continue_fe1c2d01:

    # voice "voice/lydia/3day/02 Pe.ogg"
    # Teacher "Петров, тебя это тоже касается!"
    voice "voice/lydia/3day/02 Pe.ogg"
    Teacher "Пятроў, цябе гэта таксама тычыцца!"

# game/scripts/scene/scene_day_3.rpy:668
translate belarusian day_3_continue_4638d7c1:

    # "Лилия Павловна прошла к столу, а за ней в кабинет вошёл милиционер при параде."
    "Лілія Паўлаўна прайшла да стала, а за ёй у кабінет увайшоў міліцыянер пры парадзе."

# game/scripts/scene/scene_day_3.rpy:670
translate belarusian day_3_continue_f410cd37:

    # "Тот, что приходил недавно в наш дом. Высокий, с пронзительным взглядом, под которым ты гнёшься, как лоза."
    "Той, што прыходзіў нядаўна ў наш дом. Высокі, з пранізлівым позіркам, пад якім ты гнешся, як лаза."

# game/scripts/scene/scene_day_3.rpy:683
translate belarusian day_3_continue_f11d7f31:

    # voice "voice/tihonov/3day/21Z.ogg"
    # Mil "Кхм... Здрастье."
    voice "voice/tihonov/3day/21Z.ogg"
    Mil "Кхм... Добры дзень."

# game/scripts/scene/scene_day_3.rpy:687
translate belarusian day_3_continue_f30f9558:

    # voice "voice/Child/3day/02 Zdras.ogg"
    # Childs "Здрав-ствуй-те!"
    voice "voice/Child/3day/02 Zdras.ogg"
    Childs "Доб-ры дзень!"

# game/scripts/scene/scene_day_3.rpy:691
translate belarusian day_3_continue_a63d705f:

    # voice "voice/lydia/3day/03 S.ogg"
    # Teacher "Садитесь."
    voice "voice/lydia/3day/03 S.ogg"
    Teacher "Сядайце."

# game/scripts/scene/scene_day_3.rpy:694
translate belarusian day_3_continue_142136e4:

    # voice "voice/lydia/3day/04 P.ogg"
    # Teacher "Познакомьтесь — это старший лейтенант Константин Владимирович Тихонов."
    voice "voice/lydia/3day/04 P.ogg"
    Teacher "Пазнаёмцеся — гэта старшы лейтэнант Канстанцін Уладзіміравіч Ціханаў."

# game/scripts/scene/scene_day_3.rpy:696
translate belarusian day_3_continue_d967df98:

    # voice "voice/lydia/3day/05 On.ogg"
    # Teacher "Он задаст вам несколько вопросов и проведёт небольшую лекцию по безопасности."
    voice "voice/lydia/3day/05 On.ogg"
    Teacher "Ён задасць вам некалькі пытанняў і правядзе невялікую лекцыю па бяспецы."

# game/scripts/scene/scene_day_3.rpy:705
translate belarusian day_3_continue_000a4690:

    # "Одноклассники оживились: лучше лекция от милиционера, чем уроки!"
    "Аднакласнікі ажывіліся: лепш лекцыя ад міліцыянера, чым урокі!"

# game/scripts/scene/scene_day_3.rpy:706
translate belarusian day_3_continue_ae045e3e:

    # "А я готов был высидеть сто часов русской литературы, лишь бы не терпеть на себе давящий взор лейтенанта."
    "А я гатовы быў выседзець сто гадзін рускай літаратуры, абы не цярпець на сабе ціснучы позірк лейтэнанта."

# game/scripts/scene/scene_day_3.rpy:709
translate belarusian day_3_continue_fb52093d:

    # "Карие глаза нащупали меня среди учеников. Волосы на моём затылке зашевелились от ужаса, ледяной кол впился в кишки."
    "Карыя вочы намацалі мяне сярод вучняў. Валасы на маёй патыліцы заварушыліся ад жаху, ледзяны кол упіўся ў кішкі."

# game/scripts/scene/scene_day_3.rpy:715
translate belarusian day_3_continue_47d56722:

    # voice "voice/kate/93 KA.ogg"
    # Kate "А правда, что Бабурина маньяк убил?"
    voice "voice/kate/93 KA.ogg"
    Kate "А праўда, што Бабурына маньяк забіў?"

# game/scripts/scene/scene_day_3.rpy:721
translate belarusian day_3_continue_9faa9385:

    # voice "voice/lydia/3day/06 E.ogg"
    # Teacher "Екатерина, ну-ка цыц! Вопросы здесь взрослые задают."
    voice "voice/lydia/3day/06 E.ogg"
    Teacher "Кацярына, ну-ка цыц! Пытанні тут дарослыя задаюць."

# game/scripts/scene/scene_day_3.rpy:726
translate belarusian day_3_continue_d9502d19:

    # voice "voice/kate/94 KA.ogg"
    # Kate "Просто нам всем страшно."
    voice "voice/kate/94 KA.ogg"
    Kate "Проста нам усім страшна."

# game/scripts/scene/scene_day_3.rpy:729
translate belarusian day_3_continue_c5c40ebf:

    # voice "voice/kate/95 KA.ogg"
    # Kate "Может, убийца бродит где-то рядом."
    voice "voice/kate/95 KA.ogg"
    Kate "Можа, забойца блукае недзе побач."

# game/scripts/scene/scene_day_3.rpy:732
translate belarusian day_3_continue_046b4f3e:

    # voice "voice/kate/96 KA.ogg"
    # Kate "Или сидит у нас за спиной..."
    voice "voice/kate/96 KA.ogg"
    Kate "Ці сядзіць у нас за спіной..."

# game/scripts/scene/scene_day_3.rpy:735
translate belarusian day_3_continue_e7d431ec:

    # "Хитрый лисий взгляд обращался ко мне."
    "Хітры лісіны позірк звяртаўся да мяне."

# game/scripts/scene/scene_day_3.rpy:738
translate belarusian day_3_continue_8f74996d:

    # "Тихонов шагнул в проход между рядами и медленно, невыносимо медленно пошёл, касаясь пальцами спинок стульев."
    "Ціханаў ступіў у праход паміж радамі і павольна, невыносна павольна пайшоў, кранаючы пальцамі спінкі крэслаў."

# game/scripts/scene/scene_day_3.rpy:739
translate belarusian day_3_continue_e0d67ab5:

    # "Ученики едва шеи себе не сворачивали, пристально за ним наблюдая."
    "Вучні ледзь шыі сабе не звярталі, пільна за ім назіраючы."

# game/scripts/scene/scene_day_3.rpy:740
translate belarusian day_3_continue_6870d412:

    # "Так в средневековье зеваки предвкушали публичную экзекуцию."
    "Так у сярэднявеччы разявакі прадчувалі публічную экзэкуцыю."

# game/scripts/scene/scene_day_3.rpy:742
translate belarusian day_3_continue_c53d1491:

    # "А он шёл, неумолимо приближаясь."
    "А ён ішоў, няўмольна набліжаючыся."

# game/scripts/scene/scene_day_3.rpy:744
translate belarusian day_3_continue_8b5f4cce:

    # "Я сжал зубы, удерживая вскрик."
    "Я сціснуў зубы, стрымліваючы ўскрык."

# game/scripts/scene/scene_day_3.rpy:748
translate belarusian day_3_continue_049dcc9f:

    # Ant_m "{i}Спокойно! Дыши!{/i}"
    Ant_m "{i}Спакойна! Дыхай!{/i}"

# game/scripts/scene/scene_day_3.rpy:750
translate belarusian day_3_continue_bb9f50f8:

    # Ant_m "{i}Ты никого не убивал и не похищал.{/i}"
    Ant_m "{i}Ты нікога не забіваў і не выкрадаў.{/i}"

# game/scripts/scene/scene_day_3.rpy:752
translate belarusian day_3_continue_03d0d3ff:

    # "Заранее зная ответ, Тихонов строго спросил:"
    "Загадзя ведаючы адказ, Ціханаў строга спытаў:"

# game/scripts/scene/scene_day_3.rpy:754
translate belarusian day_3_continue_266abebd:

    # voice "voice/tihonov/3day/22 P.ogg"
    # Tikhonov "Петров Антон?"
    voice "voice/tihonov/3day/22 P.ogg"
    Tikhonov "Пятроў Антон?"

# game/scripts/scene/scene_day_3.rpy:757
translate belarusian day_3_continue_98f42b22:

    # voice "voice/anton/3day/001.D.ogg"
    # Ant "Да."
    voice "voice/anton/3day/001.D.ogg"
    Ant "Так."

# game/scripts/scene/scene_day_3.rpy:761
translate belarusian day_3_continue_81fd515a:

    # voice "voice/lydia/3day/07 V.ogg"
    # Teacher "Встань, Петров."
    voice "voice/lydia/3day/07 V.ogg"
    Teacher "Устань, Пятроў."

# game/scripts/scene/scene_day_3.rpy:771
translate belarusian day_3_continue_aa37617a:

    # "Мышцы окаменели. Я встал, отклеился от стула, почти услышав треск суставов."
    "Мышцы скамянелі. Я ўстаў, адклеіўся ад крэсла, амаль пачуўшы трэск суставаў."

# game/scripts/scene/scene_day_3.rpy:772
translate belarusian day_3_continue_006f05a9:

    # "Хоть бы Полина не оборачивалась, не видела мою застывшую в ужасе гримасу."
    "Хоць бы Паліна не азіралася, не бачыла маю застылую ў жаху грымасу."

# game/scripts/scene/scene_day_3.rpy:773
translate belarusian day_3_continue_e8efeea0:

    # "Очутиться бы сейчас где-нибудь далеко, в лесу, зарыться в сугроб и сжаться комочком."
    "Апынуцца б цяпер недзе далёка, у лесе, закапацца ў сумёт і сціснуцца камячком."

# game/scripts/scene/scene_day_3.rpy:774
translate belarusian day_3_continue_fe46d0f2:

    # "Лейтенант глазел так, словно уже застёгивал наручники на моих запястьях. Они наверняка холодные, эти браслеты."
    "Лейтэнант лупіў вочы так, нібы ўжо зашпільваў кайданкі на маіх запясцях. Яны напэўна халодныя, гэтыя бранзалеты."

# game/scripts/scene/scene_day_3.rpy:775
translate belarusian day_3_continue_44f96fba:

    # "В голове носились мысли о тюрьме, о детской колонии, где десятки Семёнов не оставят на мне живого места."
    "У галаве насіліся думкі пра турму, пра дзіцячую калонію, дзе дзясяткі Сямёнаў не пакінуць на мне жывога месца."

# game/scripts/scene/scene_day_3.rpy:781
translate belarusian day_3_continue_cbedba12:

    # voice "voice/anton/3day/002 Ya.ogg"
    # Ant "Я ничего не знаю. Я тут ни при чём."
    voice "voice/anton/3day/002 Ya.ogg"
    Ant "Я нічога не ведаю. Я тут ні пры чым."

# game/scripts/scene/scene_day_3.rpy:784
translate belarusian day_3_continue_643c9ba6:

    # voice "voice/tihonov/3day/23 A.ogg"
    # Tikhonov "А тебя никто и не обвиняет..."
    voice "voice/tihonov/3day/23 A.ogg"
    Tikhonov "А цябе ніхто і не абвінавачвае..."

# game/scripts/scene/scene_day_3.rpy:786
translate belarusian day_3_continue_d244d028:

    # voice "voice/tihonov/3day/24 P.ogg"
    # Tikhonov "... пока что."
    voice "voice/tihonov/3day/24 P.ogg"
    Tikhonov "... пакуль што."

# game/scripts/scene/scene_day_3.rpy:794
translate belarusian day_3_continue_8dda026d:

    # "Только теперь я заметил папку с надписью «ДЕЛО» в его руке, серую, из шершавого картона."
    "Толькі цяпер я заўважыў папку з надпісам «СПРАВА» у яго руцэ, шэрую, з шурпатага кардона."

# game/scripts/scene/scene_day_3.rpy:796
translate belarusian day_3_continue_42e9fb08:

    # "Она шлёпнулась о стол — словно опустилось лезвие гильотины."
    "Яна ляснула аб стол — нібы апусцілася лязо гільяціны."

# game/scripts/scene/scene_day_3.rpy:801
translate belarusian day_3_continue_8e499ac1:

    # "Неторопливо, продолжая меня изучать, Тихонов открыл папку."
    "Марудна, працягваючы мяне вывучаць, Ціханаў адчыніў папку."

# game/scripts/scene/scene_day_3.rpy:802
translate belarusian day_3_continue_531d0e60:

    # "Краем глаза я видел бумаги и фотографии. На снимках были следы на снегу, кажется, звериные."
    "Краем вока я бачыў паперы і фотаздымкі. На здымках былі сляды на снезе, здаецца, звярыныя."

# game/scripts/scene/scene_day_3.rpy:804
translate belarusian day_3_continue_c27fc9f1:

    # voice "voice/tihonov/3day/25 T.ogg"
    # Tikhonov "Ты с Семёном Бабуриным общался?"
    voice "voice/tihonov/3day/25 T.ogg"
    Tikhonov "Ты з Сямёнам Бабурыным меў зносіны?"

# game/scripts/scene/scene_day_3.rpy:807
translate belarusian day_3_continue_84ec3fe8:

    # voice "voice/anton/3day/004 N.ogg"
    # Ant "Я знал его всего одну неделю."
    voice "voice/anton/3day/004 N.ogg"
    Ant "Я ведаў яго ўсяго адзін тыдзень."

# game/scripts/scene/scene_day_3.rpy:810
translate belarusian day_3_continue_08477504:

    # voice "voice/anton/3day/003 od.ogg"
    # Ant "Я знал его всего один день."
    voice "voice/anton/3day/003 od.ogg"
    Ant "Я ведаў яго ўсяго адзін дзень."

# game/scripts/scene/scene_day_3.rpy:816
translate belarusian day_3_continue_4c648dd0:

    # voice "voice/kate/97 KA.ogg"
    # Kate "Все знают: Петров его ненавидел."
    voice "voice/kate/97 KA.ogg"
    Kate "Усе ведаюць: Пятроў яго ненавідзеў."

# game/scripts/scene/scene_day_3.rpy:819
translate belarusian day_3_continue_c0e3f91b:

    # "Я покраснел."
    "Я пачырванеў."

# game/scripts/scene/scene_day_3.rpy:820
translate belarusian day_3_continue_43823f77:

    # Ant_m "{i}Ах ты мерзкая сука.{/i}"
    Ant_m "{i}Ах ты мярзотная сука.{/i}"

# game/scripts/scene/scene_day_3.rpy:821
translate belarusian day_3_continue_4a40a557:

    # "{i}Захотелось вцепиться зубами в Катино лицо и выгрызть ей щёку.{/i}"
    "{i}Захацелася ўчапіцца зубамі ў Кацін твар і выгрызці ёй шчаку.{/i}"

# game/scripts/scene/scene_day_3.rpy:834
translate belarusian day_3_continue_8012cf48:

    # "Но я сказал, совладав с голосом:"
    "Але я сказаў, авалодаўшы голасам:"

# game/scripts/scene/scene_day_3.rpy:845
translate belarusian day_3_continue_ead38bfe:

    # voice "voice/anton/3day/006 Mi.ogg"
    # Ant "Мы повздорили не так давно."
    voice "voice/anton/3day/006 Mi.ogg"
    Ant "Мы пасварыліся не так даўно."

# game/scripts/scene/scene_day_3.rpy:847
translate belarusian day_3_continue_64f50be0:

    # voice "voice/anton/3day/007 On.ogg"
    # Ant "Он меня ударил."
    voice "voice/anton/3day/007 On.ogg"
    Ant "Ён мяне ўдарыў."

# game/scripts/scene/scene_day_3.rpy:853
translate belarusian day_3_continue_f7717380:

    # "Сбоку донеслось:"
    "Збоку данеслася:"

# game/scripts/scene/scene_day_3.rpy:857
translate belarusian day_3_continue_a132e3d6:

    # voice "voice/romka/3day/03 Xa.ogg"
    # Rom "Хана тебе."
    voice "voice/romka/3day/03 Xa.ogg"
    Rom "Хана табе."

# game/scripts/scene/scene_day_3.rpy:860
translate belarusian day_3_continue_0414d9e8:

    # voice "voice/lydia/3day/08 Ta.ogg"
    # Teacher "Так, Пятифанов, а ну рот закрой!"
    voice "voice/lydia/3day/08 Ta.ogg"
    Teacher "Так, Пяціфанаў, а ну рот закрый!"

# game/scripts/scene/scene_day_3.rpy:863
translate belarusian day_3_continue_c2f3945d:

    # "Я пошатнулся, чудом устояв на ногах."
    "Я пахіснуўся, цудам утрымаўшыся на нагах."

# game/scripts/scene/scene_day_3.rpy:873
translate belarusian day_3_continue_ee240823:

    # voice "voice/anton/3day/005 m.ogg"
    # Ant "Мы повздорили вчера."
    voice "voice/anton/3day/005 m.ogg"
    Ant "Мы пасварыліся ўчора."

# game/scripts/scene/scene_day_3.rpy:880
translate belarusian day_3_continue_35fcc291:

    # voice "voice/anton/3day/008 NOon.ogg"
    # Ant "Но он первый начал."
    voice "voice/anton/3day/008 NOon.ogg"
    Ant "Але ён першы пачаў."

# game/scripts/scene/scene_day_3.rpy:888
translate belarusian day_3_continue_b104bd27:

    # voice "voice/anton/3day/009 Ya.ogg"
    # Ant "Я его ударил."
    voice "voice/anton/3day/009 Ya.ogg"
    Ant "Я яго ўдарыў."

# game/scripts/scene/scene_day_3.rpy:897
translate belarusian day_3_continue_940568c3:

    # voice "voice/tihonov/3day/26 S.ogg"
    # Tikhonov "Сильно?"
    voice "voice/tihonov/3day/26 S.ogg"
    Tikhonov "Моцна?"

# game/scripts/scene/scene_day_3.rpy:907
translate belarusian day_3_continue_62efdc80:

    # voice "voice/anton/3day/010 D.ogg"
    # Ant "Да нет. Так..."
    voice "voice/anton/3day/010 D.ogg"
    Ant "Ды не. Так..."

# game/scripts/scene/scene_day_3.rpy:918
translate belarusian day_3_continue_5478d386:

    # "Я неопределённо махнул рукой."
    "Я няпэўна махнуў рукой."

# game/scripts/scene/scene_day_3.rpy:921
translate belarusian day_3_continue_ec549af5:

    # "Тихонов посмотрел на мой кулак, будто удивляясь, что я способен стукнуть громилу с фотографии."
    "Ціханаў паглядзеў на мой кулак, быццам здзіўляючыся, што я здольны стукнуць грамілу з фотаздымка."

# game/scripts/scene/scene_day_3.rpy:924
translate belarusian day_3_continue_4fc2290e:

    # "Лилия Павловна неожиданно пришла мне на помощь."
    "Лілія Паўлаўна нечакана прыйшла мне на дапамогу."

# game/scripts/scene/scene_day_3.rpy:927
translate belarusian day_3_continue_a384c2e5:

    # voice "voice/lydia/3day/09 Ba.ogg"
    # Teacher "Бабурин — проблемный подросток. С шилом кое-где."
    voice "voice/lydia/3day/09 Ba.ogg"
    Teacher "Бабурын — праблемны падлетак. З шылам сёе-дзе."

# game/scripts/scene/scene_day_3.rpy:931
translate belarusian day_3_continue_1fc23bb7:

    # voice "voice/lydia/3day/10 S.ogg"
    # Teacher "Сам ко всем лез."
    voice "voice/lydia/3day/10 S.ogg"
    Teacher "Сам да ўсіх лез."

# game/scripts/scene/scene_day_3.rpy:940
translate belarusian day_3_continue_27776e8e:

    # "Старлей многозначительно кивнул и вдруг выудил из папки тетрадь."
    "Старлей шматзначна кіўнуў і раптам выцягнуў з папкі сшытак."

# game/scripts/scene/scene_day_3.rpy:958
translate belarusian day_3_continue_cd49a71f:

    # voice "voice/tihonov/3day/27 A.ogg"
    # Tikhonov "Это твоё?"
    voice "voice/tihonov/3day/27 A.ogg"
    Tikhonov "Гэта тваё?"

# game/scripts/scene/scene_day_3.rpy:961
translate belarusian day_3_continue_157cbabb:

    # "Я отвёл взгляд."
    "Я адвёў позірк."

# game/scripts/scene/scene_day_3.rpy:962
translate belarusian day_3_continue_a02bd7d9:

    # "Это была подписанная мною тетрадь по математике."
    "Гэта быў падпісаны мной сшытак па матэматыцы."

# game/scripts/scene/scene_day_3.rpy:963
translate belarusian day_3_continue_6739d6d3:

    # "Взгляды одноклассников жадно впились в меня. Даже писатели на портретах будто бы подозрительно сощурились."
    "Позіркі аднакласнікаў прагна ўпіліся ў мяне. Нават пісьменнікі на партрэтах быццам бы падазрона прыжмурыліся."

# game/scripts/scene/scene_day_3.rpy:964
translate belarusian day_3_continue_f10d8d32:

    # voice "voice/anton/3day/011M.ogg"
    # Ant "М-моё."
    voice "voice/anton/3day/011M.ogg"
    Ant "М-маё."

# game/scripts/scene/scene_day_3.rpy:967
translate belarusian day_3_continue_6fac90b0:

    # voice "voice/tihonov/3day/28 V.ogg"
    # Tikhonov "В лесу нашли."
    voice "voice/tihonov/3day/28 V.ogg"
    Tikhonov "У лесе знайшлі."

# game/scripts/scene/scene_day_3.rpy:970
translate belarusian day_3_continue_d65fd6ed:

    # voice "voice/tihonov/3day/29 T.ogg"
    # Tikhonov "Там же тракторист, что снег убирал, в последний раз видел Бабурина."
    voice "voice/tihonov/3day/29 T.ogg"
    Tikhonov "Там жа трактарыст, што снег прыбіраў, у апошні раз бачыў Бабурына."

# game/scripts/scene/scene_day_3.rpy:973
translate belarusian day_3_continue_36629d6b:

    # "Я растерянно заморгал."
    "Я разгублена замаргаў."

# game/scripts/scene/scene_day_3.rpy:974
translate belarusian day_3_continue_d7c9752c:

    # "Рюкзак распотрошил Ромка — тетрадь наверняка затерялась где-то под кустом."
    "Заплечнік вытрыбушыў Ромка — сшытак напэўна згубіўся недзе пад кустом."

# game/scripts/scene/scene_day_3.rpy:975
translate belarusian day_3_continue_ac11e9f4:

    # "Лейтенант в курсе насчёт школьной потасовки, но знает ли он про драку на опушке?"
    "Лейтэнант у курсе наконт школьнай бойкі, але ці ведае ён пра бойку на ўзлеску?"

# game/scripts/scene/scene_day_3.rpy:976
translate belarusian day_3_continue_9a94fe76:

    # "У меня были свидетели, которые могли бы подтвердить, что мы с Семёном разошлись по разные стороны баррикад."
    "У мяне былі сведкі, якія маглі б пацвердзіць, што мы з Сямёнам разышліся па розныя бакі барыкад."

# game/scripts/scene/scene_day_3.rpy:978
translate belarusian day_3_continue_e989b41c:

    # "В надежде я посмотрел на ребят."
    "З надзеяй я паглядзеў на хлопцаў."

# game/scripts/scene/scene_day_3.rpy:985
translate belarusian day_3_continue_8fe63a43:

    # "За спиной Тихонова Ромка прикоснулся указательным пальцем к губам."
    "За спіной Ціханава Ромка дакрануўся ўказальным пальцам да вуснаў."

# game/scripts/scene/scene_day_3.rpy:988
translate belarusian day_3_continue_657c3492:

    # "И притворился, что ковыряется в носу, когда лейтенант быстро обернулся."
    "І прыкінуўся, што калупаецца ў носе, калі лейтэнант хутка азірнуўся."

# game/scripts/scene/scene_day_3.rpy:989
translate belarusian day_3_continue_fd291457:

    # "Я расшифровал сигнал."
    "Я расшыфраваў сігнал."

# game/scripts/scene/scene_day_3.rpy:990
translate belarusian day_3_continue_b933972d:

    # "Из уст таких ребят, как Ромка, это прозвучало бы как «смотри не мусарнись»."
    "З вуснаў такіх хлопцаў, як Ромка, гэта прагучала б як «глядзі не мусарніся»."

# game/scripts/scene/scene_day_3.rpy:996
translate belarusian day_3_continue_ec91d831:

    # "Я судорожно поправил очки."
    "Я сутаргава паправіў акуляры."

# game/scripts/scene/scene_day_3.rpy:997
translate belarusian day_3_continue_6158543b:

    # "Но ведь Семён унёс их вчера с собой, а сейчас они..."
    "Але ж Сямён панёс іх учора з сабой, а цяпер яны..."

# game/scripts/scene/scene_day_3.rpy:999
translate belarusian day_3_continue_ef233091:

    # voice "voice/tihonov/3day/31 Tak.ogg"
    # Tikhonov "Так что ты делал вчера в лесу, Антон?"
    voice "voice/tihonov/3day/31 Tak.ogg"
    Tikhonov "Дык што ты рабіў учора ў лесе, Антон?"

# game/scripts/scene/scene_day_3.rpy:1005
translate belarusian day_3_continue_4d0f6945:

    # voice "voice/anton/3day/012Ya.ogg"
    # Ant "Я в школу через лес хожу."
    voice "voice/anton/3day/012Ya.ogg"
    Ant "Я ў школу праз лес хаджу."

# game/scripts/scene/scene_day_3.rpy:1012
translate belarusian day_3_continue_5537060c:

    # voice "voice/anton/3day/012M.ogg"
    # Ant "Могла выпасть легко."
    voice "voice/anton/3day/012M.ogg"
    Ant "Мог выпасці лёгка."

# game/scripts/scene/scene_day_3.rpy:1020
translate belarusian day_3_continue_3b7f1d89:

    # "Легко – именно так далась мне эта половинчатая правда."
    "Лёгка — менавіта так далася мне гэта палавіністая праўда."

# game/scripts/scene/scene_day_3.rpy:1027
translate belarusian day_3_continue_4ee7ada5:

    # voice "voice/tihonov/3day/32 B.ogg"
    # Tikhonov "Будь осторожнее."
    voice "voice/tihonov/3day/32 B.ogg"
    Tikhonov "Будзь асцярожнейшы."

# game/scripts/scene/scene_day_3.rpy:1032
translate belarusian day_3_continue_860af83f:

    # "И прежде чем я понял, угроза это или пожелание, учительница сказала:"
    "І перш чым я зразумеў, пагроза гэта ці пажаданне, настаўніца сказала:"

# game/scripts/scene/scene_day_3.rpy:1034
translate belarusian day_3_continue_d6918654:

    # voice "voice/lydia/3day/11 K.ogg"
    # Teacher "Класс, а сейчас лейтенант расскажет о правилах, которые вам необходимо соблюдать."
    voice "voice/lydia/3day/11 K.ogg"
    Teacher "Клас, а цяпер лейтэнант раскажа пра правілы, якіх вам неабходна трымацца."

# game/scripts/scene/scene_day_3.rpy:1042
translate belarusian day_3_continue_f379cb98:

    # voice "voice/kate/98 KA.ogg"
    # Kate "Так маньяк всё-таки есть!"
    voice "voice/kate/98 KA.ogg"
    Kate "Дык маньяк усё ж такі ёсць!"

# game/scripts/scene/scene_day_3.rpy:1047
translate belarusian day_3_continue_2953426d:

    # voice "voice/tihonov/3day/34 P.ogg"
    # Tikhonov "Пока мы ничего вам сказать не можем."
    voice "voice/tihonov/3day/34 P.ogg"
    Tikhonov "Пакуль мы нічога вам сказаць не можам."

# game/scripts/scene/scene_day_3.rpy:1061
translate belarusian day_3_continue_425ba6e3:

    # "Ромка качнулся на стуле и показал мне большой палец: молоток, мол, держал язык за зубами."
    "Ромка гайдануўся на крэсле і паказаў мне вялікі палец: малайчына, маўляў, трымаў язык за зубамі."

# game/scripts/scene/scene_day_3.rpy:1062
translate belarusian day_3_continue_995c643b:

    # "Я кивнул, хотя не ощутил ни малейшей гордости от его похвалы."
    "Я кіўнуў, хоць не адчуў ні найменшай гордасці ад яго пахвалы."

# game/scripts/scene/scene_day_3.rpy:1066
translate belarusian day_3_continue_53d5b6c0:

    # "В конце концов, именно Ромка раскидал мои тетради и учебники по снегу, и он же руководил Семёном, пускай потом и поменял союзников."
    "У рэшце рэшт, менавіта Ромка раскідаў мае сшыткі і падручнікі па снезе, і ён жа кіраваў Сямёнам, хай сабе потым і памяняў саюзнікаў."

# game/scripts/scene/scene_day_3.rpy:1077
translate belarusian day_3_continue_052ebeba:

    # voice "voice/tihonov/3day/35 no.ogg"
    # Tikhonov "Но есть преступник или нет, вы должны чётко помнить о собственной безопасности."
    voice "voice/tihonov/3day/35 no.ogg"
    Tikhonov "Але ёсць злачынец ці не, вы павінны выразна памятаць пра ўласную бяспеку."

# game/scripts/scene/scene_day_3.rpy:1080
translate belarusian day_3_continue_492fb496:

    # voice "voice/tihonov/3day/36 V.ogg"
    # Tikhonov "Вас бережёт милиция, вас опекают родители и учителя, но в первую очередь защищать себя должны вы сами."
    voice "voice/tihonov/3day/36 V.ogg"
    Tikhonov "Вас беражэ міліцыя, вас апякуюць бацькі і настаўнікі, але ў першую чаргу абараняць сябе павінны вы самі."

# game/scripts/scene/scene_day_3.rpy:1085
translate belarusian day_3_continue_91d40941:

    # voice "voice/tihonov/3day/37 Ita.ogg"
    # Tikhonov "Итак... Кто там что хотел узнать?"
    voice "voice/tihonov/3day/37 Ita.ogg"
    Tikhonov "Такім чынам... Хто там што хацеў даведацца?"

# game/scripts/scene/scene_day_3.rpy:1089
translate belarusian day_3_continue_fdef2ce4:

    # "Лес рук взвился над партами."
    "Лес рук узвіўся над партамі."

# game/scripts/scene/scene_day_3.rpy:1091
translate belarusian day_3_continue_1e21601d:

    # "Дети загалдели, забрасывая милиционера вопросами."
    "Дзеці загаманілі, закідваючы міліцыянера пытаннямі."

# game/scripts/scene/scene_day_3.rpy:1093
translate belarusian day_3_continue_a36c42c5:

    # "Стараясь усмирить хор, он двинулся к доске."
    "Стараючыся ўціхамірыць хор, ён рушыў да дошкі."

# game/scripts/scene/scene_day_3.rpy:1096
translate belarusian day_3_continue_bbcd0105:

    # "Серая папка осталась лежать передо мной."
    "Шэрая папка засталася ляжаць перада мной."

# game/scripts/scene/scene_day_3.rpy:1098
translate belarusian day_3_continue_d5480dee:

    # "Я смотрел на неё и дышал как человек, пробежавший стометровку."
    "Я глядзеў на яе і дыхаў як чалавек, які прабег стометроўку."

# game/scripts/scene/scene_day_3.rpy:1099
translate belarusian day_3_continue_41684f66:

    # "Под свитером струился пот."
    "Пад швэдрам струменіўся пот."

# game/scripts/scene/scene_day_3.rpy:1129
translate belarusian day_3_continue_0e33c663:

    # "Я оглядел кабинет." id day_3_continue_0e33c663
    "Я агледзеў кабінет." id day_3_continue_0e33c663

# game/scripts/scene/scene_day_3.rpy:1130
translate belarusian day_3_continue_c6337233:

    # "Все дети внимали лектору." id day_3_continue_c6337233
    "Усе дзеці ўважліва слухалі лектара." id day_3_continue_c6337233

# game/scripts/scene/scene_day_3.rpy:1132
translate belarusian day_3_continue_64b5806a:

    # "Только Ромка что-то говорил Бяше." id day_3_continue_64b5806a
    "Толькі Ромка нешта казаў Бяшу." id day_3_continue_64b5806a

# game/scripts/scene/scene_day_3.rpy:1134
translate belarusian day_3_continue_d8d63774:

    # "А Лилия Павловна, сражаясь с зевотой, пялилась в окно." id day_3_continue_d8d63774
    "А Лілія Паўлаўна, змагаючыся з пазяханнем, утаропілася ў акно." id day_3_continue_d8d63774

# game/scripts/scene/scene_day_3.rpy:1156
translate belarusian minigame_folder_hit1_6b83c22b:

    # "Никто не обращал на меня внимания, и я открыл папку одной рукой."
    "Ніхто не звяртаў на мяне ўвагі, і я адчыніў папку адной рукой."

# game/scripts/scene/scene_day_3.rpy:1158
translate belarusian minigame_folder_hit1_2af699c9:

    # "Пальцы заспешили, перебирая бумаги."
    "Пальцы заспяшаліся, перабіраючы паперы."

# game/scripts/scene/scene_day_3.rpy:1162
translate belarusian minigame_folder_hit1_6982bf2a:

    # "Ксения Талалаева, шесть лет. Ушла из дома в конце декабря. Особые приметы, ага..."
    "Ксенія Талалаева, шэсць гадоў. Пайшла з дому ў канцы снежня. Асаблівыя прыкметы, ага..."

# game/scripts/scene/scene_day_3.rpy:1163
translate belarusian minigame_folder_hit1_a1c42e54:

    # "Сердце подскочило в груди. На фотографии улыбалась круглолицая девочка не старше Оли."
    "Сэрца падскочыла ў грудзях. На фотаздымку ўсміхалася круглатварая дзяўчынка не старэйшая за Олю."

# game/scripts/scene/scene_day_3.rpy:1164
translate belarusian minigame_folder_hit1_4a03f99a:

    # "Первая жертва маньяка? Первый ребёнок, растворившийся бесследно в ночном лесу?"
    "Першая ахвяра маньяка? Першае дзіця, што растварылася бясследна ў начным лесе?"

# game/scripts/scene/scene_day_3.rpy:1169
translate belarusian minigame_folder_hit1_3b9cdc5a:

    # "Я перелистнул документы."
    "Я перагартаў дакументы."

# game/scripts/scene/scene_day_3.rpy:1173
translate belarusian minigame_folder_hit1_3c23d0de:

    # "Владимир Матюхин, 10 лет."
    "Уладзімір Мацюхін, 10 гадоў."

# game/scripts/scene/scene_day_3.rpy:1174
translate belarusian minigame_folder_hit1_d998dd0c:

    # "Вова был вторым."
    "Вова быў другім."

# game/scripts/scene/scene_day_3.rpy:1175
translate belarusian minigame_folder_hit1_ca85c373:

    # "Его варежка болталась на суку, его имя выкрикивали отчаявшиеся взрослые и повторяло глумливое эхо..."
    "Яго рукавічка боўталася на суку, яго імя выкрыквалі разгубленыя дарослыя і паўтарала здзеклівае рэха..."

# game/scripts/scene/scene_day_3.rpy:1180
translate belarusian minigame_folder_hit1_e0f977da:

    # "Лилия Павловна кашлянула, призывая к дисциплине расшумевшихся учеников."
    "Лілія Паўлаўна кашлянула, заклікаючы да дысцыпліны вучняў, якія расшумеліся."

# game/scripts/scene/scene_day_3.rpy:1183
translate belarusian minigame_folder_hit1_d7245e63:

    # "Я одёрнул руку. Папка закрылась."
    "Я аддзёр руку. Папка зачынілася."

# game/scripts/scene/scene_day_3.rpy:1209
translate belarusian minigame_folder_hit2_e35f42fa:

    # "Милиционер встал к классу спиной и заскрёб мелом по доске. Противно заскрежетало."
    "Міліцыянер стаў да класа спіной і заскроб крэйдай па дошцы. Гідка заскрыгатала."

# game/scripts/scene/scene_day_3.rpy:1210
translate belarusian minigame_folder_hit2_a904a6ae:

    # voice "voice/tihonov/3day/45 N.ogg"
    # Tikhonov "Не-зна-ком-цы."
    voice "voice/tihonov/3day/45 N.ogg"
    Tikhonov "Не-зна-ём-цы."

# game/scripts/scene/scene_day_3.rpy:1212
translate belarusian minigame_folder_hit2_44baf3f8:

    # voice "voice/tihonov/3day/46 V.ogg"
    # Tikhonov "В деревне почти все друг друга знают в лицо, так что чужаков обычно сразу замечают."
    voice "voice/tihonov/3day/46 V.ogg"
    Tikhonov "У вёсцы амаль усе адзін аднаго ведаюць у твар, таму чужынцаў звычайна адразу заўважаюць."

# game/scripts/scene/scene_day_3.rpy:1214
translate belarusian minigame_folder_hit2_2c497176:

    # voice "voice/tihonov/3day/47 U.ogg"
    # Tikhonov "Увидев незнакомца..."
    voice "voice/tihonov/3day/47 U.ogg"
    Tikhonov "Убачыўшы незнаёмца..."

# game/scripts/scene/scene_day_3.rpy:1219
translate belarusian minigame_folder_hit2_91cfe2df:

    # "Лейтенант снова заскрипел мелом, а я, убедившись, что никто не наблюдает, открыл папку и вынул фотографии, прятавшиеся на дне."
    "Лейтэнант зноў заскрыпеў крэйдай, а я, пераканаўшыся, што ніхто не назірае, адчыніў папку і выняў фотаздымкі, якія хаваліся на дне."

# game/scripts/scene/scene_day_3.rpy:1227
translate belarusian minigame_folder_hit2_dae69cbf:

    # "Они напоминали стоп-кадры из той странной передачи."
    "Яны нагадвалі стоп-кадры з той дзіўнай перадачы."

# game/scripts/scene/scene_day_3.rpy:1228
translate belarusian minigame_folder_hit2_a9fcbdd8:

    # "Только вместо крестов на белом фоне — корявые рябины."
    "Толькі замест крыжоў на белым фоне — каржакаватыя рабіны."

# game/scripts/scene/scene_day_3.rpy:1229
translate belarusian minigame_folder_hit2_94f2f047:

    # "Артерии корневищ. Пни и подрезанные молниями сосенки горельника."
    "Артэрыі карэнішчаў. Пні і падрэзаныя маланкамі сасонкі гарэльніка."

# game/scripts/scene/scene_day_3.rpy:1230
translate belarusian minigame_folder_hit2_ad5d5cc4:

    # "Снег, много снега."
    "Снег, шмат снегу."

# game/scripts/scene/scene_day_3.rpy:1231
translate belarusian minigame_folder_hit2_ba2c9e1b:

    # "И вдруг..."
    "І раптам..."

# game/scripts/scene/scene_day_3.rpy:1234
translate belarusian minigame_folder_hit2_a8947e0c:

    # "От чёрной постройки тянуло могильным холодом. Но это был не склеп."
    "Ад чорнай пабудовы цягнула магільным холадам. Але гэта быў не склеп."

# game/scripts/scene/scene_day_3.rpy:1236
translate belarusian minigame_folder_hit2_e98de4b7:

    # "Гараж."
    "Гараж."

# game/scripts/scene/scene_day_3.rpy:1237
translate belarusian minigame_folder_hit2_296e2966:

    # "Железный, и, судя по деревьям вокруг, установленный прямо в чаще."
    "Жалезны, і, мяркуючы па дрэвах вакол, усталяваны проста ў гушчары."

# game/scripts/scene/scene_day_3.rpy:1238
translate belarusian minigame_folder_hit2_792c5c76:

    # "Чёрные ворота словно засасывали меня внутрь."
    "Чорныя вароты нібыта засмоктвалі мяне ўнутр."

# game/scripts/scene/scene_day_3.rpy:1242
translate belarusian minigame_folder_hit2_5a3236a5:

    # "Я уже сталкивался раньше с этим скитающимся по округе контейнером."
    "Я ўжо сутыкаўся раней з гэтым кантэйнерам, што блукаў па акрузе."

# game/scripts/scene/scene_day_3.rpy:1243
translate belarusian minigame_folder_hit2_ca48bb79:

    # "Вчера."
    "Учора."

# game/scripts/scene/scene_day_3.rpy:1244
translate belarusian minigame_folder_hit2_ce724bf6:

    # "Сначала о нём рассказал Ромка. Он говорил, что в пропаже детей виновен Чёрный гараж, словно тот был живым существом."
    "Спачатку пра яго расказаў Ромка. Ён казаў, што ў знікненні дзяцей вінаваты Чорны гараж, быццам той быў жывой істотай."

# game/scripts/scene/scene_day_3.rpy:1245
translate belarusian minigame_folder_hit2_19c7285b:

    # "А затем, посреди густого леса, я лично встретился с этой постройкой цвета зияющей бездны."
    "А затым, пасярод густога лесу, я асабіста сустрэўся з гэтай пабудовай колеру разяўленай бездані."

# game/scripts/scene/scene_day_3.rpy:1246
translate belarusian minigame_folder_hit2_ef43e2a3:

    # "И лисичка сказала, что там прятался Вова."
    "І лісічка сказала, што там хаваўся Вова."

# game/scripts/scene/scene_day_3.rpy:1250
translate belarusian minigame_folder_hit2_3e1002cf:

    # "Пальцы дрогнули, и фотография спланировала назад в папку."
    "Пальцы дрыгнулі, і фотаздымак спланаваў назад у папку."

# game/scripts/scene/scene_day_3.rpy:1251
translate belarusian minigame_folder_hit2_427b3f60:

    # "К счастью, упала изнанкой кверху — смотреть на стальную коробку было физически неприятно."
    "На шчасце, упаў сподам дагары — глядзець на сталёвую скрынку было фізічна непрыемна."

# game/scripts/scene/scene_day_3.rpy:1257
translate belarusian minigame_folder_hit2_54449127:

    # "На дне папки лежал ещё и целлофановый пакет, в каких хранят вещдоки."
    "На дне папкі ляжаў яшчэ і цэлафанавы пакет, у якіх захоўваюць рэчдоказы."

# game/scripts/scene/scene_day_3.rpy:1263
translate belarusian minigame_folder_hit2_9313ddcb:

    # "Я открыл его..."
    "Я адчыніў яго..."

# game/scripts/scene/scene_day_3.rpy:1267
translate belarusian minigame_folder_hit2_c4bda52f:

    # "... а внутри..."
    "... а ўнутры..."

# game/scripts/scene/scene_day_3.rpy:1281
translate belarusian minigame_folder_hit2_6edc5ec3:

    # "... отрезанный палец!"
    "... адрэзаны палец!"

# game/scripts/scene/scene_day_3.rpy:1284
translate belarusian minigame_folder_hit2_324adcca:

    # "Моргнул — и мираж тут же рассеялся."
    "Міргнуў — і міраж адразу рассеяўся."

# game/scripts/scene/scene_day_3.rpy:1285
translate belarusian minigame_folder_hit2_c5df4d10:

    # "Больше не было человеческого обрубка, зато был перстень."
    "Больш не было чалавечага абрубка, затое быў пярсцёнак."

# game/scripts/scene/scene_day_3.rpy:1286
translate belarusian minigame_folder_hit2_95be6de6:

    # "Ошпаренный секундной галлюцинацией, я точно перенёсся в лес и услышал слова Семёна:"
    "Апараны секунднай галюцынацыяй, я дакладна перанёсся ў лес і пачуў словы Сямёна:"

# game/scripts/scene/scene_day_3.rpy:1290
translate belarusian minigame_folder_hit2_d3e147da:

    # voice "voice/semen/SCHa.ogg"
    # Sem "Ща, парашник, я тебе этой печаткой так заряжу!.."
    voice "voice/semen/SCHa.ogg"
    Sem "Зараз, парашнік, я табе гэтай пячаткай так зараджу!.."

# game/scripts/scene/scene_day_3.rpy:1295
translate belarusian minigame_folder_hit2_d56de03e:

    # "Перстень тускло блестел на ладони."
    "Пярсцёнак цьмяна блішчэў на далоні."

# game/scripts/scene/scene_day_3.rpy:1297
translate belarusian minigame_folder_hit2_c852adb4:

    # "Я судорожно сжал улику в кулаке, словно ища подтверждение, что она настоящая."
    "Я сутаргава сціснуў доказ у кулаку, быццам шукаючы пацвярджэнне, што ён сапраўдны."

# game/scripts/scene/scene_day_3.rpy:1300
translate belarusian minigame_folder_hit2_5da3c129:

    # "От неожиданности я клацнул зубами. Вдавился в спинку стула, затравленно моргая."
    "Ад нечаканасці я ляснуў зубамі. Уціснуўся ў спінку крэсла, зацкавана міргаючы."

# game/scripts/scene/scene_day_3.rpy:1303
translate belarusian minigame_folder_hit2_cafb44d7:

    # "Милиционер молча сгрёб папку, нахмурился."
    "Міліцыянер моўчкі згроб папку, нахмурыўся."

# game/scripts/scene/scene_day_3.rpy:1305
translate belarusian minigame_folder_hit2_8311687b:

    # voice "voice/tihonov/3day/54 B.ogg"
    # Tikhonov "Больно ты любопытный, Петров."
    voice "voice/tihonov/3day/54 B.ogg"
    Tikhonov "Надта ты цікаўны, Пятроў."

# game/scripts/scene/scene_day_3.rpy:1314
translate belarusian minigame_folder_hit2_57286222:

    # "Что есть силы я попытался выдавить слова, извиниться, вернуть перстень."
    "Што ёсць сілы я паспрабаваў выціснуць словы, папрасіць прабачэння, вярнуць пярсцёнак."

# game/scripts/scene/scene_day_3.rpy:1315
translate belarusian minigame_folder_hit2_0df83e38:

    # "Но получилось лишь протянуть сжатый кулак с кольцом и затарахтеть, как двигатель у папиной машины в мороз."
    "Але атрымалася толькі працягнуць сціснуты кулак з кольцам і затарахцець, як рухавік у татавай машыны ў мароз."

# game/scripts/scene/scene_day_3.rpy:1324
translate belarusian minigame_folder_hit2_50333667:

    # voice "voice/anton/3day/013V.ogg"
    # Ant "Во-во-во-во..."
    voice "voice/anton/3day/013V.ogg"
    Ant "Во-во-во-во..."

# game/scripts/scene/scene_day_3.rpy:1328
translate belarusian minigame_folder_hit2_2bdefac4:

    # voice "voice/tihonov/3day/01 Kak.ogg"
    # Tikhonov "Как говорится..."
    voice "voice/tihonov/3day/01 Kak.ogg"
    Tikhonov "Як гаворыцца..."

# game/scripts/scene/scene_day_3.rpy:1330
translate belarusian minigame_folder_hit2_6acc7412:

    # voice "voice/tihonov/3day/02 Me.ogg"
    # Tikhonov "... меньше знаешь — крепче спишь."
    voice "voice/tihonov/3day/02 Me.ogg"
    Tikhonov "... менш ведаеш — мацней спіш."

# game/scripts/scene/scene_day_3.rpy:1344
translate belarusian minigame_folder_hit2_2e19ab94:

    # voice "voice/anton/3day/014 Vo.ogg"
    # Ant "Во-во... вот."
    voice "voice/anton/3day/014 Vo.ogg"
    Ant "Во-во... вось."

# game/scripts/scene/scene_day_3.rpy:1348
translate belarusian minigame_folder_hit2_a9672c7e:

    # "Он пошёл к доске, не оглядываясь, а я всё сжимал украденную улику и думал о Семёне."
    "Ён пайшоў да дошкі, не азіраючыся, а я ўсё сціскаў скрадзены доказ і думаў пра Сямёна."

# game/scripts/scene/scene_day_3.rpy:1349
translate belarusian minigame_folder_hit2_5ae1b1c2:

    # "Который теперь наверняка уже мёртв."
    "Які цяпер напэўна ўжо мёртвы."

# game/scripts/scene/scene_day_3.rpy:1363
translate belarusian minigame_folder_fail1_0572c788:

    # "Как только я коснулся папки, Тихонов хлестнул меня взглядом, словно розгой."
    "Як толькі я дакрануўся да папкі, Ціханаў хляснуў мяне позіркам, быццам розгай."

# game/scripts/scene/scene_day_3.rpy:1364
translate belarusian minigame_folder_fail1_16eadfca:

    # "Рука непроизвольно отдёрнулась, будто и вправду почувствовала боль."
    "Рука міжволі аддзёрнулася, быццам і сапраўды адчула боль."

# game/scripts/scene/scene_day_3.rpy:1365
translate belarusian minigame_folder_fail1_c269d101:

    # "Лейтенант ещё некоторое время молчал, не сводя с меня глаз, и мне было не по себе от этой тишины и насмешливо косящихся одноклассников."
    "Лейтэнант яшчэ некаторы час маўчаў, не зводзячы з мяне вачэй, і мне было няўтульна ад гэтай цішыні і аднакласнікаў, што насмешліва касавурыліся."

# game/scripts/scene/scene_day_3.rpy:1369
translate belarusian minigame_folder_fail1_8ea2fade:

    # "А потом милиционер так же резко заговорил, как ни в чём не бывало."
    "А потым міліцыянер гэтак жа рэзка загаварыў, як ні ў чым не бывала."

# game/scripts/scene/scene_day_3.rpy:1382
translate belarusian minigame_folder_fail2_5da3c129:

    # "От неожиданности я клацнул зубами. Вдавился в спинку стула, затравленно моргая."
    "Ад нечаканасці я ляснуў зубамі. Уціснуўся ў спінку крэсла, зацкавана міргаючы."

# game/scripts/scene/scene_day_3.rpy:1386
translate belarusian minigame_folder_fail2_cafb44d7:

    # "Милиционер молча сгрёб папку, нахмурился."
    "Міліцыянер моўчкі згроб папку, нахмурыўся."

# game/scripts/scene/scene_day_3.rpy:1388
translate belarusian minigame_folder_fail2_8311687b:

    # voice "voice/tihonov/3day/54 B.ogg"
    # Tikhonov "Больно ты любопытный, Петров."
    voice "voice/tihonov/3day/54 B.ogg"
    Tikhonov "Надта ты цікаўны, Пятроў."

# game/scripts/scene/scene_day_3.rpy:1399
translate belarusian minigame_timeout_b96ef212:

    # "Милиционер закончил лекцию и суетливо заозирался."
    "Міліцыянер скончыў лекцыю і мітусліва зазіраўся."

# game/scripts/scene/scene_day_3.rpy:1404
translate belarusian minigame_timeout_c68ce089:

    # "Наконец он приметил оставленную на моей парте папку, молча сунул её под мышку и, не оглядываясь, пошёл к доске."
    "Нарэшце ён прыкмеціў пакінутую на маёй парце папку, моўчкі сунуў яе пад паху і, не азіраючыся, пайшоў да дошкі."

# game/scripts/scene/scene_day_3.rpy:1420
translate belarusian minigame_after_06c9b6d0:

    # voice "voice/tihonov/3day/55 E.ogg"
    # Tikhonov "И ещё раз."
    voice "voice/tihonov/3day/55 E.ogg"
    Tikhonov "І яшчэ раз."

# game/scripts/scene/scene_day_3.rpy:1422
translate belarusian minigame_after_1b85d6eb:

    # voice "voice/tihonov/3day/56 E.ogg"
    # Tikhonov "Если вы заметите в посёлке кого-то подозрительного — неважно, возле школы или на лесной тропинке — сразу сообщайте в милицию."
    voice "voice/tihonov/3day/56 E.ogg"
    Tikhonov "Калі вы заўважыце ў пасёлку кагосьці падазронага — усё роўна, каля школы ці на лясной сцяжынцы — адразу паведамляйце ў міліцыю."

# game/scripts/scene/scene_day_3.rpy:1424
translate belarusian minigame_after_bc184e88:

    # voice "voice/tihonov/3day/57 T.ogg"
    # Tikhonov "Телефон-то знаете?"
    voice "voice/tihonov/3day/57 T.ogg"
    Tikhonov "Тэлефон жа ведаеце?"

# game/scripts/scene/scene_day_3.rpy:1426
translate belarusian minigame_after_b322da79:

    # voice "voice/Child/3day/30 NolDva.ogg"
    # Childs "Ноль-два!"
    voice "voice/Child/3day/30 NolDva.ogg"
    Childs "Нуль-два!"

# game/scripts/scene/scene_day_3.rpy:1428
translate belarusian minigame_after_a0d54705:

    # voice "voice/tihonov/3day/58 S.ogg"
    # Tikhonov "Спасибо, ребята."
    voice "voice/tihonov/3day/58 S.ogg"
    Tikhonov "Дзякуй, дзеці."

# game/scripts/scene/scene_day_3.rpy:1430
translate belarusian minigame_after_09b515c8:

    # voice "voice/tihonov/3day/59 S.ogg"
    # Tikhonov "Спасибо, Лилия Павловна."
    voice "voice/tihonov/3day/59 S.ogg"
    Tikhonov "Дзякуй, Лілія Паўлаўна."

# game/scripts/scene/scene_day_3.rpy:1432
translate belarusian minigame_after_cb6b933e:

    # voice "voice/tihonov/3day/60 E.ogg"
    # Tikhonov "И это, кхм... Одноклассника вашего мы найдём."
    voice "voice/tihonov/3day/60 E.ogg"
    Tikhonov "І гэта, кхм... Аднакласніка вашага мы знойдзем."

# game/scripts/scene/scene_day_3.rpy:1435
translate belarusian minigame_after_3bf7240d:

    # "«Ну да», — подумал я."
    "«Ну так», — падумаў я."

# game/scripts/scene/scene_day_3.rpy:1436
translate belarusian minigame_after_3f55da7a:

    # Ant_m "{i}Поройтесь хорошенько в оврагах — может, соберёте...{/i}"
    Ant_m "{i}Парыйцеся добра ў ярах — можа, збераце...{/i}"

# game/scripts/scene/scene_day_3.rpy:1437
translate belarusian minigame_after_f48f4422:

    # Ant_m "{i}... как «Лего»{/i}."
    Ant_m "{i}... як «Лега»{/i}."

# game/scripts/scene/scene_day_3.rpy:1438
translate belarusian minigame_after_8320b6bc:

    # "Мысли были злыми и какими-то неуправляемыми."
    "Думкі былі злымі і нейкімі некіравальнымі."

# game/scripts/scene/scene_day_3.rpy:1439
translate belarusian minigame_after_d35b6141:

    # "Я переключился на фразу лейтенанта о подозрительных личностях."
    "Я пераключыўся на фразу лейтэнанта пра падазроных асоб."

# game/scripts/scene/scene_day_3.rpy:1440
translate belarusian minigame_after_1c1e874e:

    # "Вдруг я видел маньяка? Стоял с ним плечом к плечу?"
    "Раптам я бачыў маньяка? Стаяў з ім плячом да пляча?"

# game/scripts/scene/scene_day_3.rpy:1441
translate belarusian minigame_after_5bd2e013:

    # "Подозрительные люди, хм..."
    "Падазроныя людзі, хм..."

# game/scripts/scene/scene_day_3.rpy:1442
translate belarusian minigame_after_62439446:

    # "Насколько подозрительной была девочка-лиса, разгуливавшая в темноте?"
    "Наколькі падазронай была дзяўчынка-ліса, што шпацыравала ў цемры?"

# game/scripts/scene/scene_day_3.rpy:1443
translate belarusian minigame_after_403a41b6:

    # "Чудачка из ниоткуда, что растворялась в воздухе со своими загадками и стишками?"
    "Дзівачка з ніадкуль, што растваралася ў паветры са сваімі загадкамі і вершыкамі?"

# game/scripts/scene/scene_day_3.rpy:1444
translate belarusian minigame_after_54dbb45d:

    # "Но могла ли она причинить вред здоровенному Семёну?"
    "Але ці магла яна нашкодзіць здаравеннаму Сямёну?"

# game/scripts/scene/scene_day_3.rpy:1445
translate belarusian minigame_after_8d353588:

    # "Сказать ли мне об этом лейтенанту?"
    "Ці сказаць мне пра гэта лейтэнанту?"

# game/scripts/scene/scene_day_3.rpy:1452
translate belarusian minigame_after_27dfd35b:

    # "Вдруг от моих слов зависят жизни детей: милой девочки Ксении и Вовы?"
    "Раптам ад маіх слоў залежаць жыцці дзяцей: мілай дзяўчынкі Ксеніі і Вовы?"

# game/scripts/scene/scene_day_3.rpy:1453
translate belarusian minigame_after_c7146766:

    # "Или меня поднимут на смех? Снова начнут шептаться за спиной? А может — того ужаснее, — сочтут сумасшедшим?"
    "Ці мяне падымуць на смех? Зноў пачнуць шаптацца за спіной? А можа — што яшчэ жудасней, — палічаць вар'ятам?"

# game/scripts/scene/scene_day_3.rpy:1456
translate belarusian minigame_after_5b20a015:

    # "Ромка грозно поглядел на меня через плечо. Вряд ли такой, как он, одобрит сотрудничество с милицией."
    "Ромка грозна паглядзеў на мяне цераз плячо. Наўрад ці такі, як ён, ухваліць супрацоўніцтва з міліцыяй."

# game/scripts/scene/scene_day_3.rpy:1457
translate belarusian minigame_after_6d1f8bc5:

    # "За сидящими впереди хулиганами беспокойно сновала коса Кати."
    "За хуліганамі, што сядзелі наперадзе, неспакойна сноўдала каса Каці."

# game/scripts/scene/scene_day_3.rpy:1458
translate belarusian minigame_after_0ee4f105:

    # "Рука словно прилипла к парте."
    "Рука быццам прыліпла да парты."

# game/scripts/scene/scene_day_3.rpy:1460
translate belarusian minigame_after_cff5cac7:

    # "Тихонов уже прощался с Лилией Павловной."
    "Ціханаў ужо развітваўся з Ліліяй Паўлаўнай."

# game/scripts/scene/scene_day_3.rpy:1461
translate belarusian minigame_after_a669eb42:

    # "Уйдёт."
    "Сыдзе."

# game/scripts/scene/scene_day_3.rpy:1462
translate belarusian minigame_after_eb868da3:

    # "Опоздаю..."
    "Спазнюся..."

# game/scripts/scene/scene_day_3.rpy:1476
translate belarusian tell_or_silent_7d43fd0b:

    # "Ну уж нет."
    "Ну ўжо не."

# game/scripts/scene/scene_day_3.rpy:1477
translate belarusian tell_or_silent_8549a955:

    # "Хватит с меня позора."
    "Хопіць з мяне сораму."

# game/scripts/scene/scene_day_3.rpy:1482
translate belarusian tell_or_silent_d26026d5:

    # "Тише воды, ниже травы. Как зайчик."
    "Цішэй вады, ніжэй травы. Як зайчык."

# game/scripts/scene/scene_day_3.rpy:1483
translate belarusian tell_or_silent_f4a8518e:

    # "Я сцепил замком пальцы и прикусил язык."
    "Я счапіў замком пальцы і прыкусіў язык."

# game/scripts/scene/scene_day_3.rpy:1489
translate belarusian tell_or_silent_97e04774:

    # "Зазвенел звонок."
    "Зазвінеў званок."

# game/scripts/scene/scene_day_3.rpy:1494
translate belarusian tell_or_silent_9f8e1d95:

    # "Я отклеил ладонь от столешницы."
    "Я адклеіў далонь ад стальніцы."

# game/scripts/scene/scene_day_3.rpy:1495
translate belarusian tell_or_silent_e27d8e63:

    # "Его надо предупредить. Хотя бы ради Оли, ради её безопасности в доме у скрипучих сосен."
    "Яго трэба папярэдзіць. Хоць бы дзеля Олі, дзеля яе бяспекі ў доме каля рыпучых сосен."

# game/scripts/scene/scene_day_3.rpy:1497
translate belarusian tell_or_silent_71d24c6d:

    # "Я поднял руку, тяжёлую, как гиря."
    "Я падняў руку, цяжкую, як гіра."

# game/scripts/scene/scene_day_3.rpy:1498
translate belarusian tell_or_silent_0d6ec20c:

    # voice "voice/anton/3day/015 Pr.ogg"
    # Ant "Простите..."
    voice "voice/anton/3day/015 Pr.ogg"
    Ant "Прабачце..."

# game/scripts/scene/scene_day_3.rpy:1506
translate belarusian tell_or_silent_c1a3e0bf:

    # "Два десятка голов повернулись ко мне."
    "Два дзясяткі галоў павярнуліся да мяне."

# game/scripts/scene/scene_day_3.rpy:1507
translate belarusian tell_or_silent_b9c6d38a:

    # "Учительница, лейтенант, Полина..."
    "Настаўніца, лейтэнант, Паліна..."

# game/scripts/scene/scene_day_3.rpy:1509
translate belarusian tell_or_silent_720b1bda:

    # "Катя толкнула локтём соседку."
    "Каця штурхнула локцем суседку."

# game/scripts/scene/scene_day_3.rpy:1510
translate belarusian tell_or_silent_ed8a4888:

    # "Заспанный Бяша вытянул шею."
    "Заспаны Бяша выцягнуў шыю."

# game/scripts/scene/scene_day_3.rpy:1511
translate belarusian tell_or_silent_a1398aa9:

    # "Вопросительно нахмурился Ромка."
    "Пытальна нахмурыўся Ромка."

# game/scripts/scene/scene_day_3.rpy:1513
translate belarusian tell_or_silent_96778aae:

    # voice "voice/tihonov/3day/61 Ya.ogg"
    # Tikhonov "Я слушаю."
    voice "voice/tihonov/3day/61 Ya.ogg"
    Tikhonov "Я слухаю."

# game/scripts/scene/scene_day_3.rpy:1520
translate belarusian tell_or_silent_75dd3f1f:

    # "Меня будто изучали, положив под микроскоп."
    "Мяне быццам вывучалі, паклаўшы пад мікраскоп."

# game/scripts/scene/scene_day_3.rpy:1524
translate belarusian tell_or_silent_c5aade0f:

    # voice "voice/anton/3day/016 Vch.ogg"
    # Ant "Вчера утром по дороге в школу я видел... гм, незнакомого человека."
    voice "voice/anton/3day/016 Vch.ogg"
    Ant "Учора раніцай па дарозе ў школу я бачыў... гм, незнаёмага чалавека."

# game/scripts/scene/scene_day_3.rpy:1530
translate belarusian tell_or_silent_cb1ca6d9:

    # "Одноклассники зашептались."
    "Аднакласнікі зашапталіся."

# game/scripts/scene/scene_day_3.rpy:1531
translate belarusian tell_or_silent_d7f2bf49:

    # "Тихонов нахмурился, глубокая морщина расчертила его лоб."
    "Ціханаў нахмурыўся, глыбокая маршчына расчарціла яго лоб."

# game/scripts/scene/scene_day_3.rpy:1534
translate belarusian tell_or_silent_cf7590e7:

    # voice "voice/lydia/3day/14 D.ogg"
    # Teacher "Да откуда ему знать, чужак это или кто-то из местных."
    voice "voice/lydia/3day/14 D.ogg"
    Teacher "Ды адкуль яму ведаць, чужынец гэта ці нехта з мясцовых."

# game/scripts/scene/scene_day_3.rpy:1536
translate belarusian tell_or_silent_971cc961:

    # voice "voice/lydia/3day/15 On.ogg"
    # Teacher "Он же в посёлке без году неделя."
    voice "voice/lydia/3day/15 On.ogg"
    Teacher "Ён жа ў пасёлку без году тыдзень."

# game/scripts/scene/scene_day_3.rpy:1538
translate belarusian tell_or_silent_91cf5f96:

    # "Дети захмыкали, злобно ощерилась Катя."
    "Дзеці захмыкалі, злосна ашчэрылася Каця."

# game/scripts/scene/scene_day_3.rpy:1542
translate belarusian tell_or_silent_0298b8c6:

    # voice "voice/tihonov/3day/62 S.ogg"
    # Tikhonov "Спокойствие!"
    voice "voice/tihonov/3day/62 S.ogg"
    Tikhonov "Спакой!"

# game/scripts/scene/scene_day_3.rpy:1544
translate belarusian tell_or_silent_f2bf83eb:

    # voice "voice/tihonov/3day/63 A.ogg"
    # Tikhonov "Антон, а сможешь детальнее описать?"
    voice "voice/tihonov/3day/63 A.ogg"
    Tikhonov "Антон, а ці зможаш дэталёвей апісаць?"

# game/scripts/scene/scene_day_3.rpy:1551
translate belarusian tell_or_silent_e816d2ec:

    # "Меня осенило."
    "Мяне асяніла."

# game/scripts/scene/scene_day_3.rpy:1552
translate belarusian tell_or_silent_53121c3d:

    # "Я не только могу описать. А ещё..."
    "Я не толькі магу апісаць. А яшчэ..."

# game/scripts/scene/scene_day_3.rpy:1555
translate belarusian tell_or_silent_ceadd0dc:

    # voice "voice/anton/3day/017 Ya.ogg"
    # Ant "Я нарисовать могу!"
    voice "voice/anton/3day/017 Ya.ogg"
    Ant "Я намаляваць магу!"

# game/scripts/scene/scene_day_3.rpy:1561
translate belarusian tell_or_silent_c46d3f3e:

    # voice "voice/anton/3day/017Yar.ogg"
    # Ant "Я рисую... немного."
    voice "voice/anton/3day/017Yar.ogg"
    Ant "Я малюю... трохі."

# game/scripts/scene/scene_day_3.rpy:1565
translate belarusian tell_or_silent_bc5f68a6:

    # "Выплюнув это признание, я ожидал, что класс взорвётся гоготом, но никто не засмеялся, даже Катя."
    "Выплюнуўшы гэтае прызнанне, я чакаў, што клас выбухне рогатам, але ніхто не засмяяўся, нават Каця."

# game/scripts/scene/scene_day_3.rpy:1569
translate belarusian tell_or_silent_0d7206f1:

    # "Полина заинтересованно смотрела, склонив голову."
    "Паліна зацікаўлена глядзела, схіліўшы галаву."

# game/scripts/scene/scene_day_3.rpy:1570
translate belarusian tell_or_silent_9082de94:

    # "Внимание одноклассников польстило мне и, осмелев, я спросил:"
    "Увага аднакласнікаў палясціла мне і, асмеліўшыся, я спытаў:"

# game/scripts/scene/scene_day_3.rpy:1571
translate belarusian tell_or_silent_252269b1:

    # voice "voice/anton/3day/018 .ogg"
    # Ant "Нарисовать?"
    voice "voice/anton/3day/018 .ogg"
    Ant "Намаляваць?"

# game/scripts/scene/scene_day_3.rpy:1575
translate belarusian tell_or_silent_55f1e808:

    # "Тихонов медленно кивнул."
    "Ціханаў павольна кіўнуў."

# game/scripts/scene/scene_day_3.rpy:1576
translate belarusian tell_or_silent_010cb52c:

    # voice "voice/tihonov/3day/64 L.ogg"
    # Tikhonov "Лилия Павловна, мы тут проведём следственный эксперимент?"
    voice "voice/tihonov/3day/64 L.ogg"
    Tikhonov "Лілія Паўлаўна, мы тут правядзем следчы эксперымент?"

# game/scripts/scene/scene_day_3.rpy:1578
translate belarusian tell_or_silent_faf9c671:

    # voice "voice/lydia/3day/16 P.ogg"
    # Teacher "Пожалуйста, пожалуйста."
    voice "voice/lydia/3day/16 P.ogg"
    Teacher "Калі ласка, калі ласка."

# game/scripts/scene/scene_day_3.rpy:1580
translate belarusian tell_or_silent_e4152a95:

    # "Я вынул ручку, разгладил альбомный листок."
    "Я выняў ручку, разгладзіў альбомны аркуш."

# game/scripts/scene/scene_day_3.rpy:1587
translate belarusian tell_or_silent_3681c6c4:

    # "Одноклассники вытаращились на меня в предвкушении."
    "Аднакласнікі вылупіліся на мяне ў прадчуванні."

# game/scripts/scene/scene_day_3.rpy:1588
translate belarusian tell_or_silent_a12fbffd:

    # "Полина улыбнулась, и улыбка эта была мне наградой за проявленную смелость."
    "Паліна ўсміхнулася, і ўсмешка гэта была мне ўзнагародай за праяўленую смеласць."

# game/scripts/scene/scene_day_3.rpy:1589
translate belarusian tell_or_silent_bbfe6dc4:

    # voice "voice/tihonov/3day/65 Na.ogg"
    # Tikhonov "Ну что, Ван Гог, рисуй."
    voice "voice/tihonov/3day/65 Na.ogg"
    Tikhonov "Ну што, Ван Гог, малюй."

# game/scripts/scene/scene_day_3.rpy:1635
translate belarusian day3_photo_fox_2650a1e0:

    # voice "voice/anton/3day/019 Vo.ogg"
    # Ant "Вот, пожалуйста."
    voice "voice/anton/3day/019 Vo.ogg"
    Ant "Вось, калі ласка."

# game/scripts/scene/scene_day_3.rpy:1639
translate belarusian day3_photo_fox_b59d4ba1:

    # "Я протянул рисунок милиционеру."
    "Я працягнуў малюнак міліцыянеру."

# game/scripts/scene/scene_day_3.rpy:1642
translate belarusian day3_photo_fox_453bd13f:

    # voice "voice/tihonov/3day/67 E.ogg"
    # Tikhonov "Это что? Лиса? Смешно, юморист..."
    voice "voice/tihonov/3day/67 E.ogg"
    Tikhonov "Гэта што? Ліса? Смешна, гумарыст..."

# game/scripts/scene/scene_day_3.rpy:1645
translate belarusian day3_photo_fox_60f9659b:

    # voice "voice/tihonov/3day/69 P.ogg"
    # Tikhonov "Прикажешь её по лесу с собаками ловить?"
    voice "voice/tihonov/3day/69 P.ogg"
    Tikhonov "Загадаеш яе па лесе з сабакамі лавіць?"

# game/scripts/scene/scene_day_3.rpy:1648
translate belarusian day3_photo_fox_869827e4:

    # "Казалось, от дружного хохота задребезжали стёкла. Даже Лилия Павловна смеялась."
    "Здавалася, ад дружнага рогату задрыжэла шкло. Нават Лілія Паўлаўна смяялася."

# game/scripts/scene/scene_day_3.rpy:1649
translate belarusian day3_photo_fox_5cb3ae5d:

    # voice "voice/anton/3day/020 Vse.ogg"
    # Ant "Всё не так..."
    voice "voice/anton/3day/020 Vse.ogg"
    Ant "Усё не так..."

# game/scripts/scene/scene_day_3.rpy:1672
translate belarusian day3_photo_fox_7b2b2e3a:

    # voice "voice/kate/100 KA.ogg"
    # Kate "Петров, а {u}Чебурашка{/u} тебе не попадался? Ха-ха-ха!"
    voice "voice/kate/100 KA.ogg"
    Kate "Пятроў, а {u}Чабурашка{/u} табе не трапляўся? Ха-ха-ха!"

# game/scripts/scene/scene_day_3.rpy:1696
translate belarusian day3_photo_fox_251a2be1:

    # voice "voice/kate/100 KAA.ogg"
    # Kate "Вот умора, а-ха-ха-ха-ха!"
    voice "voice/kate/100 KAA.ogg"
    Kate "Вось смеху то, а-ха-ха-ха-ха!"

# game/scripts/scene/scene_day_3.rpy:1701
translate belarusian day3_photo_fox_79153361:

    # "Я сгорал на костре позора."
    "Я згараў на вогнішчы сораму."

# game/scripts/scene/scene_day_3.rpy:1706
translate belarusian day3_photo_fox_933192e1:

    # voice "voice/tihonov/3day/70 V.ogg"
    # Tikhonov "Всё ясно. Что тут ещё скажешь?"
    voice "voice/tihonov/3day/70 V.ogg"
    Tikhonov "Усё ясна. Што тут яшчэ скажаш?"

# game/scripts/scene/scene_day_3.rpy:1710
translate belarusian day3_photo_fox_8094f65f:

    # "Тихонов смял мой рисунок в кулаке."
    "Ціханаў скамячыў мой малюнак у кулаку."

# game/scripts/scene/scene_day_3.rpy:1712
translate belarusian day3_photo_fox_49ac48e9:

    # voice "voice/tihonov/3day/71 N.ogg"
    # Tikhonov "Ну, занимайтесь."
    voice "voice/tihonov/3day/71 N.ogg"
    Tikhonov "Ну, займайцеся."

# game/scripts/scene/scene_day_3.rpy:1718
translate belarusian day3_photo_fox_f31c62c2:

    # "Он ушёл."
    "Ён сышоў."

# game/scripts/scene/scene_day_3.rpy:1722
translate belarusian day3_photo_fox_97e04774:

    # "Зазвенел звонок."
    "Зазвінеў званок."

# game/scripts/scene/scene_day_3.rpy:1724
translate belarusian day3_photo_fox_bb35fefa:

    # voice "voice/kate/101 KA.ogg"
    # Kate "Придурочный."
    voice "voice/kate/101 KA.ogg"
    Kate "Прыдурашны."

# game/scripts/scene/scene_day_3.rpy:1729
translate belarusian day3_photo_fox_a8c0cb4c:

    # "Я не двигался. Лишь смотрел в одну точку."
    "Я не рухаўся. Толькі глядзеў у адну кропку."

# game/scripts/scene/scene_day_3.rpy:1737
translate belarusian day3_photo_witness_24526103:

    # "Вот оно, это резкое, холодное, будто высеченное из камня, лицо."
    "Вось яно, гэта рэзкае, халоднае, быццам высечанае з каменя, аблічча."

# game/scripts/scene/scene_day_3.rpy:1739
translate belarusian day3_photo_witness_1928769e:

    # "С острым, как бритва, прищуром."
    "З вострым, як брытва, прыжмурам."

# game/scripts/scene/scene_day_3.rpy:1742
translate belarusian day3_photo_witness_48b80a9d:

    # "Я неуверенно протянул готовый рисунок милиционеру."
    "Я няўпэўнена працягнуў гатовы малюнак міліцыянеру."

# game/scripts/scene/scene_day_3.rpy:1744
translate belarusian day3_photo_witness_630d90bf:

    # voice "voice/anton/3day/021 Pr.ogg"
    # Ant "Вот... примерно так."
    voice "voice/anton/3day/021 Pr.ogg"
    Ant "Вось... прыкладна так."

# game/scripts/scene/scene_day_3.rpy:1750
translate belarusian day3_photo_witness_a9bbed86:

    # voice "voice/tihonov/3day/75 P.ogg"
    # Tikhonov "Примерно?"
    voice "voice/tihonov/3day/75 P.ogg"
    Tikhonov "Прыкладна?"

# game/scripts/scene/scene_day_3.rpy:1752
translate belarusian day3_photo_witness_561cd9c8:

    # voice "voice/tihonov/3day/75 DA.ogg"
    # Tikhonov "Да ведь он — один в один тот тип."
    voice "voice/tihonov/3day/75 DA.ogg"
    Tikhonov "Ды ён жа — адзін у адзін той тып."

# game/scripts/scene/scene_day_3.rpy:1754
translate belarusian day3_photo_witness_a6e961f1:

    # voice "voice/anton/3day/022 Tak.ogg"
    # Ant "Так вы его тоже видели?"
    voice "voice/anton/3day/022 Tak.ogg"
    Ant "Дык вы яго таксама бачылі?"

# game/scripts/scene/scene_day_3.rpy:1756
translate belarusian day3_photo_witness_cb94b4ff:

    # voice "voice/tihonov/3day/76 Z.ogg"
    # Tikhonov "Заячью губу? Видел недавно возле посёлка."
    voice "voice/tihonov/3day/76 Z.ogg"
    Tikhonov "Заячую губу? Бачыў нядаўна каля пасёлка."

# game/scripts/scene/scene_day_3.rpy:1758
translate belarusian day3_photo_witness_9fba4ca3:

    # voice "voice/tihonov/3day/77 Du.ogg"
    # Tikhonov "Думал, он проездом, давно подался дальше гастролировать."
    voice "voice/tihonov/3day/77 Du.ogg"
    Tikhonov "Думаў, ён праездам, даўно падаўся далей гастраляваць."

# game/scripts/scene/scene_day_3.rpy:1760
translate belarusian day3_photo_witness_8da4f5d0:

    # voice "voice/tihonov/3day/78 A.ogg"
    # Tikhonov "А он, выходит, здесь отирается."
    voice "voice/tihonov/3day/78 A.ogg"
    Tikhonov "А ён, выходзіць, тут аціраецца."

# game/scripts/scene/scene_day_3.rpy:1763
translate belarusian day3_photo_witness_d5cda109:

    # voice "voice/anton/3day/023 A.ogg"
    # Ant "А ещё он рядом со школой стоял. И в лесу вечером."
    voice "voice/anton/3day/023 A.ogg"
    Ant "А яшчэ ён побач са школай стаяў. І ў лесе ўвечары."

# game/scripts/scene/scene_day_3.rpy:1765
translate belarusian day3_photo_witness_a5fa8a13:

    # "Тихонов посмотрел на меня так, будто видел впервые."
    "Ціханаў паглядзеў на мяне так, быццам бачыў упершыню."

# game/scripts/scene/scene_day_3.rpy:1766
translate belarusian day3_photo_witness_521a0529:

    # voice "voice/tihonov/3day/79 N.ogg"
    # Tikhonov "Ну пацан... Ну молодец! Уже хоть какая-то зацепка."
    voice "voice/tihonov/3day/79 N.ogg"
    Tikhonov "Ну хлапец... Ну малайчына! Ужо хоць нейкая зачэпка."

# game/scripts/scene/scene_day_3.rpy:1770
translate belarusian day3_photo_witness_62837a1c:

    # "И, хлопнув меня по плечу, он затопал к дверям."
    "І, пляснуўшы мяне па плячы, ён затупаў да дзвярэй."

# game/scripts/scene/scene_day_3.rpy:1775
translate belarusian day3_photo_witness_d8f15d1a:

    # "Замер, затем окликнул:"
    "Замер, потым гукнуў:"

# game/scripts/scene/scene_day_3.rpy:1776
translate belarusian day3_photo_witness_48e01682:

    # voice "voice/tihonov/3day/80 T.ogg"
    # Tikhonov "Талантливый ты парень."
    voice "voice/tihonov/3day/80 T.ogg"
    Tikhonov "Таленавіты ты хлопец."

# game/scripts/scene/scene_day_3.rpy:1778
translate belarusian day3_photo_witness_90f489f1:

    # voice "voice/tihonov/3day/81 Te.ogg"
    # Tikhonov "Тебя в академии художеств с руками оторвут!"
    voice "voice/tihonov/3day/81 Te.ogg"
    Tikhonov "Цябе ў акадэміі мастацтваў з рукамі адарвуць!"

# game/scripts/scene/scene_day_3.rpy:1786
translate belarusian day3_photo_witness_f31c62c2:

    # "Он ушёл."
    "Ён сышоў."

# game/scripts/scene/scene_day_3.rpy:1790
translate belarusian day3_photo_witness_97e04774:

    # "Зазвенел звонок."
    "Зазвінеў званок."

# game/scripts/scene/scene_day_3.rpy:1797
translate belarusian day3_photo_trudovic_2650a1e0:

    # voice "voice/anton/3day/019 Vo.ogg"
    # Ant "Вот, пожалуйста."
    voice "voice/anton/3day/019 Vo.ogg"
    Ant "Вось, калі ласка."

# game/scripts/scene/scene_day_3.rpy:1802
translate belarusian day3_photo_trudovic_b59d4ba1:

    # "Я протянул рисунок милиционеру."
    "Я працягнуў малюнак міліцыянеру."

# game/scripts/scene/scene_day_3.rpy:1809
translate belarusian day3_photo_trudovic_3a8648e2:

    # voice "voice/tihonov/3day/72 H.ogg"
    # Tikhonov "Хм, и кто это, по-твоему?"
    voice "voice/tihonov/3day/72 H.ogg"
    Tikhonov "Хм, і хто гэта, па-твойму?"

# game/scripts/scene/scene_day_3.rpy:1812
translate belarusian day3_photo_trudovic_82ee3f45:

    # voice "voice/tihonov/3day/02 Lil.ogg"
    # Tikhonov "Лилия Павловна, не узнаёте? Случаем, не ваш трудовик?"
    voice "voice/tihonov/3day/02 Lil.ogg"
    Tikhonov "Лілія Паўлаўна, не пазнаеце? Выпадкам, не ваш працавік?"

# game/scripts/scene/scene_day_3.rpy:1816
translate belarusian day3_photo_trudovic_c59ffa86:

    # "Учительница прищурилась, силясь разглядеть мою работу."
    "Настаўніца прыжмурылася, намагаючыся разгледзець маю работу."

# game/scripts/scene/scene_day_3.rpy:1817
translate belarusian day3_photo_trudovic_71d86a5a:

    # voice "voice/lydia/3day/18 Ka.ogg"
    # Teacher "Какая отвратительная рожа."
    voice "voice/lydia/3day/18 Ka.ogg"
    Teacher "Якая агідная пыса."

# game/scripts/scene/scene_day_3.rpy:1839
translate belarusian day3_photo_trudovic_6655c2e7:

    # voice "voice/byasha/3day/75 Da.ogg"
    # Bya "Да это батя Петрова! А-ха-ха-ха-ха!"
    voice "voice/byasha/3day/75 Da.ogg"
    Bya "Ды гэта баця Пятрова! А-ха-ха-ха-ха!"

# game/scripts/scene/scene_day_3.rpy:1867
translate belarusian day3_photo_trudovic_a7c74639:

    # "Ромка звонким подзатыльником осёк Бяшу, заливающегося смехом, и тот наконец прикусил язык."
    "Ромка звонкім патылічнікам спыніў Бяшу, які заліваўся смехам, і той нарэшце прыкусіў язык."

# game/scripts/scene/scene_day_3.rpy:1873
translate belarusian day3_photo_trudovic_34e17cb5:

    # voice "voice/tihonov/3day/02 Eto.ogg"
    # Tikhonov "Это что за мечта парикмахера такая?"
    voice "voice/tihonov/3day/02 Eto.ogg"
    Tikhonov "Гэта што за мара цырульніка такая?"

# game/scripts/scene/scene_day_3.rpy:1878
translate belarusian day3_photo_trudovic_daef74f7:

    # voice "voice/tihonov/3day/02 Sa.ogg"
    # Tikhonov "Сам Джон Леннон не иначе. Хотя стой! Была у нас в отделе листовка по неформальным коллективам... Летов это, братец."
    voice "voice/tihonov/3day/02 Sa.ogg"
    Tikhonov "Сам Джон Ленан не інакш. Хоць стой! Была ў нас у аддзеле ўлётка па нефармальных калектывах... Летаў гэта, браце."

# game/scripts/scene/scene_day_3.rpy:1880
translate belarusian day3_photo_trudovic_cbb1a13f:

    # voice "voice/tihonov/3day/02 U.ogg"
    # Tikhonov "У него-то может всё идёт по плану, а у меня чёрт знает что."
    voice "voice/tihonov/3day/02 U.ogg"
    Tikhonov "У яго дык можа ўсё ідзе па плане, а ў мяне чорт ведае што."

# game/scripts/scene/scene_day_3.rpy:1885
translate belarusian day3_photo_trudovic_f70af66c:

    # voice "voice/tihonov/3day/01 Ko.ogg"
    # Tikhonov "Кого это ты нам намалевал? Неужто товарища Ким Чен Ира?"
    voice "voice/tihonov/3day/01 Ko.ogg"
    Tikhonov "Каго гэта ты нам намаляваў? Няўжо таварыша Кім Чэн Іра?"

# game/scripts/scene/scene_day_3.rpy:1890
translate belarusian day3_photo_trudovic_8baa42c4:

    # voice "voice/tihonov/3day/01 Tu.ogg"
    # Tikhonov "Тю, да это ж Цой! Мда, Виктор Робертович - не признал, богатым будешь."
    voice "voice/tihonov/3day/01 Tu.ogg"
    Tikhonov "Цю, ды гэта ж Цой! Мда, Віктар Робертавіч — не пазнаў, багатым будзеш."

# game/scripts/scene/scene_day_3.rpy:1892
translate belarusian day3_photo_trudovic_250e05d9:

    # voice "voice/tihonov/3day/01 Bud.ogg"
    # Tikhonov "Тут только и остаётся что спеть: Будь осторожен, следи за собой, Антон..."
    voice "voice/tihonov/3day/01 Bud.ogg"
    Tikhonov "Тут толькі і застаецца што праспяваць: Будзь асцярожны, сачы за сабой, Антон..."

# game/scripts/scene/scene_day_3.rpy:1900
translate belarusian day3_photo_trudovic_687a5d29:

    # voice "voice/tihonov/3day/03 k.ogg"
    # Tikhonov "Кого это ты мне подсунуть решил? Бодрова?"
    voice "voice/tihonov/3day/03 k.ogg"
    Tikhonov "Каго гэта ты мне падсунуць вырашыў? Бадрова?"

# game/scripts/scene/scene_day_3.rpy:1902
translate belarusian day3_photo_trudovic_d06d7978:

    # voice "voice/tihonov/3day/03 e.ogg"
    # Tikhonov "Или думаешь я в видеосалоны не хожу и совсем про современное кино ни сном, ни духом?"
    voice "voice/tihonov/3day/03 e.ogg"
    Tikhonov "Ці думаеш я ў відэасалоны не хаджу і зусім пра сучаснае кіно ні сном, ні духам?"

# game/scripts/scene/scene_day_3.rpy:1904
translate belarusian day3_photo_trudovic_84027890:

    # voice "voice/tihonov/3day/03 v.ogg"
    # Tikhonov "Вот что я тебе скажу: Поживешь подольше - увидишь побольше."
    voice "voice/tihonov/3day/03 v.ogg"
    Tikhonov "Вось што я табе скажу: Пажывеш даўжэй — убачыш больш."

# game/scripts/scene/scene_day_3.rpy:1908
translate belarusian day3_photo_trudovic_7f5e6620:

    # "Казалось, от дружного хохота задребезжали стёкла."
    "Здавалася, ад дружнага рогату задрыжэла шкло."

# game/scripts/scene/scene_day_3.rpy:1919
translate belarusian day3_photo_trudovic_58619b6d:

    # voice "voice/lydia/3day/19 A.ogg"
    # "Лилия Павловна шикнула на класс, и смех приумолк, но я сгорал на костре позора."
    voice "voice/lydia/3day/19 A.ogg"
    "Лілія Паўлаўна шыкнула на клас, і смех прыціх, але я згараў на вогнішчы сораму."

# game/scripts/scene/scene_day_3.rpy:1921
translate belarusian day3_photo_trudovic_933192e1:

    # voice "voice/tihonov/3day/70 V.ogg"
    # Tikhonov "Всё ясно. Что тут ещё скажешь?"
    voice "voice/tihonov/3day/70 V.ogg"
    Tikhonov "Усё ясна. Што тут яшчэ скажаш?"

# game/scripts/scene/scene_day_3.rpy:1924
translate belarusian day3_photo_trudovic_1a385482:

    # "Тихонов небрежно сложил мой рисунок и кинул в папку."
    "Ціханаў нядбайна склаў мой малюнак і кінуў у папку."

# game/scripts/scene/scene_day_3.rpy:1925
translate belarusian day3_photo_trudovic_49ac48e9:

    # voice "voice/tihonov/3day/71 N.ogg"
    # Tikhonov "Ну, занимайтесь."
    voice "voice/tihonov/3day/71 N.ogg"
    Tikhonov "Ну, займайцеся."

# game/scripts/scene/scene_day_3.rpy:1929
translate belarusian day3_photo_trudovic_f31c62c2:

    # "Он ушёл."
    "Ён сышоў."

# game/scripts/scene/scene_day_3.rpy:1933
translate belarusian day3_photo_trudovic_97e04774:

    # "Зазвенел звонок."
    "Зазвінеў званок."

# game/scripts/scene/scene_day_3.rpy:1935
translate belarusian day3_photo_trudovic_bb35fefa:

    # voice "voice/kate/101 KA.ogg"
    # Kate "Придурочный."
    voice "voice/kate/101 KA.ogg"
    Kate "Прыдурашны."

# game/scripts/scene/scene_day_3.rpy:1940
translate belarusian day3_photo_trudovic_a8c0cb4c:

    # "Я не двигался. Лишь смотрел в одну точку."
    "Я не рухаўся. Толькі глядзеў у адну кропку."

# game/scripts/scene/scene_day_3.rpy:1950
translate belarusian day3_draw_wrong_class_3e59494f:

    # "Лилия Павловна прошагала, не посмотрев в мою сторону. За ней вышла Полина."
    "Лілія Паўлаўна пракрочыла, не паглядзеўшы ў мой бок. За ёй выйшла Паліна."

# game/scripts/scene/scene_day_3.rpy:1956
translate belarusian day3_draw_wrong_class_5686b71b:

    # "Ученики притихли разом, словно на пульте убавили звук."
    "Вучні прыціхлі адразу, нібы на пульце зменшылі гук."

# game/scripts/scene/scene_day_3.rpy:1957
translate belarusian day3_draw_wrong_class_af739e9a:

    # "Они следили, как я иду по проходу."
    "Яны сачылі, як я іду па праходзе."

# game/scripts/scene/scene_day_3.rpy:1958
translate belarusian day3_draw_wrong_class_25b58945:

    # "Прокурорские взгляды. Прицелы снайперских винтовок."
    "Пракурорскія позіркі. Прыцэлы снайперскіх вінтовак."

# game/scripts/scene/scene_day_3.rpy:1973
translate belarusian day3_draw_witness_class_0a5a8278:

    # "Лилия Павловна прошагала, смерив меня заинтересованным взглядом."
    "Лілія Паўлаўна пракрочыла, змерыўшы мяне зацікаўленым позіркам."

# game/scripts/scene/scene_day_3.rpy:1977
translate belarusian day3_draw_witness_class_5686b71b:

    # "Ученики притихли разом, словно на пульте убавили звук."
    "Вучні прыціхлі адразу, нібы на пульце зменшылі гук."

# game/scripts/scene/scene_day_3.rpy:1996
translate belarusian day3_draw_witness_class_5e3ec9e4:

    # "Они следили, как я иду по проходу, и что-то менялось в их взглядах."
    "Яны сачылі, як я іду па праходзе, і нешта мянялася ў іх позірках."

# game/scripts/scene/scene_day_3.rpy:1997
translate belarusian day3_draw_witness_class_0396394c:

    # "Даже в Катином произошли перемены."
    "Нават у Каціным адбыліся перамены."

# game/scripts/scene/scene_day_3.rpy:2003
translate belarusian day3_draw_witness_class_6a11bc8d:

    # "Я отчётливо вспомнил, как однажды папа заступился за ветерана в автобусе, приструнив пьяных хулиганов."
    "Я выразна ўзгадаў, як аднойчы тата заступіўся за ветэрана ў аўтобусе, уціхамірыўшы п'яных хуліганаў."

# game/scripts/scene/scene_day_3.rpy:2004
translate belarusian day3_draw_witness_class_5b07552b:

    # "Пассажиры смотрели на него так же."
    "Пасажыры глядзелі на яго таксама."

# game/scripts/scene/scene_day_3.rpy:2006
translate belarusian day3_draw_witness_class_4057a31f:

    # "С уважением."
    "З павагай."

# game/scripts/scene/scene_day_3.rpy:2012
translate belarusian day3_draw_witness_class_00afbc3d:

    # "Сходив в туалет и умывшись ледяной водой, я вернулся в класс."
    "Схадзіўшы ў прыбіральню і ўмыўшыся ледзяной вадой, я вярнуўся ў клас."

# game/scripts/scene/scene_day_3.rpy:2014
translate belarusian day3_draw_witness_class_3b92c100:

    # "Но не успел переступить порог, как кто-то радостно окликнул меня по имени."
    "Але не паспеў пераступіць парог, як нехта радасна паклікаў мяне па імені."

# game/scripts/scene/scene_day_3.rpy:2022
translate belarusian day3_draw_witness_class_a5ad1ba1:

    # "Это была Катина соседка по парте."
    "Гэта была Каціна суседка па парце."

# game/scripts/scene/scene_day_3.rpy:2023
translate belarusian day3_draw_witness_class_c9ae0ada:

    # "Улыбнувшись, она угостила меня конфетой «Скитлс»."
    "Усміхнуўшыся, яна пачаставала мяне цукеркай «Скітлс»."

# game/scripts/scene/scene_day_3.rpy:2025
translate belarusian day3_draw_witness_class_df12e314:

    # "Я пробурчал слова благодарности и машинально проглотил драже, точно это была мамина таблетка."
    "Я прабурчаў словы падзякі і машынальна праглынуў дражэ, быццам гэта была маміна таблетка."

# game/scripts/scene/scene_day_3.rpy:2026
translate belarusian day3_draw_witness_class_8a9b8cf2:

    # "Сбоку раздался радостный возглас."
    "Збоку пачуўся радасны вокліч."

# game/scripts/scene/scene_day_3.rpy:2033
translate belarusian day3_draw_witness_class_0837a6f3:

    # voice "voice/Child/3day/08 Ant.ogg"
    # Classmate "Антон, а меня нарисуешь?"
    voice "voice/Child/3day/08 Ant.ogg"
    Classmate "Антон, а мяне намалюеш?"

# game/scripts/scene/scene_day_3.rpy:2040
translate belarusian day3_draw_witness_class_e65d1d78:

    # voice "voice/Child/3day/09 E.ogg"
    # Classmate "И меня! Можно я, можно я?"
    voice "voice/Child/3day/09 E.ogg"
    Classmate "І мяне! Можна я, можна я?"

# game/scripts/scene/scene_day_3.rpy:2043
translate belarusian day3_draw_witness_class_0a2b7f07:

    # "Кричали уже со всех сторон, и от неловкости я прижался к стенке с атласом."
    "Крычалі ўжо з усіх бакоў, і ад няёмкасці я прыціснуўся да сценкі з атласам."

# game/scripts/scene/scene_day_3.rpy:2044
translate belarusian day3_draw_witness_class_62372d66:

    # voice "voice/Child/3day/10 A.ogg"
    # Classmate "А ты сам научился?"
    voice "voice/Child/3day/10 A.ogg"
    Classmate "А ты сам навучыўся?"

# game/scripts/scene/scene_day_3.rpy:2047
translate belarusian day3_draw_witness_class_3339e814:

    # voice "voice/Child/3day/11 Mo.ogg"
    # Classmate "Можешь Ван Дамма нарисовать? Я дома как плакат повешу!"
    voice "voice/Child/3day/11 Mo.ogg"
    Classmate "Можаш Ван Дама намаляваць? Я дома як плакат павешу!"

# game/scripts/scene/scene_day_3.rpy:2054
translate belarusian day3_draw_witness_class_b7a6158b:

    # voice "voice/kate/102 KA.ogg"
    # Kate "Эй, я вообще-то первая спросила!"
    voice "voice/kate/102 KA.ogg"
    Kate "Гэй, я наогул-та першая спытала!"

# game/scripts/scene/scene_day_3.rpy:2060
translate belarusian day3_draw_witness_class_8fc440e0:

    # "Катя подползла словно гадюка, незаметно вклинившись между мной и одноклассниками."
    "Каця падпаўзла нібы гадзюка, непрыкметна ўклініўшыся паміж мной і аднакласнікамі."

# game/scripts/scene/scene_day_3.rpy:2064
translate belarusian day3_draw_witness_class_2af12e86:

    # voice "voice/kate/103 KA.ogg"
    # Kate "Антон меня уже обещал нарисовать. По дружбе..."
    voice "voice/kate/103 KA.ogg"
    Kate "Антон мяне ўжо абяцаў намаляваць. Па дружбе..."

# game/scripts/scene/scene_day_3.rpy:2073
translate belarusian day3_draw_witness_class_25399a31:

    # voice "voice/kate/104 KA.ogg"
    # Kate "Да-да-да!"
    voice "voice/kate/104 KA.ogg"
    Kate "Так-так-так!"

# game/scripts/scene/scene_day_3.rpy:2078
translate belarusian day3_draw_witness_class_6aa92411:

    # voice "voice/kate/105 KA.ogg"
    # Kate "Правда же, Антон?"
    voice "voice/kate/105 KA.ogg"
    Kate "Праўда ж, Антон?"

# game/scripts/scene/scene_day_3.rpy:2083
translate belarusian day3_draw_witness_class_ec0fbd7d:

    # "«Как же!» — пронеслось у меня в голове."
    "«Яшчэ чаго!» — пранеслася ў мяне ў галаве."

# game/scripts/scene/scene_day_3.rpy:2088
translate belarusian day3_draw_witness_class_ca649212:

    # "Только я на что-то сгодился, так сразу ушлая Катя стала набиваться ко мне в друзья."
    "Толькі я на нешта згадзіўся, дык адразу хітрая Каця стала набівацца да мяне ў сябры."

# game/scripts/scene/scene_day_3.rpy:2090
translate belarusian day3_draw_witness_class_50e33216:

    # voice "voice/anton/3day/027 Pr.ogg"
    # Ant "Прости, но я уже обещал другой."
    voice "voice/anton/3day/027 Pr.ogg"
    Ant "Прабач, але я ўжо абяцаў іншай."

# game/scripts/scene/scene_day_3.rpy:2097
translate belarusian day3_draw_witness_class_6dd07138:

    # "Было видно, как дрогнуло Катино лицо, но она молча проглотила мой ответ."
    "Было відаць, як здрыгануўся Кацін твар, але яна моўчкі праглынула мой адказ."

# game/scripts/scene/scene_day_3.rpy:2138
translate belarusian day3_transit_wrong_fox_64fa5170:

    # "Я протиснулся сквозь баррикады парт, ища Полину…"
    "Я праціснуўся скрозь барыкады парт, шукаючы Паліну…"

# game/scripts/scene/scene_day_3.rpy:2177
translate belarusian day3_transit_witness_fox_bd1c0905:

    # "Я поспешил протиснуться сквозь радостно галдящих ребят, ища Полину…"
    "Я паспяшаўся праціснуцца скрозь хлопцаў, што радасна гаманілі, шукаючы Паліну…"

# game/scripts/scene/scene_day_3.rpy:2215
translate belarusian day3_transit_wrong_notfox_64fa5170:

    # "Я протиснулся сквозь баррикады парт, ища Полину…"
    "Я праціснуўся скрозь барыкады парт, шукаючы Паліну…"

# game/scripts/scene/scene_day_3.rpy:2253
translate belarusian day3_transit_witness_notfox_bd1c0905:

    # "Я поспешил протиснуться сквозь радостно галдящих ребят, ища Полину…"
    "Я паспяшаўся праціснуцца скрозь хлопцаў, што радасна гаманілі, шукаючы Паліну…"

# game/scripts/scene/scene_day_3.rpy:2271
translate belarusian day3_draw_notfox_5f7fd598:

    # "... а наткнулся на своих новых «товарищей»."
    "... а наткнуўся на сваіх новых «таварышаў»."

# game/scripts/scene/scene_day_3.rpy:2279
translate belarusian day3_draw_notfox_c02cb532:

    # "Ромка приблизился вразвалку."
    "Ромка наблізіўся ўразвалку."

# game/scripts/scene/scene_day_3.rpy:2284
translate belarusian day3_draw_notfox_f158495a:

    # voice "voice/romka/3day/04 Re.ogg"
    # Rom "Решил сдать нас ментам?"
    voice "voice/romka/3day/04 Re.ogg"
    Rom "Вырашыў здаць нас мянтам?"

# game/scripts/scene/scene_day_3.rpy:2290
translate belarusian day3_draw_notfox_da86ae60:

    # voice "voice/anton/3day/025 No.ogg"
    # Ant "Но я ничего не сказал."
    voice "voice/anton/3day/025 No.ogg"
    Ant "Але я нічога не сказаў."

# game/scripts/scene/scene_day_3.rpy:2297
translate belarusian day3_draw_notfox_011f0ccd:

    # voice "voice/byasha/3day/77 Zato.ogg"
    # Bya "Зато подумал, на."
    voice "voice/byasha/3day/77 Zato.ogg"
    Bya "Затое падумаў, на."

# game/scripts/scene/scene_day_3.rpy:2305
translate belarusian day3_draw_notfox_a9c33ee1:

    # "Ромка навис надо мной, дыша сигаретным душком."
    "Ромка навіс нада мной, дыхаючы цыгарэтным душком."

# game/scripts/scene/scene_day_3.rpy:2310
translate belarusian day3_draw_notfox_6d8fbc59:

    # voice "voice/romka/3day/05 Ti.ogg"
    # Rom "Ты сильно ошибаешься, думая, что без Сёмы у тебя настанут весёлые деньки."
    voice "voice/romka/3day/05 Ti.ogg"
    Rom "Ты моцна памыляешся, думаючы, што без Сёмы ў цябе настануць вясёлыя дзянькі."

# game/scripts/scene/scene_day_3.rpy:2317
translate belarusian day3_draw_notfox_c57e641e:

    # voice "voice/romka/3day/06 M.ogg"
    # Rom "Можешь не притворяться дурачком, пытаясь удивить Полину своей мазнёй, или корчить из себя психа."
    voice "voice/romka/3day/06 M.ogg"
    Rom "Можаш не прыкідвацца дурнікам, спрабуючы здзівіць Паліну сваёй мазнёй, ці строіць з сябе псіха."

# game/scripts/scene/scene_day_3.rpy:2322
translate belarusian day3_draw_notfox_1d53904c:

    # voice "voice/romka/3day/07 mi.ogg"
    # Rom "Мы тебя со свету сживём, понял?"
    voice "voice/romka/3day/07 mi.ogg"
    Rom "Мы цябе са свету зжывём, зразумеў?"

# game/scripts/scene/scene_day_3.rpy:2341
translate belarusian day3_draw_notfox_222027e8:

    # voice "voice/romka/3day/08 Do.ogg"
    # Rom "До скорого, очкарик!"
    voice "voice/romka/3day/08 Do.ogg"
    Rom "Да хуткага, ачкарык!"

# game/scripts/scene/scene_day_3.rpy:2361
translate belarusian day3_draw_notfox_912baf39:

    # "От подзатыльника моя голова резко качнулась вперёд."
    "Ад патылічніка мая галава рэзка хіснулася наперад."

# game/scripts/scene/scene_day_3.rpy:2378
translate belarusian day3_draw_notfox_5c12b84f:

    # voice "voice/byasha/3day/78 Vot.ogg"
    # Bya "Вот же лох, на!"
    voice "voice/byasha/3day/78 Vot.ogg"
    Bya "Вось жа лох, на!"

# game/scripts/scene/scene_day_3.rpy:2394
translate belarusian day3_draw_notfox_02d1649b:

    # "Я не удивился, обнаружив записку на моей спине:"
    "Я не здзівіўся, знайшоўшы запіску на маёй спіне:"

# game/scripts/scene/scene_day_3.rpy:2395
translate belarusian day3_draw_notfox_d8b86e34:

    # "ПНИ МЕНЯ!"
    "КАПНІ МЯНЕ!"

# game/scripts/scene/scene_day_3.rpy:2397
translate belarusian day3_draw_notfox_14a82f11:

    # "Кошмар завёлся по новой."
    "Кашмар завёўся па новай."

# game/scripts/scene/scene_day_3.rpy:2412
translate belarusian day3_draw_fox_e268d836:

    # "... а наткнулся на своих новых товарищей."
    "... а наткнуўся на сваіх новых таварышаў."

# game/scripts/scene/scene_day_3.rpy:2414
translate belarusian day3_draw_fox_b344ba2c:

    # "Ромка и Бяша караулили у расписания."
    "Ромка і Бяша пільнавалі каля раскладу."

# game/scripts/scene/scene_day_3.rpy:2418
translate belarusian day3_draw_fox_e3f190a0:

    # voice "voice/romka/3day/09 Ya.ogg"
    # Rom "Я в тебе не ошибся, Тошик."
    voice "voice/romka/3day/09 Ya.ogg"
    Rom "Я ў табе не памыліўся, Тошык."

# game/scripts/scene/scene_day_3.rpy:2424
translate belarusian day3_draw_fox_e1d70d3c:

    # voice "voice/romka/3day/10 Pa.ogg"
    # Rom "Пацан! Не спалил, как мы чуть было Свинью не забили."
    voice "voice/romka/3day/10 Pa.ogg"
    Rom "Пацан! Не спаліў, як мы ледзь было Свінню не забілі."

# game/scripts/scene/scene_day_3.rpy:2429
translate belarusian day3_draw_fox_1a3ef2cf:

    # voice "voice/anton/3day/028 Eto.ogg"
    # Ant "Это повело бы милицию по ложному следу."
    voice "voice/anton/3day/028 Eto.ogg"
    Ant "Гэта павяло б міліцыю па ілжывым следзе."

# game/scripts/scene/scene_day_3.rpy:2432
translate belarusian day3_draw_fox_0c4a3634:

    # voice "voice/anton/3day/028 Na.ogg"
    # Ant "Наверное..."
    voice "voice/anton/3day/028 Na.ogg"
    Ant "Напэўна..."

# game/scripts/scene/scene_day_3.rpy:2434
translate belarusian day3_draw_fox_6c36f803:

    # voice "voice/anton/3day/029 A.ogg"
    # Ant "А вы точно не имеете отношения к исчезновению Свин... Семёна?"
    voice "voice/anton/3day/029 A.ogg"
    Ant "А вы дакладна не маеце дачынення да знікнення Свін... Сямёна?"

# game/scripts/scene/scene_day_3.rpy:2439
translate belarusian day3_draw_fox_3d10c588:

    # voice "voice/romka/3day/11 M.ogg"
    # Rom "Мы-то нет, а вот ты?"
    voice "voice/romka/3day/11 M.ogg"
    Rom "Мы дык не, а вось ты?"

# game/scripts/scene/scene_day_3.rpy:2445
translate belarusian day3_draw_fox_e4db2e0b:

    # voice "voice/romka/3day/12 Po.ogg"
    # Rom "Помнишь, как срулил от нас в потёмках?"
    voice "voice/romka/3day/12 Po.ogg"
    Rom "Памятаеш, як зваліў ад нас у цемры?"

# game/scripts/scene/scene_day_3.rpy:2452
translate belarusian day3_draw_fox_62205c80:

    # voice "voice/byasha/3day/79 A.ogg"
    # Bya "Ага! Я такой говорю: очкарик – зверь."
    voice "voice/byasha/3day/79 A.ogg"
    Bya "Ага! Я такі кажу: ачкарык — звер."

# game/scripts/scene/scene_day_3.rpy:2458
translate belarusian day3_draw_fox_3ed84c1b:

    # voice "voice/byasha/3day/80 Sh.ogg"
    # Bya "Ща жирного нагонит и кокнет, на!"
    voice "voice/byasha/3day/80 Sh.ogg"
    Bya "Зараз тлустага дагоніць і кокне, на!"

# game/scripts/scene/scene_day_3.rpy:2465
translate belarusian day3_draw_fox_cfb5a8cd:

    # voice "voice/romka/3day/13 baz.ogg"
    # Rom "Базаришь!"
    voice "voice/romka/3day/13 baz.ogg"
    Rom "Базарыш!"

# game/scripts/scene/scene_day_3.rpy:2472
translate belarusian day3_draw_fox_87bd7d11:

    # voice "voice/romka/3day/14 Od.ogg"
    # Rom "Однако мы тебе верим. А ты нам?"
    voice "voice/romka/3day/14 Od.ogg"
    Rom "Аднак мы табе верым. А ты нам?"

# game/scripts/scene/scene_day_3.rpy:2477
translate belarusian day3_draw_fox_cc26a277:

    # "Ромка серьёзно взглянул мне в глаза так, что стало неловко, и я закивал."
    "Ромка сур'ёзна зірнуў мне ў вочы так, што стала няёмка, і я заківаў."

# game/scripts/scene/scene_day_3.rpy:2481
translate belarusian day3_draw_fox_3d89ddf4:

    # voice "voice/romka/3day/15 Vo.ogg"
    # Rom "Вот и славно."
    voice "voice/romka/3day/15 Vo.ogg"
    Rom "Вось і слаўна."

# game/scripts/scene/scene_day_3.rpy:2492
translate belarusian day3_draw_fox_507e3864:

    # voice "voice/byasha/3day/81 Et.ogg"
    # Bya "Это... Антош, а где ты так классно рисовать научился?"
    voice "voice/byasha/3day/81 Et.ogg"
    Bya "Гэта... Антош, а дзе ты так класна маляваць навучыўся?"

# game/scripts/scene/scene_day_3.rpy:2497
translate belarusian day3_draw_fox_14af39f8:

    # "Я смутился, но виду не подал. Ковырнул носком ботинка пол."
    "Я збянтэжыўся, але выгляду не падаў. Калупнуў наском чаравіка падлогу."

# game/scripts/scene/scene_day_3.rpy:2498
translate belarusian day3_draw_fox_d79acc1d:

    # voice "voice/anton/3day/030 Da.ogg"
    # Ant "Да так. У меня с детства хорошо получалось."
    voice "voice/anton/3day/030 Da.ogg"
    Ant "Ды так. У мяне з дзяцінства добра атрымлівалася."

# game/scripts/scene/scene_day_3.rpy:2503
translate belarusian day3_draw_fox_2d49b15b:

    # voice "voice/byasha/3day/82 K.ogg"
    # Bya "Круто! Я вот тоже... художник."
    voice "voice/byasha/3day/82 K.ogg"
    Bya "Крута! Я вось таксама... мастак."

# game/scripts/scene/scene_day_3.rpy:2510
translate belarusian day3_draw_fox_9d06e115:

    # voice "voice/byasha/3day/84 Pa.ogg"
    # Bya "Паяльником по дереву выжигаю, на."
    voice "voice/byasha/3day/84 Pa.ogg"
    Bya "Паяльнікам па дрэве выпальваю, на."

# game/scripts/scene/scene_day_3.rpy:2516
translate belarusian day3_draw_fox_7b9199f6:

    # voice "voice/byasha/3day/85 Von.ogg"
    # Bya "Вон, мамке на день рождения тюльпан замутил на разделочной доске."
    voice "voice/byasha/3day/85 Von.ogg"
    Bya "Вунь, мамцы на дзень нараджэння цюльпан замуціў на апрацоўчай дошцы."

# game/scripts/scene/scene_day_3.rpy:2522
translate belarusian day3_draw_fox_cdcc38b1:

    # voice "voice/byasha/3day/86 V.ogg"
    # Bya "В общем, здорово, что мы с тобой познакомились."
    voice "voice/byasha/3day/86 V.ogg"
    Bya "Увогуле, здорава, што мы з табой пазнаёміліся."

# game/scripts/scene/scene_day_3.rpy:2529
translate belarusian day3_draw_fox_b746de6a:

    # voice "voice/romka/3day/16 T.ogg"
    # Rom "Только давайте не будем обниматься на радостях."
    voice "voice/romka/3day/16 T.ogg"
    Rom "Толькі давайце не будзем абдымацца ад радасці."

# game/scripts/scene/scene_day_3.rpy:2535
translate belarusian day3_draw_fox_e023f3e4:

    # "Ромка понизил тон и с подозрением оглядел коридор."
    "Ромка панізіў тон і з падазрэннем агледзеў калідор."

# game/scripts/scene/scene_day_3.rpy:2537
translate belarusian day3_draw_fox_942a5fea:

    # "Дети поглядывали на нас, шёпотом переговаривались."
    "Дзеці пазіралі на нас, шэптам перамаўляліся."

# game/scripts/scene/scene_day_3.rpy:2541
translate belarusian day3_draw_fox_cb4dd344:

    # voice "voice/romka/3day/17 Sh.ogg"
    # Rom "Что ж, Сёма пропал, это правда."
    voice "voice/romka/3day/17 Sh.ogg"
    Rom "Што ж, Сёма знік, гэта праўда."

# game/scripts/scene/scene_day_3.rpy:2547
translate belarusian day3_draw_fox_717c814f:

    # voice "voice/romka/3day/18 K.ogg"
    # Rom "Как и факт, что не просто пропал, а, скорей всего, уже сдох."
    voice "voice/romka/3day/18 K.ogg"
    Rom "Як і факт, што не проста знік, а, хутчэй за ўсё, ужо здох."

# game/scripts/scene/scene_day_3.rpy:2557
translate belarusian day3_draw_fox_a6add373:

    # voice "voice/byasha/64 Otshat.ogg"
    # "Бяша нервно передёрнулся."
    voice "voice/byasha/64 Otshat.ogg"
    "Бяша нервова скалануўся."

# game/scripts/scene/scene_day_3.rpy:2562
translate belarusian day3_draw_fox_8ad33688:

    # voice "voice/anton/3day/031 A.ogg"
    # Ant "А ты почём знаешь?"
    voice "voice/anton/3day/031 A.ogg"
    Ant "А ты адкуль ведаеш?"

# game/scripts/scene/scene_day_3.rpy:2567
translate belarusian day3_draw_fox_562d3a99:

    # voice "voice/romka/3day/19 D.ogg"
    # Rom "Дык!"
    voice "voice/romka/3day/19 D.ogg"
    Rom "Дык!"

# game/scripts/scene/scene_day_3.rpy:2573
translate belarusian day3_draw_fox_96cdf64b:

    # voice "voice/romka/3day/29 M.ogg"
    # Rom "Мы за это уже тёрли: здесь такие случаи не впервой."
    voice "voice/romka/3day/29 M.ogg"
    Rom "Мы пра гэта ўжо церлі: тут такія выпадкі не ўпершыню."

# game/scripts/scene/scene_day_3.rpy:2594
translate belarusian day3_draw_fox_996afcbc:

    # voice "voice/romka/3day/30 D.ogg"
    # Rom "Думаешь, Сенечка, Вова этот и Сёма в Нарнию попали?"
    voice "voice/romka/3day/30 D.ogg"
    Rom "Думаеш, Сенечка, Вова гэты і Сёма ў Нарнію трапілі?"

# game/scripts/scene/scene_day_3.rpy:2600
translate belarusian day3_draw_fox_9f222d41:

    # voice "voice/romka/3day/31 P.ogg"
    # Rom "Посидят в лесу с карамелькой за щекой и назад пришлёпают?"
    voice "voice/romka/3day/31 P.ogg"
    Rom "Пасядзяць у лесе з карамелькай за шчакой і назад прышлёпаюць?"

# game/scripts/scene/scene_day_3.rpy:2606
translate belarusian day3_draw_fox_506511b4:

    # voice "voice/romka/3day/32 Ya.ogg"
    # Rom "Ясно же, кто их к себе прибрал."
    voice "voice/romka/3day/32 Ya.ogg"
    Rom "Ясна ж, хто іх да сябе прыбраў."

# game/scripts/scene/scene_day_3.rpy:2611
translate belarusian day3_draw_fox_20f02d1d:

    # voice "voice/anton/3day/032 N.ogg"
    # Ant "Неужели Чёрный..."
    voice "voice/anton/3day/032 N.ogg"
    Ant "Няўжо Чорны..."

# game/scripts/scene/scene_day_3.rpy:2622
translate belarusian day3_draw_fox_d93b1d70:

    # voice "voice/byasha/3day/87 Ma.ogg"
    # Bya "Маньячелло!"
    voice "voice/byasha/3day/87 Ma.ogg"
    Bya "Маньячэла!"

# game/scripts/scene/scene_day_3.rpy:2629
translate belarusian day3_draw_fox_5602cd31:

    # voice "voice/byasha/3day/88 BL.ogg"
    # Bya "Бля буду, пацаны! Это всё местный {u}Чикатило{/u}, на."
    voice "voice/byasha/3day/88 BL.ogg"
    Bya "Бля буду, пацаны! Гэта ўсё мясцовы {u}Чыкаціла{/u}, на."

# game/scripts/scene/scene_day_3.rpy:2637
translate belarusian day3_draw_fox_68ffcc6c:

    # voice "voice/byasha/3day/89 Mne.ogg"
    # Bya "Мне дядька с маминой работы рассказывал: он тоже Зайчью губу в посёлке видел."
    voice "voice/byasha/3day/89 Mne.ogg"
    Bya "Мне дзядзька з мамінай працы расказваў: ён таксама Заячую губу ў пасёлку бачыў."

# game/scripts/scene/scene_day_3.rpy:2642
translate belarusian day3_draw_fox_2ae7a9d0:

    # voice "voice/anton/3day/033 V.ogg"
    # Ant "Вычислить бы ещё, кто он такой."
    voice "voice/anton/3day/033 V.ogg"
    Ant "Вылічыць бы яшчэ, хто ён такі."

# game/scripts/scene/scene_day_3.rpy:2651
translate belarusian day3_draw_fox_ac2af4c5:

    # voice "voice/romka/3day/33 Nu.ogg"
    # Rom "Ну, если этот убийца Бабурина завалил – он и по нашу душу явится, отвечаю."
    voice "voice/romka/3day/33 Nu.ogg"
    Rom "Ну, калі гэты забойца Бабурына заваліў — ён і па нашу душу з'явіцца, адказваю."

# game/scripts/scene/scene_day_3.rpy:2667
translate belarusian day3_draw_fox_20da0b8f:

    # voice "voice/anton/3day/034 S.ogg"
    # Ant "Слушайте, пока Тихонов лекцию читал, я в его папку тайком заглянул."
    voice "voice/anton/3day/034 S.ogg"
    Ant "Слухайце, пакуль Ціханаў лекцыю чытаў, я ў яго папку тайком зазірнуў."

# game/scripts/scene/scene_day_3.rpy:2674
translate belarusian day3_draw_fox_b9d7f0da:

    # "Бяша присвистнул."
    "Бяша прысвіснуў."

# game/scripts/scene/scene_day_3.rpy:2675
translate belarusian day3_draw_fox_cbe188b2:

    # voice "voice/anton/3day/035 T.ogg"
    # Ant "Там лежало кое-что... печатка."
    voice "voice/anton/3day/035 T.ogg"
    Ant "Там ляжала сёе-тое... пячатка."

# game/scripts/scene/scene_day_3.rpy:2678
translate belarusian day3_draw_fox_08873c02:

    # voice "voice/anton/3day/036 S.ogg"
    # Ant "Сёмина печатка. И я её того... прихватил."
    voice "voice/anton/3day/036 S.ogg"
    Ant "Сёміна пячатка. І я яе таго... прыхапіў."

# game/scripts/scene/scene_day_3.rpy:2681
translate belarusian day3_draw_fox_3c14c43d:

    # voice "voice/byasha/3day/90 Da.ogg"
    # Bya "Да ладно! А ну закежь!"
    voice "voice/byasha/3day/90 Da.ogg"
    Bya "Ды ладна! А ну закеж!"

# game/scripts/scene/scene_day_3.rpy:2702
translate belarusian day3_draw_fox_812ead4c:

    # "Я воровато огляделся, а затем аккуратно показал украденный перстень."
    "Я зладзейску азірнуўся, а затым акуратна паказаў скрадзены пярсцёнак."

# game/scripts/scene/scene_day_3.rpy:2710
translate belarusian day3_draw_fox_3b6c8691:

    # voice "voice/byasha/3day/92 T.ogg"
    # Bya "Так я и думал, на! Маньячелло."
    voice "voice/byasha/3day/92 T.ogg"
    Bya "Так я і думаў, на! Маньячэла."

# game/scripts/scene/scene_day_3.rpy:2717
translate belarusian day3_draw_fox_f4b36d9a:

    # voice "voice/byasha/3day/93 Na.ogg"
    # Bya "На части нас разрежет."
    voice "voice/byasha/3day/93 Na.ogg"
    Bya "На часткі нас разрэжа."

# game/scripts/scene/scene_day_3.rpy:2722
translate belarusian day3_draw_fox_8eb1f658:

    # "Рому информация не впечатлила. Он лишь мрачно кивнул."
    "Рому інфармацыя не ўразіла. Ён толькі змрочна кіўнуў."

# game/scripts/scene/scene_day_3.rpy:2726
translate belarusian day3_draw_fox_c8c6d8c8:

    # voice "voice/anton/3day/037 A.ogg"
    # Ant "А ещё там фотография была... с гаражом. Чёрным."
    voice "voice/anton/3day/037 A.ogg"
    Ant "А яшчэ там фотаздымак быў... з гаражом. Чорным."

# game/scripts/scene/scene_day_3.rpy:2734
translate belarusian day3_draw_fox_fb76289d:

    # "Бяшу словно ударили под дых. Он отшатнулся, рукой заслонил лицо."
    "Бяшу нібы ўдарылі пад дых. Ён адхіснуўся, рукой засланіў твар."

# game/scripts/scene/scene_day_3.rpy:2739
translate belarusian day3_draw_fox_78ded07b:

    # "Ромка закатил глаза и выругался."
    "Ромка закаціў вочы і вылаяўся."

# game/scripts/scene/scene_day_3.rpy:2743
translate belarusian day3_draw_fox_8662809a:

    # voice "voice/romka/3day/34 O.ogg"
    # Rom "Опять двадцать пять."
    voice "voice/romka/3day/34 O.ogg"
    Rom "Зноў дваццаць пяць."

# game/scripts/scene/scene_day_3.rpy:2749
translate belarusian day3_draw_fox_65184e46:

    # voice "voice/romka/3day/35 Nu.ogg"
    # Rom "Ну, спокойно, братан, спокойно."
    voice "voice/romka/3day/35 Nu.ogg"
    Rom "Ну, спакойна, братан, спакойна."

# game/scripts/scene/scene_day_3.rpy:2754
translate belarusian day3_draw_fox_b89faa0a:

    # voice "voice/anton/3day/038 B.ogg"
    # Ant "Бяша, ты же встречал Чёрный Гараж раньше, так?"
    voice "voice/anton/3day/038 B.ogg"
    Ant "Бяша, ты ж сустракаў Чорны Гараж раней, так?"

# game/scripts/scene/scene_day_3.rpy:2756
translate belarusian day3_draw_fox_f205637d:

    # voice "voice/anton/3day/038 R.ogg"
    # Ant "Рома говорил, что ты даже заглянул в него."
    voice "voice/anton/3day/038 R.ogg"
    Ant "Рома казаў, што ты нават зазірнуў у яго."

# game/scripts/scene/scene_day_3.rpy:2761
translate belarusian day3_draw_fox_49010965:

    # "Бурятика била крупная дрожь, словно его нагим выбросили на стужу, и каждый мой последующий вопрос окатывал его как из ведра." id day3_draw_fox_49010965
    "Бураціка білі буйныя дрыжыкі, нібы яго голага выкінулі на сцюжу, і кожнае маё наступнае пытанне аблівала яго як з вядра." id day3_draw_fox_49010965

# game/scripts/scene/scene_day_3.rpy:2762
translate belarusian day3_draw_fox_3069eeec:

    # voice "voice/anton/3day/039 Ch.ogg"
    # Ant "Что ты там видел?"
    voice "voice/anton/3day/039 Ch.ogg"
    Ant "Што ты там бачыў?"

# game/scripts/scene/scene_day_3.rpy:2770
translate belarusian day3_draw_fox_76608aac:

    # voice "voice/byasha/3day/97 Bee A.ogg"
    # Bya "Бе-бе-бе-е-е..." id day3_draw_fox_76608aac
    voice "voice/byasha/3day/97 Bee A.ogg"
    Bya "Бе-бе-бе-е-е..." id day3_draw_fox_76608aac

# game/scripts/scene/scene_day_3.rpy:2787
translate belarusian day3_draw_fox_bb3e7275:

    # "Ромка заслонил приятеля грудью, явно недовольный моим допросом."
    "Ромка засланіў прыяцеля грудзьмі, відавочна незадаволены маім допытам."

# game/scripts/scene/scene_day_3.rpy:2791
translate belarusian day3_draw_fox_bbc18f08:

    # voice "voice/romka/3day/36 Za.ogg"
    # Rom "Забудь! Ничё он тебе толком не скажет."
    voice "voice/romka/3day/36 Za.ogg"
    Rom "Забудзь! Нічога ён табе толкам не скажа."

# game/scripts/scene/scene_day_3.rpy:2797
translate belarusian day3_draw_fox_122e27ce:

    # voice "voice/romka/3day/37 B.ogg"
    # Rom "Бяше каждый раз мозг набекрень сворачивает, только коснись этой темы."
    voice "voice/romka/3day/37 B.ogg"
    Rom "Бяшу кожны раз мозг набакір зварочвае, толькі крані гэту тэму."

# game/scripts/scene/scene_day_3.rpy:2804
translate belarusian day3_draw_fox_e40dc1ca:

    # voice "voice/romka/3day/38 K.ogg"
    # Rom "Коль ты теперь с нами, я тебе в первый и последний раз рассказываю..."
    voice "voice/romka/3day/38 K.ogg"
    Rom "Раз ты цяпер з намі, я табе ў першы і апошні раз расказваю..."

# game/scripts/scene/scene_day_3.rpy:2810
translate belarusian day3_draw_fox_d89856a0:

    # "Ромка заговорщицки склонился ко мне, брезгливо сморщился и, словно нехотя возвращаясь к воспоминаниям, зашептал:"
    "Ромка па-змоўніцку схіліўся да мяне, грэбліва зморшчыўся і, нібы неахвотна вяртаючыся да ўспамінаў, зашаптаў:"

# game/scripts/scene/scene_day_3.rpy:2815
translate belarusian day3_draw_fox_deda0fdd:

    # voice "voice/romka/3day/39 O.ogg"
    # Rom "Осенью мы с пацанами от нефиг делать чёрной магией баловались: хотели, как обычно, призвать Пиковую даму там, или над духом Пушкина постебаться... то да сё."
    voice "voice/romka/3day/39 O.ogg"
    Rom "Увосень мы з пацанамі ад нефіг рабіць чорнай магіяй бавіліся: хацелі, як звычайна, выклікаць Пікавую даму там, ці над духам Пушкіна пасцябацца... тое ды сёе."

# game/scripts/scene/scene_day_3.rpy:2817
translate belarusian day3_draw_fox_ac2e03c2:

    # voice "voice/romka/3day/40 A.ogg"
    # Rom "А вышло, брат, совсем не весело."
    voice "voice/romka/3day/40 A.ogg"
    Rom "А выйшла, брат, зусім не весела."

# game/scripts/scene/scene_day_3.rpy:2819
translate belarusian day3_draw_fox_a9c3bb44:

    # voice "voice/romka/3day/41 O.ogg"
    # Rom "Один старый чудила рассказал, что мы можем призвать настоящего духа, если нарушим один строжайший запрет предков."
    voice "voice/romka/3day/41 O.ogg"
    Rom "Адзін стары дзівак расказаў, што мы можам выклікаць сапраўднага духа, калі парушым адну найстражэйшую забарону продкаў."

# game/scripts/scene/scene_day_3.rpy:2821
translate belarusian day3_draw_fox_17d04ac7:

    # voice "voice/romka/3day/42 Ch.ogg"
    # Rom "Чёрт, а я ведь сразу просёк, что он ёбнутый..."
    voice "voice/romka/3day/42 Ch.ogg"
    Rom "Чорт, а я ж адразу прасёк, што ён ёбнуты..."

# game/scripts/scene/scene_day_3.rpy:2823
translate belarusian day3_draw_fox_aba4f7dd:

    # voice "voice/romka/3day/43 V.ogg"
    # Rom "Всего-то надо было пойти за гаражи глубокой ночью..."
    voice "voice/romka/3day/43 V.ogg"
    Rom "Усяго толькі трэба было пайсці за гаражы глыбокай ноччу..."

# game/scripts/scene/scene_day_3.rpy:2826
translate belarusian day3_draw_fox_218754cc:

    # voice "voice/romka/3day/44 E.ogg"
    # Rom "... и постучать в самый-самый чёрный, мать его. "
    voice "voice/romka/3day/44 E.ogg"
    Rom "... і пастукаць у самы-самы чорны, маць яго. "

# game/scripts/scene/scene_day_3.rpy:2828
translate belarusian day3_draw_fox_a3e6fa3e:

    # voice "voice/romka/3day/45 Ta.ogg"
    # Rom "Так, мол, явится эта чёрная параша и всех детей заберёт в лучший из миров. Охереть — не встать!"
    voice "voice/romka/3day/45 Ta.ogg"
    Rom "Так, маўляў, з'явіцца гэта чорная параша і ўсіх дзяцей забярэ ў лепшы са светаў. Ахерэць — не ўстаць!"

# game/scripts/scene/scene_day_3.rpy:2830
translate belarusian day3_draw_fox_4378d672:

    # voice "voice/romka/3day/46 Vo.ogg"
    # Rom "Вот мы по приколу и клюнули."
    voice "voice/romka/3day/46 Vo.ogg"
    Rom "Вось мы па прыколе і клюнулі."

# game/scripts/scene/scene_day_3.rpy:2840
translate belarusian day3_draw_fox_cd063b61:

    # "Бяша обхватил голову руками и протяжно замычал."
    "Бяша абхапіў галаву рукамі і працяжна замугыкаў."

# game/scripts/scene/scene_day_3.rpy:2848
translate belarusian day3_draw_fox_61246a2e:

    # voice "voice/byasha/3day/97 be.ogg"
    # Bya "Бе-бе-е-бе."
    voice "voice/byasha/3day/97 be.ogg"
    Bya "Бе-бе-е-бе."

# game/scripts/scene/scene_day_3.rpy:2858
translate belarusian day3_draw_fox_55421c27:

    # voice "voice/romka/3day/48 A.ogg"
    # Rom "А когда Бяша тест на пацана проходил, то должен был в этот Гараж постучать, но эта хитрая морда просто туда заглянул."
    voice "voice/romka/3day/48 A.ogg"
    Rom "А калі Бяша тэст на пацана праходзіў, дык павінен быў у гэты Гараж пастукаць, але гэтая хітрая морда проста туды зазірнуў."

# game/scripts/scene/scene_day_3.rpy:2864
translate belarusian day3_draw_fox_f66433e4:

    # voice "voice/romka/3day/50 E.ogg"
    # Rom "И правильно сделал."
    voice "voice/romka/3day/50 E.ogg"
    Rom "І правільна зрабіў."

# game/scripts/scene/scene_day_3.rpy:2870
translate belarusian day3_draw_fox_9824f3a3:

    # voice "voice/romka/3day/51 On.ogg"
    # Rom "Он от ужаса тогда так заорал, что слезы брызнули."
    voice "voice/romka/3day/51 On.ogg"
    Rom "Ён ад жаху тады так загарлапаніў, што слёзы пырснулі."

# game/scripts/scene/scene_day_3.rpy:2876
translate belarusian day3_draw_fox_747b09f8:

    # voice "voice/romka/3day/52 Ot.ogg"
    # Rom "Отвечаю, я такой истерики отродясь не видел."
    voice "voice/romka/3day/52 Ot.ogg"
    Rom "Адказваю, я такой істэрыкі зроду не бачыў."

# game/scripts/scene/scene_day_3.rpy:2882
translate belarusian day3_draw_fox_b1202bfb:

    # voice "voice/romka/3day/53 Ya.ogg"
    # Rom "Явно там не обещанная райская куща была."
    voice "voice/romka/3day/53 Ya.ogg"
    Rom "Відавочна там не абяцаная райская кушча была."

# game/scripts/scene/scene_day_3.rpy:2888
translate belarusian day3_draw_fox_6ce97580:

    # voice "voice/romka/3day/54 S.ogg"
    # Rom "С тех пор Чёрный Гараж по нашим закоулкам шарится и нормальных пацанов жрёт."
    voice "voice/romka/3day/54 S.ogg"
    Rom "З тых часоў Чорны Гараж па нашых завулках шарыцца і нармальных пацаноў жрэ."

# game/scripts/scene/scene_day_3.rpy:2901
translate belarusian day3_suefa_2effae3d:

    # voice "voice/anton/3day/040 Chto.ogg"
    # Ant "Что же делать?"
    voice "voice/anton/3day/040 Chto.ogg"
    Ant "Што ж рабіць?"

# game/scripts/scene/scene_day_3.rpy:2907
translate belarusian day3_suefa_939aa76d:

    # voice "voice/romka/3day/55 V.ogg"
    # Rom "Вместе держаться, вот что. Втроём мы как {u}Вольтрон{/u}."
    voice "voice/romka/3day/55 V.ogg"
    Rom "Разам трымацца, вось што. Утрох мы як {u}Вальтрон{/u}."

# game/scripts/scene/scene_day_3.rpy:2917
translate belarusian day3_suefa_44528941:

    # "Неожиданно отошедший от шока Бяша промямлил:"
    "Нечакана адышоўшы ад шоку, Бяша прамямліў:"

# game/scripts/scene/scene_day_3.rpy:2920
translate belarusian day3_suefa_65e597c7:

    # voice "voice/byasha/3day/98 Eto.ogg"
    # Bya "Это..."
    voice "voice/byasha/3day/98 Eto.ogg"
    Bya "Гэта..."

# game/scripts/scene/scene_day_3.rpy:2926
translate belarusian day3_suefa_09f31088:

    # voice "voice/byasha/3day/99 V.ogg"
    # Bya "В Вольтроне их пятеро было, на."
    voice "voice/byasha/3day/99 V.ogg"
    Bya "У Вальтроне іх пяцёра было, на."

# game/scripts/scene/scene_day_3.rpy:2933
translate belarusian day3_suefa_0c332d98:

    # voice "voice/romka/3day/56 Nu.ogg"
    # Rom "Ну, считай, мы покалеченный Вольтрон."
    voice "voice/romka/3day/56 Nu.ogg"
    Rom "Ну, лічы, мы пакалечаны Вальтрон."

# game/scripts/scene/scene_day_3.rpy:2940
translate belarusian day3_suefa_6fe9b509:

    # "Он кивнул мне совсем по-взрослому, а его глаза были полными тревоги и грусти."
    "Ён кіўнуў мне зусім па-даросламу, а яго вочы былі поўныя трывогі і смутку."

# game/scripts/scene/scene_day_3.rpy:2945
translate belarusian day3_suefa_4d8d110a:

    # voice "voice/romka/3day/57 La.ogg"
    # Rom "Ладно, раз Сёмы больше нет... Айда с нами!"
    voice "voice/romka/3day/57 La.ogg"
    Rom "Добра, раз Сёмы больш няма... Гайда з намі!"

# game/scripts/scene/scene_day_3.rpy:2974
translate belarusian day3_suefa_a60f5ca6:

    # voice "voice/romka/3day/58 D.ogg"
    # Rom "Дело одно есть: постоишь для вида, покараулишь. Тебя, кажется, уже боятся все."
    voice "voice/romka/3day/58 D.ogg"
    Rom "Справа адна ёсць: пастаіш для выгляду, папільнуеш. Цябе, здаецца, ужо баяцца ўсе."

# game/scripts/scene/scene_day_3.rpy:2977
translate belarusian day3_suefa_39b9f0d4:

    # "Меня? Боятся?"
    "Мяне? Баяцца?"

# game/scripts/scene/scene_day_3.rpy:2978
translate belarusian day3_suefa_93f330e4:

    # "И хотя это не укладывалось в голове, меня раздобрило их отношение, и я тут же согласился."
    "І хоць гэта не ўкладвалася ў галаве, мяне раздабрыла іх стаўленне, і я адразу пагадзіўся."

# game/scripts/scene/scene_day_3.rpy:2982
translate belarusian day3_suefa_84031f32:

    # "Я шёл за Ромкой и Бяшей по сумрачным туннелям школы, дегустируя совершенно новое чувство вседозволенности."
    "Я ішоў за Ромкам і Бяшам па змрочных тунэлях школы, дэгустуючы зусім новае пачуццё ўседазволенасці."

# game/scripts/scene/scene_day_3.rpy:2983
translate belarusian day3_suefa_68c9d36c:

    # "Мы шагали картинно, будто герои какого-то криминального фильма."
    "Мы крочылі карцінна, быццам героі нейкага крымінальнага фільма."

# game/scripts/scene/scene_day_3.rpy:2985
translate belarusian day3_suefa_0a7d8871:

    # "Словно только мы втроём обладали некой информацией, недоступной всем прочим."
    "Быццам толькі мы ўтрох валодалі нейкай інфармацыяй, недаступнай усім астатнім."

# game/scripts/scene/scene_day_3.rpy:2988
translate belarusian day3_suefa_acd464d8:

    # "Не знаю, пошёл бы я с ними, если б мне сразу объяснили цель кампании."
    "Не ведаю, ці пайшоў бы я з імі, калі б мне адразу патлумачылі мэту кампаніі."

# game/scripts/scene/scene_day_3.rpy:2997
translate belarusian day3_suefa_00cf44f0:

    # "Мы затаились в темноте у спортзала, а ребята начали потирать костяшки, глядя на выходящих из раздевалки мальчиков."
    "Мы прытаіліся ў цемры каля спартзалы, а хлопцы пачалі паціраць костачкі, гледзячы на хлопчыкаў, што выходзілі з раздзявалкі."

# game/scripts/scene/scene_day_3.rpy:3002
translate belarusian day3_suefa_ef2c479f:

    # "Наконец Бяша ткнул пальцем в кого-то из толпы."
    "Нарэшце Бяша тыцнуў пальцам у кагосьці з натоўпу."

# game/scripts/scene/scene_day_3.rpy:3010
translate belarusian day3_suefa_8b5be5a6:

    # voice "voice/byasha/3day/100 Vo.ogg"
    # Bya "Вон этот лох!"
    voice "voice/byasha/3day/100 Vo.ogg"
    Bya "Вунь гэты лох!"

# game/scripts/scene/scene_day_3.rpy:3015
translate belarusian day3_suefa_690a1642:

    # "Ромка опасно заулыбался и кинул прокуренным голосом:"
    "Ромка небяспечна заўсміхаўся і кінуў пракураным голасам:"

# game/scripts/scene/scene_day_3.rpy:3020
translate belarusian day3_suefa_16210ca8:

    # voice "voice/romka/3day/59 S.ogg"
    # Rom "Стой на стрёме. Если кто из училок объявится — дай знать."
    voice "voice/romka/3day/59 S.ogg"
    Rom "Стой на стромі. Калі нехта з настаўніц з'явіцца — дай знаць."

# game/scripts/scene/scene_day_3.rpy:3029
translate belarusian day3_suefa_5e047216:

    # voice "voice/byasha/3day/101 G.ogg"
    # Bya "Гляди в четыре глаза, на."
    voice "voice/byasha/3day/101 G.ogg"
    Bya "Глядзі ў чатыры вокі, на."

# game/scripts/scene/scene_day_3.rpy:3036
translate belarusian day3_suefa_0ebf394d:

    # voice "voice/romka/3day/60 Davai.ogg"
    # "Я встал на углу, переполненный самыми разными мыслями и чувствами."
    voice "voice/romka/3day/60 Davai.ogg"
    "Я стаў на рагу, перапоўнены самымі рознымі думкамі і пачуццямі."

# game/scripts/scene/scene_day_3.rpy:3038
translate belarusian day3_suefa_fe40110a:

    # voice "voice/romka/3day/60 Nono.ogg"
    # "В закутке позади Ромка переговаривался с пятиклассником."
    voice "voice/romka/3day/60 Nono.ogg"
    "У закутку ззаду Ромка перамаўляўся з пяцікласнікам."

# game/scripts/scene/scene_day_3.rpy:3040
translate belarusian day3_suefa_54461ec3:

    # voice "voice/romka/3day/60 Schet.ogg"
    # "Мальчик едва не хныкал, что-то доказывая, но Ромка гнул свою линию, забористо бранясь, а Бяша лишь изредка подгавкивал."
    voice "voice/romka/3day/60 Schet.ogg"
    "Хлопчык ледзь не хныкаў, нешта даказваючы, але Ромка гнуў сваю лінію, заўзята лаючыся, а Бяша толькі зрэдку падбрахваў."

# game/scripts/scene/scene_day_3.rpy:3042
translate belarusian day3_suefa_1d02d079:

    # voice "voice/romka/3day/30 Cry.ogg"
    # "Похвалил бы меня папа за то, что я связался с ними?"
    voice "voice/romka/3day/30 Cry.ogg"
    "Ці пахваліў бы мяне тата за тое, што я звязаўся з імі?"

# game/scripts/scene/scene_day_3.rpy:3045
translate belarusian day3_suefa_cad86628:

    # voice "voice/romka/3day/61 v.ogg"
    # Rom "Всё, вали давай."
    voice "voice/romka/3day/61 v.ogg"
    Rom "Усё, валі давай."

# game/scripts/scene/scene_day_3.rpy:3061
translate belarusian day3_suefa_c8d6a577:

    # "Товарищи вышли из закутка."
    "Таварышы выйшлі з закутка."

# game/scripts/scene/scene_day_3.rpy:3063
translate belarusian day3_suefa_b24cf588:

    # "Лампочка озарила фотоаппарат в руке Ромки."
    "Лямпачка азарыла фотаапарат у руцэ Ромкі."

# game/scripts/scene/scene_day_3.rpy:3065
translate belarusian day3_suefa_d166b24f:

    # voice "voice/anton/3day/041 Og.ogg"
    # Ant "Ого! «Полароид»... Он твой?"
    voice "voice/anton/3day/041 Og.ogg"
    Ant "Ого! «Палароід»... Ён твой?"

# game/scripts/scene/scene_day_3.rpy:3067
translate belarusian day3_suefa_34608943:

    # "Ромка безразлично тряхнул чёрным чудом техники с раскладной вспышкой."
    "Ромка абыякава страсянуў чорны цуд тэхнікі з раскладной успышкай."

# game/scripts/scene/scene_day_3.rpy:3068
translate belarusian day3_suefa_5e69feea:

    # voice "voice/romka/3day/62 Te.ogg"
    # Rom "Терь мой."
    voice "voice/romka/3day/62 Te.ogg"
    Rom "Цяпер мой."

# game/scripts/scene/scene_day_3.rpy:3075
translate belarusian day3_suefa_be200e59:

    # voice "voice/romka/3day/63 M.ogg"
    # Rom "Мне тут один должник велик торчал за свой гнилой базар."
    voice "voice/romka/3day/63 M.ogg"
    Rom "Мне тут адзін даўжнік ровар торчаў за свой гнілы базар."

# game/scripts/scene/scene_day_3.rpy:3081
translate belarusian day3_suefa_43f667f5:

    # voice "voice/romka/3day/64 N.ogg"
    # Rom "Но, грит, нет у него велосипеда."
    voice "voice/romka/3day/64 N.ogg"
    Rom "Але, кажа, няма ў яго ровара."

# game/scripts/scene/scene_day_3.rpy:3087
translate belarusian day3_suefa_fb16fb04:

    # voice "voice/romka/3day/65 V.ogg"
    # Rom "Вот и расплатился фотиком."
    voice "voice/romka/3day/65 V.ogg"
    Rom "Вось і расплаціўся фоцікам."

# game/scripts/scene/scene_day_3.rpy:3093
translate belarusian day3_suefa_8d9fcbdf:

    # voice "voice/romka/3day/66 A.ogg"
    # Rom "А мне он, честно говоря, и в хер не впился."
    voice "voice/romka/3day/66 A.ogg"
    Rom "А мне ён, шчыра кажучы, і ў хер не ўпіўся."

# game/scripts/scene/scene_day_3.rpy:3119
translate belarusian day3_suefa_e4b62a14:

    # "Парня было жалко, но все плохие мысли растворялись при взгляде на желанную камеру."
    "Хлопца было шкада, але ўсе дрэнныя думкі раствараліся пры поглядзе на жаданую камеру."

# game/scripts/scene/scene_day_3.rpy:3123
translate belarusian day3_suefa_64ab74d7:

    # "Я живо представил, как понравился бы Оле «Полароид», как я фотографировал бы сестру, маму, отца."
    "Я жыва ўявіў, як спадабаўся б Олі «Палароід», як я фатаграфаваў бы сястру, маму, бацьку."

# game/scripts/scene/scene_day_3.rpy:3135
translate belarusian day3_suefa_edcea9c6:

    # "Образы неспешно проступают на твёрдой карточке, будто из тумана выплывают родные лица."
    "Вобразы няспешна праступаюць на цвёрдай картцы, быццам з туману выплываюць родныя твары."

# game/scripts/scene/scene_day_3.rpy:3136
translate belarusian day3_suefa_3b9f4bc6:

    # "И Полину тоже щёлкнул бы – тогда у меня была бы её фотография."
    "І Паліну таксама шчоўкнуў бы — тады ў мяне быў бы яе фотаздымак."

# game/scripts/scene/scene_day_3.rpy:3137
translate belarusian day3_suefa_dda74a63:

    # "Хранилась бы в ящике, под замком."
    "Захоўваўся б у шуфлядзе, пад замком."

# game/scripts/scene/scene_day_3.rpy:3139
translate belarusian day3_suefa_86d53139:

    # voice "voice/anton/3day/042.Ra.ogg"
    # Ant "Раз он тебе не нужен, можешь мне его отдать?"
    voice "voice/anton/3day/042.Ra.ogg"
    Ant "Раз ён табе не патрэбны, можаш мне яго аддаць?"

# game/scripts/scene/scene_day_3.rpy:3147
translate belarusian day3_suefa_7cb3488c:

    # "Рома смерил меня взглядом, и снова стал тем Ромкой, с которым я столкнулся вчера."
    "Рома змераў мяне позіркам і зноў стаў тым Ромкам, з якім я сутыкнуўся ўчора."

# game/scripts/scene/scene_day_3.rpy:3148
translate belarusian day3_suefa_22660c74:

    # "Коварным и насмешливым вожаком хищной стаи."
    "Падступным і насмешлівым важаком драпежнай зграі."

# game/scripts/scene/scene_day_3.rpy:3153
translate belarusian day3_suefa_ac090bcd:

    # voice "voice/romka/3day/67 T.ogg"
    # Rom "Ты извини, братан, но я вещами просто так не разбрасываюсь."
    voice "voice/romka/3day/67 T.ogg"
    Rom "Ты выбачай, братан, але я рэчамі проста так не раскідваюся."

# game/scripts/scene/scene_day_3.rpy:3159
translate belarusian day3_suefa_e9504dc6:

    # voice "voice/romka/3day/68 M.ogg"
    # Rom "Могу в ломбард загнать, ну или разыграть во что-нибудь."
    voice "voice/romka/3day/68 M.ogg"
    Rom "Магу ў ламбард загнаць, ну ці разыграць у што-небудзь."

# game/scripts/scene/scene_day_3.rpy:3164
translate belarusian day3_suefa_f11e9a56:

    # "Только он сказал об игре, как мне почему-то вспомнилась Алиса."
    "Толькі ён сказаў пра гульню, як мне чамусьці ўзгадалася Аліса."

# game/scripts/scene/scene_day_3.rpy:3166
translate belarusian day3_suefa_44e732fb:

    # "Я посмотрел на «Полароид»."
    "Я паглядзеў на «Палароід»."

# game/scripts/scene/scene_day_3.rpy:3167
translate belarusian day3_suefa_6673fbb1:

    # voice "voice/anton/3day/043 Nu.ogg"
    # Ant "Ну давай я с тобой на него сыграю. Только во что?"
    voice "voice/anton/3day/043 Nu.ogg"
    Ant "Ну давай я з табой на яго згуляю. Толькі ў што?"

# game/scripts/scene/scene_day_3.rpy:3170
translate belarusian day3_suefa_91096b51:

    # "Бяша прыснул в кулак."
    "Бяша пырснуў у кулак."

# game/scripts/scene/scene_day_3.rpy:3180
translate belarusian day3_suefa_9e094967:

    # voice "voice/byasha/3day/108 Che.ogg"
    # Bya "Чё, Ром, снимем с нашего Антошки последние штаны?"
    voice "voice/byasha/3day/108 Che.ogg"
    Bya "Што, Ром, здымем з нашага Антошкі апошнія штаны?"

# game/scripts/scene/scene_day_3.rpy:3189
translate belarusian day3_suefa_17db49a4:

    # voice "voice/romka/3day/69 Ya.ogg"
    # Rom "Я те чё, пидор, с пацанов штаны снимать?"
    voice "voice/romka/3day/69 Ya.ogg"
    Rom "Я табе што, підар, з пацаноў штаны здымаць?"

# game/scripts/scene/scene_day_3.rpy:3194
translate belarusian day3_suefa_efac7a8c:

    # "Рома посмотрел на меня сверху вниз."
    "Рома паглядзеў на мяне зверху ўніз."

# game/scripts/scene/scene_day_3.rpy:3199
translate belarusian day3_suefa_7ec7845d:

    # voice "voice/romka/3day/70 N.ogg"
    # Rom "На что играть собрался?"
    voice "voice/romka/3day/70 N.ogg"
    Rom "На што гуляць сабраўся?"

# game/scripts/scene/scene_day_3.rpy:3205
translate belarusian day3_suefa_abeb7886:

    # voice "voice/romka/3day/71 U.ogg"
    # Rom "У тебя хоть бабки есть?"
    voice "voice/romka/3day/71 U.ogg"
    Rom "У цябе хоць бабкі ёсць?"

# game/scripts/scene/scene_day_3.rpy:3216
translate belarusian day3_suefa_a4408478:

    # voice "voice/byasha/3day/110 Vo.ogg"
    # Bya "Во-во! Свети карманы, Тошик."
    voice "voice/byasha/3day/110 Vo.ogg"
    Bya "Во-во! Свяці кішэні, Тошык."

# game/scripts/scene/scene_day_3.rpy:3219
translate belarusian day3_suefa_817a3f63:

    # "Я медленно вывернул содержимое брюк в слабой надежде наскрести хотя бы какой-то мелочи на завтрак..."
    "Я павольна вывернуў змесціва штаноў у слабай надзеі наскрэбці хоць якой дробязі на сняданак..."

# game/scripts/scene/scene_day_3.rpy:3226
translate belarusian day3_suefa_6a6bf768:

    # "Посреди карманной пыли разместилась пара медяков в компании с пуговицей и наполовину стёртой резинкой."
    "Сярод кішэннага пылу размясцілася пара медзякоў у кампаніі з гузікам і напалову сцёртай гумкай."

# game/scripts/scene/scene_day_3.rpy:3227
translate belarusian day3_suefa_d211242b:

    # voice "voice/byasha/3day/112 Da.ogg"
    # Bya "Да ты ж на мели, на!"
    voice "voice/byasha/3day/112 Da.ogg"
    Bya "Ды ты ж на мялі, на!"

# game/scripts/scene/scene_day_3.rpy:3229
translate belarusian day3_suefa_557fc850:

    # voice "voice/romka/3day/72 P.ogg"
    # Rom "Прости, кент."
    voice "voice/romka/3day/72 P.ogg"
    Rom "Прабач, кент."

# game/scripts/scene/scene_day_3.rpy:3231
translate belarusian day3_suefa_89626e81:

    # voice "voice/romka/3day/73 N.ogg"
    # Rom "На такие несметные богатства я меняться не готов."
    voice "voice/romka/3day/73 N.ogg"
    Rom "На такія незлічоныя багацці я мяняцца не гатовы."

# game/scripts/scene/scene_day_3.rpy:3236
translate belarusian day3_suefa_b1ff7556:

    # voice "voice/romka/3day/74 A.ogg"
    # Rom "А на интерес с тобой играть мы не будем."
    voice "voice/romka/3day/74 A.ogg"
    Rom "А на цікавасць з табой гуляць мы не будзем."

# game/scripts/scene/scene_day_3.rpy:3248
translate belarusian day3_suefa_20e496ab:

    # voice "voice/romka/3day/75 D.ogg"
    # Rom "Давай-ка в следующий раз."
    voice "voice/romka/3day/75 D.ogg"
    Rom "Давай-ка ў наступны раз."

# game/scripts/scene/scene_day_3.rpy:3250
translate belarusian day3_suefa_f5663c64:

    # "Ромка надел «Полароид» себе на шею, а затем подмигнул нам с Бяшей."
    "Ромка надзеў «Палароід» сабе на шыю, а пасля падміргнуў нам з Бяшам."

# game/scripts/scene/scene_day_3.rpy:3251
translate belarusian day3_suefa_945b599e:

    # voice "voice/romka/3day/76 N.ogg"
    # Rom "Ну чё, пацаны, пойдём тёлок снимать?"
    voice "voice/romka/3day/76 N.ogg"
    Rom "Ну што, пацаны, пойдзем цёлак здымаць?"

# game/scripts/scene/scene_day_3.rpy:3258
translate belarusian day3_suefa_1d639e26:

    # "В кармане что-то зашуршало."
    "У кішэні нешта зашамацела."

# game/scripts/scene/scene_day_3.rpy:3285
translate belarusian day3_suefa_cc6994e4:

    # "Я выудил из штанов тот самый вкладыш с мерседесом, что получил благодаря Алисе."
    "Я выцягнуў са штаноў той самы ўкладыш з мерсэдэсам, што атрымаў дзякуючы Алісе."

# game/scripts/scene/scene_day_3.rpy:3286
translate belarusian day3_suefa_ee235025:

    # "Видимо я машинально сунул его туда, когда он вылетел из рюкзака со всеми тетрадями."
    "Відаць, я машынальна сунуў яго туды, калі ён вылецеў з заплечніка з усімі сшыткамі."

# game/scripts/scene/scene_day_3.rpy:3287
translate belarusian day3_suefa_607bde9e:

    # voice "voice/anton/3day/044.Ana.ogg"
    # Ant "А на вкладыши играете?"
    voice "voice/anton/3day/044.Ana.ogg"
    Ant "А на ўкладышы гуляеце?"

# game/scripts/scene/scene_day_3.rpy:3289
translate belarusian day3_suefa_73207e60:

    # "У Бяши округлились глаза, стоило поднести картинку с машиной поближе, а вот Ромка даже бровью не повёл."
    "У Бяшы акругліліся вочы, варта было паднесці карцінку з машынай бліжэй, а вось Ромка нават брывом не павёў."

# game/scripts/scene/scene_day_3.rpy:3290
translate belarusian day3_suefa_74689fc0:

    # voice "voice/romka/3day/77 H.ogg"
    # Rom "Хочешь, чтобы я целый фотик за какой-то там фантик отдал?"
    voice "voice/romka/3day/77 H.ogg"
    Rom "Хочаш, каб я цэлы фоцік за нейкі там фанцік аддаў?"

# game/scripts/scene/scene_day_3.rpy:3293
translate belarusian day3_suefa_557044c2:

    # voice "voice/byasha/3day/114 E.ogg"
    # Bya "Это же..."
    voice "voice/byasha/3day/114 E.ogg"
    Bya "Гэта ж..."

# game/scripts/scene/scene_day_3.rpy:3304
translate belarusian day3_suefa_3e513a93:

    # voice "voice/romka/3day/78 Da.ogg"
    # Rom "Да жвачке этой рубль цена, а в «Полароиде» кассета ещё целая."
    voice "voice/romka/3day/78 Da.ogg"
    Rom "Ды жуйцы гэтай рубель цана, а ў «Палароідзе» касета яшчэ цэлая."

# game/scripts/scene/scene_day_3.rpy:3317
translate belarusian day3_suefa_8d0b4c73:

    # voice "voice/byasha/3day/114 Et.ogg"
    # Bya "Да это же..."
    voice "voice/byasha/3day/114 Et.ogg"
    Bya "Ды гэта ж..."

# game/scripts/scene/scene_day_3.rpy:3322
translate belarusian day3_suefa_fe8cf318:

    # voice "voice/romka/3day/79 O.ogg"
    # Rom "Ой, у меня таких вкладышей жопой жуй. На кой мне ещё..."
    voice "voice/romka/3day/79 O.ogg"
    Rom "Ой, у мяне такіх укладышаў жопай жуй. На хер мне яшчэ..."

# game/scripts/scene/scene_day_3.rpy:3328
translate belarusian day3_suefa_c9e08283:

    # voice "voice/byasha/3day/115 M.ogg"
    # Bya "Мерседес-Бенц, на! Его-то нам и не хватало, Ромыч!"
    voice "voice/byasha/3day/115 M.ogg"
    Bya "Мэрсэдэс-Бэнц, на! Яго нам і не хапала, Ромыч!"

# game/scripts/scene/scene_day_3.rpy:3358
translate belarusian day3_suefa_e8e9ee53:

    # "Ромка сплюнул под ноги и отвесил Бяше подзатыльник."
    "Ромка сплюнуў пад ногі і адвесіў Бяшу патылічнік."

# game/scripts/scene/scene_day_3.rpy:3362
translate belarusian day3_suefa_018262af:

    # voice "voice/romka/3day/81 Nu.ogg"
    # Rom "Ну ты и трепло, братка. Теперь он за него цену до небес взвинтит."
    voice "voice/romka/3day/81 Nu.ogg"
    Rom "Ну ты і трапло, братка. Цяпер ён за яго цану да нябёсаў узвінціць."

# game/scripts/scene/scene_day_3.rpy:3371
translate belarusian day3_suefa_fabbf30f:

    # "Как я и подозревал, такой автомобиль был ценным пополнением любого коллекционера жвачки Turbo."
    "Як я і падазраваў, такі аўтамабіль быў каштоўным папаўненнем для любога калекцыянера жуйкі Turbo."

# game/scripts/scene/scene_day_3.rpy:3372
translate belarusian day3_suefa_a2b6896d:

    # voice "voice/anton/3day/045.Aga.ogg"
    # Ant "Ага, значит, появился интерес?"
    voice "voice/anton/3day/045.Aga.ogg"
    Ant "Ага, значыць, з'явілася цікавасць?"

# game/scripts/scene/scene_day_3.rpy:3374
translate belarusian day3_suefa_ad6a8b7c:

    # voice "voice/anton/3day/046.Ta.ogg"
    # Ant "Так во что будем играть?"
    voice "voice/anton/3day/046.Ta.ogg"
    Ant "Дык у што будзем гуляць?"

# game/scripts/scene/scene_day_3.rpy:3381
translate belarusian day3_suefa_4f7c7f5e:

    # voice "voice/byasha/3day/117 V.ogg"
    # Bya "В подкидного?"
    voice "voice/byasha/3day/117 V.ogg"
    Bya "У падкіднога?"

# game/scripts/scene/scene_day_3.rpy:3392
translate belarusian day3_suefa_28a56e2e:

    # voice "voice/romka/3day/82 V.ogg"
    # Rom "В ножички?"
    voice "voice/romka/3day/82 V.ogg"
    Rom "У ножычкі?"

# game/scripts/scene/scene_day_3.rpy:3398
translate belarusian day3_suefa_67b16daf:

    # "Я не заметил, как в руках Бяши появилась засаленная и наверняка краплёная колода карт, а Ромка прямо перед носом мастерски крутанул бабочкой."
    "Я не заўважыў, як у руках Бяшы з'явілася зашмальцаваная і напэўна краплёная калода карт, а Ромка проста перад носам па-майстэрску крутнуў матыльком."

# game/scripts/scene/scene_day_3.rpy:3399
translate belarusian day3_suefa_f907da74:

    # "Играть по их правилам совершенно не хотелось."
    "Гуляць па іх правілах зусім не хацелася."

# game/scripts/scene/scene_day_3.rpy:3400
translate belarusian day3_suefa_886f3e16:

    # voice "voice/anton/3day/047 A.ogg"
    # Ant "А давайте в «камень-ножницы»."
    voice "voice/anton/3day/047 A.ogg"
    Ant "А давайце ў «камень-нажніцы»."

# game/scripts/scene/scene_day_3.rpy:3406
translate belarusian day3_suefa_2f153c75:

    # voice "voice/romka/3day/83 O.ogg"
    # Rom "Ого, а ты у нас любишь рисковать."
    voice "voice/romka/3day/83 O.ogg"
    Rom "Ого, а ты ў нас любіш рызыкаваць."

# game/scripts/scene/scene_day_3.rpy:3408
translate belarusian day3_suefa_82011ae4:

    # voice "voice/romka/3day/84 Nu.ogg"
    # Rom "Ну что, мой «Полароид» против твоего мерса?"
    voice "voice/romka/3day/84 Nu.ogg"
    Rom "Ну што, мой «Палароід» супраць твайго мэрса?"

# game/scripts/scene/scene_day_3.rpy:3419
translate belarusian day3_suefa_8a9adf4a:

    # voice "voice/anton/3day/048 Po.ogg"
    # Ant "По рукам."
    voice "voice/anton/3day/048 Po.ogg"
    Ant "Па руках."

# game/scripts/scene/scene_day_3.rpy:3458
translate belarusian suefa_lose_0230524e:

    # "Бяша, ликуя, захлопал в ладоши так, что идущие по коридору дети покосились на нас."
    "Бяша, радуючыся, запляскаў у ладкі так, што дзеці, якія ішлі па калідоры, скасіліся на нас."

# game/scripts/scene/scene_day_3.rpy:3459
translate belarusian suefa_lose_3991f3ec:

    # "Я был полностью разгромлен."
    "Я быў цалкам разгромлены."

# game/scripts/scene/scene_day_3.rpy:3467
translate belarusian suefa_lose_48398744:

    # voice "voice/byasha/3day/122 F.ogg"
    # Bya "Фени коля комедия, Тошик! Гони мерс, на."
    voice "voice/byasha/3day/122 F.ogg"
    Bya "Фені коля камедыя, Тошык! Гані мэрс, на."

# game/scripts/scene/scene_day_3.rpy:3473
translate belarusian suefa_lose_5f1fe322:

    # "Через руки Бяши к Ромке перекочевало моё единственное подтверждение, что Алиса существует."
    "Праз рукі Бяшы да Ромкі перакачавала маё адзінае пацверджанне таго, што Аліса існуе."

# game/scripts/scene/scene_day_3.rpy:3484
translate belarusian suefa_lose_7cc1fedd:

    # voice "voice/romka/3day/92 A.ogg"
    # Rom "Хе-хе! А вот и вишенка моей коллекции подоспела."
    voice "voice/romka/3day/92 A.ogg"
    Rom "Хе-хе! А вось і вішанька маёй калекцыі падаспела."

# game/scripts/scene/scene_day_3.rpy:3487
translate belarusian suefa_lose_0d8724a3:

    # voice "voice/romka/3day/93 S.ogg"
    # Rom "Спасибо, Антош, было приятно иметь с тобой дело."
    voice "voice/romka/3day/93 S.ogg"
    Rom "Дзякуй, Антош, было прыемна мець з табой справу."

# game/scripts/scene/scene_day_3.rpy:3532
translate belarusian suefa_win_86b2dc1c:

    # voice "voice/anton/3day/052.Viig.ogg"
    # Ant "Ну, я выиграл? Или теперь мне нужно ещё и Бяшу обыграть?"
    voice "voice/anton/3day/052.Viig.ogg"
    Ant "Ну, я выйграў? Ці цяпер мне трэба яшчэ і Бяшу абыграць?"

# game/scripts/scene/scene_day_3.rpy:3535
translate belarusian suefa_win_d8c8306c:

    # "Ромка что-то буркнул под нос."
    "Ромка нешта буркнуў пад нос."

# game/scripts/scene/scene_day_3.rpy:3536
translate belarusian suefa_win_431d77ac:

    # "Мне показалось, что он откажется выполнять условие и пошлёт меня куда подальше."
    "Мне падалося, што ён адмовіцца выконваць умову і пашле мяне куды падалей."

# game/scripts/scene/scene_day_3.rpy:3540
translate belarusian suefa_win_63e5857b:

    # voice "voice/byasha/3day/124 E.ogg"
    # Bya "Эй, Ромыч, всё по чесноку, на."
    voice "voice/byasha/3day/124 E.ogg"
    Bya "Эй, Ромыч, усё па часноку, на."

# game/scripts/scene/scene_day_3.rpy:3547
translate belarusian suefa_win_7470762a:

    # "Ромка неохотно сдался."
    "Ромка неахвотна здаўся."

# game/scripts/scene/scene_day_3.rpy:3552
translate belarusian suefa_win_1e4a7fb5:

    # voice "voice/romka/3day/95 V.ogg"
    # Rom "Везучий ты, сука. Держи!"
    voice "voice/romka/3day/95 V.ogg"
    Rom "Шчасліўчык ты, сука. Трымай!"

# game/scripts/scene/scene_day_3.rpy:3557
translate belarusian suefa_win_8280cfd7:

    # voice "voice/romka/3day/96 T.ogg"
    # Rom "Только писюн свой не фоткай."
    voice "voice/romka/3day/96 T.ogg"
    Rom "Толькі пісюн свой не фоткай."

# game/scripts/scene/scene_day_3.rpy:3565
translate belarusian suefa_win_fe73ea8e:

    # "Я взвесил на ладони «Полароид» и понял, что усмехаюсь, как настоящий победитель."
    "Я ўзважыў на далоні «Палароід» і зразумеў, што ўсміхаюся, як сапраўдны пераможца."

# game/scripts/scene/scene_day_3.rpy:3594
translate belarusian dev_day3_week_end_89cbaa24:

    # "Семь дней миновало с того дня, как лейтенант навещал класс."
    "Сем дзён мінула з таго дня, як лейтэнант наведваў клас."

# game/scripts/scene/scene_day_3.rpy:3595
translate belarusian dev_day3_week_end_2e1f9a27:

    # "На первый взгляд, всё осталось так же."
    "На першы погляд, усё засталося так жа."

# game/scripts/scene/scene_day_3.rpy:3600
translate belarusian dev_day3_week_end_ae8b5578:

    # "Лес по-прежнему протягивал к посёлку свои крючковатые лапы, а ветер ночами взметал белые флаги пороши."
    "Лес па-ранейшаму працягваў да пасёлка свае кручкаватыя лапы, а вецер начамі ўзмятаў белыя сцягі парошы."

# game/scripts/scene/scene_day_3.rpy:3601
translate belarusian dev_day3_week_end_085bf04c:

    # "Родители приглушённо спорили в спальне, а я включал мультики погромче и подсаживался к Оле."
    "Бацькі прыглушана спрачаліся ў спальні, а я ўключаў мульцікі грамчэй і падсаджваўся да Олі."

# game/scripts/scene/scene_day_3.rpy:3605
translate belarusian dev_day3_week_end_81f07fa2:

    # "Фотографии Вовы и Семёна чернели на доске. Да и круглолицая Сенечка не вернулась домой."
    "Фотаздымкі Вовы і Сямёна чарнелі на дошцы. Ды і круглатварая Сенечка не вярнулася дадому."

# game/scripts/scene/scene_day_3.rpy:3607
translate belarusian dev_day3_week_end_a63d26aa:

    # "Фотографии Вовы и Семёна чернели на доске."
    "Фотаздымкі Вовы і Сямёна чарнелі на дошцы."

# game/scripts/scene/scene_day_3.rpy:3608
translate belarusian dev_day3_week_end_24353978:

    # "Но что-то всё же поменялось. На лицах одноклассников читались перемены."
    "Але нешта ўсё ж памянялася. На тварах аднакласнікаў чыталіся змены."

# game/scripts/scene/scene_day_3.rpy:3611
translate belarusian dev_day3_week_end_5f08d5cd:

    # "Они встретили меня новыми порциями тычков и оскорблений. Презрение, издёвки и одиночество стали моими постоянными спутниками."
    "Яны сустрэлі мяне новымі порцыямі штуршкоў і абраз. Пагарда, здзекі і адзінота сталі маімі пастаяннымі спадарожнікамі."

# game/scripts/scene/scene_day_3.rpy:3615
translate belarusian dev_day3_week_end_ba89e478:

    # "Они оттягивали карман подаренным яблоком. Испарилась враждебность. Школа больше не пугала меня."
    "Яны адцягвалі кішэню падораным яблыкам. Выпарылася варожасць. Школа больш не палохала мяне."

# game/scripts/scene/scene_day_3.rpy:3617
translate belarusian dev_day3_week_end_1a2ca336:

    # "А главное..."
    "А галоўнае..."

# game/scripts/scene/scene_day_3.rpy:3620
translate belarusian dev_day3_week_end_c714843c:

    # "Чья-то тень проскользнула по столу, оставив таинственную записку."
    "Чыясьці цень праслізнула па стале, пакінуўшы таямнічую запіску."

# game/scripts/scene/scene_day_3.rpy:3623
translate belarusian dev_day3_week_end_e4be60dd:

    # "Я бросил взгляд в проём между партами, но посыльного и след простыл."
    "Я кінуў позірк у праём паміж партамі, але пасланца і след прастыў."

# game/scripts/scene/scene_day_3.rpy:3627
translate belarusian dev_day3_week_end_19eabedc:

    # "От кого эта записка? Что мог скрывать в себе этот аккуратно вырванный и сложенный листок?"
    "Ад каго гэтая запіска? Што мог хаваць у сабе гэты акуратна вырваны і складзены лісток?"

# game/scripts/scene/scene_day_3.rpy:3628
translate belarusian dev_day3_week_end_03f29a04:

    # "Очередные угрозы и унижения, или всё-таки..."
    "Чарговыя пагрозы і прыніжэнні, ці ўсё ж такі..."

# game/scripts/scene/scene_day_3.rpy:3631
translate belarusian dev_day3_week_end_9ebcb98a:

    # "Я взял листочек и осторожно вдохнул льющийся аромат."
    "Я ўзяў лісточак і асцярожна ўдыхнуў ліючыся водар."

# game/scripts/scene/scene_day_3.rpy:3650
translate belarusian dev_day3_week_end_42387107:

    # "Ежевика."
    "Ажына."

# game/scripts/scene/scene_day_3.rpy:3651
translate belarusian dev_day3_week_end_039a9db6:

    # "Внутри красивым почерком было выведено: «Жду тебя в тупичке у раздевалки. Приходи один»."
    "Унутры прыгожым почыркам было выведзена: «Чакаю цябе ў тупічку каля распранальні. Прыходзь адзін»."

# game/scripts/scene/scene_day_3.rpy:3668
translate belarusian dev_day3_week_end_70a53e56:

    # "Опьянённый призывом, я тут же сорвался с места, то и дело оглядываясь, не увязался ли кто за мной."
    "Ап'янены заклікам, я адразу ж сарваўся з месца, раз-пораз азіраючыся, ці не ўвязаўся хто за мной."

# game/scripts/scene/scene_day_3.rpy:3671
translate belarusian dev_day3_week_end_2aba4024:

    # "Мысль, что это была очередная ловушка, подстроенная Ромкой и Бяшей, хоть и зудила в моём возбужденном сознании, всё же быстро оставила в покое."
    "Думка, што гэта была чарговая пастка, падстроеная Ромкам і Бяшам, хоць і свярбела ў маёй узбуджанай свядомасці, усё ж хутка пакінула ў спакоі."

# game/scripts/scene/scene_day_3.rpy:3672
translate belarusian dev_day3_week_end_76e73391:

    # "Им бы не хватило смекалки так мастерски подделать записку Полины."
    "Ім бы не хапіла кемлівасці так па-майстэрску падрабіць запіску Паліны."

# game/scripts/scene/scene_day_3.rpy:3673
translate belarusian dev_day3_week_end_35c603f1:

    # "Задумавшись, я не заметил, что уже почти бегу, заскакивая за поворот."
    "Задумаўшыся, я не заўважыў, што ўжо амаль бягу, заскокваючы за паварот."

# game/scripts/scene/scene_day_3.rpy:3684
translate belarusian dev_day3_week_end_f3545699:

    # "И тут же наткнулся на кого-то в тёмном закутке."
    "І адразу ж натыкнуўся на некага ў цёмным закутку."

# game/scripts/scene/scene_day_3.rpy:3693
translate belarusian dev_day3_week_end_b8262865:

    # voice "voice/Polina/3day/01 O.ogg"
    # Pol "Ой!"
    voice "voice/Polina/3day/01 O.ogg"
    Pol "Ой!"

# game/scripts/scene/scene_day_3.rpy:3700
translate belarusian dev_day3_week_end_e4e95e7a:

    # "Как диковинная птица, полетела к моим ногам зелёная тетрадка."
    "Як дзіўная птушка, паляцеў да маіх ног зялёны сшытак."

# game/scripts/scene/scene_day_3.rpy:3701
translate belarusian dev_day3_week_end_c1e50c61:

    # "Полина преувеличенно возмутилась."
    "Паліна перабольшана абурылася."

# game/scripts/scene/scene_day_3.rpy:3704
translate belarusian dev_day3_week_end_18d4d800:

    # voice "voice/Polina/3day/02 P.ogg"
    # Pol "Петров, да ты совсем зрение потерял!"
    voice "voice/Polina/3day/02 P.ogg"
    Pol "Пятроў, ды ты зусім зрок страціў!"

# game/scripts/scene/scene_day_3.rpy:3706
translate belarusian dev_day3_week_end_20c5893d:

    # "Я поправил очки – собственная близорукость словно бы перестала смущать."
    "Я паправіў акуляры — уласная блізарукасць быццам бы перастала бянтэжыць."

# game/scripts/scene/scene_day_3.rpy:3711
translate belarusian dev_day3_week_end_cef9b154:

    # "Наклонился и подобрал тетрадку."
    "Нахіліўся і падняў сшытак."

# game/scripts/scene/scene_day_3.rpy:3720
translate belarusian dev_day3_week_end_a4a5c4ad:

    # voice "voice/anton/3day/054 Pr.ogg"
    # Ant "Прости, я так торопился. Ты меня ждала? Что случилось?"
    voice "voice/anton/3day/054 Pr.ogg"
    Ant "Прабач, я так спяшаўся. Ты мяне чакала? Што здарылася?"

# game/scripts/scene/scene_day_3.rpy:3737
translate belarusian day3_amulet_before_668394f4:

    # "Полина сменила наигранный гнев на милость, замялась, явно подбирая правильные слова."
    "Паліна змяніла наіграны гнеў на міласць, замялася, відавочна падбіраючы правільныя словы."

# game/scripts/scene/scene_day_3.rpy:3741
translate belarusian day3_amulet_before_d44fed01:

    # "При этом смотрела на меня так взволнованно и грустно, словно надеялась, что я продолжу разговор, не дав нам окончательно увязнуть в неловкой тишине."
    "Пры гэтым глядзела на мяне так усхвалявана і сумна, быццам спадзявалася, што я працягну размову, не даўшы нам канчаткова загразнуць у няёмкай цішыні."

# game/scripts/scene/scene_day_3.rpy:3745
translate belarusian day3_amulet_before_227a95fa:

    # "Но я хранил молчание, всматриваясь в её дрожащие губы."
    "Але я маўчаў, углядаючыся ў яе дрыготкія вусны."

# game/scripts/scene/scene_day_3.rpy:3747
translate belarusian day3_amulet_before_7d58b206:

    # "Наконец Полина глубоко вздохнула и, несколько робея, заговорила:"
    "Нарэшце Паліна глыбока ўздыхнула і, крыху саромеючыся, загаварыла:"

# game/scripts/scene/scene_day_3.rpy:3754
translate belarusian day3_amulet_before_df254e32:

    # voice "voice/Polina/3day/04 A.ogg"
    # Pol "Антон, скажи, ты на меня сильно злишься?"
    voice "voice/Polina/3day/04 A.ogg"
    Pol "Антон, скажы, ты на мяне моцна злуешся?"

# game/scripts/scene/scene_day_3.rpy:3759
translate belarusian day3_amulet_before_ded77cee:

    # "Она не дала мне ответить."
    "Яна не дала мне адказаць."

# game/scripts/scene/scene_day_3.rpy:3762
translate belarusian day3_amulet_before_fd37eb8b:

    # voice "voice/Polina/3day/05 Oh.ogg"
    # Pol "Ох, ну конечно сильно. Что за дурацкий вопрос такой?"
    voice "voice/Polina/3day/05 Oh.ogg"
    Pol "Ох, ну вядома моцна. Што за дурное пытанне такое?"

# game/scripts/scene/scene_day_3.rpy:3766
translate belarusian day3_amulet_before_208b1059:

    # voice "voice/Polina/3day/06 P.ogg"
    # Pol "Прости, пожалуйста, я не хотела, чтобы так вышло, честно!"
    voice "voice/Polina/3day/06 P.ogg"
    Pol "Прабач, калі ласка, я не хацела, каб так выйшла, шчыра!"

# game/scripts/scene/scene_day_3.rpy:3770
translate belarusian day3_amulet_before_e5291523:

    # voice "voice/Polina/3day/07 Ko.ogg"
    # Pol "Когда Пятифанов… Этот изверг пнул ту собачку…"
    voice "voice/Polina/3day/07 Ko.ogg"
    Pol "Калі Пяціфанаў... Гэты вырадак штурхануў таго сабачку..."

# game/scripts/scene/scene_day_3.rpy:3775
translate belarusian day3_amulet_before_4625a7df:

    # voice "voice/Polina/3day/08 Et.ogg"
    # Pol "Это словно и не я была, понимаешь?"
    voice "voice/Polina/3day/08 Et.ogg"
    Pol "Гэта быццам і не я была, разумееш?"

# game/scripts/scene/scene_day_3.rpy:3780
translate belarusian day3_amulet_before_1d4e870a:

    # "Она тихонько шмыгнула носом, и даже в полумраке я заметил, как заблестели её глаза цвета океана."
    "Яна ціхенька шмыгнула носам, і нават у паўзмроку я заўважыў, як заблішчалі яе вочы колеру акіяна."

# game/scripts/scene/scene_day_3.rpy:3783
translate belarusian day3_amulet_before_c656cd09:

    # voice "voice/Polina/3day/09 Da.ogg"
    # Pol "Да, так нельзя…"
    voice "voice/Polina/3day/09 Da.ogg"
    Pol "Так, гэтак нельга..."

# game/scripts/scene/scene_day_3.rpy:3787
translate belarusian day3_amulet_before_0383dcbe:

    # voice "voice/Polina/3day/10 Ne.ogg"
    # Pol "Нельзя смеяться над тем, как издеваются над животными."
    voice "voice/Polina/3day/10 Ne.ogg"
    Pol "Нельга смяяцца з таго, як здзекуюцца з жывёл."

# game/scripts/scene/scene_day_3.rpy:3791
translate belarusian day3_amulet_before_b6288ad5:

    # voice "voice/Polina/3day/11 Nez.ogg"
    # Pol "Не знаю даже, что ты обо мне подумал…"
    voice "voice/Polina/3day/11 Nez.ogg"
    Pol "Не ведаю нават, што ты пра мяне падумаў..."

# game/scripts/scene/scene_day_3.rpy:3795
translate belarusian day3_amulet_before_6d16e30a:

    # voice "voice/Polina/3day/12 No.ogg"
    # Pol "Но я ничего не могу с собой поделать, Антон."
    voice "voice/Polina/3day/12 No.ogg"
    Pol "Але я нічога не магу з сабой зрабіць, Антон."

# game/scripts/scene/scene_day_3.rpy:3820
translate belarusian day3_amulet_before_a1e585d5:

    # voice "voice/Polina/3day/13 S.ogg"
    # Pol "Стоит мне подумать о дедушке, что он пережил в тот день, когда на него напала эта стая бродячих псов, как…"
    voice "voice/Polina/3day/13 S.ogg"
    Pol "Варта мне падумаць пра дзядулю, што ён перажыў у той дзень, калі на яго напала тая зграя валацужных псоў, як..."

# game/scripts/scene/scene_day_3.rpy:3823
translate belarusian day3_amulet_before_38426ae2:

    # voice "voice/Polina/3day/14 K.ogg"
    # Pol "... как мой разум словно затуманивается."
    voice "voice/Polina/3day/14 K.ogg"
    Pol "... як мой розум быццам затуманьваецца."

# game/scripts/scene/scene_day_3.rpy:3836
translate belarusian day3_amulet_before_fc14c203:

    # "Полинина тетрадка в моей руке всё ещё ждала, чтобы вернуться к хозяйке, но я никак не мог найти подходящего момента."
    "Палінін сшытак у маёй руцэ ўсё яшчэ чакаў, каб вярнуцца да гаспадыні, але я ніяк не мог знайсці падыходнага моманту."

# game/scripts/scene/scene_day_3.rpy:3839
translate belarusian day3_amulet_before_de05be8b:

    # voice "voice/Polina/3day/15 T.ogg"
    # Pol "Ты, наверное, считаешь, что я чокнутая, да?"
    voice "voice/Polina/3day/15 T.ogg"
    Pol "Ты, напэўна, лічыш, што я чокнутая, так?"

# game/scripts/scene/scene_day_3.rpy:3845
translate belarusian day3_amulet_before_ec6ee115:

    # "Она смотрела на меня с надеждой, пока я в смятении перебирал в голове все те безумства, что выкидывало моё подсознание в последнее время раз за разом."
    "Яна глядзела на мяне з надзеяй, пакуль я ў разгубленасці перабіраў у галаве ўсе тыя вар'яцтвы, што выкідвала мая падсвядомасць у апошні час раз за разам."

# game/scripts/scene/scene_day_3.rpy:3846
translate belarusian day3_amulet_before_8830703e:

    # "Я был точно не тем человеком, кто мог судить о нормальности."
    "Я быў дакладна не тым чалавекам, хто мог судзіць пра нармальнасць."

# game/scripts/scene/scene_day_3.rpy:3849
translate belarusian day3_amulet_before_b3458b4b:

    # voice "voice/Polina/3day/16 M.ogg"
    # Pol "Мне не всегда удаётся себя контролировать."
    voice "voice/Polina/3day/16 M.ogg"
    Pol "Мне не заўсёды ўдаецца сябе кантраляваць."

# game/scripts/scene/scene_day_3.rpy:3853
translate belarusian day3_amulet_before_09e563da:

    # voice "voice/Polina/3day/17 No.ogg"
    # Pol "Но я точно не причинила бы кому-то вреда, слышишь?!"
    voice "voice/Polina/3day/17 No.ogg"
    Pol "Але я дакладна не прычыніла б камусьці шкоды, чуеш?!"

# game/scripts/scene/scene_day_3.rpy:3857
translate belarusian day3_amulet_before_32ec3fae:

    # voice "voice/Polina/3day/18 N.ogg"
    # Pol "Не то, что этот садист Ромка."
    voice "voice/Polina/3day/18 N.ogg"
    Pol "Не тое, што гэты садыст Ромка."

# game/scripts/scene/scene_day_3.rpy:3861
translate belarusian day3_amulet_before_a652539f:

    # voice "voice/Polina/3day/19 A.ogg"
    # Pol "Антон, прошу, держись от него подальше!"
    voice "voice/Polina/3day/19 A.ogg"
    Pol "Антон, прашу, трымайся ад яго далей!"

# game/scripts/scene/scene_day_3.rpy:3865
translate belarusian day3_amulet_before_f6178b49:

    # "В голове будто щёлкнуло. Я недоверчиво покосился на Полину."
    "У галаве быццам шчоўкнула. Я недаверліва скасіўся на Паліну."

# game/scripts/scene/scene_day_3.rpy:3867
translate belarusian day3_amulet_before_4fcf92dc:

    # voice "voice/anton/3day/58 V.ogg"
    # Ant "Неделю назад во время драки ты называла его по-другому."
    voice "voice/anton/3day/58 V.ogg"
    Ant "Тыдзень таму падчас бойкі ты называла яго інакш."

# game/scripts/scene/scene_day_3.rpy:3869
translate belarusian day3_amulet_before_5fb18fdf:

    # voice "voice/anton/3day/58 R.ogg"
    # Ant "Ромочкой."
    voice "voice/anton/3day/58 R.ogg"
    Ant "Ромачкам."

# game/scripts/scene/scene_day_3.rpy:3871
translate belarusian day3_amulet_before_932cddcc:

    # voice "voice/anton/3day/59 Sk.ogg"
    # Ant "Скажи, вы что, встречаетесь?"
    voice "voice/anton/3day/59 Sk.ogg"
    Ant "Скажы, вы што, сустракаецеся?"

# game/scripts/scene/scene_day_3.rpy:3877
translate belarusian day3_amulet_before_478e3b4e:

    # "Полину словно током ударило."
    "Паліну быццам токам ударыла."

# game/scripts/scene/scene_day_3.rpy:3880
translate belarusian day3_amulet_before_6b7eb97e:

    # voice "voice/Polina/3day/20 E.ogg"
    # Pol "Ещё чего! Этот урод ко мне приклеился как банный лист."
    voice "voice/Polina/3day/20 E.ogg"
    Pol "Яшчэ чаго! Гэты вырадак да мяне прыляпіўся як банны ліст."

# game/scripts/scene/scene_day_3.rpy:3884
translate belarusian day3_amulet_before_7b54b872:

    # voice "voice/Polina/3day/22 T.ogg"
    # Pol "Такие, как он, не то что намёков, грубых слов не понимают."
    voice "voice/Polina/3day/22 T.ogg"
    Pol "Такія, як ён, не тое што намёкаў, грубых слоў не разумеюць."

# game/scripts/scene/scene_day_3.rpy:3889
translate belarusian day3_amulet_before_c13b528d:

    # "Она несколько смягчилась, разглядывая ссадины на моём лице."
    "Яна крыху змякчылася, разглядаючы ранкі на маім твары."

# game/scripts/scene/scene_day_3.rpy:3892
translate belarusian day3_amulet_before_f20eaa60:

    # voice "voice/Polina/3day/23 P.ogg"
    # Pol "Прости ещё раз, что так вышло."
    voice "voice/Polina/3day/23 P.ogg"
    Pol "Прабач яшчэ раз, што так выйшла."

# game/scripts/scene/scene_day_3.rpy:3896
translate belarusian day3_amulet_before_5fbb6f33:

    # voice "voice/Polina/3day/24 Ya.ogg"
    # Pol "Я… Ну, я правда надеялась, что смогу помочь тебе."
    voice "voice/Polina/3day/24 Ya.ogg"
    Pol "Я... Ну, я сапраўды спадзявалася, што змагу дапамагчы табе."

# game/scripts/scene/scene_day_3.rpy:3901
translate belarusian day3_amulet_before_de9c531f:

    # voice "voice/Polina/3day/25 Z.ogg"
    # Pol "Зря я поверила, что у таких подонков может быть какой-то там кодекс чести."
    voice "voice/Polina/3day/25 Z.ogg"
    Pol "Дарма я паверыла, што ў такіх падонкаў можа быць нейкі там кодэкс гонару."

# game/scripts/scene/scene_day_3.rpy:3905
translate belarusian day3_amulet_before_7fde70d5:

    # voice "voice/Polina/3day/26 V.ogg"
    # Pol "Вот, у меня есть для тебя подарок."
    voice "voice/Polina/3day/26 V.ogg"
    Pol "Вось, у мяне ёсць для цябе падарунак."

# game/scripts/scene/scene_day_3.rpy:3913
translate belarusian day3_amulet_before_1904fa4b:

    # "Неожиданно она расстегнула верхнюю пуговицу жилетки и тут же засмущалась, заметив мой ошеломлённый взгляд."
    "Нечакана яна расшпіліла верхні гузік камізэлькі і тут жа засаромелася, заўважыўшы мой ашаломлены позірк."

# game/scripts/scene/scene_day_3.rpy:3927
translate belarusian day3_amulet_before_aa0fdb1d:

    # "Затем сняла с шеи амулет на прочном кожаном шнурке, с примотанным к нему крупным звериным когтем, и протянула мне."
    "Пасля зняла з шыі амулет на трывалым скураным шнурку, з прыматаным да яго буйным звярыным кіпцюром, і працягнула мне."

# game/scripts/scene/scene_day_3.rpy:3930
translate belarusian day3_amulet_before_09760c86:

    # voice "voice/Polina/3day/28 E.ogg"
    # Pol "Этот оберег подарил мне дедушка."
    voice "voice/Polina/3day/28 E.ogg"
    Pol "Гэты абярэг падарыў мне дзядуля."

# game/scripts/scene/scene_day_3.rpy:3934
translate belarusian day3_amulet_before_c8127670:

    # voice "voice/Polina/3day/29 G.ogg"
    # Pol "Говорит, он помогает от всяких бесноватых и одержимых."
    voice "voice/Polina/3day/29 G.ogg"
    Pol "Кажа, ён дапамагае ад усялякіх шалёных і апантаных."

# game/scripts/scene/scene_day_3.rpy:3938
translate belarusian day3_amulet_before_5a6693de:

    # voice "voice/Polina/3day/30 On.ogg"
    # Pol "Он ему от одного шамана достался..."
    voice "voice/Polina/3day/30 On.ogg"
    Pol "Ён яму ад аднаго шамана дастаўся..."

# game/scripts/scene/scene_day_3.rpy:3942
translate belarusian day3_amulet_before_fdeaacfc:

    # voice "voice/Polina/3day/31M.ogg"
    # Pol "Можешь не верить, но когда дедушка забыл его надеть, с ним и случилось то несчастье."
    voice "voice/Polina/3day/31M.ogg"
    Pol "Можаш не верыць, але калі дзядуля забыўся яго надзець, з ім і здарылася тое няшчасце."

# game/scripts/scene/scene_day_3.rpy:3946
translate belarusian day3_amulet_before_f80bca25:

    # "Я вновь покосился на испещрённое царапинами когтище невиданного зверя."
    "Я зноў скасіўся на пакрыты драпінамі кіпцюрышча невядомага звера."

# game/scripts/scene/scene_day_3.rpy:3948
translate belarusian day3_amulet_before_ff0cac13:

    # voice "voice/anton/3day/60 A.ogg"
    # Ant "А чей он? Ну, в смысле коготь."
    voice "voice/anton/3day/60 A.ogg"
    Ant "А чый ён? Ну, у сэнсе кіпцюр."

# game/scripts/scene/scene_day_3.rpy:3952
translate belarusian day3_amulet_before_6a73ead3:

    # voice "voice/Polina/3day/32 D.ogg"
    # Pol "Даже не знаю…"
    voice "voice/Polina/3day/32 D.ogg"
    Pol "Нават не ведаю..."

# game/scripts/scene/scene_day_3.rpy:3957
translate belarusian day3_amulet_before_046333a7:

    # voice "voice/Polina/3day/33 M.ogg"
    # Pol "Может быть медведя, а может и тигра."
    voice "voice/Polina/3day/33 M.ogg"
    Pol "Можа быць мядзведзя, а можа і тыгра."

# game/scripts/scene/scene_day_3.rpy:3961
translate belarusian day3_amulet_before_7354033f:

    # voice "voice/Polina/3day/34 K.ogg"
    # Pol "Кого только не встретишь в нашем лесу."
    voice "voice/Polina/3day/34 K.ogg"
    Pol "Каго толькі не сустрэнеш у нашым лесе."

# game/scripts/scene/scene_day_3.rpy:3967
translate belarusian day3_amulet_before_69687a22:

    # voice "voice/Polina/3day/35 V.ogg"
    # Pol "В любом случае, пожалуйста, прими вместе с моими извинениями."
    voice "voice/Polina/3day/35 V.ogg"
    Pol "У любым выпадку, калі ласка, прымі разам з маімі выбачэннямі."

# game/scripts/scene/scene_day_3.rpy:3993
translate belarusian day3_amulet_yes_93fc9bd0:

    # voice "voice/anton/3day/61 E.ogg"
    # Ant "Если для тебя это так важно..."
    voice "voice/anton/3day/61 E.ogg"
    Ant "Калі для цябе гэта так важна..."

# game/scripts/scene/scene_day_3.rpy:3996
translate belarusian day3_amulet_yes_dcdb442f:

    # voice "voice/anton/3day/156 Horosh.ogg"
    # Ant "Хорошо, давай попробуем начать всё с чистого листа."
    voice "voice/anton/3day/156 Horosh.ogg"
    Ant "Добра, давай паспрабуем пачаць усё з чыстага аркуша."

# game/scripts/scene/scene_day_3.rpy:4011
translate belarusian day3_amulet_yes_af10671b:

    # "Я осторожно взял амулет свободной рукой — тот источал тепло Полининого тела и пленяющий аромат ежевики."
    "Я асцярожна ўзяў амулет вольнай рукой — той струменіў цяпло Палінінага цела і палонячы водар ажыны."

# game/scripts/scene/scene_day_3.rpy:4012
translate belarusian day3_amulet_yes_4e92af6a:

    # "Затем аккуратно повесил его на шею, спрятав под воротник рубашки."
    "Потым акуратна павесіў яго на шыю, схаваўшы пад каўнер кашулі."

# game/scripts/scene/scene_day_3.rpy:4020
translate belarusian day3_amulet_yes_e8a622b2:

    # "Вместе с подарком пришла какая-то странная уверенность: этот оберег сможет изменить мою жизнь."
    "Разам з падарункам прыйшла нейкая дзіўная ўпэўненасць: гэты абярэг зможа змяніць маё жыццё."

# game/scripts/scene/scene_day_3.rpy:4028
translate belarusian day3_amulet_yes_e973dcf3:

    # "Мы с Полиной синхронно улыбнулись, чувствуя, как между нами тает ледяная стена."
    "Мы з Палінай сінхронна ўсміхнуліся, адчуваючы, як паміж намі растае ледзяная сцяна."

# game/scripts/scene/scene_day_3.rpy:4032
translate belarusian day3_amulet_yes_8627d6e3:

    # voice "voice/Polina/3day/36 S.ogg"
    # Pol "Спасибо, Антон."
    voice "voice/Polina/3day/36 S.ogg"
    Pol "Дзякуй, Антон."

# game/scripts/scene/scene_day_3.rpy:4036
translate belarusian day3_amulet_yes_b648586e:

    # voice "voice/Polina/3day/37 D.ogg"
    # Pol "Для меня это действительно много значит."
    voice "voice/Polina/3day/37 D.ogg"
    Pol "Для мяне гэта сапраўды шмат значыць."

# game/scripts/scene/scene_day_3.rpy:4049
translate belarusian day3_amulet_no_bc8f2f3e:

    # voice "voice/anton/3day/62 Da.ogg"
    # Ant "Давай он побудет у тебя."
    voice "voice/anton/3day/62 Da.ogg"
    Ant "Давай ён пабудзе ў цябе."

# game/scripts/scene/scene_day_3.rpy:4053
translate belarusian day3_amulet_no_2e5c328f:

    # voice "voice/anton/3day/63 Eto.ogg"
    # Ant "Это всё таки ваша семейная реликвия..."
    voice "voice/anton/3day/63 Eto.ogg"
    Ant "Гэта ўсё ж такі ваша сямейная рэліквія..."

# game/scripts/scene/scene_day_3.rpy:4056
translate belarusian day3_amulet_no_a6aa4596:

    # voice "voice/anton/3day/64 Da.ogg"
    # Ant "Да и мне будет спокойнее, если ты будешь под защитой."
    voice "voice/anton/3day/64 Da.ogg"
    Ant "Ды і мне будзе спакайней, калі ты будзеш пад абаронай."

# game/scripts/scene/scene_day_3.rpy:4062
translate belarusian day3_amulet_no_3ed35aa2:

    # voice "voice/Polina/3day/38 V.ogg"
    # Pol "Всегда думаешь о других..."
    voice "voice/Polina/3day/38 V.ogg"
    Pol "Заўсёды думаеш пра іншых..."

# game/scripts/scene/scene_day_3.rpy:4067
translate belarusian day3_amulet_no_215cf8d0:

    # voice "voice/Polina/3day/39 Z.ogg"
    # Pol "Знаешь, мне казалось, что благородство бывает лишь в книжках."
    voice "voice/Polina/3day/39 Z.ogg"
    Pol "Ведаеш, мне здавалася, што высакароднасць бывае толькі ў кніжках."

# game/scripts/scene/scene_day_3.rpy:4072
translate belarusian day3_amulet_no_198e6fc2:

    # voice "voice/Polina/3day/40 P.ogg"
    # Pol "Пока не встретила тебя."
    voice "voice/Polina/3day/40 P.ogg"
    Pol "Пакуль не сустрэла цябе."

# game/scripts/scene/scene_day_3.rpy:4076
translate belarusian day3_amulet_no_f7f51b2e:

    # "Мне было немного неловко, и я смущенно зашаркал носком ботинка:"
    "Мне было крыху няёмка, і я збянтэжана зашаргаў наском чаравіка:"

# game/scripts/scene/scene_day_3.rpy:4078
translate belarusian day3_amulet_no_166635fd:

    # voice "voice/anton/3day/65 S.ogg"
    # Ant "Скажешь тоже."
    voice "voice/anton/3day/65 S.ogg"
    Ant "Скажаш таксама."

# game/scripts/scene/scene_day_3.rpy:4083
translate belarusian day3_amulet_no_ec5e4531:

    # voice "voice/Polina/3day/41 Ya.ogg"
    # Pol "Я серьезно!"
    voice "voice/Polina/3day/41 Ya.ogg"
    Pol "Я сур'ёзна!"

# game/scripts/scene/scene_day_3.rpy:4088
translate belarusian day3_amulet_no_9807a448:

    # voice "voice/Polina/3day/42 A.ogg"
    # Pol "А что на счёт моих извинений? Их ты примешь?"
    voice "voice/Polina/3day/42 A.ogg"
    Pol "А што наконт маіх выбачэнняў? Іх ты прымеш?"

# game/scripts/scene/scene_day_3.rpy:4092
translate belarusian day3_amulet_no_dc75a1e7:

    # "Полина пленительно улыбнулась, заглядывая в мои глаза и я покраснел еще больше."
    "Паліна чароўна ўсміхнулася, зазіраючы ў мае вочы, і я пачырванеў яшчэ больш."

# game/scripts/scene/scene_day_3.rpy:4094
translate belarusian day3_amulet_no_35a45a00:

    # voice "voice/anton/3day/66 Da.ogg"
    # Ant "Да я и не думал на тебя обижаться."
    voice "voice/anton/3day/66 Da.ogg"
    Ant "Ды я і не думаў на цябе крыўдзіцца."

# game/scripts/scene/scene_day_3.rpy:4098
translate belarusian day3_amulet_no_f6563c33:

    # voice "voice/anton/3day/156 Bilo.ogg"
    # Ant "Было бы на что."
    voice "voice/anton/3day/156 Bilo.ogg"
    Ant "Было б на што."

# game/scripts/scene/scene_day_3.rpy:4108
translate belarusian day3_amulet_after_5d897d87:

    # "Полина внимательно меня осмотрела и пощёлкала языком."
    "Паліна ўважліва мяне агледзела і пашчоўкала языком."

# game/scripts/scene/scene_day_3.rpy:4118
translate belarusian day3_amulet_after_1cf1ff52:

    # voice "voice/Polina/3day/03 A.ogg"
    # Pol "А знаешь, на что ты похож, Антоша?"
    voice "voice/Polina/3day/03 A.ogg"
    Pol "А ведаеш, на што ты падобны, Антоша?"

# game/scripts/scene/scene_day_3.rpy:4125
translate belarusian day3_amulet_after_a20cefa7:

    # "..."
    "..."

# game/scripts/scene/scene_day_3.rpy:4132
translate belarusian day3_amulet_after_491ef6b3:

    # voice "voice/Polina/3day/04 Na.ogg"
    # Pol "На блюзовую импровизацию."
    voice "voice/Polina/3day/04 Na.ogg"
    Pol "На блюзавую імправізацыю."

# game/scripts/scene/scene_day_3.rpy:4140
translate belarusian day3_amulet_after_0ba124ec:

    # "Я заморгал озадаченно."
    "Я заморгаў здзіўлена."

# game/scripts/scene/scene_day_3.rpy:4147
translate belarusian day3_amulet_after_86c6fc25:

    # voice "voice/anton/3day/055 Eto.ogg"
    # Ant "Это как?"
    voice "voice/anton/3day/055 Eto.ogg"
    Ant "Гэта як?"

# game/scripts/scene/scene_day_3.rpy:4155
translate belarusian day3_amulet_after_37c7afd0:

    # voice "voice/Polina/3day/05 D.ogg"
    # Pol "Для меня все люди с чем-то ассоциируются."
    voice "voice/Polina/3day/05 D.ogg"
    Pol "Для мяне ўсе людзі з нечым асацыююцца."

# game/scripts/scene/scene_day_3.rpy:4163
translate belarusian day3_amulet_after_2efc4eb1:

    # voice "voice/anton/3day/056..ogg"
    # Ant "И для меня. Но не с музыкой же."
    voice "voice/anton/3day/056..ogg"
    Ant "І для мяне. Але ж не з музыкай."

# game/scripts/scene/scene_day_3.rpy:4171
translate belarusian day3_amulet_after_9cafe419:

    # voice "voice/Polina/3day/06 Vo.ogg"
    # Pol "Вот как раз с музыкой!"
    voice "voice/Polina/3day/06 Vo.ogg"
    Pol "Вось якраз з музыкай!"

# game/scripts/scene/scene_day_3.rpy:4177
translate belarusian day3_amulet_after_8f02e323:

    # voice "voice/Polina/3day/07 B.ogg"
    # Pol "Бывают люди-гитарные соло. Или барабанный бой. Или военный марш, как наша Лилия Павловна."
    voice "voice/Polina/3day/07 B.ogg"
    Pol "Бываюць людзі — гітарныя сола. Ці барабанны бой. Ці ваенны марш, як наша Лілія Паўлаўна."

# game/scripts/scene/scene_day_3.rpy:4183
translate belarusian day3_amulet_after_6877d187:

    # voice "voice/Polina/3day/08 A.ogg"
    # Pol "А ты такой задумчивый, таинственный. Иногда немного печальный."
    voice "voice/Polina/3day/08 A.ogg"
    Pol "А ты такі задуменны, таямнічы. Часам крыху сумны."

# game/scripts/scene/scene_day_3.rpy:4188
translate belarusian day3_amulet_after_73b1cda1:

    # voice "voice/Polina/3day/09 T.ogg"
    # Pol "Ты точно блюз."
    voice "voice/Polina/3day/09 T.ogg"
    Pol "Ты дакладна блюз."

# game/scripts/scene/scene_day_3.rpy:4193
translate belarusian day3_amulet_after_c68636e1:

    # voice "voice/anton/3day/057 A.ogg"
    # Ant "А почему импровизация?"
    voice "voice/anton/3day/057 A.ogg"
    Ant "А чаму імправізацыя?"

# game/scripts/scene/scene_day_3.rpy:4198
translate belarusian day3_amulet_after_fa868b83:

    # voice "voice/Polina/3day/10 A.ogg"
    # Pol "А это когда слушатель не догадывается, куда свернёт мелодия, какой темп возьмёт."
    voice "voice/Polina/3day/10 A.ogg"
    Pol "А гэта калі слухач не здагадваецца, куды збочыць мелодыя, які тэмп возьме."

# game/scripts/scene/scene_day_3.rpy:4203
translate belarusian day3_amulet_after_17a9e0e9:

    # "Конечно, не всё сказанное Полиной дошло до меня."
    "Вядома, не ўсё сказанае Палінай дайшло да мяне."

# game/scripts/scene/scene_day_3.rpy:4206
translate belarusian day3_amulet_after_76ef7855:

    # "Но я не мог оторваться от её улыбки, лёгкой, как дуновенье майского ветерка, и от глаз, голубых и глубоких."
    "Але я не мог адарвацца ад яе ўсмешкі, лёгкай, як подых майскага ветрыку, і ад вачэй, блакітных і глыбокіх."

# game/scripts/scene/scene_day_3.rpy:4211
translate belarusian day3_amulet_after_96bf6be1:

    # voice "voice/Polina/3day/11 Ch.ogg"
    # Pol "Чтобы распознать в тебе музыку, нужен опыт и вкус."
    voice "voice/Polina/3day/11 Ch.ogg"
    Pol "Каб распазнаць у табе музыку, патрэбен вопыт і густ."

# game/scripts/scene/scene_day_3.rpy:4217
translate belarusian day3_amulet_after_475e8d65:

    # voice "voice/Polina/3day/12 E.ogg"
    # Pol "Это не какая-то там эстрада."
    voice "voice/Polina/3day/12 E.ogg"
    Pol "Гэта не нейкая там эстрада."

# game/scripts/scene/scene_day_3.rpy:4222
translate belarusian day3_amulet_after_a925e992:

    # voice "voice/anton/3day/058.Ya.ogg"
    # Ant "Я, наверное, вообще не знаю, что такое этот блюз."
    voice "voice/anton/3day/058.Ya.ogg"
    Ant "Я, напэўна, наогул не ведаю, што такое гэты блюз."

# game/scripts/scene/scene_day_3.rpy:4228
translate belarusian day3_amulet_after_e6f39c01:

    # "Полина охнула, нахмурилась, от чего стала ещё красивее."
    "Паліна вохнула, нахмурылася, ад чаго стала яшчэ прыгажэйшай."

# game/scripts/scene/scene_day_3.rpy:4232
translate belarusian day3_amulet_after_a28184b0:

    # voice "voice/Polina/3day/13 Ne.ogg"
    # Pol "Не произноси при мне такие слова! Я тебе обязательно дам кассету."
    voice "voice/Polina/3day/13 Ne.ogg"
    Pol "Не прамаўляй пры мне такія словы! Я табе абавязкова дам касету."

# game/scripts/scene/scene_day_3.rpy:4238
translate belarusian day3_amulet_after_e1e5cab9:

    # voice "voice/Polina/3day/14 R.ogg"
    # Pol "Раньше мне дедушка из города столько музыки привозил! И джаз, и свинг, и классику."
    voice "voice/Polina/3day/14 R.ogg"
    Pol "Раней мне дзядуля з горада столькі музыкі прывозіў! І джаз, і свінг, і класіку."

# game/scripts/scene/scene_day_3.rpy:4244
translate belarusian day3_amulet_after_ccdfffad:

    # voice "voice/Polina/3day/15 E.ogg"
    # Pol "Это он подметил, что у меня склад ума, как у музыканта."
    voice "voice/Polina/3day/15 E.ogg"
    Pol "Гэта ён заўважыў, што ў мяне склад розуму, як у музыкі."

# game/scripts/scene/scene_day_3.rpy:4250
translate belarusian day3_amulet_after_9365a293:

    # voice "voice/Polina/3day/16 Ya.ogg"
    # Pol "Я ещё совсем маленькой пыталась на бумаге записать звуки природы: пение дождя, леса..."
    voice "voice/Polina/3day/16 Ya.ogg"
    Pol "Я яшчэ зусім маленькай спрабавала на паперы запісаць гукі прыроды: спевы дажджу, лесу..."

# game/scripts/scene/scene_day_3.rpy:4255
translate belarusian day3_amulet_after_159cff4d:

    # voice "voice/anton/3day/059 Eh.ogg"
    # Ant "Эх, мне бы твои уши."
    voice "voice/anton/3day/059 Eh.ogg"
    Ant "Эх, мне б твае вушы."

# game/scripts/scene/scene_day_3.rpy:4260
translate belarusian day3_amulet_after_43952e6c:

    # voice "voice/Polina/3day/17 A.ogg"
    # Pol "А мне бы твои глаза!"
    voice "voice/Polina/3day/17 A.ogg"
    Pol "А мне б твае вочы!"

# game/scripts/scene/scene_day_3.rpy:4265
translate belarusian day3_amulet_after_a3cc9515:

    # "Я напрягся, тревожась, что она подтрунивает. Но Полина качнула головой."
    "Я напружыўся, трывожачыся, што яна паджартоўвае. Але Паліна пахітала галавой."

# game/scripts/scene/scene_day_3.rpy:4293
translate belarusian day3_amulet_after_6d46ca07:

    # voice "voice/Polina/3day/18 Da.ogg"
    # Pol "Да-да, я серьёзно. У тебя глаза художника."
    voice "voice/Polina/3day/18 Da.ogg"
    Pol "Так-так, я сур'ёзна. У цябе вочы мастака."

# game/scripts/scene/scene_day_3.rpy:4299
translate belarusian day3_amulet_after_dbad2c12:

    # voice "voice/Polina/3day/19 S.ogg"
    # Pol "Смотришь на вещи и фиксируешь их. Я так не умею."
    voice "voice/Polina/3day/19 S.ogg"
    Pol "Глядзіш на рэчы і фіксуеш іх. Я так не ўмею."

# game/scripts/scene/scene_day_3.rpy:4319
translate belarusian day3_amulet_after_66aba2f9:

    # "Мимо прошагала Катя со своим фирменным морозным взглядом."
    "Міма пракрочыла Каця са сваім фірмовым марозным позіркам."

# game/scripts/scene/scene_day_3.rpy:4320
translate belarusian day3_amulet_after_bdf2a25b:

    # "Мы нырнули в тень, стараясь его избежать."
    "Мы нырнулі ў цень, стараючыся яго пазбегнуць."

# game/scripts/scene/scene_day_3.rpy:4325
translate belarusian day3_amulet_after_1c29ff9e:

    # voice "voice/Polina/3day/21 t.ogg"
    # Pol "Теперь понимаешь, почему мы тут прячемся? Вот из-за таких, как она."
    voice "voice/Polina/3day/21 t.ogg"
    Pol "Цяпер разумееш, чаму мы тут хаваемся? Вось з-за такіх, як яна."

# game/scripts/scene/scene_day_3.rpy:4334
translate belarusian day3_amulet_after_73b76bb2:

    # voice "voice/anton/3day/060 AKat.ogg"
    # Ant "А Катька какая мелодия?"
    voice "voice/anton/3day/060 AKat.ogg"
    Ant "А Кацька якая мелодыя?"

# game/scripts/scene/scene_day_3.rpy:4344
translate belarusian day3_amulet_after_7800b077:

    # "Полина хитро улыбнулась."
    "Паліна хітра ўсміхнулася."

# game/scripts/scene/scene_day_3.rpy:4352
translate belarusian day3_amulet_after_2c3f4132:

    # voice "voice/Polina/3day/22 Sk.ogg"
    # Pol "Скрип несмазанных дверных петель."
    voice "voice/Polina/3day/22 Sk.ogg"
    Pol "Скрып нязмазаных дзвярных завес."

# game/scripts/scene/scene_day_3.rpy:4366
translate belarusian day3_amulet_after_ed6e52d7:

    # voice "voice/Polina/3day/23 Z.ogg"
    # Pol "Знаешь, такой мерзкий дискант."
    voice "voice/Polina/3day/23 Z.ogg"
    Pol "Ведаеш, такі брыдкі дыскант."

# game/scripts/scene/scene_day_3.rpy:4376
translate belarusian day3_amulet_after_94f70379:

    # "Я захихикал, прикрыв рот."
    "Я захіхікаў, прыкрыўшы рот."

# game/scripts/scene/scene_day_3.rpy:4379
translate belarusian day3_amulet_after_0a1190a5:

    # "Катя, конечно, не слышала нашего перешёптывания, но вдруг неодобрительно покосилась через плечо. А потом лишь хмыкнула и ушла восвояси."
    "Каця, вядома, не чула нашага перашэптвання, але раптам неадабральна скасілася праз плячо. А потым толькі хмыкнула і пайшла сабе прэч."

# game/scripts/scene/scene_day_3.rpy:4416
translate belarusian day3_amulet_after_defff995:

    # "Я же вспомнил про тетрадь, которую так и сжимал в руке. Повертел её."
    "Я ж узгадаў пра сшытак, які так і сціскаў у руцэ. Павярцеў яго."

# game/scripts/scene/scene_day_3.rpy:4417
translate belarusian day3_amulet_after_afcdc29e:

    # "Вместо названия предмета на обложке были выведены имя и фамилия хозяйки и слова «только для друзей»."
    "Замест назвы прадмета на вокладцы былі выведзены імя і прозвішча гаспадыні і словы «толькі для сяброў»."

# game/scripts/scene/scene_day_3.rpy:4418
translate belarusian day3_amulet_after_7cf6454c:

    # voice "voice/Polina/3day/24 L.ogg"
    # Pol "Любопытной Варваре кое-что оторвали."
    voice "voice/Polina/3day/24 L.ogg"
    Pol "Цікаўнай Варвары сёе-тое адарвалі."

# game/scripts/scene/scene_day_3.rpy:4420
translate belarusian day3_amulet_after_a83f534c:

    # voice "voice/anton/3day/062 Pr.ogg"
    # Ant "Прости. Это анкета?"
    voice "voice/anton/3day/062 Pr.ogg"
    Ant "Прабач. Гэта анкета?"

# game/scripts/scene/scene_day_3.rpy:4437
translate belarusian day3_amulet_after_6b02000a:

    # voice "voice/Polina/3day/25 Za.ogg"
    # Pol "Заполнял когда-нибудь?"
    voice "voice/Polina/3day/25 Za.ogg"
    Pol "Запаўняў калі-небудзь?"

# game/scripts/scene/scene_day_3.rpy:4447
translate belarusian day3_amulet_after_c2d19ea7:

    # "Я соврал, что да."
    "Я схлусіў, што так."

# game/scripts/scene/scene_day_3.rpy:4448
translate belarusian day3_amulet_after_e5412364:

    # "На деле же одноклассницы из моей старой школы никогда не просили меня заполнить анкету. Это было довольно обидно."
    "На справе ж аднакласніцы з маёй старой школы ніколі не прасілі мяне запоўніць анкету. Гэта было даволі крыўдна."

# game/scripts/scene/scene_day_3.rpy:4449
translate belarusian day3_amulet_after_37651e1b:

    # "Развлечение, конечно, девчачье: просто список стандартных вопросов про любимых актёров и любимые цвета, но доверить кому-то такую тетрадку считалось показателем дружбы."
    "Забаўка, вядома, дзявочая: проста спіс стандартных пытанняў пра любімых акцёраў і любімыя колеры, але даверыць камусьці такі сшытак лічылася паказчыкам сяброўства."

# game/scripts/scene/scene_day_3.rpy:4452
translate belarusian day3_amulet_after_61b9ea7f:

    # "И иногда чего-то большего, о чём раньше я имел смутные представления."
    "І часам нечага большага, пра што раней я меў цьмянае ўяўленне."

# game/scripts/scene/scene_day_3.rpy:4460
translate belarusian day3_amulet_after_b000dcee:

    # voice "voice/Polina/3day/26 Ho.ogg"
    # Pol "Хочешь — заполни и мою."
    voice "voice/Polina/3day/26 Ho.ogg"
    Pol "Хочаш — запоўні і маю."

# game/scripts/scene/scene_day_3.rpy:4469
translate belarusian day3_amulet_after_d65237c1:

    # "Сердце участило свой бег."
    "Сэрца паскорыла свой бег."

# game/scripts/scene/scene_day_3.rpy:4471
translate belarusian day3_amulet_after_d33d60bd:

    # voice "voice/anton/3day/064 Ho.ogg"
    # Ant "Хочу, спасибо."
    voice "voice/anton/3day/064 Ho.ogg"
    Ant "Хачу, дзякуй."

# game/scripts/scene/scene_day_3.rpy:4475
translate belarusian day3_amulet_after_2baf87f3:

    # "Полина хитро хихикнула."
    "Паліна хітра хіхікнула."

# game/scripts/scene/scene_day_3.rpy:4489
translate belarusian day3_polinahall_amuletfox_f2d44a56:

    # voice "voice/Polina/3day/27 A.ogg"
    # Pol "А хотя... там же столько секретов!"
    voice "voice/Polina/3day/27 A.ogg"
    Pol "А хаця... там жа столькі сакрэтаў!"

# game/scripts/scene/scene_day_3.rpy:4503
translate belarusian day3_polinahall_amuletfox_2587a07d:

    # voice "voice/Polina/3day/28 Na.ogg"
    # Pol "Наверное, лучше тебе и не знать, о чём мы, девочки, думаем."
    voice "voice/Polina/3day/28 Na.ogg"
    Pol "Напэўна, лепш табе і не ведаць, пра што мы, дзяўчаткі, думаем."

# game/scripts/scene/scene_day_3.rpy:4512
translate belarusian day3_polinahall_amuletfox_dc447d71:

    # "Она потянулась к тетрадке, играя со мной. Я перебросил находку в другую руку. Полина попыталась пресечь мой манёвр."
    "Яна пацягнулася да сшытка, гуляючы са мной. Я перакінуў знаходку ў другую руку. Паліна паспрабавала спыніць мой манеўр."

# game/scripts/scene/scene_day_3.rpy:4523
translate belarusian day3_polinahall_amuletfox_2249b1f4:

    # "Её волосы на миг коснулись моего лица — шелковистая прядь защекотала нос."
    "Яе валасы на імгненне кранулі майго твару — шаўкавістая пасма зашчыкатала нос."

# game/scripts/scene/scene_day_3.rpy:4524
translate belarusian day3_polinahall_amuletfox_9d1a7e00:

    # "Я ощутил запах, и весь мир стал этим ароматом: душистым, манящим, живым..."
    "Я адчуў пах, і ўвесь свет стаў гэтым водарам: духмяным, вабным, жывым..."

# game/scripts/scene/scene_day_3.rpy:4525
translate belarusian day3_polinahall_amuletfox_fc9f8f32:

    # "Запомнить бы его, украсть!"
    "Запомніць бы яго, скрасці!"

# game/scripts/scene/scene_day_3.rpy:4526
translate belarusian day3_polinahall_amuletfox_80109d1f:

    # "Голова пошла кругом, но я собрался и сказал, подражая интонациям лейтенанта Тихонова:"
    "Галава пайшла кругам, але я сабраўся і сказаў, пераймаючы інтанацыі лейтэнанта Ціханава:"

# game/scripts/scene/scene_day_3.rpy:4538
translate belarusian day3_polinahall_amuletfox_b5c36104:

    # voice "voice/anton/3day/065 Va.ogg"
    # Ant "Ваша анкета является важнейшей уликой, и я вынужден временно изъять её для изучения."
    voice "voice/anton/3day/065 Va.ogg"
    Ant "Ваша анкета з'яўляецца найважнейшым доказам, і я вымушаны часова канфіскаваць яе для вывучэння."

# game/scripts/scene/scene_day_3.rpy:4543
translate belarusian day3_polinahall_amuletfox_a924f44a:

    # "Полина прикрыла округлившийся в притворном ужасе рот."
    "Паліна прыкрыла акруглены ў напускным жаху рот."

# game/scripts/scene/scene_day_3.rpy:4547
translate belarusian day3_polinahall_amuletfox_ff0b887a:

    # voice "voice/Polina/3day/29 E.ogg"
    # Pol "И что мне грозит за сокрытие улик?"
    voice "voice/Polina/3day/29 E.ogg"
    Pol "І што мне пагражае за ўтойванне доказаў?"

# game/scripts/scene/scene_day_3.rpy:4552
translate belarusian day3_polinahall_amuletfox_61544d90:

    # voice "voice/anton/3day/066.S.ogg"
    # Ant "Следствие покажет."
    voice "voice/anton/3day/066.S.ogg"
    Ant "Следства пакажа."

# game/scripts/scene/scene_day_3.rpy:4557
translate belarusian day3_polinahall_amuletfox_7844f50b:

    # voice "voice/Polina/3day/30 S.ogg"
    # Pol "Сдаюсь, товарищ милиционер."
    voice "voice/Polina/3day/30 S.ogg"
    Pol "Здаюся, таварыш міліцыянер."

# game/scripts/scene/scene_day_3.rpy:4563
translate belarusian day3_polinahall_amuletfox_2993f416:

    # voice "voice/Polina/3day/31 T.ogg"
    # Pol "Только обещайте ничего не читать."
    voice "voice/Polina/3day/31 T.ogg"
    Pol "Толькі паабяцайце нічога не чытаць."

# game/scripts/scene/scene_day_3.rpy:4569
translate belarusian day3_polinahall_amuletfox_33c34c35:

    # voice "voice/Polina/3day/32 Z.ogg"
    # Pol "Здесь содержатся секретные сведения."
    voice "voice/Polina/3day/32 Z.ogg"
    Pol "Тут утрымліваюцца сакрэтныя звесткі."

# game/scripts/scene/scene_day_3.rpy:4574
translate belarusian day3_polinahall_amuletfox_1828e250:

    # voice "voice/anton/3day/067 B.ogg"
    # Ant "Боюсь, что мне всё-таки придётся выяснить, не влюблён ли кто в гражданина Петрова."
    voice "voice/anton/3day/067 B.ogg"
    Ant "Баюся, што мне ўсё ж такі давядзецца высветліць, ці не закаханы хто ў грамадзяніна Пятрова."

# game/scripts/scene/scene_day_3.rpy:4581
translate belarusian day3_polinahall_amuletfox_e07636fd:

    # "Полина засмеялась и неожиданно притиснулась к моей груди, вновь обдав ароматом волос и кожи, такой сливочной, почти прозрачной, с тоненькими ниточками вен под ней."
    "Паліна засмяялася і нечакана прыціснулася да маіх грудзей, зноў абдаўшы водарам валасоў і скуры, такой сметанковай, амаль празрыстай, з тоненькімі нітачкамі вен пад ёй."

# game/scripts/scene/scene_day_3.rpy:4585
translate belarusian day3_polinahall_amuletfox_6bbaec61:

    # "Её шёпот был горячим, как расплавленное на сковородке масло."
    "Яе шэпт быў гарачым, як растопленае на патэльні масла."

# game/scripts/scene/scene_day_3.rpy:4589
translate belarusian day3_polinahall_amuletfox_05c5aa79:

    # voice "voice/Polina/3day/33 T.ogg"
    # Pol "Тогда поклянитесь, что не станете разглашать информацию."
    voice "voice/Polina/3day/33 T.ogg"
    Pol "Тады пакляніцеся, што не станеце разгалошваць інфармацыю."

# game/scripts/scene/scene_day_3.rpy:4594
translate belarusian day3_polinahall_amuletfox_05915cdf:

    # voice "voice/anton/3day/068 Ch.ogg"
    # Ant "Честное милицейское!"
    voice "voice/anton/3day/068 Ch.ogg"
    Ant "Сумленнае міліцэйскае!"

# game/scripts/scene/scene_day_3.rpy:4609
translate belarusian day3_polinahall_ring_1a839ed7:

    # voice "voice/Polina/3day/34 At.ogg"
    # Pol "А теперь, Антоша, самое время поторопиться."
    voice "voice/Polina/3day/34 At.ogg"
    Pol "А цяпер, Антоша, самы час паспяшацца."

# game/scripts/scene/scene_day_3.rpy:4646
translate belarusian dev_day3_anketa_after_7f92231e:

    # "На уроке я достал тетрадь."
    "На ўроку я дастаў сшытак."

# game/scripts/scene/scene_day_3.rpy:4655
translate belarusian dev_day3_anketa_after_e45e7040:

    # "С величайшей осторожностью, будто она была хрупким сокровищем."
    "З найвялікшай асцярожнасцю, быццам ён быў далікатным скарбам."

# game/scripts/scene/scene_day_3.rpy:4657
translate belarusian dev_day3_anketa_after_ea6a5bb6:

    # "Полистал, вчитываясь в чужие предпочтения."
    "Пагартаў, учытваючыся ў чужыя перавагі."

# game/scripts/scene/scene_day_3.rpy:4661
translate belarusian dev_day3_anketa_after_f11a34da:

    # "Изрядно удивился, обнаружив кривоватый почерк Ромки."
    "Вельмі здзівіўся, выявіўшы крываваты почырк Ромкі."

# game/scripts/scene/scene_day_3.rpy:4662
translate belarusian dev_day3_anketa_after_2bec8d72:

    # "Буквы вылезали за рамки клеточек, словно стеснялись своей бесформенности."
    "Літары вылазілі за межы клетачак, нібы саромеліся сваёй бясформавасці."

# game/scripts/scene/scene_day_3.rpy:4663
translate belarusian dev_day3_anketa_after_35eb0279:

    # "Грозный Ромка нашёл время заниматься такой ерундой?"
    "Грозны Ромка знайшоў час займацца такой лухтой?"

# game/scripts/scene/scene_day_3.rpy:4664
translate belarusian dev_day3_anketa_after_48fc44ef:

    # "Я улыбнулся в кулак, узнав, что любимый мультфильм Ромы – даже не «Чёрный плащ», а «Утиные истории»."
    "Я ўсміхнуўся ў кулак, даведаўшыся, што любімы мультфільм Ромы — нават не «Чорны плашч», а «Качыныя гісторыі»."

# game/scripts/scene/scene_day_3.rpy:4665
translate belarusian dev_day3_anketa_after_cca373f4:

    # "Где-то далеко учитель декламировал отрывки из рассказа Андреева «Кусака». Мне было не до него."
    "Недзе далёка настаўнік дэкламаваў урыўкі з апавядання Андрэева «Кусака». Мне было не да яго."

# game/scripts/scene/scene_day_3.rpy:4670
translate belarusian dev_day3_anketa_after_e1d22ccc:

    # "Страницу с ответами Полины украшали цветы и вырезки из журнала «Cool girl»."
    "Старонку з адказамі Паліны ўпрыгожвалі кветкі і выразкі з часопіса «Cool girl»."

# game/scripts/scene/scene_day_3.rpy:4671
translate belarusian dev_day3_anketa_after_2e90cde8:

    # "Любимая музыка – Шуберт."
    "Любімая музыка — Шуберт."

# game/scripts/scene/scene_day_3.rpy:4672
translate belarusian dev_day3_anketa_after_c808c3d6:

    # "Лучший друг – дедушка."
    "Лепшы сябар — дзядуля."

# game/scripts/scene/scene_day_3.rpy:4673
translate belarusian dev_day3_anketa_after_0101639e:

    # "Хобби – не скрипка, как я предполагал, а куда более загадочное – «слушать»."
    "Хобі — не скрыпка, як я меркаваў, а куды больш загадкавае — «слухаць»."

# game/scripts/scene/scene_day_3.rpy:4677
translate belarusian dev_day3_anketa_after_2b7e3e69:

    # "Неужели такой банальный процесс может быть увлечением?"
    "Няўжо такі банальны працэс можа быць захапленнем?"

# game/scripts/scene/scene_day_3.rpy:4678
translate belarusian dev_day3_anketa_after_f369ca00:

    # "Я посмотрел через головы одноклассников на Полину. Она сосредоточенно записывала за учителем."
    "Я паглядзеў праз галовы аднакласнікаў на Паліну. Яна засяроджана запісвала за настаўнікам."

# game/scripts/scene/scene_day_3.rpy:4684
translate belarusian dev_day3_anketa_after_e71e71c0:

    # "Я пролистал тетрадь до чистой страницы и вооружился ручкой."
    "Я прагартаў сшытак да чыстай старонкі і ўзброіўся ручкай."

# game/scripts/scene/scene_day_3.rpy:4688
translate belarusian dev_day3_anketa_after_f5d8ef70:

    # "Петров Антон. 6 «В»."
    "Пятроў Антон. 6 «В»."

# game/scripts/scene/scene_day_3.rpy:4694
translate belarusian dev_day3_anketa_after_e287da2e:

    # "Я долго вспоминал любимого музыканта, пока на ум не пришла модная группа «{u}Кар-мэн{/u}» с крутыми танцорами в клипах."
    "Я доўга ўзгадваў любімага музыку, пакуль на розум не прыйшла модная група «{u}Кар-мэн{/u}» з крутымі танцорамі ў кліпах."

# game/scripts/scene/scene_day_3.rpy:4698
translate belarusian dev_day3_anketa_after_c45980e9:

    # "Любимый праздник – это просто. Новый год, естественно."
    "Любімае свята — гэта проста. Новы год, натуральна."

# game/scripts/scene/scene_day_3.rpy:4702
translate belarusian dev_day3_anketa_after_519220e0:

    # "Хобби – рисование."
    "Хобі — маляванне."

# game/scripts/scene/scene_day_3.rpy:4706
translate belarusian dev_day3_anketa_after_955764f1:

    # "Мечта... Пускай будет посетить Диснейленд."
    "Мара... Няхай будзе наведаць Дыснэйлэнд."

# game/scripts/scene/scene_day_3.rpy:4710
translate belarusian dev_day3_anketa_after_8eadd7a5:

    # "Мой герой."
    "Мой герой."

# game/scripts/scene/scene_day_3.rpy:4711
translate belarusian dev_day3_anketa_after_d903b6c7:

    # "Я не раздумывая начал: «па...»"
    "Я не раздумваючы пачаў: «па...»"

# game/scripts/scene/scene_day_3.rpy:4715
translate belarusian dev_day3_anketa_after_1f21c3d9:

    # "Остановился на первом слоге из двух. Вдруг тем, кто будет читать анкеты, мой выбор покажется смешным и глупым?"
    "Спыніўся на першым складзе з двух. Раптам тым, хто будзе чытаць анкеты, мой выбар падасца смешным і дурным?"

# game/scripts/scene/scene_day_3.rpy:4716
translate belarusian dev_day3_anketa_after_1e9b9018:

    # "Обмозговав, я решил, что далеко не всё стоит доверять бумаге."
    "Абмазгаваўшы, я вырашыў, што далёка не ўсё варта давяраць паперы."

# game/scripts/scene/scene_day_3.rpy:4717
translate belarusian dev_day3_anketa_after_e7258088:

    # "«Паук», — закончил я, сверху присобачил «человек». Человек-паук. Почему бы и нет?"
    "«Павук», — скончыў я, зверху прысабачыў «чалавек». Чалавек-павук. Чаму б і не?"

# game/scripts/scene/scene_day_3.rpy:4721
translate belarusian dev_day3_anketa_after_8531b6b0:

    # "Чего ты боишься больше всего?"
    "Чаго ты баішся больш за ўсё?"

# game/scripts/scene/scene_day_3.rpy:4722
translate belarusian dev_day3_anketa_after_a0dd1eb4:

    # "Я написал незамедлительно: потерять дорогого мне человека."
    "Я напісаў неадкладна: страціць дарагога мне чалавека."

# game/scripts/scene/scene_day_3.rpy:4726
translate belarusian dev_day3_anketa_after_1f023c1e:

    # "Твой номер телефона."
    "Твой нумар тэлефона."

# game/scripts/scene/scene_day_3.rpy:4727
translate belarusian dev_day3_anketa_after_20732a48:

    # "Никакого секрета: 3-03-95."
    "Ніякага сакрэту: 3-03-95."

# game/scripts/scene/scene_day_3.rpy:4730
translate belarusian dev_day3_anketa_after_1b843023:

    # "Любимый мультфильм?"
    "Любімы мультфільм?"

# game/scripts/scene/scene_day_3.rpy:4731
translate belarusian dev_day3_anketa_after_ae39e5ff:

    # "Трансформеры"
    "Трансформеры"

# game/scripts/scene/scene_day_3.rpy:4736
translate belarusian dev_day3_anketa_after_f67c6a11:

    # "Лучший друг..."
    "Лепшы сябар..."

# game/scripts/scene/scene_day_3.rpy:4737
translate belarusian dev_day3_anketa_after_e20ebf1a:

    # "Я замешкался, прикусив колпачок ручки."
    "Я замарудзіўся, прыкусіўшы каўпачок ручкі."

# game/scripts/scene/scene_day_3.rpy:4741
translate belarusian dev_day3_anketa_after_3f58d5b0:

    # "Вспомнил Алису, скользящую за стволами деревьев, задорно смеющуюся в темноте."
    "Узгадаў Алісу, якая слізгае за стваламі дрэў, задзірліва смяецца ў цемры."

# game/scripts/scene/scene_day_3.rpy:4743
translate belarusian dev_day3_anketa_after_7ad99175:

    # "В конце концов, именно она не дала меня на растерзание тому исполинскому монстру, что бродит по лесу в ночи."
    "У рэшце рэшт, менавіта яна не аддала мяне на раздзіранне таму велізарнаму монстру, што блукае па лесе ўначы."

# game/scripts/scene/scene_day_3.rpy:4744
translate belarusian dev_day3_anketa_after_8f045cae:

    # "Как-то упомянул при Ромке и Бяше «девочку в маске», но они лишь странно на меня посмотрели."
    "Неяк згадаў пры Ромку і Бяшу «дзяўчынку ў масцы», але яны толькі дзіўна на мяне паглядзелі."

# game/scripts/scene/scene_day_3.rpy:4745
translate belarusian dev_day3_anketa_after_c7ef351e:

    # "Интересно, чем она сейчас занимается?"
    "Цікава, чым яна цяпер займаецца?"

# game/scripts/scene/scene_day_3.rpy:4747
translate belarusian dev_day3_anketa_after_2e530719:

    # "«Лучший друг», — перечитал я анкетный вопрос. Такой лёгкий и такой важный."
    "«Лепшы сябар», — перачытаў я анкетнае пытанне. Такое лёгкае і такое важнае."

# game/scripts/scene/scene_day_3.rpy:4751
translate belarusian dev_day3_anketa_after_b466ada4:

    # "Ответом были две буквы, и я аккуратно вписал их в клеточки:"
    "Адказам былі тры літары, і я акуратна ўпісаў іх у клетачкі:"

# game/scripts/scene/scene_day_3.rpy:4752
translate belarusian dev_day3_anketa_after_30bf1b93:

    # "«Ты»."
    "«Ты»."

# game/scripts/scene/scene_day_3.rpy:4759
translate belarusian dev_day3_anketa_after_5ff4fe07:

    # "«Ты», — повторил я, выныривая из школы."
    "«Ты», — паўтарыў я, вынырваючы са школы."

# game/scripts/scene/scene_day_3.rpy:4768
translate belarusian dev_day3_anketa_after_d7598c5b:

    # "Морозный бодрящий воздух обдал мои щёки румянцем."
    "Марознае падбадзёрлівае паветра абдало мае шчокі румянцам."

# game/scripts/scene/scene_day_3.rpy:4769
translate belarusian dev_day3_anketa_after_5e46e232:

    # "Солнце, похожее на целый яичный желток, ярко светило."
    "Сонца, падобнае на цэлы яечны жаўток, ярка свяціла."

# game/scripts/scene/scene_day_3.rpy:4770
translate belarusian dev_day3_anketa_after_44791357:

    # "Дорогу словно отлили серебром: снег искрился, преломляя солнечные лучи, и я, зажмурившись, улыбался ослепительной белизне."
    "Дарогу быццам адлілі серабром: снег іскрыўся, пераламляючы сонечныя промні, і я, зажмурыўшыся, усміхаўся асляпляльнай белі."

# game/scripts/scene/scene_day_3.rpy:4771
translate belarusian dev_day3_anketa_after_075fd31f:

    # "И от чего-то волшебного и зовущего в груди."
    "І ад нечага чароўнага і клічучага ў грудзях."

# game/scripts/scene/scene_day_3.rpy:4772
translate belarusian dev_day3_anketa_after_d23f8072:

    # "Потому что в дружбе может таиться нечто большее."
    "Таму што ў сяброўстве можа таіцца нешта большае."

# game/scripts/scene/scene_day_3.rpy:4777
translate belarusian dev_day3_anketa_after_c939b9f2:

    # "Ответом было имя сестры, и я аккуратно вписал его в клеточки:"
    "Адказам было імя сястры, і я акуратна ўпісаў яго ў клетачкі:"

# game/scripts/scene/scene_day_3.rpy:4781
translate belarusian dev_day3_anketa_after_c3ff8367:

    # "«Оля»."
    "«Оля»."

# game/scripts/scene/scene_day_3.rpy:4789
translate belarusian dev_day3_anketa_after_7f5c998e:

    # "«Оля», — повторил я, выныривая из школы."
    "«Оля», — паўтарыў я, вынырваючы са школы."

# game/scripts/scene/scene_day_3.rpy:4798
translate belarusian dev_day3_anketa_after_55fdf8f0:

    # "В моей тетрадке красовался свежий рисунок дракончика, которого я сделал специально для моей любимой сестрёнки."
    "У маім сшытку красаваўся свежы малюнак дракончыка, якога я зрабіў спецыяльна для маёй любімай сястрычкі."

# game/scripts/scene/scene_day_3.rpy:4799
translate belarusian dev_day3_anketa_after_4937b9c6:

    # "В этом царстве мрака и обмана только её поддержка вдохновляла меня продолжать творить и не терять веру в людей."
    "У гэтым царстве змроку і падману толькі яе падтрымка натхняла мяне працягваць тварыць і не губляць веру ў людзей."

# game/scripts/scene/scene_day_3.rpy:4800
translate belarusian dev_day3_anketa_after_d7598c5b_1:

    # "Морозный бодрящий воздух обдал мои щёки румянцем."
    "Марознае падбадзёрлівае паветра абдало мае шчокі румянцам."

# game/scripts/scene/scene_day_3.rpy:4803
translate belarusian dev_day3_anketa_after_5e46e232_1:

    # "Солнце, похожее на целый яичный желток, ярко светило."
    "Сонца, падобнае на цэлы яечны жаўток, ярка свяціла."

# game/scripts/scene/scene_day_3.rpy:4804
translate belarusian dev_day3_anketa_after_44791357_1:

    # "Дорогу словно отлили серебром: снег искрился, преломляя солнечные лучи, и я, зажмурившись, улыбался ослепительной белизне."
    "Дарогу быццам адлілі серабром: снег іскрыўся, пераламляючы сонечныя промні, і я, зажмурыўшыся, усміхаўся асляпляльнай белі."

# game/scripts/scene/scene_day_3.rpy:4805
translate belarusian dev_day3_anketa_after_8ca52407:

    # "Плевать, что у меня больше нет настоящих друзей."
    "Пляваць, што ў мяне больш няма сапраўдных сяброў."

# game/scripts/scene/scene_day_3.rpy:4806
translate belarusian dev_day3_anketa_after_aff56b60:

    # "У меня есть нечто большее — тот, кто нуждается в моей защите; тот, кто никогда не предаст и не обидит."
    "У мяне ёсць нешта большае — той, хто мае патрэбу ў маёй абароне; той, хто ніколі не здрадзіць і не пакрыўдзіць."

# game/scripts/scene/scene_day_3.rpy:4807
translate belarusian dev_day3_anketa_after_884228e6:

    # "Потому что семья — это самое главное. Так всегда говорил мой папа."
    "Таму што сям'я — гэта самае галоўнае. Так заўсёды казаў мой тата."

# game/scripts/scene/scene_day_3.rpy:4846
translate belarusian day3_corner_fox_92851a1b:

    # voice "voice/byasha/125 Tosh.ogg"
    # Bya "Тош, ты чё лыбишься?"
    voice "voice/byasha/125 Tosh.ogg"
    Bya "Тош, ты чаго лыбішся?"

# game/scripts/scene/scene_day_3.rpy:4854
translate belarusian day3_corner_fox_4ef8917f:

    # "Я сжевал улыбку и покраснел, как рак."
    "Я зжаваў усмешку і пачырванеў, як рак."

# game/scripts/scene/scene_day_3.rpy:4855
translate belarusian day3_corner_fox_9b4fea9d:

    # voice "voice/anton/3day/070 Aneg.ogg"
    # Ant "Да так, анекдот вспомнил."
    voice "voice/anton/3day/070 Aneg.ogg"
    Ant "Ды так, анекдот узгадаў."

# game/scripts/scene/scene_day_3.rpy:4857
translate belarusian day3_corner_fox_9d3571b2:

    # "Бяша топтался в центре двора, ботинки нетерпеливо елозили по льду."
    "Бяша таптаўся ў цэнтры двара, чаравікі нецярпліва соўгаліся па лёдзе."

# game/scripts/scene/scene_day_3.rpy:4861
translate belarusian day3_corner_fox_4ce0fb50:

    # voice "voice/byasha/126 Nu.ogg"
    # Bya "Ну делись тогда, на."
    voice "voice/byasha/126 Nu.ogg"
    Bya "Ну дзяліся тады, на."

# game/scripts/scene/scene_day_3.rpy:4866
translate belarusian day3_corner_fox_fe04b8aa:

    # "Я прошерстил память и выдал первый попавшийся анекдот, услышанный утром в столовой."
    "Я прашэрсціў памяць і выдаў першы трапіўшыся анекдот, пачуты раніцай у сталовай."

# game/scripts/scene/scene_day_3.rpy:4868
translate belarusian day3_corner_fox_f0ec7842:

    # voice "voice/anton/3day/069 Ko.ogg"
    # Ant "Кощей вышел на крыльцо, почесать себе сундук, зайца, утку и яйцо."
    voice "voice/anton/3day/069 Ko.ogg"
    Ant "Кашчэй выйшаў на ганак, пачасаць сабе куфар, зайца, качку і яйцо."

# game/scripts/scene/scene_day_3.rpy:4887
translate belarusian day3_corner_fox_c6a30e12:

    # voice "voice/byasha/127 Yasno.ogg"
    # Bya "Ясно, {u}Петросян{/u}."
    voice "voice/byasha/127 Yasno.ogg"
    Bya "Ясна, {u}Петрасян{/u}."

# game/scripts/scene/scene_day_3.rpy:4893
translate belarusian day3_corner_fox_70213e20:

    # voice "voice/byasha/128 NuIdem.ogg"
    # Bya "Ну, идём, на."
    voice "voice/byasha/128 NuIdem.ogg"
    Bya "Ну, хадзем, на."

# game/scripts/scene/scene_day_3.rpy:4908
translate belarusian day3_corner_fox_17f1ef2b:

    # "И не дожидаясь, он последовал к углу школы. Я неуверенно двинулся за ним."
    "І не чакаючы, ён накіраваўся да вугла школы. Я няўпэўнена рушыў за ім."

# game/scripts/scene/scene_day_3.rpy:4920
translate belarusian day3_corner_fox_bca22474:

    # voice "voice/anton/3day/071 A.ogg"
    # Ant "А куда?"
    voice "voice/anton/3day/071 A.ogg"
    Ant "А куды?"

# game/scripts/scene/scene_day_3.rpy:4928
translate belarusian day3_corner_fox_a711250f:

    # voice "voice/byasha/129 Idem A.ogg"
    # Bya "Идём-идём, на." id day3_corner_fox_a711250f
    voice "voice/byasha/129 Idem A.ogg"
    Bya "Хадзем-хадзем, на." id day3_corner_fox_a711250f

# game/scripts/scene/scene_day_3.rpy:4934
translate belarusian day3_corner_fox_bbbc0907:

    # voice "voice/byasha/130 mi.ogg"
    # Bya "Мы теперь в одной связке и действуем заодно."
    voice "voice/byasha/130 mi.ogg"
    Bya "Мы цяпер у адной звязцы і дзейнічаем заадно."

# game/scripts/scene/scene_day_3.rpy:4940
translate belarusian day3_corner_fox_d15ca125:

    # voice "voice/byasha/131 Po.ogg"
    # Bya "Помощь твоя нужна в кое-каком дельце."
    voice "voice/byasha/131 Po.ogg"
    Bya "Дапамога твая патрэбна ў адной спраўцы."

# game/scripts/scene/scene_day_3.rpy:4957
translate belarusian day3_corner_fox_867c30bb:

    # "Я почувствовал холодок за пазухой. Больно не понравилось слово «дельце»."
    "Я адчуў халадок за пазухай. Надта не спадабалася слова «спраўка»."

# game/scripts/scene/scene_day_3.rpy:4958
translate belarusian day3_corner_fox_ceec2a79:

    # "За этим словом, произнесённым вот так, через плевок, обычно скрывались разные тёмные штуки."
    "За гэтым словам, вымаўленым вось так, праз плявок, звычайна хаваліся розныя цёмныя штукі."

# game/scripts/scene/scene_day_3.rpy:4959
translate belarusian day3_corner_fox_fc4bf575:

    # "Так говорили незнакомцы, звоня нам в старую квартиру по телефону: «Батю позови, дельце есть»."
    "Так казалі незнаёмцы, тэлефануючы нам у старую кватэру: «Бацю пакліч, спраўка ёсць»."

# game/scripts/scene/scene_day_3.rpy:4960
translate belarusian day3_corner_fox_2ed09bd9:

    # "Бяша обернулся: в облегающем капюшоне он был похож на космонавта."
    "Бяша абярнуўся: у аблягаючым капюшоне ён быў падобны на касманаўта."

# game/scripts/scene/scene_day_3.rpy:4961
translate belarusian day3_corner_fox_8784baf2:

    # "Если бы он был звуком, то, скорее всего, пронзительным свистом, сигналом того, кто сторожит на шухере."
    "Калі б ён быў гукам, то, хутчэй за ўсё, пранізлівым свістам, сігналам таго, хто пільнуе на шухеры."

# game/scripts/scene/scene_day_3.rpy:4962
translate belarusian day3_corner_fox_0d73765d:

    # "От мысли, что меня сейчас втянут во что-то преступное, ноги предательски затряслись."
    "Ад думкі, што мяне зараз уцягнуць у нешта злачыннае, ногі здрадніцку затрэсліся."

# game/scripts/scene/scene_day_3.rpy:4972
translate belarusian day3_corner_fox_2a9ce2a6:

    # "Череда образов проскочила перед глазами: строгий Тихонов захлопывает дверь камеры, отец гневно бьёт по тюремным прутьям, а мама и Оля тихо плачут рядом..."
    "Чарада вобразаў праскочыла перад вачыма: строгі Ціханаў захлопвае дзверы камеры, бацька гнеўна б'е па турэмных кратах, а мама і Оля ціха плачуць побач..."

# game/scripts/scene/scene_day_3.rpy:4973
translate belarusian day3_corner_fox_b88cb265:

    # "На заднем дворе, как назло, никого не было."
    "На заднім двары, як на злосць, нікога не было."

# game/scripts/scene/scene_day_3.rpy:4996
translate belarusian day3_corner_fox_c0858647:

    # "Никого, кроме мрачного Ромки."
    "Нікога, акрамя змрочнага Ромкі."

# game/scripts/scene/scene_day_3.rpy:4997
translate belarusian day3_corner_fox_a781b17d:

    # "Он стоял, широко раздвинув ноги, правая рука была спрятана за спину."
    "Ён стаяў, шырока расставіўшы ногі, правая рука была схавана за спіну."

# game/scripts/scene/scene_day_3.rpy:4998
translate belarusian day3_corner_fox_35ef256d:

    # "Наверняка там нож – стальная бабочка смерти, летящая на стук сердца."
    "Напэўна там нож — сталёвы матылёк смерці, які ляціць на стук сэрца."

# game/scripts/scene/scene_day_3.rpy:4999
translate belarusian day3_corner_fox_232991b5:

    # "Ромка плотно сжал сухие губы, стреляя взглядом то в меня, то по сторонам."
    "Ромка шчыльна сціснуў сухія вусны, страляючы позіркам то ў мяне, то па баках."

# game/scripts/scene/scene_day_3.rpy:5000
translate belarusian day3_corner_fox_083c67cf:

    # "Что происходит?"
    "Што адбываецца?"

# game/scripts/scene/scene_day_3.rpy:5001
translate belarusian day3_corner_fox_69df07b3:

    # "Ромка будто прочёл и озвучил мои мысли:"
    "Ромка быццам прачытаў і агучыў мае думкі:"

# game/scripts/scene/scene_day_3.rpy:5004
translate belarusian day3_corner_fox_4b894ea1:

    # voice "voice/romka/3day/01 Ct.ogg"
    # Rom "Что происходит?"
    voice "voice/romka/3day/01 Ct.ogg"
    Rom "Што адбываецца?"

# game/scripts/scene/scene_day_3.rpy:5021
translate belarusian day3_corner_fox_abf41794:

    # voice "voice/byasha/132 Niche.ogg"
    # Bya "Ничего. Проветриваемся, на."
    voice "voice/byasha/132 Niche.ogg"
    Bya "Нічога. Праветрываемся, на."

# game/scripts/scene/scene_day_3.rpy:5024
translate belarusian day3_corner_fox_aa90ad60:

    # "Голос Бяши был противным, насмешливым."
    "Голас Бяшы быў брыдкім, насмешлівым."

# game/scripts/scene/scene_day_3.rpy:5026
translate belarusian day3_corner_fox_45dee8b5:

    # voice "voice/romka/3day/02 Pr.ogg"
    # Rom "Проветривайся в другом месте."
    voice "voice/romka/3day/02 Pr.ogg"
    Rom "Праветрывайся ў іншым месцы."

# game/scripts/scene/scene_day_3.rpy:5032
translate belarusian day3_corner_fox_52b909ad:

    # voice "voice/byasha/134 A mne.ogg"
    # Bya "А мне и здесь нормально. Да, куколка?"
    voice "voice/byasha/134 A mne.ogg"
    Bya "А мне і тут нармальна. Праўда, лялечка?"

# game/scripts/scene/scene_day_3.rpy:5040
translate belarusian day3_corner_fox_02ee3918:

    # "Куколка? Это он мне?"
    "Лялечка? Гэта ён мне?"

# game/scripts/scene/scene_day_3.rpy:5041
translate belarusian day3_corner_fox_b607d0be:

    # "От изумления я не мог выдавить из себя ни звука."
    "Ад здзіўлення я не мог выціснуць з сябе ні гуку."

# game/scripts/scene/scene_day_3.rpy:5042
translate belarusian day3_corner_fox_be4f1a0c:

    # "Только таращился на весь этот цирк, разыгрываемый моими неоднозначными товарищами."
    "Толькі вылупіўся на ўвесь гэты цырк, які разыгрывалі мае неадназначныя таварышы."

# game/scripts/scene/scene_day_3.rpy:5059
translate belarusian day3_corner_fox_6d19609d:

    # voice "voice/romka/3day/03 Vi.ogg"
    # Rom "Видишь, ты её напугал."
    voice "voice/romka/3day/03 Vi.ogg"
    Rom "Бачыш, ты яе напалохаў."

# game/scripts/scene/scene_day_3.rpy:5067
translate belarusian day3_corner_fox_a94fd886:

    # voice "voice/byasha/3day/136 Atebe.ogg"
    # Bya "А тебе какая забота, говнюк? Вали пока цел, на."
    voice "voice/byasha/3day/136 Atebe.ogg"
    Bya "А табе які клопат, гаўнюк? Валі пакуль цэлы, на."

# game/scripts/scene/scene_day_3.rpy:5074
translate belarusian day3_corner_fox_f36f79ad:

    # "Я переваривал услышанное: Бяша назвал Рому говнюком? Он свихнулся?"
    "Я пераварваў пачутае: Бяша назваў Рому гаўнюком? Ён з глузду з'ехаў?"

# game/scripts/scene/scene_day_3.rpy:5075
translate belarusian day3_corner_fox_dc1e2187:

    # voice "voice/anton/3day/072 Pa.ogg"
    # Ant "Пацаны..."
    voice "voice/anton/3day/072 Pa.ogg"
    Ant "Пацаны..."

# game/scripts/scene/scene_day_3.rpy:5099
translate belarusian day3_corner_fox_6019df39:

    # "Не обращая внимание на мой робкий протест, Бяша шагнул к Роме, замахнулся как-то чудно и комично."
    "Не звяртаючы ўвагі на мой нясмелы пратэст, Бяша ступіў да Ромы, замахнуўся неяк дзіўна і камічна."

# game/scripts/scene/scene_day_3.rpy:5123
translate belarusian day3_corner_fox_286f27a3:

    # "Не вынимая правой руки, Рома свободной кистью заблокировал удар."
    "Не вымаючы правай рукі, Рома вольнай кісцю заблакаваў удар."

# game/scripts/scene/scene_day_3.rpy:5125
translate belarusian day3_corner_fox_8c7f0c7e:

    # "Актёры в индийских фильмах, которые любит мама, и то дрались убедительнее."
    "Акцёры ў індыйскіх фільмах, якія любіць мама, і тое біліся больш пераканаўча."

# game/scripts/scene/scene_day_3.rpy:5127
translate belarusian day3_corner_fox_0e9e3249:

    # "Бяша заскулил, хоть я и не видел, чтобы Рома стукнул его."
    "Бяша заскуголіў, хоць я і не бачыў, каб Рома стукнуў яго."

# game/scripts/scene/scene_day_3.rpy:5143
translate belarusian day3_corner_fox_026c06af:

    # voice "voice/byasha/138 Ai.ogg"
    # Bya "Ай-ай-ай, больно как, у меня сотрясение мозга!"
    voice "voice/byasha/138 Ai.ogg"
    Bya "Ай-ай-ай, балюча як, у мяне страсенне мозгу!"

# game/scripts/scene/scene_day_3.rpy:5168
translate belarusian day3_corner_fox_d01bb4fd:

    # "Рома пнул куда-то в коленку, Бяша припал на четвереньки, охая и ахая."
    "Рома штурхануў кудысьці ў калена, Бяша прыпаў на карачкі, вохкаючы і ахкаючы."

# game/scripts/scene/scene_day_3.rpy:5170
translate belarusian day3_corner_fox_0e42e060:

    # "А я смотрел, не моргая, как приближается Ромка."
    "А я глядзеў, не міргаючы, як набліжаецца Ромка."

# game/scripts/scene/scene_day_3.rpy:5180
translate belarusian day3_corner_fox_28c50920:

    # "Локоть его подёргивался, рука выползала из-за спины. Я врос в асфальт."
    "Локаць яго паторгваўся, рука выпаўзала з-за спіны. Я ўрос у асфальт."

# game/scripts/scene/scene_day_3.rpy:5186
translate belarusian day3_corner_fox_8cee35ae:

    # "Сейчас заблестит лезвие."
    "Зараз заблішчыць лязо."

# game/scripts/scene/scene_day_3.rpy:5193
translate belarusian day3_corner_fox_68d03680:

    # "Вот сейчас!"
    "Вось зараз!"

# game/scripts/scene/scene_day_3.rpy:5194
translate belarusian day3_corner_fox_58ed6067:

    # "Ромка резко выкинул руку, и я щёлкнул зубами от испуга."
    "Ромка рэзка выкінуў руку, і я шчоўкнуў зубамі ад спалоху."

# game/scripts/scene/scene_day_3.rpy:5220
translate belarusian day3_corner_fox_775583cc:

    # "Букет подснежников, не пойми откуда взявшийся в такой мороз, качнулся у моего лица."
    "Букет пралесак, не зразумець адкуль узяўшыся ў такі мароз, гайдануўся каля майго твару."

# game/scripts/scene/scene_day_3.rpy:5221
translate belarusian day3_corner_fox_920a806c:

    # "Это что? Цветы?!"
    "Гэта што? Кветкі?!"

# game/scripts/scene/scene_day_3.rpy:5222
translate belarusian day3_corner_fox_fcffa732:

    # voice "voice/romka/3day/05 Poz.ogg"
    # Rom "Позволь проводить тебя."
    voice "voice/romka/3day/05 Poz.ogg"
    Rom "Дазволь правесці цябе."

# game/scripts/scene/scene_day_3.rpy:5224
translate belarusian day3_corner_fox_d2867a7f:

    # voice "voice/romka/3day/06 Ato.ogg"
    # Rom "А то сама знаешь: шастают тут всякие... маньяки."
    voice "voice/romka/3day/06 Ato.ogg"
    Rom "А то сама ведаеш: бадзяюцца тут усякія... маньякі."

# game/scripts/scene/scene_day_3.rpy:5242
translate belarusian day3_corner_fox_e7b2cd18:

    # voice "voice/byasha/3day/141 N.ogg"
    # Bya "Ну а чё, на? Бедным маньякам уже и пошастать нельзя?"
    voice "voice/byasha/3day/141 N.ogg"
    Bya "Ну а што, на? Бедным маньякам ужо і пабадзяцца нельга?"

# game/scripts/scene/scene_day_3.rpy:5252
translate belarusian day3_corner_fox_82a2a110:

    # voice "voice/romka/3day/07 Xr.ogg"
    # Rom "Эх, хреновый из тебя маньяк, Бяшка, даже Тоха не повёлся."
    voice "voice/romka/3day/07 Xr.ogg"
    Rom "Эх, хрэнавы з цябе маньяк, Бяшка, нават Тоха не павёўся."

# game/scripts/scene/scene_day_3.rpy:5257
translate belarusian day3_corner_fox_55dd4bdc:

    # voice "voice/romka/3day/08 A ona.ogg"
    # Rom "А она нас в два счёта раскусит."
    voice "voice/romka/3day/08 A ona.ogg"
    Rom "А яна нас у два рахункі раскусіць."

# game/scripts/scene/scene_day_3.rpy:5264
translate belarusian day3_corner_fox_fcb93ad0:

    # "Наконец ко мне вернулся дар речи."
    "Нарэшце да мяне вярнуўся дар мовы."

# game/scripts/scene/scene_day_3.rpy:5265
translate belarusian day3_corner_fox_1d863ed1:

    # voice "voice/anton/3day/073 Ona.ogg"
    # Ant "Она? Кто «она»? Что тут творится?"
    voice "voice/anton/3day/073 Ona.ogg"
    Ant "Яна? Хто «яна»? Што тут творыцца?"

# game/scripts/scene/scene_day_3.rpy:5279
translate belarusian day3_corner_fox_e3062979:

    # "Рома хмыкнул, сдувая с цветов снежинки."
    "Рома хмыкнуў, здзьмухваючы з кветак сняжынкі."

# game/scripts/scene/scene_day_3.rpy:5280
translate belarusian day3_corner_fox_d79c4337:

    # voice "voice/romka/3day/09 Da.ogg"
    # Rom "Да, маленькая репетиция, братан."
    voice "voice/romka/3day/09 Da.ogg"
    Rom "Ды так, маленькая рэпетыцыя, братан."

# game/scripts/scene/scene_day_3.rpy:5282
translate belarusian day3_corner_fox_74c2daa9:

    # voice "voice/romka/3day/10 Ho.ogg"
    # Rom "Хотели на твою реакцию посмотреть."
    voice "voice/romka/3day/10 Ho.ogg"
    Rom "Хацелі на тваю рэакцыю паглядзець."

# game/scripts/scene/scene_day_3.rpy:5314
translate belarusian day3_corner_fox_800ceff3:

    # "Бяша встал, отряхиваясь."
    "Бяша ўстаў, абтрасаючыся."

# game/scripts/scene/scene_day_3.rpy:5317
translate belarusian day3_corner_fox_4b0d2aa7:

    # voice "voice/byasha/3day/142 Da.ogg"
    # Bya "Да Ромыч в тёлку одну втюрился."
    voice "voice/byasha/3day/142 Da.ogg"
    Bya "Ды Ромыч у цёлку адну ўцюрыўся."

# game/scripts/scene/scene_day_3.rpy:5321
translate belarusian day3_corner_fox_f8c28d6c:

    # voice "voice/byasha/3day/143 V.ogg"
    # Bya "Вон, откуда-то цветы нарыл, на."
    voice "voice/byasha/3day/143 V.ogg"
    Bya "Вунь, аднекуль кветкі нарыў, на."

# game/scripts/scene/scene_day_3.rpy:5326
translate belarusian day3_corner_fox_6b6c70d2:

    # voice "voice/romka/3day/11 Pa.ogg"
    # Rom "Пасть заткни!"
    voice "voice/romka/3day/11 Pa.ogg"
    Rom "Пашчу заткні!"

# game/scripts/scene/scene_day_3.rpy:5331
translate belarusian day3_corner_fox_34f568f3:

    # voice "voice/romka/3day/12Ya.ogg"
    # Rom "Я так... планирую подкатить слегка."
    voice "voice/romka/3day/12Ya.ogg"
    Rom "Я так... планую падкаціць злёгку."

# game/scripts/scene/scene_day_3.rpy:5336
translate belarusian day3_corner_fox_d52320f8:

    # voice "voice/romka/3day/13 Ra.ogg"
    # Rom "Разыграть представление, а то она неприступная, мать её за ногу."
    voice "voice/romka/3day/13 Ra.ogg"
    Rom "Разыграць спектакль, а то яна непрыступная, маць яе за нагу."

# game/scripts/scene/scene_day_3.rpy:5342
translate belarusian day3_corner_fox_1ab4bb1d:

    # voice "voice/romka/3day/14 Ti.ogg"
    # Rom "Типа гуляет девочка себе, а к ней докапывается такое вот говно."
    voice "voice/romka/3day/14 Ti.ogg"
    Rom "Тыпу гуляе дзяўчынка сабе, а да яе дакалупваецца такое вось гаўно."

# game/scripts/scene/scene_day_3.rpy:5348
translate belarusian day3_corner_fox_b5df61c6:

    # "Бяша обиженно заворчал."
    "Бяша пакрыўджана забурчаў."

# game/scripts/scene/scene_day_3.rpy:5351
translate belarusian day3_corner_fox_c07ab6a6:

    # voice "voice/byasha/3day/144 S.ogg"
    # Bya "Сам ты говно!"
    voice "voice/byasha/3day/144 S.ogg"
    Bya "Сам ты гаўно!"

# game/scripts/scene/scene_day_3.rpy:5356
translate belarusian day3_corner_fox_acdda043:

    # voice "voice/romka/3day/15 Nu.ogg"
    # Rom "Ну и я такой её – раз! – и спасаю!"
    voice "voice/romka/3day/15 Nu.ogg"
    Rom "Ну і я такі яе — раз! — і ратую!"

# game/scripts/scene/scene_day_3.rpy:5363
translate belarusian day3_corner_fox_ad806ef6:

    # voice "voice/romka/3day/16 No.ogg"
    # Rom "Но чёт Бяша совсем бездарный актёр."
    voice "voice/romka/3day/16 No.ogg"
    Rom "Але нешта Бяша зусім бяздарны акцёр."

# game/scripts/scene/scene_day_3.rpy:5368
translate belarusian day3_corner_fox_8c35158b:

    # voice "voice/romka/3day/17 Da.ogg"
    # Rom "Давай-ка ты маньяком будешь."
    voice "voice/romka/3day/17 Da.ogg"
    Rom "Давай-ка ты маньякам будзеш."

# game/scripts/scene/scene_day_3.rpy:5373
translate belarusian day3_corner_fox_cce0919e:

    # voice "voice/anton/3day/074 Ya.ogg"
    # Ant "Я?"
    voice "voice/anton/3day/074 Ya.ogg"
    Ant "Я?"

# game/scripts/scene/scene_day_3.rpy:5377
translate belarusian day3_corner_fox_50e67497:

    # voice "voice/romka/3day/18 Nu.ogg"
    # Rom "Ну а чё."
    voice "voice/romka/3day/18 Nu.ogg"
    Rom "Ну а што."

# game/scripts/scene/scene_day_3.rpy:5382
translate belarusian day3_corner_fox_9f76a0c8:

    # voice "voice/romka/3day/19 Kak.ogg"
    # Rom "Как по телеку показывали: маньяки вообще всегда тихие, скромные люди."
    voice "voice/romka/3day/19 Kak.ogg"
    Rom "Як па тэлеку паказвалі: маньякі наогул заўсёды ціхія, сціплыя людзі."

# game/scripts/scene/scene_day_3.rpy:5387
translate belarusian day3_corner_fox_ca74ddaa:

    # voice "voice/romka/3day/20 Vot.ogg"
    # Rom "Вот прям как ты."
    voice "voice/romka/3day/20 Vot.ogg"
    Rom "Вось прама як ты."

# game/scripts/scene/scene_day_3.rpy:5392
translate belarusian day3_corner_fox_6e24c8d7:

    # voice "voice/romka/3day/21 A.ogg"
    # Rom "А благодаря Катькиным сплетням все в школе думают, что именно ты Бабурина кокнул."
    voice "voice/romka/3day/21 A.ogg"
    Rom "А дзякуючы Кацькіным плёткам усе ў школе думаюць, што менавіта ты Бабурына кокнуў."

# game/scripts/scene/scene_day_3.rpy:5397
translate belarusian day3_corner_fox_27f4fdc0:

    # voice "voice/romka/3day/22 Da.ogg"
    # Rom "Давай, соглашайся, Тох."
    voice "voice/romka/3day/22 Da.ogg"
    Rom "Давай, пагаджайся, Тох."

# game/scripts/scene/scene_day_3.rpy:5401
translate belarusian day3_corner_fox_b4c686f4:

    # "От сердца отлегло. Никакого криминала — обычный театр, ещё и ради девочки."
    "Ад сэрца адлягло. Ніякага крыміналу — звычайны тэатр, яшчэ і дзеля дзяўчынкі."

# game/scripts/scene/scene_day_3.rpy:5402
translate belarusian day3_corner_fox_71a9cbfc:

    # voice "voice/anton/3day/075 A.ogg"
    # Ant "А что делать-то надо?"
    voice "voice/anton/3day/075 A.ogg"
    Ant "А што рабіць трэба?"

# game/scripts/scene/scene_day_3.rpy:5406
translate belarusian day3_corner_fox_3c68ca2e:

    # voice "voice/romka/3day/23 T.ogg"
    # Rom "Ты ж видел Бяшины кривляния?"
    voice "voice/romka/3day/23 T.ogg"
    Rom "Ты ж бачыў Бяшыны крыўлянні?"

# game/scripts/scene/scene_day_3.rpy:5411
translate belarusian day3_corner_fox_e8ce79fa:

    # voice "voice/romka/3day/24 Tip.ogg"
    # Rom "Тип, идёшь ко мне, борзый такой. Можешь разок в печень заехать."
    voice "voice/romka/3day/24 Tip.ogg"
    Rom "Тыпу, ідзеш да мяне, барзы такі. Можаш разок у печань заехаць."

# game/scripts/scene/scene_day_3.rpy:5424
translate belarusian day3_corner_fox_a50403f4:

    # voice "voice/romka/3day/25 A.ogg"
    # Rom "А я тебя, тип, херак, — и в сугроб."
    voice "voice/romka/3day/25 A.ogg"
    Rom "А я цябе, тыпу, херак — і ў сумёт."

# game/scripts/scene/scene_day_3.rpy:5428
translate belarusian day3_corner_fox_f9cf9e2d:

    # voice "voice/anton/3day/076.Nu.ogg"
    # Ant "Ну давайте попробуем."
    voice "voice/anton/3day/076.Nu.ogg"
    Ant "Ну давайце паспрабуем."

# game/scripts/scene/scene_day_3.rpy:5430
translate belarusian day3_corner_fox_6ec8fd7f:

    # "Рома оживился."
    "Рома ажывіўся."

# game/scripts/scene/scene_day_3.rpy:5450
translate belarusian day3_corner_fox_4c7ac33a:

    # voice "voice/romka/3day/26 O.ogg"
    # Rom "Отлично!"
    voice "voice/romka/3day/26 O.ogg"
    Rom "Выдатна!"

# game/scripts/scene/scene_day_3.rpy:5456
translate belarusian day3_corner_fox_5bed8b43:

    # voice "voice/romka/3day/27 B.ogg"
    # Rom "Бяша, меняешь пол. Ты теперь тёлочка."
    voice "voice/romka/3day/27 B.ogg"
    Rom "Бяша, мяняеш пол. Ты цяпер цёлачка."

# game/scripts/scene/scene_day_3.rpy:5463
translate belarusian day3_corner_fox_9cc4d024:

    # voice "voice/romka/3day/28 G.ogg"
    # Rom "Гуляй!"
    voice "voice/romka/3day/28 G.ogg"
    Rom "Гуляй!"

# game/scripts/scene/scene_day_3.rpy:5467
translate belarusian day3_corner_fox_de0afb38:

    # "Бяша зашаркал по двору, закривлялся."
    "Бяша зашаргаў па двары, закрыўляўся."

# game/scripts/scene/scene_day_3.rpy:5524
translate belarusian day3_corner_fox_26974d7c:

    # voice "voice/byasha/3day/145 Ya.ogg"
    # Bya "Я тёлочка, красивая тёлочка, я гуляю! Ля-ля-ля."
    voice "voice/byasha/3day/145 Ya.ogg"
    Bya "Я цёлачка, прыгожая цёлачка, я гуляю! Ля-ля-ля."

# game/scripts/scene/scene_day_3.rpy:5530
translate belarusian day3_corner_fox_50f170e0:

    # voice "voice/romka/3day/29 To.ogg"
    # Rom "Тоха, действуй."
    voice "voice/romka/3day/29 To.ogg"
    Rom "Тоха, дзейнічай."

# game/scripts/scene/scene_day_3.rpy:5569
translate belarusian day3_corner_fox_6b9cd3c5:

    # "Я, борясь с улыбкой, направился к Ромке."
    "Я, змагаючыся з усмешкай, накіраваўся да Ромкі."

# game/scripts/scene/scene_day_3.rpy:5570
translate belarusian day3_corner_fox_f7c96b54:

    # "Он опять спрятал руку и смотрел сурово. Актёрствовал на пять баллов."
    "Ён зноў схаваў руку і глядзеў сурова. Акцёрстваваў на пяць балаў."

# game/scripts/scene/scene_day_3.rpy:5571
translate belarusian day3_corner_fox_1c3e46ef:

    # voice "voice/anton/3day/077 Ona.ogg"
    # Ant "Она моя!"
    voice "voice/anton/3day/077 Ona.ogg"
    Ant "Яна мая!"

# game/scripts/scene/scene_day_3.rpy:5575
translate belarusian day3_corner_fox_936edeb9:

    # voice "voice/romka/3day/30 Ris.ogg"
    # Rom "Рискни!"
    voice "voice/romka/3day/30 Ris.ogg"
    Rom "Рызыкні!"

# game/scripts/scene/scene_day_3.rpy:5589
translate belarusian day3_corner_fox_582f54f6:

    # "Я рискнул — махнул в сторону друга. Костяшки кулака лишь скользнули по кожаной куртке, как Ромка внезапно упал."
    "Я рызыкнуў — махнуў у бок сябра. Костачкі кулака толькі слізганулі па скураной куртцы, як Ромка раптоўна ўпаў."

# game/scripts/scene/scene_day_3.rpy:5590
translate belarusian day3_corner_fox_8792404c:

    # "Не от шутливого тычка, конечно, а поскользнувшись на льду."
    "Не ад жартаўлівага штуршка, вядома, а паслізнуўшыся на лёдзе."

# game/scripts/scene/scene_day_3.rpy:5605
translate belarusian day3_corner_fox_76c4b8e5:

    # "Хлопнулся всем весом, так и не убрав руку из-под тела."
    "Хлопнуўся ўсёй вагой, так і не прыбраўшы руку з-пад цела."

# game/scripts/scene/scene_day_3.rpy:5609
translate belarusian day3_corner_fox_509e2bd0:

    # "Лепестки примятых бутонов остались на снегу."
    "Пялёсткі прымятых бутонаў засталіся на снезе."

# game/scripts/scene/scene_day_3.rpy:5610
translate belarusian day3_corner_fox_d25362aa:

    # "Я кинулся на помощь."
    "Я кінуўся на дапамогу."

# game/scripts/scene/scene_day_3.rpy:5624
translate belarusian day3_corner_fox_32c05105:

    # voice "voice/romka/3day/32 Oi.ogg"
    # Rom "Ой, бля... Да погоди ты, не дёргай."
    voice "voice/romka/3day/32 Oi.ogg"
    Rom "Ой, бля... Ды пачакай ты, не тузай."

# game/scripts/scene/scene_day_3.rpy:5629
translate belarusian day3_corner_fox_33596420:

    # voice "voice/anton/3day/078 N.ogg"
    # Ant "Не сломал?"
    voice "voice/anton/3day/078 N.ogg"
    Ant "Не зламаў?"

# game/scripts/scene/scene_day_3.rpy:5632
translate belarusian day3_corner_fox_cecbc0c2:

    # "Рома осторожно разминал запястье."
    "Рома асцярожна расціраў запясце."

# game/scripts/scene/scene_day_3.rpy:5635
translate belarusian day3_corner_fox_7972a3da:

    # voice "voice/romka/3day/33 Ta.ogg"
    # Rom "Та не. Ушиб вроде."
    voice "voice/romka/3day/33 Ta.ogg"
    Rom "Ды не. Выцяў быццам."

# game/scripts/scene/scene_day_3.rpy:5639
translate belarusian day3_corner_fox_1d27cf23:

    # voice "voice/byasha/3day/146 L.ogg"
    # Bya "Лёд приложить нужно, на."
    voice "voice/byasha/3day/146 L.ogg"
    Bya "Лёд прыкласці трэба, на."

# game/scripts/scene/scene_day_3.rpy:5645
translate belarusian day3_corner_fox_f403cbda:

    # voice "voice/romka/3day/34 Te.ogg"
    # Rom "Тебя, мудака, приложить нужно..."
    voice "voice/romka/3day/34 Te.ogg"
    Rom "Цябе, мудака, прыкласці трэба..."

# game/scripts/scene/scene_day_3.rpy:5650
translate belarusian day3_corner_fox_fd7d4750:

    # voice "voice/romka/3day/35 O.ogg"
    # Rom "О стенку башкой."
    voice "voice/romka/3day/35 O.ogg"
    Rom "Аб сценку башкай."

# game/scripts/scene/scene_day_3.rpy:5677
translate belarusian day3_corner_fox_06560567:

    # "Ромка встал, уже посмеиваясь, собрал цветы."
    "Ромка ўстаў, ужо пасмейваючыся, сабраў кветкі."

# game/scripts/scene/scene_day_3.rpy:5681
translate belarusian day3_corner_fox_4f0a95c9:

    # voice "voice/romka/3day/37 d.ogg"
    # Rom "М-да, если я так при подруге навернусь — можно будет про неё забыть."
    voice "voice/romka/3day/37 d.ogg"
    Rom "М-да, калі я так пры сяброўцы навярнуся — можна будзе пра яе забыцца."

# game/scripts/scene/scene_day_3.rpy:5686
translate belarusian day3_corner_fox_5244e143:

    # voice "voice/anton/3day/079 Da.ogg"
    # Ant "Давай ещё раз отрепетируем."
    voice "voice/anton/3day/079 Da.ogg"
    Ant "Давай яшчэ раз адрэпеціруем."

# game/scripts/scene/scene_day_3.rpy:5688
translate belarusian day3_corner_fox_5023da74:

    # "Рома мотнул головой."
    "Рома крутнуў галавой."

# game/scripts/scene/scene_day_3.rpy:5691
translate belarusian day3_corner_fox_2a5bf464:

    # voice "voice/romka/3day/38 V.ogg"
    # Rom "Вечером, как рука пройдёт."
    voice "voice/romka/3day/38 V.ogg"
    Rom "Увечары, як рука пройдзе."

# game/scripts/scene/scene_day_3.rpy:5696
translate belarusian day3_corner_fox_1691b0fb:

    # voice "voice/romka/3day/39 N.ogg"
    # Rom "Не хочу опозориться перед первой скрипкой школы."
    voice "voice/romka/3day/39 N.ogg"
    Rom "Не хачу апаганіцца перад першай скрыпкай школы."

# game/scripts/scene/scene_day_3.rpy:5701
translate belarusian day3_corner_fox_3debf21b:

    # voice "voice/anton/3day/080 Dog.ogg"
    # Ant "Догово..."
    voice "voice/anton/3day/080 Dog.ogg"
    Ant "Дамов..."

# game/scripts/scene/scene_day_3.rpy:5704
translate belarusian day3_corner_fox_7ef34a77:

    # "Я осёкся на полуслове."
    "Я асекся на паўслове."

# game/scripts/scene/scene_day_3.rpy:5705
translate belarusian day3_corner_fox_cb9f1aea:

    # "В голове щёлкнул рубильник, и всё встало на свои места."
    "У галаве шчоўкнуў рубільнік, і ўсё стала на свае месцы."

# game/scripts/scene/scene_day_3.rpy:5706
translate belarusian day3_corner_fox_8d89cc2c:

    # "Я вспомнил беглые взоры, которые Ромка посылал Полине."
    "Я ўзгадаў хуткія позіркі, якія Ромка пасылаў Паліне."

# game/scripts/scene/scene_day_3.rpy:5707
translate belarusian day3_corner_fox_5b7a04cd:

    # "Вспомнил его каракули в анкете: и почему я не удосужился как следует изучить их?"
    "Узгадаў яго крамзолі ў анкеце: і чаму я не захацеў як след вывучыць іх?"

# game/scripts/scene/scene_day_3.rpy:5708
translate belarusian day3_corner_fox_68075fe5:

    # "Меня будто молотом огрели, вколотили в землю."
    "Мяне быццам молатам агрэлі, убілі ў зямлю."

# game/scripts/scene/scene_day_3.rpy:5709
translate belarusian day3_corner_fox_e88f3890:

    # "Полина. Вот главный герой спектакля, срежиссированного Ромкой."
    "Паліна. Вось галоўны герой спектакля, зрэжысіраванага Ромкам."

# game/scripts/scene/scene_day_3.rpy:5710
translate belarusian day3_corner_fox_2b0a2a03:

    # "А мне в нём досталась роль третьего лишнего."
    "А мне ў ім дасталася роля трэцяга лішняга."

# game/scripts/scene/scene_day_3.rpy:5711
translate belarusian day3_corner_fox_ac9b0a89:

    # "Я рассеяно брякнул:"
    "Я рассеяна бразнуў:"

# game/scripts/scene/scene_day_3.rpy:5712
translate belarusian day3_corner_fox_f4203830:

    # voice "voice/anton/3day/081D.ogg"
    # Ant "Договорились."
    voice "voice/anton/3day/081D.ogg"
    Ant "Дамовіліся."

# game/scripts/scene/scene_day_3.rpy:5716
translate belarusian day3_corner_fox_bba059f1:

    # voice "voice/romka/3day/40 V.ogg"
    # Rom "Вот это я понимаю – команда Вольтрона!"
    voice "voice/romka/3day/40 V.ogg"
    Rom "Вось гэта я разумею — каманда Вальтрона!"

# game/scripts/scene/scene_day_3.rpy:5722
translate belarusian day3_corner_fox_da76c484:

    # voice "voice/romka/3day/41 Od.ogg"
    # Rom "Один за всех..."
    voice "voice/romka/3day/41 Od.ogg"
    Rom "Адзін за ўсіх..."

# game/scripts/scene/scene_day_3.rpy:5728
translate belarusian day3_corner_fox_083063b0:

    # voice "voice/byasha/3day/147 I.ogg"
    # Bya "... и все на одного!"
    voice "voice/byasha/3day/147 I.ogg"
    Bya "... і ўсе на аднаго!"

# game/scripts/scene/scene_day_3.rpy:5734
translate belarusian day3_corner_fox_15d75673:

    # voice "voice/romka/3day/42 Z.ogg"
    # Rom "Захлопни!"
    voice "voice/romka/3day/42 Z.ogg"
    Rom "Заткніся!"

# game/scripts/scene/scene_day_3.rpy:5742
translate belarusian day3_corner_fox_4c917114:

    # voice "voice/romka/3day/43 E.ogg"
    # Rom "Если вдруг тебе понадобится помощь, Антоха, — можешь рассчитывать на меня."
    voice "voice/romka/3day/43 E.ogg"
    Rom "Калі раптам табе спатрэбіцца дапамога, Антоха, — можаш разлічваць на мяне."

# game/scripts/scene/scene_day_3.rpy:5751
translate belarusian day3_corner_fox_b59b9041:

    # voice "voice/romka/3day/44 A.ogg"
    # Rom "А теперь бывай!"
    voice "voice/romka/3day/44 A.ogg"
    Rom "А цяпер бывай!"

# game/scripts/scene/scene_day_3.rpy:5756
translate belarusian day3_corner_fox_b60697b1:

    # voice "voice/romka/3day/45 V.ogg"
    # Rom "Вечером мы к тебе заглянем."
    voice "voice/romka/3day/45 V.ogg"
    Rom "Увечары мы да цябе зазірнем."

# game/scripts/scene/scene_day_3.rpy:5802
translate belarusian day3_corner_notfox_61086ba3:

    # voice "voice/byasha/3day/148 S.ogg"
    # Bya "Слыш, хорош лыбу тянуть!"
    voice "voice/byasha/3day/148 S.ogg"
    Bya "Чуеш, хопіць лыбу цягнуць!"

# game/scripts/scene/scene_day_3.rpy:5808
translate belarusian day3_corner_notfox_1704b999:

    # "Улыбка скукожилась на задеревеневших губах."
    "Усмешка скурчылася на здранцвелых вуснах."

# game/scripts/scene/scene_day_3.rpy:5810
translate belarusian day3_corner_notfox_9d3571b2:

    # "Бяша топтался в центре двора, ботинки нетерпеливо елозили по льду."
    "Бяша таптаўся ў цэнтры двара, чаравікі нецярпліва соўгаліся па лёдзе."

# game/scripts/scene/scene_day_3.rpy:5811
translate belarusian day3_corner_notfox_6af2c672:

    # voice "voice/anton/3day/082 Ya.ogg"
    # Ant "Я не тяну."
    voice "voice/anton/3day/082 Ya.ogg"
    Ant "Я не цягну."

# game/scripts/scene/scene_day_3.rpy:5822
translate belarusian day3_corner_notfox_df2b68fa:

    # "Попробовал обойти его — как же!"
    "Паспрабаваў абысці яго — дзе там!"

# game/scripts/scene/scene_day_3.rpy:5823
translate belarusian day3_corner_notfox_360f357a:

    # "Фортуна помахала ручкой, сгинув в ранних сумерках."
    "Фартуна памахала ручкай, знікнуўшы ў раннім змроку."

# game/scripts/scene/scene_day_3.rpy:5825
translate belarusian day3_corner_notfox_99447d0e:

    # voice "voice/byasha/3day/149 To.ogg"
    # Bya "Торопишься, на?"
    voice "voice/byasha/3day/149 To.ogg"
    Bya "Спяшаешся, на?"

# game/scripts/scene/scene_day_3.rpy:5828
translate belarusian day3_corner_notfox_2050b82c:

    # voice "voice/anton/3day/083 N.ogg"
    # Ant "Немного. Меня папа ждёт."
    voice "voice/anton/3day/083 N.ogg"
    Ant "Крыху. Мяне тата чакае."

# game/scripts/scene/scene_day_3.rpy:5832
translate belarusian day3_corner_notfox_bfd2ed86:

    # voice "voice/byasha/3day/150 Ya.ogg"
    # Bya "Я ему чиркну на {u}пейджер{/u}, что ты не придёшь, на."
    voice "voice/byasha/3day/150 Ya.ogg"
    Bya "Я яму чыркну на {u}пэйджар{/u}, што ты не прыйдзеш, на."

# game/scripts/scene/scene_day_3.rpy:5835
translate belarusian day3_corner_notfox_4e20cfc8:

    # "Глаз непроизвольно дёрнулся. Взмокла кожа."
    "Вока міжволі тузанулася. Узмакрэла скура."

# game/scripts/scene/scene_day_3.rpy:5837
translate belarusian day3_corner_notfox_0fe81a55:

    # voice "voice/byasha/3day/151 Ed.ogg"
    # Bya "Идём, на. К тебе дельце есть."
    voice "voice/byasha/3day/151 Ed.ogg"
    Bya "Хадзем, на. Да цябе спраўка ёсць."

# game/scripts/scene/scene_day_3.rpy:5850
translate belarusian day3_corner_notfox_b213b01e:

    # "Я почувствовал холодок за пазухой."
    "Я адчуў халадок за пазухай."

# game/scripts/scene/scene_day_3.rpy:5863
translate belarusian day3_corner_notfox_df66faee:

    # "Больно не понравилось слово «дельце»."
    "Надта не спадабалася слова «спраўка»."

# game/scripts/scene/scene_day_3.rpy:5864
translate belarusian day3_corner_notfox_ceec2a79:

    # "За этим словом, произнесённым вот так, через плевок, обычно скрывались разные тёмные штуки."
    "За гэтым словам, вымаўленым вось так, праз плявок, звычайна хаваліся розныя цёмныя штукі."

# game/scripts/scene/scene_day_3.rpy:5865
translate belarusian day3_corner_notfox_fc4bf575:

    # "Так говорили незнакомцы, звоня нам в старую квартиру по телефону: «Батю позови, дельце есть»."
    "Так казалі незнаёмцы, тэлефануючы нам у старую кватэру: «Бацю пакліч, спраўка ёсць»."

# game/scripts/scene/scene_day_3.rpy:5879
translate belarusian day3_corner_notfox_2ed09bd9:

    # "Бяша обернулся: в облегающем капюшоне он был похож на космонавта."
    "Бяша абярнуўся: у аблягаючым капюшоне ён быў падобны на касманаўта."

# game/scripts/scene/scene_day_3.rpy:5880
translate belarusian day3_corner_notfox_63d6cecd:

    # "Если бы он был бы звуком, то, скорее всего, пронзительным свистом, сигналом того, кто сторожит на шухере."
    "Калі б ён быў гукам, то, хутчэй за ўсё, пранізлівым свістам, сігналам таго, хто пільнуе на шухеры."

# game/scripts/scene/scene_day_3.rpy:5882
translate belarusian day3_corner_notfox_b88cb265:

    # "На заднем дворе, как назло, никого не было."
    "На заднім двары, як на злосць, нікога не было."

# game/scripts/scene/scene_day_3.rpy:5906
translate belarusian day3_corner_notfox_c0858647:

    # "Никого, кроме мрачного Ромки."
    "Нікога, акрамя змрочнага Ромкі."

# game/scripts/scene/scene_day_3.rpy:5907
translate belarusian day3_corner_notfox_02bbfa4d:

    # "Он стоял, широко раздвинув ноги ,правая рука была спрятана за спину."
    "Ён стаяў, шырока расставіўшы ногі, правая рука была схавана за спіну."

# game/scripts/scene/scene_day_3.rpy:5908
translate belarusian day3_corner_notfox_9fa11c47:

    # "Сухие губы плотно сжаты, глаза стреляют то в меня, то по сторонам."
    "Сухія вусны шчыльна сціснуты, вочы страляюць то ў мяне, то па баках."

# game/scripts/scene/scene_day_3.rpy:5911
translate belarusian day3_corner_notfox_bbb85dc9:

    # "Я всей душой надеялся, что Ромка не видел нас с Полиной вместе."
    "Я ўсёй душой спадзяваўся, што Ромка не бачыў нас з Палінай разам."

# game/scripts/scene/scene_day_3.rpy:5928
translate belarusian day3_corner_notfox_65a4dec4:

    # voice "voice/byasha/3day/152 Pri.ogg"
    # Bya "Привёл, на."
    voice "voice/byasha/3day/152 Pri.ogg"
    Bya "Прывёў, на."

# game/scripts/scene/scene_day_3.rpy:5935
translate belarusian day3_corner_notfox_0aa923e8:

    # voice "voice/romka/3day/46 Vi.ogg"
    # Rom "Вижу."
    voice "voice/romka/3day/46 Vi.ogg"
    Rom "Бачу."

# game/scripts/scene/scene_day_3.rpy:5943
translate belarusian day3_corner_notfox_18840639:

    # voice "voice/romka/3day/47 Nu.ogg"
    # Rom "Ну здорово, Антоша!"
    voice "voice/romka/3day/47 Nu.ogg"
    Rom "Ну здарова, Антоша!"

# game/scripts/scene/scene_day_3.rpy:5951
translate belarusian day3_corner_notfox_a9677707:

    # voice "voice/anton/3day/084 Ch.ogg"
    # Ant "Что тебе нужно?"
    voice "voice/anton/3day/084 Ch.ogg"
    Ant "Што табе трэба?"

# game/scripts/scene/scene_day_3.rpy:5962
translate belarusian day3_corner_notfox_241fc610:

    # "Он медленно извлёк из-за спины узкое, хищно блестящее лезвие."
    "Ён павольна дастаў з-за спіны вузкае, драпежна бліскучае лязо."

# game/scripts/scene/scene_day_3.rpy:5963
translate belarusian day3_corner_notfox_426e4a18:

    # "Нож – стальная бабочка смерти, летящая на стук сердца."
    "Нож — сталёвы матылёк смерці, які ляціць на стук сэрца."

# game/scripts/scene/scene_day_3.rpy:5978
translate belarusian day3_corner_notfox_83b76614:

    # "Я инстинктивно отпрянул и врезался в Бяшу. Ромкина шестёрка подтолкнула меня обратно."
    "Я інстынктыўна адскочыў і ўрэзаўся ў Бяшу. Ромкіна шасцёрка падштурхнула мяне назад."

# game/scripts/scene/scene_day_3.rpy:5981
translate belarusian day3_corner_notfox_533af75f:

    # voice "voice/romka/3day/48 Am.ogg"
    # Rom "А мы с Бяшей хотели узнать..."
    voice "voice/romka/3day/48 Am.ogg"
    Rom "А мы з Бяшам хацелі даведацца..."

# game/scripts/scene/scene_day_3.rpy:5985
translate belarusian day3_corner_notfox_76a38d7a:

    # voice "voice/romka/3day/49 T.ogg"
    # Rom "Ты не держишь на нас обиду?" id day3_corner_notfox_76a38d7a
    voice "voice/romka/3day/49 T.ogg"
    Rom "Ты не трымаеш на нас крыўду?" id day3_corner_notfox_76a38d7a

# game/scripts/scene/scene_day_3.rpy:5989
translate belarusian day3_corner_notfox_1788547f:

    # "Ромка принялся ковырять жёлтый ноготь, с коварной усмешкой уставившись на меня."
    "Ромка пачаў калупаць жоўты пазногаць, з падступнай усмешкай уставіўшыся на мяне."

# game/scripts/scene/scene_day_3.rpy:5991
translate belarusian day3_corner_notfox_44223f11:

    # voice "voice/romka/3day/50 Nu.ogg"
    # Rom "Ну, там, в лесу... мы были немного грубы с тобой."
    voice "voice/romka/3day/50 Nu.ogg"
    Rom "Ну, там, у лесе... мы былі крыху грубыя з табой."

# game/scripts/scene/scene_day_3.rpy:5998
translate belarusian day3_corner_notfox_b07911b6:

    # voice "voice/byasha/3day/153 Sa A.ogg"
    # Bya "Сам понимаешь, такое у нас воспитание, на." id day3_corner_notfox_b07911b6
    voice "voice/byasha/3day/153 Sa A.ogg"
    Bya "Сам разумееш, такое ў нас выхаванне, на." id day3_corner_notfox_b07911b6

# game/scripts/scene/scene_day_3.rpy:6002
translate belarusian day3_corner_notfox_9542c3e3:

    # voice "voice/romka/3day/51 D.ogg"
    # Rom "Да, до вас, городских, далеко."
    voice "voice/romka/3day/51 D.ogg"
    Rom "Так, да вас, гарадскіх, далёка."

# game/scripts/scene/scene_day_3.rpy:6006
translate belarusian day3_corner_notfox_8fbc3731:

    # voice "voice/romka/3day/52 V.ogg"
    # Rom "Вот порой нас и заносит."
    voice "voice/romka/3day/52 V.ogg"
    Rom "Вось часам нас і заносіць."

# game/scripts/scene/scene_day_3.rpy:6009
translate belarusian day3_corner_notfox_da25c980:

    # "Я кивнул, глядя на нож."
    "Я кіўнуў, гледзячы на нож."

# game/scripts/scene/scene_day_3.rpy:6013
translate belarusian day3_corner_notfox_078f5aca:

    # voice "voice/romka/3day/53 Sk.ogg"
    # Rom "Скажи, Антоша..."
    voice "voice/romka/3day/53 Sk.ogg"
    Rom "Скажы, Антоша..."

# game/scripts/scene/scene_day_3.rpy:6017
translate belarusian day3_corner_notfox_c9a58729:

    # voice "voice/romka/3day/54 Y.ogg"
    # Rom "Я тебя в последний раз не сильно огрел?"
    voice "voice/romka/3day/54 Y.ogg"
    Rom "Я цябе ў апошні раз не моцна агрэў?"

# game/scripts/scene/scene_day_3.rpy:6020
translate belarusian day3_corner_notfox_5526c225:

    # voice "voice/anton/3day/085 Da.ogg"
    # Ant "Да нет..."
    voice "voice/anton/3day/085 Da.ogg"
    Ant "Ды не..."

# game/scripts/scene/scene_day_3.rpy:6023
translate belarusian day3_corner_notfox_52fd82ce:

    # voice "voice/romka/3day/55 Nu.ogg"
    # Rom "Ну и славно!"
    voice "voice/romka/3day/55 Nu.ogg"
    Rom "Ну і слаўна!"

# game/scripts/scene/scene_day_3.rpy:6027
translate belarusian day3_corner_notfox_8377ba9e:

    # voice "voice/romka/3day/55 A.ogg"
    # Rom "А то я затревожился, что память тебе отбил. И ты запамятовал, о чём тебе втолковывали."
    voice "voice/romka/3day/55 A.ogg"
    Rom "А то я занепакоіўся, што памяць табе адбіў. І ты запамятаваў, пра што табе ўтлумачвалі."

# game/scripts/scene/scene_day_3.rpy:6030
translate belarusian day3_corner_notfox_ebe1bf81:

    # voice "voice/anton/3day/086 Ya.ogg"
    # Ant "Я помню."
    voice "voice/anton/3day/086 Ya.ogg"
    Ant "Я памятаю."

# game/scripts/scene/scene_day_3.rpy:6033
translate belarusian day3_corner_notfox_c31e4a40:

    # "Лезвие переливалось в закатном свете. И так же зло переливались зрачки Ромки."
    "Лязо пералівалася ў закатным святле. І гэтак жа зло пераліваліся зрэнкі Ромкі."

# game/scripts/scene/scene_day_3.rpy:6063
translate belarusian day3_corner_notfox_fa709f8b:

    # "Он шагнул ко мне."
    "Ён ступіў да мяне."

# game/scripts/scene/scene_day_3.rpy:6074
translate belarusian day3_corner_notfox_1c77e194:

    # "Поводил ножом в сантиметре от куртки."
    "Павадзіў нажом за сантыметр ад курткі."

# game/scripts/scene/scene_day_3.rpy:6075
translate belarusian day3_corner_notfox_47f9235a:

    # "Одно движение — и сталь вспорет ткань. А если надавить глубже..."
    "Адзін рух — і сталь распароць тканіну. А калі націснуць глыбей..."

# game/scripts/scene/scene_day_3.rpy:6086
translate belarusian day3_corner_notfox_effd6812:

    # voice "voice/romka/3day/56 Na.ogg"
    # Rom "Нам одна птичка напела, что ты опять возле Полины отирался."
    voice "voice/romka/3day/56 Na.ogg"
    Rom "Нам адна птушка напела, што ты зноў каля Паліны аціраўся."

# game/scripts/scene/scene_day_3.rpy:6089
translate belarusian day3_corner_notfox_74e222c2:

    # "Страшно было так, что я не сразу понял, кто такая Полина."
    "Страшна было так, што я не адразу зразумеў, хто такая Паліна."

# game/scripts/scene/scene_day_3.rpy:6090
translate belarusian day3_corner_notfox_bbf35f3f:

    # "Мозг сбоил. Колени тряслись."
    "Мозг збоіў. Калені трэсліся."

# game/scripts/scene/scene_day_3.rpy:6104
translate belarusian day3_corner_notfox_03a6a262:

    # "Вдруг позади Ромки неспешной походкой прошла наша староста."
    "Раптам ззаду Ромкі неспяшанай хадой прайшла наша стараста."

# game/scripts/scene/scene_day_3.rpy:6106
translate belarusian day3_corner_notfox_08ded944:

    # voice "voice/kate/106 KA.ogg"
    # Kate "О, смотрю, мальчики, вы нашли общий язык."
    voice "voice/kate/106 KA.ogg"
    Kate "О, гляджу, хлопчыкі, вы знайшлі агульную мову."

# game/scripts/scene/scene_day_3.rpy:6111
translate belarusian day3_corner_notfox_65fd4ddd:

    # voice "voice/romka/3day/57 Z.ogg"
    # Rom "За мной должок, Катька."
    voice "voice/romka/3day/57 Z.ogg"
    Rom "За мной даўжок, Кацька."

# game/scripts/scene/scene_day_3.rpy:6116
translate belarusian day3_corner_notfox_65d089b7:

    # voice "voice/kate/107 KA.ogg"
    # Kate "Ой, не благодари, Ромочка. Я всегда на страже настоящей любви!"
    voice "voice/kate/107 KA.ogg"
    Kate "Ой, не дзякуй, Ромачка. Я заўсёды на варце сапраўднага кахання!"

# game/scripts/scene/scene_day_3.rpy:6127
translate belarusian day3_corner_notfox_bf1e6e65:

    # voice "voice/kate/108 KA.ogg"
    # Kate "Да-да-да!"
    voice "voice/kate/108 KA.ogg"
    Kate "Так-так-так!"

# game/scripts/scene/scene_day_3.rpy:6143
translate belarusian day3_corner_notfox_2d65523d:

    # "«{i}Клянусь, я убью тебя!{/i}»"
    "«{i}Клянуся, я заб'ю цябе!{/i}»"

# game/scripts/scene/scene_day_3.rpy:6145
translate belarusian day3_corner_notfox_3c7fb579:

    # voice "voice/romka/3day/58 T.ogg"
    # Rom "Так, я не слышу: ты к Полине подходил или нет?"
    voice "voice/romka/3day/58 T.ogg"
    Rom "Дык, я не чую: ты да Паліны падыходзіў ці не?"

# game/scripts/scene/scene_day_3.rpy:6148
translate belarusian day3_corner_notfox_77f5282f:

    # voice "voice/anton/3day/087 M.ogg"
    # Ant "Мы... так... болтали."
    voice "voice/anton/3day/087 M.ogg"
    Ant "Мы... так... балбаталі."

# game/scripts/scene/scene_day_3.rpy:6151
translate belarusian day3_corner_notfox_d37ed9dc:

    # voice "voice/romka/3day/59 B.ogg"
    # Rom "Болтать будешь кишками, когда я тебе брюхо вскрою."
    voice "voice/romka/3day/59 B.ogg"
    Rom "Балбатаць будзеш кішкамі, калі я табе пуза ўскрою."

# game/scripts/scene/scene_day_3.rpy:6155
translate belarusian day3_corner_notfox_7e9921e7:

    # "Лезвие плашмя прошлось по моему рукаву вверх и достало до воротника."
    "Лязо плазам прайшлося па маім рукаве ўверх і дастала да каўняра."

# game/scripts/scene/scene_day_3.rpy:6156
translate belarusian day3_corner_notfox_c59eb11f:

    # "Ветер остужал лицо, но струйка пота стекла по виску."
    "Вецер астуджаў твар, але струменьчык поту сцёк па скроні."

# game/scripts/scene/scene_day_3.rpy:6162
translate belarusian day3_corner_notfox_65c1c71b:

    # "Вдруг в голове щёлкнул рубильник, и всё встало на свои места."
    "Раптам у галаве шчоўкнуў рубільнік, і ўсё стала на свае месцы."

# game/scripts/scene/scene_day_3.rpy:6163
translate belarusian day3_corner_notfox_8d89cc2c:

    # "Я вспомнил беглые взоры, которые Ромка посылал Полине."
    "Я ўзгадаў хуткія позіркі, якія Ромка пасылаў Паліне."

# game/scripts/scene/scene_day_3.rpy:6164
translate belarusian day3_corner_notfox_c28b16cc:

    # "Вспомнил его каракули в анкете – и почему я не удосужился как следует изучить их?"
    "Узгадаў яго крамзолі ў анкеце — і чаму я не захацеў як след вывучыць іх?"

# game/scripts/scene/scene_day_3.rpy:6166
translate belarusian day3_corner_notfox_e4be2bd4:

    # voice "voice/romka/3day/60 Ese.ogg"
    # Rom "Ещё раз замечу рядом с Полинкой – пеняй на себя. Шишкой не отделаешься."
    voice "voice/romka/3day/60 Ese.ogg"
    Rom "Яшчэ раз заўважу побач з Палінкай — наракай на сябе. Гузам не адбудзешся."

# game/scripts/scene/scene_day_3.rpy:6170
translate belarusian day3_corner_notfox_bc73088f:

    # voice "voice/romka/3day/60 Us.ogg"
    # Rom "Усёк?"
    voice "voice/romka/3day/60 Us.ogg"
    Rom "Усёк?"

# game/scripts/scene/scene_day_3.rpy:6179
translate belarusian day3_corner_notfox_4c776fe7:

    # voice "voice/anton/3day/089 Da_l.ogg"
    # Ant "Да."
    voice "voice/anton/3day/089 Da_l.ogg"
    Ant "Так."

# game/scripts/scene/scene_day_3.rpy:6183
translate belarusian day3_corner_notfox_39bdd3be:

    # voice "voice/romka/3day/61 P.ogg"
    # Rom "Пшёл вон!"
    voice "voice/romka/3day/61 P.ogg"
    Rom "Пайшоў вон!"

# game/scripts/scene/scene_day_3.rpy:6185
translate belarusian day3_corner_notfox_ce06fcac:

    # "Вероятно, я был так загипнотизирован ножом, что Роме пришлось повторить."
    "Верагодна, я быў так загіпнатызаваны нажом, што Роме давялося паўтарыць."

# game/scripts/scene/scene_day_3.rpy:6212
translate belarusian day3_corner_notfox_c7648417:

    # voice "voice/romka/3day/62 Von.ogg"
    # Rom "Вон!"
    voice "voice/romka/3day/62 Von.ogg"
    Rom "Вон!"

# game/scripts/scene/scene_day_3.rpy:6233
translate belarusian day3_corner_notfox_f3fe10a1:

    # "Ретируясь с площадки, я думал о холодном остро заточенном металле."
    "Рэціруючыся з пляцоўкі, я думаў пра халодны востра наточаны метал."

# game/scripts/scene/scene_day_3.rpy:6234
translate belarusian day3_corner_notfox_63d8c126:

    # "И спрашивал себя, хватит ли мне духа нарушить данное ублюдкам слово."
    "І пытаўся сябе, ці хопіць мне духу парушыць дадзенае выблюдкам слова."

# game/scripts/scene/scene_day_3.rpy:6243
translate belarusian day3_corner_notfox_bf9a99af:

    # voice "voice/romka/3day/63Na.ogg"
    # Rom "Наверное, мне надо объяснить так, чтобы ты понял..."
    voice "voice/romka/3day/63Na.ogg"
    Rom "Напэўна, мне трэба растлумачыць так, каб ты зразумеў..."

# game/scripts/scene/scene_day_3.rpy:6249
translate belarusian day3_corner_notfox_b7c0da96:

    # "Рукояти и клинок завертелись в опасной пляске, как лопасти вертолёта, сметающие всё на своём пути."
    "Рукаяці і клінок закруціліся ў небяспечным танцы, як лопасці верталёта, якія змятаюць усё на сваім шляху."

# game/scripts/scene/scene_day_3.rpy:6255
translate belarusian day3_corner_notfox_1e7aae31:

    # "Я попытался увернуться, как тут же бритвенно-острый наконечник спикировал в моё плечо."
    "Я паспрабаваў ухіліцца, як тут жа востры як брытва наканечнік спікіраваў у маё плячо."

# game/scripts/scene/scene_day_3.rpy:6260
translate belarusian day3_corner_notfox_7f511f95:

    # "Шокированный, я видел, как нож с рвущимся треском погружается в меня, заполняя образовавшуюся канавку кровью."
    "Шакаваны, я бачыў, як нож з рвучым трэскам пагружаецца ў мяне, запаўняючы ўтвораную канаўку крывёю."

# game/scripts/scene/scene_day_3.rpy:6261
translate belarusian day3_corner_notfox_643a22f4:

    # "Адреналина уже было недостаточно, и пронзающая боль вырвалась из меня жалобным криком."
    "Адрэналіну ўжо было недастаткова, і пранізлівы боль вырваўся з мяне жаласным крыкам."

# game/scripts/scene/scene_day_3.rpy:6262
translate belarusian day3_corner_notfox_710b49b7:

    # voice "voice/anton/3day/088 AAAAAA.ogg"
    # Ant "А-а-а-а-а-а-а-а!"
    voice "voice/anton/3day/088 AAAAAA.ogg"
    Ant "А-а-а-а-а-а-а-а!"

# game/scripts/scene/scene_day_3.rpy:6273
translate belarusian day3_corner_notfox_4a9f0bea:

    # "Ромка грубо вытащил нож и я, зажав кровоточащую рану, бросился прочь без оглядки."
    "Ромка груба выцягнуў нож, і я, заціснуўшы крывацечную рану, кінуўся прэч без аглядкі."

# game/scripts/scene/scene_day_3.rpy:6287
translate belarusian day3_corner_notfox_91ef1037:

    # voice "voice/romka/3day/65 Po.ogg"
    # Rom "Попробуй ещё раз позабудь!"
    voice "voice/romka/3day/65 Po.ogg"
    Rom "Паспрабуй яшчэ раз забудзь!"

# game/scripts/scene/scene_day_3.rpy:6290
translate belarusian day3_corner_notfox_ace03eb1:

    # voice "voice/romka/3day/66 Ant.ogg"
    # Rom "Антоша!"
    voice "voice/romka/3day/66 Ant.ogg"
    Rom "Антоша!"

# game/scripts/scene/scene_day_3.rpy:6300
translate belarusian day3_corner_notfox_bf9a99af_1:

    # voice "voice/romka/3day/63Na.ogg"
    # Rom "Наверное, мне надо объяснить так, чтобы ты понял..."
    voice "voice/romka/3day/63Na.ogg"
    Rom "Напэўна, мне трэба растлумачыць так, каб ты зразумеў..."

# game/scripts/scene/scene_day_3.rpy:6307
translate belarusian day3_corner_notfox_b7c0da96_1:

    # "Рукояти и клинок завертелись в опасной пляске, как лопасти вертолёта, сметающие всё на своём пути."
    "Рукаяці і клінок закруціліся ў небяспечным танцы, як лопасці верталёта, якія змятаюць усё на сваім шляху."

# game/scripts/scene/scene_day_3.rpy:6315
translate belarusian day3_corner_notfox_a84d6691:

    # "Я попытался увернуться, но, сделав шаг назад, поскользнулся и грохнулся на пятую точку."
    "Я паспрабаваў ухіліцца, але, зрабіўшы крок назад, паслізнуўся і грымнуўся на пятую кропку."

# game/scripts/scene/scene_day_3.rpy:6340
translate belarusian day3_corner_notfox_f76df969:

    # "Амулет Полины будто того и ждал — бросился из-под воротника навстречу острию ножа."
    "Амулет Паліны быццам таго і чакаў — кінуўся з-пад каўняра насустрач вастрыю нажа."

# game/scripts/scene/scene_day_3.rpy:6346
translate belarusian day3_corner_notfox_82efa145:

    # "Подвеска не дала когтю впиться в шею обидчика, и оберег глухо рухнул мне на грудь."
    "Падвеска не дала кіпцюру ўпіцца ў шыю крыўдніка, і абярэг глуха грымнуўся мне на грудзі."

# game/scripts/scene/scene_day_3.rpy:6348
translate belarusian day3_corner_notfox_df2e0296:

    # "Казалось, колотые раны вот-вот посыпятся на меня в таком количестве, что я захлебнусь собственной кровью."
    "Здавалася, колатыя раны вось-вось пасыплюцца на мяне ў такой колькасці, што я захлынуся ўласнай крывёю."

# game/scripts/scene/scene_day_3.rpy:6351
translate belarusian day3_corner_notfox_fa7f31cc:

    # "Но почему-то Ромка застыл, словно завороженный."
    "Але чамусьці Ромка застыў, нібы зачараваны."

# game/scripts/scene/scene_day_3.rpy:6354
translate belarusian day3_corner_notfox_2e5516ff:

    # "Он стоял с занесённой для удара рукой и, вытаращившись на побрякушку, рычал что-то злобное и нечленораздельное."
    "Ён стаяў з занесенай для ўдару рукой і, вылупіўшыся на бразготку, рыкаў нешта злоснае і нечленараздзельнае."

# game/scripts/scene/scene_day_3.rpy:6355
translate belarusian day3_corner_notfox_7160c981:

    # "Полинин подарок одним свои видом бесил Ромку, но одновременно связывал его руки."
    "Палінін падарунак адным сваім выглядам шаліў Ромку, але адначасова звязваў яго рукі."

# game/scripts/scene/scene_day_3.rpy:6370
translate belarusian day3_corner_notfox_e8346b0d:

    # "Это длилось неестественно долгое время, так что Бяша с непониманием нахмурился."
    "Гэта доўжылася ненатуральна доўгі час, так што Бяша з неразуменнем нахмурыўся."

# game/scripts/scene/scene_day_3.rpy:6392
translate belarusian day3_corner_notfox_922a4b86:

    # "Где-то наверху скрипнуло открывающееся окно..."
    "Недзе наверсе рыпнула акно, якое адчынялася..."

# game/scripts/scene/scene_day_3.rpy:6402
translate belarusian day3_corner_notfox_e689620c:

    # voice "voice/lydia/3day/08 Pyatifanov.ogg"
    # Teacher "Пятифанов!"
    voice "voice/lydia/3day/08 Pyatifanov.ogg"
    Teacher "Пяціфанаў!"

# game/scripts/scene/scene_day_3.rpy:6406
translate belarusian day3_corner_notfox_2a0ea734:

    # "Адреналина уже было предостаточно, и, почти взлетев с места, я бросился прочь."
    "Адрэналіну ўжо было дастаткова, і, амаль узляцеўшы з месца, я кінуўся прэч."

# game/scripts/scene/scene_day_3.rpy:6407
translate belarusian day3_corner_notfox_1957bf2b:

    # "Ромка ожил, когда я был уже далеко, и бросил мне вслед пугающее напоминание:"
    "Ромка ажыў, калі я быў ужо далёка, і кінуў мне ўслед пужаючы напамін:"

# game/scripts/scene/scene_day_3.rpy:6429
translate belarusian day3_corner_notfox_91ef1037_1:

    # voice "voice/romka/3day/65 Po.ogg"
    # Rom "Попробуй ещё раз позабудь!"
    voice "voice/romka/3day/65 Po.ogg"
    Rom "Паспрабуй яшчэ раз забудзь!"

# game/scripts/scene/scene_day_3.rpy:6432
translate belarusian day3_corner_notfox_ace03eb1_1:

    # voice "voice/romka/3day/66 Ant.ogg"
    # Rom "Антоша!"
    voice "voice/romka/3day/66 Ant.ogg"
    Rom "Антоша!"

# game/scripts/scene/scene_day_3.rpy:6482
translate belarusian dev_d3_olyatalk_end_ac64a469:

    # "Во рту стоял привкус гадкой воды, которой я запил лекарства."
    "У роце стаяў прысмак брыдкай вады, якой я запіў лекі."

# game/scripts/scene/scene_day_3.rpy:6487
translate belarusian dev_d3_olyatalk_end_94278a10:

    # "Обработанный йодом порез ныл под бинтом с махристыми краями."
    "Апрацаваны ёдам парэз ныў пад бінтам з махрыстымі краямі."

# game/scripts/scene/scene_day_3.rpy:6488
translate belarusian dev_d3_olyatalk_end_3e3ff7d5:

    # "Я не сказал родителям правду, как это получилось, сославшись на то, что наткнулся на острый сук в лесу."
    "Я не сказаў бацькам праўду, як гэта атрымалася, спаслаўшыся на тое, што натыкнуўся на востры сук у лесе."

# game/scripts/scene/scene_day_3.rpy:6489
translate belarusian dev_d3_olyatalk_end_9dbb44d3:

    # "Всё ждал более удобного случая, когда у вечно занятых мамы с папой появится на меня время."
    "Усё чакаў больш зручнага выпадку, калі ў вечна занятых мамы з татам з'явіцца на мяне час."

# game/scripts/scene/scene_day_3.rpy:6491
translate belarusian dev_d3_olyatalk_end_1b82c94b:

    # "Все мысли занимала только Полина."
    "Усе думкі займала толькі Паліна."

# game/scripts/scene/scene_day_3.rpy:6495
translate belarusian dev_d3_olyatalk_end_8b6d1cd1:

    # "И та угроза Ромки, если я вновь к ней приближусь."
    "І тая пагроза Ромкі, калі я зноў да яе набліжуся."

# game/scripts/scene/scene_day_3.rpy:6499
translate belarusian dev_d3_olyatalk_end_6ab6e41b:

    # "И тот спектакль, где Ромка уготовил мне роль злодея."
    "І той спектакль, дзе Ромка падрыхтаваў мне ролю злыдня."

# game/scripts/scene/scene_day_3.rpy:6524
translate belarusian dev_d3_olyatalk_end_6659d757:

    # "Я бродил по дому, будто пьяный, поддакивал сестре, толком не разбирая, о чём она говорит."
    "Я блукаў па доме, быццам п'яны, падтакваў сястры, толкам не разбіраючы, пра што яна кажа."

# game/scripts/scene/scene_day_3.rpy:6529
translate belarusian dev_d3_olyatalk_end_e59e8152:

    # "Оля же талдычила без перебоя, то и дело вскидывая руки и смеясь, как вдруг так же резко смолкла и уставилась на меня до боли знакомым колючим маминым взглядом."
    "Оля ж талдычыла без перапынку, раз-пораз ускідваючы рукі і смеючыся, як раптам гэтак жа рэзка змоўкла і ўтаропілася на мяне да болю знаёмым калючым маміным позіркам."

# game/scripts/scene/scene_day_3.rpy:6537
translate belarusian dev_d3_olyatalk_end_d1d96c97:

    # "Меня буквально выдернуло из темницы разума, где клокочущие мысли, подобно гарпиям, обрушивались на мой искусанный мозг, не давая вернуться в реальность."
    "Мяне літаральна вырвала з цямніцы розуму, дзе думкі клекаталі і, падобна да гарпій, абрушваліся на мой пакусаны мозг, не даючы вярнуцца ў рэальнасць."

# game/scripts/scene/scene_day_3.rpy:6539
translate belarusian dev_d3_olyatalk_end_e9cd8dcd:

    # "Я уставился на сестру — сейчас она была миниатюрной копией мамы."
    "Я ўтаропіўся на сястру — цяпер яна была мініяцюрнай копіяй мамы."

# game/scripts/scene/scene_day_3.rpy:6540
translate belarusian dev_d3_olyatalk_end_795cd405:

    # "Точнее тем, в кого она превратилась с момента переезда сюда: с её грозной позой в виде заглавной буквы «Ф» и вздёрнутыми к потолку бровями."
    "Дакладней тым, у каго яна ператварылася з моманту пераезду сюды: з яе грознай позай у выглядзе загалоўнай літары «Ф» і ўздзёртымі да столі брывамі."

# game/scripts/scene/scene_day_3.rpy:6544
translate belarusian dev_d3_olyatalk_end_8ef16303:

    # voice "voice/olya/3day/02 Ti.ogg"
    # Oly "Ты меня не слушал, так?!"
    voice "voice/olya/3day/02 Ti.ogg"
    Oly "Ты мяне не слухаў, так?!"

# game/scripts/scene/scene_day_3.rpy:6549
translate belarusian dev_d3_olyatalk_end_d6707c40:

    # "Она брызнула ядом в мою сторону, копируя мимику и интонации чуть ли не единственного человека, с кем проводила всё своё свободное время."
    "Яна пырснула атрутай у мой бок, капіруючы міміку і інтанацыі ледзь не адзінага чалавека, з кім праводзіла ўвесь свой вольны час."

# game/scripts/scene/scene_day_3.rpy:6550
translate belarusian dev_d3_olyatalk_end_9468b3fd:

    # "На мгновение мне показалось, что свет, излучаемый Олей все эти годы, стал слабее и опасно затрепыхался на ветру затянувшихся перемен. "
    "На імгненне мне падалося, што святло, якое выпраменьвала Оля ўсе гэтыя гады, стала слабейшым і небяспечна затрымцела на ветры зацягнутых перамен."

# game/scripts/scene/scene_day_3.rpy:6551
translate belarusian dev_d3_olyatalk_end_544d919d:

    # "Еще немного — и моя прекрасная принцесса станет драконом, который сторожил её в своей башне. А это пугало сильнее подкрадывающихся ко мне ужасов из будущего."
    "Яшчэ крыху — і мая цудоўная прынцэса стане драконам, які вартаваў яе ў сваёй вежы. А гэта палохала мацней за жахі з будучыні, якія падкрадваліся да мяне."

# game/scripts/scene/scene_day_3.rpy:6553
translate belarusian dev_d3_olyatalk_end_e6f43059:

    # voice "voice/anton/3day/04 Ol.ogg"
    # Ant "Оля, прости..."
    voice "voice/anton/3day/04 Ol.ogg"
    Ant "Оля, прабач..."

# game/scripts/scene/scene_day_3.rpy:6555
translate belarusian dev_d3_olyatalk_end_b2cfae7b:

    # voice "voice/anton/3day/05T.ogg"
    # Ant "Ты же не сердишься, правда? Я просто задумался."
    voice "voice/anton/3day/05T.ogg"
    Ant "Ты ж не злуешся, праўда? Я проста задумаўся."

# game/scripts/scene/scene_day_3.rpy:6559
translate belarusian dev_d3_olyatalk_end_7ac2570b:

    # "Взгляд заметался по комнате, как загнанный в ловушку зверь, перескакивая с одного предмета на другой, силясь найти хоть что-нибудь, что могло отвлечь Олю."
    "Позірк замятаўся па пакоі, як загнаны ў пастку звер, пераскокваючы з аднаго прадмета на іншы, сілячыся знайсці хоць што-небудзь, што магло адцягнуць увагу Олі."

# game/scripts/scene/scene_day_3.rpy:6563
translate belarusian dev_d3_olyatalk_end_ae2de6bd:

    # voice "voice/anton/3day/06 A.ogg"
    # Ant "А давай в приставку поиграем!"
    voice "voice/anton/3day/06 A.ogg"
    Ant "А давай у прыстаўку пагуляем!"

# game/scripts/scene/scene_day_3.rpy:6568
translate belarusian dev_d3_olyatalk_end_4a13ca17:

    # "Оля нахохлилась, однако искорка интереса вспыхнула в её изумрудных глазках. "
    "Оля нахмурылася, аднак іскрынка цікавасці ўспыхнула ў яе ізумрудных вочках."

# game/scripts/scene/scene_day_3.rpy:6570
translate belarusian dev_d3_olyatalk_end_ca63da58:

    # "И ледяной осколок, занесённый Снежной королевой, начал потихоньку оттаивать."
    "І ледзяны асколак, занесены Снежнай каралевай, пачаў паціху адтайваць."

# game/scripts/scene/scene_day_3.rpy:6573
translate belarusian dev_d3_olyatalk_end_3b7bf4e4:

    # voice "voice/olya/3day/04 A.ogg"
    # Oly "А как же второй джойстик? Не работает же."
    voice "voice/olya/3day/04 A.ogg"
    Oly "А як жа другі джойсцік? Не працуе ж."

# game/scripts/scene/scene_day_3.rpy:6577
translate belarusian dev_d3_olyatalk_end_a66f4d92:

    # voice "voice/olya/3day/05 A.ogg"
    # Oly "А папе починить некогда..."
    voice "voice/olya/3day/05 A.ogg"
    Oly "А тату паправіць няма калі..."

# game/scripts/scene/scene_day_3.rpy:6581
translate belarusian dev_d3_olyatalk_end_7f361827:

    # voice "voice/anton/3day/07 M.ogg"
    # Ant "М-м-м... Можем из пистолета пострелять."
    voice "voice/anton/3day/07 M.ogg"
    Ant "М-м-м... Можам з пісталета пастраляць."

# game/scripts/scene/scene_day_3.rpy:6583
translate belarusian dev_d3_olyatalk_end_4ced8023:

    # voice "voice/anton/3day/08 V.ogg"
    # Ant "В ковбоев или уток, хочешь?"
    voice "voice/anton/3day/08 V.ogg"
    Ant "У каўбояў або качак, хочаш?"

# game/scripts/scene/scene_day_3.rpy:6587
translate belarusian dev_d3_olyatalk_end_33067940:

    # voice "voice/olya/3day/06 T.ogg"
    # Oly "Ты лучше меня играешь." id dev_d3_olyatalk_end_33067940
    voice "voice/olya/3day/06 T.ogg"
    Oly "Ты лепш за мяне гуляеш." id dev_d3_olyatalk_end_33067940

# game/scripts/scene/scene_day_3.rpy:6591
translate belarusian dev_d3_olyatalk_end_ccb42ec2:

    # voice "voice/anton/3day/09 Da.ogg"
    # Ant "Да ладно тебе."
    voice "voice/anton/3day/09 Da.ogg"
    Ant "Ды кінь ты."

# game/scripts/scene/scene_day_3.rpy:6593
translate belarusian dev_d3_olyatalk_end_7643f2b1:

    # voice "voice/anton/3day/10 P.ogg"
    # Ant "Поди, целый день тренировалась, пока меня дома не было."
    voice "voice/anton/3day/10 P.ogg"
    Ant "Мусіць, цэлы дзень трэніравалася, пакуль мяне дома не было."

# game/scripts/scene/scene_day_3.rpy:6599
translate belarusian dev_d3_olyatalk_end_4571a709:

    # "Оля прыснула со смеха. Ледяное сердце окончательно растаяло."
    "Оля пырснула ад смеху. Ледзяное сэрца канчаткова растала."

# game/scripts/scene/scene_day_3.rpy:6602
translate belarusian dev_d3_olyatalk_end_7b7ebfc8:

    # voice "voice/olya/3day/08 A.ogg"
    # Oly "А как ты догадался?"
    voice "voice/olya/3day/08 A.ogg"
    Oly "А як ты здагадаўся?"

# game/scripts/scene/scene_day_3.rpy:6606
translate belarusian dev_d3_olyatalk_end_e178081f:

    # voice "voice/olya/3day/09 Ya.ogg"
    # Oly "Я сейчас знаешь какая меткая? Считай, уже проиграл."
    voice "voice/olya/3day/09 Ya.ogg"
    Oly "Я цяпер ведаеш якая трапная? Лічы, ужо прайграў."

# game/scripts/scene/scene_day_3.rpy:6610
translate belarusian dev_d3_olyatalk_end_18196794:

    # voice "voice/anton/3day/11 Ne.ogg"
    # Ant "Не на того напала! Включай скорее!"
    voice "voice/anton/3day/11 Ne.ogg"
    Ant "Не на таго напала! Уключай хутчэй!"

# game/scripts/scene/scene_day_3.rpy:6642
translate belarusian open_box_table_db7c425d:

    # "Я спрятал печатку Семёна в ящик письменного стола."
    "Я схаваў пячатку Сямёна ў шуфляду пісьмовага стала."

# game/scripts/scene/scene_day_3.rpy:6645
translate belarusian open_box_table_9a7ef6ab:

    # "Хотя сам до конца так и не понял — поступил ли я правильно украв у милиционера важную улику."
    "Хаця сам да канца так і не зразумеў — ці правільна я паступіў, скраўшы ў міліцыянера важны доказ."

# game/scripts/scene/scene_day_3.rpy:6649
translate belarusian open_box_table_b4f40b9d:

    # "Наконец, я перебрался в комнату сестры."
    "Нарэшце, я перабраўся ў пакой сястры."

# game/scripts/scene/scene_day_3.rpy:6679
translate belarusian open_box_table_ba415a04:

    # "Малютка подскочила к телевизору и, щёлкнув питанием, начала вслепую шарить по задней стенке «Фотона», явно пытаясь воткнуть кабель от приставки в гнездо антенны."
    "Малая падскочыла да тэлевізара і, шчоўкнуўшы сілкаваннем, пачала ўсляпую шарыць па задняй сценцы «Фатона», відавочна спрабуючы ўткнуць кабель ад прыстаўкі ў гняздо антэны."

# game/scripts/scene/scene_day_3.rpy:6689
translate belarusian open_box_table_472c2a8a:

    # "Отрывки из телепередач маячили на ламповом экране, пока Оля листала до канала, где ловила заветная «{u}Денди{/u}»."
    "Урыўкі з тэлеперадач маячылі на лямпавым экране, пакуль Оля гартала да канала, дзе лавіла запаветная «{u}Дэндзі{/u}»."

# game/scripts/scene/scene_day_3.rpy:6692
translate belarusian open_box_table_41a61dd1:

    # voice "voice/anton/3day/12 Ch.ogg"
    # Ant "Что дома интересного происходило?"
    voice "voice/anton/3day/12 Ch.ogg"
    Ant "Што дома цікавага адбывалася?"

# game/scripts/scene/scene_day_3.rpy:6695
translate belarusian open_box_table_438eae8b:

    # "Вопрос был обывательским — я даже и не задумался над его значением."
    "Пытанне было звычайным — я нават і не задумаўся над яго значэннем."

# game/scripts/scene/scene_day_3.rpy:6706
translate belarusian open_box_table_f04a93c5:

    # "Однако Оля внезапно изменилась в лице и растеряла обретённую дорогой ценой детскую невозмутимость."
    "Аднак Оля раптоўна змянілася ў твары і разгубіла здабытую дарагой цаной дзіцячую непарушнасць."

# game/scripts/scene/scene_day_3.rpy:6710
translate belarusian open_box_table_0c4847c0:

    # voice "voice/anton/3day/13 Ol.ogg"
    # Ant "Оль, что-то случилось?"
    voice "voice/anton/3day/13 Ol.ogg"
    Ant "Оль, нешта здарылася?"

# game/scripts/scene/scene_day_3.rpy:6714
translate belarusian open_box_table_3a3f10ce:

    # "Сестрёнка вставила кабель на место и, вытащив испачканную ручонку, стала неуклюже отряхивать пыль. "
    "Сястрычка ўставіла кабель на месца і, выцягнуўшы запэцканую ручку, стала нязграбна абтрасаць пыл."

# game/scripts/scene/scene_day_3.rpy:6720
translate belarusian open_box_table_ef08b76f:

    # "Она явно искала в себе силы, чтобы начать разговор."
    "Яна відавочна шукала ў сабе сілы, каб пачаць размову."

# game/scripts/scene/scene_day_3.rpy:6737
translate belarusian open_box_table_708c5be5:

    # voice "voice/olya/3day/13 Ma.ogg"
    # Oly "Мама..."
    voice "voice/olya/3day/13 Ma.ogg"
    Oly "Мама..."

# game/scripts/scene/scene_day_3.rpy:6743
translate belarusian open_box_table_ba5417a1:

    # "Она замолчала, и на секунду показалось, что на её глазах выступили слезы."
    "Яна змоўкла, і на секунду падалося, што на яе вачах выступілі слёзы."

# game/scripts/scene/scene_day_3.rpy:6749
translate belarusian open_box_table_36025220:

    # voice "voice/olya/3day/16 U.ogg"
    # Oly "У неё опять был этот страшный..."
    voice "voice/olya/3day/16 U.ogg"
    Oly "У яе зноў быў гэты страшны..."

# game/scripts/scene/scene_day_3.rpy:6754
translate belarusian open_box_table_efd839e2:

    # "Оля взглянула на меня мокрыми глазёнками-блюдцами."
    "Оля зірнула на мяне мокрымі вочкамі-сподачкамі."

# game/scripts/scene/scene_day_3.rpy:6758
translate belarusian open_box_table_a88ec01c:

    # voice "voice/anton/3day/14 P.ogg"
    # Ant "... приступ."
    voice "voice/anton/3day/14 P.ogg"
    Ant "... прыступ."

# game/scripts/scene/scene_day_3.rpy:6765
translate belarusian open_box_table_f665fe9b:

    # "Такое случалось и раньше, но довольно редко, а когда мы перебрались в этот богом забытый край — мамины приступы пугающе участились."
    "Такое здаралася і раней, але даволі рэдка, а калі мы перабраліся ў гэты богам забыты край — маміны прыступы палохаюча пачасціліся."

# game/scripts/scene/scene_day_3.rpy:6768
translate belarusian open_box_table_3fb4082a:

    # voice "voice/olya/3day/17 Pa.ogg"
    # Oly "Папа принёс большую рыбу..."
    voice "voice/olya/3day/17 Pa.ogg"
    Oly "Тата прынёс вялікую рыбу..."

# game/scripts/scene/scene_day_3.rpy:6775
translate belarusian open_box_table_217421b7:

    # voice "voice/olya/3day/18 Ona.ogg"
    # Oly "Она в газету была завёрнута и пахла так... Бэ..."
    voice "voice/olya/3day/18 Ona.ogg"
    Oly "Яна ў газету была загорнута і пахла так... Бэ..."

# game/scripts/scene/scene_day_3.rpy:6784
translate belarusian open_box_table_fcd84c3e:

    # voice "voice/olya/3day/19 A.ogg"
    # Oly "А мама опять начала злиться, потом взяла нож."
    voice "voice/olya/3day/19 A.ogg"
    Oly "А мама зноў пачала злавацца, потым узяла нож."

# game/scripts/scene/scene_day_3.rpy:6794
translate belarusian open_box_table_6a0bcdc6:

    # "Оля поёжилась, с опаской выглянув в окно."
    "Оля паёжылася, з асцярогай выглянуўшы ў акно."

# game/scripts/scene/scene_day_3.rpy:6795
translate belarusian open_box_table_ad18198c:

    # voice "voice/olya/3day/20 O.ogg"
    # Oly "Они начали громко ругаться и..."
    voice "voice/olya/3day/20 O.ogg"
    Oly "Яны пачалі гучна лаяцца і..."

# game/scripts/scene/scene_day_3.rpy:6806
translate belarusian open_box_table_0e746259:

    # "Я замер, представляя, как сестрёнка, такая маленькая и незаметная, стояла посреди кухонного проёма."
    "Я замер, уяўляючы, як сястрычка, такая маленькая і непрыкметная, стаяла пасярод кухоннага праёма."

# game/scripts/scene/scene_day_3.rpy:6808
translate belarusian open_box_table_a6301fd9:

    # "Она даже не пыталась спрятаться: родители попросту её не замечали."
    "Яна нават не спрабавала схавацца: бацькі папросту яе не заўважалі."

# game/scripts/scene/scene_day_3.rpy:6810
translate belarusian open_box_table_56ba1e73:

    # voice "voice/olya/3day/21E.ogg"
    # Oly "И потом мама ударила."
    voice "voice/olya/3day/21E.ogg"
    Oly "І потым мама ўдарыла."

# game/scripts/scene/scene_day_3.rpy:6817
translate belarusian open_box_table_d998d42b:

    # voice "voice/olya/3day/22 V.ogg"
    # Oly "Вот так."
    voice "voice/olya/3day/22 V.ogg"
    Oly "Вось так."

# game/scripts/scene/scene_day_3.rpy:6820
translate belarusian open_box_table_ad8af6b4:

    # "Оля едва дёрнула кулачком сверху вниз, имитируя удар."
    "Оля ледзь тузанула кулачком зверху ўніз, імітуючы ўдар."

# game/scripts/scene/scene_day_3.rpy:6825
translate belarusian open_box_table_a7298dfd:

    # voice "voice/olya/3day/23 R.ogg"
    # Oly "Рыбу."
    voice "voice/olya/3day/23 R.ogg"
    Oly "Рыбу."

# game/scripts/scene/scene_day_3.rpy:6827
translate belarusian open_box_table_a749a852:

    # voice "voice/olya/3day/24 O.ogg"
    # Oly "Она была живая, Тош. Ей было больно, а мама... мама..."
    voice "voice/olya/3day/24 O.ogg"
    Oly "Яна была жывая, Тош. Ёй было балюча, а мама... мама..."

# game/scripts/scene/scene_day_3.rpy:6830
translate belarusian open_box_table_56dacb65:

    # "Мне было легко представить, что было дальше: извивающаяся рыба с воткнутым в жабры клинком брызнула зловонной слизью на мамино лицо."
    "Мне было лёгка ўявіць, што было далей: рыба, што выгіналася з уваткнутым у жабры клінком, пырснула смярдзючай сліззю на мамін твар."

# game/scripts/scene/scene_day_3.rpy:6835
translate belarusian open_box_table_1bf45c52:

    # "Если смерть приближалась так близко к маме, как в тот день, когда при нас человека сбило автобусом, и кровь размазалась по лобовому стеклу..."
    "Калі смерць набліжалася так блізка да мамы, як у той дзень, калі пры нас чалавека збіў аўтобус, і кроў размазалася па лабавым шкле..."

# game/scripts/scene/scene_day_3.rpy:6836
translate belarusian open_box_table_42940ea4:

    # "Или когда бабушка отрубила голову цыплёнку — мама всегда впадала в странный пугающий до дрожи приступ."
    "Або калі бабуля адсекла галаву кураняці — мама заўсёды ўпадала ў дзіўны, пужаючы да дрыжыкаў прыступ."

# game/scripts/scene/scene_day_3.rpy:6857
translate belarusian open_box_table_333cf89c:

    # "Её глаза закатывались, она падала навзничь, как спиленное дерево, и извивалась, как та самая бившаяся в агонии рыба, переворачивая стулья и выплёвывая обрывки пугающих фраз."
    "Яе вочы закочваліся, яна падала наўзніч, як спілаванае дрэва, і выгіналася, як тая самая рыба, што білася ў агоніі, пераварочваючы крэслы і выплёўваючы ўрыўкі страшных фраз."

# game/scripts/scene/scene_day_3.rpy:6859
translate belarusian open_box_table_3d3d9d70:

    # voice "voice/anton/3day/15 A.ogg"
    # Ant "А папа? Он ей помог?"
    voice "voice/anton/3day/15 A.ogg"
    Ant "А тата? Ён ёй дапамог?"

# game/scripts/scene/scene_day_3.rpy:6863
translate belarusian open_box_table_5bdbe820:

    # "Оля вздрогнула, как будто бы воспоминания ранили её."
    "Оля ўздрыгнула, нібыта ўспаміны ранілі яе."

# game/scripts/scene/scene_day_3.rpy:6865
translate belarusian open_box_table_2e3f5781:

    # voice "voice/olya/3day/26 Da.ogg"
    # Oly "Да. Но в начале..."
    voice "voice/olya/3day/26 Da.ogg"
    Oly "Так. Але спачатку..."

# game/scripts/scene/scene_day_3.rpy:6873
translate belarusian open_box_table_90bc00f8:

    # voice "voice/olya/3day/27 On.ogg"
    # Oly "Он засмеялся, Тоша!"
    voice "voice/olya/3day/27 On.ogg"
    Oly "Ён засмяяўся, Тоша!"

# game/scripts/scene/scene_day_3.rpy:6879
translate belarusian open_box_table_22f9618c:

    # voice "voice/olya/3day/28 T.ogg"
    # Oly "Так страшно, когда увидел, что маме плохо..."
    voice "voice/olya/3day/28 T.ogg"
    Oly "Так страшна, калі ўбачыў, што маме дрэнна..."

# game/scripts/scene/scene_day_3.rpy:6884
translate belarusian open_box_table_7572e0d3:

    # voice "voice/olya/3day/29 A.ogg"
    # Oly "А потом вдруг заплакал."
    voice "voice/olya/3day/29 A.ogg"
    Oly "А потым раптам заплакаў."

# game/scripts/scene/scene_day_3.rpy:6888
translate belarusian open_box_table_affd2b7d:

    # "От услышанного у меня дёрнулась бровь."
    "Ад пачутага ў мяне тузанулася брыво."

# game/scripts/scene/scene_day_3.rpy:6894
translate belarusian open_box_table_724545cf:

    # "Безумие, источаемое лесом и окончательно завладевшее мамой, перебросилось и на нашего сильного и храброго отца."
    "Вар'яцтва, якое выпраменьваў лес і якое канчаткова завалодала мамай, перакінулася і на нашага моцнага і адважнага бацьку."

# game/scripts/scene/scene_day_3.rpy:6902
translate belarusian open_box_table_14d17451:

    # "Я быстро шагнул навстречу Оле, заключив её в крепкие объятия."
    "Я хутка ступіў насустрач Олі, заключыўшы яе ў моцныя абдымкі."

# game/scripts/scene/scene_day_3.rpy:6903
translate belarusian open_box_table_fdfbcba3:

    # "Она уткнулась мордашкой мне в грудь, и я почувствовал, как рубашка сделалась мокрой."
    "Яна ўткнулася мордачкай мне ў грудзі, і я адчуў, як кашуля зрабілася мокрай."

# game/scripts/scene/scene_day_3.rpy:6905
translate belarusian open_box_table_7a7740dd:

    # voice "voice/olya/3day/30 Z.ogg"
    # Oly "Зачем они так издеваются друг над другом, Тош?"
    voice "voice/olya/3day/30 Z.ogg"
    Oly "Навошта яны так здзекуюцца адзін з аднаго, Тош?"

# game/scripts/scene/scene_day_3.rpy:6911
translate belarusian open_box_table_e8740cc5:

    # voice "voice/olya/3day/31 Oni.ogg"
    # Oly "Они сумасшедшие?"
    voice "voice/olya/3day/31 Oni.ogg"
    Oly "Яны вар'яты?"

# game/scripts/scene/scene_day_3.rpy:6917
translate belarusian open_box_table_dad6c61e:

    # "Не находя, как оправдать родительское поведение, я запнулся."
    "Не знаходзячы, як апраўдаць бацькоўскія паводзіны, я запнуўся."

# game/scripts/scene/scene_day_3.rpy:6921
translate belarusian open_box_table_dc9ad77d:

    # "Слова иссякли, и всё, что я мог, так это покрепче обнять Олю."
    "Словы вычарпаліся, і ўсё, што я мог, дык гэта мацней абняць Олю."

# game/scripts/scene/scene_day_3.rpy:6946
translate belarusian open_box_table_5471976a:

    # "Оля в ужасе вскрикнула и спряталась за меня."
    "Оля ў жаху ўскрыкнула і схавалася за мяне."

# game/scripts/scene/scene_day_3.rpy:6948
translate belarusian open_box_table_944a1b17:

    # voice "voice/olya/3day/33 Per .ogg"
    # Oly "Переключи, переключи скорей!"
    voice "voice/olya/3day/33 Per .ogg"
    Oly "Пераключы, пераключы хутчэй!"

# game/scripts/scene/scene_day_3.rpy:6951
translate belarusian open_box_table_5aa9ec71:

    # "Сколько бы раз она ни видела эту заставку, всё время реагировала одинаково... как и при виде совы."
    "Колькі б разоў яна ні бачыла гэтую застаўку, увесь час рэагавала аднолькава... як і пры выглядзе савы."

# game/scripts/scene/scene_day_3.rpy:6958
translate belarusian open_box_table_7c282941:

    # "У меня самого выступали мурашки при появлении этого {u}призрачного лица{/u}, поэтому я моментально исполнил пожелание сестры."
    "У мяне самога выступалі мурашкі пры з'яўленні гэтага {u}прывіднага твару{/u}, таму я імгненна выканаў пажаданне сястры."

# game/scripts/scene/scene_day_3.rpy:7003
translate belarusian day3_goosehunt_e32f059f:

    # "Наконец на экране появился список многоигровки, идущей в комплекте вместе с приставкой."
    "Нарэшце на экране з'явіўся спіс шматгульнёўкі, якая ішла ў камплекце разам з прыстаўкай."

# game/scripts/scene/scene_day_3.rpy:7015
translate belarusian day3_goosehunt_d4658a9f:

    # "Досадно, что большинство наименований на этом картридже были просто другими уровнями одной и той же игры."
    "Крыўдна, што большасць назваў на гэтым картрыджы былі проста іншымі ўзроўнямі адной і той жа гульні."

# game/scripts/scene/scene_day_3.rpy:7056
translate belarusian day3_goosehunt_b4269dfb:

    # "Я подобрал серый прямоугольный джойстик и стал выискивать в пиксельном многообразии знакомые английские слова про утиную охоту."
    "Я падабраў шэры прамавугольны джойсцік і стаў вышукваць у піксельнай разнастайнасці знаёмыя англійскія словы пра качынае паляванне."

# game/scripts/scene/scene_day_3.rpy:7069
translate belarusian day3_goosehunt_0511ee60:

    # "Фоновая музыка подействовала на Олю умиротворяюще, и она спокойно поинтересовалась:"
    "Фонавая музыка падзейнічала на Олю супакойліва, і яна спакойна пацікавілася:"

# game/scripts/scene/scene_day_3.rpy:7073
translate belarusian day3_goosehunt_2f558bbf:

    # voice "voice/olya/3day/34 Aka.ogg"
    # Oly "А как твои дела в школе?"
    voice "voice/olya/3day/34 Aka.ogg"
    Oly "А як твае справы ў школе?"

# game/scripts/scene/scene_day_3.rpy:7079
translate belarusian day3_goosehunt_af1465c4:

    # voice "voice/anton/3day/34 Ya.ogg"
    # Ant "Я с одной девочкой подружился."
    voice "voice/anton/3day/34 Ya.ogg"
    Ant "Я з адной дзяўчынкай пасябраваў."

# game/scripts/scene/scene_day_3.rpy:7083
translate belarusian day3_goosehunt_20581887:

    # voice "voice/olya/3day/54 A.ogg"
    # Oly "А она красивая?"
    voice "voice/olya/3day/54 A.ogg"
    Oly "А яна прыгожая?"

# game/scripts/scene/scene_day_3.rpy:7086
translate belarusian day3_goosehunt_7f15ab29:

    # "Я смутился."
    "Я збянтэжыўся."

# game/scripts/scene/scene_day_3.rpy:7087
translate belarusian day3_goosehunt_f42917b3:

    # voice "voice/anton/3day/35 Nu.ogg"
    # Ant "Ну... я не знаю."
    voice "voice/anton/3day/35 Nu.ogg"
    Ant "Ну... я не ведаю."

# game/scripts/scene/scene_day_3.rpy:7090
translate belarusian day3_goosehunt_95990784:

    # voice "voice/olya/3day/55 Xa.ogg"
    # Oly "Ха, ты засмущался. Значит очень красивая!"
    voice "voice/olya/3day/55 Xa.ogg"
    Oly "Ха, ты засаромеўся. Значыць вельмі прыгожая!"

# game/scripts/scene/scene_day_3.rpy:7093
translate belarusian day3_goosehunt_3f520a9f:

    # voice "voice/anton/3day/36 Pe.ogg"
    # Ant "Перестань, Оль."
    voice "voice/anton/3day/36 Pe.ogg"
    Ant "Перастань, Оль."

# game/scripts/scene/scene_day_3.rpy:7096
translate belarusian day3_goosehunt_ffc67c76:

    # voice "voice/olya/3day/56 Vl.ogg"
    # Oly "Влюбился! Влюбился!"
    voice "voice/olya/3day/56 Vl.ogg"
    Oly "Закахаўся! Закахаўся!"

# game/scripts/scene/scene_day_3.rpy:7099
translate belarusian day3_goosehunt_9fbc738b:

    # voice "voice/anton/3day/37 Ol.ogg"
    # Ant "Оля, блин, сейчас не буду с тобой играть."
    voice "voice/anton/3day/37 Ol.ogg"
    Ant "Оля, блін, зараз не буду з табой гуляць."

# game/scripts/scene/scene_day_3.rpy:7102
translate belarusian day3_goosehunt_20c05d35:

    # voice "voice/olya/3day/57 D.ogg"
    # Oly "Ха-ха! Да я пошутила!"
    voice "voice/olya/3day/57 D.ogg"
    Oly "Ха-ха! Ды я пажартавала!"

# game/scripts/scene/scene_day_3.rpy:7106
translate belarusian day3_goosehunt_eee9f35a:

    # voice "voice/olya/3day/58 A.ogg"
    # Oly "А ты нас познакомишь?"
    voice "voice/olya/3day/58 A.ogg"
    Oly "А ты нас пазнаёміш?"

# game/scripts/scene/scene_day_3.rpy:7109
translate belarusian day3_goosehunt_0544d9f7:

    # voice "voice/anton/3day/38 Nu.ogg"
    # Ant "Ну, может быть."
    voice "voice/anton/3day/38 Nu.ogg"
    Ant "Ну, можа быць."

# game/scripts/scene/scene_day_3.rpy:7112
translate belarusian day3_goosehunt_1433960d:

    # voice "voice/olya/3day/59 Ak.ogg"
    # Oly "А как её зовут?"
    voice "voice/olya/3day/59 Ak.ogg"
    Oly "А як яе завуць?"

# game/scripts/scene/scene_day_3.rpy:7115
translate belarusian day3_goosehunt_c59a979b:

    # voice "voice/anton/3day/39 P.ogg"
    # Ant "П-полина..."
    voice "voice/anton/3day/39 P.ogg"
    Ant "П-паліна..."

# game/scripts/scene/scene_day_3.rpy:7118
translate belarusian day3_goosehunt_b68c1a49:

    # voice "voice/olya/3day/60 Pok.ogg"
    # Oly "А ты покраснел!"
    voice "voice/olya/3day/60 Pok.ogg"
    Oly "А ты пачырванеў!"

# game/scripts/scene/scene_day_3.rpy:7122
translate belarusian day3_goosehunt_5137f46a:

    # voice "voice/olya/3day/61 A.ogg"
    # Oly "А где вы будете жить, когда поженитесь?"
    voice "voice/olya/3day/61 A.ogg"
    Oly "А дзе вы будзеце жыць, калі пажэніцеся?"

# game/scripts/scene/scene_day_3.rpy:7125
translate belarusian day3_goosehunt_980a9436:

    # voice "voice/anton/3day/40 M.ogg"
    # Ant "Мы будем играть или нет?"
    voice "voice/anton/3day/40 M.ogg"
    Ant "Мы будзем гуляць ці не?"

# game/scripts/scene/scene_day_3.rpy:7130
translate belarusian day3_goosehunt_a1f273f4:

    # voice "voice/anton/3day/41 Da.ogg"
    # Ant "Да вот завёл пару друзей... наверное."
    voice "voice/anton/3day/41 Da.ogg"
    Ant "Ды вось завёў пару сяброў... напэўна."

# game/scripts/scene/scene_day_3.rpy:7133
translate belarusian day3_goosehunt_a2a46b98:

    # voice "voice/olya/3day/63 Og.ogg"
    # Oly "Ого! Целых двух. Везёт."
    voice "voice/olya/3day/63 Og.ogg"
    Oly "Ого! Цэлых двух. Шанцуе."

# game/scripts/scene/scene_day_3.rpy:7136
translate belarusian day3_goosehunt_0f654aa0:

    # voice "voice/anton/3day/42 A.ogg"
    # Ant "А ты говоришь, лисичку видела?"
    voice "voice/anton/3day/42 A.ogg"
    Ant "А ты кажаш, лісічку бачыла?"

# game/scripts/scene/scene_day_3.rpy:7139
translate belarusian day3_goosehunt_9d3052c9:

    # voice "voice/olya/3day/64 Aga.ogg"
    # Oly "Ага. Её зовут Алиса."
    voice "voice/olya/3day/64 Aga.ogg"
    Oly "Ага. Яе завуць Аліса."

# game/scripts/scene/scene_day_3.rpy:7142
translate belarusian day3_goosehunt_9dfbdcf0:

    # "Мне резко стало не по себе при упоминании новой знакомой."
    "Мне рэзка стала не па сабе пры згадванні новай знаёмай."

# game/scripts/scene/scene_day_3.rpy:7143
translate belarusian day3_goosehunt_98967370:

    # voice "voice/anton/3day/43 Ot.ogg"
    # Ant "Откуда ты знаешь? Она так сказала?"
    voice "voice/anton/3day/43 Ot.ogg"
    Ant "Адкуль ты ведаеш? Яна так сказала?"

# game/scripts/scene/scene_day_3.rpy:7146
translate belarusian day3_goosehunt_b234b2b1:

    # voice "voice/olya/3day/64 da.ogg"
    # Oly "Да, когда с мамой мусор ходили выбрасывать. А ещё говорила, что спасла тебя."
    voice "voice/olya/3day/64 da.ogg"
    Oly "Так, калі з мамай смецце хадзілі выкідваць. А яшчэ казала, што выратавала цябе."

# game/scripts/scene/scene_day_3.rpy:7149
translate belarusian day3_goosehunt_00ae6be4:

    # voice "voice/anton/3day/44 S.ogg"
    # Ant "Спасла?.."
    voice "voice/anton/3day/44 S.ogg"
    Ant "Выратавала?.."

# game/scripts/scene/scene_day_3.rpy:7151
translate belarusian day3_goosehunt_41334921:

    # "Тут же вспомнилась перепалка с хулиганами в лесу, а затем таинственный шепоток из чащи."
    "Адразу ж узгадалася перапалка з хуліганамі ў лесе, а потым таямнічы шэпт з гушчару."

# game/scripts/scene/scene_day_3.rpy:7152
translate belarusian day3_goosehunt_df532002:

    # "Как улепётывал побитый Семён, и как склонялся надо мной, заслоняя луну, рогатый великан."
    "Як уцякаў пабіты Сямён, і як схіляўся нада мной, засланяючы месяц, рагаты волат."

# game/scripts/scene/scene_day_3.rpy:7153
translate belarusian day3_goosehunt_6af72e3e:

    # "Всё это время я будто бы ощущал незримое присутствие Алисы. Словно она следила за мной из-за кривых стволов деревьев с застывшей улыбкой на рыжей маске."
    "Увесь гэты час я быццам бы адчуваў нябачную прысутнасць Алісы. Нібы яна сачыла за мной з-за крывых ствалоў дрэў з застылай усмешкай на рудой масцы."

# game/scripts/scene/scene_day_3.rpy:7154
translate belarusian day3_goosehunt_834d55eb:

    # "Я вздрогнул, прогоняя наваждение."
    "Я ўздрыгнуў, праганяючы здань."

# game/scripts/scene/scene_day_3.rpy:7155
translate belarusian day3_goosehunt_d40a40ba:

    # voice "voice/anton/3day/45 A.ogg"
    # Ant "А ещё она что-нибудь говорила?"
    voice "voice/anton/3day/45 A.ogg"
    Ant "А яшчэ яна што-небудзь казала?"

# game/scripts/scene/scene_day_3.rpy:7158
translate belarusian day3_goosehunt_1e3cfcbd:

    # voice "voice/olya/3day/65 Nea.ogg"
    # Oly "Не-а."
    voice "voice/olya/3day/65 Nea.ogg"
    Oly "Не-а."

# game/scripts/scene/scene_day_3.rpy:7162
translate belarusian day3_goosehunt_ec84c30f:

    # voice "voice/olya/3day/66 Ma.ogg"
    # Oly "Мама так быстро вернулась. Я её хотела с лисичкой познакомить, а та уже убежала."
    voice "voice/olya/3day/66 Ma.ogg"
    Oly "Мама так хутка вярнулася. Я яе хацела з лісічкай пазнаёміць, а тая ўжо ўцякла."

# game/scripts/scene/scene_day_3.rpy:7165
translate belarusian day3_goosehunt_dd1f9828:

    # voice "voice/anton/3day/46 T.ogg"
    # Ant "Ты её не боишься?"
    voice "voice/anton/3day/46 T.ogg"
    Ant "Ты яе не баішся?"

# game/scripts/scene/scene_day_3.rpy:7169
translate belarusian day3_goosehunt_9bb48ca7:

    # voice "voice/olya/3day/67 A.ogg"
    # Oly "А почему я должна бояться? Алиса добрая, такая пушистая и красивая..."
    voice "voice/olya/3day/67 A.ogg"
    Oly "А чаму я павінна баяцца? Аліса добрая, такая пухнатая і прыгожая..."

# game/scripts/scene/scene_day_3.rpy:7173
translate belarusian day3_goosehunt_0722b841:

    # voice "voice/olya/3day/68 Ne.ogg"
    # Oly "Не то что сова."
    voice "voice/olya/3day/68 Ne.ogg"
    Oly "Не тое што сава."

# game/scripts/scene/scene_day_3.rpy:7193
translate belarusian day3_goosehunt_c9f0db26:

    # "Я вставил световой пистолет в гнездо от второго джойстика под смешок сестры."
    "Я ўставіў светлавы пісталет у гняздо ад другога джойсціка пад смяшок сястры."

# game/scripts/scene/scene_day_3.rpy:7203
translate belarusian day3_goosehunt_e4425e18:

    # voice "voice/olya/3day/62 Chu.ogg"
    # Oly "Чур, я первая!"
    voice "voice/olya/3day/62 Chu.ogg"
    Oly "Чур, я першая!"

# game/scripts/scene/scene_day_3.rpy:7210
translate belarusian day3_goosehunt_7c6321c2:

    # voice "voice/anton/3day/18 Ni.ogg"
    # Ant "Ничего хорошего."
    voice "voice/anton/3day/18 Ni.ogg"
    Ant "Нічога добрага."

# game/scripts/scene/scene_day_3.rpy:7214
translate belarusian day3_goosehunt_f042bc93:

    # voice "voice/anton/3day/19 Sh.ogg"
    # Ant "Школа новая, а достаётся мне по-прежнему."
    voice "voice/anton/3day/19 Sh.ogg"
    Ant "Школа новая, а дастаецца мне па-ранейшаму."

# game/scripts/scene/scene_day_3.rpy:7219
translate belarusian day3_goosehunt_b8d138ad:

    # voice "voice/anton/3day/20 S.ogg"
    # Ant "Словно и не переезжали никуда... Задолбало."
    voice "voice/anton/3day/20 S.ogg"
    Ant "Быццам і не пераязджалі нікуды... Задзяўбло."

# game/scripts/scene/scene_day_3.rpy:7229
translate belarusian day3_goosehunt_b3397bdb:

    # "И прежде чем безнадёга снова повела меня тоскливой тропинкой в плен гнетущих мыслей, что-то зловещее зашевелилось в недрах черепной коробки."
    "І перш чым безнадзейнасць зноў павяла мяне тужлівай сцяжынкай у палон прыгнятальных думак, нешта злавеснае заварушылася ў нетрах чэрапа."

# game/scripts/scene/scene_day_3.rpy:7230
translate belarusian day3_goosehunt_a62a59e6:

    # "Будоража такие дикие и оттого приятные воспоминания."
    "Разбуджаючы такія дзікія і ад таго прыемныя ўспаміны."

# game/scripts/scene/scene_day_3.rpy:7231
translate belarusian day3_goosehunt_9ef13be8:

    # voice "voice/anton/3day/21 H.ogg"
    # Ant "{i}Хотя, знаешь... Кое-что хорошее всё же случилось.{/i}"
    voice "voice/anton/3day/21 H.ogg"
    Ant "{i}Хаця, ведаеш... Нешта добрае ўсё ж здарылася.{/i}"

# game/scripts/scene/scene_day_3.rpy:7233
translate belarusian day3_goosehunt_2cc154ff:

    # "Оля с надеждой посмотрела на мою криво расползающуюся улыбку, отдалённо напоминающую вспоротую рану от канцелярского ножа."
    "Оля з надзеяй паглядзела на маю ўсмешку, што крыва расплывалася і аддалена нагадвала распаротую рану ад канцылярскага нажа."

# game/scripts/scene/scene_day_3.rpy:7234
translate belarusian day3_goosehunt_1264792f:

    # voice "voice/anton/3day/22 E.ogg"
    # Ant "{i}Ещё один мальчик пропал.{/i}"
    voice "voice/anton/3day/22 E.ogg"
    Ant "{i}Яшчэ адзін хлопчык знік.{/i}"

# game/scripts/scene/scene_day_3.rpy:7237
translate belarusian day3_goosehunt_f4aff973:

    # voice "voice/olya/3day/35 To.ogg"
    # Oly "Тоша, разве это... хорошо? Почему ты так говоришь?"
    voice "voice/olya/3day/35 To.ogg"
    Oly "Тоша, хіба гэта... добра? Чаму ты так кажаш?"

# game/scripts/scene/scene_day_3.rpy:7240
translate belarusian day3_goosehunt_2aa336f4:

    # "Голос сестры вздрогнул, когда она заглянула мне в глаза сквозь толстые очки."
    "Голас сястры ўздрыгнуў, калі яна зазірнула мне ў вочы скрозь тоўстыя акуляры."

# game/scripts/scene/scene_day_3.rpy:7245
translate belarusian day3_goosehunt_d7f45e6e:

    # voice "voice/anton/3day/23 Z.ogg"
    # Ant "{i}Знаешь, а может, тот пропавший Вова сам виноват, что с ним это случилось.{/i}"
    voice "voice/anton/3day/23 Z.ogg"
    Ant "{i}Ведаеш, а можа, той зніклы Вова сам вінаваты, што з ім гэта здарылася.{/i}"

# game/scripts/scene/scene_day_3.rpy:7247
translate belarusian day3_goosehunt_75db774a:

    # voice "voice/anton/3day/24 M.ogg"
    # Ant "{i}Может, он совершил нечто настолько плохое... что не заслуживал жить.{/i}"
    voice "voice/anton/3day/24 M.ogg"
    Ant "{i}Можа, ён здзейсніў нешта настолькі дрэннае... што не заслугоўваў жыць.{/i}"

# game/scripts/scene/scene_day_3.rpy:7250
translate belarusian day3_goosehunt_41b6653c:

    # voice "voice/olya/3day/36 Ne.ogg"
    # Oly "Не будь таким жестоким, пожалуйста!"
    voice "voice/olya/3day/36 Ne.ogg"
    Oly "Не будзь такім жорсткім, калі ласка!"

# game/scripts/scene/scene_day_3.rpy:7252
translate belarusian day3_goosehunt_6a3205a1:

    # "Оля прижала ноги к подбородку и обхватила их руками, пытаясь сжаться сильнее."
    "Оля прыціснула ногі да падбародка і абхапіла іх рукамі, спрабуючы сціснуцца мацней."

# game/scripts/scene/scene_day_3.rpy:7253
translate belarusian day3_goosehunt_8631f769:

    # "Будто она хотела стать ещё меньше, быть может, окончательно исчезнуть."
    "Быццам яна хацела стаць яшчэ меншай, быць можа, канчаткова знікнуць."

# game/scripts/scene/scene_day_3.rpy:7254
translate belarusian day3_goosehunt_dc656140:

    # "Это всё, что нам оставалось — пропасть без вести. Затеряться среди прочих сломанных игрушек."
    "Гэта ўсё, што нам заставалася — прапасці без вестак. Згубіцца сярод іншых зламаных цацак."

# game/scripts/scene/scene_day_3.rpy:7255
translate belarusian day3_goosehunt_79c12299:

    # "И больше никогда не попадаться озлобленным родителям и взбешённым одноклассникам."
    "І больш ніколі не трапляцца азлобленым бацькам і шалёным аднакласнікам."

# game/scripts/scene/scene_day_3.rpy:7258
translate belarusian day3_goosehunt_f9108c8f:

    # "Мы единственные, кто остался друг у друга: те, кто может защитить, выслушать и пожалеть."
    "Мы адзіныя, хто застаўся адзін у аднаго: тыя, хто можа абараніць, выслухаць і пашкадаваць."

# game/scripts/scene/scene_day_3.rpy:7259
translate belarusian day3_goosehunt_a40b485e:

    # "А значит, она обязана слушать, что я думаю о них всех — этих озверевших тварях, притворяющихся детьми, так жаждущих издеваться над слабыми."
    "А значыць, яна абавязана слухаць, што я думаю пра іх усіх — гэтых азвярэлых стварэнняў, якія прыкідваюцца дзецьмі, якія так прагнуць здзекавацца са слабых."

# game/scripts/scene/scene_day_3.rpy:7260
translate belarusian day3_goosehunt_04ac3e1a:

    # "Мой черёд говорить."
    "Мая чарга казаць."

# game/scripts/scene/scene_day_3.rpy:7261
translate belarusian day3_goosehunt_13ce5b95:

    # voice "voice/anton/3day/25 D.ogg"
    # Ant "{i}Думаю, они не последние.{i}"
    voice "voice/anton/3day/25 D.ogg"
    Ant "{i}Думаю, яны не апошнія.{/i}"

# game/scripts/scene/scene_day_3.rpy:7264
translate belarusian day3_goosehunt_7abe357b:

    # "Моё дыхание участилось. Пальцы забарабанили по дощатому полу."
    "Маё дыханне пачасцілася. Пальцы забарабанілі па дашчанай падлозе."

# game/scripts/scene/scene_day_3.rpy:7266
translate belarusian day3_goosehunt_5979b601:

    # voice "voice/anton/3day/27 Ta.ogg"
    # Ant "{i}Такие люди, как они, недостойны жить, ходить с нами в одну школу...{i}"
    voice "voice/anton/3day/27 Ta.ogg"
    Ant "{i}Такія людзі, як яны, нягодныя жыць, хадзіць з намі ў адну школу...{/i}"

# game/scripts/scene/scene_day_3.rpy:7268
translate belarusian day3_goosehunt_6fda86c9:

    # voice "voice/anton/3day/28 S.ogg"
    # Ant "{i}… смотреть на твой свет.{i}"
    voice "voice/anton/3day/28 S.ogg"
    Ant "{i}… глядзець на тваё святло.{/i}"

# game/scripts/scene/scene_day_3.rpy:7270
translate belarusian day3_goosehunt_204eb195:

    # "Мысли путались, ускользали вслед за спокойствием."
    "Думкі блыталіся, выслізгвалі следам за спакоем."

# game/scripts/scene/scene_day_3.rpy:7273
translate belarusian day3_goosehunt_1c87c051:

    # voice "voice/olya/3day/37 To.ogg"
    # Oly "Тошенька, хватит! Ты меня пугаешь."
    voice "voice/olya/3day/37 To.ogg"
    Oly "Тошанька, хопіць! Ты мяне палохаеш."

# game/scripts/scene/scene_day_3.rpy:7275
translate belarusian day3_goosehunt_29d2d913:

    # voice "voice/anton/3day/29 Ne.ogg"
    # Ant "{i}Не бойся, я смогу тебя защитить.{i}"
    voice "voice/anton/3day/29 Ne.ogg"
    Ant "{i}Не бойся, я змагу цябе абараніць.{/i}"

# game/scripts/scene/scene_day_3.rpy:7279
translate belarusian day3_goosehunt_bbe90ca0:

    # "И тут я впервые заметил, как Оля смотрит на меня, словно на незнакомца."
    "І тут я ўпершыню заўважыў, як Оля глядзіць на мяне, быццам на незнаёмца."

# game/scripts/scene/scene_day_3.rpy:7280
translate belarusian day3_goosehunt_96f2087d:

    # voice "voice/olya/3day/38 Kto.ogg"
    # Oly "К-кто ты?"
    voice "voice/olya/3day/38 Kto.ogg"
    Oly "Х-хто ты?"

# game/scripts/scene/scene_day_3.rpy:7286
translate belarusian day3_goosehunt_05736369:

    # "Потаённая ярость отступила, спряталась за оболочкой труса, оставив меня один на один с нарастающим чувством стыда за то, что я напугал сестру."
    "Патаемная лютасць адступіла, схавалася за абалонкай баязліўца, пакінуўшы мяне сам-насам з пачуццём сораму, што ўсё нарастала, за тое, што я напалохаў сястру."

# game/scripts/scene/scene_day_3.rpy:7287
translate belarusian day3_goosehunt_8a8384ff:

    # voice "voice/anton/3day/30 Ol.ogg"
    # Ant "Оленька, прости, я... Я не хотел."
    voice "voice/anton/3day/30 Ol.ogg"
    Ant "Оленька, прабач, я... Я не хацеў."

# game/scripts/scene/scene_day_3.rpy:7291
translate belarusian day3_goosehunt_2bcb01f4:

    # voice "voice/anton/3day/31 Vi.ogg"
    # Ant "Видимо, я схожу с ума в этой школе."
    voice "voice/anton/3day/31 Vi.ogg"
    Ant "Відаць, я вар'яцею ў гэтай школе."

# game/scripts/scene/scene_day_3.rpy:7295
translate belarusian day3_goosehunt_70c0e300:

    # "Она бросилась мне на шею, едва сдерживая слёзы."
    "Яна кінулася мне на шыю, ледзь стрымліваючы слёзы."

# game/scripts/scene/scene_day_3.rpy:7296
translate belarusian day3_goosehunt_682c2eaf:

    # voice "voice/olya/3day/39 V.ogg"
    # Oly "Всё хорошо, Тоша, только, пожалуйста-пожалуйста, никогда так больше не говори."
    voice "voice/olya/3day/39 V.ogg"
    Oly "Усё добра, Тоша, толькі, калі ласка-калі ласка, ніколі так больш не кажы."

# game/scripts/scene/scene_day_3.rpy:7298
translate belarusian day3_goosehunt_701d1213:

    # voice "voice/anton/3day/32 K.ogg"
    # Ant "Клянусь маминым сердцем."
    voice "voice/anton/3day/32 K.ogg"
    Ant "Клянуся маміным сэрцам."

# game/scripts/scene/scene_day_3.rpy:7300
translate belarusian day3_goosehunt_1d4eda92:

    # "Оля горько улыбнулась."
    "Оля горка ўсміхнулася."

# game/scripts/scene/scene_day_3.rpy:7303
translate belarusian day3_goosehunt_7dcf1617:

    # voice "voice/olya/3day/40 A.ogg"
    # Oly "А сам сказал, что так говорить нехорошо..."
    voice "voice/olya/3day/40 A.ogg"
    Oly "А сам сказаў, што так казаць нядобра..."

# game/scripts/scene/scene_day_3.rpy:7321
translate belarusian day3_goosehunt_8b431be7:

    # voice "voice/anton/3day/33 T.ogg"
    # Ant "Ты права. Давай лучше играть."
    voice "voice/anton/3day/33 T.ogg"
    Ant "Ты маеш рацыю. Давай лепш гуляць."

# game/scripts/scene/scene_day_3.rpy:7339
translate belarusian day3_goosehunt_b90f0b70:

    # voice "voice/olya/3day/41 To.ogg"
    # Oly "Только, чур, я первая!"
    voice "voice/olya/3day/41 To.ogg"
    Oly "Толькі, чур, я першая!"

# game/scripts/scene/scene_day_3.rpy:7419
translate belarusian day3_goose_round_1_79c3a653:

    # voice "voice/olya/3day/47 S.ogg"
    # Oly "Считай, это я тебе поддалась."
    voice "voice/olya/3day/47 S.ogg"
    Oly "Лічы, гэта я табе паддалася."

# game/scripts/scene/scene_day_3.rpy:7430
translate belarusian day3_goose_round_1_56dd8ef9:

    # voice "voice/olya/3day/50 M.ogg"
    # Oly "Метко, ничего не скажешь."
    voice "voice/olya/3day/50 M.ogg"
    Oly "Трапна, нічога не скажаш."

# game/scripts/scene/scene_day_3.rpy:7441
translate belarusian day3_goose_round_1_85738752:

    # voice "voice/olya/3day/44 Nu.ogg"
    # Oly "Ну-ка, от винта!"
    voice "voice/olya/3day/44 Nu.ogg"
    Oly "Ну-ка, ад вінта!"

# game/scripts/scene/scene_day_3.rpy:7520
translate belarusian day3_goose_round_2_71c23c46:

    # voice "voice/olya/3day/48 bu.ogg"
    # Oly "Бу! Это ты виноват, что я промазала."
    voice "voice/olya/3day/48 bu.ogg"
    Oly "Бу! Гэта ты вінаваты, што я прамахнулася."

# game/scripts/scene/scene_day_3.rpy:7531
translate belarusian day3_goose_round_2_c137d747:

    # voice "voice/olya/3day/51 Hor.ogg"
    # Oly "Хорош! Почти как я."
    voice "voice/olya/3day/51 Hor.ogg"
    Oly "Добры! Амаль як я."

# game/scripts/scene/scene_day_3.rpy:7542
translate belarusian day3_goose_round_2_50ca3a26:

    # voice "voice/olya/3day/45 Kto.ogg"
    # Oly "Ха! Кто на новенького?"
    voice "voice/olya/3day/45 Kto.ogg"
    Oly "Ха! Хто на новенькага?"

# game/scripts/scene/scene_day_3.rpy:7627
translate belarusian day3_goose_round_3_9dec04d2:

    # voice "voice/olya/3day/43Ne.ogg"
    # Oly "Несчитово! Ты ближе к экрану стоял. Я с тобой так больше не играю!"
    voice "voice/olya/3day/43Ne.ogg"
    Oly "Не лічыцца! Ты бліжэй да экрана стаяў. Я з табой так больш не гуляю!"

# game/scripts/scene/scene_day_3.rpy:7639
translate belarusian day3_goose_round_3_7f59a4a0:

    # voice "voice/olya/3day/52 Au.ogg"
    # Oly "А у нас, Тоша, ничья."
    voice "voice/olya/3day/52 Au.ogg"
    Oly "А ў нас, Тоша, нічыя."

# game/scripts/scene/scene_day_3.rpy:7655
translate belarusian day3_goose_round_3_458a6d85:

    # voice "voice/olya/3day/42 Pif.ogg"
    # Oly "Пиф-паф! Ой-ой-ой! Умирает зайчик мой. Ха-ха! Ты проиграл, Тоша."
    voice "voice/olya/3day/42 Pif.ogg"
    Oly "Піф-паф! Ой-ой-ой! Памірае зайчык мой. Ха-ха! Ты прайграў, Тоша."

# game/scripts/scene/scene_day_3.rpy:7710
translate belarusian dendy_jack_turnoff_6c1708d2:

    # voice "voice/anton/3day/47 Po.ogg"
    # Ant "Поиграли и будет."
    voice "voice/anton/3day/47 Po.ogg"
    Ant "Пагулялі і хопіць."

# game/scripts/scene/scene_day_3.rpy:7758
translate belarusian dev_d3_polinacall_end_2e72ad77:

    # "Мама докричалась до меня только с третьего раза."
    "Мама дакрычалася да мяне толькі з трэцяга разу."

# game/scripts/scene/scene_day_3.rpy:7761
translate belarusian dev_d3_polinacall_end_85f4eae0:

    # voice "voice/karina/3day/122 Teb.ogg"
    # Mam "Антон! Тебя к телефону!"
    voice "voice/karina/3day/122 Teb.ogg"
    Mam "Антон! Цябе да тэлефона!"

# game/scripts/scene/scene_day_3.rpy:7764
translate belarusian dev_d3_polinacall_end_e4154753:

    # voice "voice/karina/3day/123 Dev.ogg"
    # Mam "Девочка какая-то."
    voice "voice/karina/3day/123 Dev.ogg"
    Mam "Дзяўчынка нейкая."

# game/scripts/scene/scene_day_3.rpy:7771
translate belarusian dev_d3_polinacall_end_d22c2df4:

    # "Моментально протрезвев, я метнулся в коридор."
    "Імгненна працверазеўшы, я кінуўся ў калідор."

# game/scripts/scene/scene_day_3.rpy:7777
translate belarusian dev_d3_polinacall_end_8ada454c:

    # voice "voice/karina/3day/124 Ne.ogg"
    # Mam "Не споткнись смотри!"
    voice "voice/karina/3day/124 Ne.ogg"
    Mam "Не спатыкніся глядзі!"

# game/scripts/scene/scene_day_3.rpy:7786
translate belarusian dev_d3_polinacall_end_143d1e85:

    # "Я схватил трубку, прижал к груди, многозначительно глядя на маму."
    "Я схапіў слухаўку, прыціснуў да грудзей, шматзначна гледзячы на маму."

# game/scripts/scene/scene_day_3.rpy:7787
translate belarusian dev_d3_polinacall_end_e37576b0:

    # "Она лишь пожала плечами и удалилась в комнату, на ходу собирая разбросанные Олей игрушки."
    "Яна толькі паціснула плячыма і пайшла ў пакой, на хаду збіраючы раскіданыя Оляй цацкі."

# game/scripts/scene/scene_day_3.rpy:7793
translate belarusian dev_d3_polinacall_end_e41e11c0:

    # voice "voice/anton/3day/090 A.ogg"
    # Ant "Алло!"
    voice "voice/anton/3day/090 A.ogg"
    Ant "Алё!"

# game/scripts/scene/scene_day_3.rpy:7798
translate belarusian dev_d3_polinacall_end_1178423e:

    # voice "voice/Polina/3day/35 Utv.ogg"
    # Pol "У твоей мамы такой молодой голос."
    voice "voice/Polina/3day/35 Utv.ogg"
    Pol "У тваёй мамы такі малады голас."

# game/scripts/scene/scene_day_3.rpy:7802
translate belarusian dev_d3_polinacall_end_a395eee0:

    # voice "voice/anton/3day/091 Anu.ogg"
    # Ant "А... Ну да. Она сама молодая."
    voice "voice/anton/3day/091 Anu.ogg"
    Ant "А... Ну так. Яна сама маладая."

# game/scripts/scene/scene_day_3.rpy:7806
translate belarusian dev_d3_polinacall_end_f37965a8:

    # voice "voice/Polina/3day/36 Ne.ogg"
    # Pol "Не мешаю?"
    voice "voice/Polina/3day/36 Ne.ogg"
    Pol "Не перашкаджаю?"

# game/scripts/scene/scene_day_3.rpy:7810
translate belarusian dev_d3_polinacall_end_1fb51028:

    # voice "voice/anton/3day/092 Net.ogg"
    # Ant "Нет, что ты."
    voice "voice/anton/3day/092 Net.ogg"
    Ant "Не, што ты."

# game/scripts/scene/scene_day_3.rpy:7813
translate belarusian dev_d3_polinacall_end_5808c1e0:

    # "Знала бы она, как дорого мне может обойтись этот разговор, и чем я рискую, просто отвечая на звонок."
    "Ведала б яна, як дорага мне можа абысціся гэтая размова, і чым я рызыкую, проста адказваючы на званок."

# game/scripts/scene/scene_day_3.rpy:7816
translate belarusian dev_d3_polinacall_end_26721d51:

    # "На тумбочке лежали карандаш и потрёпанный блокнот."
    "На тумбачцы ляжалі аловак і патрапаны нататнік."

# game/scripts/scene/scene_day_3.rpy:7826
translate belarusian dev_d3_polinacall_end_e5ef19e3:

    # "Я взял их и принялся водить грифелем по бумаге, рисуя хаотичные завитки, так и норовящие соединиться в дурацкие сердечки."
    "Я ўзяў іх і пачаў вадзіць грыфелем па паперы, малюючы хаатычныя завіткі, якія так і намерваліся злучыцца ў дурныя сардэчкі."

# game/scripts/scene/scene_day_3.rpy:7837
translate belarusian day3_polinacall_solo_50ceacba:

    # voice "voice/Polina/3day/90 Ya.ogg"
    # Pol "Я тут подумала... Мне надо тебе сказать кое-что."
    voice "voice/Polina/3day/90 Ya.ogg"
    Pol "Я тут падумала... Мне трэба табе сказаць сёе-тое."

# game/scripts/scene/scene_day_3.rpy:7840
translate belarusian day3_polinacall_solo_60af9f29:

    # "Я застыл."
    "Я застыў."

# game/scripts/scene/scene_day_3.rpy:7843
translate belarusian day3_polinacall_solo_fe7ea42b:

    # "Не может быть! Неужели я ей нравлюсь?"
    "Не можа быць! Няўжо я ёй падабаюся?"

# game/scripts/scene/scene_day_3.rpy:7845
translate belarusian day3_polinacall_solo_1bd5210a:

    # voice "voice/Polina/3day/92 V.ogg"
    # Pol "В последнее время у тебя такой потерянный вид."
    voice "voice/Polina/3day/92 V.ogg"
    Pol "Апошнім часам у цябе такі разгублены выгляд."

# game/scripts/scene/scene_day_3.rpy:7847
translate belarusian day3_polinacall_solo_cc0d6b21:

    # voice "voice/Polina/3day/93 A.ogg"
    # Pol "А сегодня в школе на тебе буквально лица не было."
    voice "voice/Polina/3day/93 A.ogg"
    Pol "А сёння ў школе на табе літаральна твару не было."

# game/scripts/scene/scene_day_3.rpy:7853
translate belarusian day3_polinacall_solo_61a8c3cf:

    # "Я не находил слов. Сердце трепетало в ожидании."
    "Я не знаходзіў слоў. Сэрца трапятала ў чаканні."

# game/scripts/scene/scene_day_3.rpy:7855
translate belarusian day3_polinacall_solo_04a18908:

    # voice "voice/Polina/3day/94 Ya.ogg"
    # Pol "Я хочу сказать..."
    voice "voice/Polina/3day/94 Ya.ogg"
    Pol "Я хачу сказаць..."

# game/scripts/scene/scene_day_3.rpy:7858
translate belarusian day3_polinacall_solo_1f1650c2:

    # voice "voice/Polina/3day/95 Y.ogg"
    # Pol "Я на твоей стороне."
    voice "voice/Polina/3day/95 Y.ogg"
    Pol "Я на тваім баку."

# game/scripts/scene/scene_day_3.rpy:7863
translate belarusian day3_polinacall_solo_213f397a:

    # "В предвкушении Полининых слов улыбка растеклась по моим губам."
    "У прадчуванні Палініных слоў усмешка расцяклася па маіх вуснах."

# game/scripts/scene/scene_day_3.rpy:7867
translate belarusian day3_polinacall_solo_1b174b6e:

    # voice "voice/Polina/3day/96 E.ogg"
    # Pol "И мне тебя очень жаль."
    voice "voice/Polina/3day/96 E.ogg"
    Pol "І мне цябе вельмі шкада."

# game/scripts/scene/scene_day_3.rpy:7872
translate belarusian day3_polinacall_solo_3e4f6371:

    # voice "voice/Polina/3day/97 Ta.ogg"
    # Pol "Такие хорошие ребята, как ты, заслуживают большего."
    voice "voice/Polina/3day/97 Ta.ogg"
    Pol "Такія добрыя хлопцы, як ты, заслугоўваюць большага."

# game/scripts/scene/scene_day_3.rpy:7876
translate belarusian day3_polinacall_solo_ecece9d8:

    # voice "voice/Polina/3day/98 M.ogg"
    # Pol "Мне очень хочется верить, что однажды ты найдёшь в себе силы дать отпор, и другие перестанут тебя задирать."
    voice "voice/Polina/3day/98 M.ogg"
    Pol "Мне вельмі хочацца верыць, што аднойчы ты знойдзеш у сабе сілы даць адпор, і іншыя перастануць цябе задзіраць."

# game/scripts/scene/scene_day_3.rpy:7880
translate belarusian day3_polinacall_solo_1ebe9e51:

    # "Карандаш выпал из разжавшихся пальцев."
    "Аловак выпаў з разнятых пальцаў."

# game/scripts/scene/scene_day_3.rpy:7881
translate belarusian day3_polinacall_solo_94c42218:

    # "Это всё, что она мне скажет?"
    "Гэта ўсё, што яна мне скажа?"

# game/scripts/scene/scene_day_3.rpy:7883
translate belarusian day3_polinacall_solo_51f9a8c9:

    # voice "voice/Polina/3day/99 Mo.ogg"
    # Pol "Может, даже девушку найдёшь..."
    voice "voice/Polina/3day/99 Mo.ogg"
    Pol "Можа, нават дзяўчыну знойдзеш..."

# game/scripts/scene/scene_day_3.rpy:7886
translate belarusian day3_polinacall_solo_038bdee9:

    # "Она будто сомневалась в собственных словах."
    "Яна быццам сумнявалася ва ўласных словах."

# game/scripts/scene/scene_day_3.rpy:7887
translate belarusian day3_polinacall_solo_96bc9559:

    # voice "voice/Polina/3day/100 K.ogg"
    # Pol "Короче, знай: ты славный парень!"
    voice "voice/Polina/3day/100 K.ogg"
    Pol "Карацей, ведай: ты слаўны хлопец!"

# game/scripts/scene/scene_day_3.rpy:7889
translate belarusian day3_polinacall_solo_624e1679:

    # "Это был провал."
    "Гэта быў правал."

# game/scripts/scene/scene_day_3.rpy:7890
translate belarusian day3_polinacall_solo_ecbcbeb9:

    # "Вместо предложения погулять – сочувствие, будто к какому-то калеке."
    "Замест прапановы пагуляць — спачуванне, быццам да нейкага калекі."

# game/scripts/scene/scene_day_3.rpy:7891
translate belarusian day3_polinacall_solo_5667ebcd:

    # voice "voice/Polina/3day/101 T.ogg"
    # Pol "Ты тут?"
    voice "voice/Polina/3day/101 T.ogg"
    Pol "Ты тут?"

# game/scripts/scene/scene_day_3.rpy:7899
translate belarusian day3_polinacall_notsolo_0a04d95d:

    # voice "voice/Polina/3day/37 Ya.ogg"
    # Pol "Я прочла твои ответы."
    voice "voice/Polina/3day/37 Ya.ogg"
    Pol "Я прачытала твае адказы."

# game/scripts/scene/scene_day_3.rpy:7901
translate belarusian day3_polinacall_notsolo_55a1f3e1:

    # voice "voice/Polina/3day/38 A.ogg"
    # Pol "А тебе действительно «Кар-Мэн» нравится?"
    voice "voice/Polina/3day/38 A.ogg"
    Pol "А табе сапраўды «Кар-Мэн» падабаецца?"

# game/scripts/scene/scene_day_3.rpy:7905
translate belarusian day3_polinacall_notsolo_810315b8:

    # voice "voice/anton/3day/051 Mne.ogg"
    # Ant "Мне, если по правде, русский рок больше нравится."
    voice "voice/anton/3day/051 Mne.ogg"
    Ant "Мне, калі па праўдзе, рускі рок больш падабаецца."

# game/scripts/scene/scene_day_3.rpy:7907
translate belarusian day3_polinacall_notsolo_b996611e:

    # voice "voice/anton/3day/052 No.ogg"
    # Ant "Но я почему-то постеснялся это написать."
    voice "voice/anton/3day/052 No.ogg"
    Ant "Але я чамусьці пасаромеўся гэта напісаць."

# game/scripts/scene/scene_day_3.rpy:7913
translate belarusian day3_polinacall_notsolo_593e4e62:

    # voice "voice/Polina/3day/39 A.ogg"
    # Pol "А хочешь, Антоша, и я честной буду?"
    voice "voice/Polina/3day/39 A.ogg"
    Pol "А хочаш, Антоша, і я шчырай буду?"

# game/scripts/scene/scene_day_3.rpy:7915
translate belarusian day3_polinacall_notsolo_550ebf1d:

    # voice "voice/anton/3day/094 K.ogg"
    # Ant "Конечно."
    voice "voice/anton/3day/094 K.ogg"
    Ant "Вядома."

# game/scripts/scene/scene_day_3.rpy:7920
translate belarusian day3_polinacall_notsolo_df06e6bd:

    # "Карандаш вывел женский профиль, глаз, длинные ресницы."
    "Аловак вывеў жаночы профіль, вока, доўгія вейкі."

# game/scripts/scene/scene_day_3.rpy:7924
translate belarusian day3_polinacall_notsolo_a3ec4b82:

    # "Полина сказала полушёпотом, наверное, чтобы дедушка не услышал:"
    "Паліна сказала паўшэптам, напэўна, каб дзядуля не пачуў:"

# game/scripts/scene/scene_day_3.rpy:7925
translate belarusian day3_polinacall_notsolo_f42fbbdc:

    # voice "voice/Polina/3day/40 Mn.ogg"
    # Pol "Мне здесь ужасно тоскливо."
    voice "voice/Polina/3day/40 Mn.ogg"
    Pol "Мне тут жудасна маркотна."

# game/scripts/scene/scene_day_3.rpy:7930
translate belarusian day3_polinacall_notsolo_d8d75548:

    # voice "voice/anton/3day/095 Doma.ogg"
    # Ant "Дома?"
    voice "voice/anton/3day/095 Doma.ogg"
    Ant "Дома?"

# game/scripts/scene/scene_day_3.rpy:7932
translate belarusian day3_polinacall_notsolo_71a9e6a0:

    # voice "voice/Polina/3day/41 V.ogg"
    # Pol "В посёлке."
    voice "voice/Polina/3day/41 V.ogg"
    Pol "У пасёлку."

# game/scripts/scene/scene_day_3.rpy:7937
translate belarusian day3_polinacall_notsolo_e8738262:

    # voice "voice/Polina/3day/42 Z.ogg"
    # Pol "Здесь никогда ничего не происходит, а если происходит, то всякая гадость."
    voice "voice/Polina/3day/42 Z.ogg"
    Pol "Тут ніколі нічога не адбываецца, а калі адбываецца, то ўсялякае паскудства."

# game/scripts/scene/scene_day_3.rpy:7940
translate belarusian day3_polinacall_notsolo_36455264:

    # voice "voice/Polina/3day/43 E.ogg"
    # Pol "И дело даже не в пропавших детях."
    voice "voice/Polina/3day/43 E.ogg"
    Pol "І справа нават не ў зніклых дзецях."

# game/scripts/scene/scene_day_3.rpy:7942
translate belarusian day3_polinacall_notsolo_f6b2ec30:

    # voice "voice/Polina/3day/44 Zd.ogg"
    # Pol "Здесь музыки мало."
    voice "voice/Polina/3day/44 Zd.ogg"
    Pol "Тут музыкі мала."

# game/scripts/scene/scene_day_3.rpy:7946
translate belarusian day3_polinacall_notsolo_cce43d8b:

    # voice "voice/anton/3day/096 No.ogg"
    # Ant "Но у тебя же кассеты есть."
    voice "voice/anton/3day/096 No.ogg"
    Ant "Але ў цябе ж касеты ёсць."

# game/scripts/scene/scene_day_3.rpy:7948
translate belarusian day3_polinacall_notsolo_db06d603:

    # voice "voice/Polina/3day/45 Ya.ogg"
    # Pol "Я не про записи."
    voice "voice/Polina/3day/45 Ya.ogg"
    Pol "Я не пра запісы."

# game/scripts/scene/scene_day_3.rpy:7950
translate belarusian day3_polinacall_notsolo_d9627168:

    # voice "voice/Polina/3day/46 Ya.ogg"
    # Pol "Я про... ну, голос этого места."
    voice "voice/Polina/3day/46 Ya.ogg"
    Pol "Я пра... ну, голас гэтага месца."

# game/scripts/scene/scene_day_3.rpy:7955
translate belarusian day3_polinacall_notsolo_2191c862:

    # voice "voice/Polina/3day/47 On.ogg"
    # Pol "Он не мелодичный. Всё шуршит, как патефонная игла, скрипит, воет изредка."
    voice "voice/Polina/3day/47 On.ogg"
    Pol "Ён не меладычны. Усё шамаціць, як патэфонная іголка, рыпіць, вые зрэдку."

# game/scripts/scene/scene_day_3.rpy:7957
translate belarusian day3_polinacall_notsolo_7bef130e:

    # voice "voice/Polina/3day/48 T.ogg"
    # Pol "Тут неуютно, тесно очень."
    voice "voice/Polina/3day/48 T.ogg"
    Pol "Тут няўтульна, цесна вельмі."

# game/scripts/scene/scene_day_3.rpy:7959
translate belarusian day3_polinacall_notsolo_4d1f3b35:

    # voice "voice/Polina/3day/49 N.ogg"
    # Pol "Не знаю, как объяснить тебе."
    voice "voice/Polina/3day/49 N.ogg"
    Pol "Не ведаю, як растлумачыць табе."

# game/scripts/scene/scene_day_3.rpy:7964
translate belarusian day3_polinacall_notsolo_15304bb0:

    # "Грифель набросал дом, окружённый высокими деревьями."
    "Грыфель накідаў дом, акружаны высокімі дрэвамі."

# game/scripts/scene/scene_day_3.rpy:7965
translate belarusian day3_polinacall_notsolo_7921fd7b:

    # voice "voice/anton/3day/097 Ka.ogg"
    # Ant "Кажется, я тебя понимаю."
    voice "voice/anton/3day/097 Ka.ogg"
    Ant "Здаецца, я цябе разумею."

# game/scripts/scene/scene_day_3.rpy:7967
translate belarusian day3_polinacall_notsolo_9ec12408:

    # voice "voice/anton/3day/097 M.ogg"
    # Ant "Моя сестрёнка говорит, что чувствует себя заточённой в темницу."
    voice "voice/anton/3day/097 M.ogg"
    Ant "Мая сястрычка кажа, што адчувае сябе зачыненай у вязніцу."

# game/scripts/scene/scene_day_3.rpy:7971
translate belarusian day3_polinacall_notsolo_27384d9e:

    # voice "voice/Polina/3day/50 V.ogg"
    # Pol "Вот и я... Я очень люблю дедушку. И бросить его боюсь."
    voice "voice/Polina/3day/50 V.ogg"
    Pol "Вось і я... Я вельмі люблю дзядулю. І кінуць яго баюся."

# game/scripts/scene/scene_day_3.rpy:7973
translate belarusian day3_polinacall_notsolo_00cac59f:

    # voice "voice/Polina/3day/51 A.ogg"
    # Pol "А порой так хочется убежать. Далеко-далеко."
    voice "voice/Polina/3day/51 A.ogg"
    Pol "А часам так хочацца ўцячы. Далёка-далёка."

# game/scripts/scene/scene_day_3.rpy:7976
translate belarusian day3_polinacall_notsolo_114ae476:

    # "«{i}В лес,{/i} — подумал я отчуждённо, малюя хвойные лапы; — {i}Убежать в лес, чтобы снежинки падали на шерсть, и ветви закрыли от посторонних глаз{/i}»."
    "«{i}У лес,{/i} — падумаў я адчужана, малюючы хваёвыя лапы; — {i}Уцячы ў лес, каб сняжынкі падалі на поўсць, і галіны схавалі ад чужых вачэй{/i}»."

# game/scripts/scene/scene_day_3.rpy:7977
translate belarusian day3_polinacall_notsolo_ec8b8868:

    # voice "voice/anton/3day/098 Ya.ogg"
    # Ant "Я, когда рисую, будто путешествую."
    voice "voice/anton/3day/098 Ya.ogg"
    Ant "Я, калі малюю, быццам падарожнічаю."

# game/scripts/scene/scene_day_3.rpy:7982
translate belarusian day3_polinacall_notsolo_3a6fda37:

    # voice "voice/Polina/3day/52 Um.ogg"
    # Pol "У меня так же со скрипкой."
    voice "voice/Polina/3day/52 Um.ogg"
    Pol "У мяне так жа са скрыпкай."

# game/scripts/scene/scene_day_3.rpy:7988
translate belarusian day3_polinacall_notsolo_bd02a280:

    # voice "voice/Polina/3day/53 U.ogg"
    # Pol "Убегаю по смычку в небо."
    voice "voice/Polina/3day/53 U.ogg"
    Pol "Уцякаю па смычку ў неба."

# game/scripts/scene/scene_day_3.rpy:7994
translate belarusian day3_polinacall_notsolo_b60929ff:

    # "Я осознал, что рисую нож-бабочку. Зачеркнул."
    "Я ўсвядоміў, што малюю нож-матылёк. Закрэсліў."

# game/scripts/scene/scene_day_3.rpy:7995
translate belarusian day3_polinacall_notsolo_ddaf202c:

    # "Воспоминания о Ромке испортили настроение."
    "Успаміны пра Ромку сапсавалі настрой."

# game/scripts/scene/scene_day_3.rpy:7999
translate belarusian day3_polinacall_notsolo_cd703907:

    # "Сказать ей? Предупредить, что он замыслил?"
    "Сказаць ёй? Папярэдзіць, што ён задумаў?"

# game/scripts/scene/scene_day_3.rpy:8000
translate belarusian day3_polinacall_notsolo_8c6ba989:

    # "Сорвать его планы охмурить Полину?"
    "Сарваць яго планы закружыць Паліну?"

# game/scripts/scene/scene_day_3.rpy:8001
translate belarusian day3_polinacall_notsolo_1200929f:

    # "А как же команда Вольтрона? Всё-таки они были какими-никакими, но моими приятелями."
    "А як жа каманда Вальтрона? Усё ж такі яны былі якімі-ніякімі, але маімі прыяцелямі."

# game/scripts/scene/scene_day_3.rpy:8002
translate belarusian day3_polinacall_notsolo_30da81ac:

    # "И кем бы я стал, предав их?"
    "І кім бы я стаў, здрадзіўшы ім?"

# game/scripts/scene/scene_day_3.rpy:8022
translate belarusian bunny3_betray_true_2d8d3000:

    # voice "voice/anton/3day/102 Pol.ogg"
    # Ant "Полина?"
    voice "voice/anton/3day/102 Pol.ogg"
    Ant "Паліна?"

# game/scripts/scene/scene_day_3.rpy:8024
translate belarusian bunny3_betray_true_3153119f:

    # voice "voice/Polina/3day/54 Da.ogg"
    # Pol "Да?"
    voice "voice/Polina/3day/54 Da.ogg"
    Pol "Так?"

# game/scripts/scene/scene_day_3.rpy:8026
translate belarusian bunny3_betray_true_b0e98b62:

    # voice "voice/anton/3day/103YaHo.ogg"
    # Ant "Я хочу тебе кое в чём признаться..."
    voice "voice/anton/3day/103YaHo.ogg"
    Ant "Я хачу табе ў нечым прызнацца..."

# game/scripts/scene/scene_day_3.rpy:8028
translate belarusian bunny3_betray_true_276b3bc5:

    # voice "voice/anton/3day/103Rom.ogg"
    # Ant "Ромка... попросил меня об одной услуге."
    voice "voice/anton/3day/103Rom.ogg"
    Ant "Ромка... папрасіў мяне пра адну паслугу."

# game/scripts/scene/scene_day_3.rpy:8030
translate belarusian bunny3_betray_true_5be1f3e7:

    # "Слова вязли во рту, ускользали."
    "Словы вязлі ў роце, выслізгвалі."

# game/scripts/scene/scene_day_3.rpy:8031
translate belarusian bunny3_betray_true_2af57ce3:

    # "От напряжения я стал накручивать завитой провод на палец."
    "Ад напружання я стаў накручваць завіты провад на палец."

# game/scripts/scene/scene_day_3.rpy:8032
translate belarusian bunny3_betray_true_60802132:

    # voice "voice/Polina/3day/56 A.ogg"
    # Pol "Алло, Антош, я тебя плохо слышу."
    voice "voice/Polina/3day/56 A.ogg"
    Pol "Алё, Антош, я цябе дрэнна чую."

# game/scripts/scene/scene_day_3.rpy:8035
translate belarusian bunny3_betray_true_d71a65fa:

    # "Я громко выдохнул."
    "Я гучна выдыхнуў."

# game/scripts/scene/scene_day_3.rpy:8041
translate belarusian bunny3_betray_true_906caf06:

    # voice "voice/anton/3day/105 Romk.ogg"
    # Ant "Ромка сделал из меня маньяка."
    voice "voice/anton/3day/105 Romk.ogg"
    Ant "Ромка зрабіў з мяне маньяка."

# game/scripts/scene/scene_day_3.rpy:8043
translate belarusian bunny3_betray_true_117da0a2:

    # "В трубке повисло гудящее молчание."
    "У слухаўцы павісла гудучае маўчанне."

# game/scripts/scene/scene_day_3.rpy:8044
translate belarusian bunny3_betray_true_788e5b0e:

    # voice "voice/Polina/3day/57 Ha.ogg"
    # Pol "Ха! Что?"
    voice "voice/Polina/3day/57 Ha.ogg"
    Pol "Ха! Што?"

# game/scripts/scene/scene_day_3.rpy:8049
translate belarusian bunny3_betray_true_d713e4e8:

    # voice "voice/anton/3day/106 On.ogg"
    # Ant "Он попросил меня напасть на тебя..."
    voice "voice/anton/3day/106 On.ogg"
    Ant "Ён папрасіў мяне напасці на цябе..."

# game/scripts/scene/scene_day_3.rpy:8054
translate belarusian bunny3_betray_true_61f93e62:

    # voice "voice/anton/3day/106 Kak.ogg"
    # Ant "Как будто я какой-то монстр."
    voice "voice/anton/3day/106 Kak.ogg"
    Ant "Нібыта я нейкі монстр."

# game/scripts/scene/scene_day_3.rpy:8059
translate belarusian bunny3_betray_true_07e0a39e:

    # voice "voice/anton/3day/107 Aon.ogg"
    # Ant "А он бы тут же объявился и героически тебя спас."
    voice "voice/anton/3day/107 Aon.ogg"
    Ant "А ён бы адразу ж з'явіўся і гераічна цябе выратаваў."

# game/scripts/scene/scene_day_3.rpy:8064
translate belarusian bunny3_betray_true_8374fe9f:

    # voice "voice/anton/3day/107 ALe.ogg"
    # Ant "Алё, Полин?"
    voice "voice/anton/3day/107 ALe.ogg"
    Ant "Алё, Палін?"

# game/scripts/scene/scene_day_3.rpy:8070
translate belarusian bunny3_betray_true_185c8086:

    # "Она молчала, так что я подул в трубку."
    "Яна маўчала, так што я падзьмуў у слухаўку."

# game/scripts/scene/scene_day_3.rpy:8071
translate belarusian bunny3_betray_true_3ca87104:

    # voice "voice/Polina/3day/58 E.ogg"
    # Pol "И? Ты согласился?"
    voice "voice/Polina/3day/58 E.ogg"
    Pol "І? Ты пагадзіўся?"

# game/scripts/scene/scene_day_3.rpy:8073
translate belarusian bunny3_betray_true_6ddaa20e:

    # "Её голос стал серьёзным, более жёстким."
    "Яе голас стаў сур'ёзным, больш жорсткім."

# game/scripts/scene/scene_day_3.rpy:8076
translate belarusian bunny3_betray_true_d5fe154d:

    # voice "voice/anton/3day/109 Net.ogg"
    # Ant "Нет! Как ты могла подумать?"
    voice "voice/anton/3day/109 Net.ogg"
    Ant "Не! Як ты магла падумаць?"

# game/scripts/scene/scene_day_3.rpy:8081
translate belarusian bunny3_betray_true_6aeb9c34:

    # voice "voice/anton/3day/109 Ya.ogg"
    # Ant "Я ведь сказал тебе правду."
    voice "voice/anton/3day/109 Ya.ogg"
    Ant "Я ж сказаў табе праўду."

# game/scripts/scene/scene_day_3.rpy:8086
translate belarusian bunny3_betray_true_bbaed327:

    # voice "voice/anton/3day/110 AR.ogg"
    # Ant "А Ромка с Бяшей... После такого они мне больше не товарищи!"
    voice "voice/anton/3day/110 AR.ogg"
    Ant "А Ромка з Бяшам... Пасля такога яны мне больш не таварышы!"

# game/scripts/scene/scene_day_3.rpy:8090
translate belarusian bunny3_betray_true_d9a9cb3b:

    # voice "voice/Polina/3day/59 Ah.ogg"
    # Pol "Ах, Антон! Спасибо!"
    voice "voice/Polina/3day/59 Ah.ogg"
    Pol "Ах, Антон! Дзякуй!"

# game/scripts/scene/scene_day_3.rpy:8092
translate belarusian bunny3_betray_true_d2489e57:

    # voice "voice/Polina/3day/60 Ya.ogg"
    # Pol "Я так рада, что ты со мной."
    voice "voice/Polina/3day/60 Ya.ogg"
    Pol "Я так рада, што ты са мной."

# game/scripts/scene/scene_day_3.rpy:8094
translate belarusian bunny3_betray_true_92f488d7:

    # "Сердце заколотилось быстрее. Волнение потерять Полину передало эстафету трепету встречи."
    "Сэрца закалацілася хутчэй. Хваляванне страціць Паліну перадало эстафету трапятанню сустрэчы."

# game/scripts/scene/scene_day_3.rpy:8096
translate belarusian bunny3_betray_true_c9f34a3b:

    # voice "voice/Polina/3day/61 P.ogg"
    # Pol "Понимаю, как тебе было нелегко рассказать такое."
    voice "voice/Polina/3day/61 P.ogg"
    Pol "Разумею, як табе было нялёгка расказаць такое."

# game/scripts/scene/scene_day_3.rpy:8098
translate belarusian bunny3_betray_true_ad45a8d5:

    # voice "voice/Polina/3day/62 S.ogg"
    # Pol "Слушай, дедушка всегда говорил, что музыка лечит душу."
    voice "voice/Polina/3day/62 S.ogg"
    Pol "Слухай, дзядуля заўсёды казаў, што музыка лечыць душу."

# game/scripts/scene/scene_day_3.rpy:8100
translate belarusian bunny3_betray_true_b8d41ab8:

    # voice "voice/Polina/3day/63 H.ogg"
    # Pol "Хочешь, я тебе сыграю?"
    voice "voice/Polina/3day/63 H.ogg"
    Pol "Хочаш, я табе зайграю?"

# game/scripts/scene/scene_day_3.rpy:8102
translate belarusian bunny3_betray_true_d1a4b623:

    # voice "voice/anton/3day/111 Gd.ogg"
    # Ant "Где? В школе?"
    voice "voice/anton/3day/111 Gd.ogg"
    Ant "Дзе? У школе?"

# game/scripts/scene/scene_day_3.rpy:8104
translate belarusian bunny3_betray_true_039fc416:

    # voice "voice/Polina/3day/84 N.ogg"
    # Pol "Нет же. После школы."
    voice "voice/Polina/3day/84 N.ogg"
    Pol "Не ж бо. Пасля школы."

# game/scripts/scene/scene_day_3.rpy:8106
translate belarusian bunny3_betray_true_b75cebf9:

    # voice "voice/Polina/3day/85 P.ogg"
    # Pol "Придёшь завтра ко мне в гости?"
    voice "voice/Polina/3day/85 P.ogg"
    Pol "Прыйдзеш заўтра да мяне ў госці?"

# game/scripts/scene/scene_day_3.rpy:8110
translate belarusian bunny3_betray_true_b24650a1:

    # "Не веря в услышанное, я обронил карандаш."
    "Не верачы ў пачутае, я выпусціў аловак."

# game/scripts/scene/scene_day_3.rpy:8121
translate belarusian bunny3_betray_true_20462e04:

    # "А когда бросился вытаскивать его из-под тумбочки, что есть силы треснулся о неё лбом."
    "А калі кінуўся выцягваць яго з-пад тумбачкі, што ёсць сілы трэснуўся аб яе лбом."

# game/scripts/scene/scene_day_3.rpy:8125
translate belarusian bunny3_betray_true_ba00cba8:

    # voice "voice/anton/3day/113. Ko.ogg"
    # Ant "К-конечно... П-почему бы и нет?"
    voice "voice/anton/3day/113. Ko.ogg"
    Ant "К-вядома... Ч-чаму б і не?"

# game/scripts/scene/scene_day_3.rpy:8129
translate belarusian bunny3_betray_true_2fcd893d:

    # voice "voice/Polina/3day/86 T.ogg"
    # Pol "Тогда завтра после уроков, хорошо?"
    voice "voice/Polina/3day/86 T.ogg"
    Pol "Тады заўтра пасля ўрокаў, добра?"

# game/scripts/scene/scene_day_3.rpy:8131
translate belarusian bunny3_betray_true_e9c68c1f:

    # "На макушке медленно надувалась шишка, но я её почти не чувствовал."
    "На верхавіне павольна надзімалася гуза, але я яе амаль не адчуваў."

# game/scripts/scene/scene_day_3.rpy:8142
translate belarusian bunny3_betray_false_d64bd744:

    # "Да, порой Ромка вёл себя ужасно, бывал несправедлив к другим и помыкал слабыми."
    "Так, часам Ромка паводзіў сябе жудасна, бываў несправядлівы да іншых і памыкаў слабымі."

# game/scripts/scene/scene_day_3.rpy:8143
translate belarusian bunny3_betray_false_19ac9d5b:

    # "Но что-то мне подсказывало, что дружба для Ромки — не пустое слово."
    "Але нешта мне падказвала, што сяброўства для Ромкі — не пустое слова."

# game/scripts/scene/scene_day_3.rpy:8145
translate belarusian bunny3_betray_false_8208a088:

    # "Разве не о друзьях я мечтал всё это время на новом месте?"
    "Хіба не пра сяброў я марыў увесь гэты час на новым месцы?"

# game/scripts/scene/scene_day_3.rpy:8146
translate belarusian bunny3_betray_false_586ea07a:

    # "Пускай здесь они и были так же чудовищны, как вид на древний лес из моего окна."
    "Няхай тут яны і былі такія ж жахлівыя, як від на старажытны лес з майго акна."

# game/scripts/scene/scene_day_3.rpy:8147
translate belarusian bunny3_betray_false_4db2cfc6:

    # "Я сдвинул очки на лоб, потирая глаза."
    "Я ссунуў акуляры на лоб, паціраючы вочы."

# game/scripts/scene/scene_day_3.rpy:8154
translate belarusian bunny3_betray_false_ec812359:

    # voice "voice/anton/3day/114 p .ogg"
    # Ant "Эх, поскорей бы уже повзрослеть."
    voice "voice/anton/3day/114 p .ogg"
    Ant "Эх, хутчэй бы ўжо пасталець."

# game/scripts/scene/scene_day_3.rpy:8159
translate belarusian bunny3_betray_false_14c72694:

    # voice "voice/Polina/3day/87 D.ogg"
    # Pol "Думаешь, будет проще?"
    voice "voice/Polina/3day/87 D.ogg"
    Pol "Думаеш, будзе прасцей?"

# game/scripts/scene/scene_day_3.rpy:8166
translate belarusian day3_polinacall_phase2_fox_c3bee9e8:

    # "Не давая ответить, раздался дверной звонок."
    "Не даючы адказаць, раздаўся дзвярны званок."

# game/scripts/scene/scene_day_3.rpy:8169
translate belarusian day3_polinacall_phase2_fox_a302a7b4:

    # "Мой блуждающий взгляд ткнулся в дверь."
    "Мой блукаючы позірк уперся ў дзверы."

# game/scripts/scene/scene_day_3.rpy:8170
translate belarusian day3_polinacall_phase2_fox_0f648fb4:

    # "Это Ромка с Бяшей пришли репетировать, а я должен помочь им увести девочку, которая мне нравится."
    "Гэта Ромка з Бяшам прыйшлі рэпеціраваць, а я павінен дапамагчы ім звесці дзяўчынку, якая мне падабаецца."

# game/scripts/scene/scene_day_3.rpy:8173
translate belarusian day3_polinacall_phase2_fox_c51260a3:

    # "Придётся сделать вид, что я с ними. Ради Полины."
    "Давядзецца зрабіць выгляд, што я з імі. Дзеля Паліны."

# game/scripts/scene/scene_day_3.rpy:8177
translate belarusian day3_polinacall_phase2_fox_7cfc5ed9:

    # voice "voice/anton/3day/115 Pol.ogg"
    # Ant "Полин, подожди минутку."
    voice "voice/anton/3day/115 Pol.ogg"
    Ant "Палін, пачакай хвілінку."

# game/scripts/scene/scene_day_3.rpy:8188
translate belarusian day3_polinacall_phase2_fox_a57fbc7a:

    # "Сделав пару шагов, я прижался к дверному полотну."
    "Зрабіўшы пару крокаў, я прыціснуўся да дзвярнога палатна."

# game/scripts/scene/scene_day_3.rpy:8194
translate belarusian day3_polinacall_phase2_fox_2ed98cb9:

    # "Горевшая снаружи лампочка озаряла крыльцо, и в замёрзшем глазке различались два невысоких тёмных силуэта."
    "Лямпачка, якая гарэла звонку, асвячала ганак, і ў замерзлым вочку адрозніваліся два невысокія цёмныя сілуэты."

# game/scripts/scene/scene_day_3.rpy:8195
translate belarusian day3_polinacall_phase2_fox_026cc7e4:

    # "Явились, не запылились."
    "З'явіліся, не запыліліся."

# game/scripts/scene/scene_day_3.rpy:8196
translate belarusian day3_polinacall_phase2_fox_c22b159b:

    # voice "voice/anton/3day/116 Pod.ogg"
    # Ant "Подождите, я сейчас."
    voice "voice/anton/3day/116 Pod.ogg"
    Ant "Пачакайце, я зараз."

# game/scripts/scene/scene_day_3.rpy:8202
translate belarusian day3_polinacall_phase2_fox_ab5503ca:

    # "Вернувшись к телефону, я поднял трубку."
    "Вярнуўшыся да тэлефона, я падняў слухаўку."

# game/scripts/scene/scene_day_3.rpy:8207
translate belarusian day3_polinacall_phase2_fox_b8f740aa:

    # voice "voice/anton/3day/117P.ogg"
    # Ant "Мне надо бежать."
    voice "voice/anton/3day/117P.ogg"
    Ant "Мне трэба бегчы."

# game/scripts/scene/scene_day_3.rpy:8210
translate belarusian day3_polinacall_phase2_fox_286d35d3:

    # voice "voice/Polina/3day/88 Mn.ogg"
    # Pol "Мне тоже."
    voice "voice/Polina/3day/88 Mn.ogg"
    Pol "Мне таксама."

# game/scripts/scene/scene_day_3.rpy:8212
translate belarusian day3_polinacall_phase2_fox_77f7fa4f:

    # voice "voice/Polina/3day/89 S.ogg"
    # Pol "Спасибо, что выслушал."
    voice "voice/Polina/3day/89 S.ogg"
    Pol "Дзякуй, што выслухаў."

# game/scripts/scene/scene_day_3.rpy:8215
translate belarusian day3_polinacall_phase2_fox_ad6ddf8b:

    # "Гудки завибрировали в ухо."
    "Гудкі завібрыравалі ў вуха."

# game/scripts/scene/scene_day_3.rpy:8222
translate belarusian day3_polinacall_phase2_fox_2d818370:

    # "Я опустил трубку на рычаг и покосился на лестницу."
    "Я апусціў слухаўку на рычаг і скасіўся на лесвіцу."

# game/scripts/scene/scene_day_3.rpy:8223
translate belarusian day3_polinacall_phase2_fox_d615ec8a:

    # "Мама, увлечённая сериалами, не заметила трель."
    "Мама, захопленая серыяламі, не заўважыла трэль."

# game/scripts/scene/scene_day_3.rpy:8242
translate belarusian day3_polinacall_phase2_fox_3d41d291:

    # "Никого не предупредив, я натянул обувь и шапку, а затем выскользнул в темноту зимнего вечера."
    "Нікога не папярэдзіўшы, я нацягнуў абутак і шапку, а потым выслізнуў у цемру зімовага вечара."

# game/scripts/scene/scene_day_3.rpy:8275
translate belarusian day3_polinacall_phase2_fox_91524716:

    # "Ветер защипал щёки. Я поморгал, привыкая к сумеркам."
    "Вецер зашчыпаў шчокі. Я паміргаў, прызвычайваючыся да змроку."

# game/scripts/scene/scene_day_3.rpy:8276
translate belarusian day3_polinacall_phase2_fox_1a968b60:

    # "От леса тянуло холодом и смолистым запахом хвои, а где-то в поле трещал мороз."
    "Ад лесу цягнула холадам і смалістым пахам ігліцы, а недзе ў полі трашчаў мароз."

# game/scripts/scene/scene_day_3.rpy:8277
translate belarusian day3_polinacall_phase2_fox_f1a371aa:

    # "Впереди у калитки маячили две тени. Лишь рост позволял распознать в них моих одноклассников."
    "Наперадзе каля брамкі маячылі два цені. Толькі рост дазваляў распазнаць у іх маіх аднакласнікаў."

# game/scripts/scene/scene_day_3.rpy:8284
translate belarusian day3_polinacall_phase2_fox_7b5691dd:

    # "Я направился к забору, слушая вой ветра в ушах и монотонный скрип под подошвами."
    "Я накіраваўся да плота, слухаючы выццё ветру ў вушах і манатонны рып пад падэшвамі."

# game/scripts/scene/scene_day_3.rpy:8296
translate belarusian day3_polinacall_phase2_fox_03230067:

    # "Одна из фигур шевельнулась и плавно устремилась к чащобе, будто конькобежец по льду."
    "Адна з постацяў варухнулася і плаўна накіравалася да гушчару, быццам канькабежац па лёдзе."

# game/scripts/scene/scene_day_3.rpy:8297
translate belarusian day3_polinacall_phase2_fox_7b413ea3:

    # "Я замедлил шаг и коснулся очков, тщетно стараясь вычленить из мрака хоть какие-то детали."
    "Я запаволіў крок і дакрануўся да акуляраў, дарэмна стараючыся вылучыць з змроку хоць нейкія дэталі."

# game/scripts/scene/scene_day_3.rpy:8298
translate belarusian day3_polinacall_phase2_fox_9c62f274:

    # "Тревога опустилась на плечи, как невесомая снежинка."
    "Трывога апусцілася на плечы, як бязважкая сняжынка."

# game/scripts/scene/scene_day_3.rpy:8299
translate belarusian day3_polinacall_phase2_fox_7ec65e70:

    # "В животе закопошилась проснувшаяся змея. Стало тошно."
    "У жываце заварушылася абуджаная змяя. Стала млосна."

# game/scripts/scene/scene_day_3.rpy:8300
translate belarusian day3_polinacall_phase2_fox_368f1fb8:

    # "Я подумал о доме, о хлипкой крепости позади."
    "Я падумаў пра дом, пра кволую крэпасць ззаду."

# game/scripts/scene/scene_day_3.rpy:8301
translate belarusian day3_polinacall_phase2_fox_a5beff51:

    # "Мама и Оля сидят в тепле перед телевизором на втором этаже и непринуждённо следят за похождениями героев «Санта-Барбары»."
    "Мама і Оля сядзяць у цяпле перад тэлевізарам на другім паверсе і нязмушана сочаць за прыгодамі герояў «Санта-Барбары»."

# game/scripts/scene/scene_day_3.rpy:8302
translate belarusian day3_polinacall_phase2_fox_cd5e4370:

    # "Мне совсем не хотелось участвовать в Ромкиных постановках."
    "Мне зусім не хацелася ўдзельнічаць у Ромкіных пастаноўках."

# game/scripts/scene/scene_day_3.rpy:8303
translate belarusian day3_polinacall_phase2_fox_44fff8e5:

    # "И ещё сильнее не хотелось идти туда, где на зимнем ветру колыхалась раздвоенная тень."
    "І яшчэ мацней не хацелася ісці туды, дзе на зімовым ветры калыхаўся раздвоены цень."

# game/scripts/scene/scene_day_3.rpy:8305
translate belarusian day3_polinacall_phase2_fox_d4df2403:

    # voice "voice/byasha/3day/154 nu.ogg"
    # Bya "Ну что застрял, на?"
    voice "voice/byasha/3day/154 nu.ogg"
    Bya "Ну што затрымаўся, на?"

# game/scripts/scene/scene_day_3.rpy:8307
translate belarusian day3_polinacall_phase2_fox_4b6b59ba:

    # voice "voice/byasha/3day/154 M.ogg"
    # Bya "Мы тут замёрзли совсем!"
    voice "voice/byasha/3day/154 M.ogg"
    Bya "Мы тут змерзлі зусім!"

# game/scripts/scene/scene_day_3.rpy:8309
translate belarusian day3_polinacall_phase2_fox_64578e8d:

    # "Голос Бяши буквально дрожал, а нетерпеливый Ромка пускал клубы пара у тёмных сосен. Такой влюблённый и задумчивый."
    "Голас Бяшы літаральна дрыжаў, а нецярплівы Ромка пускаў клубы пары каля цёмных соснаў. Такі закаханы і задуменны."

# game/scripts/scene/scene_day_3.rpy:8310
translate belarusian day3_polinacall_phase2_fox_1331160c:

    # voice "voice/byasha/3day/155 do.ogg"
    # Bya "До костей продрогли, на."
    voice "voice/byasha/3day/155 do.ogg"
    Bya "Да касцей прамерзлі, на."

# game/scripts/scene/scene_day_3.rpy:8312
translate belarusian day3_polinacall_phase2_fox_446bffc3:

    # voice "voice/byasha/3day/156 Sh.ogg"
    # Bya "Шевелись..."
    voice "voice/byasha/3day/156 Sh.ogg"
    Bya "Варушыся..."

# game/scripts/scene/scene_day_3.rpy:8314
translate belarusian day3_polinacall_phase2_fox_2a333df0:

    # voice "voice/anton/3day/118 E.ogg"
    # Ant "Да иду, иду..."
    voice "voice/anton/3day/118 E.ogg"
    Ant "Ды іду, іду..."

# game/scripts/scene/scene_day_3.rpy:8329
translate belarusian day3_polinacall_phase2_fox_c3e5ba36:

    # "Я глубоко вдохнул и пошёл, пиная сугробы."
    "Я глыбока ўдыхнуў і пайшоў, штурхаючы гурбы."

# game/scripts/scene/scene_day_3.rpy:8333
translate belarusian day3_polinacall_phase2_fox_f37ce710:

    # "Бяша замер лицом к тайге."
    "Бяша замер тварам да тайгі."

# game/scripts/scene/scene_day_3.rpy:8334
translate belarusian day3_polinacall_phase2_fox_044d105e:

    # "До него было рукой подать, и я зачем-то положил озябшую кисть ему на плечо — наверное, убедиться, что это всё не сон."
    "Да яго было рукой падаць, і я чамусьці паклаў азяблую кісць яму на плячо — напэўна, пераканацца, што гэта ўсё не сон."

# game/scripts/scene/scene_day_3.rpy:8340
translate belarusian day3_polinacall_phase2_fox_de9052ee:

    # "В мою сторону торчал острый клюв, со всех сторон усеянный мохнатыми перьями, из которых складывалась морда совы."
    "У мой бок тырчала вострая дзюба, з усіх бакоў усеяная касматым пер'ем, з якога складалася морда савы."

# game/scripts/scene/scene_day_3.rpy:8343
translate belarusian day3_polinacall_phase2_fox_9622065a:

    # "Нечто в птичьей маске таращилось на меня."
    "Нешта ў птушынай масцы вылупілася на мяне."

# game/scripts/scene/scene_day_3.rpy:8344
translate belarusian day3_polinacall_phase2_fox_fbf307aa:

    # voice "voice/Owl/3day/01Do.ogg"
    # Owl "У-ху, до самых косточек."
    voice "voice/Owl/3day/01Do.ogg"
    Owl "У-ху, да самых костачак."

# game/scripts/scene/scene_day_3.rpy:8346
translate belarusian day3_polinacall_phase2_fox_40c878b0:

    # "Голос был точь-в-точь Бяшин, но за перьями и картоном таился некто иной."
    "Голас быў кропля ў кроплю Бяшын, але за пер'ем і кардонам таіўся хтосьці іншы."

# game/scripts/scene/scene_day_3.rpy:8366
translate belarusian day3_polinacall_phase2_fox_5cbc4a5d:

    # "Я рванул прочь, словно меня стегнули нагайкой."
    "Я ірвануў прэч, быццам мяне сцебанулі нагайкай."

# game/scripts/scene/scene_day_3.rpy:8367
translate belarusian day3_polinacall_phase2_fox_1b6468fc:

    # "Существо в маске лишь притворялось Бяшей..."
    "Істота ў масцы толькі прыкідвалася Бяшам..."

# game/scripts/scene/scene_day_3.rpy:8368
translate belarusian day3_polinacall_phase2_fox_ed633275:

    # Ant_m "«{i}Чтобы выманить меня!{/i}»"
    Ant_m "«{i}Каб выманіць мяне!{/i}»"

# game/scripts/scene/scene_day_3.rpy:8376
translate belarusian day3_polinacall_phase2_notfox_d30794d7:

    # "Не давая ответить, Оля спустилась по ступенькам."
    "Не даючы адказаць, Оля спусцілася па прыступках."

# game/scripts/scene/scene_day_3.rpy:8389
translate belarusian day3_polinacall_phase2_notfox_0108f33b:

    # "В её руке была зажата книжка с розовой обложкой: «Энциклопедия маленьких принцесс»."
    "У яе руцэ была заціснутая кніжка з ружовай вокладкай: «Энцыклапедыя маленькіх прынцэс»."

# game/scripts/scene/scene_day_3.rpy:8395
translate belarusian day3_polinacall_phase2_notfox_5d0dcffb:

    # voice "voice/olya/3day/01 T.ogg"
    # Oly "Ты долго ещё?"
    voice "voice/olya/3day/01 T.ogg"
    Oly "Ты доўга яшчэ?"

# game/scripts/scene/scene_day_3.rpy:8398
translate belarusian day3_polinacall_phase2_notfox_059fe1d8:

    # "Я прикрыл ладонью трубку."
    "Я прыкрыў далонню слухаўку."

# game/scripts/scene/scene_day_3.rpy:8399
translate belarusian day3_polinacall_phase2_notfox_faf6c0c1:

    # voice "voice/anton/3day/120Ya.ogg"
    # Ant "Я разговариваю."
    voice "voice/anton/3day/120Ya.ogg"
    Ant "Я размаўляю."

# game/scripts/scene/scene_day_3.rpy:8401
translate belarusian day3_polinacall_phase2_notfox_de34c3c3:

    # voice "voice/anton/3day/121Ch.ogg"
    # Ant "Что случилось?"
    voice "voice/anton/3day/121Ch.ogg"
    Ant "Што здарылася?"

# game/scripts/scene/scene_day_3.rpy:8404
translate belarusian day3_polinacall_phase2_notfox_ff92a77d:

    # voice "voice/olya/3day/02 Po.ogg"
    # Oly "Почитай мне, пожалуйста."
    voice "voice/olya/3day/02 Po.ogg"
    Oly "Пачытай мне, калі ласка."

# game/scripts/scene/scene_day_3.rpy:8408
translate belarusian day3_polinacall_phase2_notfox_52975dd2:

    # voice "voice/olya/3day/03 M.ogg"
    # Oly "Мама уснула."
    voice "voice/olya/3day/03 M.ogg"
    Oly "Мама заснула."

# game/scripts/scene/scene_day_3.rpy:8411
translate belarusian day3_polinacall_phase2_notfox_4516d61b:

    # voice "voice/anton/3day/122 Ed.ogg"
    # Ant "Иди к себе. Я сейчас."
    voice "voice/anton/3day/122 Ed.ogg"
    Ant "Ідзі да сябе. Я зараз."

# game/scripts/scene/scene_day_3.rpy:8414
translate belarusian day3_polinacall_phase2_notfox_29992867:

    # voice "voice/olya/3day/04 To.ogg"
    # Oly "Только быстрее, ладно?"
    voice "voice/olya/3day/04 To.ogg"
    Oly "Толькі хутчэй, добра?"

# game/scripts/scene/scene_day_3.rpy:8417
translate belarusian day3_polinacall_phase2_notfox_e2982745:

    # voice "voice/anton/3day/123La.ogg"
    # Ant "Ладно!"
    voice "voice/anton/3day/123La.ogg"
    Ant "Добра!"

# game/scripts/scene/scene_day_3.rpy:8422
translate belarusian day3_polinacall_phase2_notfox_d075eea4:

    # "Последнее слово прозвучало излишне раздражённо. Я вздохнул, наблюдая, как сестра семенит по лестнице."
    "Апошняе слова прагучала залішне раздражнёна. Я ўздыхнуў, назіраючы, як сястра дробніць па лесвіцы."

# game/scripts/scene/scene_day_3.rpy:8426
translate belarusian day3_polinacall_phase2_notfox_2dbe9f9c:

    # voice "voice/anton/3day/125Pr.ogg"
    # Ant "Прости, надо бежать."
    voice "voice/anton/3day/125Pr.ogg"
    Ant "Прабач, трэба бегчы."

# game/scripts/scene/scene_day_3.rpy:8428
translate belarusian day3_polinacall_phase2_notfox_286d35d3:

    # voice "voice/Polina/3day/88 Mn.ogg"
    # Pol "Мне тоже."
    voice "voice/Polina/3day/88 Mn.ogg"
    Pol "Мне таксама."

# game/scripts/scene/scene_day_3.rpy:8430
translate belarusian day3_polinacall_phase2_notfox_77f7fa4f:

    # voice "voice/Polina/3day/89 S.ogg"
    # Pol "Спасибо, что выслушал."
    voice "voice/Polina/3day/89 S.ogg"
    Pol "Дзякуй, што выслухаў."

# game/scripts/scene/scene_day_3.rpy:8433
translate belarusian day3_polinacall_phase2_notfox_b4ae2974:

    # "Гудки завибрировали в ухо.Я опустил трубку на рычаг."
    "Гудкі завібрыравалі ў вуха. Я апусціў слухаўку на рычаг."

# game/scripts/scene/scene_day_3.rpy:8439
translate belarusian day3_polinacall_phase2_notfox_8818f57b:

    # "Размышляя о девочке, за которую мне грозит смерть от ножа, я поплёлся на второй этаж."
    "Разважаючы пра дзяўчынку, за якую мне пагражае смерць ад нажа, я паплёўся на другі паверх."

# game/scripts/scene/scene_day_3.rpy:8443
translate belarusian day3_polinacall_phase2_notfox_3d446b73:

    # voice "voice/anton/3day/099 AlePo.ogg"
    # Ant "Алё! Полина?"
    voice "voice/anton/3day/099 AlePo.ogg"
    Ant "Алё! Паліна?"

# game/scripts/scene/scene_day_3.rpy:8445
translate belarusian day3_polinacall_phase2_notfox_3a045ea8:

    # voice "voice/Polina/3day/102 Pr.ogg"
    # Pol "Прости, мне надо бежать."
    voice "voice/Polina/3day/102 Pr.ogg"
    Pol "Прабач, мне трэба бегчы."

# game/scripts/scene/scene_day_3.rpy:8448
translate belarusian day3_polinacall_phase2_notfox_0b9c88fd:

    # voice "voice/Polina/3day/103 Pre.ogg"
    # Pol "Представляешь, кое-кто втюрился в меня и теперь отирается у моих окон, требуя сходить с ним на свидание."
    voice "voice/Polina/3day/103 Pre.ogg"
    Pol "Уяўляеш, хтосьці ўцюрыўся ў мяне і цяпер аціраецца ля маіх вокнаў, патрабуючы схадзіць з ім на спатканне."

# game/scripts/scene/scene_day_3.rpy:8450
translate belarusian day3_polinacall_phase2_notfox_2771a01b:

    # voice "voice/Polina/3day/104 Po.ogg"
    # Pol "Пойду прогоню его, пока дедушка не проснулся."
    voice "voice/Polina/3day/104 Po.ogg"
    Pol "Пайду праганю яго, пакуль дзядуля не прачнуўся."

# game/scripts/scene/scene_day_3.rpy:8452
translate belarusian day3_polinacall_phase2_notfox_85f0f83f:

    # voice "voice/Polina/3day/105 H.ogg"
    # Pol "Хм, или, может, дать ему шанс?"
    voice "voice/Polina/3day/105 H.ogg"
    Pol "Хм, ці, можа, даць яму шанец?"

# game/scripts/scene/scene_day_3.rpy:8454
translate belarusian day3_polinacall_phase2_notfox_dc9bd59c:

    # "Я прикусил нижнюю губу от обиды."
    "Я прыкусіў ніжнюю губу ад крыўды."

# game/scripts/scene/scene_day_3.rpy:8455
translate belarusian day3_polinacall_phase2_notfox_5011bdaa:

    # voice "voice/Polina/3day/106 Es.ogg"
    # Pol "Если интересно — расскажу тебе завтра."
    voice "voice/Polina/3day/106 Es.ogg"
    Pol "Калі цікава — раскажу табе заўтра."

# game/scripts/scene/scene_day_3.rpy:8458
translate belarusian day3_polinacall_phase2_notfox_c1ba49d2:

    # voice "voice/Polina/3day/107 M.ogg"
    # Pol "Мы, в конце концов, друзья."
    voice "voice/Polina/3day/107 M.ogg"
    Pol "Мы, у рэшце рэшт, сябры."

# game/scripts/scene/scene_day_3.rpy:8462
translate belarusian day3_polinacall_phase2_notfox_b22fd947:

    # "Друзья. Хорошо хоть не подружки."
    "Сябры. Добра хоць не сяброўкі."

# game/scripts/scene/scene_day_3.rpy:8463
translate belarusian day3_polinacall_phase2_notfox_ddb58cf5:

    # voice "voice/anton/3day/100 Da.ogg"
    # Ant "М-да, конечно."
    voice "voice/anton/3day/100 Da.ogg"
    Ant "М-да, вядома."

# game/scripts/scene/scene_day_3.rpy:8465
translate belarusian day3_polinacall_phase2_notfox_8c6a4463:

    # voice "voice/anton/3day/101Do.ogg"
    # Ant "Доброй..."
    voice "voice/anton/3day/101Do.ogg"
    Ant "Дабра..."

# game/scripts/scene/scene_day_3.rpy:8468
translate belarusian day3_polinacall_phase2_notfox_d793aff4:

    # "Гудки ударили по мозгам."
    "Гудкі ўдарылі па мазгах."

# game/scripts/scene/scene_day_3.rpy:8477
translate belarusian day3_polinacall_phase2_notfox_968c8471:

    # "«{i}Потаскуха{/i}», — процедил злой голос в голове."
    "«{i}Шлёндра{/i}», — працадзіў злы голас у галаве."

# game/scripts/scene/scene_day_3.rpy:8478
translate belarusian day3_polinacall_phase2_notfox_0d8913fb:

    # "Словно зомби, лишённый покоя и рассудка, я поплёлся по лестнице."
    "Быццам зомбі, пазбаўлены спакою і розуму, я паплёўся па лесвіцы."

# game/scripts/scene/scene_day_3.rpy:8482
translate belarusian day3_polinacall_phase2_notfox_4f542cd1:

    # "Рассказать бы отцу. Попросить его мужского совета."
    "Расказаць бы бацьку. Папрасіць яго мужчынскай парады."

# game/scripts/scene/scene_day_3.rpy:8483
translate belarusian day3_polinacall_phase2_notfox_e7070c72:

    # "Но из-за новой работы его до поздней ночи не бывает дома."
    "Але з-за новай працы яго да позняй ночы не бывае дома."

# game/scripts/scene/scene_day_3.rpy:8484
translate belarusian day3_polinacall_phase2_notfox_c9d2c347:

    # "Родителям не до меня, если не сказать грубее."
    "Бацькам не да мяне, калі не сказаць грубей."

# game/scripts/scene/scene_day_3.rpy:8488
translate belarusian day3_polinacall_phase2_notfox_7bd02e0d:

    # voice "voice/anton/3day/126Nu.ogg"
    # Ant "Ну, где твоя книжка?"
    voice "voice/anton/3day/126Nu.ogg"
    Ant "Ну, дзе твая кніжка?"

# game/scripts/scene/scene_day_3.rpy:8493
translate belarusian day3_polinacall_phase2_notfox_66496bba:

    # "Я осёкся. Детская была пуста."
    "Я асекся. Дзіцячая была пустая."

# game/scripts/scene/scene_day_3.rpy:8494
translate belarusian day3_polinacall_phase2_notfox_551cc7e2:

    # voice "voice/anton/3day/127Ol.ogg"
    # Ant "Оль?"
    voice "voice/anton/3day/127Ol.ogg"
    Ant "Оль?"

# game/scripts/scene/scene_day_3.rpy:8498
translate belarusian day3_polinacall_phase2_notfox_0e5edc88:

    # "Наверное, пробралась ко мне."
    "Напэўна, прабралася да мяне."

# game/scripts/scene/scene_day_3.rpy:8500
translate belarusian day3_polinacall_phase2_notfox_f5b8f405:

    # "Я зашагал по коридору."
    "Я закрочыў па калідоры."

# game/scripts/scene/scene_day_3.rpy:8503
translate belarusian day3_polinacall_phase2_notfox_3755b207:

    # "Тени населяли комнату. Занавеска колыхалась, будто кто-то хоронился за ней."
    "Цені засялялі пакой. Фіранка калыхалася, быццам хтосьці хаваўся за ёй."

# game/scripts/scene/scene_day_3.rpy:8508
translate belarusian day3_polinacall_phase2_notfox_fed75dab:

    # "Я улыбнулся. Тихо прокрался к окну и распахнул штору."
    "Я ўсміхнуўся. Ціха пракраўся да акна і расхінуў штору."

# game/scripts/scene/scene_day_3.rpy:8547
translate belarusian day3_polinacall_phase2_notfox_46a27e17:

    # voice "voice/anton/3day/128 Po.ogg"
    # Ant "Попалась!"
    voice "voice/anton/3day/128 Po.ogg"
    Ant "Трапілася!"

# game/scripts/scene/scene_day_3.rpy:8549
translate belarusian day3_polinacall_phase2_notfox_ecb6e16a:

    # "За тканью никого не было."
    "За тканінай нікога не было."

# game/scripts/scene/scene_day_3.rpy:8550
translate belarusian day3_polinacall_phase2_notfox_cb597246:

    # "Окно, как экран телевизора, показывало зимний пейзаж."
    "Акно, як экран тэлевізара, паказвала зімовы пейзаж."

# game/scripts/scene/scene_day_3.rpy:8551
translate belarusian day3_polinacall_phase2_notfox_ba03f6dc:

    # "Фонарь, поле, и в самом его центре – бредущие фигурки."
    "Ліхтар, поле, і ў самым яго цэнтры — постаці, што брылі па снезе."

# game/scripts/scene/scene_day_3.rpy:8569
translate belarusian day3_polinacall_phase2_notfox_4cd14038:

    # "Алиса и Оля..."
    "Аліса і Оля..."

# game/scripts/scene/scene_day_3.rpy:8571
translate belarusian day3_polinacall_phase2_notfox_dc1cd1df:

    # "Я ахнул, прижав кулак ко рту, впился зубами в кожу."
    "Я ахнуў, прыціснуўшы кулак да рота, упіўся зубамі ў скуру."

# game/scripts/scene/scene_day_3.rpy:8592
translate belarusian day3_polinacall_phase2_notfox_f8c9ed5c:

    # "Алиса уводила в чащу мою сестру."
    "Аліса вяла ў гушчар маю сястру."

# game/scripts/scene/scene_day_3.rpy:8620
translate belarusian day3_polinacall_phase2_notfox_43976a4b:

    # "Понадобилось меньше минуты, чтобы я второпях оделся и вылетел из дому."
    "Спатрэбілася менш за хвіліну, каб я паспешліва апрануўся і вылецеў з дому."

# game/scripts/scene/scene_day_3.rpy:8646
translate belarusian day3_polinacall_phase2_notfox_3d07f08a:

    # "Сердце стучало пулемётной очередью."
    "Сэрца стукала кулямётнай чаргой."

# game/scripts/scene/scene_day_3.rpy:8652
translate belarusian day3_polinacall_phase2_notfox_1a968b60:

    # "От леса тянуло холодом и смолистым запахом хвои, а где-то в поле трещал мороз."
    "Ад лесу цягнула холадам і смалістым пахам ігліцы, а недзе ў полі трашчаў мароз."

# game/scripts/scene/scene_day_3.rpy:8659
translate belarusian day3_polinacall_phase2_notfox_caf29cb6:

    # "Впереди у калитки маячили две тени, лишь рост позволял распознать в них мою сестру и девочку-лисицу."
    "Наперадзе каля брамкі маячылі два цені, толькі рост дазваляў распазнаць у іх маю сястру і дзяўчынку-лісіцу."

# game/scripts/scene/scene_day_3.rpy:8661
translate belarusian day3_polinacall_phase2_notfox_81192f58:

    # "Я помчался к забору, слыша вой ветра в ушах и ритмичный скрип под подошвами."
    "Я паімчаўся да плота, чуючы выццё ветру ў вушах і рытмічны рып пад падэшвамі."

# game/scripts/scene/scene_day_3.rpy:8667
translate belarusian day3_polinacall_phase2_notfox_ab308d0c:

    # "Фигура повыше шевельнулась и устремилась к чащобе, плавно, будто конькобежец по льду."
    "Постаць вышэйшая варухнулася і накіравалася да гушчару, плаўна, быццам канькабежац па лёдзе."

# game/scripts/scene/scene_day_3.rpy:8668
translate belarusian day3_polinacall_phase2_notfox_7b413ea3:

    # "Я замедлил шаг и коснулся очков, тщетно стараясь вычленить из мрака хоть какие-то детали."
    "Я запаволіў крок і дакрануўся да акуляраў, дарэмна стараючыся вылучыць з змроку хоць нейкія дэталі."

# game/scripts/scene/scene_day_3.rpy:8669
translate belarusian day3_polinacall_phase2_notfox_9c62f274:

    # "Тревога опустилась на плечи, как невесомая снежинка."
    "Трывога апусцілася на плечы, як бязважкая сняжынка."

# game/scripts/scene/scene_day_3.rpy:8670
translate belarusian day3_polinacall_phase2_notfox_7ec65e70:

    # "В животе закопошилась проснувшаяся змея. Стало тошно."
    "У жываце заварушылася абуджаная змяя. Стала млосна."

# game/scripts/scene/scene_day_3.rpy:8671
translate belarusian day3_polinacall_phase2_notfox_368f1fb8:

    # "Я подумал о доме, о хлипкой крепости позади."
    "Я падумаў пра дом, пра кволую крэпасць ззаду."

# game/scripts/scene/scene_day_3.rpy:8683
translate belarusian day3_polinacall_phase2_notfox_8dd4bfed:

    # "Наконец я настиг сестрёнку, одетую в одну курточку."
    "Нарэшце я дагнаў сястрычку, апранутую ў адну куртачку."

# game/scripts/scene/scene_day_3.rpy:8686
translate belarusian day3_polinacall_phase2_notfox_424a142f:

    # voice "voice/anton/3day/130 Ol.ogg"
    # Ant "Оля!"
    voice "voice/anton/3day/130 Ol.ogg"
    Ant "Оля!"

# game/scripts/scene/scene_day_3.rpy:8688
translate belarusian day3_polinacall_phase2_notfox_ce1afac3:

    # voice "voice/olya/3day/05 T.ogg"
    # Oly "Ты видел лисичку?"
    voice "voice/olya/3day/05 T.ogg"
    Oly "Ты бачыў лісічку?"

# game/scripts/scene/scene_day_3.rpy:8690
translate belarusian day3_polinacall_phase2_notfox_73404473:

    # voice "voice/anton/3day/131 Olya.ogg"
    # Ant "Оля, зачем ты вышла на улицу?"
    voice "voice/anton/3day/131 Olya.ogg"
    Ant "Оля, навошта ты выйшла на вуліцу?"

# game/scripts/scene/scene_day_3.rpy:8692
translate belarusian day3_polinacall_phase2_notfox_367cdf19:

    # voice "voice/anton/3day/131 Es.ogg"
    # Ant "Если мама узнает..."
    voice "voice/anton/3day/131 Es.ogg"
    Ant "Калі мама даведаецца..."

# game/scripts/scene/scene_day_3.rpy:8696
translate belarusian day3_polinacall_phase2_notfox_aeaab666:

    # "Сестра замерла к тайге лицом."
    "Сястра замерла тварам да тайгі."

# game/scripts/scene/scene_day_3.rpy:8697
translate belarusian day3_polinacall_phase2_notfox_d351b67d:

    # "До неё было рукой подать, и я зачем-то положил озябшую кисть ей на плечо, наверное, убедиться, что это всё не сон."
    "Да яе было рукой падаць, і я чамусьці паклаў азяблую кісць ёй на плячо, напэўна, пераканацца, што гэта ўсё не сон."

# game/scripts/scene/scene_day_3.rpy:8704
translate belarusian day3_polinacall_phase2_notfox_de9052ee:

    # "В мою сторону торчал острый клюв, со всех сторон усеянный мохнатыми перьями, из которых складывалась морда совы."
    "У мой бок тырчала вострая дзюба, з усіх бакоў усеяная касматым пер'ем, з якога складалася морда савы."

# game/scripts/scene/scene_day_3.rpy:8705
translate belarusian day3_polinacall_phase2_notfox_9622065a:

    # "Нечто в птичьей маске таращилось на меня."
    "Нешта ў птушынай масцы вылупілася на мяне."

# game/scripts/scene/scene_day_3.rpy:8706
translate belarusian day3_polinacall_phase2_notfox_06b1f6ec:

    # voice "voice/olya/3day/06 Uxu.ogg"
    # Owl "У-ху, не узнает."
    voice "voice/olya/3day/06 Uxu.ogg"
    Owl "У-ху, не даведаецца."

# game/scripts/scene/scene_day_3.rpy:8710
translate belarusian day3_polinacall_phase2_notfox_6d022fa3:

    # "Голос был точь-в-точь Олин, но за перьями и картоном таился некто иной."
    "Голас быў кропля ў кроплю Олін, але за пер'ем і кардонам таіўся хтосьці іншы."

# game/scripts/scene/scene_day_3.rpy:8730
translate belarusian day3_polinacall_phase2_notfox_5cbc4a5d:

    # "Я рванул прочь, словно меня стегнули нагайкой."
    "Я ірвануў прэч, быццам мяне сцебанулі нагайкай."

# game/scripts/scene/scene_day_3.rpy:8731
translate belarusian day3_polinacall_phase2_notfox_eebc51ce:

    # "Существо в маске лишь притворялось Олей..."
    "Істота ў масцы толькі прыкідвалася Оляй..."

# game/scripts/scene/scene_day_3.rpy:8732
translate belarusian day3_polinacall_phase2_notfox_965b08a3:

    # Ant_m "{i}Чтобы выманить меня!{/i}"
    Ant_m "{i}Каб выманіць мяне!{/i}"

# game/scripts/scene/scene_day_3.rpy:8738
translate belarusian day3_night_1a7e13e9:

    # "Я бежал со всех ног, утопая в снегу."
    "Я бег з усіх ног, патанаючы ў снезе."

# game/scripts/scene/scene_day_3.rpy:8739
translate belarusian day3_night_1adeeaae:

    # "Дом впереди стремительно увеличивался."
    "Дом наперадзе імкліва павялічваўся."

# game/scripts/scene/scene_day_3.rpy:8740
translate belarusian day3_night_e80ff95d:

    # "Жёлтый свет в окнах дарил надежду."
    "Жоўтае святло ў вокнах дарыла надзею."

# game/scripts/scene/scene_day_3.rpy:8741
translate belarusian day3_night_6d7883c2:

    # "Там мама, сестра! Спасение!"
    "Там мама, сястра! Выратаванне!"

# game/scripts/scene/scene_day_3.rpy:8742
translate belarusian day3_night_9329db49:

    # "За спиной было тихо, как будто никто не гнался за мной."
    "За спінай было ціха, нібы ніхто не гнаўся за мной."

# game/scripts/scene/scene_day_3.rpy:8743
translate belarusian day3_night_413e8457:

    # "Может, потому что совы умеют летать?"
    "Можа, таму што совы ўмеюць лятаць?"

# game/scripts/scene/scene_day_3.rpy:8745
translate belarusian day3_night_d3dae374:

    # "Я уже карабкался по крыльцу, как вдруг краем глаза заметил ещё одну фигуру."
    "Я ўжо караскаўся па ганку, як раптам краем вока заўважыў яшчэ адну постаць."

# game/scripts/scene/scene_day_3.rpy:8751
translate belarusian day3_night_167d6185:

    # "Взъерошенный волчок выполз из угольной тени дома, преградив путь."
    "Ускудлачаны ваўчок выпаўз з вугальнага ценю дома, перагарадзіўшы шлях."

# game/scripts/scene/scene_day_3.rpy:8753
translate belarusian day3_night_27f4e767:

    # "Он двигался дёргано, хаотично, словно приплясывал какой-то жуткий танец..."
    "Ён рухаўся паторгана, хаатычна, быццам прытанцоўваў нейкі жудасны танец..."

# game/scripts/scene/scene_day_3.rpy:8755
translate belarusian day3_night_26d3a1a3:

    # "... или корчился в припадке."
    "... ці курчыўся ў прыпадку."

# game/scripts/scene/scene_day_3.rpy:8757
translate belarusian day3_night_c11dce73:

    # "И пускай я отчётливо видел, что волчья морда — обыкновенная маска, что-то в судорогах оборотня заставило меня окоченеть."
    "І няхай я выразна бачыў, што воўчая морда — звычайная маска, нешта ў сутаргах пярэваратня прымусіла мяне акалець."

# game/scripts/scene/scene_day_3.rpy:8759
translate belarusian day3_night_8711b342:

    # "Ряженый потёрся боком о столб крыльца и припал на четвереньки."
    "Пераапрануты пацёрся бокам аб слуп ганка і прыпаў на карачкі."

# game/scripts/scene/scene_day_3.rpy:8761
translate belarusian day3_night_cc7c08fe:

    # "Выгнулся так, что позвоночник должен был хрустнуть."
    "Выгнуўся так, што пазваночнік павінен быў хруснуць."

# game/scripts/scene/scene_day_3.rpy:8763
translate belarusian day3_night_07ddcbab:

    # "Глаза образины засверкали."
    "Вочы пачвары заззялі."

# game/scripts/scene/scene_day_3.rpy:8765
translate belarusian day3_night_a01638b7:

    # "Но зверь не нападал."
    "Але звер не нападаў."

# game/scripts/scene/scene_day_3.rpy:8767
translate belarusian day3_night_1c3f3bab:

    # "Он то ползал вокруг по-пластунски, то трусил на четырёх конечностях."
    "Ён то поўзаў вакол па-пластунску, то трусіў на чатырох канечнасцях."

# game/scripts/scene/scene_day_3.rpy:8769
translate belarusian day3_night_7992895b:

    # "С отвисшей челюстью я перебирал ногами, пытаясь удерживать его в поле зрения."
    "З адвіслай сківіцай я перабіраў нагамі, спрабуючы ўтрымліваць яго ў полі зроку."

# game/scripts/scene/scene_day_3.rpy:8771
translate belarusian day3_night_e1b1c613:

    # "Из-под прорезей маски сочилась жидкость. Тягучие капли падали на доски."
    "З-пад проразей маскі сачылася вадкасць. Цягучыя кроплі падалі на дошкі."

# game/scripts/scene/scene_day_3.rpy:8772
translate belarusian day3_night_0c9bd856:

    # "«Слюна», — догадался я."
    "«Сліна», — здагадаўся я."

# game/scripts/scene/scene_day_3.rpy:8777
translate belarusian day3_night_d0a6f63a:

    # "Какая-то сила толкнула в спину, шепнула: «{i}Спасайся!{i}»"
    "Нейкая сіла штурханула ў спіну, шапнула: «{i}Ратуйся!{/i}»"

# game/scripts/scene/scene_day_3.rpy:8785
translate belarusian day3_night_d5ff446b:

    # "Штакетины забора замельтешили."
    "Штакеціны плота замільгалі."

# game/scripts/scene/scene_day_3.rpy:8793
translate belarusian day3_night_c22f7918:

    # "Я снова бежал — в обратную сторону, к зубчатой и пахнущей хвоей кромке леса."
    "Я зноў бег — у адваротны бок, да зубчастага ўскрайку лесу, што пах ігліцай."

# game/scripts/scene/scene_day_3.rpy:8795
translate belarusian day3_night_1b917811:

    # "Удары сердца отмеряли время."
    "Удары сэрца адмяралі час."

# game/scripts/scene/scene_day_3.rpy:8796
translate belarusian day3_night_5b291001:

    # "Волчок позади, будто забыв человеческую речь, рычал:"
    "Ваўчок ззаду, быццам забыўшы чалавечую мову, рыкаў:"

# game/scripts/scene/scene_day_3.rpy:8797
translate belarusian day3_night_1b697ac1:

    # voice "voice/Wolf/308 GR.ogg"
    # Noname "Гр-р-р-р... Гр-р-р-р-р..."
    voice "voice/Wolf/308 GR.ogg"
    Noname "Гр-р-р-р... Гр-р-р-р-р..."

# game/scripts/scene/scene_day_3.rpy:8799
translate belarusian day3_night_99d1fcf3:

    # "Правая нога застряла в припорошенной лунке."
    "Правая нага затрымалася ў прыпарошанай лунцы."

# game/scripts/scene/scene_day_3.rpy:8800
translate belarusian day3_night_c3938cc3:

    # "Я выдернул её, чертыхаясь, и тут же рухнул на землю."
    "Я выдраў яе, чартыхаючыся, і адразу ж грымнуўся на зямлю."

# game/scripts/scene/scene_day_3.rpy:8801
translate belarusian day3_night_a6aaa2d8:

    # "Подо мной заструились зыбучие снега, мешая подняться, упереться во что-нибудь."
    "Пада мной заструменіліся сыпучыя снягі, перашкаджаючы падняцца, абаперціся аб што-небудзь."

# game/scripts/scene/scene_day_3.rpy:8802
translate belarusian day3_night_ee23910d:

    # "Но дикая жажда жизни буквально вырвала меня из ловушки."
    "Але дзікая прага жыцця літаральна вырвала мяне з пасткі."

# game/scripts/scene/scene_day_3.rpy:8803
translate belarusian day3_night_d3b965b1:

    # "Тьма подкрадывалась всё ближе, напоминая едкий дым погребальных костров. И я снова побежал, вдыхая колючий воздух."
    "Цемра падкрадвалася ўсё бліжэй, нагадваючы з'едлівы дым пахавальных вогнішчаў. І я зноў пабег, удыхаючы калючае паветра."

# game/scripts/scene/scene_day_3.rpy:8804
translate belarusian day3_night_14e9ce2e:

    # "Волосы развевались на ветру."
    "Валасы развяваліся на ветры."

# game/scripts/scene/scene_day_3.rpy:8805
translate belarusian day3_night_300c8747:

    # "Падая, я обронил шапку, и уши запекло от лютого мороза, пока сам я весь взмок от пота."
    "Падаючы, я выпусціў шапку, і вушы запякло ад лютага марозу, пакуль сам я ўвесь змок ад поту."

# game/scripts/scene/scene_day_3.rpy:8806
translate belarusian day3_night_07528e7a:

    # "Поле наконец закончилось."
    "Поле нарэшце скончылася."

# game/scripts/scene/scene_day_3.rpy:8808
translate belarusian day3_night_751b4f6d:

    # "Понимая, что было не лучшим решением мчаться в лес, я юркнул за деревья."
    "Разумеючы, што было не лепшым рашэннем імчацца ў лес, я шмыгнуў за дрэвы."

# game/scripts/scene/scene_day_3.rpy:8809
translate belarusian day3_night_07eefd08:

    # "Не останавливаясь, бежал, прикрывая ладонью лицо."
    "Не спыняючыся, бег, прыкрываючы далонню твар."

# game/scripts/scene/scene_day_3.rpy:8810
translate belarusian day3_night_90b35300:

    # "Чтобы случайный сук не лишил глаза."
    "Каб выпадковы сук не пазбавіў вачэй."

# game/scripts/scene/scene_day_3.rpy:8811
translate belarusian day3_night_d369cad4:

    # "Ветки били по одежде, кололи кожу, как мясники, гнавшие скотину прямиком в мясорубку."
    "Галлё біла па вопратцы, калола скуру, як мяснікі, якія гналі жывёлу наўпрост у мясарубку."

# game/scripts/scene/scene_day_3.rpy:8834
translate belarusian dev_bunny3_candyjumps_end_d23787c0:

    # "Узел выбившихся из почвы корней прихватил за стопу."
    "Вузел выбітых з глебы каранёў прыхапіў за ступню."

# game/scripts/scene/scene_day_3.rpy:8844
translate belarusian dev_bunny3_candyjumps_end_a23654dc:

    # "Я врезался в шершавый ствол, сполз к самому его основанию и в панике оглянулся."
    "Я ўрэзаўся ў шурпаты ствол, спаўз да самага яго падножжа і ў паніцы азірнуўся."

# game/scripts/scene/scene_day_3.rpy:8854
translate belarusian dev_bunny3_candyjumps_end_6658ba0c:

    # voice "voice/Alisa/3day/01 Uh.ogg"
    # Alis "Ух, какой ты быстрый!"
    voice "voice/Alisa/3day/01 Uh.ogg"
    Alis "Ух, які ты хуткі!"

# game/scripts/scene/scene_day_3.rpy:8857
translate belarusian dev_bunny3_candyjumps_end_06a57dbf:

    # "Первым желанием было кинуться к ней и обнять её."
    "Першым жаданнем было кінуцца да яе і абняць яе."

# game/scripts/scene/scene_day_3.rpy:8858
translate belarusian dev_bunny3_candyjumps_end_1d627136:

    # "Но я поборол себя и плотнее притиснулся к сосне."
    "Але я перамог сябе і шчыльней прыціснуўся да сасны."

# game/scripts/scene/scene_day_3.rpy:8859
translate belarusian dev_bunny3_candyjumps_end_5bbcfa1d:

    # voice "voice/anton/3day/133.Ti.ogg"
    # Ant "Ты... Что ты здесь делаешь?"
    voice "voice/anton/3day/133.Ti.ogg"
    Ant "Ты... Што ты тут робіш?"

# game/scripts/scene/scene_day_3.rpy:8865
translate belarusian dev_bunny3_candyjumps_end_2ae2c44e:

    # voice "voice/Alisa/3day/02 Da.ogg"
    # Alis "Да вот."
    voice "voice/Alisa/3day/02 Da.ogg"
    Alis "Ды вось."

# game/scripts/scene/scene_day_3.rpy:8867
translate belarusian dev_bunny3_candyjumps_end_b20198fb:

    # "Она протянула мне потерянную шапку."
    "Яна працягнула мне згубленую шапку."

# game/scripts/scene/scene_day_3.rpy:8868
translate belarusian dev_bunny3_candyjumps_end_afccd4f6:

    # voice "voice/Alisa/3day/03 V.ogg"
    # Alis "В бюро находок подрабатываю."
    voice "voice/Alisa/3day/03 V.ogg"
    Alis "У бюро знаходак падпрацоўваю."

# game/scripts/scene/scene_day_3.rpy:8870
translate belarusian dev_bunny3_candyjumps_end_cd96a14c:

    # voice "voice/Alisa/3day/04 N.ogg"
    # Alis "Надевай, а то уши замёрзнут, а потом, глядишь, и вовсе отвалятся."
    voice "voice/Alisa/3day/04 N.ogg"
    Alis "Надзявай, а то вушы змерзнуць, а потым, глядзіш, і зусім адваляцца."

# game/scripts/scene/scene_day_3.rpy:8873
translate belarusian dev_bunny3_candyjumps_end_d8e2c47f:

    # "Она хихикнула."
    "Яна хіхікнула."

# game/scripts/scene/scene_day_3.rpy:8874
translate belarusian dev_bunny3_candyjumps_end_fdaa5e55:

    # "Я подозрительно смотрел то на неё, то на шапку, будто боялся, что в руке Алисы окажется что-то вроде отрубленной головы — или ещё страшнее."
    "Я падазрона глядзеў то на яе, то на шапку, быццам баяўся, што ў руцэ Алісы апынецца нешта накшталт адсечанай галавы — ці яшчэ страшней."

# game/scripts/scene/scene_day_3.rpy:8875
translate belarusian dev_bunny3_candyjumps_end_6084c24e:

    # "Но шапка была просто шапкой."
    "Але шапка была проста шапкай."

# game/scripts/scene/scene_day_3.rpy:8885
translate belarusian dev_bunny3_candyjumps_end_7495fd83:

    # "Я забрал её, натянул по самые брови."
    "Я забраў яе, нацягнуў па самыя бровы."

# game/scripts/scene/scene_day_3.rpy:8886
translate belarusian dev_bunny3_candyjumps_end_79588491:

    # voice "voice/Alisa/3day/06 T.ogg"
    # Alis "Тепло?"
    voice "voice/Alisa/3day/06 T.ogg"
    Alis "Цёпла?"

# game/scripts/scene/scene_day_3.rpy:8888
translate belarusian dev_bunny3_candyjumps_end_7fe9a557:

    # "Я не ответил."
    "Я не адказаў."

# game/scripts/scene/scene_day_3.rpy:8897
translate belarusian dev_bunny3_candyjumps_end_e6b8f262:

    # voice "voice/anton/3day/134 Tam.ogg"
    # Ant "Там во дворе были какие-то дети."
    voice "voice/anton/3day/134 Tam.ogg"
    Ant "Там у двары былі нейкія дзеці."

# game/scripts/scene/scene_day_3.rpy:8900
translate belarusian dev_bunny3_candyjumps_end_5fac3ab4:

    # voice "voice/Alisa/3day/07 E.ogg"
    # Alis "И что? Покусали тебя, что ли?"
    voice "voice/Alisa/3day/07 E.ogg"
    Alis "І што? Пакусалі цябе, ці што?"

# game/scripts/scene/scene_day_3.rpy:8903
translate belarusian dev_bunny3_candyjumps_end_b0899b65:

    # voice "voice/anton/3day/135 net.ogg"
    # Ant "Нет..."
    voice "voice/anton/3day/135 net.ogg"
    Ant "Не..."

# game/scripts/scene/scene_day_3.rpy:8906
translate belarusian dev_bunny3_candyjumps_end_64731e00:

    # voice "voice/Alisa/3day/08 A.ogg"
    # Alis "А чего же ты убежал?"
    voice "voice/Alisa/3day/08 A.ogg"
    Alis "А чаго ж ты ўцёк?"

# game/scripts/scene/scene_day_3.rpy:8908
translate belarusian dev_bunny3_candyjumps_end_c647e0ba:

    # "Ответ был очевиден, но, покатав мысль на языке, я лишь пробурчал:"
    "Адказ быў відавочны, але, пакатаўшы думку на языку, я толькі прабурчаў:"

# game/scripts/scene/scene_day_3.rpy:8910
translate belarusian dev_bunny3_candyjumps_end_821821c7:

    # voice "voice/anton/3day/136 Nez.ogg"
    # Ant "Не знаю..."
    voice "voice/anton/3day/136 Nez.ogg"
    Ant "Не ведаю..."

# game/scripts/scene/scene_day_3.rpy:8913
translate belarusian dev_bunny3_candyjumps_end_1fe4f5de:

    # voice "voice/Alisa/3day/09 E.ogg"
    # Alis "Эх, обещала не обзывать тебя дурачком."
    voice "voice/Alisa/3day/09 E.ogg"
    Alis "Эх, абяцала не абзываць цябе дурненькім."

# game/scripts/scene/scene_day_3.rpy:8915
translate belarusian dev_bunny3_candyjumps_end_c6148e59:

    # voice "voice/Alisa/3day/10 A.ogg"
    # Alis "А я обещания исполняю."
    voice "voice/Alisa/3day/10 A.ogg"
    Alis "А я абяцанні выконваю."

# game/scripts/scene/scene_day_3.rpy:8924
translate belarusian dev_bunny3_candyjumps_end_1d75767b:

    # "Она подошла вплотную, взяла под локоть."
    "Яна падышла ўшчыльную, узяла пад локаць."

# game/scripts/scene/scene_day_3.rpy:8926
translate belarusian dev_bunny3_candyjumps_end_76f91645:

    # "Я почувствовал запах мяты, апельсинов и сгоревших бенгальских огней."
    "Я адчуў пах мяты, апельсінаў і згарэлых бенгальскіх агнёў."

# game/scripts/scene/scene_day_3.rpy:8927
translate belarusian dev_bunny3_candyjumps_end_628b39a0:

    # "Захотелось наклониться к Алисе, чтобы распробовать все тонкости ароматов."
    "Захацелася нахіліцца да Алісы, каб распрабаваць усе тонкасці водараў."

# game/scripts/scene/scene_day_3.rpy:8928
translate belarusian dev_bunny3_candyjumps_end_5703dc0f:

    # voice "voice/Alisa/3day/11 S.ogg"
    # Alis "Сколько можно повторять: со мной ты в безопасности."
    voice "voice/Alisa/3day/11 S.ogg"
    Alis "Колькі можна паўтараць: са мной ты ў бяспецы."

# game/scripts/scene/scene_day_3.rpy:8930
translate belarusian dev_bunny3_candyjumps_end_64bf6ccf:

    # voice "voice/Alisa/3day/12 Ya.ogg"
    # Alis "Я твой друг."
    voice "voice/Alisa/3day/12 Ya.ogg"
    Alis "Я твой сябар."

# game/scripts/scene/scene_day_3.rpy:8933
translate belarusian dev_bunny3_candyjumps_end_9e7780fd:

    # voice "voice/Alisa/3day/13 E.ogg"
    # Alis "И они."
    voice "voice/Alisa/3day/13 E.ogg"
    Alis "І яны."

# game/scripts/scene/scene_day_3.rpy:8944
translate belarusian dev_bunny3_candyjumps_end_5f3fb549:

    # "Я быстро обернулся туда, куда показывала лисичка."
    "Я хутка азірнуўся туды, куды паказвала лісічка."

# game/scripts/scene/scene_day_3.rpy:8954
translate belarusian dev_bunny3_candyjumps_end_44cabe5d:

    # "На краю опушки появились дети в масках. По крайней мере все они были небольшого роста."
    "На краі ўзлеску з'явіліся дзеці ў масках. Прынамсі ўсе яны былі невялікага росту."

# game/scripts/scene/scene_day_3.rpy:8960
translate belarusian dev_bunny3_candyjumps_end_a371808c:

    # "Волчок, сова и медвежонок."
    "Ваўчок, сава і медзведзяня."

# game/scripts/scene/scene_day_3.rpy:8978
translate belarusian dev_bunny3_candyjumps_end_198e188f:

    # "Они фыркали и вздыхали, явно утомившись от бега."
    "Яны фыркалі і ўздыхалі, відавочна стаміўшыся ад бегу."

# game/scripts/scene/scene_day_3.rpy:8990
translate belarusian dev_bunny3_candyjumps_end_61828efb:

    # voice "voice/Owl/3day/09 Ya.ogg"
    # Noname "Я ду-у-ху-мала, ты в снег провалился."
    voice "voice/Owl/3day/09 Ya.ogg"
    Noname "Я ду-у-ху-мала, ты ў снег праваліўся."

# game/scripts/scene/scene_day_3.rpy:8993
translate belarusian dev_bunny3_candyjumps_end_a3580c35:

    # voice "voice/Owl/3day/10 S.ogg"
    # Noname "Стала снег копать – нет тебя."
    voice "voice/Owl/3day/10 S.ogg"
    Noname "Стала снег капаць — няма цябе."

# game/scripts/scene/scene_day_3.rpy:9011
translate belarusian dev_bunny3_candyjumps_end_edc39a8a:

    # voice "voice/Bear/3day/01 A.ogg"
    # Noname "А я не копал. Лень копать было."
    voice "voice/Bear/3day/01 A.ogg"
    Noname "А я не капаў. Лянота капаць было."

# game/scripts/scene/scene_day_3.rpy:9013
translate belarusian dev_bunny3_candyjumps_end_9f3b548e:

    # voice "voice/Bear/3day/02 O.ogg"
    # Noname "Оно как получается: если дурак, то бегай да копай."
    voice "voice/Bear/3day/02 O.ogg"
    Noname "Яно як атрымліваецца: калі дурань, дык бегай ды капай."

# game/scripts/scene/scene_day_3.rpy:9015
translate belarusian dev_bunny3_candyjumps_end_28a9ecd0:

    # voice "voice/Bear/3day/03 Ae.ogg"
    # Noname "А если умный — подожди, пока другие набегаются, накопаются и устанут."
    voice "voice/Bear/3day/03 Ae.ogg"
    Noname "А калі разумны — пачакай, пакуль іншыя набегаюцца, накапаюцца і стомяцца."

# game/scripts/scene/scene_day_3.rpy:9017
translate belarusian dev_bunny3_candyjumps_end_1fabc808:

    # voice "voice/Bear/3day/04 E.ogg"
    # Noname "И уж тогда заводи разговор."
    voice "voice/Bear/3day/04 E.ogg"
    Noname "І ўжо тады пачынай размову."

# game/scripts/scene/scene_day_3.rpy:9039
translate belarusian dev_bunny3_candyjumps_end_34eaf921:

    # voice "voice/Wolf/309 Kak.ogg"
    # Noname "Как я р-р-рад!"
    voice "voice/Wolf/309 Kak.ogg"
    Noname "Як я р-р-рады!"

# game/scripts/scene/scene_day_3.rpy:9052
translate belarusian dev_bunny3_candyjumps_end_f93e8529:

    # voice "voice/Wolf/310 D.ogg"
    # Noname "Дегенер-р-р-рат!"
    voice "voice/Wolf/310 D.ogg"
    Noname "Дэгенер-р-р-рат!"

# game/scripts/scene/scene_day_3.rpy:9061
translate belarusian dev_bunny3_candyjumps_end_aceacf69:

    # voice "voice/anton/3day/137A.ogg"
    # Ant "А?"
    voice "voice/anton/3day/137A.ogg"
    Ant "А?"

# game/scripts/scene/scene_day_3.rpy:9063
translate belarusian dev_bunny3_candyjumps_end_483fef82:

    # voice "voice/Alisa/3day/12 Neobr.ogg"
    # Alis "Не обращай внимания, он со странностями."
    voice "voice/Alisa/3day/12 Neobr.ogg"
    Alis "Не звяртай увагі, ён з дзівацтвамі."

# game/scripts/scene/scene_day_3.rpy:9065
translate belarusian dev_bunny3_candyjumps_end_3b8fcacb:

    # "Я понял, что стою с открытым ртом, с бессильно опущенными руками."
    "Я зразумеў, што стаю з адкрытым ротам, з бяссільна апушчанымі рукамі."

# game/scripts/scene/scene_day_3.rpy:9071
translate belarusian dev_bunny3_candyjumps_end_3370613a:

    # "Не зная, как реагировать на слова поздних гостей, я всё-таки выдавил подобие улыбки."
    "Не ведаючы, як рэагаваць на словы позніх гасцей, я ўсё ж такі выціснуў падабенства ўсмешкі."

# game/scripts/scene/scene_day_3.rpy:9075
translate belarusian dev_bunny3_candyjumps_end_074923f5:

    # voice "voice/anton/3day/138 V.ogg"
    # Ant "Вы просто меня напугали."
    voice "voice/anton/3day/138 V.ogg"
    Ant "Вы проста мяне напалохалі."

# game/scripts/scene/scene_day_3.rpy:9092
translate belarusian dev_bunny3_candyjumps_end_4fb41b20:

    # "Они начали переглядываться, а кто-то даже фыркнул, словно услышал шутку."
    "Яны пачалі пераглядацца, а хтосьці нават фыркнуў, быццам пачуў жарт."

# game/scripts/scene/scene_day_3.rpy:9095
translate belarusian dev_bunny3_candyjumps_end_b849d4a1:

    # voice "voice/Wolf/310 Da.ogg"
    # Noname "Да, да! Лиса права..."
    voice "voice/Wolf/310 Da.ogg"
    Noname "Так, так! Ліса мае рацыю..."

# game/scripts/scene/scene_day_3.rpy:9100
translate belarusian dev_bunny3_candyjumps_end_4935c659:

    # voice "voice/Bear/3day/06 Eto.ogg"
    # Noname "Это он!"
    voice "voice/Bear/3day/06 Eto.ogg"
    Noname "Гэта ён!"

# game/scripts/scene/scene_day_3.rpy:9105
translate belarusian dev_bunny3_candyjumps_end_6f0f6059:

    # voice "voice/Alisa/3day/15 N.ogg"
    # Alis "Нет, это наш..."
    voice "voice/Alisa/3day/15 N.ogg"
    Alis "Не, гэта наш..."

# game/scripts/scene/scene_day_3.rpy:9111
translate belarusian dev_bunny3_candyjumps_end_a0d695e9:

    # voice "voice/Owl/3day/15 N.ogg"
    # Noname "Неужели нашли?"
    voice "voice/Owl/3day/15 N.ogg"
    Noname "Няўжо знайшлі?"

# game/scripts/scene/scene_day_3.rpy:9116
translate belarusian dev_bunny3_candyjumps_end_16be64c4:

    # voice "voice/Bear/3day/07 Na.ogg"
    # Noname "Наш Зайчик!"
    voice "voice/Bear/3day/07 Na.ogg"
    Noname "Наш Зайчык!"

# game/scripts/scene/scene_day_3.rpy:9121
translate belarusian dev_bunny3_candyjumps_end_a777c8f6:

    # voice "voice/Owl/3day/16 D.ogg"
    # Noname "Да, да, похож..."
    voice "voice/Owl/3day/16 D.ogg"
    Noname "Так, так, падобны..."

# game/scripts/scene/scene_day_3.rpy:9129
translate belarusian dev_bunny3_candyjumps_end_b8a6b306:

    # "Взбесившийся от радости волчок начал махать частью костюма, словно хвостом."
    "Шалёны ад радасці ваўчок пачаў махаць часткай касцюма, быццам хвастом."

# game/scripts/scene/scene_day_3.rpy:9132
translate belarusian dev_bunny3_candyjumps_end_49f017ed:

    # voice "voice/Wolf/312 P.ogg"
    # Noname "Пе-е-ер-р-р-рвый!"
    voice "voice/Wolf/312 P.ogg"
    Noname "Пе-е-ер-р-р-шы!"

# game/scripts/scene/scene_day_3.rpy:9137
translate belarusian dev_bunny3_candyjumps_end_e816cfd0:

    # voice "voice/Alisa/3day/17 Nu.ogg"
    # Alis "Ну конечно, ты первый."
    voice "voice/Alisa/3day/17 Nu.ogg"
    Alis "Ну вядома, ты першы."

# game/scripts/scene/scene_day_3.rpy:9139
translate belarusian dev_bunny3_candyjumps_end_6142db16:

    # voice "voice/Alisa/3day/18 Et.ogg"
    # Alis "Это Волчик раньше всех почуял Зайчика в тебе. И рассказал нам."
    voice "voice/Alisa/3day/18 Et.ogg"
    Alis "Гэта Воўчык раней за ўсіх пачуў Зайчыка ў табе. І расказаў нам."

# game/scripts/scene/scene_day_3.rpy:9144
translate belarusian dev_bunny3_candyjumps_end_1071845e:

    # voice "voice/anton/3day/52 Zd.ogg"
    # Ant "Здравствуй."
    voice "voice/anton/3day/52 Zd.ogg"
    Ant "Вітаю."

# game/scripts/scene/scene_day_3.rpy:9146
translate belarusian dev_bunny3_candyjumps_end_4a43d924:

    # voice "voice/Alisa/3day/02 S.ogg"
    # Alis "С нашей Совушкой ты знаком не понаслышке. Не такая она уж и страшная, правда?"
    voice "voice/Alisa/3day/02 S.ogg"
    Alis "З нашай Совушкай ты знаёмы не па чутках. Не такая яна ўжо і страшная, праўда?"

# game/scripts/scene/scene_day_3.rpy:9148
translate belarusian dev_bunny3_candyjumps_end_1a349986:

    # voice "voice/anton/3day/53 Da.ogg"
    # Ant "Да, наверное..."
    voice "voice/anton/3day/53 Da.ogg"
    Ant "Так, напэўна..."

# game/scripts/scene/scene_day_3.rpy:9151
translate belarusian dev_bunny3_candyjumps_end_bdd81665:

    # voice "voice/Alisa/3day/04 A.ogg"
    # Alis "А этот улыбчивый бугай — Медвежутка."
    voice "voice/Alisa/3day/04 A.ogg"
    Alis "А гэты ўсмешлівы асілак — Мядзведжутка."

# game/scripts/scene/scene_day_3.rpy:9153
translate belarusian dev_bunny3_candyjumps_end_a7d86708:

    # voice "voice/Alisa/3day/05 T.ogg"
    # Alis "Ты лучше с ним поласковее, а то голову откусит."
    voice "voice/Alisa/3day/05 T.ogg"
    Alis "Ты лепш з ім лагодней, а то галаву адкусіць."

# game/scripts/scene/scene_day_3.rpy:9155
translate belarusian dev_bunny3_candyjumps_end_b6cbf604:

    # voice "voice/anton/3day/54 Za.ogg"
    # Ant "Зачем это?"
    voice "voice/anton/3day/54 Za.ogg"
    Ant "Навошта гэта?"

# game/scripts/scene/scene_day_3.rpy:9158
translate belarusian dev_bunny3_candyjumps_end_f58f64ba:

    # voice "voice/Alisa/3day/06 M.ogg"
    # Alis "М-да, смотрю, ты и чувство юмора где-то обронил."
    voice "voice/Alisa/3day/06 M.ogg"
    Alis "М-да, гляджу, ты і пачуццё гумару недзе згубіў."

# game/scripts/scene/scene_day_3.rpy:9172
translate belarusian dev_bunny3_candyjumps_end_e71dd051:

    # "Всё ещё сомневаясь в благих намерениях причудливых зверят, я спрятал руки за спину, стараясь при этом не смотреть на зияющие дыры карнавальных масок вместо глаз."
    "Усё яшчэ сумняваючыся ў добрых намерах мудрагелістых звяркоў, я схаваў рукі за спіну, стараючыся пры гэтым не глядзець на пустыя дзіркі карнавальных масак замест вачэй."

# game/scripts/scene/scene_day_3.rpy:9176
translate belarusian dev_bunny3_candyjumps_end_bec136b2:

    # "Алиса наигранно подбоченилась и как-то ухитрилась подмигнуть своей рыжей личиной."
    "Аліса наіграна ўзялася ў бокі і неяк прымудрылася падміргнуць сваёй рудой лічынай."

# game/scripts/scene/scene_day_3.rpy:9182
translate belarusian dev_bunny3_candyjumps_end_2d7d06d7:

    # voice "voice/Alisa/3day/19 K.ogg"
    # Alis "Когда в следующий раз придём — будем звенеть в колокольчики, чтобы ты не так боялся нашего визита."
    voice "voice/Alisa/3day/19 K.ogg"
    Alis "Калі ў наступны раз прыйдзем — будзем звінець у званочкі, каб ты не так баяўся нашага візіту."

# game/scripts/scene/scene_day_3.rpy:9189
translate belarusian dev_bunny3_candyjumps_end_da040db9:

    # voice "voice/Owl/3day/01 A.ogg"
    # Owl "А у нас разве есть колокольчики?"
    voice "voice/Owl/3day/01 A.ogg"
    Owl "А ў нас хіба ёсць званочкі?"

# game/scripts/scene/scene_day_3.rpy:9194
translate belarusian dev_bunny3_candyjumps_end_8f3b3a5a:

    # voice "voice/Bear/3day/09 Ch.ogg"
    # Bear "Чур, я звенеть не буду."
    voice "voice/Bear/3day/09 Ch.ogg"
    Bear "Чур, я звінець не буду."

# game/scripts/scene/scene_day_3.rpy:9196
translate belarusian dev_bunny3_candyjumps_end_bf20dad7:

    # voice "voice/Bear/3day/10 U.ogg"
    # Bear "У меня лапка болит."
    voice "voice/Bear/3day/10 U.ogg"
    Bear "У мяне лапка баліць."

# game/scripts/scene/scene_day_3.rpy:9201
translate belarusian dev_bunny3_candyjumps_end_3b082654:

    # "Моя улыбка стала настоящей."
    "Мая ўсмешка стала сапраўднай."

# game/scripts/scene/scene_day_3.rpy:9206
translate belarusian dev_bunny3_candyjumps_end_f0b0a64b:

    # voice "voice/Alisa/3day/13 Ozu.ogg"
    # Alis "О, зубы показал — это добрый знак."
    voice "voice/Alisa/3day/13 Ozu.ogg"
    Alis "О, зубы паказаў — гэта добры знак."

# game/scripts/scene/scene_day_3.rpy:9208
translate belarusian dev_bunny3_candyjumps_end_f4798c41:

    # voice "voice/Alisa/3day/14 Neo.ogg"
    # Alis "Не ожидала, что сможем тебя рассмешить."
    voice "voice/Alisa/3day/14 Neo.ogg"
    Alis "Не чакала, што зможам цябе рассмяшыць."

# game/scripts/scene/scene_day_3.rpy:9210
translate belarusian dev_bunny3_candyjumps_end_6ed7db57:

    # voice "voice/Alisa/3day/15 Ya.ogg"
    # Alis "Я думала, это под силу только Диснейленду."
    voice "voice/Alisa/3day/15 Ya.ogg"
    Alis "Я думала, гэта пад сілу толькі Дыснэйлэнду."

# game/scripts/scene/scene_day_3.rpy:9213
translate belarusian dev_bunny3_candyjumps_end_c73bd6d8:

    # voice "voice/anton/3day/140 Otk.ogg"
    # Ant "Откуда ты знаешь?"
    voice "voice/anton/3day/140 Otk.ogg"
    Ant "Адкуль ты ведаеш?"

# game/scripts/scene/scene_day_3.rpy:9217
translate belarusian dev_bunny3_candyjumps_end_aeba8e4e:

    # voice "voice/Alisa/3day/20 Da.ogg"
    # Alis "Да так, прочитала кое-где..."
    voice "voice/Alisa/3day/20 Da.ogg"
    Alis "Ды так, прачытала сёе-дзе..."

# game/scripts/scene/scene_day_3.rpy:9220
translate belarusian dev_bunny3_candyjumps_end_8443a7ab:

    # voice "voice/anton/3day/141 Pro.ogg"
    # Ant "Про меня?"
    voice "voice/anton/3day/141 Pro.ogg"
    Ant "Пра мяне?"

# game/scripts/scene/scene_day_3.rpy:9224
translate belarusian dev_bunny3_candyjumps_end_ff500d94:

    # voice "voice/Alisa/3day/24 Pr.ogg"
    # Alis "Про клюв от воробья! Про Диснейленд, яхонтовый."
    voice "voice/Alisa/3day/24 Pr.ogg"
    Alis "Пра дзюбу ад вераб'я! Пра Дыснэйлэнд, яхантавы."

# game/scripts/scene/scene_day_3.rpy:9229
translate belarusian dev_bunny3_candyjumps_end_d8fa0f28:

    # voice "voice/Owl/3day/12 T.ogg"
    # Owl "Ты умеешь читать по-человечески?"
    voice "voice/Owl/3day/12 T.ogg"
    Owl "Ты ўмееш чытаць па-чалавечы?"

# game/scripts/scene/scene_day_3.rpy:9234
translate belarusian dev_bunny3_candyjumps_end_49c09e0b:

    # voice "voice/Alisa/3day/25 Z.ogg"
    # Alis "Зря я, что ли, в школу хожу день ото дня?"
    voice "voice/Alisa/3day/25 Z.ogg"
    Alis "Дарма я, ці што, у школу хаджу дзень пры дні?"

# game/scripts/scene/scene_day_3.rpy:9251
translate belarusian dev_d3_dance_82a8cae4:

    # "И она кокетливо запела:"
    "І яна какетліва заспявала:"

# game/scripts/scene/scene_day_3.rpy:9269
translate belarusian dev_d3_dance_0f7305ed:

    # Alis "Как детей не замечать, как мечты их развенчать \nУчат в школе, учат в школе, учат в школе!{w=7.367}{nw}"
    Alis "Як дзяцей не заўважаць, як іх мары разбураць \nВучаць у школе, вучаць у школе, вучаць у школе!{w=7.367}{nw}"

# game/scripts/scene/scene_day_3.rpy:9277
translate belarusian dev_d3_dance_42a1854c:

    # Alis "Крепко-накрепко вломить, с детства слабеньких чморить \nУчат в школе, учат в школе, учат в школе!"
    Alis "Як памоцней уламіць, змалку слабенькіх чмарыць \nВучаць у школе, вучаць у школе, вучаць у школе!"

# game/scripts/scene/scene_day_3.rpy:9284
translate belarusian dev_d3_dance_7b77ae2d:

    # "Я осторожно засмеялся."
    "Я асцярожна засмяяўся."

# game/scripts/scene/scene_day_3.rpy:9305
translate belarusian dev_d3_dance_7b479f9a:

    # "Новые знакомые уже не отпугивали, а, напротив, привлекали."
    "Новыя знаёмыя ўжо не адпужвалі, а, наадварот, прываблівалі."

# game/scripts/scene/scene_day_3.rpy:9306
translate belarusian dev_d3_dance_8fa9069a:

    # "Было в них что-то особенное."
    "Было ў іх нешта асаблівае."

# game/scripts/scene/scene_day_3.rpy:9307
translate belarusian dev_d3_dance_2817a298:

    # "И в этой опушке, и в луне, и в снежинках, которые почему-то падали наоборот, с земли в тёмное небо, как на прокрученной задом наперёд плёнке."
    "І ў гэтым узлеску, і ў месяцы, і ў сняжынках, якія чамусьці падалі наадварот, з зямлі ў цёмнае неба, як на пракручанай задам наперад стужцы."

# game/scripts/scene/scene_day_3.rpy:9308
translate belarusian dev_d3_dance_79c4994f:

    # "Дети в масках приблизились, и я ощутил их прикосновения: они хлопали дружески, трогали мою одежду, словно проверяли, что я настоящий."
    "Дзеці ў масках наблізіліся, і я адчуў іх дотыкі: яны пляскалі па-сяброўску, краналі маю вопратку, быццам правяралі, што я сапраўдны."

# game/scripts/scene/scene_day_3.rpy:9309
translate belarusian dev_d3_dance_3625f588:

    # "В их прикосновениях не было звериной злости — лишь чистое незамутнённое любопытство ребёнка."
    "У іх дотыках не было звярынай злосці — толькі чыстая незамутнёная цікаўнасць дзіцяці."

# game/scripts/scene/scene_day_3.rpy:9310
translate belarusian dev_d3_dance_dd393ce1:

    # "И я почему-то сказал про себя:"
    "І я чамусьці сказаў пра сябе:"

# game/scripts/scene/scene_day_3.rpy:9311
translate belarusian dev_d3_dance_a09953e9:

    # Ant_m "«{i}Им можно доверять{/i}»."
    Ant_m "«{i}Ім можна давяраць{/i}»."

# game/scripts/scene/scene_day_3.rpy:9312
translate belarusian dev_d3_dance_9350eaa2:

    # "Снежинки всё планировали ввысь."
    "Сняжынкі ўсё планіравалі ўвысь."

# game/scripts/scene/scene_day_3.rpy:9331
translate belarusian dev_d3_dance_6280243e:

    # voice "voice/Owl/3day/14 N.ogg"
    # Owl "Никто тебя больше не обидит."
    voice "voice/Owl/3day/14 N.ogg"
    Owl "Ніхто цябе больш не пакрыўдзіць."

# game/scripts/scene/scene_day_3.rpy:9336
translate belarusian dev_d3_dance_34c4abe3:

    # voice "voice/Wolf/313 D.ogg"
    # Wolf "Др-р-руг."
    voice "voice/Wolf/313 D.ogg"
    Wolf "Сяб-р-р-р."

# game/scripts/scene/scene_day_3.rpy:9341
translate belarusian dev_d3_dance_d50beac4:

    # voice "voice/Bear/3day/12 P.ogg"
    # Bear "Пусть только попробуют!"
    voice "voice/Bear/3day/12 P.ogg"
    Bear "Хай толькі паспрабуюць!"

# game/scripts/scene/scene_day_3.rpy:9361
translate belarusian dev_d3_dance_030fbec3:

    # "Лиса тихонько пихнула меня в плечо и рассмеялась."
    "Ліса ціхенька пхнула мяне ў плячо і засмяялася."

# game/scripts/scene/scene_day_3.rpy:9364
translate belarusian dev_d3_dance_ef1594b5:

    # voice "voice/Alisa/3day/28 N.ogg"
    # Alis "Ну что, Тоша, убежишь с воплями или с нами пойдёшь?"
    voice "voice/Alisa/3day/28 N.ogg"
    Alis "Ну што, Тоша, уцячэш з крыкамі ці з намі пойдзеш?"

# game/scripts/scene/scene_day_3.rpy:9367
translate belarusian dev_d3_dance_d5bafe11:

    # voice"voice/anton/3day/143 Ku.ogg"
    # Ant "Куда?"
    voice"voice/anton/3day/143 Ku.ogg"
    Ant "Куды?"

# game/scripts/scene/scene_day_3.rpy:9372
translate belarusian dev_d3_dance_94b2f8f8:

    # voice "voice/Alisa/3day/29 N.ogg"
    # Alis "А-ха-ха-ха! На аттракционы!"
    voice "voice/Alisa/3day/29 N.ogg"
    Alis "А-ха-ха-ха! На атракцыёны!"

# game/scripts/scene/scene_day_3.rpy:9376
translate belarusian dev_d3_dance_7bbcc2ac:

    # "В эту секунду далёкий звук флейты нарушил обманчивую тишину тайги."
    "У гэтую секунду далёкі гук флейты парушыў зманлівую цішыню тайгі."

# game/scripts/scene/scene_day_3.rpy:9377
translate belarusian dev_d3_dance_0619fc55:

    # "Прекрасный и таинственный, он вызывал в памяти звон хрусталя и журчание студёного ручья."
    "Цудоўны і таямнічы, ён выклікаў у памяці звон крышталя і журчанне сцюдзёнага ручая."

# game/scripts/scene/scene_day_3.rpy:9391
translate belarusian beasts_sky_4efbbdb1:

    # "Если какие-то сомнения оставались, то песня флейты развеяла их."
    "Калі нейкія сумненні заставаліся, то песня флейты развеяла іх."

# game/scripts/scene/scene_day_3.rpy:9395
translate belarusian beasts_sky_d6a50f28:

    # "Я пошёл за новыми друзьями прежде, чем принял решение."
    "Я пайшоў за новымі сябрамі перш, чым прыняў рашэнне."

# game/scripts/scene/scene_day_3.rpy:9407
translate belarusian beasts_sky_c287e515:

    # "Ноги сами переступали, а образованные соснами туннели раздвигались. Кусты кланялись перед нашей процессией."
    "Ногі самі пераступалі, а ўтвораныя соснамі тунэлі рассоўваліся. Кусты кланяліся перад нашай працэсіяй."

# game/scripts/scene/scene_day_3.rpy:9408
translate belarusian beasts_sky_08f24ff4:

    # "Всё это напоминало сон."
    "Усё гэта нагадвала сон."

# game/scripts/scene/scene_day_3.rpy:9420
translate belarusian beasts_sky_bd378890:

    # "Ведь даже поляну, на которую мы выбрались, я видел во сне."
    "Бо нават паляну, на якую мы выбраліся, я бачыў у сне."

# game/scripts/scene/scene_day_3.rpy:9421
translate belarusian beasts_sky_660e14b6:

    # "Флейта, как чудесная птица, парила где-то высоко, между тёмных крон."
    "Флейта, як цудоўная птушка, парыла недзе высока, паміж цёмных крон."

# game/scripts/scene/scene_day_3.rpy:9422
translate belarusian beasts_sky_26e34a61:

    # "Снежинки, взлетая, закручивались спиралью."
    "Сняжынкі, узлятаючы, закручваліся спіраллю."

# game/scripts/scene/scene_day_3.rpy:9423
translate belarusian beasts_sky_db670388:

    # "Луна окрашивала ветви в серебряный цвет."
    "Месяц афарбоўваў галіны ў сярэбраны колер."

# game/scripts/scene/scene_day_3.rpy:9425
translate belarusian beasts_sky_027d1de4:

    # "Алиса зачарованно ахнула. И я разделял её восторг."
    "Аліса зачаравана ахнула. І я падзяляў яе захапленне."

# game/scripts/scene/scene_day_3.rpy:9429
translate belarusian beasts_sky_6f63c12e:

    # "Задрав голову, я смотрел вверх."
    "Задраўшы галаву, я глядзеў уверх."

# game/scripts/scene/scene_day_3.rpy:9440
translate belarusian beasts_sky_767eb594:

    # voice "voice/Owl/3day/15 K.ogg"
    # Owl "У-у-ух, красиво как!"
    voice "voice/Owl/3day/15 K.ogg"
    Owl "У-у-ух, прыгожа як!"

# game/scripts/scene/scene_day_3.rpy:9450
translate belarusian beasts_sky_79e7605f:

    # voice "voice/anton/3day/144 Och.ogg"
    # Ant "Очень красиво."
    voice "voice/anton/3day/144 Och.ogg"
    Ant "Вельмі прыгожа."

# game/scripts/scene/scene_day_3.rpy:9460
translate belarusian beasts_sky_ee192c5b:

    # "Волчок одобрительно завыл."
    "Ваўчок ухвальна завыў."

# game/scripts/scene/scene_day_3.rpy:9469
translate belarusian beasts_sky_5ad141cd:

    # voice "voice/Alisa/3day/31 E.ogg"
    # Alis "Это мелочи!"
    voice "voice/Alisa/3day/31 E.ogg"
    Alis "Гэта дробязі!"

# game/scripts/scene/scene_day_3.rpy:9473
translate belarusian beasts_sky_fcd1c646:

    # voice "voice/Alisa/3day/32 Ya.ogg"
    # Alis "Я покажу гораздо больше..."
    voice "voice/Alisa/3day/32 Ya.ogg"
    Alis "Я пакажу значна больш..."

# game/scripts/scene/scene_day_3.rpy:9475
translate belarusian beasts_sky_5a0dde28:

    # voice "voice/Alisa/3day/33 E.ogg"
    # Alis "Если захочешь."
    voice "voice/Alisa/3day/33 E.ogg"
    Alis "Калі захочаш."

# game/scripts/scene/scene_day_3.rpy:9479
translate belarusian beasts_sky_c918fdfe:

    # "А я хотел. Как сильно я хотел увидеть то, что видела лисичка своими спрятанными в полутьме капюшона глазами!"
    "А я хацеў. Як моцна я хацеў убачыць тое, што бачыла лісічка сваімі схаванымі ў паўцемры капюшона вачыма!"

# game/scripts/scene/scene_day_3.rpy:9480
translate belarusian beasts_sky_b118a3d8:

    # "Теперь смущало не то, что дети носили маски, а то, что без маски был я."
    "Цяпер бянтэжыла не тое, што дзеці насілі маскі, а тое, што без маскі быў я."

# game/scripts/scene/scene_day_3.rpy:9481
translate belarusian beasts_sky_b86eee6c:

    # "Точно голый на январском ветру."
    "Дакладна голы на студзеньскім ветры."

# game/scripts/scene/scene_day_3.rpy:9513
translate belarusian beasts_sky_a8649788:

    # voice"voice/anton/3day/145 S.ogg"
    # Ant "Скажите, а зачем вам маски?"
    voice"voice/anton/3day/145 S.ogg"
    Ant "Скажыце, а навошта вам маскі?"

# game/scripts/scene/scene_day_3.rpy:9515
translate belarusian beasts_sky_5b776bb7:

    # "Я не боялся, хотя меня и трясло."
    "Я не баяўся, хаця мяне і трасло."

# game/scripts/scene/scene_day_3.rpy:9516
translate belarusian beasts_sky_85af34cd:

    # "Дрожь была не от холода, а от странного волнения, предвкушения чего-то невероятного."
    "Дрыжыкі былі не ад холаду, а ад дзіўнага хвалявання, прадчування чагосьці неверагоднага."

# game/scripts/scene/scene_day_3.rpy:9527
translate belarusian beasts_sky_32e90ab3:

    # voice "voice/Alisa/3day/07 At.ogg"
    # Alis "А тебе зачем?"
    voice "voice/Alisa/3day/07 At.ogg"
    Alis "А табе навошта?"

# game/scripts/scene/scene_day_3.rpy:9531
translate belarusian beasts_sky_7bf3fea8:

    # "Я дотронулся до прохладной щеки."
    "Я дакрануўся да прахалоднай шчакі."

# game/scripts/scene/scene_day_3.rpy:9532
translate belarusian beasts_sky_0c8adb92:

    # voice"voice/anton/3day/146 No.ogg"
    # Ant "Но я без маски."
    voice"voice/anton/3day/146 No.ogg"
    Ant "Але я без маскі."

# game/scripts/scene/scene_day_3.rpy:9536
translate belarusian beasts_sky_b3eff0a9:

    # voice "voice/Alisa/3day/35 O.ogg"
    # Alis "А-ха-ха-ха! Обожаю человеческие сказки!"
    voice "voice/Alisa/3day/35 O.ogg"
    Alis "А-ха-ха-ха! Абажаю чалавечыя казкі!"

# game/scripts/scene/scene_day_3.rpy:9541
translate belarusian beasts_sky_d2d52956:

    # voice "voice/Owl/3day/16 Ch.ogg"
    # Owl "Человеческие ласки?"
    voice "voice/Owl/3day/16 Ch.ogg"
    Owl "Чалавечыя ласкі?"

# game/scripts/scene/scene_day_3.rpy:9546
translate belarusian beasts_sky_352b9a1f:

    # voice "voice/Bear/3day/13 Ch.ogg"
    # Bear "Человеческие дрязги."
    voice "voice/Bear/3day/13 Ch.ogg"
    Bear "Чалавечыя звадкі."

# game/scripts/scene/scene_day_3.rpy:9551
translate belarusian beasts_sky_3dcdda7c:

    # voice "voice/Alisa/3day/36 Ya.ogg"
    # Alis "Я же говорила..."
    voice "voice/Alisa/3day/36 Ya.ogg"
    Alis "Я ж казала..."

# game/scripts/scene/scene_day_3.rpy:9553
translate belarusian beasts_sky_ae6320fb:

    # voice "voice/Alisa/3day/36 V.ogg"
    # Alis "Все жители посёлка носят маски."
    voice "voice/Alisa/3day/36 V.ogg"
    Alis "Усе жыхары пасёлка носяць маскі."

# game/scripts/scene/scene_day_3.rpy:9555
translate belarusian beasts_sky_790c7867:

    # voice "voice/Alisa/3day/37 T.ogg"
    # Alis "Только скрываются за ними отнюдь не люди."
    voice "voice/Alisa/3day/37 T.ogg"
    Alis "Толькі хаваюцца за імі зусім не людзі."

# game/scripts/scene/scene_day_3.rpy:9559
translate belarusian beasts_sky_6ca4a7f3:

    # voice"voice/anton/3day/147 E.ogg"
    # Ant "И даже я?"
    voice"voice/anton/3day/147 E.ogg"
    Ant "І нават я?"

# game/scripts/scene/scene_day_3.rpy:9563
translate belarusian beasts_sky_f62fe49e:

    # voice "voice/Bear/3day/14 T.ogg"
    # Bear "Хе-хе, ты такой рассеянный, Антон."
    voice "voice/Bear/3day/14 T.ogg"
    Bear "Хе-хе, ты такі рассеяны, Антон."

# game/scripts/scene/scene_day_3.rpy:9568
translate belarusian beasts_sky_3fcc9371:

    # voice "voice/Owl/3day/17 Od.ogg"
    # Owl "Однажды мы уже нашли твои очки."
    voice "voice/Owl/3day/17 Od.ogg"
    Owl "Аднойчы мы ўжо знайшлі твае акуляры."

# game/scripts/scene/scene_day_3.rpy:9573
translate belarusian beasts_sky_92813351:

    # voice "voice/Wolf/315 E.ogg"
    # Wolf "И шапку-у-у-у!"
    voice "voice/Wolf/315 E.ogg"
    Wolf "І шапку-у-у-у!"

# game/scripts/scene/scene_day_3.rpy:9595
translate belarusian beasts_sky_88d948c3:

    # voice "voice/Alisa/3day/38 E.ogg"
    # Alis "И твоё настоящее лицо."
    voice "voice/Alisa/3day/38 E.ogg"
    Alis "І твой сапраўдны твар."

# game/scripts/scene/scene_day_3.rpy:9600
translate belarusian beasts_sky_21b9d1b3:

    # "Я увидел маску, которую лиса мне протягивала."
    "Я ўбачыў маску, якую ліса мне працягвала."

# game/scripts/scene/scene_day_3.rpy:9601
translate belarusian beasts_sky_b5d9056f:

    # "Ту самую маску зайчика, похожую на серебряный слиток в лунном свете."
    "Тую самую маску зайчыка, падобную на сярэбраны злітак у месячным святле."

# game/scripts/scene/scene_day_3.rpy:9602
translate belarusian beasts_sky_b62b955d:

    # "Любопытно стало, как изменится мир, если взглянуть сквозь прорези."
    "Цікаўна стала, як зменіцца свет, калі зірнуць скрозь проразі."

# game/scripts/scene/scene_day_3.rpy:9610
translate belarusian beasts_sky_b1547596:

    # "Но вдруг, с трудом просачиваясь сквозь мелодию флейты, меня посетило озарение: очки, которые они нашли, были у Семёна."
    "Але раптам, з цяжкасцю прасочваючыся скрозь мелодыю флейты, мяне наведала азарэнне: акуляры, якія яны знайшлі, былі ў Сямёна."

# game/scripts/scene/scene_day_3.rpy:9611
translate belarusian beasts_sky_a26ccb97:

    # "Мои новые знакомые наверняка знали, что с ним произошло."
    "Мае новыя знаёмыя напэўна ведалі, што з ім адбылося."

# game/scripts/scene/scene_day_3.rpy:9612
translate belarusian beasts_sky_3b940a0c:

    # "Или хуже..."
    "Ці горш..."

# game/scripts/scene/scene_day_3.rpy:9630
translate belarusian beasts_sky_423947e8:

    # voice"voice/anton/3day/148 A.ogg"
    # Ant "А куда подевался Семён? Что с ним стало?"
    voice"voice/anton/3day/148 A.ogg"
    Ant "А куды падзеўся Сямён? Што з ім сталася?"

# game/scripts/scene/scene_day_3.rpy:9634
translate belarusian beasts_sky_b835c1c9:

    # voice"voice/anton/3day/148 Es.ogg"
    # Ant "И с остальными детьми?"
    voice"voice/anton/3day/148 Es.ogg"
    Ant "І з астатнімі дзецьмі?"

# game/scripts/scene/scene_day_3.rpy:9639
translate belarusian beasts_sky_9edcc9f4:

    # "Медвежонок и сова переглянулись."
    "Медзведзяня і сава пераглянуліся."

# game/scripts/scene/scene_day_3.rpy:9642
translate belarusian beasts_sky_ee1d937c:

    # "Волчок сжался комочком, а лисичка чуть опустила острый носик маски."
    "Ваўчок сціснуўся камячком, а лісічка крыху апусціла востры носік маскі."

# game/scripts/scene/scene_day_3.rpy:9646
translate belarusian beasts_sky_5ee937df:

    # voice "voice/Owl/3day/18 T.ogg"
    # Owl "Тот, кого держали в клетке!"
    voice "voice/Owl/3day/18 T.ogg"
    Owl "Той, каго трымалі ў клетцы!"

# game/scripts/scene/scene_day_3.rpy:9651
translate belarusian beasts_sky_f1781e01:

    # voice "voice/Wolf/316 T.ogg"
    # Wolf "Тот, кто р-р-режет мелко-мелко!"
    voice "voice/Wolf/316 T.ogg"
    Wolf "Той, хто р-р-рэжа дробна-дробна!"

# game/scripts/scene/scene_day_3.rpy:9656
translate belarusian beasts_sky_28a60d62:

    # voice "voice/Alisa/3day/39 T.ogg"
    # Alis "Тот, кто носит кожаное лицо, забрал их."
    voice "voice/Alisa/3day/39 T.ogg"
    Alis "Той, хто носіць скураны твар, забраў іх."

# game/scripts/scene/scene_day_3.rpy:9661
translate belarusian beasts_sky_a07fa368:

    # voice "voice/Bear/3day/15 Um.ogg"
    # Bear "Умел бы я креститься – перекрестился бы."
    voice "voice/Bear/3day/15 Um.ogg"
    Bear "Умеў бы я хрысціцца — перахрысціўся б."

# game/scripts/scene/scene_day_3.rpy:9665
translate belarusian beasts_sky_a872235f:

    # voice "voice/anton/3day/149 H.ogg"
    # Ant "Хотите сказать, это был человек?"
    voice "voice/anton/3day/149 H.ogg"
    Ant "Хочаце сказаць, гэта быў чалавек?"

# game/scripts/scene/scene_day_3.rpy:9669
translate belarusian beasts_sky_97b0815f:

    # voice "voice/Alisa/3day/16 Chem.ogg"
    # Alis "Чем ты только слушал?"
    voice "voice/Alisa/3day/16 Chem.ogg"
    Alis "Чым ты толькі слухаў?"

# game/scripts/scene/scene_day_3.rpy:9672
translate belarusian beasts_sky_5b84d1be:

    # voice "voice/Alisa/3day/17 Razv.ogg"
    # Alis "Разве можно назвать такого, как он, человеком?"
    voice "voice/Alisa/3day/17 Razv.ogg"
    Alis "Хіба можна назваць такога, як ён, чалавекам?"

# game/scripts/scene/scene_day_3.rpy:9677
translate belarusian beasts_sky_b49befe7:

    # voice "voice/Bear/3day/16 O.ogg"
    # Bear "Одно слово – взрослый."
    voice "voice/Bear/3day/16 O.ogg"
    Bear "Адно слова — дарослы."

# game/scripts/scene/scene_day_3.rpy:9682
translate belarusian beasts_sky_83e57ca3:

    # voice "voice/Owl/3day/19 V.ogg"
    # Owl "В мире взрослых так легко потеряться."
    voice "voice/Owl/3day/19 V.ogg"
    Owl "У свеце дарослых так лёгка згубіцца."

# game/scripts/scene/scene_day_3.rpy:9689
translate belarusian beasts_sky_f21fa5b8:

    # voice "voice/Alisa/3day/42 U.ogg"
    # Alis "Убийцы, жестокие дрессировщики и равнодушные родители..."
    voice "voice/Alisa/3day/42 U.ogg"
    Alis "Забойцы, жорсткія дрэсіроўшчыкі і абыякавыя бацькі..."

# game/scripts/scene/scene_day_3.rpy:9691
translate belarusian beasts_sky_28a51dd0:

    # voice "voice/Alisa/3day/43 L.ogg"
    # Alis "Эх, лучше об этом вовсе не думать, чтобы не грустить."
    voice "voice/Alisa/3day/43 L.ogg"
    Alis "Эх, лепш пра гэта зусім не думаць, каб не сумаваць."

# game/scripts/scene/scene_day_3.rpy:9695
translate belarusian beasts_sky_af9912bf:

    # voice "voice/Alisa/3day/44 A.ogg"
    # Alis "Не знаю, как вам, а мне печалиться совсем не хочется."
    voice "voice/Alisa/3day/44 A.ogg"
    Alis "Не ведаю, як вам, а мне смуткаваць зусім не хочацца."

# game/scripts/scene/scene_day_3.rpy:9706
translate belarusian beasts_sky_aa761324:

    # voice "voice/Bear/3day/17 E.ogg"
    # Bear "И я сегодня какой-то не грустный."
    voice "voice/Bear/3day/17 E.ogg"
    Bear "І я сёння нейкі не сумны."

# game/scripts/scene/scene_day_3.rpy:9708
translate belarusian beasts_sky_f6210c43:

    # voice "voice/Bear/3day/18 A.ogg"
    # Bear "Антон, а ты?"
    voice "voice/Bear/3day/18 A.ogg"
    Bear "Антон, а ты?"

# game/scripts/scene/scene_day_3.rpy:9712
translate belarusian beasts_sky_30e54b0a:

    # voice"voice/anton/3day/150 A.ogg"
    # Ant "А?"
    voice"voice/anton/3day/150 A.ogg"
    Ant "А?"

# game/scripts/scene/scene_day_3.rpy:9714
translate belarusian beasts_sky_42467c10:

    # "Я задумался, глядя в лес, пытаясь определить, откуда доносится звук флейты."
    "Я задумаўся, гледзячы ў лес, спрабуючы вызначыць, адкуль даносіцца гук флейты."

# game/scripts/scene/scene_day_3.rpy:9715
translate belarusian beasts_sky_2d9da2a1:

    # "Я был уверен, что музыкант стоит прямо за частоколом сосен."
    "Я быў упэўнены, што музыка стаіць проста за частаколам соснаў."

# game/scripts/scene/scene_day_3.rpy:9716
translate belarusian beasts_sky_4bea9629:

    # "Очень высокий, перебирающий длинными пальцами дырочки в корпусе флейты."
    "Вельмі высокі, перабіраючы доўгімі пальцамі дзірачкі ў корпусе флейты."

# game/scripts/scene/scene_day_3.rpy:9719
translate belarusian beasts_sky_41d8c2ca:

    # voice "voice/Bear/3day/20 T.ogg"
    # Bear "Так что? Сядем тосковать или займёмся отдыхом?"
    voice "voice/Bear/3day/20 T.ogg"
    Bear "Дык што? Сядзем сумаваць ці зоймемся адпачынкам?"

# game/scripts/scene/scene_day_3.rpy:9723
translate belarusian beasts_sky_1ce8b728:

    # voice"voice/anton/3day/151 Al.ogg"
    # Ant "Алиса хотела что-то показать..."
    voice"voice/anton/3day/151 Al.ogg"
    Ant "Аліса хацела нешта паказаць..."

# game/scripts/scene/scene_day_3.rpy:9727
translate belarusian beasts_sky_5e867f77:

    # voice "voice/Alisa/3day/45 D.ogg"
    # Alis "Давай начнём с самой сладкой части программы!"
    voice "voice/Alisa/3day/45 D.ogg"
    Alis "Давай пачнем з самай салодкай часткі праграмы!"

# game/scripts/scene/scene_day_3.rpy:9733
translate belarusian beasts_sky_da07360b:

    # "Лисичка извлекла из карманов горсть конфет и вручила по очереди всем детям."
    "Лісічка дастала з кішэняў жменю цукерак і ўручыла па чарзе ўсім дзецям."

# game/scripts/scene/scene_day_3.rpy:9735
translate belarusian beasts_sky_c8a18d93:

    # "Зашуршали фантики. Тут же запахло ананасом, какао и дыней."
    "Зашамацелі фанцікі. Адразу ж запахла ананасам, какава і дыняй."

# game/scripts/scene/scene_day_3.rpy:9757
translate belarusian beasts_sky_609678f6:

    # "Последнюю конфету, вафельную, мою любимую, Алиса вложила мне прямо в рот."
    "Апошнюю цукерку, вафельную, маю любімую, Аліса ўклала мне проста ў рот."

# game/scripts/scene/scene_day_3.rpy:9758
translate belarusian beasts_sky_6d44dc94:

    # "Язык обволокло пряностью."
    "Язык агарнула прыемнай вострыняй."

# game/scripts/scene/scene_day_3.rpy:9765
translate belarusian beasts_sky_203dffc4:

    # "Казалось, что моё тело покрылось шерстью, по которой пробегали яркие искорки."
    "Здавалася, што маё цела пакрылася поўсцю, па якой прабягалі яркія іскрынкі."

# game/scripts/scene/scene_day_3.rpy:9767
translate belarusian beasts_sky_17fcfa24:

    # "Замешкав, я прожевал вафли и шоколад, проглотил их, наслаждаясь вкусом."
    "Замарудзіўшыся, я пражаваў вафлі і шакалад, праглынуў іх, атрымліваючы асалоду ад смаку."

# game/scripts/scene/scene_day_3.rpy:9770
translate belarusian beasts_sky_60c46fab:

    # Ant "Спасибо..."
    Ant "Дзякуй..."

# game/scripts/scene/scene_day_3.rpy:9776
translate belarusian beasts_sky_e9cb7098:

    # "Благодарность вышла глуховатой, потому что губы мои уже касались маски."
    "Падзяка выйшла глухаватай, таму што вусны мае ўжо краналіся маскі."

# game/scripts/scene/scene_day_3.rpy:9796
translate belarusian beasts_sky_b6a68617:

    # "Я не заметил, как поднёс её к лицу."
    "Я не заўважыў, як паднёс яе да твару."

# game/scripts/scene/scene_day_3.rpy:9797
translate belarusian beasts_sky_53cb6074:

    # "От папье-маше исходило тепло. Маска льнула к коже, и приятно пощипывало."
    "Ад пап'е-машэ сыходзіла цяпло. Маска тулілася да скуры, і прыемна пашчыпвала."

# game/scripts/scene/scene_day_3.rpy:9798
translate belarusian beasts_sky_dcedf6bc:

    # "Так я нырял после зимней прогулки в горячую ванну и лежал, мурча от пенной воды."
    "Так я ныраў пасля зімовай прагулкі ў гарачую ванну і ляжаў, мурлыкаючы ад пеннай вады."

# game/scripts/scene/scene_day_3.rpy:9802
translate belarusian beasts_sky_138737ec:

    # voice "voice/Alisa/3day/47 G.ogg"
    # Alis "Говорила же: это твоё!"
    voice "voice/Alisa/3day/47 G.ogg"
    Alis "Казала ж: гэта тваё!"

# game/scripts/scene/scene_day_3.rpy:9806
translate belarusian beasts_sky_56aec357:

    # voice"voice/anton/3day/154 M.ogg"
    # Ant "Моё!"
    voice"voice/anton/3day/154 M.ogg"
    Ant "Маё!"

# game/scripts/scene/scene_day_3.rpy:9810
translate belarusian beasts_sky_b1afe02b:

    # voice "voice/Bear/3day/21 Ch.ogg"
    # Bear "Чего стоим? За нас веселиться никто не будет!"
    voice "voice/Bear/3day/21 Ch.ogg"
    Bear "Чаго стаім? За нас весяліцца ніхто не будзе!"

# game/scripts/scene/scene_day_3.rpy:9815
translate belarusian beasts_sky_21310ee3:

    # voice "voice/Owl/3day/21 E.ogg"
    # Owl "И то верно!" id beasts_sky_21310ee3
    voice "voice/Owl/3day/21 E.ogg"
    Owl "І тое праўда!" id beasts_sky_21310ee3

# game/scripts/scene/scene_day_3.rpy:9820
translate belarusian beasts_sky_1e60c89c:

    # "Мелодия кружилась по поляне, как вихрь."
    "Мелодыя кружылася па паляне, як віхор."

# game/scripts/scene/scene_day_3.rpy:9822
translate belarusian beasts_sky_c458ee4a:

    # "Не терпелось выпустить ту энергию, тот жар, которыми меня наполняла чарующая музыка."
    "Не цярпелася выпусціць тую энергію, той жар, якімі мяне напаўняла чароўная музыка."

# game/scripts/scene/scene_day_3.rpy:9850
translate belarusian beasts_sky_69a1a09d:

    # "Сова прыгнула и исчезла высоко вверху."
    "Сава падскочыла і знікла высока ўверсе."

# game/scripts/scene/scene_day_3.rpy:9879
translate belarusian beasts_sky_82e540f6:

    # "Над головой раздался её смех, а потом она приземлилась обратно, фырча и отдуваясь."
    "Над галавой раздаўся яе смех, а потым яна прызямлілася назад, фыркаючы і аддыхваючыся."

# game/scripts/scene/scene_day_3.rpy:9882
translate belarusian beasts_sky_0c6129f9:

    # voice "voice/Alisa/3day/48 E.ogg"
    # Alis "И ты так можешь! Попробуй!"
    voice "voice/Alisa/3day/48 E.ogg"
    Alis "І ты так можаш! Паспрабуй!"

# game/scripts/scene/scene_day_3.rpy:9885
translate belarusian beasts_sky_1d25fc8f:

    # "Я попробовал."
    "Я паспрабаваў."

# game/scripts/scene/scene_day_3.rpy:9912
translate belarusian beasts_sky_64129bee:

    # "Ноги оттолкнулись от земли. Я взлетел ракетой к звёздам и закричал от счастья, увидев своих друзей внизу."
    "Ногі адштурхнуліся ад зямлі. Я ўзляцеў ракетай да зорак і закрычаў ад шчасця, убачыўшы сваіх сяброў унізе."

# game/scripts/scene/scene_day_3.rpy:9913
translate belarusian beasts_sky_b9e86728:

    # "Ветер помогал мне лететь. Словно я скакал на громадном батуте."
    "Вецер дапамагаў мне ляцець. Быццам я скакаў на велізарным батуце."

# game/scripts/scene/scene_day_3.rpy:9935
translate belarusian beasts_sky_cce17748:

    # Narrator_color "Звёзды казались яркими блёстками, до которых можно дотянуться языком, слизнуть."
    Narrator_color "Зоркі здаваліся яркімі бліскаўкамі, да якіх можна дацягнуцца языком, злізнуць."

# game/scripts/scene/scene_day_3.rpy:9953
translate belarusian beasts_sky_1cb6d5e3:

    # Narrator_color "Луна стала ближе... А потом я полетел вниз."
    Narrator_color "Месяц стаў бліжэй... А потым я паляцеў уніз."

# game/scripts/scene/scene_day_3.rpy:9955
translate belarusian beasts_sky_0a78d3d0:

    # Narrator_color "Лишь на мгновение испугался, что сломаю ноги, но подошвы твёрдо встали на снег."
    Narrator_color "Толькі на імгненне спалохаўся, што зламаю ногі, але падэшвы цвёрда ўсталі на снег."

# game/scripts/scene/scene_day_3.rpy:9958
translate belarusian beasts_sky_9eb58680:

    # voice "voice/Alisa/3day/49 S.ogg"
    # Alis_Color "С нами ты в безопасности!"
    voice "voice/Alisa/3day/49 S.ogg"
    Alis_Color "З намі ты ў бяспецы!"

# game/scripts/scene/scene_day_3.rpy:9960
translate belarusian beasts_sky_0256a9de:

    # voice "voice/Alisa/3day/50 E.ogg"
    # Alis_Color "И все твои мечты станут явью!"
    voice "voice/Alisa/3day/50 E.ogg"
    Alis_Color "І ўсе твае мары стануць явай!"

# game/scripts/scene/scene_day_3.rpy:9962
translate belarusian beasts_sky_1d38266e:

    # voice "voice/Alisa/3day/51 Ya.ogg"
    # Alis_Color "Я так счастлива наконец обрести тебя..."
    voice "voice/Alisa/3day/51 Ya.ogg"
    Alis_Color "Я такая шчаслівая нарэшце здабыць цябе..."

# game/scripts/scene/scene_day_3.rpy:9964
translate belarusian beasts_sky_00371ad9:

    # voice "voice/Alisa/3day/52 Z.ogg"
    # Alis_Color "Зайчик."
    voice "voice/Alisa/3day/52 Z.ogg"
    Alis_Color "Зайчык."

# game/scripts/scene/scene_day_3.rpy:9967
translate belarusian beasts_sky_6ffd835a:

    # Narrator_color "Смеясь от восторга, я понял главное: эти четверо не причинят мне вреда."
    Narrator_color "Смеючыся ад захаплення, я зразумеў галоўнае: гэтыя чацвёра не прычыняць мне шкоды."

# game/scripts/scene/scene_day_3.rpy:9968
translate belarusian beasts_sky_472985bb:

    # Narrator_color "А настоящие враги – я чувствовал это каждой шерстинкой своей маски – те, кто далёк от волшебства."
    Narrator_color "А сапраўдныя ворагі — я адчуваў гэта кожнай шарсцінкай сваёй маскі — тыя, хто далёкі ад чараўніцтва."

# game/scripts/scene/scene_day_3.rpy:9969
translate belarusian beasts_sky_69e6dd6b:

    # Narrator_color "Люди из посёлка."
    Narrator_color "Людзі з пасёлка."

# game/scripts/scene/scene_day_3.rpy:9989
translate belarusian beasts_sky_1aa91998:

    # Narrator_color "Ещё я понял, что всё вокруг по-настоящему живое."
    Narrator_color "Яшчэ я зразумеў, што ўсё вакол па-сапраўднаму жывое."

# game/scripts/scene/scene_day_3.rpy:9990
translate belarusian beasts_sky_0e6fcd7f:

    # Narrator_color "Услышал, как стонет под снегом сухая трава; увидел, что у деревьев и звёзд есть лица. Деревья ухмылялись, а звёзды корчились в страхе."
    Narrator_color "Пачуў, як стогне пад снегам сухая трава; убачыў, што ў дрэў і зорак ёсць твары. Дрэвы ўхмыляліся, а зоркі курчыліся ў страху."

# game/scripts/scene/scene_day_3.rpy:9996
translate belarusian beasts_sky_10318250:

    # Narrator_color "«{i}Правильно! Бойтесь! Я допрыгну до вас и…{/i}»"
    Narrator_color "«{i}Правільна! Бойцеся! Я даскочу да вас і…{/i}»"

# game/scripts/scene/scene_day_3.rpy:9997
translate belarusian beasts_sky_ad2b5d27:

    # Narrator_color "Я щёлкнул зубами. Затем закричал ликующе и прыгнул одновременно с лисой."
    Narrator_color "Я шчоўкнуў зубамі. Потым закрычаў радасна і скокнуў адначасова з лісой."

# game/scripts/scene/scene_day_3.rpy:10033
translate belarusian beasts_sky_7a9bbd8d:

    # Narrator_color "Мы полетели выше самых высоких сосен, и застыли в воздухе."
    Narrator_color "Мы паляцелі вышэй за самыя высокія сосны і застылі ў паветры."

# game/scripts/scene/scene_day_3.rpy:10034
translate belarusian beasts_sky_abab8bee:

    # Narrator_color "Я закружился, Алиса закружилась в такт."
    Narrator_color "Я закружыўся, Аліса закружылася ў такт."

# game/scripts/scene/scene_day_3.rpy:10035
translate belarusian beasts_sky_0cdea2f7:

    # Narrator_color "Я знал, что она улыбается, и улыбался сам."
    Narrator_color "Я ведаў, што яна ўсміхаецца, і ўсміхаўся сам."

# game/scripts/scene/scene_day_3.rpy:10036
translate belarusian beasts_sky_91040269:

    # Narrator_color "А флейта всё играла и играла, унося нас ввысь."
    Narrator_color "А флейта ўсё іграла і іграла, уносячы нас увысь."

# game/scripts/scene/scene_day_3.rpy:10118
translate belarusian dev_day3_end_titr_end_efb0865f:

    # voice "voice/romka/3day/67 Ti.ogg"
    # Rom "Ты чё, опять в облаках витаешь?"
    voice "voice/romka/3day/67 Ti.ogg"
    Rom "Ты чаго, зноў у аблоках лётаеш?"

# game/scripts/scene/scene_day_3.rpy:10126
translate belarusian dev_day3_end_titr_end_fe4f7471:

    # voice "voice/Polina/3day/108 E.ogg"
    # Pol "Эй, тебя что, заколдовали?"
    voice "voice/Polina/3day/108 E.ogg"
    Pol "Эй, цябе што, зачаравалі?"

# game/scripts/scene/scene_day_3.rpy:10179
translate belarusian dev_day3_end_titr_end_ee452fcf:

    # "«С вами полетаешь», — сонно подумал я, отклеивая подбородок от парты."
    "«З вамі палятаеш», — сонна падумаў я, адклейваючы падбародак ад парты."

# game/scripts/scene/scene_day_3.rpy:10182
translate belarusian dev_day3_end_titr_end_9439ffa1:

    # "«Расколдовали», — сонно подумал я, отклеивая подбородок от парты."
    "«Расчаравалі», — сонна падумаў я, адклейваючы падбародак ад парты."

# game/scripts/scene/scene_day_3.rpy:10200
translate belarusian dev_day3_end_titr_end_7e950f17:

    # "Мышцы слегка ныли, но это было приятное чувство."
    "Мышцы злёгку нылі, але гэта было прыемнае пачуццё."

# game/scripts/scene/scene_day_3.rpy:10203
translate belarusian dev_day3_end_titr_end_41aeb84e:

    # "Все отчего-то вновь слонялись по классу, передавали друг другу записки, шушукались."
    "Усе чамусьці зноў бадзяліся па класе, перадавалі адзін аднаму запіскі, шапталіся."

# game/scripts/scene/scene_day_3.rpy:10204
translate belarusian dev_day3_end_titr_end_ecc10028:

    # "Их физиономии казались выцветшими масками, блёклыми и скучными."
    "Іх фізіяноміі здаваліся выцвілымі маскамі, бляклымі і сумнымі."

# game/scripts/scene/scene_day_3.rpy:10224
translate belarusian dev_day3_end_titr_end_5e673bdc:

    # "Я зевнул, вспоминая, как парил высоко над лесом, а рядом смеялась Алиса и крепко сжимала мою ладонь."
    "Я пазяхнуў, узгадваючы, як парыў высока над лесам, а побач смяялася Аліса і моцна сціскала маю далонь."

# game/scripts/scene/scene_day_3.rpy:10225
translate belarusian dev_day3_end_titr_end_4946feda:

    # "Возможно, — и почти наверняка, — это был сон."
    "Магчыма, — і амаль напэўна, — гэта быў сон."

# game/scripts/scene/scene_day_3.rpy:10226
translate belarusian dev_day3_end_titr_end_1c374cc2:

    # "Потому что из лесу я не возвращался, а проснулся дома в кровати обыкновенным утром с чаем и таблетками."
    "Таму што з лесу я не вяртаўся, а прачнуўся дома ў ложку звычайнай раніцай з гарбатай і таблеткамі."

# game/scripts/scene/scene_day_3.rpy:10229
translate belarusian dev_day3_end_titr_end_4ac7f36e:

    # "Но меня мало тревожило разумное объяснение ночным танцам."
    "Але мяне мала трывожыла разумнае тлумачэнне начным танцам."

# game/scripts/scene/scene_day_3.rpy:10230
translate belarusian dev_day3_end_titr_end_f84b49b0:

    # "Куда важнее было чувство полёта."
    "Куды важнейшым было пачуццё палёту."

# game/scripts/scene/scene_day_3.rpy:10248
translate belarusian dev_day3_end_titr_end_6aab3422:

    # "Знание о том, каково висеть над пиками величественных сосен и скалиться на луну."
    "Веданне пра тое, як гэта — вісець над пікамі велічных соснаў і скаліцца на месяц."

# game/scripts/scene/scene_day_3.rpy:10252
translate belarusian dev_day3_end_titr_end_77850305:

    # voice "voice/anton/3day/2. Nu.ogg"
    # Ant "Ну чего?"
    voice "voice/anton/3day/2. Nu.ogg"
    Ant "Ну чаго?"

# game/scripts/scene/scene_day_3.rpy:10256
translate belarusian dev_day3_end_titr_end_173a4201:

    # voice "voice/romka/3day/68 Cho.ogg"
    # Rom "Чего-чего... Пока ты носом клевал, Катька пропала."
    voice "voice/romka/3day/68 Cho.ogg"
    Rom "Чаго-чаго... Пакуль ты носам кляваў, Кацька знікла."

# game/scripts/scene/scene_day_3.rpy:10275
translate belarusian dev_day3_end_titr_end_fd1e13e5:

    # "Сон как рукой сняло. Я недоверчиво нахмурился."
    "Сон як рукой зняло. Я недаверліва нахмурыўся."

# game/scripts/scene/scene_day_3.rpy:10278
translate belarusian dev_day3_end_titr_end_a3237693:

    # voice "voice/anton/3day/7. Pr.ogg"
    # Ant "Прости, задумался."
    voice "voice/anton/3day/7. Pr.ogg"
    Ant "Прабач, задумаўся."

# game/scripts/scene/scene_day_3.rpy:10281
translate belarusian dev_day3_end_titr_end_cb3f51ad:

