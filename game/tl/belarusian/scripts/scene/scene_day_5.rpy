    voice "voice/karina/5day/153 Atep.ogg"
    Mam "А цяпер, калі ласка, Антон. Ты нам вельмі патрэбны тут."

# game/scripts/scene/scene_day_5.rpy:1165
translate belarusian begin_refuse_b9b6d67f:

    # voice "voice/father/day5/17sc.ogg"
    # Pap "Скорей, Карина, мы теряем время."
    voice "voice/father/day5/17sc.ogg"
    Pap "Хутчэй, Карына, мы трацім час."

# game/scripts/scene/scene_day_5.rpy:1188
translate belarusian begin_refuse_3c88a5a8:

    # "Через пять минут двери внизу защёлкнулись, и, сквозь вой вьюги, зажужжал двигатель автомобиля."
    "Праз пяць хвілін дзверы ўнізе зашчоўкнуліся, і праз выццё завеі загудзеў рухавік аўтамабіля."

# game/scripts/scene/scene_day_5.rpy:1196
translate belarusian begin_refuse_45562fd5:

    # voice "voice/olya/5day/07 Pod.ogg"
    # Oly "Под масками темнота."
    voice "voice/olya/5day/07 Pod.ogg"
    Oly "Пад маскамі цемра."

# game/scripts/scene/scene_day_5.rpy:1215
translate belarusian begin_refuse_b72d7466:

    # "Оля описывала в бреду образы из моего сна, вещи, о которых она не могла знать."
    "Оля апісвала ў трызненні вобразы з майго сну, рэчы, пра якія яна не магла ведаць."

# game/scripts/scene/scene_day_5.rpy:1217
translate belarusian begin_refuse_21a8551f:

    # voice "voice/anton/5day/016.Ehne.ogg"
    # Ant "Их не существует."
    voice "voice/anton/5day/016.Ehne.ogg"
    Ant "Іх не існуе."

# game/scripts/scene/scene_day_5.rpy:1314
translate belarusian begin_refuse_f9c6a06d:

    # voice "voice/Bear/5day/1 mi.ogg"
    # "«{sc=2}{i}Мы существуем, ещё как существуем{/i}{/sc}», — голос раздавался в моей голове и в то же время струился из углов и щелей."
    voice "voice/Bear/5day/1 mi.ogg"
    "«{sc=2}{i}Мы існуём, яшчэ як існуём{/i}{/sc}», — голас гучаў у маёй галаве і ў той жа час струменіўся з кутоў і шчылін."

# game/scripts/scene/scene_day_5.rpy:1331
translate belarusian begin_refuse_7139e5fd:

    # voice "voice/Bear/5day/2 mi.ogg"
