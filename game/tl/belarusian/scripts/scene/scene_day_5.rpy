# game/scripts/scene/scene_day_5.rpy:12365
translate belarusian event_m_polina_afterphone_b22299ea:

    # "Я собрался с духом и набрал домашний номер."
    "Я сабраўся з духам і набраў хатні нумар."

# game/scripts/scene/scene_day_5.rpy:12369
translate belarusian event_m_polina_afterphone_f3ff86f4:

    # "Гудки."
    "Гудкі."

# game/scripts/scene/scene_day_5.rpy:12374
translate belarusian event_m_polina_afterphone_fac71b88:

    # "За ними — шорох и тишина в динамике."
    "За імі — шорах і цішыня ў дынаміку."

# game/scripts/scene/scene_day_5.rpy:12375
translate belarusian event_m_polina_afterphone_692d0a4f:

    # "Был бы это папа, сказал бы: «На проводе»."
    "Быў бы гэта тата, сказаў бы: «На провадзе»."

# game/scripts/scene/scene_day_5.rpy:12376
translate belarusian event_m_polina_afterphone_f058719a:

    # "Но мама почему-то всегда молчала, сняв трубку, и ждала, пока собеседник не заговорит первым."
    "Але мама чамусьці заўсёды маўчала, зняўшы слухаўку, і чакала, пакуль суразмоўца не загаворыць першым."

# game/scripts/scene/scene_day_5.rpy:12377
translate belarusian event_m_polina_afterphone_bd5799f8:

    # voice "voice/Anton/5day/150 M.ogg"
    # Ant "Мам, это я."
    voice "voice/Anton/5day/150 M.ogg"
    Ant "Мам, гэта я."

# game/scripts/scene/scene_day_5.rpy:12379
translate belarusian event_m_polina_afterphone_47b0f501:

    # voice "voice/karina/5day/08 Vas.ogg"
    # Mam "Вас что, задержали после уроков?"
    voice "voice/karina/5day/08 Vas.ogg"
    Mam "Вас што, затрымалі пасля ўрокаў?"

# game/scripts/scene/scene_day_5.rpy:12381
translate belarusian event_m_polina_afterphone_1f42348d:

    # voice "voice/Anton/5day/151 Net.ogg"
    # Ant "Нет... тут такое..."
    voice "voice/Anton/5day/151 Net.ogg"
    Ant "Не... тут такое..."

# game/scripts/scene/scene_day_5.rpy:12383
translate belarusian event_m_polina_afterphone_70dedb53:

    # voice "voice/Anton/5day/152 T.ogg"
    # Ant "Ты не волнуйся, мне тут грамоту дали... за человечность и мужество..."
    voice "voice/Anton/5day/152 T.ogg"
    Ant "Ты не хвалюйся, мне тут грамату далі... за чалавечнасць і мужнасць..."

# game/scripts/scene/scene_day_5.rpy:12385
translate belarusian event_m_polina_afterphone_802b6ff8:

    # "Я пошёл с козырей."
    "Я пайшоў з казыроў."

# game/scripts/scene/scene_day_5.rpy:12386
translate belarusian event_m_polina_afterphone_5dc72b97:

    # voice "voice/karina/5day/09 Me.ogg" 
    # Mam "Меня бы устроили хорошие оценки. Без всяких грамот."
    voice "voice/karina/5day/09 Me.ogg" 
    Mam "Мяне б задаволілі добрыя адзнакі. Без усякіх грамат."

# game/scripts/scene/scene_day_5.rpy:12388
translate belarusian event_m_polina_afterphone_39fe5c24:

    # "Снова этот тон Снежной Королевы!"
    "Зноў гэты тон Снежнай Каралевы!"

# game/scripts/scene/scene_day_5.rpy:12401
translate belarusian event_m_polina_afterphone_3c70cd9a:

    # voice "voice/Anton/5day/153 Pr.ogg"
    # Ant "Просто одноклассники так обрадовались за меня."
    voice "voice/Anton/5day/153 Pr.ogg"
    Ant "Проста аднакласнікі так узрадаваліся за мяне."

# game/scripts/scene/scene_day_5.rpy:12405
translate belarusian event_m_polina_afterphone_2c1e5a87:

    # voice "voice/Anton/5day/154  E.ogg"
    # Ant "И мы решили отпраздновать колой и тортом..."
    voice "voice/Anton/5day/154  E.ogg"
    Ant "І мы вырашылі адсвяткаваць колай і тортам..."

# game/scripts/scene/scene_day_5.rpy:12408
translate belarusian event_m_polina_afterphone_6e36358e:

    # "Врать было противно. Но что я мог сказать?"
    "Хлусіць было брыдка. Але што я мог сказаць?"

# game/scripts/scene/scene_day_5.rpy:12409
translate belarusian event_m_polina_afterphone_c94e5a90:

    # "Что я не лез в гараж добровольно?"
    "Што я не лез у гараж добраахвотна?"

# game/scripts/scene/scene_day_5.rpy:12410
translate belarusian event_m_polina_afterphone_f6752b4a:

    # "И что не по собственной инициативе вышел из дома в тот проклятый день, а чтобы избавиться от Жульки?"
    "І што не па ўласнай ініцыятыве выйшаў з дому ў той пракляты дзень, а каб пазбавіцца ад Жулькі?"

# game/scripts/scene/scene_day_5.rpy:12411
translate belarusian event_m_polina_afterphone_500b0313:

    # voice "voice/karina/5day/10 Ka.ogg" 
    # Mam "Какой торт, Антон? Кому я готовила ужин?"
    voice "voice/karina/5day/10 Ka.ogg" 
    Mam "Які торт, Антон? Каму я гатавала вячэру?"

# game/scripts/scene/scene_day_5.rpy:12413
translate belarusian event_m_polina_afterphone_9d1524ca:

    # voice "voice/karina/5day/11 T.ogg" 
    # Mam "Ты снова хочешь вляпаться в неприятности?"
    voice "voice/karina/5day/11 T.ogg" 
    Mam "Ты зноў хочаш уляпацца ў непрыемнасці?"

# game/scripts/scene/scene_day_5.rpy:12416
translate belarusian event_m_polina_afterphone_527fc259:

    # voice "voice/Anton/5day/155 Ya.ogg"
    # Ant "Я подумал... подумал, лучше остаться в большой компании, чем идти одному через посёлок."
    voice "voice/Anton/5day/155 Ya.ogg"
    Ant "Я падумаў... падумаў, лепш застацца ў вялікай кампаніі, чым ісці аднаму праз пасёлак."

# game/scripts/scene/scene_day_5.rpy:12420
translate belarusian event_m_polina_afterphone_e106539e:

    # voice "voice/Anton/5day/156 k.ogg"
    # Ant "К тому же там метель, и она усиливается."
    voice "voice/Anton/5day/156 k.ogg"
    Ant "Да таго ж там завіруха, і яна ўзмацняецца."

# game/scripts/scene/scene_day_5.rpy:12423
translate belarusian event_m_polina_afterphone_5226ae3e:

    # "Мама колебалась несколько секунд."
    "Мама вагалася некалькі секунд."

# game/scripts/scene/scene_day_5.rpy:12424
translate belarusian event_m_polina_afterphone_4f9493a3:

    # voice "voice/karina/5day/12 U.ogg" 
    # Mam "У отца машина опять заглохла, а так бы отвёз тебя домой..."
    voice "voice/karina/5day/12 U.ogg" 
    Mam "У бацькі машына зноў заглухла, а так бы адвёз цябе дадому..."

# game/scripts/scene/scene_day_5.rpy:12426
translate belarusian event_m_polina_afterphone_f7f69684:

    # voice "voice/karina/5day/13 Ho.ogg"
    # Mam "Хорошо, можешь остаться. Но чтобы завтра после школы сразу домой."
    voice "voice/karina/5day/13 Ho.ogg"
    Mam "Добра, можаш застацца. Але каб заўтра пасля школы адразу дадому."

# game/scripts/scene/scene_day_5.rpy:12428
translate belarusian event_m_polina_afterphone_47a417cb:

    # "Сработало!"
    "Спрацавала!"

# game/scripts/scene/scene_day_5.rpy:12429
translate belarusian event_m_polina_afterphone_9b9e44c1:

    # voice "voice/karina/5day/14 T.ogg"
    # Mam "Ты у кого ночуешь, Антон?"
    voice "voice/karina/5day/14 T.ogg"
    Mam "Ты ў каго начуеш, Антон?"

# game/scripts/scene/scene_day_5.rpy:12431
translate belarusian event_m_polina_afterphone_83533a65:

    # voice "voice/karina/5day/15 Ch.ogg" 
    # Mam "Чтобы я, если что, позвонить могла?"
    voice "voice/karina/5day/15 Ch.ogg" 
    Mam "Каб я, калі што, патэлефанаваць магла?"

# game/scripts/scene/scene_day_5.rpy:12439
translate belarusian event_m_polina_afterphone_8dfe377e:

    # voice "voice/Anton/5day/U.ogg"
    # Ant "У..."
    voice "voice/Anton/5day/U.ogg"
    Ant "У..."

# game/scripts/scene/scene_day_5.rpy:12455
translate belarusian event_m_polina_afterphone_d7c60c86:

    # "Я вынул из кармана объявления и пересёкся взглядом с зернистой фотографией Бяши."
    "Я выняў з кішэні аб'явы і сустрэўся позіркам з зярністым фотаздымкам Бяшы."

# game/scripts/scene/scene_day_5.rpy:12456
translate belarusian event_m_polina_afterphone_b9b82b63:

    # voice "voice/Anton/5day/157 U.ogg"
    # Ant "У Бя... У Будаева Игоря."
    voice "voice/Anton/5day/157 U.ogg"
    Ant "У Бя... У Будаева Ігара."

# game/scripts/scene/scene_day_5.rpy:12461
translate belarusian event_m_polina_afterphone_41d7f9da:

    # "Я машинально назвал телефон Полины."
    "Я машынальна назваў тэлефон Паліны."

# game/scripts/scene/scene_day_5.rpy:12462
translate belarusian event_m_polina_afterphone_020c0d95:

    # voice "voice/Anton/5day/158 T.ogg"
    # Ant "3-24-92"
    voice "voice/Anton/5day/158 T.ogg"
    Ant "3-24-92"

# game/scripts/scene/scene_day_5.rpy:12464
translate belarusian event_m_polina_afterphone_225f3d34:

    # voice "voice/karina/5day/16 Pe.ogg" 
    # Mam "Передавай привет Игорю. И не забывай про лекарства."
    voice "voice/karina/5day/16 Pe.ogg" 
    Mam "Перадавай прывітанне Ігару. І не забывай пра лекі."

# game/scripts/scene/scene_day_5.rpy:12466
translate belarusian event_m_polina_afterphone_c887457f:

    # voice "voice/Anton/5day/159 S.ogg"
    # Ant "Спасибо! Не забуду!"
    voice "voice/Anton/5day/159 S.ogg"
    Ant "Дзякуй! Не забуду!"

# game/scripts/scene/scene_day_5.rpy:12468
translate belarusian event_m_polina_afterphone_bd6dd6be:

    # voice "voice/Anton/5day/160 Ma.ogg"
    # Ant "Мам, а как там Оля?"
    voice "voice/Anton/5day/160 Ma.ogg"
    Ant "Мам, а як там Оля?"

# game/scripts/scene/scene_day_5.rpy:12473
translate belarusian event_m_polina_afterphone_253adcc6:

    # "Мама резко бросила трубку. Наверное, не услышала."
    "Мама рэзка кінула слухаўку. Напэўна, не пачула."

# game/scripts/scene/scene_day_5.rpy:12489
translate belarusian event_m_polina_afterphone_7e69ecd3:

    # "Я положил телефон на место и заглянул в дверной проём, куда ушла Полина."
    "Я паклаў тэлефон на месца і зазірнуў у дзвярны праём, куды пайшла Паліна."

# game/scripts/scene/scene_day_5.rpy:12501
translate belarusian event_m_polina_afterphone_13a56fd7:

    # "Девочка распихивала по шкафам вещи."
    "Дзяўчынка распіхвала па шафах рэчы."

# game/scripts/scene/scene_day_5.rpy:12503
translate belarusian event_m_polina_afterphone_b008ddab:

    # voice "voice/Polina/5day/83 Mo.ogg"
    # Pol "Можешь заходить."
    voice "voice/Polina/5day/83 Mo.ogg"
    Pol "Можаш заходзіць."

# game/scripts/scene/scene_day_5.rpy:12521
translate belarusian event_m_polina_afterphone_b5dca808:

    # voice "voice/Polina/5day/84 D.ogg" 
    # Pol "Джоанна спряталась в шкафу, так что пока ты в безопасности."
    voice "voice/Polina/5day/84 D.ogg" 
    Pol "Джаана схавалася ў шафе, так што пакуль ты ў бяспецы."

# game/scripts/scene/scene_day_5.rpy:12527
translate belarusian event_m_polina_afterphone_4047a253:

    # voice "voice/Polina/5day/85 Eto.ogg" 
    # Pol "Это, если что, кошка моя. Она чужаков не любит, может и поцарапать."
    voice "voice/Polina/5day/85 Eto.ogg" 
    Pol "Гэта, калі што, котка мая. Яна чужынцаў не любіць, можа і падрапаць."

# game/scripts/scene/scene_day_5.rpy:12532
translate belarusian event_m_polina_afterphone_8eb215f2:

    # voice "voice/Polina/5day/86 Ch.ogg"
    # Pol "Что сказала мама?"
    voice "voice/Polina/5day/86 Ch.ogg"
    Pol "Што сказала мама?"

# game/scripts/scene/scene_day_5.rpy:12537
translate belarusian event_m_polina_afterphone_ed0914b5:

    # "Я вздохнул."
    "Я ўздыхнуў."

# game/scripts/scene/scene_day_5.rpy:12540
translate belarusian event_m_polina_afterphone_68fe26af:

    # voice "voice/Anton/5day/162 Che.ogg"
    # Ant "Честно говоря, думал, будет хуже. Наорёт и всё."
    voice "voice/Anton/5day/162 Che.ogg"
    Ant "Шчыра кажучы, думаў, будзе горш. Накрычыць і ўсё."

# game/scripts/scene/scene_day_5.rpy:12544
translate belarusian event_m_polina_afterphone_d330dda7:

    # voice "voice/Polina/5day/87 ne.ogg"
    # Pol "Недооцениваешь свою маму, Петров!"
    voice "voice/Polina/5day/87 ne.ogg"
    Pol "Недаацэньваеш сваю маму, Пятроў!"

# game/scripts/scene/scene_day_5.rpy:12548
translate belarusian event_m_polina_afterphone_82927640:

    # voice "voice/Polina/5day/88 Z.ogg" 
    # Pol "Значит, отпустила?"
    voice "voice/Polina/5day/88 Z.ogg" 
    Pol "Значыць, адпусціла?"

# game/scripts/scene/scene_day_5.rpy:12552
translate belarusian event_m_polina_afterphone_5f803bf4:

    # voice "voice/Polina/5day/89 Ur.ogg"
    # Pol "Ура-ура!"
    voice "voice/Polina/5day/89 Ur.ogg"
    Pol "Ура-ура!"

# game/scripts/scene/scene_day_5.rpy:12560
translate belarusian event_m_polina_afterphone_ce88997c:

    # voice "voice/Polina/5day/90  Sl.ogg"
    # Pol "Слышишь?"
    voice "voice/Polina/5day/90  Sl.ogg"
    Pol "Чуеш?"

# game/scripts/scene/scene_day_5.rpy:12565
translate belarusian event_m_polina_afterphone_9d1963c6:

    # "Полина подняла палец."
    "Паліна падняла палец."

# game/scripts/scene/scene_day_5.rpy:12566
translate belarusian event_m_polina_afterphone_8dfaf3f6:

    # "Метель за окнами свирепела. К утру улицы совсем занесёт."
    "Завіруха за вокнамі лютавала. Да раніцы вуліцы зусім занясе."

# game/scripts/scene/scene_day_5.rpy:12569
translate belarusian event_m_polina_afterphone_ef64f202:

    # voice "voice/Polina/5day/91 ho.ogg" 
    # Pol "Хорошо, что ты здесь. Я такая трусиха."
    voice "voice/Polina/5day/91 ho.ogg" 
    Pol "Добра, што ты тут. Я такая баязліўка."

# game/scripts/scene/scene_day_5.rpy:12586
translate belarusian event_m_polina_afterphone_aae8e91e:

    # voice "voice/Polina/5day/92 Da.ogg" 
    # Pol "Давай посмотрим телевизор, пока не выбило..."
    voice "voice/Polina/5day/92 Da.ogg" 
    Pol "Давай паглядзім тэлевізар, пакуль не выбіла..."

# game/scripts/scene/scene_day_5.rpy:12588
translate belarusian event_m_polina_afterphone_279c876f:

    # "Комната погрузилась во мрак. Ветер злорадно завывал снаружи."
    "Пакой патануў у змроку. Вецер зларадна завываў звонку."

# game/scripts/scene/scene_day_5.rpy:12589
translate belarusian event_m_polina_afterphone_560ebd0d:

    # voice "voice/Polina/5day/94 pro.ogg" 
    # Pol "... пробки."
    voice "voice/Polina/5day/94 pro.ogg" 
    Pol "... коркі."

# game/scripts/scene/scene_day_5.rpy:12591
translate belarusian event_m_polina_afterphone_a7d0139a:

    # voice "voice/Polina/5day/95 S.ogg" 
    # Pol "Сглазила. У нас такое постоянно."
    voice "voice/Polina/5day/95 S.ogg" 
    Pol "Сурочыла. У нас такое пастаянна."

# game/scripts/scene/scene_day_5.rpy:12593
translate belarusian event_m_polina_afterphone_6c1166a1:

    # voice "voice/Polina/5day/96 Po.ogg"
    # Pol "Постой, где-то здесь..."
    voice "voice/Polina/5day/96 Po.ogg"
    Pol "Пачакай, недзе тут..."

# game/scripts/scene/scene_day_5.rpy:12616
translate belarusian event_m_polina_afterphone_c899c4ce:

    # "Зашуршало, вспыхнула, осветив лицо Полины, спичка, а затем занялся фитиль свечи."
    "Зашамацела, успыхнула, асвятліўшы твар Паліны, запалка, а потым заняўся кнот свечкі."

# game/scripts/scene/scene_day_5.rpy:12618
translate belarusian event_m_polina_afterphone_e503a4a2:

    # "Несмотря на яростный ветер, в спальне сделалось как-то по-особенному уютно."
    "Нягледзячы на шалёны вецер, у спальні стала неяк па-асабліваму ўтульна."

# game/scripts/scene/scene_day_5.rpy:12619
translate belarusian event_m_polina_afterphone_8093bde6:

    # "Так бывает зимой, в непогоду, если знаешь, что дома тебе ничего не грозит."
    "Так бывае зімой, у непагадзь, калі ведаеш, што дома табе нічога не пагражае."

# game/scripts/scene/scene_day_5.rpy:12620
translate belarusian event_m_polina_afterphone_fe15db26:

    # "И можно даже пофантазировать о привидениях, щекоча нервы."
    "І можна нават пафантазаваць пра прывідаў, казычучы нервы."

# game/scripts/scene/scene_day_5.rpy:12621
translate belarusian event_m_polina_afterphone_9170fe16:

    # "Но я не желал думать ни о чём подобном."
    "Але я не жадаў думаць ні пра што падобнае."

# game/scripts/scene/scene_day_5.rpy:12637
translate belarusian event_m_polina_afterphone_d6ec42fe:

    # "Полина зажгла множество свечей. Видимо, свет в её доме отключали часто."
    "Паліна запаліла мноства свечак. Відаць, святло ў яе доме адключалі часта."

# game/scripts/scene/scene_day_5.rpy:12638
translate belarusian event_m_polina_afterphone_4bc6a68f:

    # voice "voice/Polina/5day/97 Te.ogg" 
    # Pol "Телевизор отпадает. Может, сыграешь мне на гитаре?"
    voice "voice/Polina/5day/97 Te.ogg" 
    Pol "Тэлевізар адпадае. Можа, сыграеш мне на гітары?"

# game/scripts/scene/scene_day_5.rpy:12640
translate belarusian event_m_polina_afterphone_c5e98ee4:

    # voice "voice/Anton/5day/163 Ya.ogg"
    # Ant "Я? Да мне медведь все уши оттоптал."
    voice "voice/Anton/5day/163 Ya.ogg"
    Ant "Я? Ды мне мядзведзь усе вушы адтаптаў."

# game/scripts/scene/scene_day_5.rpy:12642
translate belarusian event_m_polina_afterphone_bd5fabae:

    # voice "voice/Polina/5day/98 Go.ogg" 
    # Pol "Говорила я с этим медведем, он сказал, ты преувеличиваешь."
    voice "voice/Polina/5day/98 Go.ogg" 
    Pol "Гаварыла я з гэтым мядзведзем, ён сказаў, ты перабольшваеш."

# game/scripts/scene/scene_day_5.rpy:12644
translate belarusian event_m_polina_afterphone_15c709c3:

    # voice "voice/Polina/5day/99 Eto.ogg" 
    # Pol "Это очень просто."
    voice "voice/Polina/5day/99 Eto.ogg" 
    Pol "Гэта вельмі проста."

# game/scripts/scene/scene_day_5.rpy:12661
translate belarusian event_m_polina_guitar_intro_talk_57ac6a5b:

    # "Она принесла гитару и встала позади меня."
    "Яна прынесла гітару і стала пазаду мяне."

# game/scripts/scene/scene_day_5.rpy:12669
translate belarusian event_m_polina_guitar_intro_talk_3c362fa0:

    # "Я дёрнул нейлоновые струны, музыкальный инструмент немелодично запротестовал."
    "Я тузануў нейлонавыя струны, музычны інструмент немеладычна запратэставаў."

# game/scripts/scene/scene_day_5.rpy:12672
translate belarusian event_m_polina_guitar_intro_talk_369a0e9d:

    # voice "voice/Anton/5day/164 G.ogg"
    # Ant "Говорю же."
    voice "voice/Anton/5day/164 G.ogg"
    Ant "Кажу ж."

# game/scripts/scene/scene_day_5.rpy:12677
translate belarusian event_m_polina_guitar_intro_talk_cae61caa:

    # voice "voice/Polina/5day/100 Te.ogg" 
    # Pol "Тебе нужен репетитор."
    voice "voice/Polina/5day/100 Te.ogg" 
    Pol "Табе патрэбен рэпетытар."

# game/scripts/scene/scene_day_5.rpy:12681
translate belarusian event_m_polina_guitar_intro_talk_bfdb2571:

    # voice "voice/Polina/5day/101 be.ogg"
    # Pol "Беру дорого, но оно того стоит."
    voice "voice/Polina/5day/101 be.ogg"
    Pol "Бяру дорага, але яно таго вартае."

# game/scripts/scene/scene_day_5.rpy:12688
translate belarusian event_m_polina_guitar_intro_talk_363b77c1:

    # voice "voice/Polina/5day/102 Po.ogg" 
    # Pol "Повернись-ка вот так. Не души её. Пальцы сюда."
    voice "voice/Polina/5day/102 Po.ogg" 
    Pol "Павярніся вось так. Не душы яе. Пальцы сюды."

# game/scripts/scene/scene_day_5.rpy:12693
translate belarusian event_m_polina_guitar_intro_talk_aa465def:

    # "Стоя позади меня, Полина «лепила» мою руку, как скульптор — глину."
    "Стоячы пазаду мяне, Паліна «ляпіла» маю руку, як скульптар — гліну."

# game/scripts/scene/scene_day_5.rpy:12694
translate belarusian event_m_polina_guitar_intro_talk_66cb66d9:

    # "Я почувствовал запах её шампуня. По телу разлилось тепло, и мне стало плевать на метель."
    "Я адчуў пах яе шампуню. Па целе разлілося цяпло, і мне стала пляваць на завіруху."

# game/scripts/scene/scene_day_5.rpy:12724
translate belarusian event_m_polina_guitar_intro_talk_c091aa90:

    # voice "voice/Polina/5day/103 p.ogg" 
    # Pol "Потом сюда... сюда... Ем, Ам, D... G... C..."
    voice "voice/Polina/5day/103 p.ogg" 
    Pol "Потым сюды... сюды... Em, Am, D... G... C..."

# game/scripts/scene/scene_day_5.rpy:12732
translate belarusian event_m_polina_guitar_intro_talk_ea7dbddd:

    # voice "voice/Anton/5day/165 K.ogg"
    # Ant "Какой-нибудь Паганини?"
    voice "voice/Anton/5day/165 K.ogg"
    Ant "Які-небудзь Паганіні?"

# game/scripts/scene/scene_day_5.rpy:12737
translate belarusian event_m_polina_guitar_intro_talk_4f619b8d:

    # voice "voice/Polina/5day/104 E.ogg" 
    # Pol "Если бы."
    voice "voice/Polina/5day/104 E.ogg" 
    Pol "Каб жа."

# game/scripts/scene/scene_day_5.rpy:12741
translate belarusian event_m_polina_guitar_intro_talk_8e034f10:

    # voice "voice/Polina/5day/105 Ya.ogg" 
    # Pol "Я эту мелодию сама написала. Нравится?"
    voice "voice/Polina/5day/105 Ya.ogg" 
    Pol "Я гэтую мелодыю сама напісала. Падабаецца?"

# game/scripts/scene/scene_day_5.rpy:12746
translate belarusian event_m_polina_guitar_intro_talk_70fe531a:

    # voice "voice/Anton/5day/166 P.ogg"
    # Ant "Правда? Звучит как какой-то радио-хит."
    voice "voice/Anton/5day/166 P.ogg"
    Ant "Праўда? Гучыць як нейкі радыёхіт."

# game/scripts/scene/scene_day_5.rpy:12750
translate belarusian event_m_polina_guitar_intro_talk_08f4b053:

    # voice "voice/Anton/5day/167 Me.ogg"
    # Ant "Мелодия такая цепляющая... и одновременно очень знакомая."
    voice "voice/Anton/5day/167 Me.ogg"
    Ant "Мелодыя так чапляе... і адначасова вельмі знаёмая."

# game/scripts/scene/scene_day_5.rpy:12756
translate belarusian event_m_polina_guitar_intro_talk_c003e98c:

    # voice "voice/Polina/5day/106 S.ogg"
    # Pol "Спасибо. Ты меня прям засмущал."
    voice "voice/Polina/5day/106 S.ogg"
    Pol "Дзякуй. Ты мяне аж збянтэжыў."

# game/scripts/scene/scene_day_5.rpy:12760
translate belarusian event_m_polina_guitar_intro_talk_fc9214aa:

    # voice "voice/Polina/5day/107 Ya.ogg" 
    # Pol "Я, конечно, эстраду не жалую, но тут соглашусь — звучит попсовенько."
    voice "voice/Polina/5day/107 Ya.ogg" 
    Pol "Я, вядома, эстраду не шаную, але тут пагаджуся — гучыць папсовенька."

# game/scripts/scene/scene_day_5.rpy:12764
translate belarusian event_m_polina_guitar_intro_talk_f534323e:

    # voice "voice/Polina/5day/108 Da.ogg"
    # Pol "Давай, ты сам сможешь."
    voice "voice/Polina/5day/108 Da.ogg"
    Pol "Давай, ты сам зможаш."

# game/scripts/scene/scene_day_5.rpy:12810
translate belarusian event_m_polina_guitar_r_fail_f1741f6f:

    # voice "voice/Polina/5day/115 Po.ogg" 
    # Pol "Попробуем сыграть ещё раз?"
    voice "voice/Polina/5day/115 Po.ogg" 
    Pol "Паспрабуем сыграць яшчэ раз?"

# game/scripts/scene/scene_day_5.rpy:12822
translate belarusian event_m_polina_guitar_r2_polina_before_943a0138:

    # voice "voice/Anton/5day/168 K.ogg"
    # Ant "Класс! У меня получается!"
    voice "voice/Anton/5day/168 K.ogg"
    Ant "Клас! У мяне атрымліваецца!"

# game/scripts/scene/scene_day_5.rpy:12827
translate belarusian event_m_polina_guitar_r2_polina_before_2753e65c:

    # voice "voice/Polina/5day/121 A.ogg"
    # Pol "А я говорила! У тебя пальцы гитариста!"
    voice "voice/Polina/5day/121 A.ogg"
    Pol "А я казала! У цябе пальцы гітарыста!"

# game/scripts/scene/scene_day_5.rpy:12847
translate belarusian event_m_polina_guitar_r3_polina_before_2b8c6b69:

    # voice "voice/Anton/5day/169 T.ogg"
    # Ant "Ты клёвый репетитор!"
    voice "voice/Anton/5day/169 T.ogg"
    Ant "Ты клёвы рэпетытар!"

# game/scripts/scene/scene_day_5.rpy:12852
translate belarusian event_m_polina_guitar_r3_polina_before_83d187dd:

    # voice "voice/Polina/5day/122 Og.ogg" 
    # Pol "Ого! Может, попробуешь и скрипку?"
    voice "voice/Polina/5day/122 Og.ogg" 
    Pol "Ого! Можа, паспрабуеш і скрыпку?"

# game/scripts/scene/scene_day_5.rpy:12885
translate belarusian event_m_polina_guitar_abort_bb2a0514:

    # voice "voice/Polina/5day/126 S.ogg" 
    # Pol "Сдаёшься?"
    voice "voice/Polina/5day/126 S.ogg" 
    Pol "Здаешся?"

# game/scripts/scene/scene_day_5.rpy:12890
translate belarusian event_m_polina_guitar_abort_def070c8:

    # voice "voice/Anton/5day/170 P.ogg"
    # Ant "Прости, мне легче нарисовать музыку, чем её сыграть."
    voice "voice/Anton/5day/170 P.ogg"
    Ant "Прабач, мне лягчэй намаляваць музыку, чым яе сыграць."

# game/scripts/scene/scene_day_5.rpy:12898
translate belarusian event_m_polina_guitar_abort_0a54f0d3:

    # "Я хотел было отдать Полине гитару, но она ещё сильнее прижалась ко мне."
    "Я хацеў быў аддаць Паліне гітару, але яна яшчэ мацней прытулілася да мяне."

# game/scripts/scene/scene_day_5.rpy:12901
translate belarusian event_m_polina_guitar_abort_ea596a6a:

    # voice "voice/Polina/5day/127 Eh.ogg" 
    # Pol "Эх, визуалы. Тяжко мне с вами."
    voice "voice/Polina/5day/127 Eh.ogg" 
    Pol "Эх, візуалы. Цяжка мне з вамі."

# game/scripts/scene/scene_day_5.rpy:12905
translate belarusian event_m_polina_guitar_abort_d74c8d72:

    # "Я покраснел от макушки и до пят."
    "Я пачырванеў ад макаўкі і да пят."

# game/scripts/scene/scene_day_5.rpy:12909
translate belarusian event_m_polina_guitar_abort_59ddcfc2:

    # "Не глядя на гриф, улыбаясь мне, она провела по струнам тонкими пальцами."
    "Не гледзячы на грыф, усміхаючыся мне, яна правяла па струнах тонкімі пальцамі."

# game/scripts/scene/scene_day_5.rpy:12910
translate belarusian event_m_polina_guitar_abort_02dfc28d:

    # "Гитара отозвалась мелодично."
    "Гітара адгукнулася меладычна."

# game/scripts/scene/scene_day_5.rpy:12911
translate belarusian event_m_polina_guitar_abort_dffb4cc4:

    # "Полина наслаждалась тем, как легко даются ей аккорды, а я наслаждался мелодией, уносящей вдаль, прочь от зимы."
    "Паліна насалоджвалася тым, як лёгка даюцца ёй акорды, а я насалоджваўся мелодыяй, што несла ўдалячынь, прэч ад зімы."

# game/scripts/scene/scene_day_5.rpy:12912
translate belarusian event_m_polina_guitar_abort_477a5f04:

    # "Все проклятые старые дома оставались в прошлом."
    "Усе праклятыя старыя дамы заставаліся ў мінулым."

# game/scripts/scene/scene_day_5.rpy:12915
translate belarusian event_m_polina_guitar_abort_929f7151:

    # voice "voice/Polina/5day/128 La.ogg"
    # Pol "Ладно, тебе не обязательно быть рок-звездой."
    voice "voice/Polina/5day/128 La.ogg"
    Pol "Добра, табе не абавязкова быць рок-зоркай."

# game/scripts/scene/scene_day_5.rpy:12919
translate belarusian event_m_polina_guitar_abort_c2a631c7:

    # voice "voice/Polina/5day/129 Do.ogg" 
    # Pol "Достаточно того, что ты художник. И смельчак."
    voice "voice/Polina/5day/129 Do.ogg" 
    Pol "Дастаткова таго, што ты мастак. І смяльчак."

# game/scripts/scene/scene_day_5.rpy:12949
translate belarusian event_m_polina_guitar_success_b6ae9952:

    # voice "voice/Anton/5day/171 S.ogg"
    # Ant "Слышишь! У меня получается!"
    voice "voice/Anton/5day/171 S.ogg"
    Ant "Чуеш! У мяне атрымліваецца!"

# game/scripts/scene/scene_day_5.rpy:12955
translate belarusian event_m_polina_guitar_success_1fbfd4e0:

    # voice "voice/Polina/5day/124 Ok.ogg"
    # Pol "Оказывается, ты не только художник, но ещё и рок-звезда."
    voice "voice/Polina/5day/124 Ok.ogg"
    Pol "Аказваецца, ты не толькі мастак, але яшчэ і рок-зорка."

# game/scripts/scene/scene_day_5.rpy:12959
translate belarusian event_m_polina_guitar_success_43cd3332:

    # voice "voice/Polina/5day/125 U.ogg" 
    # Pol "У тебя уже биография покруче чем у многих, смельчак."
    voice "voice/Polina/5day/125 U.ogg" 
    Pol "У цябе ўжо біяграфія круцейшая, чым у многіх, смяльчак."

# game/scripts/scene/scene_day_5.rpy:12971
translate belarusian event_m_polina_guitar_fail_01_40d02bf0:

    # voice "voice/Polina/5day/114 Ch.ogg"
    # Pol "Что ж, нужно было начинать с песен попроще, например, «Король и Шут»."
    voice "voice/Polina/5day/114 Ch.ogg"
    Pol "Што ж, трэба было пачынаць з песень прасцейшых, напрыклад, «Кароль і Шут»."

# game/scripts/scene/scene_day_5.rpy:12976
translate belarusian event_m_polina_guitar_fail_01_74748bb3:

    # voice "voice/Anton/5day/172 T.ogg"
    # Ant "Только если у них есть песни с одним аккордом."
    voice "voice/Anton/5day/172 T.ogg"
    Ant "Толькі калі ў іх ёсць песні з адным акордам."

# game/scripts/scene/scene_day_5.rpy:12983
translate belarusian event_m_polina_guitar_fail_02_7d4f1db3:

    # voice "voice/Anton/5day/173 A.ogg"
    # Ant "А гитара точно настроена?"
    voice "voice/Anton/5day/173 A.ogg"
    Ant "А гітара дакладна настроена?"

# game/scripts/scene/scene_day_5.rpy:12988
translate belarusian event_m_polina_guitar_fail_02_bf4e754b:

    # voice "voice/Polina/5day/116 Ne.ogg" 
    # Pol "Не стоит винить в неудачах музыкальный инструмент!"
    voice "voice/Polina/5day/116 Ne.ogg" 
    Pol "Не варта вінаваціць у няўдачах музычны інструмент!"

# game/scripts/scene/scene_day_5.rpy:12995
translate belarusian event_m_polina_guitar_fail_03_0f4338a5:

    # voice "voice/Polina/5day/117 La.ogg" 
    # Pol "Ладно, Сальвадор Дали тоже не был великим гитаристом."
    voice "voice/Polina/5day/117 La.ogg" 
    Pol "Добра, Сальвадор Далі таксама не быў вялікім гітарыстам."

# game/scripts/scene/scene_day_5.rpy:13000
translate belarusian event_m_polina_guitar_fail_03_92b1683a:

    # voice "voice/Anton/5day/174 T.ogg"
    # Ant "Ты умеешь успокаивать, но лучше б я не начинал."
    voice "voice/Anton/5day/174 T.ogg"
    Ant "Ты ўмееш супакойваць, але лепш бы я не пачынаў."

# game/scripts/scene/scene_day_5.rpy:13007
translate belarusian event_m_polina_guitar_fail_04_3205ad7b:

    # voice "voice/Anton/5day/175 Ya.ogg"
    # Ant "Я безнадёжен."
    voice "voice/Anton/5day/175 Ya.ogg"
    Ant "Я безнадзейны."

# game/scripts/scene/scene_day_5.rpy:13012
translate belarusian event_m_polina_guitar_fail_04_e627364b:

    # voice "voice/Polina/5day/118 Ne.ogg" 
    # Pol "Не унывай."
    voice "voice/Polina/5day/118 Ne.ogg" 
    Pol "Не журыся."

# game/scripts/scene/scene_day_5.rpy:13020
translate belarusian event_m_polina_guitar_fail_05_1f6a20b7:

    # voice "voice/Polina/5day/119 T.ogg" 
    # Pol "Ты что, подбираешь песню группы «На-на»?"
    voice "voice/Polina/5day/119 T.ogg" 
    Pol "Ты што, падбіраеш песню гурта «На-на»?"

# game/scripts/scene/scene_day_5.rpy:13027
translate belarusian event_m_polina_guitar_fail_06_099fe814:

    # voice "voice/Anton/5day/176 Y.ogg"
    # Ant "Я перепутал аккорды."
    voice "voice/Anton/5day/176 Y.ogg"
    Ant "Я пераблытаў акорды."

# game/scripts/scene/scene_day_5.rpy:13034
translate belarusian event_m_polina_guitar_fail_07_d69831f9:

    # voice "voice/Polina/5day/120 Ti.ogg" 
    # Pol "Ты слишком напряжён. Расслабь кисть."
    voice "voice/Polina/5day/120 Ti.ogg" 
    Pol "Ты занадта напружаны. Расслаб кісць."

# game/scripts/scene/scene_day_5.rpy:13041
translate belarusian event_m_polina_guitar_fail_08_daae8376:

    # voice "voice/Anton/5day/177 Ya.ogg"
    # Ant "Я только позорюсь."
    voice "voice/Anton/5day/177 Ya.ogg"
    Ant "Я толькі ганьблюся."

# game/scripts/scene/scene_day_5.rpy:13051
translate belarusian event_m_polina_followup_3d84d27b:

    # voice "voice/Anton/5day/178 K.ogg"
    # Ant "Какой я смельчак... Сбежал от тебя тогда, как дурачок."
    voice "voice/Anton/5day/178 K.ogg"
    Ant "Які я смяльчак... Уцёк ад цябе тады, як дурачок."

# game/scripts/scene/scene_day_5.rpy:13055
translate belarusian event_m_polina_followup_8e37c93c:

    # voice "voice/Anton/5day/179 D.ogg"
    # Ant "До сих пор стыдно..."
    voice "voice/Anton/5day/179 D.ogg"
    Ant "Дагэтуль сорамна..."

# game/scripts/scene/scene_day_5.rpy:13060
translate belarusian event_m_polina_followup_3f93529d:

    # voice "voice/Polina/5day/130 Y.ogg" 
    # Pol "Я уже и забыла."
    voice "voice/Polina/5day/130 Y.ogg" 
    Pol "Я ўжо і забыла."

# game/scripts/scene/scene_day_5.rpy:13066
translate belarusian event_m_polina_followup_620a01f2:

    # "Она смотрела мне в глаза, и от этого взгляда бросало то в жар, то в холод."
    "Яна глядзела мне ў вочы, і ад гэтага позірку кідала то ў жар, то ў холад."

# game/scripts/scene/scene_day_5.rpy:13069
translate belarusian event_m_polina_followup_59eec5ac:

    # voice "voice/Polina/5day/131 Mo.ogg" 
    # Pol "Может, переместимся на диванчик?"
    voice "voice/Polina/5day/131 Mo.ogg" 
    Pol "Можа, перамесцімся на канапку?"

# game/scripts/scene/scene_day_5.rpy:13088
translate belarusian event_m_polina_followup_4e3cc0f3:

    # "От предложения у меня спёрло дыхание, но я послушно пересел."
    "Ад прапановы ў мяне заняло дыханне, але я паслухмяна перасеў."

# game/scripts/scene/scene_day_5.rpy:13216
translate belarusian event_m_polina_followup_f2631682:

    # "Полина убрала гитару и устроилась рядышком."
    "Паліна прыбрала гітару і ўладкавалася побач."

# game/scripts/scene/scene_day_5.rpy:13219
translate belarusian event_m_polina_followup_af6603e3:

    # voice "voice/Polina/5day/132 Zn.ogg" 
    # Pol "Знаешь, я хотела тебе кое в чём признаться."
    voice "voice/Polina/5day/132 Zn.ogg" 
    Pol "Ведаеш, я хацела табе ў чымсьці прызнацца."

# game/scripts/scene/scene_day_5.rpy:13223
translate belarusian event_m_polina_followup_5b682665:

    # voice "voice/Polina/5day/133 Ti.ogg" 
    # Pol "Ты мне всегда нравился. С первой встречи. Или раньше..."
    voice "voice/Polina/5day/133 Ti.ogg" 
    Pol "Ты мне заўсёды падабаўся. З першай сустрэчы. Ці раней..."

# game/scripts/scene/scene_day_5.rpy:13227
translate belarusian event_m_polina_followup_0d30c173:

    # voice "voice/Anton/5day/180 k.ogg"
    # Ant "Как это — раньше?"
    voice "voice/Anton/5day/180 k.ogg"
    Ant "Як гэта — раней?"

# game/scripts/scene/scene_day_5.rpy:13231
translate belarusian event_m_polina_followup_e8123553:

    # voice "voice/Polina/5day/134 Nu.ogg" 
    # Pol "Ну знаешь. Девочки придумывают принца."
    voice "voice/Polina/5day/134 Nu.ogg" 
    Pol "Ну ведаеш. Дзяўчынкі прыдумваюць прынца."

# game/scripts/scene/scene_day_5.rpy:13235
translate belarusian event_m_polina_followup_baae4259:

    # voice "voice/Polina/5day/135 mne.ogg" 
    # Pol "Мне кажется, я тебя придумала. А ты появился."
    voice "voice/Polina/5day/135 mne.ogg" 
    Pol "Мне здаецца, я цябе прыдумала. А ты з'явіўся."

# game/scripts/scene/scene_day_5.rpy:13254
translate belarusian event_m_polina_followup_3eb7d050:

    # "У меня закружилась голова, будто я поднимался в небо на колесе обозрения."
    "У мяне закружылася галава, быццам я падымаўся ў неба на коле агляду."

# game/scripts/scene/scene_day_5.rpy:13255
translate belarusian event_m_polina_followup_74405af4:

    # "Оказалось, можно летать без высоких технологий или волшебства."
    "Выявілася, можна лятаць без высокіх тэхналогій ці чараўніцтва."

# game/scripts/scene/scene_day_5.rpy:13256
translate belarusian event_m_polina_followup_8a4bd25c:

    # "Нет, то, что происходило в этой комнате и было волшебством."
    "Не, тое, што адбывалася ў гэтым пакоі, і было чараўніцтвам."

# game/scripts/scene/scene_day_5.rpy:13258
translate belarusian event_m_polina_followup_eb98600a:

    # "Я понял, что только им можно противостоять чёрной магии, отравившей посёлок."
    "Я зразумеў, што толькі ім можна супрацьстаяць чорнай магіі, якая атруціла пасёлак."

# game/scripts/scene/scene_day_5.rpy:13260
translate belarusian event_m_polina_followup_192e313c:

    # "Полина словно чего-то ожидала. И не только она."
    "Паліна нібыта чагосьці чакала. І не толькі яна."

# game/scripts/scene/scene_day_5.rpy:13284
translate belarusian event_m_polina_followup_3de324e8:

    # "В комнате был ещё кто-то, требующий моего внимания."
    "У пакоі быў яшчэ нехта, хто патрабаваў маёй увагі."

# game/scripts/scene/scene_day_5.rpy:13325
translate belarusian event_m_polina_followup_4013e313:

    # "Сместив взгляд за плечо Полины, я остолбенел."
    "Перавёўшы позірк за плячо Паліны, я аслупянеў."

# game/scripts/scene/scene_day_5.rpy:13326
translate belarusian event_m_polina_followup_98dcbcf2:

    # "В углу, спиной к нам, будто наказанный, стоял ребёнок."
    "У куце, спінай да нас, быццам пакаранае, стаяла дзіця."

# game/scripts/scene/scene_day_5.rpy:13327
translate belarusian event_m_polina_followup_c9f5ddbc:

    # "Капюшон прикрывал его голову. Крошечная фигурка почти сливалась с темнотой."
    "Капюшон прыкрываў яго галаву. Малюсенькая фігурка амаль злівалася з цемрай."

# game/scripts/scene/scene_day_5.rpy:13328
translate belarusian event_m_polina_followup_561688da:

    # "Она уже являлась ко мне. В Гараже и на уроке Лилии Павловны."
    "Яна ўжо з'яўлялася мне. У Гаражы і на ўроку Ліліі Паўлаўны."

# game/scripts/scene/scene_day_5.rpy:13329
translate belarusian event_m_polina_followup_a7fce58e:

    # "Оля?"
    "Оля?"

# game/scripts/scene/scene_day_5.rpy:13330
translate belarusian event_m_polina_followup_c7148695:

    # "Но ребёнок, исчезающий мистическим образом, скорее походил на призрак, а моя Оля жива и здорова..."
    "Але дзіця, якое знікае містычным чынам, хутчэй нагадвала прывід, а мая Оля жывая і здаровая..."

# game/scripts/scene/scene_day_5.rpy:13331
translate belarusian event_m_polina_followup_485ffd1c:

    # voice "voice/Polina/5day/136 ti.ogg" 
    # Pol "Ты чего?"
    voice "voice/Polina/5day/136 ti.ogg" 
    Pol "Ты чаго?"

# game/scripts/scene/scene_day_5.rpy:13333
translate belarusian event_m_polina_followup_47d4c133:

    # voice "voice/Anton/5day/181 T.ogg"
    # Ant "Там кто-то есть."
    voice "voice/Anton/5day/181 T.ogg"
    Ant "Там нехта ёсць."

# game/scripts/scene/scene_day_5.rpy:13358
translate belarusian event_m_polina_followup_bd1543a5:

    # "Полина даже не посмотрела во тьму, куда не доставал свет свечей."
    "Паліна нават не паглядзела ў цемру, куды не дасягала святло свечак."

# game/scripts/scene/scene_day_5.rpy:13361
translate belarusian event_m_polina_followup_7e1cf89b:

    # voice "voice/Polina/5day/137 Eto.ogg" 
    # Pol "Это Джоанна выбралась."
    voice "voice/Polina/5day/137 Eto.ogg" 
    Pol "Гэта Джаана выбралася."

# game/scripts/scene/scene_day_5.rpy:13420
translate belarusian event_m_polina_followup_2dc5ae0d:

    # "Я поднёс свечку ближе, чтобы прогнать наваждение..."
    "Я паднёс свечку бліжэй, каб прагнаць насланнё..."

# game/scripts/scene/scene_day_5.rpy:13421
translate belarusian event_m_polina_followup_01ba9288:

    # voice "voice/Polina/5day/138 Vi.ogg" 
    # Pol "Видишь? Я же говорила."
    voice "voice/Polina/5day/138 Vi.ogg" 
    Pol "Бачыш? Я ж казала."

# game/scripts/scene/scene_day_5.rpy:13423
translate belarusian event_m_polina_followup_89714e34:

    # "В пляшущем свете огонька на меня таращилась тайская кошка."
    "У мігатлівым святле агеньчыка на мяне тарашчылася тайская котка."

# game/scripts/scene/scene_day_5.rpy:13448
translate belarusian event_m_polina_followup_bd970f4d:

    # "Но стоило мне отвести свет, как силуэт ребёнка снова зарябил во тьме."
    "Але варта было мне адвесці святло, як сілуэт дзіцяці зноў замільгацеў у цемры."

# game/scripts/scene/scene_day_5.rpy:13449
translate belarusian event_m_polina_followup_3d87d885:

    # "Я с трудом оторвался от маячащей в углу фигурки."
    "Я з цяжкасцю адарваўся ад фігуркі, што маячыла ў куце."

# game/scripts/scene/scene_day_5.rpy:13450
translate belarusian event_m_polina_followup_44308bef:

    # "Было жутко говорить с ней, зная, что незваный гость там."
    "Было жудасна гаварыць з ёй, ведаючы, што няпрошаны госць там."

# game/scripts/scene/scene_day_5.rpy:13451
translate belarusian event_m_polina_followup_610feae7:

    # "Мне пора было признаться."
    "Мне пара было прызнацца."

# game/scripts/scene/scene_day_5.rpy:13476
translate belarusian event_m_polina_followup_af1c0394:

    # voice "voice/Anton/5day/182 P.ogg"
    # Ant "Полина, у меня галлюцинации."
    voice "voice/Anton/5day/182 P.ogg"
    Ant "Паліна, у мяне галюцынацыі."

# game/scripts/scene/scene_day_5.rpy:13480
translate belarusian event_m_polina_followup_beb60e86:

    # voice "voice/Polina/5day/139 S.ogg" 
    # Pol "Сейчас?"
    voice "voice/Polina/5day/139 S.ogg" 
    Pol "Цяпер?"

# game/scripts/scene/scene_day_5.rpy:13484
translate belarusian event_m_polina_followup_65ed6ba1:

    # voice "voice/Anton/5day/183 E.ogg"
    # Ant "И сейчас, и вообще..."
    voice "voice/Anton/5day/183 E.ogg"
    Ant "І цяпер, і ўвогуле..."

# game/scripts/scene/scene_day_5.rpy:13486
translate belarusian event_m_polina_followup_056ce4b9:

    # voice "voice/Anton/5day/184 Ya.ogg"
    # Ant "Я вижу странные штуки."
    voice "voice/Anton/5day/184 Ya.ogg"
    Ant "Я бачу дзіўныя штукі."

# game/scripts/scene/scene_day_5.rpy:13490
translate belarusian event_m_polina_followup_b3122984:

    # voice "voice/Polina/5day/140 Ho.ogg"
    # Pol "Хочешь сказать, ты сумасшедший?"
    voice "voice/Polina/5day/140 Ho.ogg"
    Pol "Хочаш сказаць, ты вар'ят?"

# game/scripts/scene/scene_day_5.rpy:13494
translate belarusian event_m_polina_followup_6324424e:

    # voice "voice/Anton/5day/185 D.ogg"
    # Ant "Доктор говорит, это переходный возраст, и скоро пройдёт. Надо принимать лекарства."
    voice "voice/Anton/5day/185 D.ogg"
    Ant "Доктар кажа, гэта пераходны ўзрост, і хутка міне. Трэба прымаць лекі."

# game/scripts/scene/scene_day_5.rpy:13498
translate belarusian event_m_polina_followup_b2f0566d:

    # voice "voice/Polina/5day/141 oni.ogg"
    # Pol "Они у тебя с собой?"
    voice "voice/Polina/5day/141 oni.ogg"
    Pol "Яны ў цябе з сабой?"

# game/scripts/scene/scene_day_5.rpy:13516
translate belarusian event_m_polina_followup_a7f3e202:

    # "Я кивнул, вынимая из кармана таблетки."
    "Я кіўнуў, вымаючы з кішэні таблеткі."

# game/scripts/scene/scene_day_5.rpy:13519
translate belarusian event_m_polina_followup_1cc2e8ab:

    # voice "voice/Polina/5day/142 Tak.ogg" 
    # Pol "Так чего ты ждёшь?"
    voice "voice/Polina/5day/142 Tak.ogg" 
    Pol "Дык чаго ты чакаеш?"

# game/scripts/scene/scene_day_5.rpy:13523
translate belarusian event_m_polina_followup_809f5e1a:

    # "И правда. Чего я жду?"
    "І праўда. Чаго я чакаю?"

# game/scripts/scene/scene_day_5.rpy:13547
translate belarusian event_m_polina_followup_3dd9223c:

    # "Я снова посмотрел в угол."
    "Я зноў паглядзеў у кут."

# game/scripts/scene/scene_day_5.rpy:13548
translate belarusian event_m_polina_followup_7659a008:

    # "Фигурка не поменяла позы, но теперь во мне поселилась уверенность..."
    "Фігурка не змяніла позы, але цяпер ува мне пасялілася ўпэўненасць..."

# game/scripts/scene/scene_day_5.rpy:13549
translate belarusian event_m_polina_followup_19e7e1e3:

    # "Это Оля."
    "Гэта Оля."

# game/scripts/scene/scene_day_5.rpy:13566
translate belarusian event_m_polina_followup_2716498a:

    # "Шёпот был глуше, чем завывания ветра."
    "Шэпт быў глушэйшы за завыванні ветру."

# game/scripts/scene/scene_day_5.rpy:13567
translate belarusian event_m_polina_followup_f35acfc9:

    # "Точно он прорывался сквозь толщу снега, из-под промёрзлой земли, будто сестра звала меня из могилы."
    "Нібы ён прарываўся скрозь тоўшчу снегу, з-пад прамёрзлай зямлі, быццам сястра клікала мяне з магілы."

# game/scripts/scene/scene_day_5.rpy:13568
translate belarusian event_m_polina_followup_20df7807:

    # voice "voice/olya/5day/09 Ant.ogg"
    # Oly "Антон! Антон, вернись!"
    voice "voice/olya/5day/09 Ant.ogg"
    Oly "Антон! Антон, вярніся!"

# game/scripts/scene/scene_day_5.rpy:13570
translate belarusian event_m_polina_followup_c136fba1:

    # voice "voice/olya/5day/10 Ver.ogg"
    # Oly "Вернись ко мне, пожалуйста!"
    voice "voice/olya/5day/10 Ver.ogg"
    Oly "Вярніся да мяне, калі ласка!"

# game/scripts/scene/scene_day_5.rpy:13572
translate belarusian event_m_polina_followup_1ed4e7a2:

    # voice "voice/Polina/5day/143 T.ogg" 
    # Pol "Ты меня пугаешь."
    voice "voice/Polina/5day/143 T.ogg" 
    Pol "Ты мяне палохаеш."

# game/scripts/scene/scene_day_5.rpy:13575
translate belarusian event_m_polina_followup_c7e48941:

    # "В другом мире Оля плакала и повторяла моё имя."
    "У іншым свеце Оля плакала і паўтарала маё імя."

# game/scripts/scene/scene_day_5.rpy:13609
translate belarusian event_m_polina_followup_afterdev_1ec41d1d:

    # "Мой взгляд снова упал на таблетки."
    "Мой позірк зноў упаў на таблеткі."

# game/scripts/scene/scene_day_5.rpy:13669
translate belarusian event_m_polina_accept_e4ddbfd2:

    # "Я готов был поверить в привидения, но ведь Оля не умирала. Полчаса назад я говорил по телефону с мамой."
    "Я гатовы быў паверыць у прывіды, але ж Оля не памірала. Паўгадзіны таму я гаварыў па тэлефоне з мамай."

# game/scripts/scene/scene_day_5.rpy:13670
translate belarusian event_m_polina_accept_89ceda25:

    # "В этом нет смысла."
    "У гэтым няма сэнсу."

# game/scripts/scene/scene_day_5.rpy:13701
translate belarusian event_m_polina_accept_5e846205:

    # "Я бросил на язык таблетки. Перед моим лицом всплыла рука со стаканом воды."
    "Я кінуў на язык таблеткі. Перад маім тварам усплыла рука са шклянкай вады."

# game/scripts/scene/scene_day_5.rpy:13723
translate belarusian event_m_polina_accept_3072fed9:

    # "Полина глядела на меня заботливо, и моё сердце наполнилось благодарностью."
    "Паліна глядзела на мяне клапатліва, і маё сэрца напоўнілася ўдзячнасцю."

# game/scripts/scene/scene_day_5.rpy:13727
translate belarusian event_m_polina_accept_e44aa4b7:

    # "Я выпил воду."
    "Я выпіў ваду."

# game/scripts/scene/scene_day_5.rpy:13731
translate belarusian event_m_polina_accept_cf5ff89c:

    # voice "voice/Polina/5day/144 Nu.ogg"
    # Pol "Ну как?"
    voice "voice/Polina/5day/144 Nu.ogg"
    Pol "Ну як?"

# game/scripts/scene/scene_day_5.rpy:13770
translate belarusian event_m_polina_accept_7e6e0055:

    # "Мой взгляд метнулся в угол."
    "Мой позірк мятнуўся ў кут."

# game/scripts/scene/scene_day_5.rpy:13771
translate belarusian event_m_polina_accept_20b21db0:

    # "Плач утих."
    "Плач сціх."

# game/scripts/scene/scene_day_5.rpy:13772
translate belarusian event_m_polina_accept_87c7e74d:

    # "Галлюцинации оставили меня."
    "Галюцынацыі пакінулі мяне."

# game/scripts/scene/scene_day_5.rpy:13812
translate belarusian event_m_polina_accept_e6990908:

    # voice "voice/Anton/5day/186 Y.ogg"
    # Ant "Я всё-таки псих."
    voice "voice/Anton/5day/186 Y.ogg"
    Ant "Я ўсё ж такі псіх."

# game/scripts/scene/scene_day_5.rpy:13817
translate belarusian event_m_polina_accept_e467a3f0:

    # "Полина улыбнулась расслабленно."
    "Паліна ўсміхнулася расслаблена."

# game/scripts/scene/scene_day_5.rpy:13820
translate belarusian event_m_polina_accept_09c40bdb:

    # voice "voice/Polina/5day/145 Sl.ogg" 
    # Pol "Сложно отрицать."
    voice "voice/Polina/5day/145 Sl.ogg" 
    Pol "Цяжка адмаўляць."

# game/scripts/scene/scene_day_5.rpy:13824
translate belarusian event_m_polina_accept_7a22cd95:

    # voice "voice/Polina/5day/146 No.ogg" 
    # Pol "Но ты точно самый прикольный из всех психов, которые мне встречались."
    voice "voice/Polina/5day/146 No.ogg" 
    Pol "Але ты дакладна самы прыкольны з усіх псіхаў, якія мне сустракаліся."

# game/scripts/scene/scene_day_5.rpy:13828
translate belarusian event_m_polina_accept_57c7ead2:

    # voice "voice/Polina/5day/147 ps.ogg"
    # Pol "Псих-красавчик."
    voice "voice/Polina/5day/147 ps.ogg"
    Pol "Псіх-прыгажунчык."

# game/scripts/scene/scene_day_5.rpy:13839
translate belarusian event_m_polina_accept_f24ac718:

    # "Внезапно Полина села ко мне на колени и внимательно, очень по-взрослому посмотрела в мои глаза."
    "Раптам Паліна села мне на калені і ўважліва, вельмі па-даросламу паглядзела ў мае вочы."

# game/scripts/scene/scene_day_5.rpy:13843
translate belarusian event_m_polina_accept_a8a52eb8:

    # "Я ощутил, как сердце замирает, сбивается с ритма, будто не знает, что ему делать дальше."
    "Я адчуў, як сэрца замірае, збіваецца з рытму, быццам не ведае, што яму рабіць далей."

# game/scripts/scene/scene_day_5.rpy:13844
translate belarusian event_m_polina_accept_4ba459db:

    # "И начинает вновь колотиться, посылая по венам горячую кровь."
    "І пачынае зноў калаціцца, пасылаючы па венах гарачую кроў."

# game/scripts/scene/scene_day_5.rpy:13866
translate belarusian event_m_polina_accept_b6e1b023:

    # "Я подумал об отце."
    "Я падумаў пра бацьку."

# game/scripts/scene/scene_day_5.rpy:13867
translate belarusian event_m_polina_accept_a98baca0:

    # "Проходил ли он через подобное в юности, до мамы?"
    "Ці праходзіў ён праз падобнае ў юнацтве, да мамы?"

# game/scripts/scene/scene_day_5.rpy:13868
translate belarusian event_m_polina_accept_ad544772:

    # "Была ли в его жизни девочка вроде Полины, вот так смотревшая на него?"
    "Ці была ў яго жыцці дзяўчынка накшталт Паліны, якая вось так глядзела на яго?"

# game/scripts/scene/scene_day_5.rpy:13869
translate belarusian event_m_polina_accept_e5cd3772:

    # "А если да, как он не сгорел от переизбытка эмоций?"
    "А калі так, як ён не згарэў ад лішку эмоцый?"

# game/scripts/scene/scene_day_5.rpy:13881
translate belarusian event_m_polina_accept_714a6986:

    # "Полина коснулась моего плеча, убрала невидимую ворсинку и спросила тихо:"
    "Паліна дакранулася да майго пляча, прыбрала нябачную варсінку і спытала ціха:"

# game/scripts/scene/scene_day_5.rpy:13884
translate belarusian event_m_polina_accept_e5d583fb:

    # voice "voice/Polina/5day/148 Ne.ogg" 
    # Pol "Не сбежишь?"
    voice "voice/Polina/5day/148 Ne.ogg" 
    Pol "Не ўцячэш?"

# game/scripts/scene/scene_day_5.rpy:13887
translate belarusian event_m_polina_accept_ad78aa99:

    # voice "voice/Anton/5day/187 N.ogg"
    # Ant "Никогда."
    voice "voice/Anton/5day/187 N.ogg"
    Ant "Ніколі."

# game/scripts/scene/scene_day_5.rpy:13914
translate belarusian event_m_polina_accept_8e9f45af:

    # "Поцелуй."
    "Пацалунак."

# game/scripts/scene/scene_day_5.rpy:13921
translate belarusian event_m_polina_accept_31b53116:

    # "Свечи погасли."
    "Свечкі пагаслі."

# game/scripts/scene/scene_day_5.rpy:13959
translate belarusian event_m_polina_refuse_638c1245:

    # "Но если это не бред?"
    "Але калі гэта не трызненне?"

# game/scripts/scene/scene_day_5.rpy:13967
translate belarusian event_m_polina_refuse_3e17de76:

    # "Я сжал в кулаке таблетки."
    "Я сціснуў у кулаку таблеткі."

# game/scripts/scene/scene_day_5.rpy:13972
translate belarusian event_m_polina_refuse_a513747f:

    # "Что, если Оле нужна помощь, или она хочет о чём-то меня предупредить?"
    "Што, калі Олі патрэбна дапамога, ці яна хоча пра нешта мяне папярэдзіць?"

# game/scripts/scene/scene_day_5.rpy:13995
translate belarusian event_m_polina_refuse_60746dd4:

    # voice "voice/Polina/5day/149 A.ogg" 
    # Pol "Антон, быстрее."
    voice "voice/Polina/5day/149 A.ogg" 
    Pol "Антон, хутчэй."

# game/scripts/scene/scene_day_5.rpy:13999
translate belarusian event_m_polina_refuse_7f3d000c:

    # "Я нахмурился, увидев страх, мелькнувший в глазах Полины. Даже не страх, а нарастающую панику."
    "Я нахмурыўся, убачыўшы страх, які мільгануў у вачах Паліны. Нават не страх, а паніку, што нарастала."

# game/scripts/scene/scene_day_5.rpy:14001
translate belarusian event_m_polina_refuse_41ecbc33:

    # voice "voice/Anton/5day/188 Ch.ogg"
    # Ant "Что происходит?"
    voice "voice/Anton/5day/188 Ch.ogg"
    Ant "Што адбываецца?"

# game/scripts/scene/scene_day_5.rpy:14017
translate belarusian event_m_polina_refuse_6d9632d8:

    # "Плач стал громче. Он заполнил комнату."
    "Плач стаў гучнейшым. Ён запоўніў пакой."

# game/scripts/scene/scene_day_5.rpy:14043
translate belarusian event_m_polina_refuse_823805aa:

    # "Полина что, поморщилась? Покосилась в угол? Она тоже слышит?"
    "Паліна што, паморшчылася? Пакасілася ў кут? Яна таксама чуе?"

# game/scripts/scene/scene_day_5.rpy:14064
translate belarusian event_m_polina_refuse_cf59fa5d:

    # voice "voice/Anton/5day/189 T.ogg"
    # Ant "Так это не галлюцинации..."
    voice "voice/Anton/5day/189 T.ogg"
    Ant "Дык гэта не галюцынацыі..."

# game/scripts/scene/scene_day_5.rpy:14078
translate belarusian event_m_polina_refuse_b0a1f12b:

    # voice "voice/Polina/5day/13 krik.ogg" 
    # "Полина вскрикнула, когда в дверь ударил чей-то кулак."
    voice "voice/Polina/5day/13 krik.ogg" 
    "Паліна ўскрыкнула, калі ў дзверы ўдарыў чыйсьці кулак."

# game/scripts/scene/scene_day_5.rpy:14124
translate belarusian event_m_polina_refuse_e6c3c442:

    # "Кошка ринулась под потолок, сорвав штору, и растворилась в темноте."
    "Котка кінулася пад столь, сарваўшы штору, і растварылася ў цемры."

# game/scripts/scene/scene_day_5.rpy:14125
translate belarusian event_m_polina_refuse_ae31da7a:

    # "Мы оба сжались."
    "Мы абое скуліліся."

# game/scripts/scene/scene_day_5.rpy:14126
translate belarusian event_m_polina_refuse_9845a920:

    # voice "voice/Polina/5day/150 net.ogg" 
    # Pol "Нет, нет, нет..."
    voice "voice/Polina/5day/150 net.ogg" 
    Pol "Не, не, не..."

# game/scripts/scene/scene_day_5.rpy:14129
translate belarusian event_m_polina_refuse_0e234806:

    # "Она трясла головой и дрожала всем телом."
    "Яна трасла галавой і дрыжала ўсім целам."

# game/scripts/scene/scene_day_5.rpy:14133
translate belarusian event_m_polina_refuse_ef7d68f6:

    # "Плач Оли и тоскливая песня вьюги слились в единый хор. В дверь колотили — руками, ногами."
    "Плач Олі і тужлівая песня завірухі зліліся ў адзіны хор. У дзверы грукалі — рукамі, нагамі."

# game/scripts/scene/scene_day_5.rpy:14134
translate belarusian event_m_polina_refuse_fadfa638:

    # "Язычки пламени затрепетали, и тьма вокруг нас сгустилась."
    "Язычкі полымя затрапяталі, і цемра вакол нас згусцілася."

# game/scripts/scene/scene_day_5.rpy:14157
translate belarusian event_m_polina_refuse_ddd716c5:

    # voice "voice/Hariton/02 Po.ogg"
    # Noname "Полина! Полина, ты дома?"
    voice "voice/Hariton/02 Po.ogg"
    Noname "Паліна! Паліна, ты дома?"

# game/scripts/scene/scene_day_5.rpy:14173
translate belarusian event_m_polina_refuse_9b4dc826:

    # "Это её дедушка... просто дедушку выписали из больницы... но почему ночью?"
    "Гэта яе дзядуля... проста дзядулю выпісалі з бальніцы... але чаму ўначы?"

# game/scripts/scene/scene_day_5.rpy:14174
translate belarusian event_m_polina_refuse_e0453c58:

    # "И почему голос звучит так, словно у говорящего полон рот клыков?"
    "І чаму голас гучыць так, быццам у таго, хто гаворыць, поўны рот іклаў?"

# game/scripts/scene/scene_day_5.rpy:14194
translate belarusian event_m_polina_refuse_2daf902a:

    # voice "voice/Polina/5day/151 Ch.ogg" 
    # Pol "Что ты наделал, Антон? Почему ты не выпил таблетки?"
    voice "voice/Polina/5day/151 Ch.ogg" 
    Pol "Што ты нарабіў, Антон? Чаму ты не выпіў таблеткі?"

# game/scripts/scene/scene_day_5.rpy:14198
translate belarusian event_m_polina_refuse_ad94395a:

    # "Слёзы брызнули из её расширившихся глаз."
    "Слёзы пырснулі з яе пашыраных вачэй."

# game/scripts/scene/scene_day_5.rpy:14222
translate belarusian event_m_polina_refuse_ec243db8:

    # voice "voice/Hariton/03 Vi.ogg"
    # Noname "Выйди, внученька!"
    voice "voice/Hariton/03 Vi.ogg"
    Noname "Выйдзі, унучачка!"

# game/scripts/scene/scene_day_5.rpy:14224
translate belarusian event_m_polina_refuse_70e39d26:

    # voice "voice/Hariton/42.C2.ogg"
    # Noname "Целиком не выйдешь, хоть кусок мне отрежь!"
    voice "voice/Hariton/42.C2.ogg"
    Noname "Цалкам не выйдзеш, хоць кавалак мне адрэж!"

# game/scripts/scene/scene_day_5.rpy:14234
translate belarusian event_m_polina_refuse_a97740e1:

    # voice "voice/Polina/5day/13 Vs.ogg"
    # "Полина истерично взвизгнула."
    voice "voice/Polina/5day/13 Vs.ogg"
    "Паліна істэрычна віскнула."

# game/scripts/scene/scene_day_5.rpy:14244
translate belarusian event_m_polina_refuse_a58a1c32:

    # "Заскрипело крыльцо."
    "Заскрыпеў ганак."

# game/scripts/scene/scene_day_5.rpy:14266
translate belarusian event_m_polina_refuse_aa05296e:

    # "Харитон... он научился ходить? Ходить в метели, ходить во тьме..."
    "Харытон... ён навучыўся хадзіць? Хадзіць у завеі, хадзіць у цемры..."

# game/scripts/scene/scene_day_5.rpy:14272
translate belarusian event_m_polina_refuse_d7fa5639:

    # "За окном мелькнула чудовищная фигура."
    "За акном мільганула пачварная постаць."

# game/scripts/scene/scene_day_5.rpy:14276
translate belarusian event_m_polina_refuse_d2851100:

    # "От жаркого дыхания иней истаял, и в образовавшемся пятнышке мелькнул выпученный глаз."
    "Ад гарачага дыхання шэрань растала, і ў плямцы, што ўтварылася, мільганула вылупленае вока."

# game/scripts/scene/scene_day_5.rpy:14277
translate belarusian event_m_polina_refuse_95577ecf:

    # "Кто-то огромный заглянул в комнату и убедился, что здесь полно свежего мяса."
    "Нехта велізарны зазірнуў у пакой і пераканаўся, што тут поўна свежага мяса."

# game/scripts/scene/scene_day_5.rpy:14284
translate belarusian event_m_polina_refuse_a0fc178d:

    # "Когти сковырнули иней и заскрежетали по стеклу."
    "Кіпцюры скалупнулі шэрань і заскрыгаталі па шкле."

# game/scripts/scene/scene_day_5.rpy:14400
translate belarusian event_m_polina_refuse_d9df5bbf:

    # voice "voice/Polina/5day/13 krik.ogg"
    # "Окно лопнуло, обдав нас холодом. Осколки посыпались на пол. Костяные серпы прошлись по раме."
    voice "voice/Polina/5day/13 krik.ogg"
    "Акно лопнула, абдаўшы нас холадам. Аскепкі пасыпаліся на падлогу. Касцяныя сярпы прайшліся па раме."

# game/scripts/scene/scene_day_5.rpy:14405
translate belarusian event_m_polina_refuse_fe55777d:

    # "Ветер задул и опрокинул большинство свечей, но одна, упав, продолжала гореть."
    "Вецер задуў і перакуліў большасць свечак, але адна, упаўшы, працягвала гарэць."

# game/scripts/scene/scene_day_5.rpy:14408
translate belarusian event_m_polina_refuse_0a1f832d:

    # "Чтобы я видел, как ночные твари пришли в гости к визжащей Полине. У них был вожак."
    "Каб я бачыў, як начныя пачвары прыйшлі ў госці да Паліны, якая вішчала. У іх быў важак."

# game/scripts/scene/scene_day_5.rpy:14409
translate belarusian event_m_polina_refuse_69c180a3:

    # "Заслонившись руками от кошмара, я смотрел сквозь пальцы на гигантское существо, возникшее в квадрате окна."
    "Засланіўшыся рукамі ад кашмару, я глядзеў скрозь пальцы на гіганцкую істоту, што паўстала ў квадраце акна."

# game/scripts/scene/scene_day_5.rpy:14437
translate belarusian event_m_polina_refuse_7b41d586:

    # "Голодные глаза светились в полумраке, как серебряные луны."
    "Галодныя вочы свяціліся ў паўзмроку, як сярэбраныя месяцы."

# game/scripts/scene/scene_day_5.rpy:14441
translate belarusian event_m_polina_refuse_80ab17aa:

    # "Тварь протянула руку и указала на нас пальцем, напоминающим кинжал."
    "Пачвара працягнула руку і паказала на нас пальцам, які нагадваў кінжал."

# game/scripts/scene/scene_day_5.rpy:14454
translate belarusian event_m_polina_refuse_b5785174:

    # "Стая обезумевших волков хлынула в комнату, как поток, снося всё на своём пути."
    "Зграя ашалелых ваўкоў хлынула ў пакой, як паток, зносячы ўсё на сваім шляху."

# game/scripts/scene/scene_day_5.rpy:14471
translate belarusian event_m_polina_refuse_fa216c52:

    # "Великан влез вслед за ними."
    "Волат улез следам за імі."

# game/scripts/scene/scene_day_5.rpy:14479
translate belarusian event_m_polina_refuse_a92b98a7:

    # "Он выпрямился во весь свой ужасающий рост, до потолка."
    "Ён выпрастаўся на ўвесь свой жахлівы рост, да столі."

# game/scripts/scene/scene_day_5.rpy:14480
translate belarusian event_m_polina_refuse_0e9bd6c8:

    # "Длинные уши подёргивались над громоздкой головой."
    "Доўгія вушы паторгваліся над грувасткай галавой."

# game/scripts/scene/scene_day_5.rpy:14481
translate belarusian event_m_polina_refuse_c49ab2fc:

    # "Тени чудовищ бесновались на стенах."
    "Цені пачвар беснаваліся на сценах."

# game/scripts/scene/scene_day_5.rpy:14501
translate belarusian event_m_polina_refuse_e7b9ebc1:

    # "Свеча подожгла скатерть, и та, потрескивая, прогорала."
    "Свечка падпаліла абрус, і той, патрэскваючы, прагараў."

# game/scripts/scene/scene_day_5.rpy:14502
translate belarusian event_m_polina_refuse_2099557c:

    # "Дым обжигал слизистую. В красном аду скалились прожорливые бесы."
    "Дым апякаў слізістую. У чырвоным пекле шчэрыліся пражэрлівыя бесы."

# game/scripts/scene/scene_day_5.rpy:14534
translate belarusian event_m_polina_refuse_af68d1d4:

    # "Парализованный страхом, я смотрел, как Полина сорвалась с дивана, пытаясь убежать."
    "Паралізаваны страхам, я глядзеў, як Паліна сарвалася з канапы, спрабуючы ўцячы."

# game/scripts/scene/scene_day_5.rpy:14536
translate belarusian event_m_polina_refuse_30966af4:

    # "Но посреди комнаты она затряслась и упала на колени перед древним монстром."
    "Але пасярод пакоя яна затраслася і ўпала на калені перад старажытным монстрам."

# game/scripts/scene/scene_day_5.rpy:14567
translate belarusian event_m_polina_refuse_5a48efd3:

    # "Пришедшим из лесов и промозглых захоронений."
    "Што прыйшоў з лясоў і золкіх пахаванняў."

# game/scripts/scene/scene_day_5.rpy:14610
translate belarusian event_m_polina_refuse_bfebd071:

    # "Заяц протянул левую лапу и вцепился Полине в волосы."
    "Заяц працягнуў левую лапу і ўчапіўся Паліне ў валасы."

# game/scripts/scene/scene_day_5.rpy:14624
translate belarusian event_m_polina_refuse_98e873cd:

    # "Пальцы правой он развернул, как веер, наслаждаясь беспомощностью жертвы."
    "Пальцы правай ён разгарнуў, як веер, цешачыся бездапаможнасцю ахвяры."

# game/scripts/scene/scene_day_5.rpy:14628
translate belarusian event_m_polina_refuse_61cd7538:

    # "Коготь медленно очерчивал девичье лицо."
    "Кіпцюр павольна акрэсліваў дзявочы твар."

# game/scripts/scene/scene_day_5.rpy:14667
translate belarusian event_m_polina_refuse_fdc682a8:

    # "Вдоль скулы, через подбородок и снова вверх."
    "Уздоўж выліцы, праз падбародак і зноў уверх."

# game/scripts/scene/scene_day_5.rpy:14673
translate belarusian event_m_polina_refuse_2704620a:

    # "Полина закричала."
    "Паліна закрычала."

# game/scripts/scene/scene_day_5.rpy:14674
translate belarusian event_m_polina_refuse_45218330:

    # "Кожа раскрывалась под нажимом когтя. Слёзы лились по обескровленным щекам."
    "Скура раскрывалася пад націскам кіпцюра. Слёзы ліліся па абяскроўленых шчоках."

# game/scripts/scene/scene_day_5.rpy:14675
translate belarusian event_m_polina_refuse_a706a7f1:

    # "Горящие лохмотья скатерти спланировали на стул и подожгли обивку."
    "Шматкі абруса, што гарэлі, спланеравалі на крэсла і падпалілі абіўку."

# game/scripts/scene/scene_day_5.rpy:14702
translate belarusian event_m_polina_refuse_dd89c83d:

    # "А потом одним движением монстр срезал лицо Полины и отшвырнул его, как ненужную тряпку."
    "А потым адным рухам монстр зрэзаў твар Паліны і адшпурнуў яго, як непатрэбную анучу."

# game/scripts/scene/scene_day_5.rpy:14713
translate belarusian event_m_polina_refuse_539b61d6:

    # "На месте лица было красное, влажно блестящее месиво с канатами сухожилий и шариками жира."
    "На месцы твару было чырвонае, вільготна бліскучае месіва з канатамі сухажылляў і шарыкамі тлушчу."

# game/scripts/scene/scene_day_5.rpy:14714
translate belarusian event_m_polina_refuse_71f6805c:

    # "Освежёванная Полина бешено визжала."
    "Асвяжаваная Паліна шалёна вішчала."

# game/scripts/scene/scene_day_5.rpy:14715
translate belarusian event_m_polina_refuse_efea7482:

    # "Отсветы пламени отражались в кровавой трясине на её лицевых костях."
    "Водсветы полымя адбіваліся ў крывавай дрыгве на яе тваравых касцях."

# game/scripts/scene/scene_day_5.rpy:14717
translate belarusian event_m_polina_refuse_300b256d:

    # "Вопль перешёл в пронзительный визг, затем в какое-то карканье."
    "Лямант перайшоў у пранізлівы віск, потым у нейкае карканне."

# game/scripts/scene/scene_day_5.rpy:14718
translate belarusian event_m_polina_refuse_60e70491:

    # "Она что?.. Она смеялась?"
    "Яна што?.. Яна смяялася?"

# game/scripts/scene/scene_day_5.rpy:14764
translate belarusian event_m_polina_refuse_74979806:

    # "Полина повернула ко мне то, что осталось от лица."
    "Паліна павярнула да мяне тое, што засталося ад твару."

# game/scripts/scene/scene_day_5.rpy:14791
translate belarusian event_m_polina_refuse_282cd1fe:

    # "Дикий хохот извергался из дыры в лоснящемся мясе."
    "Дзікі рогат вывяргаўся з дзіры ў ласністым мясе."

# game/scripts/scene/scene_day_5.rpy:14792
translate belarusian event_m_polina_refuse_204260cc:

    # "Глаза, лишённые век, идеально круглые, вращались в глазницах."
    "Вочы, пазбаўленыя павек, ідэальна круглыя, вярцеліся ў вачніцах."

# game/scripts/scene/scene_day_5.rpy:14864
translate belarusian event_m_polina_refuse_6a7a5e5c:

    # "Мне хотелось умереть и больше не видеть этого. Я был парализован страхом."
    "Мне хацелася памерці і больш не бачыць гэтага. Я быў паралізаваны страхам."

# game/scripts/scene/scene_day_5.rpy:14949
translate belarusian event_m_polina_refuse_e8747031:

    # voice "voice/Polina/5day/156 ti.ogg" 
    # Pol "Ты ничего не смог сделать, трус!"
    voice "voice/Polina/5day/156 ti.ogg" 
    Pol "Ты нічога не змог зрабіць, баязлівец!"

# game/scripts/scene/scene_day_5.rpy:14953
translate belarusian event_m_polina_refuse_376bbebd:

    # voice "voice/Polina/5day/157 ni.ogg" 
    # Pol "Ничтожество, ты не смог меня защитить!"
    voice "voice/Polina/5day/157 ni.ogg" 
    Pol "Нікчэмнік, ты не змог мяне абараніць!"

# game/scripts/scene/scene_day_5.rpy:14969
translate belarusian event_m_polina_refuse_f49c5cfa:

    # "Я зажал пальцами уши, но продолжал слышать."
    "Я заціснуў пальцамі вушы, але працягваў чуць."

# game/scripts/scene/scene_day_5.rpy:14992
translate belarusian event_m_polina_refuse_d4c740ee:

    # voice "voice/Polina/5day/158 ro.ogg" 
    # Pol "Ромка был в тысячу раз лучше."
    voice "voice/Polina/5day/158 ro.ogg" 
    Pol "Ромка быў у тысячу разоў лепшы."

# game/scripts/scene/scene_day_5.rpy:15016
translate belarusian event_m_polina_refuse_4d6f84c1:

    # voice "voice/Polina/5day/159 zn.ogg" 
    # Pol "Знай, неудачник..."
    voice "voice/Polina/5day/159 zn.ogg" 
    Pol "Ведай, няўдачнік..."

# game/scripts/scene/scene_day_5.rpy:15040
translate belarusian event_m_polina_refuse_11abd073:

    # voice "voice/Polina/5day/160 ni.ogg"
    # Pol "Ни в одном мире ты меня не спасёшь, Антон!"
    voice "voice/Polina/5day/160 ni.ogg"
    Pol "Ні ў адным свеце ты мяне не выратуеш, Антон!"

# game/scripts/scene/scene_day_5.rpy:15092
translate belarusian event_m_polina_refuse_f2eda78b:

    # voice "voice/Polina/5day/161ni.ogg" 
    # Pol "Ни в одной вселенной я не буду твоей!"
    voice "voice/Polina/5day/161ni.ogg" 
    Pol "Ні ў адным сусвеце я не буду тваёй!"

# game/scripts/scene/scene_day_5.rpy:15164
translate belarusian event_m_polina_refuse_e61ef0f4:

    # voice "voice/Polina/5day/162 ti.ogg" 
    # Pol "Ты обречён!"
    voice "voice/Polina/5day/162 ti.ogg" 
    Pol "Ты вырачаны!"

# game/scripts/scene/scene_day_5.rpy:15217
translate belarusian event_m_polina_refuse_576113a2:

    # "Позади меня бушевал пожар. В дыму Полина снова завизжала."
    "Пазаду мяне шалеў пажар. У дыме Паліна зноў завішчала."

# game/scripts/scene/scene_day_5.rpy:15273
translate belarusian event_m_polina_refuse_7f327d70:

    # "Она будто бы догадалась, что сейчас произойдёт."
    "Яна нібыта здагадалася, што зараз адбудзецца."

# game/scripts/scene/scene_day_5.rpy:15294
translate belarusian event_m_polina_refuse_fdaf63a4:

    # "Коготь вспорол её живот с отвратительным звуком рвущейся ткани."
    "Кіпцюр распароў яе жывот з агідным гукам тканіны, што рвецца."

# game/scripts/scene/scene_day_5.rpy:15304
translate belarusian event_m_polina_refuse_7356e36d:

    # "Лапа проникла в образовавшуюся щель и вынула внутренности."
    "Лапа пранікла ў шчыліну, што ўтварылася, і выняла вантробы."

# game/scripts/scene/scene_day_5.rpy:15310
translate belarusian event_m_polina_refuse_aab86555:

    # "Пурпурный кишечник школьницы."
    "Пурпуровы кішэчнік школьніцы."

# game/scripts/scene/scene_day_5.rpy:15324
translate belarusian event_m_polina_refuse_bec05b1a:

    # "Облизываясь, тварь накинула вонючую гирлянду на шею Полины. Как верёвку. И резко подбросила лапу."
    "Аблізваючыся, пачвара накінула смярдзючую гірлянду на шыю Паліны. Як вяроўку. І рэзка падкінула лапу."

# game/scripts/scene/scene_day_5.rpy:15414
translate belarusian event_m_polina_refuse_f0ce1530:

    # "Полина поднялась вверх, подвешенная к люстре на собственных кишках, и закачалась, как колокол."
    "Паліна паднялася ўверх, падвешаная да люстры на ўласных кішках, і загайдалася, як звон."

# game/scripts/scene/scene_day_5.rpy:15416
translate belarusian event_m_polina_refuse_2872334b:

    # "Ноги дёргались в конвульсиях, безнадёжно ища под собой опоры. Слабеющие пальцы царапали мерзкую удавку."
    "Ногі тузаліся ў канвульсіях, безнадзейна шукаючы пад сабой апоры. Пальцы, што слабелі, драпалі мярзотную зашмаргу."

# game/scripts/scene/scene_day_5.rpy:15427
translate belarusian event_m_polina_refuse_433e946b:

    # "Монстр повернул ко мне истекающую вязкой слюной пасть."
    "Монстр павярнуў да мяне пашчу, з якой сцякала вязкая сліна."

# game/scripts/scene/scene_day_5.rpy:15432
translate belarusian event_m_polina_refuse_8f00ee4e:

    # "Руки Полины обвисли, мёртвое тело продолжало раскачиваться на ветру."
    "Рукі Паліны абвіслі, мёртвае цела працягвала разгойдвацца на ветры."

# game/scripts/scene/scene_day_5.rpy:15440
translate belarusian event_m_polina_refuse_ff603f56:

    # "Волки напружинились, ожидая приказа."
    "Ваўкі напружыліся, чакаючы загаду."

# game/scripts/scene/scene_day_5.rpy:15441
translate belarusian event_m_polina_refuse_e042c9ec:

    # "Мышцы двигались под вздыбленной грязной шерстью."
    "Мышцы рухаліся пад уздыбленай бруднай поўсцю."

# game/scripts/scene/scene_day_5.rpy:15442
translate belarusian event_m_polina_refuse_c4f707ec:

    # "Покрытые коростой хвосты трепетали в предвкушении пира."
    "Пакрытыя каростай хвасты трапяталі ў прадчуванні балю."

# game/scripts/scene/scene_day_5.rpy:15450
translate belarusian event_m_polina_refuse_38273307:

    # "Чудовище медленно подняло лапу и ткнуло в меня когтем."
    "Пачвара павольна падняла лапу і тыцнула ў мяне кіпцюром."

# game/scripts/scene/scene_day_5.rpy:15453
translate belarusian event_m_polina_refuse_0fa3eb2c:

    # voice "voice/bunny/13 Ez.ogg"
    # Bunny "Из-за таких, как ты, мы изгои!"
    voice "voice/bunny/13 Ez.ogg"
    Bunny "Праз такіх, як ты, мы ізгоі!"

# game/scripts/scene/scene_day_5.rpy:15458
translate belarusian event_m_polina_refuse_11f6ad30:

    # voice "voice/bunny/14 Vs.ogg"
    # Bunny "Вся стая уже укусила луну..."
    voice "voice/bunny/14 Vs.ogg"
    Bunny "Уся зграя ўжо ўкусіла месяц..."

# game/scripts/scene/scene_day_5.rpy:15463
translate belarusian event_m_polina_refuse_7f3458cb:

    # voice "voice/bunny/15 As.ogg"
    # Bunny "А с тобой приходится цацкаться!"
    voice "voice/bunny/15 As.ogg"
    Bunny "А з табой даводзіцца цацкацца!"

# game/scripts/scene/scene_day_5.rpy:15474
translate belarusian event_m_polina_refuse_1837a01b:

    # voice "voice/bunny/16Tv .ogg"
    # Bunny "Твоё мясо растворится в желудочных соках."
    voice "voice/bunny/16Tv .ogg"
    Bunny "Тваё мяса растворыцца ў страўнікавых соках."

# game/scripts/scene/scene_day_5.rpy:15479
translate belarusian event_m_polina_refuse_dc3e1303:

    # voice "voice/bunny/17Tv.ogg"
    # Bunny "Твоя душа достанется лесу."
    voice "voice/bunny/17Tv.ogg"
    Bunny "Твая душа дастанецца лесу."

# game/scripts/scene/scene_day_5.rpy:15485
translate belarusian event_m_polina_refuse_f23bc9d5:

    # voice "voice/bunny/18 Tv.ogg"
    # Bunny "Твоё имя забудут."
    voice "voice/bunny/18 Tv.ogg"
    Bunny "Тваё імя забудуць."

# game/scripts/scene/scene_day_5.rpy:15496
translate belarusian event_m_polina_refuse_51430495:

    # "Волки завыли."
    "Ваўкі завылі."

# game/scripts/scene/scene_day_5.rpy:15573
translate belarusian event_m_polina_refuse_73b38b0b:

    # "Ближайший зверь прыгнул, смыкая челюсти на моём горле. Зубы погрузились в гортань."
    "Найбліжэйшы звер скокнуў, змыкаючы сківіцы на маім горле. Зубы пагрузіліся ў гартань."

# game/scripts/scene/scene_day_5.rpy:15574
translate belarusian event_m_polina_refuse_9c7745b6:

    # "Тень Полины моталась по стене."
    "Цень Паліны матляўся па сцяне."

# game/scripts/scene/scene_day_5.rpy:15578
translate belarusian event_m_polina_refuse_5b641b60:

    # "Я вцепился пальцами в липкую волчью шкуру, пытаясь из последних сил оттолкнуть хищника."
    "Я ўчапіўся пальцамі ў ліпкую ваўчыную шкуру, спрабуючы з апошніх сіл адштурхнуць драпежніка."

# game/scripts/scene/scene_day_5.rpy:15597
translate belarusian event_m_polina_refuse_4312a689:

    # "Он жевал и раздирал клыками мою гортань."
    "Ён жаваў і раздзіраў ікламі маю гартань."

# game/scripts/scene/scene_day_5.rpy:15676
translate belarusian event_m_polina_refuse_bc729829:

    # voice "voice/bunny/19 Nu.ogg"
    # Bunny "Ну как? Страшно умирать?"
    voice "voice/bunny/19 Nu.ogg"
    Bunny "Ну як? Страшна паміраць?"

# game/scripts/scene/scene_day_5.rpy:15708
translate belarusian event_m_polina_refuse_2e6f3731:

    # Oly "А-а-а-а-а-а!"
    Oly "А-а-а-а-а-а!"

# game/scripts/scene/scene_day_5.rpy:15770
translate belarusian event_m_polina_refuse_c119b180:

    # voice "voice/anton/5day/sluni.ogg"
    # "Я забулькал слюнями, думая, что давлюсь кровью, и открыл глаза."
    voice "voice/anton/5day/sluni.ogg"
    "Я забулькаў слінай, думаючы, што захлынаюся крывёй, і расплюшчыў вочы."

# game/scripts/scene/scene_day_5.rpy:15804
translate belarusian event_m_polina_refuse_4e72f538:

    # "Крик Оли оборвался, но эхо ещё звучало в моей голове."
    "Крык Олі абарваўся, але рэха яшчэ гучала ў маёй галаве."

# game/scripts/scene/scene_day_5.rpy:15805
translate belarusian event_m_polina_refuse_8b7ec864:

    # "Боль прошла."
    "Боль прайшоў."

# game/scripts/scene/scene_day_5.rpy:15806
translate belarusian event_m_polina_refuse_41e3163d:

    # "Волки, чудовище, мёртвая Полина — всё это исчезло."
    "Ваўкі, пачвара, мёртвая Паліна — усё гэта знікла."

# game/scripts/scene/scene_day_5.rpy:15807
translate belarusian event_m_polina_refuse_fe6567f3:

    # "Из дома Харитона, из пылающей спальни я перенёсся в собственную прихожую. Так это всё был сон?"
    "З дома Харытона, са спальні, што палала, я перанёсся ва ўласную пярэднюю. Дык гэта ўсё быў сон?"

# game/scripts/scene/scene_day_5.rpy:15808
translate belarusian event_m_polina_refuse_29fb91a9:

    # "Я ощупал целёхонькую шею."
    "Я абмацаў цалюсенькую шыю."

# game/scripts/scene/scene_day_5.rpy:15809
translate belarusian event_m_polina_refuse_95a875db:

    # "Не только ночь у Полины, но и весь последний месяц, и раненая Катя, и побег из Гаража..."
    "Не толькі ноч у Паліны, але і ўвесь апошні месяц, і параненая Каця, і ўцёкі з Гаража..."

# game/scripts/scene/scene_day_5.rpy:15869
translate belarusian event_m_katya_devend_c6fc05a3:

    # "Я посмотрел на Полину."
    "Я паглядзеў на Паліну."

# game/scripts/scene/scene_day_5.rpy:15872
translate belarusian event_m_katya_devend_596994e6:

    # "Она невинно улыбалась, но меня не подкупила эта улыбка."
    "Яна нявінна ўсміхалася, але мяне не падкупіла гэтая ўсмешка."

# game/scripts/scene/scene_day_5.rpy:15873
translate belarusian event_m_katya_devend_915f9f40:

    # "И хотя снежная мгла заволакивала двор, теперь я видел гораздо лучше."
    "І хоць снежная імгла засцілала двор, цяпер я бачыў значна лепш."

# game/scripts/scene/scene_day_5.rpy:15874
translate belarusian event_m_katya_devend_3b9f0535:

    # "Я по-прежнему не доверял Полине."
    "Я па-ранейшаму не давяраў Паліне."

# game/scripts/scene/scene_day_5.rpy:15879
translate belarusian event_m_katya_devend_786f9a45:

    # voice "voice/Anton/5day/192 P.ogg"
    # Ant "Прости, Полин, Кате моя помощь нужнее."
    voice "voice/Anton/5day/192 P.ogg"
    Ant "Прабач, Палін, Каці мая дапамога патрэбней."

# game/scripts/scene/scene_day_5.rpy:15893
translate belarusian event_m_katya_devend_d67c4943:

    # "Ей будто пощёчину отвесили."
    "Ёй нібы поўху далі."

# game/scripts/scene/scene_day_5.rpy:15894
translate belarusian event_m_katya_devend_ebc07830:

    # "Глаза Полины сузились, а улыбка завяла, и губы задрожали."
    "Вочы Паліны звузіліся, а ўсмешка звяла, і вусны задрыжалі."

# game/scripts/scene/scene_day_5.rpy:15897
translate belarusian event_m_katya_devend_4b944c3c:

    # voice "voice/kate/5day/62 Es.ogg"
    # Kate "Если ты, конечно, не против. Ты же не против, Полин, м?"
    voice "voice/kate/5day/62 Es.ogg"
    Kate "Калі ты, вядома, не супраць. Ты ж не супраць, Палін, м?"

# game/scripts/scene/scene_day_5.rpy:15921
translate belarusian event_m_katya_devend_4e190ed8:

    # "Немую сцену прервало появление Ромки."
    "Нямую сцэну перапыніла з'яўленне Ромкі."

# game/scripts/scene/scene_day_5.rpy:15935
translate belarusian event_m_katya_devend_4d66e3df:

    # "Он вышел из-за угла, низко опустив голову."
    "Ён выйшаў з-за рога, нізка апусціўшы галаву."

# game/scripts/scene/scene_day_5.rpy:15936
translate belarusian event_m_katya_devend_bd9f4fde:

    # "Казалось, потеря друга давит на его плечи физически ощутимым грузом."
    "Здавалася, страта сябра цісне на яго плечы фізічна адчувальным цяжарам."

# game/scripts/scene/scene_day_5.rpy:15940
translate belarusian event_m_katya_devend_3536de2b:

    # "Катя взяла меня под локоть, но я не обратил на это внимания."
    "Каця ўзяла мяне пад локаць, але я не звярнуў на гэта ўвагі."

# game/scripts/scene/scene_day_5.rpy:15946
translate belarusian event_m_katya_devend_0fdf0024:

    # voice "voice/Polina/5day/165 R.ogg" 
    # Pol "Ром!"
    voice "voice/Polina/5day/165 R.ogg" 
    Pol "Ром!"

# game/scripts/scene/scene_day_5.rpy:15981
translate belarusian event_m_katya_devend_6a3a5cdd:

    # "Полина бросилась к Ромке и обняла его."
    "Паліна кінулася да Ромкі і абняла яго."

# game/scripts/scene/scene_day_5.rpy:15983
translate belarusian event_m_katya_devend_46d51701:

    # voice "voice/Polina/5day/166 ro.ogg" 
    # Pol "Ромочка, мне было так плохо без тебя."
    voice "voice/Polina/5day/166 ro.ogg" 
    Pol "Ромачка, мне было так дрэнна без цябе."

# game/scripts/scene/scene_day_5.rpy:15987
translate belarusian event_m_katya_devend_4ebc8af6:

    # voice "voice/Polina/5day/167 nu.ogg" 
    # Pol "Ну где ты пропадал?"
    voice "voice/Polina/5day/167 nu.ogg" 
    Pol "Ну дзе ты прападаў?"

# game/scripts/scene/scene_day_5.rpy:15995
translate belarusian event_m_katya_devend_3c699788:

    # "Помедлив, Ромка положил руки на спину хныкающей Полине."
    "Памарудзіўшы, Ромка паклаў рукі на спіну Паліне, якая хныкала."

# game/scripts/scene/scene_day_5.rpy:16035
translate belarusian event_m_katya_devend_58f5d7fb:

    # voice "voice/kate/5day/63 b.ogg"
    # Kate "Быстро она переобулась. Не обидно, Антон?"
    voice "voice/kate/5day/63 b.ogg"
    Kate "Хутка яна пераабулася. Не крыўдна, Антон?"

# game/scripts/scene/scene_day_5.rpy:16039
translate belarusian event_m_katya_devend_b1549d79:

    # "Я мотнул головой отрицательно."
    "Я адмоўна матнуў галавой."

# game/scripts/scene/scene_day_5.rpy:16073
translate belarusian event_m_katya_devend_68f91cbb:

    # "Ромка поднял голову. Привычная нагловатая усмешка победителя появилась на его лице, но сразу пропала."
    "Ромка падняў галаву. Звыклая нахабнаватая ўсмешка пераможцы з'явілася на яго твары, але адразу знікла."

# game/scripts/scene/scene_day_5.rpy:16076
translate belarusian event_m_katya_devend_bf673c64:

    # voice "voice/romka/5day/41 Nu.ogg"
    # Rom "Ну не реви, не люблю этого."
    voice "voice/romka/5day/41 Nu.ogg"
    Rom "Ну не раві, не люблю гэтага."

# game/scripts/scene/scene_day_5.rpy:16080
translate belarusian event_m_katya_devend_cdeca368:

    # voice "voice/romka/5day/42 Na.ogg"
    # Rom "На уроках была?"
    voice "voice/romka/5day/42 Na.ogg"
    Rom "На ўроках была?"

# game/scripts/scene/scene_day_5.rpy:16084
translate belarusian event_m_katya_devend_1f849953:

    # voice "voice/Polina/5day/168 bi.ogg" 
    # Pol "Была..."
    voice "voice/Polina/5day/168 bi.ogg" 
    Pol "Была..."

# game/scripts/scene/scene_day_5.rpy:16088
translate belarusian event_m_katya_devend_10c91e3c:

    # voice "voice/romka/5day/43 B.ogg"
    # Rom "Бяша объявлялся?"
    voice "voice/romka/5day/43 B.ogg"
    Rom "Бяша аб'яўляўся?"

# game/scripts/scene/scene_day_5.rpy:16092
translate belarusian event_m_katya_devend_b5e4dda1:

    # voice "voice/Polina/5day/168 ne.ogg" 
    # Pol "Нет."
    voice "voice/Polina/5day/168 ne.ogg" 
    Pol "Не."

# game/scripts/scene/scene_day_5.rpy:16119
translate belarusian event_m_katya_devend_d452472c:

    # "Рома сплюнул в снег. Только сейчас он посмотрел на нас с Катей."
    "Рома сплюнуў у снег. Толькі цяпер ён паглядзеў на нас з Кацяй."

# game/scripts/scene/scene_day_5.rpy:16121
translate belarusian event_m_katya_devend_b656f847:

    # voice "voice/romka/5day/45 A.ogg"
    # Rom "А вы Бяшу видели?"
    voice "voice/romka/5day/45 A.ogg"
    Rom "А вы Бяшу бачылі?"

# game/scripts/scene/scene_day_5.rpy:16124
translate belarusian event_m_katya_devend_ba2f83fb:

    # "Я качнул головой, про себя удивившись."
    "Я хітнуў галавой, у думках здзівіўшыся."

# game/scripts/scene/scene_day_5.rpy:16157
translate belarusian event_m_katya_devend_3b02b3bb:

    # "Мы же оба прекрасно видели кроссовок. И Ромка подтвердил, что он его друга."
    "Мы ж абодва выдатна бачылі красоўку. І Ромка пацвердзіў, што яна належыць яго сябру."

# game/scripts/scene/scene_day_5.rpy:16158
translate belarusian event_m_katya_devend_10ef62ad:

    # "Вряд ли Бяша сам подарил обувь маньяку и бродит по посёлку босиком."
    "Наўрад ці Бяша сам падарыў абутак маньяку і бадзяецца па пасёлку басанож."

# game/scripts/scene/scene_day_5.rpy:16204
translate belarusian event_m_katya_devend_a704b0c7:

    # voice "voice/Anton/5day/193 R.ogg"
    # Ant "Ром, Бяша был в Гараже."
    voice "voice/Anton/5day/193 R.ogg"
    Ant "Ром, Бяша быў у Гаражы."

# game/scripts/scene/scene_day_5.rpy:16247
translate belarusian event_m_katya_devend_19455efe:

    # voice "voice/romka/5day/46 B.ogg"
    # Rom "Был, и что? Мы тоже были — живы-здоровы."
    voice "voice/romka/5day/46 B.ogg"
    Rom "Быў, і што? Мы таксама былі — жывыя-здаровыя."

# game/scripts/scene/scene_day_5.rpy:16251
translate belarusian event_m_katya_devend_9230fad2:

    # "Он не казался мне здоровым."
    "Ён не здаваўся мне здаровым."

# game/scripts/scene/scene_day_5.rpy:16254
translate belarusian event_m_katya_devend_e24f277f:

    # voice "voice/romka/5day/47 Ya.ogg"
    # Rom "Я не успокоюсь, пока не выясню, что с Бяшей."
    voice "voice/romka/5day/47 Ya.ogg"
    Rom "Я не супакоюся, пакуль не высветлю, што з Бяшам."

# game/scripts/scene/scene_day_5.rpy:16266
translate belarusian event_m_katya_devend_ad483a0a:

    # "Вынув из куртки пачку распечаток, он отделил десяток бумажек и ткнул их мне."
    "Выняўшы з курткі стос раздруковак, ён аддзяліў дзясятак паперак і тыцнуў іх мне."

# game/scripts/scene/scene_day_5.rpy:16269
translate belarusian event_m_katya_devend_3726f5da:

    # voice "voice/romka/5day/48 Ra.ogg"
    # Rom "Развесь вдоль дороги."
    voice "voice/romka/5day/48 Ra.ogg"
    Rom "Развесь уздоўж дарогі."

# game/scripts/scene/scene_day_5.rpy:16273
translate belarusian event_m_katya_devend_8908565d:

    # "Я даже не успел их толком разглядеть, как Катя потянула меня в сторону."
    "Я нават не паспеў іх толкам разгледзець, як Каця пацягнула мяне ўбок."

# game/scripts/scene/scene_day_5.rpy:16314
translate belarusian event_m_katya_devend_d22d448e:

    # voice "voice/kate/5day/64 K.ogg"
    # Kate "Конечно-конечно! Любой каприз — за ваши деньги."
    voice "voice/kate/5day/64 K.ogg"
    Kate "Вядома-вядома! Любы капрыз — за вашы грошы."

# game/scripts/scene/scene_day_5.rpy:16318
translate belarusian event_m_katya_devend_d35347c2:

    # voice "voice/kate/5day/65 A.ogg"
    # Kate "А если финансы поют романсы — ищи дурачков дальше."
    voice "voice/kate/5day/65 A.ogg"
    Kate "А калі фінансы спяваюць рамансы — шукай дурнікаў далей."

# game/scripts/scene/scene_day_5.rpy:16322
translate belarusian event_m_katya_devend_58bc9ee2:

    # voice "voice/kate/5day/66 Ch.ogg"
    # Kate "Чао какао!"
    voice "voice/kate/5day/66 Ch.ogg"
    Kate "Чаа какаа!"

# game/scripts/scene/scene_day_5.rpy:16369
translate belarusian event_m_katya_devend_57eff479:

    # "Рома пропустил Катины комментарии мимо ушей. Он потрепал Полину по плечу."
    "Рома прапусціў Каціны каментарыі міма вушэй. Ён паляпаў Паліну па плячы."

# game/scripts/scene/scene_day_5.rpy:16372
translate belarusian event_m_katya_devend_7ca5f718:

    # voice "voice/romka/5day/49 Ed.ogg"
    # Rom "Идём, малая."
    voice "voice/romka/5day/49 Ed.ogg"
    Rom "Хадзем, малая."

# game/scripts/scene/scene_day_5.rpy:16376
translate belarusian event_m_katya_devend_d9ba62e6:

    # voice "voice/romka/5day/49 od.ogg"
    # Rom "Одной щас быть нельзя."
    voice "voice/romka/5day/49 od.ogg"
    Rom "Адной зараз быць нельга."

# game/scripts/scene/scene_day_5.rpy:16381
translate belarusian event_m_katya_devend_3a3f6b24:

    # voice "voice/Polina/5day/169 ed.ogg" 
    # Pol "Идём, Ромочка. Я столько всего тебе хочу рассказать."
    voice "voice/Polina/5day/169 ed.ogg" 
    Pol "Хадзем, Ромачка. Я столькі ўсяго табе хачу расказаць."

# game/scripts/scene/scene_day_5.rpy:16449
translate belarusian event_m_katya_devend_310a8da4:

    # "Напоследок Ромка перехватил мой взгляд и кивнул, словно у нас с ним была одна тайна на двоих."
    "Напрыканцы Ромка перахапіў мой позірк і кіўнуў, быццам у нас з ім была адна таямніца на дваіх."

# game/scripts/scene/scene_day_5.rpy:16496
translate belarusian event_m_katya_devend_a5366a6a:

    # voice "voice/kate/5day/67 E.ogg"
    # Kate "И жили они долго и счастливо..."
    voice "voice/kate/5day/67 E.ogg"
    Kate "І жылі яны доўга і шчасліва..."

# game/scripts/scene/scene_day_5.rpy:16500
translate belarusian event_m_katya_devend_3d518b5d:

    # voice "voice/lydia/5day/18 Kat.ogg"
    # Lilia_P "Катюш!"
    voice "voice/lydia/5day/18 Kat.ogg"
    Lilia_P "Кацюш!"

# game/scripts/scene/scene_day_5.rpy:16529
translate belarusian event_m_katya_devend_c0d5b245:

    # "Мы подняли глаза к окну второго этажа."
    "Мы паднялі вочы да акна другога паверха."

# game/scripts/scene/scene_day_5.rpy:16530
translate belarusian event_m_katya_devend_a2c9071b:

    # voice "voice/lydia/5day/19 Ver.ogg"
    # Lilia_P "Вернись в класс. Придётся тебе меня подождать."
    voice "voice/lydia/5day/19 Ver.ogg"
    Lilia_P "Вярніся ў клас. Давядзецца табе мяне пачакаць."

# game/scripts/scene/scene_day_5.rpy:16532
translate belarusian event_m_katya_devend_7d0fbb93:

    # voice "voice/lydia/5day/20 Ra.ogg"
    # Lilia_P "Работы море!"
    voice "voice/lydia/5day/20 Ra.ogg"
    Lilia_P "Працы мора!"

# game/scripts/scene/scene_day_5.rpy:16534
translate belarusian event_m_katya_devend_2ce8c1a3:

    # voice "voice/Anton/5day/194 L.ogg"
    # Ant "Лилия Павловна, я могу Катю проводить."
    voice "voice/Anton/5day/194 L.ogg"
    Ant "Лілія Паўлаўна, я магу Кацю правесці."

# game/scripts/scene/scene_day_5.rpy:16536
translate belarusian event_m_katya_devend_acd18702:

    # voice "voice/lydia/5day/21 Pr.ogg"
    # Lilia_P "Правда? О-о, это было бы чудесно!"
    voice "voice/lydia/5day/21 Pr.ogg"
    Lilia_P "Праўда? О-о, гэта было б цудоўна!"

# game/scripts/scene/scene_day_5.rpy:16538
translate belarusian event_m_katya_devend_4866d949:

    # voice "voice/lydia/5day/22 No.ogg"
    # Lilia_P "Но... Кать, дома и поесть нечего."
    voice "voice/lydia/5day/22 No.ogg"
    Lilia_P "Але... Каць, дома і паесці няма чаго."

# game/scripts/scene/scene_day_5.rpy:16540
translate belarusian event_m_katya_devend_a416bb45:

    # voice "voice/kate/5day/68 Ya.ogg"
    # Kate "Я приготовлю, мам. Всё будет хорошо."
    voice "voice/kate/5day/68 Ya.ogg"
    Kate "Я прыгатую, мам. Усё будзе добра."

# game/scripts/scene/scene_day_5.rpy:16542
translate belarusian event_m_katya_devend_d89e6860:

    # voice "voice/lydia/5day/23 Mo.ogg"
    # Lilia_P "Мои вы славные! Ну, будьте аккуратны там."
    voice "voice/lydia/5day/23 Mo.ogg"
    Lilia_P "Мае вы слаўныя! Ну, будзьце асцярожныя там."

# game/scripts/scene/scene_day_5.rpy:16544
translate belarusian event_m_katya_devend_7be81fba:

    # voice "voice/Anton/5day/195 K.ogg"
    # Ant "Конечно!"
    voice "voice/Anton/5day/195 K.ogg"
    Ant "Вядома!"

# game/scripts/scene/scene_day_5.rpy:16606
translate belarusian event_m_katya_devend_16386849:

    # "Мы двинулись по дороге."
    "Мы рушылі па дарозе."

# game/scripts/scene/scene_day_5.rpy:16607
translate belarusian event_m_katya_devend_720b1696:

    # "Пепельные тучи заволокли небо, скрыли солнце, придали всему оттенок плесневелой серости."
    "Попельныя хмары зацягнулі неба, схавалі сонца, надалі ўсяму адценне цвілой шэрасці."

# game/scripts/scene/scene_day_5.rpy:16613
translate belarusian event_m_katya_devend_22ab6680:

    # voice "voice/kate/5day/69 Esh.ogg"
    # Kate "Ещё раз прости меня. За сегодня и вообще."
    voice "voice/kate/5day/69 Esh.ogg"
    Kate "Яшчэ раз прабач мне. За сёння і ўвогуле."

# game/scripts/scene/scene_day_5.rpy:16615
translate belarusian event_m_katya_devend_139891da:

    # voice "voice/kate/5day/70 T.ogg"
    # Kate "Ты, наверное, думал, я какая-то гадина?"
    voice "voice/kate/5day/70 T.ogg"
    Kate "Ты, напэўна, думаў, я нейкая гадзюка?"

# game/scripts/scene/scene_day_5.rpy:16617
translate belarusian event_m_katya_devend_54c08a09:

    # voice "voice/Anton/5day/196 Che.ogg"
    # Ant "Честно? Посещали такие мысли."
    voice "voice/Anton/5day/196 Che.ogg"
    Ant "Шчыра? Наведвалі такія думкі."

# game/scripts/scene/scene_day_5.rpy:16619
translate belarusian event_m_katya_devend_78bdab93:

    # voice "voice/kate/5day/71 Nu.ogg"
    # Kate "Ну и дурак!"
    voice "voice/kate/5day/71 Nu.ogg"
    Kate "Ну і дурань!"

# game/scripts/scene/scene_day_5.rpy:16621
translate belarusian event_m_katya_devend_ae4cefd3:

    # voice "voice/Anton/5day/197 H.ogg"
    # Ant "Хотела же честно."
    voice "voice/Anton/5day/197 H.ogg"
    Ant "Хацела ж шчыра."

# game/scripts/scene/scene_day_5.rpy:16625
translate belarusian event_m_katya_devend_e501a76f:

    # voice "voice/kate/5day/72 Ya.ogg"
    # Kate "Я тогда тоже буду честной."
    voice "voice/kate/5day/72 Ya.ogg"
    Kate "Я тады таксама буду шчырай."

# game/scripts/scene/scene_day_5.rpy:16627
translate belarusian event_m_katya_devend_5e6e4613:

    # voice "voice/kate/5day/73 Dum.ogg"
    # Kate "Думаешь, я тебя задевала, потому что садистка?"
    voice "voice/kate/5day/73 Dum.ogg"
    Kate "Думаеш, я цябе чапляла, таму што садыстка?"

# game/scripts/scene/scene_day_5.rpy:16629
translate belarusian event_m_katya_devend_603a8991:

    # voice "voice/kate/5day/74 Da.ogg"
    # Kate "Да-да-да! Как бы не так!"
    voice "voice/kate/5day/74 Da.ogg"
    Kate "Так-так-так! Дзе там!"

# game/scripts/scene/scene_day_5.rpy:16631
translate belarusian event_m_katya_devend_c5c12d67:

    # voice "voice/kate/5day/75 Ya.ogg"
    # Kate "Я не знала, как по-другому привлечь твоё внимание."
    voice "voice/kate/5day/75 Ya.ogg"
    Kate "Я не ведала, як інакш прыцягнуць тваю ўвагу."

# game/scripts/scene/scene_day_5.rpy:16633
translate belarusian event_m_katya_devend_ffde1c1c:

    # voice "voice/kate/5day/77 kh.ogg"
    # "Я посмотрел на Катю удивлённо."
    voice "voice/kate/5day/77 kh.ogg"
    "Я здзіўлена паглядзеў на Кацю."

# game/scripts/scene/scene_day_5.rpy:16635
translate belarusian event_m_katya_devend_be255b32:

    # voice "voice/kate/5day/76 V.ogg"
    # Kate "Вы, мальчики, такие недогадливые."
    voice "voice/kate/5day/76 V.ogg"
    Kate "Вы, хлопчыкі, такія нездагадлівыя."

# game/scripts/scene/scene_day_5.rpy:16653
translate belarusian event_m_katya_devend_48e236b9:

    # voice "voice/kate/5day/79 ai.ogg"
    # "Катя поморщилась, и мы остановились на миг."
    voice "voice/kate/5day/79 ai.ogg"
    "Каця паморшчылася, і мы спыніліся на імгненне."

# game/scripts/scene/scene_day_5.rpy:16659
translate belarusian event_m_katya_devend_161cf97d:

    # voice "voice/kate/5day/78V.ogg"
    # Kate "Всё нормально. Пойдём дальше."
    voice "voice/kate/5day/78V.ogg"
    Kate "Усё нармальна. Пойдзем далей."

# game/scripts/scene/scene_day_5.rpy:16720
translate belarusian event_m_katya_devend_0b4a88e1:

    # voice "voice/Anton/5day/198 Na.ogg"
    # Ant "На костылях, наверное, очень неудобно..."
    voice "voice/Anton/5day/198 Na.ogg"
    Ant "На мыліцах, напэўна, вельмі нязручна..."

# game/scripts/scene/scene_day_5.rpy:16722
translate belarusian event_m_katya_devend_f1350c3d:

    # "Банальности спасали от смущения, которое вызвали откровенные слова Кати."
    "Банальнасці ратавалі ад збянтэжанасці, якую выклікалі шчырыя словы Каці."

# game/scripts/scene/scene_day_5.rpy:16756
translate belarusian event_m_katya_devend_dadf120d:

    # "В голове стоял яркий образ: наши руки соединяются на заднем сидении бобика."
    "У галаве стаяў яркі вобраз: нашы рукі злучаюцца на заднім сядзенні бобіка."

# game/scripts/scene/scene_day_5.rpy:16768
translate belarusian event_m_katya_devend_5aee8c65:

    # voice "voice/kate/5day/79 p.ogg"
    # Kate "Привыкаешь."
    voice "voice/kate/5day/79 p.ogg"
    Kate "Звыкаеш."

# game/scripts/scene/scene_day_5.rpy:16770
translate belarusian event_m_katya_devend_e6047c70:

    # voice "voice/kate/5day/80 m.ogg"
    # Kate "Мама очень помогает."
    voice "voice/kate/5day/80 m.ogg"
    Kate "Мама вельмі дапамагае."

# game/scripts/scene/scene_day_5.rpy:16774
translate belarusian event_m_katya_devend_b8e87d2b:

    # voice "voice/kate/5day/81 E.ogg"
    # Kate "Ей и так одной нелегко, а тут ещё я, калека."
    voice "voice/kate/5day/81 E.ogg"
    Kate "Ёй і так адной нялёгка, а тут яшчэ я, калека."

# game/scripts/scene/scene_day_5.rpy:16776
translate belarusian event_m_katya_devend_b1b2fa2f:

    # voice "voice/Anton/5day/199 Y.ogg"
    # Ant "Я могу спросить?"
    voice "voice/Anton/5day/199 Y.ogg"
    Ant "Я магу спытаць?"

# game/scripts/scene/scene_day_5.rpy:16780
translate belarusian event_m_katya_devend_16c422c3:

    # voice "voice/kate/5day/82 ri.ogg"
    # Kate "Рискни."
    voice "voice/kate/5day/82 ri.ogg"
    Kate "Рызыкні."

# game/scripts/scene/scene_day_5.rpy:16782
translate belarusian event_m_katya_devend_526ad992:

    # voice "voice/Anton/5day/200 T.ogg"
    # Ant "Твой папа..."
    voice "voice/Anton/5day/200 T.ogg"
    Ant "Твой тата..."

# game/scripts/scene/scene_day_5.rpy:16786
translate belarusian event_m_katya_devend_5ebd1e6a:

    # "Катя поджала губы."
    "Каця падціснула вусны."

# game/scripts/scene/scene_day_5.rpy:16789
translate belarusian event_m_katya_devend_0d790fb1:

    # "Я зашёл на опасную территорию. Но чуть расслабившись, она сказала:"
    "Я зайшоў на небяспечную тэрыторыю. Але, крыху расслабіўшыся, яна сказала:"

# game/scripts/scene/scene_day_5.rpy:16791
translate belarusian event_m_katya_devend_1ab7f2ff:

    # voice "voice/kate/5day/83 Pa.ogg"
    # Kate "Папа работал в психдиспансере."
    voice "voice/kate/5day/83 Pa.ogg"
    Kate "Тата працаваў у псіхдыспансеры."

# game/scripts/scene/scene_day_5.rpy:16795
translate belarusian event_m_katya_devend_2e32a0de:

    # voice "voice/kate/5day/84 Ya.ogg"
    # Kate "Я столько от него узнала про наших милых соседей."
    voice "voice/kate/5day/84 Ya.ogg"
    Kate "Я столькі ад яго даведалася пра нашых мілых суседзяў."

# game/scripts/scene/scene_day_5.rpy:16797
translate belarusian event_m_katya_devend_4ea5f39a:

    # "Видимо, старалась соскочить с темы."
    "Відаць, старалася саскочыць з тэмы."

# game/scripts/scene/scene_day_5.rpy:16800
translate belarusian event_m_katya_devend_457169c9:

    # voice "voice/kate/5day/85 V.ogg"
    # Kate "Возьми Полину. Там семейка ещё та..."
    voice "voice/kate/5day/85 V.ogg"
    Kate "Вазьмі Паліну. Там сямейка яшчэ тая..."

# game/scripts/scene/scene_day_5.rpy:16802
translate belarusian event_m_katya_devend_3436eb98:

    # voice "voice/kate/5day/86 E.ogg"
    # Kate "Это же её дед сдал Бяшину маму в психушку."
    voice "voice/kate/5day/86 E.ogg"
    Kate "Гэта ж яе дзед здаў Бяшыну маму ў псіхушку."

# game/scripts/scene/scene_day_5.rpy:16804
translate belarusian event_m_katya_devend_7ab20c78:

    # voice "voice/Anton/5day/201 Ha.ogg"
    # Ant "Харитон?"
    voice "voice/Anton/5day/201 Ha.ogg"
    Ant "Харытон?"

# game/scripts/scene/scene_day_5.rpy:16806
translate belarusian event_m_katya_devend_c63ad7c1:

    # voice "voice/kate/5day/87 on.ogg"
    # Kate "Он самый. Хотя не скажу, что без оснований."
    voice "voice/kate/5day/87 on.ogg"
    Kate "Ён самы. Хоць не скажу, што без падстаў."

# game/scripts/scene/scene_day_5.rpy:16808
translate belarusian event_m_katya_devend_a2f7d389:

    # voice "voice/kate/5day/88 Ma.ogg"
    # Kate "Мама Бяши слухи распускала... даже не слухи, а так — бред несла."
    voice "voice/kate/5day/88 Ma.ogg"
    Kate "Мама Бяшы чуткі распускала... нават не чуткі, а так — лухту несла."

# game/scripts/scene/scene_day_5.rpy:16810
translate belarusian event_m_katya_devend_84b6253b:

    # voice "voice/kate/5day/89 G.ogg"
    # Kate "Говорила, что люди в посёлке одержимы бесами, что дед Харитон — чёрт."
    voice "voice/kate/5day/89 G.ogg"
    Kate "Казала, што людзі ў пасёлку апантаныя бесамі, што дзед Харытон — чорт."

# game/scripts/scene/scene_day_5.rpy:16812
translate belarusian event_m_katya_devend_9809f959:

    # voice "voice/kate/5day/90 Na.ogg"
    # Kate "Насинячилась с утра пораньше, вот черти и мерещатся."
    voice "voice/kate/5day/90 Na.ogg"
    Kate "Насінячылася з самага ранку, вось чэрці і мрояцца."

# game/scripts/scene/scene_day_5.rpy:16830
translate belarusian event_m_katya_devend_b1036640:

    # "Я вспомнил старика на инвалидном кресле и его зловещие байки."
    "Я згадаў старога ў інвалідным крэсле і яго злавесныя байкі."

# game/scripts/scene/scene_day_5.rpy:16837
translate belarusian event_m_katya_devend_d0db524c:

    # voice "voice/kate/5day/91 Ko.ogg"
    # Kate "Когда её закрыли, Харитон стал присматривать за Бяшей."
    voice "voice/kate/5day/91 Ko.ogg"
    Kate "Калі яе закрылі, Харытон пачаў прыглядаць за Бяшам."

# game/scripts/scene/scene_day_5.rpy:16839
translate belarusian event_m_katya_devend_246bd159:

    # voice "voice/kate/5day/92 E.ogg"
    # Kate "И про папашу Ромки отец рассказывал."
    voice "voice/kate/5day/92 E.ogg"
    Kate "І пра бацьку Ромкі тата расказваў."

# game/scripts/scene/scene_day_5.rpy:16841
translate belarusian event_m_katya_devend_70c9a703:

    # voice "voice/kate/5day/93 Z.ogg"
    # Kate "Знал, что он проходит терапию, как наркозависимый?"
    voice "voice/kate/5day/93 Z.ogg"
    Kate "Ведаў, што ён праходзіць тэрапію як нарказалежны?"

# game/scripts/scene/scene_day_5.rpy:16843
translate belarusian event_m_katya_devend_8a039476:

    # voice "voice/kate/5day/94 da.ogg"
    # Kate "Да-да-да!"
    voice "voice/kate/5day/94 da.ogg"
    Kate "Так-так-так!"

# game/scripts/scene/scene_day_5.rpy:16845
translate belarusian event_m_katya_devend_cebc3120:

    # voice "voice/kate/5day/95  Ez.ogg"
    # Kate "Из-за этого и лупит сынка."
    voice "voice/kate/5day/95  Ez.ogg"
    Kate "Праз гэта і лупіць сынка."

# game/scripts/scene/scene_day_5.rpy:16847
translate belarusian event_m_katya_devend_8d284522:

    # voice "voice/kate/5day/96 N.ogg"
    # Kate "Не удивлюсь, если Ромка сам скоро встанет в диспансере на учёт."
    voice "voice/kate/5day/96 N.ogg"
    Kate "Не здзіўлюся, калі Ромка сам хутка стане ў дыспансеры на ўлік."

# game/scripts/scene/scene_day_5.rpy:16849
translate belarusian event_m_katya_devend_2b8751e8:

    # voice "voice/kate/5day/97 S.ogg"
    # Kate "С такой-то жизнью."
    voice "voice/kate/5day/97 S.ogg"
    Kate "З такім-та жыццём."

# game/scripts/scene/scene_day_5.rpy:16855
translate belarusian event_m_katya_devend_66e2d353:

    # "Мне было неприятно слушать о тёмных сторонах людей."
    "Мне было непрыемна слухаць пра цёмныя бакі людзей."

# game/scripts/scene/scene_day_5.rpy:16856
translate belarusian event_m_katya_devend_24507e87:

    # "Наркоманы, больные женщины..."
    "Наркаманы, хворыя жанчыны..."

# game/scripts/scene/scene_day_5.rpy:16857
translate belarusian event_m_katya_devend_ecf834b9:

    # "Я вновь подумал, что мрак обитает не только в лесу или в затянутых паутиной углах старых домов."
    "Я зноў падумаў, што змрок жыве не толькі ў лесе ці ў зацягнутых павуціннем кутах старых дамоў."

# game/scripts/scene/scene_day_5.rpy:16858
translate belarusian event_m_katya_devend_8186442f:

    # "Часто он копится в головах."
    "Часта ён назапашваецца ў галовах."

# game/scripts/scene/scene_day_5.rpy:16859
translate belarusian event_m_katya_devend_a043b7c5:

    # "И пробуждает что-то опасное... демонов... потаённых зверей..."
    "І абуджае нешта небяспечнае... дэманаў... патаемных звяроў..."

# game/scripts/scene/scene_day_5.rpy:16868
translate belarusian event_m_katya_devend_f5231065:

    # voice "voice/Anton/5day/202 Chto.ogg"
    # Ant "Что мы всё о других? Расскажи о себе."
    voice "voice/Anton/5day/202 Chto.ogg"
    Ant "Што мы ўсё пра іншых? Раскажы пра сябе."

# game/scripts/scene/scene_day_5.rpy:16871
translate belarusian event_m_katya_devend_36ed3a5a:

    # voice "voice/kate/5day/98a.ogg"
    # Kate "А что рассказывать? Ты и так всё знаешь."
    voice "voice/kate/5day/98a.ogg"
    Kate "А што расказваць? Ты і так усё ведаеш."

# game/scripts/scene/scene_day_5.rpy:16873
translate belarusian event_m_katya_devend_b7da548f:

    # voice "voice/Anton/5day/203 Ne.ogg"
    # Ant "Ничего я не знаю."
    voice "voice/Anton/5day/203 Ne.ogg"
    Ant "Нічога я не ведаю."

# game/scripts/scene/scene_day_5.rpy:16875
translate belarusian event_m_katya_devend_a605cbc8:

    # voice "voice/Anton/5day/204 T.ogg"
    # Ant "Ты сказала: папа работал."
    voice "voice/Anton/5day/204 T.ogg"
    Ant "Ты сказала: тата працаваў."

# game/scripts/scene/scene_day_5.rpy:16877
translate belarusian event_m_katya_devend_468652cf:

    # voice "voice/Anton/5day/205 On.ogg"
    # Ant "Он уволился?"
    voice "voice/Anton/5day/205 On.ogg"
    Ant "Ён звольніўся?"

# game/scripts/scene/scene_day_5.rpy:16880
translate belarusian event_m_katya_devend_8c204392:

    # voice "voice/kate/5day/99t.ogg"
    # Kate "Так бывает."
    voice "voice/kate/5day/99t.ogg"
    Kate "Так бывае."

# game/scripts/scene/scene_day_5.rpy:16883
translate belarusian event_m_katya_devend_9cb28513:

    # "Катя отвела взгляд в туман, ползущий впереди."
    "Каця адвяла позірк у туман, што поўз наперадзе."

# game/scripts/scene/scene_day_5.rpy:16884
translate belarusian event_m_katya_devend_e70c74df:

    # voice "voice/kate/5day/100e.ogg"
    # Kate "Имеешь дело с психами и сам теряешь разум."
    voice "voice/kate/5day/100e.ogg"
    Kate "Маеш справу з псіхамі і сам губляеш розум."

# game/scripts/scene/scene_day_5.rpy:16887
translate belarusian event_m_katya_devend_975e6023:

    # voice "voice/kate/5day/101p.ogg"
    # Kate "Папка нашёл себе молоденькую медсестру и слинял с ней, кобель."
    voice "voice/kate/5day/101p.ogg"
    Kate "Татка знайшоў сабе маладзенькую медсястру і зліняў з ёй, кабёл."

# game/scripts/scene/scene_day_5.rpy:16889
translate belarusian event_m_katya_devend_f1c0bbc4:

    # voice "voice/kate/5day/102ma.ogg"
    # Kate "Маме пришлось вертеться, чтобы я ни в чём не нуждалась. И преподавать, и воспитывать меня."
    voice "voice/kate/5day/102ma.ogg"
    Kate "Маме давялося круціцца, каб я ні ў чым не мела патрэбы. І выкладаць, і выхоўваць мяне."

# game/scripts/scene/scene_day_5.rpy:16892
translate belarusian event_m_katya_devend_cc76e077:

    # voice "voice/kate/5day/103z.ogg"
    # Kate "Знаешь, как она меня любит?"
    voice "voice/kate/5day/103z.ogg"
    Kate "Ведаеш, як яна мяне любіць?"

# game/scripts/scene/scene_day_5.rpy:16894
translate belarusian event_m_katya_devend_f48ed394:

    # voice "voice/kate/5day/104e.ogg"
    # Kate "Если бы меня не стало, она бы, думаю, руки на себя наложила."
    voice "voice/kate/5day/104e.ogg"
    Kate "Калі б мяне не стала, яна б, думаю, рукі на сябе наклала."

# game/scripts/scene/scene_day_5.rpy:16897
translate belarusian event_m_katya_devend_25e10570:

    # voice "voice/kate/5day/105t.ogg"
    # Kate "Так что ты, считай, двоих спас."
    voice "voice/kate/5day/105t.ogg"
    Kate "Так што ты, лічы, дваіх выратаваў."

# game/scripts/scene/scene_day_5.rpy:16899
translate belarusian event_m_katya_devend_46ced24c:

    # "У меня в голове нарисовалась яркая картинка."
    "У мяне ў галаве намалявалася яркая карцінка."

# game/scripts/scene/scene_day_5.rpy:16923
translate belarusian event_m_katya_devend_71219415:

    # "Дети ждут начала урока, но вместо их учительницы в класс входит директор."
    "Дзеці чакаюць пачатку ўрока, але замест іх настаўніцы ў клас уваходзіць дырэктар."

# game/scripts/scene/scene_day_5.rpy:16924
translate belarusian event_m_katya_devend_160664ba:

    # "Он говорит, что литературы сегодня не будет."
    "Ён кажа, што літаратуры сёння не будзе."

# game/scripts/scene/scene_day_5.rpy:16937
translate belarusian event_m_katya_devend_540576c0:

    # "Лилия Павловна умерла. Повесилась."
    "Лілія Паўлаўна памерла. Павесілася."

# game/scripts/scene/scene_day_5.rpy:16948
translate belarusian event_m_katya_devend_e1ac50ef:

    # "Воображённая сцена ошпарила болью сердце и вернула меня в тот трагический день."
    "Уяўленая сцэна апякла болем сэрца і вярнула мяне ў той трагічны дзень."

# game/scripts/scene/scene_day_5.rpy:17004
translate belarusian event_m_katya_devend_953e3684:

    # "Катя в раструбе мясорубки... её изувеченные пальцы."
    "Каця ў раструбе мясарубкі... яе знявечаныя пальцы."

# game/scripts/scene/scene_day_5.rpy:17022
translate belarusian event_m_katya_devend_cdb45ff6:

    # "Я заморгал, борясь с наваждением. И задал осторожный вопрос."
    "Я заміргаў, змагаючыся з насланнём. І задаў асцярожнае пытанне."

# game/scripts/scene/scene_day_5.rpy:17023
translate belarusian event_m_katya_devend_6411ec2d:

    # voice "voice/Anton/5day/206 Ti.ogg"
    # Ant "Ты помнишь, как тебя похитили?"
    voice "voice/Anton/5day/206 Ti.ogg"
    Ant "Ты памятаеш, як цябе выкралі?"

# game/scripts/scene/scene_day_5.rpy:17027
translate belarusian event_m_katya_devend_908568cd:

    # voice "voice/kate/5day/106 gl.ogg"
    # "Катя сглотнула слюну."
    voice "voice/kate/5day/106 gl.ogg"
    "Каця праглынула сліну."

# game/scripts/scene/scene_day_5.rpy:17029
translate belarusian event_m_katya_devend_82d23636:

    # "Я отругал себя за длинный язык. Нашёл, о чём спрашивать!"
    "Я вылаяў сябе за доўгі язык. Знайшоў, пра што пытацца!"

# game/scripts/scene/scene_day_5.rpy:17030
translate belarusian event_m_katya_devend_c1e02ba9:

    # voice "voice/kate/5day/107 V.ogg"
    # Kate "В общих чертах."
    voice "voice/kate/5day/107 V.ogg"
    Kate "У агульных рысах."

# game/scripts/scene/scene_day_5.rpy:17032
translate belarusian event_m_katya_devend_74200eb0:

    # voice "voice/kate/5day/108on.ogg"
    # Kate "Он... п-подошёл сзади, схватил, и... и я... наверное, п-потеряла сознание."
    voice "voice/kate/5day/108on.ogg"
    Kate "Ён... п-падышоў ззаду, схапіў, і... і я... напэўна, с-страціла прытомнасць."

# game/scripts/scene/scene_day_5.rpy:17034
translate belarusian event_m_katya_devend_09fb756f:

    # "Знакомая до дрожи история..."
    "Знаёмая да дрыжыкаў гісторыя..."

# game/scripts/scene/scene_day_5.rpy:17036
translate belarusian event_m_katya_devend_f845bc7f:

    # voice "voice/kate/5day/01 p.ogg"
    # Kate "Потому что как иначе это объяснить?"
    voice "voice/kate/5day/01 p.ogg"
    Kate "Бо як інакш гэта растлумачыць?"

# game/scripts/scene/scene_day_5.rpy:17038
translate belarusian event_m_katya_devend_8b68d84b:

    # voice "voice/kate/5day/02 u.ogg"
    # Kate "У него было твоё лицо, Антон! А потом как взмыл в небо, да-да-да."
    voice "voice/kate/5day/02 u.ogg"
    Kate "У яго быў твой твар, Антон! А потым як узвіўся ў неба, так-так-так."

# game/scripts/scene/scene_day_5.rpy:17040
translate belarusian event_m_katya_devend_9ec37373:

    # voice "voice/kate/5day/03 e.ogg"
    # Kate "И дальше такая чертовщина началась… Бр-р-р!"
    voice "voice/kate/5day/03 e.ogg"
    Kate "І далей такая чартаўшчына пачалася... Бр-р-р!"

# game/scripts/scene/scene_day_5.rpy:17043
translate belarusian event_m_katya_devend_da2167d0:

    # voice "voice/kate/5day/04 y.ogg"
    # Kate "Я поняла, что это всего лишь кошмар. П-потом, когда очнулась..."
    voice "voice/kate/5day/04 y.ogg"
    Kate "Я зразумела, што гэта ўсяго толькі кашмар. П-потым, калі апрытомнела..."

# game/scripts/scene/scene_day_5.rpy:17045
translate belarusian event_m_katya_devend_40080c9a:

    # voice "voice/kate/5day/05 s.ogg"
    # Kate "Смотрю, он тащит меня по снегу."
    voice "voice/kate/5day/05 s.ogg"
    Kate "Гляджу, ён цягне мяне па снезе."

# game/scripts/scene/scene_day_5.rpy:17047
translate belarusian event_m_katya_devend_6f04faa8:

    # voice "voice/kate/5day/110 Ya.ogg"
    # Kate "Я кошелёк хвать... бросила на дорогу. Надеялась, кто-то найдёт и..."
    voice "voice/kate/5day/110 Ya.ogg"
    Kate "Я гаманец хап... кінула на дарогу. Спадзявалася, хтосьці знойдзе і..."

# game/scripts/scene/scene_day_5.rpy:17077
translate belarusian event_m_katya_devend_87f86ddd:

    # "Катя встала напротив многоквартирных домов, таких было всего два в посёлке, и отвернулась."
    "Каця стала насупраць шматкватэрных дамоў, такіх было ўсяго два ў пасёлку, і адвярнулася."

# game/scripts/scene/scene_day_5.rpy:17078
translate belarusian event_m_katya_devend_b1e515ba:

    # voice "voice/Anton/5day/207 K.ogg"
    # Ant "Кать?"
    voice "voice/Anton/5day/207 K.ogg"
    Ant "Каць?"

# game/scripts/scene/scene_day_5.rpy:17080
translate belarusian event_m_katya_devend_af10dc2b:

    # voice "voice/kate/5day/111 hn.ogg"
    # "Я услышал, что она плачет."
    voice "voice/kate/5day/111 hn.ogg"
    "Я пачуў, што яна плача."

# game/scripts/scene/scene_day_5.rpy:17094
translate belarusian event_m_katya_devend_c0e94151:

    # voice "voice/kate/5day/112 ch.ogg"
    # Kate "Что — Кать?"
    voice "voice/kate/5day/112 ch.ogg"
    Kate "Што — Каць?"

# game/scripts/scene/scene_day_5.rpy:17098
translate belarusian event_m_katya_devend_df8db7f7:

    # voice "voice/kate/5day/113 Ya.ogg"
    # Kate "Я двенадцать лет «Кать»!"
    voice "voice/kate/5day/113 Ya.ogg"
    Kate "Я дванаццаць гадоў «Каць»!"

# game/scripts/scene/scene_day_5.rpy:17101
translate belarusian event_m_katya_devend_6b69349d:

    # voice "voice/Anton/5day/208 Nu.ogg"
    # Ant "Ну не надо. Всё позади."
    voice "voice/Anton/5day/208 Nu.ogg"
    Ant "Ну не трэба. Усё мінула."

# game/scripts/scene/scene_day_5.rpy:17104
translate belarusian event_m_katya_devend_bf334cda:

    # voice "voice/kate/5day/114 At.ogg"
    # Kate "А ты знаешь, чего я больше всего испугалась в мясорубке этой?"
    voice "voice/kate/5day/114 At.ogg"
    Kate "А ты ведаеш, чаго я больш за ўсё спалохалася ў мясарубцы гэтай?"

# game/scripts/scene/scene_day_5.rpy:17108
translate belarusian event_m_katya_devend_bddbd490:

    # voice "voice/kate/5day/115ch.ogg"
    # Kate "Что умру и не признаюсь тебе."
    voice "voice/kate/5day/115ch.ogg"
    Kate "Што памру і не прызнаюся табе."

# game/scripts/scene/scene_day_5.rpy:17111
translate belarusian event_m_katya_devend_81cfdf00:

    # voice "voice/Anton/5day/209 V.ogg"
    # Ant "В чём?"
    voice "voice/Anton/5day/209 V.ogg"
    Ant "У чым?"

# game/scripts/scene/scene_day_5.rpy:17120
translate belarusian event_m_katya_devend_7180703a:

    # "Катя резко повернула ко мне покрасневшее лицо."
    "Каця рэзка павярнула да мяне пачырванелы твар."

# game/scripts/scene/scene_day_5.rpy:17123
translate belarusian event_m_katya_devend_6568b2ca:

    # voice "voice/kate/5day/116 k.ogg"
    # Kate "Какой ты кретин, Антон Петров!"
    voice "voice/kate/5day/116 k.ogg"
    Kate "Які ты крэтын, Антон Пятроў!"

# game/scripts/scene/scene_day_5.rpy:17129
translate belarusian event_m_katya_devend_a47ce4f2:

    # voice "voice/kate/5day/117v.ogg"
    # Kate "В том, что ты мне нравишься!"
    voice "voice/kate/5day/117v.ogg"
    Kate "У тым, што ты мне падабаешся!"

# game/scripts/scene/scene_day_5.rpy:17133
translate belarusian event_m_katya_devend_8f0584ec:

    # "Я опешил."
    "Я разгубіўся."

# game/scripts/scene/scene_day_5.rpy:17134
translate belarusian event_m_katya_devend_92fe9c12:

    # "И услышал собственные слова, прозвучавшие словно издали:"
    "І пачуў уласныя словы, якія прагучалі нібы здалёк:"

# game/scripts/scene/scene_day_5.rpy:17135
translate belarusian event_m_katya_devend_3e66440d:

    # voice "voice/Anton/5day/210 T.ogg"
    # Ant "Ты мне тоже."
    voice "voice/Anton/5day/210 T.ogg"
    Ant "Ты мне таксама."

# game/scripts/scene/scene_day_5.rpy:17139
translate belarusian event_m_katya_devend_0bb3fc39:

    # voice "voice/kate/5day/118 Ch.ogg"
    # Kate "Честно?"
    voice "voice/kate/5day/118 Ch.ogg"
    Kate "Шчыра?"

# game/scripts/scene/scene_day_5.rpy:17143
translate belarusian event_m_katya_devend_14b7ed21:

    # voice "voice/Anton/5day/211 Ch.ogg"
    # Ant "Честно."
    voice "voice/Anton/5day/211 Ch.ogg"
    Ant "Шчыра."

# game/scripts/scene/scene_day_5.rpy:17148
translate belarusian event_m_katya_devend_3c4b67d0:

    # "Я вытер слёзы с её просветлевшего лица."
    "Я выцер слёзы з яе пасвятлелага твару."

# game/scripts/scene/scene_day_5.rpy:17149
translate belarusian event_m_katya_devend_dabc5dab:

    # voice "voice/Anton/5day/212 K.ogg"
    # Ant "Конечно, нравишься. По-моему, это очевидно."
    voice "voice/Anton/5day/212 K.ogg"
    Ant "Вядома, падабаешся. Па-мойму, гэта відавочна."

# game/scripts/scene/scene_day_5.rpy:17153
translate belarusian event_m_katya_devend_29f555ce:

    # voice "voice/kate/5day/119 V.ogg"
    # Kate "Всё вам, парням, очевидно."
    voice "voice/kate/5day/119 V.ogg"
    Kate "Усё вам, хлопцам, відавочна."

# game/scripts/scene/scene_day_5.rpy:17158
translate belarusian event_m_katya_devend_82482566:

    # voice "voice/kate/5day/120 a.ogg"
    # Kate "А девушки хотят слышать. Мы ушами любим, знаешь такое?"
    voice "voice/kate/5day/120 a.ogg"
    Kate "А дзяўчаты хочуць чуць. Мы вушамі кахаем, ведаеш такое?"

# game/scripts/scene/scene_day_5.rpy:17162
translate belarusian event_m_katya_devend_13168ae4:

    # "Я очень многого ещё не знал."
    "Я вельмі шмат чаго яшчэ не ведаў."

# game/scripts/scene/scene_day_5.rpy:17163
translate belarusian event_m_katya_devend_c39d3b68:

    # "Блестели Катины слёзы, снег осыпал перекрёсток, будто развилку с разными вариантами, с непохожими жизнями."
    "Блішчалі Каціны слёзы, снег асыпаў скрыжаванне, нібы раздарожжа з рознымі варыянтамі, з непадобнымі жыццямі."

# game/scripts/scene/scene_day_5.rpy:17164
translate belarusian event_m_katya_devend_7e203eac:

    # "Мне казалось, что этот момент очень важен, и его надо увековечить."
    "Мне здавалася, што гэты момант вельмі важны, і яго трэба ўвекавечыць."

# game/scripts/scene/scene_day_5.rpy:17165
translate belarusian event_m_katya_devend_098c264f:

    # voice "voice/Anton/5day/213 r.ogg"
    # Ant "Разрешишь тебя нарисовать?"
    voice "voice/Anton/5day/213 r.ogg"
    Ant "Дазволіш цябе намаляваць?"

# game/scripts/scene/scene_day_5.rpy:17170
translate belarusian event_m_katya_devend_a26beed4:

    # "Катя улыбнулась и утёрла слёзы."
    "Каця ўсміхнулася і выцерла слёзы."

# game/scripts/scene/scene_day_5.rpy:17172
translate belarusian event_m_katya_devend_40ba10ac:

    # voice "voice/kate/5day/121 t.ogg"
    # Kate "Только не зарёванной."
    voice "voice/kate/5day/121 t.ogg"
    Kate "Толькі не зарумзанай."

# game/scripts/scene/scene_day_5.rpy:17175
translate belarusian event_m_katya_devend_907de230:

    # voice "voice/Anton/5day/214 po.ogg"
    # Ant "По рукам!"
    voice "voice/Anton/5day/214 po.ogg"
    Ant "Па руках!"

# game/scripts/scene/scene_day_5.rpy:17182
translate belarusian event_m_katya_devend_a9072e72:

    # "Она перевела взгляд на панельное здание."
    "Яна перавяла позірк на панэльны будынак."

# game/scripts/scene/scene_day_5.rpy:17184
translate belarusian event_m_katya_devend_bc4a9a7d:

    # voice "voice/kate/5day/122 z.ogg"
    # Kate "Здесь я живу."
    voice "voice/kate/5day/122 z.ogg"
    Kate "Тут я жыву."

# game/scripts/scene/scene_day_5.rpy:17187
translate belarusian event_m_katya_devend_687e5aa4:

    # voice "voice/Anton/5day/215 Kr.ogg"
    # Ant "Круто. Ты и в этом отличилась от всех."
    voice "voice/Anton/5day/215 Kr.ogg"
    Ant "Крута. Ты і ў гэтым адрознілася ад усіх."

# game/scripts/scene/scene_day_5.rpy:17191
translate belarusian event_m_katya_devend_7d8f4033:

    # voice "voice/kate/5day/123 r.ogg"
    # Kate "Родителям выдали квартиру. Учитель и врач — важные люди в посёлке."
    voice "voice/kate/5day/123 r.ogg"
    Kate "Бацькам далі кватэру. Настаўнік і доктар — важныя людзі ў пасёлку."

# game/scripts/scene/scene_day_5.rpy:17195
translate belarusian event_m_katya_devend_7875aa0e:

    # voice "voice/kate/5day/124 k.ogg"
    # Kate "Комфорт с видом на мусорную площадку."
    voice "voice/kate/5day/124 k.ogg"
    Kate "Камфорт з відам на смеццевую пляцоўку."

# game/scripts/scene/scene_day_5.rpy:17210
translate belarusian event_m_katya_devend_d757fab0:

    # "Я выбрал бы мусорки вместо чащобы, окружающей наше жильё."
    "Я выбраў бы сметнікі замест гушчару, які акружае наша жыллё."

# game/scripts/scene/scene_day_5.rpy:17215
translate belarusian event_m_katya_devend_a83a3d9d:

    # voice "voice/kate/5day/125 za.ogg"
    # Kate "Жаль, нет лифта, мучусь с костылями."
    voice "voice/kate/5day/125 za.ogg"
    Kate "Шкада, няма ліфта, мучуся з мыліцамі."

# game/scripts/scene/scene_day_5.rpy:17217
translate belarusian event_m_katya_devend_8b2b9213:

    # voice "voice/kate/5day/126ne.ogg"
    # Kate "Непросто добираться на третий этаж."
    voice "voice/kate/5day/126ne.ogg"
    Kate "Няпроста дабірацца на трэці паверх."

# game/scripts/scene/scene_day_5.rpy:17221
translate belarusian event_m_katya_devend_92e1171c:

    # voice "voice/Anton/5day/216 T.ogg"
    # Ant "Ты позволишь?"
    voice "voice/Anton/5day/216 T.ogg"
    Ant "Ты дазволіш?"

# game/scripts/scene/scene_day_5.rpy:17237
translate belarusian event_m_katya_devend_50053941:

    # "Когда-то мама рассказала, как на свидании с будущим мужем — моим папой — подвернула ногу."
    "Калісьці мама расказала, як на спатканні з будучым мужам — маім татам — падвярнула нагу."

# game/scripts/scene/scene_day_5.rpy:17238
translate belarusian event_m_katya_devend_03e3e7e7:

    # "И папа нёс маму на руках два квартала."
    "І тата нёс маму на руках два кварталы."

# game/scripts/scene/scene_day_5.rpy:17239
translate belarusian event_m_katya_devend_e314e09f:

    # "Тогда она и решила, что будет вместе с этим мужчиной."
    "Тады яна і вырашыла, што будзе разам з гэтым мужчынам."

# game/scripts/scene/scene_day_5.rpy:17245
translate belarusian event_m_katya_devend_782d61f0:

    # voice "voice/kate/5day/127ah.ogg"
    voice "voice/kate/5day/127ah.ogg"

# game/scripts/scene/scene_day_5.rpy:17260
translate belarusian event_m_katya_devend_9a1d3dd5:

    # voice "voice/kate/5day/128 ok.ogg"
    # Kate "Окончательно спятил! Придурок, я ж тяжёлая."
    voice "voice/kate/5day/128 ok.ogg"
    Kate "Канчаткова з глузду з'ехаў! Прыдурак, я ж цяжкая."

# game/scripts/scene/scene_day_5.rpy:17271
translate belarusian event_m_katya_devend_c9b3523c:

    # voice "voice/Anton/5day/218 K.ogg"
    # Ant "Как пушинка."
    voice "voice/Anton/5day/218 K.ogg"
    Ant "Як пушынка."

# game/scripts/scene/scene_day_5.rpy:17310
translate belarusian event_m_katya_devend_b3aa199e:

    # voice "voice/kate/5day/129 oi.ogg"
    # Kate "Ой! Смотри лапы-то свои не распускай."
    voice "voice/kate/5day/129 oi.ogg"
    Kate "Ой! Глядзі, лапы свае не распускай."

# game/scripts/scene/scene_day_5.rpy:17314
translate belarusian event_m_katya_devend_d6487ce5:

    # voice "voice/kate/5day/130 at.ogg"
    # Kate "А то маме расскажу."
    voice "voice/kate/5day/130 at.ogg"
    Kate "А то маме раскажу."

# game/scripts/scene/scene_day_5.rpy:17322
translate belarusian event_m_katya_devend_ac5f4ec9:

    # "Я взял её на руки и понёс к квартире."
    "Я ўзяў яе на рукі і панёс да кватэры."

# game/scripts/scene/scene_day_5.rpy:17329
translate belarusian event_m_katya_devend_336acf64:

    # "Навстречу нам вышла дворничиха, грызущая козинак. Её мучнистое лицо расплылось."
    "Насустрач нам выйшла дворнічыха, якая грызла казінак. Яе мучністы твар расплыўся."

# game/scripts/scene/scene_day_5.rpy:17334
translate belarusian event_m_katya_devend_e68d48ac:

    # voice "voice/episod/06 Vot.ogg"
    # Janitor "Вот так вот! Ха! Картина маслом! Как в сериале бразильском!"
    voice "voice/episod/06 Vot.ogg"
    Janitor "Вось так вось! Ха! Карціна алеем! Як у серыяле бразільскім!"

# game/scripts/scene/scene_day_5.rpy:17339
translate belarusian event_m_katya_devend_5b57f254:

    # voice "voice/episod/07 N.ogg" 
    # Janitor "Ну молодец, мальчуган! Как несёт-то, а! Ха-ха-ха!"
    voice "voice/episod/07 N.ogg" 
    Janitor "Ну малайчына, хлапчук! Як нясе, а! Ха-ха-ха!"

# game/scripts/scene/scene_day_5.rpy:17347
translate belarusian event_m_katya_devend_6da57047:

    # voice "voice/episod/08 L.ogg" 
    # Janitor "Люди добрые, поглядите!"
    voice "voice/episod/08 L.ogg" 
    Janitor "Людзі добрыя, паглядзіце!"

# game/scripts/scene/scene_day_5.rpy:17352
translate belarusian event_m_katya_devend_9e56044f:

    # voice "voice/episod/09 A.ogg" 
    # Janitor "А говорят, американское кино молодёжь попортило! Есть ещё добрые молодцы! Ух, хе-хе-хе!"
    voice "voice/episod/09 A.ogg" 
    Janitor "А кажуць, амерыканскае кіно моладзь сапсавала! Ёсць яшчэ добрыя малайцы! Ух, хе-хе-хе!"

# game/scripts/scene/scene_day_5.rpy:17359
translate belarusian event_m_katya_devend_45985722:

    # "Я промычал что-то смущённо. А вот Катя покраснела, как помидор."
    "Я прамычаў нешта збянтэжана. А вось Каця пачырванела, як памідор."

# game/scripts/scene/scene_day_5.rpy:17386
translate belarusian event_m_katya_devend_61dbd069:

    # "Хоть она и была лёгкой, но на ступеньках меня стало водить из стороны в сторону."
    "Хоць яна і была лёгкай, але на прыступках мяне пачало хістаць з боку ў бок."

# game/scripts/scene/scene_day_5.rpy:17413
translate belarusian event_m_katya_devend_6f720360:

    # "Костыли, которые она держала, изредка ударялись о перила с металлическим звоном."
    "Мыліцы, якія яна трымала, зрэдку стукаліся аб парэнчы з металічным звонам."

# game/scripts/scene/scene_day_5.rpy:17414
translate belarusian event_m_katya_devend_48c1b9bd:

    # voice "voice/kate/5day/131 hi.ogg"
    # "Катя смущённо хихикала."
    voice "voice/kate/5day/131 hi.ogg"
    "Каця збянтэжана хіхікала."

# game/scripts/scene/scene_day_5.rpy:17418
translate belarusian event_m_katya_devend_49ab9134:

    # voice "voice/kate/5day/131 hihi.ogg"
    # "У неё вдруг стало такое лицо, точно она запоминала каждый миг этого восхождения."
    voice "voice/kate/5day/131 hihi.ogg"
    "У яе раптам стаў такі твар, быццам яна запамінала кожнае імгненне гэтага ўзыходжання."

# game/scripts/scene/scene_day_5.rpy:17445
translate belarusian event_m_katya_devend_0fdb4d27:

    # "А я изо всех сил старался не сопеть и держаться прямо."
    "А я з усіх сіл стараўся не сапці і трымацца прама."

# game/scripts/scene/scene_day_5.rpy:17446
translate belarusian event_m_katya_devend_bfad3207:

    # "В спину доносились подбадривающие реплики:"
    "У спіну даносіліся падбадзёрлівыя рэплікі:"

# game/scripts/scene/scene_day_5.rpy:17451
translate belarusian event_m_katya_devend_9e1844b9:

    # voice "voice/episod/10 Na.ogg" 
    # Janitor "Настоящий кавалер! Женись на нём, Катька, как подрастёшь! Хе-хе-хе!"
    voice "voice/episod/10 Na.ogg" 
    Janitor "Сапраўдны кавалер! Жаніся з ім, Кацька, як падрасцеш! Хе-хе-хе!"

# game/scripts/scene/scene_day_5.rpy:17455
translate belarusian event_m_katya_devend_85e77347:

    # "Катя прыснула:"
    "Каця пырснула:"

# game/scripts/scene/scene_day_5.rpy:17466
translate belarusian event_m_katya_devend_99c6a83a:

    # voice "voice/kate/5day/132 ob.ogg"
    # Kate "Обязательно!"
    voice "voice/kate/5day/132 ob.ogg"
    Kate "Абавязкова!"

# game/scripts/scene/scene_day_5.rpy:17491
translate belarusian event_m_katya_devend_94ac0a7f:

    # "Я осторожно поставил Катю на бетон у порога её квартиры."
    "Я асцярожна паставіў Кацю на бетон ля парога яе кватэры."

# game/scripts/scene/scene_day_5.rpy:17493
translate belarusian event_m_katya_devend_7c20d642:

    # voice "voice/kate/5day/131 hihihi.ogg"
    # "Она, радостно озираясь на меня через плечо и прикусывая губы, отперла дверь."
    voice "voice/kate/5day/131 hihihi.ogg"
    "Яна, радасна азіраючыся на мяне праз плячо і прыкусваючы вусны, адамкнула дзверы."

# game/scripts/scene/scene_day_5.rpy:17501
translate belarusian event_m_katya_devend_8dd138e6:

    # voice "voice/kate/5day/133 s.ogg"
    # Kate "Спасибо, силач!"
    voice "voice/kate/5day/133 s.ogg"
    Kate "Дзякуй, асілак!"

# game/scripts/scene/scene_day_5.rpy:17527
translate belarusian event_m_katya_devend_a9fc7484:

    # voice "voice/kate/5day/134 pr.ogg"
    # Kate "Проходи, я пока перебинтую ногу. Пришлось научиться самой."
    voice "voice/kate/5day/134 pr.ogg"
    Kate "Праходзь, я пакуль перабінтую нагу. Давялося навучыцца самой."

# game/scripts/scene/scene_day_5.rpy:17530
translate belarusian event_m_katya_devend_14544133:

    # "Она скрылась за дверью ванной, а я вошёл в опрятную комнату."
    "Яна схавалася за дзвярыма ваннай, а я ўвайшоў у ахайны пакой."

# game/scripts/scene/scene_day_5.rpy:17548
translate belarusian event_m_katya_devend_cf193516:

    # "Метель, которая снова завела свою песню снаружи, придавала тёплой спальне дополнительный уют."
    "Мяцеліца, якая зноў завяла сваю песню звонку, надавала цёплай спальні дадатковую ўтульнасць."

# game/scripts/scene/scene_day_5.rpy:17549
translate belarusian event_m_katya_devend_ada0e2d1:

    # "Я вспомнил нашу прежнюю, городскую квартиру. Там пахло выпечкой и звучал родительский смех."
    "Я згадаў нашу ранейшую, гарадскую кватэру. Там пахла выпечкай і гучаў бацькоўскі смех."

# game/scripts/scene/scene_day_5.rpy:17550
translate belarusian event_m_katya_devend_1a4e38af:

    # "И там и тут — я чувствовал себя в безопасности."
    "І там і тут — я адчуваў сябе ў бяспецы."

# game/scripts/scene/scene_day_5.rpy:17578
translate belarusian event_m_katya_lookaround_aqua_1c2eb46a:

    # "Аквариум."
    "Акварыум."

# game/scripts/scene/scene_day_5.rpy:17772
translate belarusian event_m_katya_lookaround_draw_aqua_8cbe77ec:

    # "Рыбки неприхотливы. Идеальный вариант, если часто уезжаешь."
    "Рыбкі непатрабавальныя. Ідэальны варыянт, калі часта з'язджаеш."

# game/scripts/scene/scene_day_5.rpy:17782
translate belarusian event_m_katya_lookaround_draw_aqua_b5bed4cd:

    # "А Катя периодически отсутствовала на уроках, и в посёлке её не встречали несколько дней к ряду."
    "А Каця перыядычна адсутнічала на ўроках, і ў пасёлку яе не сустракалі некалькі дзён запар."

# game/scripts/scene/scene_day_5.rpy:17794
translate belarusian event_m_katya_lookaround_draw_aqua_5cb1a491:

    # voice "voice/Anton/5day/220 M.ogg"
    # Ant "Можно покормить твоих рыбок?"
    voice "voice/Anton/5day/220 M.ogg"
    Ant "Можна пакарміць тваіх рыбак?"

# game/scripts/scene/scene_day_5.rpy:17798
translate belarusian event_m_katya_lookaround_draw_aqua_30584a6b:

    # voice "voice/kate/5day/135 T.ogg"
    # Kate "Только чуть-чуть."
    voice "voice/kate/5day/135 T.ogg"
    Kate "Толькі крышачку."

# game/scripts/scene/scene_day_5.rpy:17800
translate belarusian event_m_katya_lookaround_draw_aqua_239c9ea7:

    # voice "voice/kate/5day/136 E.ogg"
    # Kate "Если корм загниёт, они умрут."
    voice "voice/kate/5day/136 E.ogg"
    Kate "Калі корм загніе, яны памруць."

# game/scripts/scene/scene_day_5.rpy:18034
translate belarusian event_m_katya_lookaround_certif_a85e78f2:

    # "Награды."
    "Узнагароды."

# game/scripts/scene/scene_day_5.rpy:18036
translate belarusian event_m_katya_lookaround_certif_6e531818:

    # "Медали за участие в детских и юношеских соревнованиях по художественной гимнастике."
    "Медалі за ўдзел у дзіцячых і юнацкіх спаборніцтвах па мастацкай гімнастыцы."

# game/scripts/scene/scene_day_5.rpy:18037
translate belarusian event_m_katya_lookaround_certif_ac7e81a6:

    # "А я и не знал, что она юная спортсменка."
    "А я і не ведаў, што яна юная спартсменка."

# game/scripts/scene/scene_day_5.rpy:18038
translate belarusian event_m_katya_lookaround_certif_844b831b:

    # "Катя многого добилась прежде, чем очутиться в Чёрном гараже."
    "Каця шмат чаго дамаглася, перш чым апынуцца ў Чорным гаражы."

# game/scripts/scene/scene_day_5.rpy:18048
translate belarusian event_m_katya_lookaround_dollh_1887a83a:

    # "Домик Барби."
    "Домік Барбі."

# game/scripts/scene/scene_day_5.rpy:18053
translate belarusian event_m_katya_lookaround_dollh_30de6a4e:

    # "Не разбираюсь в куклах, но это точно стоило немалых денег. Мама балует единственную дочь."
    "Не разбіраюся ў ляльках, але гэта дакладна каштавала немалых грошай. Мама песціць адзіную дачку."

# game/scripts/scene/scene_day_5.rpy:18054
translate belarusian event_m_katya_lookaround_dollh_3830cf03:

    # "Только почему пластиковые девушки чаёвничают, а у Кена отвинчена башка?"
    "Толькі чаму пластыкавыя дзяўчаты чаююць, а ў Кена адкручана башка?"

# game/scripts/scene/scene_day_5.rpy:18064
translate belarusian event_m_katya_lookaround_mirror_3d8c065a:

    # "Трельяж."
    "Трэльяж."

# game/scripts/scene/scene_day_5.rpy:18066
translate belarusian event_m_katya_lookaround_mirror_2a5fd420:

    # "Здесь Катя прихорашивается и любуется собой. Косметики больше, чем у моей мамы."
    "Тут Каця прыхарошваецца і любуецца сабой. Касметыкі больш, чым у маёй мамы."

# game/scripts/scene/scene_day_5.rpy:18076
translate belarusian event_m_katya_lookaround_musicb_754856f5:

    # "Магнитофон."
    "Магнітафон."

# game/scripts/scene/scene_day_5.rpy:18080
translate belarusian event_m_katya_lookaround_musicb_43265b63:

    # "Чистокровный японский мафон."
    "Чыстакроўны японскі мафон."

# game/scripts/scene/scene_day_5.rpy:18081
translate belarusian event_m_katya_lookaround_musicb_ce125c3b:

    # "И спортивный инвентарь рядом. Легко представить, как она тренировалась здесь под музыку."
    "І спартыўны інвентар побач. Лёгка ўявіць, як яна трэніравалася тут пад музыку."

# game/scripts/scene/scene_day_5.rpy:18093
translate belarusian event_m_katya_followup_cc0ce762:

    # "Катя с развевающимися лентами приподнялась на носке, грациозно отведя назад другую ногу."
    "Каця са стужкамі, што развяваюцца, прыўзнялася на наску, грацыёзна адвёўшы назад другую нагу."

# game/scripts/scene/scene_day_5.rpy:18094
translate belarusian event_m_katya_followup_9091769b:

    # "Сколько плавности и изящества в её позе!"
    "Колькі плаўнасці і вытанчанасці ў яе позе!"

# game/scripts/scene/scene_day_5.rpy:18095
translate belarusian event_m_katya_followup_99c021f3:

    # "Почему мне так грустно смотреть на эту фотографию?"
    "Чаму мне так сумна глядзець на гэтую фатаграфію?"

# game/scripts/scene/scene_day_5.rpy:18103
translate belarusian event_m_katya_followup_d98f11da:

    # "Я так увлёкся, что не сразу услышал постукивание прорезиненных наконечников костылей."
    "Я так захапіўся, што не адразу пачуў пастукванне прагумаваных наканечнікаў мыліц."

# game/scripts/scene/scene_day_5.rpy:18123
translate belarusian event_m_katya_followup_f6973a12:

    # "Увидел Катю в отражении и обернулся."
    "Убачыў Кацю ў адлюстраванні і азірнуўся."

# game/scripts/scene/scene_day_5.rpy:18124
translate belarusian event_m_katya_followup_e3e9e2c1:

    # voice "voice/kate/5day/137 vz.ogg"
    # "Она провела взглядом по комнате и вздохнула."
    voice "voice/kate/5day/137 vz.ogg"
    "Яна правяла позіркам па пакоі і ўздыхнула."

# game/scripts/scene/scene_day_5.rpy:18144
translate belarusian event_m_katya_followup_c119a55c:

    # voice "voice/kate/5day/138 do.ogg"
    # Kate "До сих пор не верю, что всё это позади."
    voice "voice/kate/5day/138 do.ogg"
    Kate "Дагэтуль не веру, што ўсё гэта ў мінулым."

# game/scripts/scene/scene_day_5.rpy:18148
translate belarusian event_m_katya_followup_5ff89c68:

    # voice "voice/kate/5day/139 mam.ogg"
    # Kate "Мама всю жизнь грезила о спортивной карьере и вбила себе в голову, что я обязана воплотить её мечту."
    voice "voice/kate/5day/139 mam.ogg"
    Kate "Мама ўсё жыццё трызніла спартыўнай кар'ерай і ўбіла сабе ў галаву, што я абавязана ўвасобіць яе мару."

# game/scripts/scene/scene_day_5.rpy:18151
translate belarusian event_m_katya_followup_0592d942:

    # voice "voice/Anton/5day/221 M.ogg"
    # Ant "Мне так жаль."
    voice "voice/Anton/5day/221 M.ogg"
    Ant "Мне так шкада."

# game/scripts/scene/scene_day_5.rpy:18153
translate belarusian event_m_katya_followup_a6669f6f:

    # voice "voice/Anton/5day/222 V.ogg"
    # Ant "Все эти медали, фотки... как ты будешь жить без гимнастики?"
    voice "voice/Anton/5day/222 V.ogg"
    Ant "Усе гэтыя медалі, фоткі... як ты будзеш жыць без гімнастыкі?"

# game/scripts/scene/scene_day_5.rpy:18160
translate belarusian event_m_katya_followup_78230607:

    # voice "voice/kate/5day/140 Us.ogg"
    # Kate "Уж точно не пойду в паралимпийскую сборную."
    voice "voice/kate/5day/140 Us.ogg"
    Kate "Ужо дакладна не пайду ў паралімпійскую зборную."

# game/scripts/scene/scene_day_5.rpy:18164
translate belarusian event_m_katya_followup_b75313c5:

    # "Катя вдруг заулыбалась."
    "Каця раптам заўсміхалася."

# game/scripts/scene/scene_day_5.rpy:18167
translate belarusian event_m_katya_followup_cca7cbb2:

    # voice "voice/kate/5day/141 A.ogg"
    # Kate "Антон, меня тошнило от гимнастики."
    voice "voice/kate/5day/141 A.ogg"
    Kate "Антон, мяне ванітавала ад гімнастыкі."

# game/scripts/scene/scene_day_5.rpy:18171
translate belarusian event_m_katya_followup_532cd4cb:

    # voice "voice/kate/5day/142 Vs.ogg"
    # Kate "Встань так, встань эдак. Что за чушь?"
    voice "voice/kate/5day/142 Vs.ogg"
    Kate "Стань так, стань гэтак. Што за лухта?"

# game/scripts/scene/scene_day_5.rpy:18175
translate belarusian event_m_katya_followup_ff93fb38:

    # voice "voice/kate/5day/143 ed.ogg"
    # Kate "Единственная хорошая вещь, которая случилась за последнее время..."
    voice "voice/kate/5day/143 ed.ogg"
    Kate "Адзіная добрая рэч, якая здарылася за апошні час..."

# game/scripts/scene/scene_day_5.rpy:18179
translate belarusian event_m_katya_followup_2cd64dd8:

    # voice "voice/kate/5day/144 Ya.ogg"
    # Kate "... я не обязана больше мотаться по соревнованиям."
    voice "voice/kate/5day/144 Ya.ogg"
    Kate "... я не абавязана больш цягацца па спаборніцтвах."

# game/scripts/scene/scene_day_5.rpy:18183
translate belarusian event_m_katya_followup_91e8ca92:

    # voice "voice/kate/5day/145 Da.ogg"
    # Kate "Да-да-да!"
    voice "voice/kate/5day/145 Da.ogg"
    Kate "Так-так-так!"

# game/scripts/scene/scene_day_5.rpy:18187
translate belarusian event_m_katya_followup_9a6d10c9:

    # voice "voice/kate/5day/146 te.ogg"
    # Kate "Теперь я делаю то, что мне вздумается!"
    voice "voice/kate/5day/146 te.ogg"
    Kate "Цяпер я раблю тое, што мне заманецца!"

# game/scripts/scene/scene_day_5.rpy:18199
translate belarusian event_m_katya_followup_1f4ee2ae:

    # voice "voice/kate/5day/147 kto.ogg"
    # Kate "Кто пуп земли? Катя пуп земли!"
    voice "voice/kate/5day/147 kto.ogg"
    Kate "Хто пуп зямлі? Каця пуп зямлі!"

# game/scripts/scene/scene_day_5.rpy:18211
translate belarusian event_m_katya_followup_35c8631b:

    # voice "voice/kate/5day/148 ha.ogg"
    # "Она рассмеялась, показывая, что шутит, но в каждой шутке..."
    voice "voice/kate/5day/148 ha.ogg"
    "Яна рассмяялася, паказваючы, што жартуе, але ў кожным жарце..."

# game/scripts/scene/scene_day_5.rpy:18213
translate belarusian event_m_katya_followup_680e36b9:

    # voice "voice/Anton/5day/223 Ch.ogg"
    # Ant "Что-то я не замечал, чтобы тебя в чём-то ограничивали."
    voice "voice/Anton/5day/223 Ch.ogg"
    Ant "Нешта я не заўважаў, каб цябе ў нечым абмяжоўвалі."

# game/scripts/scene/scene_day_5.rpy:18218
translate belarusian event_m_katya_followup_ca6b4de2:

    # voice "voice/kate/5day/149 et.ogg"
    # Kate "Это что, критика? Ты считаешь меня избалованной?"
    voice "voice/kate/5day/149 et.ogg"
    Kate "Гэта што, крытыка? Ты лічыш мяне распешчанай?"

# game/scripts/scene/scene_day_5.rpy:18223
translate belarusian event_m_katya_followup_7b4bb55b:

    # voice "voice/kate/5day/150 h.ogg"
    voice "voice/kate/5day/150 h.ogg"

# game/scripts/scene/scene_day_5.rpy:18226
translate belarusian event_m_katya_followup_6eae585f:

    # "Катя игриво замахнулась костылём."
    "Каця гулліва замахнулася мыліцай."

# game/scripts/scene/scene_day_5.rpy:18230
translate belarusian event_m_katya_followup_a96c4ac5:

    # voice "voice/kate/5day/151p.ogg"
    # Kate "Поговори мне тут, Петров!"
    voice "voice/kate/5day/151p.ogg"
    Kate "Пагавары мне тут, Пятроў!"

# game/scripts/scene/scene_day_5.rpy:18235
translate belarusian event_m_katya_followup_c7036bc6:

    # voice "voice/kate/5day/152 e.ogg"
    # Kate "И вообще, хватит прохлаждаться. Ты поможешь мне с ужином или как?"
    voice "voice/kate/5day/152 e.ogg"
    Kate "І наогул, хопіць прахалоджвацца. Ты дапаможаш мне з вячэрай ці як?"

# game/scripts/scene/scene_day_5.rpy:18239
translate belarusian event_m_katya_followup_bc7d947c:

    # voice "voice/Anton/5day/224 P.ogg"
    # Ant "Попытаюсь!"
    voice "voice/Anton/5day/224 P.ogg"
    Ant "Паспрабую!"

# game/scripts/scene/scene_day_5.rpy:18298
translate belarusian event_m_katya_followup_eb84bdb7:

    # voice "voice/kate/5day/153 oh.ogg"
    # "Катя провела меня на кухню, открыла ящик и замерла, настороженно вглядываясь внутрь."
    voice "voice/kate/5day/153 oh.ogg"
    "Каця правяла мяне на кухню, адкрыла шуфляду і замерла, насцярожана ўглядаючыся ўсярэдзіну."

# game/scripts/scene/scene_day_5.rpy:18300
translate belarusian event_m_katya_followup_deec41a6:

    # voice "voice/Anton/5day/225 Ch.ogg"
    # Ant "Что там, мыши завелись?"
    voice "voice/Anton/5day/225 Ch.ogg"
    Ant "Што там, мышы завяліся?"

# game/scripts/scene/scene_day_5.rpy:18302
translate belarusian event_m_katya_followup_198d95c9:

    # "Она нервно помотала головой."
    "Яна нервова паматала галавой."

# game/scripts/scene/scene_day_5.rpy:18305
translate belarusian event_m_katya_followup_2f26b7de:

    # voice "voice/kate/5day/154 d.ogg"
    # Kate "Достань, пожалуйста."
    voice "voice/kate/5day/154 d.ogg"
    Kate "Дастань, калі ласка."

# game/scripts/scene/scene_day_5.rpy:18315
translate belarusian event_m_katya_followup_c33f1a32:

    # "Я приблизился к ней и тоже посмотрел в ящик..."
    "Я наблізіўся да яе і таксама паглядзеў у шуфляду..."

# game/scripts/scene/scene_day_5.rpy:18320
translate belarusian event_m_katya_followup_c9dfa9d8:

    # "На мясорубку, притаившуюся среди кухонной утвари."
    "На мясарубку, што прытаілася сярод кухоннага начыння."

# game/scripts/scene/scene_day_5.rpy:18321
translate belarusian event_m_katya_followup_c7d6b439:

    # voice "voice/Anton/5day/226 K.ogg"
    # Ant "Конечно..."
    voice "voice/Anton/5day/226 K.ogg"
    Ant "Вядома..."

# game/scripts/scene/scene_day_5.rpy:18344
translate belarusian event_m_katya_followup_aab01929:

    # "Я взял мясорубку, почувствовав холодок под сердцем."
    "Я ўзяў мясарубку, адчуўшы халадок пад сэрцам."

# game/scripts/scene/scene_day_5.rpy:18369
translate belarusian event_m_katya_followup_c2934919:

    # "Поёжился, заметив в раструбе корпуса привинченный к валам нож."
    "Паёжыўся, заўважыўшы ў раструбе корпуса прыкручаны да валоў нож."

# game/scripts/scene/scene_day_5.rpy:18370
translate belarusian event_m_katya_followup_30bf7df7:

    # "Я сказал себе, что допотопная чугунная штуковина не имеет ничего общего с промышленной махиной из Гаража."
    "Я сказаў сабе, што дапатопная чыгунная штуковіна не мае нічога агульнага з прамысловай махінай з Гаража."

# game/scripts/scene/scene_day_5.rpy:18378
translate belarusian event_m_katya_followup_354ef7a9:

    # "Наблюдая за мной, Катя как-то притихла, потускнела."
    "Назіраючы за мной, Каця неяк прыціхла, пацьмянела."

# game/scripts/scene/scene_day_5.rpy:18382
translate belarusian event_m_katya_followup_06cdbdc1:

    # voice "voice/kate/5day/155 ne.ogg"
    # Kate "Не могу заставить себя крутить фарш."
    voice "voice/kate/5day/155 ne.ogg"
    Kate "Не магу прымусіць сябе круціць фарш."

# game/scripts/scene/scene_day_5.rpy:18386
translate belarusian event_m_katya_followup_41d262fd:

    # voice "voice/kate/5day/156pl.ogg"
    # Kate "Плохо становится."
    voice "voice/kate/5day/156pl.ogg"
    Kate "Дрэнна робіцца."

# game/scripts/scene/scene_day_5.rpy:18409
translate belarusian event_m_katya_followup_970ec169:

    # voice "voice/Anton/5day/227 P.ogg"        
    # Ant "Предоставь это мне!"
    voice "voice/Anton/5day/227 P.ogg"        
    Ant "Пакінь гэта мне!"

# game/scripts/scene/scene_day_5.rpy:18414
translate belarusian event_m_katya_followup_152b25df:

    # "Пока я цеплял мясорубку к краю стола, Катя зазвенела посудой, захлопала дверцами холодильника."
    "Пакуль я чапляў мясарубку да краю стала, Каця зазвінела посудам, заляскала дзверцамі халадзільніка."

# game/scripts/scene/scene_day_5.rpy:18421
translate belarusian event_m_katya_followup_1d025f3c:

    # "Она выкладывала в миски мясо, лук и сухари. Взбодрившись, нарезала овощи для салата."
    "Яна выкладала ў міскі мяса, цыбулю і сухары. Падбадзёрыўшыся, нарэзала гародніну для салаты."

# game/scripts/scene/scene_day_5.rpy:18422
translate belarusian event_m_katya_followup_8e8ea047:

    # "Я закинул в мясорубку ингредиенты и взялся за дело."
    "Я закінуў у мясарубку інгрэдыенты і ўзяўся за справу."

# game/scripts/scene/scene_day_5.rpy:18427
translate belarusian event_m_katya_followup_bca8271b:

    # voice "voice/kate/5day/157b.ogg"
    # Kate "Береги пальчики."
    voice "voice/kate/5day/157b.ogg"
    Kate "Беражы пальчыкі."

# game/scripts/scene/scene_day_5.rpy:18445
translate belarusian event_m_katya_followup_c3993aa9:

    # "Винтовой стержень вращался вслед за ручкой, продавливая куски свинины к ножам."
    "Вінтавы стрыжань круціўся следам за ручкай, праціскаючы кавалкі свініны да нажоў."

# game/scripts/scene/scene_day_5.rpy:18449
translate belarusian event_m_katya_followup_bd8174b3:

    # "Готовый фарш валился сквозь решётку."
    "Гатовы фарш валіўся праз рашотку."

# game/scripts/scene/scene_day_5.rpy:18452
translate belarusian event_m_katya_followup_a2ceb183:

    # voice "voice/kate/5day/158tc.ogg"
    # Kate "Тщательнее перемалывай мясо!"
    voice "voice/kate/5day/158tc.ogg"
    Kate "Старанней перамолвай мяса!"

# game/scripts/scene/scene_day_5.rpy:18456
translate belarusian event_m_katya_followup_0a9e457b:

    # voice "voice/kate/5day/159 ne.ogg"
    # Kate "Не бойся, эта мясорубка никогда не сломается!"
    voice "voice/kate/5day/159 ne.ogg"
    Kate "Не бойся, гэтая мясарубка ніколі не зламаецца!"

# game/scripts/scene/scene_day_5.rpy:18497
translate belarusian event_m_katya_followup_b22a0b41:

    # "Я скривился, вспомнив лезвия, окрашенные в человеческую кровь. Катин палец, болтающийся на лоскутке кожи."
    "Я скрывіўся, успомніўшы лёзы, афарбаваныя ў чалавечую кроў. Кацін палец, што боўтаўся на шматочку скуры."

# game/scripts/scene/scene_day_5.rpy:18511
translate belarusian event_m_katya_followup_086d8d39:

    # "Тайком выдавил на язык таблетку и разжевал."
    "Цішком выціснуў на язык таблетку і разжаваў."

# game/scripts/scene/scene_day_5.rpy:18512
translate belarusian event_m_katya_followup_b72a52a3:

    # "Лекарства успокоили, страх спрятался в нору."
    "Лекі супакоілі, страх схаваўся ў нару."

# game/scripts/scene/scene_day_5.rpy:18515
translate belarusian event_m_katya_followup_7c540197:

    # voice "voice/kate/5day/160mi.ogg"
    # Kate "Мы с тобой как странная семейка."
    voice "voice/kate/5day/160mi.ogg"
    Kate "Мы з табой як дзіўная сямейка."

# game/scripts/scene/scene_day_5.rpy:18519
translate belarusian event_m_katya_followup_0df4ac4b:

    # voice "voice/kate/5day/161do.ogg"
    # Kate "Дорогой, что на ужин?"
    voice "voice/kate/5day/161do.ogg"
    Kate "Дарагі, што на вячэру?"

# game/scripts/scene/scene_day_5.rpy:18523
translate belarusian event_m_katya_followup_8ac8e261:

    # "Я поддержал игру."
    "Я падтрымаў гульню."

# game/scripts/scene/scene_day_5.rpy:18524
translate belarusian event_m_katya_followup_d2a9ff30:

    # voice "voice/Anton/5day/228 K.ogg"
    # Ant "Котлетки, дорогая."
    voice "voice/Anton/5day/228 K.ogg"
    Ant "Катлеткі, дарагая."

# game/scripts/scene/scene_day_5.rpy:18528
translate belarusian event_m_katya_followup_f63048ac:

    # voice "voice/kate/5day/162Ah.ogg"
    # Kate "Ах, я ела бы их три раза в день, дорогой."
    voice "voice/kate/5day/162Ah.ogg"
    Kate "Ах, я ела б іх тры разы на дзень, дарагі."

# game/scripts/scene/scene_day_5.rpy:18531
translate belarusian event_m_katya_followup_7751245b:

    # voice "voice/Anton/5day/229 U.ogg"
    # Ant "У меня для тебя хорошая новость. Котлеток хватит до следующей зимы!"
    voice "voice/Anton/5day/229 U.ogg"
    Ant "У мяне для цябе добрая навіна. Катлетак хопіць да наступнай зімы!"

# game/scripts/scene/scene_day_5.rpy:18533
translate belarusian event_m_katya_followup_c06ffd4d:

    # voice "voice/kate/5day/163hah.ogg"
    voice "voice/kate/5day/163hah.ogg"

# game/scripts/scene/scene_day_5.rpy:18549
translate belarusian event_m_katya_followup_99deeed4:

    # "Мы дурачились, и волнения отступали вместе с тошнотворными видениями."
    "Мы дурэлі, і хваляванні адступалі разам з млоснымі відзежамі."

# game/scripts/scene/scene_day_5.rpy:18558
translate belarusian event_m_katya_stove_lose1_22acb9c9:

    # voice "voice/kate/5day/168 ne.ogg"
    # Kate "Не думаю, что они должны быть настолько чёрными."
    voice "voice/kate/5day/168 ne.ogg"
    Kate "Не думаю, што яны павінны быць настолькі чорнымі."

# game/scripts/scene/scene_day_5.rpy:18562
translate belarusian event_m_katya_stove_lose2_91837881:

    # voice "voice/kate/5day/169ot.ogg"
    # Kate "Открой форточку, а то задохнёмся от вони."
    voice "voice/kate/5day/169ot.ogg"
    Kate "Адчыні фортку, а то задыхнёмся ад смуроду."

# game/scripts/scene/scene_day_5.rpy:18566
translate belarusian event_m_katya_stove_lose3_9062e70e:

    # voice "voice/kate/5day/170 m.ogg"
    # Kate "М-да. Говорят, угли помогают при изжоге."
    voice "voice/kate/5day/170 m.ogg"
    Kate "М-да. Кажуць, вуглі дапамагаюць пры пякотцы."

# game/scripts/scene/scene_day_5.rpy:18571
translate belarusian event_m_katya_round1_win_08333f2a:

    # voice "voice/Anton/5day/230 T.ogg"
    # Ant "Ты посмотри, как подрумянилась корочка!"
    voice "voice/Anton/5day/230 T.ogg"
    Ant "Ты паглядзі, як падрумянілася скарыначка!"

# game/scripts/scene/scene_day_5.rpy:18580
translate belarusian event_m_katya_round2_win_d2d632fe:

    # voice "voice/kate/5day/164 z.ogg"
    # Kate "Запах такой, что сейчас даже соседи придут."
    voice "voice/kate/5day/164 z.ogg"
    Kate "Пах такі, што зараз нават суседзі прыйдуць."

# game/scripts/scene/scene_day_5.rpy:18591
translate belarusian event_m_katya_round3_win_81fbdcf8:

    # voice "voice/Anton/5day/231 Pe.ogg"
    # Ant "Первый раз так хорошо получается."
    voice "voice/Anton/5day/231 Pe.ogg"
    Ant "Першы раз так добра атрымліваецца."

# game/scripts/scene/scene_day_5.rpy:18604
translate belarusian event_m_katya_round4_win_7df1ce54:

    # voice "voice/kate/5day/165 p.ogg"
    # Kate "Почти как в ресторане, скажи!"
    voice "voice/kate/5day/165 p.ogg"
    Kate "Амаль як у рэстаране, скажы!"

# game/scripts/scene/scene_day_5.rpy:18617
translate belarusian event_m_katya_round5_win_44baa39a:

    # voice "voice/kate/5day/166v.ogg"
    # Kate "Выходит не хуже, чем у мамы!"
    voice "voice/kate/5day/166v.ogg"
    Kate "Выходзіць не горш, чым у мамы!"

# game/scripts/scene/scene_day_5.rpy:18630
translate belarusian event_m_katya_round6_win_7eaabc17:

    # voice "voice/kate/5day/167e.ogg"
    # Kate "Если это так же хорошо на вкус, как выглядит, придётся выйти за тебя замуж."
    voice "voice/kate/5day/167e.ogg"
    Kate "Калі гэта такое ж добрае на смак, як і выглядае, давядзецца выйсці за цябе замуж."

# game/scripts/scene/scene_day_5.rpy:18659
translate belarusian event_m_katya_skip_game_eaa3d43e:

    # voice "voice/Anton/5day/232 Y.ogg"
    # Ant "Я тот ещё кулинар..."
    voice "voice/Anton/5day/232 Y.ogg"
    Ant "Я той яшчэ кулінар..."

# game/scripts/scene/scene_day_5.rpy:18668
translate belarusian event_m_katya_bad_game_4af02666:

    # voice "voice/Anton/5day/233 P.ogg"
    # Ant "Просто скажи, где у тебя мусорное ведро."
    voice "voice/Anton/5day/233 P.ogg"
    Ant "Проста скажы, дзе ў цябе вядро для смецця."

# game/scripts/scene/scene_day_5.rpy:18670
translate belarusian event_m_katya_bad_game_a16236f1:

    # voice "voice/kate/5day/173p.ogg"
    # Kate "Под мойкой. И глянь заодно, не завалялся ли там противогаз."
    voice "voice/kate/5day/173p.ogg"
    Kate "Пад мыйкай. І глянь заадно, ці не заваляўся там процівагаз."

# game/scripts/scene/scene_day_5.rpy:18672
translate belarusian event_m_katya_bad_game_8e85176d:

    # voice "voice/kate/5day/174 fu.ogg"
    # "Катя принюхалась и сморщила носик."
    voice "voice/kate/5day/174 fu.ogg"
    "Каця прынюхалася і зморшчыла носік."

# game/scripts/scene/scene_day_5.rpy:18686
translate belarusian event_m_katya_bad_game_part2_efff4772:

    # voice "voice/kate/5day/175nu.ogg"
    # Kate "Ну, Петров, не возьмут тебя в программу «Смак»."
    voice "voice/kate/5day/175nu.ogg"
    Kate "Ну, Пятроў, не возьмуць цябе ў праграму «Смак»."

# game/scripts/scene/scene_day_5.rpy:18688
translate belarusian event_m_katya_bad_game_part2_d1bf306d:

    # voice "voice/kate/5day/176dai.ogg"
    # Kate "Дай-ка я сама..."
    voice "voice/kate/5day/176dai.ogg"
    Kate "Дай-тка я сама..."

# game/scripts/scene/scene_day_5.rpy:18700
translate belarusian event_m_katya_bad_game_part2_22c0adcd:

    # voice "voice/kate/5day/177v.ogg"
    # "Она качнулась к печке. Я поймал Катю за талию, помешав упасть."
    voice "voice/kate/5day/177v.ogg"
    "Яна хіснулася да печкі. Я злавіў Кацю за талію, не даўшы ўпасці."

# game/scripts/scene/scene_day_5.rpy:18702
translate belarusian event_m_katya_bad_game_part2_7403cf6f:

    # "И лишь потом покраснел, поняв, каким смелым получился этот жест."
    "І толькі потым пачырванеў, зразумеўшы, якім смелым атрымаўся гэты жэст."

# game/scripts/scene/scene_day_5.rpy:18703
translate belarusian event_m_katya_bad_game_part2_fbd3a385:

    # voice "voice/kate/5day/178de.ogg"
    # Kate "Держи крепче."
    voice "voice/kate/5day/178de.ogg"
    Kate "Трымай мацней."

# game/scripts/scene/scene_day_5.rpy:18720
translate belarusian event_m_katya_good_game_0db0735e:

    # voice "voice/kate/5day/179vd.ogg"
    # "Катя втянула ноздрями аппетитный аромат."
    voice "voice/kate/5day/179vd.ogg"
    "Каця ўцягнула ноздрамі апетытны водар."

# game/scripts/scene/scene_day_5.rpy:18735
translate belarusian event_m_katya_good_game_6e4ca434:

    # voice "voice/kate/5day/180s.ogg"
    # Kate "Слюнки текут!"
    voice "voice/kate/5day/180s.ogg"
    Kate "Слінкі цякуць!"

# game/scripts/scene/scene_day_5.rpy:18739
translate belarusian event_m_katya_good_game_849513da:

    # voice "voice/kate/5day/181da.ogg"
    # Kate "Да такого жениха любая с руками оторвёт."
    voice "voice/kate/5day/181da.ogg"
    Kate "Ды такога жаніха любая з рукамі адарве."

# game/scripts/scene/scene_day_5.rpy:18758
translate belarusian event_m_katya_good_game_ec129c3a:

    # voice "voice/kate/5day/182oh.ogg"
    voice "voice/kate/5day/182oh.ogg"

# game/scripts/scene/scene_day_5.rpy:18761
translate belarusian event_m_katya_good_game_b84e566b:

    # "Катя оступилась и покачнулась над печкой. Мне пришлось поддержать её, обняв за талию."
    "Каця аступілася і пахіснулася над печкай. Мне давялося падтрымаць яе, абняўшы за талію."

# game/scripts/scene/scene_day_5.rpy:18764
translate belarusian event_m_katya_good_game_1b8fc18d:

    # "Лишь потом я покраснел, осознав, каким смелым получился этот жест."
    "Толькі потым я пачырванеў, усвядоміўшы, якім смелым атрымаўся гэты жэст."

# game/scripts/scene/scene_day_5.rpy:18771
translate belarusian event_m_katya_good_game_14758b05:

    # voice "voice/kate/5day/183 ne.ogg"
    # Kate "Нет, руки отрывать не будем. Ты ими меня крепче держи, пока я дегустирую."
    voice "voice/kate/5day/183 ne.ogg"
    Kate "Не, рукі адрываць не будзем. Ты імі мяне мацней трымай, пакуль я дэгустую."

# game/scripts/scene/scene_day_5.rpy:18781
translate belarusian event_m_katya_after_game_52656f70:

    # voice "voice/kate/5day/184 na.ogg"
    # Kate "Наконец-то то, о чём я мечтала, убивая себя тренировками!"
    voice "voice/kate/5day/184 na.ogg"
    Kate "Нарэшце тое, пра што я марыла, забіваючы сябе трэніроўкамі!"

# game/scripts/scene/scene_day_5.rpy:18785
translate belarusian event_m_katya_after_game_1a0f999f:

    # voice "voice/kate/5day/185mo.ogg"
    # Kate "Можно лопать вкусняшки и не думать о дурацких диетах."
    voice "voice/kate/5day/185mo.ogg"
    Kate "Можна ўплятаць смакоцце і не думаць пра дурацкія дыеты."

# game/scripts/scene/scene_day_5.rpy:18792
translate belarusian event_m_katya_after_game_63ed6b57:

    # voice "voice/kate/5day/186m.ogg"
    # Kate "М-м-м! Жареная картошечка с котлетками, да на масле..."
    voice "voice/kate/5day/186m.ogg"
    Kate "М-м-м! Смажаная бульбачка з катлеткамі, ды на масле..."

# game/scripts/scene/scene_day_5.rpy:18796
translate belarusian event_m_katya_after_game_b4f35df4:

    # voice "voice/kate/5day/187h.ogg"
    # Kate "Хочешь кусочек?"
    voice "voice/kate/5day/187h.ogg"
    Kate "Хочаш кавалачак?"

# game/scripts/scene/scene_day_5.rpy:18806
translate belarusian event_m_katya_after_game_8e948e77:

    # "Катя протянула мне насаженную на вилку котлету и маняще улыбнулась."
    "Каця працягнула мне насаджаную на відэлец катлету і вабліва ўсміхнулася."

# game/scripts/scene/scene_day_5.rpy:18818
translate belarusian event_m_katya_after_game_578f66ae:

    # "Я и сам не заметил, как стал есть с её рук, при этом глупо улыбаясь."
    "Я і сам не заўважыў, як стаў есці з яе рук, пры гэтым па-дурному ўсміхаючыся."

# game/scripts/scene/scene_day_5.rpy:18819
translate belarusian event_m_katya_after_game_d57be047:

    # "Котлеты были прекрасны, пышные и нежные."
    "Катлеты былі цудоўныя, пышныя і далікатныя."

# game/scripts/scene/scene_day_5.rpy:18827
translate belarusian event_m_katya_after_game_34fee4e8:

    # "Когда тарелки опустели, я предложил:"
    "Калі талеркі апусцелі, я прапанаваў:"

# game/scripts/scene/scene_day_5.rpy:18828
translate belarusian event_m_katya_after_game_9e107ae9:

    # voice "voice/Anton/5day/235 D.ogg"
    # Ant "Добавки?"
    voice "voice/Anton/5day/235 D.ogg"
    Ant "Дабаўкі?"

# game/scripts/scene/scene_day_5.rpy:18830
translate belarusian event_m_katya_after_game_25323e8a:

    # voice "voice/Anton/5day/236 K.ogg"
    # Ant "Кать, всё хорошо?"
    voice "voice/Anton/5day/236 K.ogg"
    Ant "Каць, усё добра?"

# game/scripts/scene/scene_day_5.rpy:18832
translate belarusian event_m_katya_after_game_2697f4ac:

    # voice "voice/kate/5day/189m.ogg"
    # "Она молчала, тёрла пальцами висок."
    voice "voice/kate/5day/189m.ogg"
    "Яна маўчала, церла пальцамі скронь."

# game/scripts/scene/scene_day_5.rpy:18834
translate belarusian event_m_katya_after_game_a8545aec:

    # voice "voice/Anton/5day/237 Ne.ogg"
    # Ant "Не надо было тебе перетруждаться!"
    voice "voice/Anton/5day/237 Ne.ogg"
    Ant "Не трэба было табе ператамляцца!"

# game/scripts/scene/scene_day_5.rpy:18838
translate belarusian event_m_katya_after_game_50543a18:

    # voice "voice/kate/5day/190p.ogg"
    # Kate "Просто немного..."
    voice "voice/kate/5day/190p.ogg"
    Kate "Проста крыху..."

# game/scripts/scene/scene_day_5.rpy:18841
translate belarusian event_m_katya_after_game_86a14ebd:

    # voice "voice/kate/5day/189st.ogg"
    # "Она втянула воздух сквозь стиснутые зубы."
    voice "voice/kate/5day/189st.ogg"
    "Яна ўцягнула паветра скрозь сцятыя зубы."

# game/scripts/scene/scene_day_5.rpy:18844
translate belarusian event_m_katya_after_game_8f040bf0:

    # voice "voice/kate/5day/191g.ogg"
    # Kate "... голова кружится."
    voice "voice/kate/5day/191g.ogg"
    Kate "... галава кружыцца."

# game/scripts/scene/scene_day_5.rpy:18848
translate belarusian event_m_katya_after_game_3d356733:

    # voice "voice/kate/5day/192 m.ogg"
    # Kate "Можешь проверить, у меня нет температуры?"
    voice "voice/kate/5day/192 m.ogg"
    Kate "Можаш праверыць, ці няма ў мяне тэмпературы?"

# game/scripts/scene/scene_day_5.rpy:18851
translate belarusian event_m_katya_after_game_3e038c37:

    # "Я протянул руку."
    "Я працягнуў руку."

# game/scripts/scene/scene_day_5.rpy:18853
translate belarusian event_m_katya_after_game_16715220:

    # voice "voice/kate/5day/193ne.ogg"
    # Kate "Нет. Попробуй лоб губами. Мама так всегда делает."
    voice "voice/kate/5day/193ne.ogg"
    Kate "Не. Памацай лоб вуснамі. Мама так заўсёды робіць."

# game/scripts/scene/scene_day_5.rpy:18856
translate belarusian event_m_katya_after_game_bcd935cc:

    # "Меня опять посетило неприятное чувство, что Катя играет со мной."
    "Мяне зноў наведала непрыемнае пачуццё, што Каця гуляецца са мной."

# game/scripts/scene/scene_day_5.rpy:18857
translate belarusian event_m_katya_after_game_52f13b6b:

    # voice "voice/Anton/5day/238 A.ogg"
    # Ant "А градусника у тебя нет?"
    voice "voice/Anton/5day/238 A.ogg"
    Ant "А градусніка ў цябе няма?"

# game/scripts/scene/scene_day_5.rpy:18859
translate belarusian event_m_katya_after_game_a4e33af9:

    # voice "voice/Anton/5day/239 Nu.ogg"
    # Ant "Ну ладно..."
    voice "voice/Anton/5day/239 Nu.ogg"
    Ant "Ну добра..."

# game/scripts/scene/scene_day_5.rpy:18883
translate belarusian event_m_katya_after_game_f325af14:

    # "Я наклонился и быстро прикоснулся губами к Катиному лбу."
    "Я нахіліўся і хутка дакрануўся вуснамі да Кацінага лба."

# game/scripts/scene/scene_day_5.rpy:18884
translate belarusian event_m_katya_after_game_4090cd59:

    # voice "voice/Anton/5day/240 Vr.ogg"
    # Ant "Вроде не горячий."
    voice "voice/Anton/5day/240 Vr.ogg"
    Ant "Нібыта не гарачы."

# game/scripts/scene/scene_day_5.rpy:18905
translate belarusian event_m_katya_after_game_3f7d9c54:

    # voice "voice/kate/5day/194do.ogg"
    # Kate "Доведи до постели, пожалуйста."
    voice "voice/kate/5day/194do.ogg"
    Kate "Давядзі да пасцелі, калі ласка."

# game/scripts/scene/scene_day_5.rpy:18937
translate belarusian event_m_katya_after_game_454e7dc8:

    # "Я помог Кате добраться до спальни, и она забралась под одеяло."
    "Я дапамог Каці дабрацца да спальні, і яна забралася пад коўдру."

# game/scripts/scene/scene_day_5.rpy:18938
translate belarusian event_m_katya_after_game_3c1a21d9:

    # voice "voice/kate/5day/195po.ogg"
    # Kate "Полежи со мной."
    voice "voice/kate/5day/195po.ogg"
    Kate "Паляжы са мной."

# game/scripts/scene/scene_day_5.rpy:18940
translate belarusian event_m_katya_after_game_422494aa:

    # "Я окончательно смутился."
    "Я канчаткова збянтэжыўся."

# game/scripts/scene/scene_day_5.rpy:18941
translate belarusian event_m_katya_after_game_8c0478da:

    # voice "voice/Anton/5day/241 E.ogg"
    # Ant "Это как-то... как-то чересчур..."
    voice "voice/Anton/5day/241 E.ogg"
    Ant "Гэта неяк... неяк занадта..."

# game/scripts/scene/scene_day_5.rpy:18943
translate belarusian event_m_katya_after_game_22c5c306:

    # voice "voice/kate/5day/196ch.ogg"
    # Kate "Чересчур — составить подружке компанию?"
    voice "voice/kate/5day/196ch.ogg"
    Kate "Занадта — скласці сяброўцы кампанію?"

# game/scripts/scene/scene_day_5.rpy:18945
translate belarusian event_m_katya_after_game_d07a1f2b:

    # voice "voice/kate/5day/197m.ogg"
    # Kate "Мама скоро вернётся и заменит тебя. Полежи, пока я не усну."
    voice "voice/kate/5day/197m.ogg"
    Kate "Мама хутка вернецца і заменіць цябе. Паляжы, пакуль я не засну."

# game/scripts/scene/scene_day_5.rpy:18954
translate belarusian event_m_katya_after_game_0b74f271:

    # "В её взгляде сквозила мольба. Я кивнул и устроился рядом."
    "У яе позірку праступала мальба. Я кіўнуў і ўладкаваўся побач."

# game/scripts/scene/scene_day_5.rpy:18963
translate belarusian event_m_katya_after_game_2e6231b7:

    # "Катя щёлкнула выключателем, и свет погас."
    "Каця пстрыкнула выключальнікам, і святло пагасла."

# game/scripts/scene/scene_day_5.rpy:18964
translate belarusian event_m_katya_after_game_763d68f8:

    # "Мы лежали в темноте, слушая вой ветра."
    "Мы ляжалі ў цемры, слухаючы выццё ветру."

# game/scripts/scene/scene_day_5.rpy:18998
translate belarusian event_m_katya_after_game_7b815e93:

    # "Катин палец мазнул по моему запястью. Наши мизинцы сплелись."
    "Кацін палец мазнуў па маім запясці. Нашы мезенцы спляліся."

# game/scripts/scene/scene_day_5.rpy:18999
translate belarusian event_m_katya_after_game_f18d4b13:

    # "Не нужно было ничего говорить, но Катя сказала:"
    "Не трэба было нічога казаць, але Каця сказала:"

# game/scripts/scene/scene_day_5.rpy:19000
translate belarusian event_m_katya_after_game_1fd310d8:

    # voice "voice/kate/5day/199t.ogg"
    # Kate "Ты мне правда очень, очень нравишься."
    voice "voice/kate/5day/199t.ogg"
    Kate "Ты мне праўда вельмі, вельмі падабаешся."

# game/scripts/scene/scene_day_5.rpy:19002
translate belarusian event_m_katya_after_game_7e1cc2ff:

    # voice "voice/kate/5day/200s.ogg"
    # Kate "Скажи, если это взаимно."
    voice "voice/kate/5day/200s.ogg"
    Kate "Скажы, калі гэта ўзаемна."

# game/scripts/scene/scene_day_5.rpy:19004
translate belarusian event_m_katya_after_game_d6209e36:

    # "Я облизал внезапно пересохшие губы."
    "Я аблізаў раптоўна перасохлыя вусны."

# game/scripts/scene/scene_day_5.rpy:19010
translate belarusian event_m_katya_after_game_e012e6c6:

    # voice "voice/olya/5day/15 Anto.ogg"
    # Oly "Антон..."
    voice "voice/olya/5day/15 Anto.ogg"
    Oly "Антон..."

# game/scripts/scene/scene_day_5.rpy:19013
translate belarusian event_m_katya_after_game_2d1a4e56:

    # "Голос донёсся из угла."
    "Голас данёсся з кута."

# game/scripts/scene/scene_day_5.rpy:19032
translate belarusian event_m_katya_after_game_4d02d425:

    # "Я обернулся, изумлённый."
    "Я азірнуўся, здзіўлены."

# game/scripts/scene/scene_day_5.rpy:19034
translate belarusian event_m_katya_after_game_6744b33d:

    # "Во тьме угадывались очертания ребёнка, крошечного призрака, пришедшего по мою душу."
    "У цемры ўгадваліся абрысы дзіцяці, малюсенькага прывіда, што прыйшоў па маю душу."

# game/scripts/scene/scene_day_5.rpy:19035
translate belarusian event_m_katya_after_game_d58dae10:

    # voice "voice/Anton/5day/242 K.ogg"
    # Ant "Кать..."
    voice "voice/Anton/5day/242 K.ogg"
    Ant "Каць..."

# game/scripts/scene/scene_day_5.rpy:19037
translate belarusian event_m_katya_after_game_35003d86:

    # voice "voice/kate/5day/201da.ogg"
    # Kate "Да?"
    voice "voice/kate/5day/201da.ogg"
    Kate "Так?"

# game/scripts/scene/scene_day_5.rpy:19039
translate belarusian event_m_katya_after_game_eacdd63d:

    # voice "voice/Anton/5day/243 T.ogg"
    # Ant "Там кто-то есть."
    voice "voice/Anton/5day/243 T.ogg"
    Ant "Там нехта ёсць."

# game/scripts/scene/scene_day_5.rpy:19041
translate belarusian event_m_katya_after_game_6d7b867f:

    # voice "voice/kate/5day/202eto.ogg"
    # Kate "Это лишь тень от моих наград, глупый."
    voice "voice/kate/5day/202eto.ogg"
    Kate "Гэта толькі цень ад маіх узнагарод, дурненькі."

# game/scripts/scene/scene_day_5.rpy:19043
translate belarusian event_m_katya_after_game_ca3477ee:

    # voice "voice/olya/5day/16 An.ogg"
    # Oly "Антон, проснись, пожалуйста."
    voice "voice/olya/5day/16 An.ogg"
    Oly "Антон, прачніся, калі ласка."

# game/scripts/scene/scene_day_5.rpy:19064
translate belarusian event_m_katya_after_game_34a4b3d8:

    # "Я отвернулся от фигуры ребёнка, и мой мизинец крепче сжал мизинец Кати."
    "Я адвярнуўся ад постаці дзіцяці, і мой мезенец мацней сціснуў мезенец Каці."

# game/scripts/scene/scene_day_5.rpy:19065
translate belarusian event_m_katya_after_game_22c18bf4:

    # voice "voice/Anton/5day/244 K.ogg"
    # Ant "Кать, я хочу признаться."
    voice "voice/Anton/5day/244 K.ogg"
    Ant "Каць, я хачу прызнацца."

# game/scripts/scene/scene_day_5.rpy:19067
translate belarusian event_m_katya_after_game_d6ca3063:

    # voice "voice/kate/5day/203ya.ogg"
    # Kate "Я не нравлюсь тебе?"
    voice "voice/kate/5day/203ya.ogg"
    Kate "Я не падабаюся табе?"

# game/scripts/scene/scene_day_5.rpy:19069
translate belarusian event_m_katya_after_game_b8de2148:

    # voice "voice/Anton/5day/245 De.ogg"
    # Ant "Дело не в этом. Иногда у меня бывают галлюцинации."
    voice "voice/Anton/5day/245 De.ogg"
    Ant "Справа не ў гэтым. Часам у мяне бываюць галюцынацыі."

# game/scripts/scene/scene_day_5.rpy:19071
translate belarusian event_m_katya_after_game_a4ad14f1:

    # voice "voice/Anton/5day/246 D.ogg"
    # Ant "Доктор говорит, я вырасту, и это пройдёт. Я принимаю лекарства."
    voice "voice/Anton/5day/246 D.ogg"
    Ant "Доктар кажа, я вырасту, і гэта пройдзе. Я прымаю лекі."

# game/scripts/scene/scene_day_5.rpy:19073
translate belarusian event_m_katya_after_game_28b55925:

    # voice "voice/kate/5day/204ti.ogg"
    # Kate "Ты меня этим не напугаешь. Забыл?"
    voice "voice/kate/5day/204ti.ogg"
    Kate "Ты мяне гэтым не напалохаеш. Забыўся?"

# game/scripts/scene/scene_day_5.rpy:19075
translate belarusian event_m_katya_after_game_b42997a4:

    # voice "voice/kate/5day/205m.ogg"
    # Kate "Мой так называемый папашка — психиатр."
    voice "voice/kate/5day/205m.ogg"
    Kate "Мой так званы баця — псіхіятр."

# game/scripts/scene/scene_day_5.rpy:19077
translate belarusian event_m_katya_after_game_fc4178ab:

    # voice "voice/kate/5day/206v.ogg"
    # Kate "Выпей таблетку, и всё будет нормально."
    voice "voice/kate/5day/206v.ogg"
    Kate "Выпі таблетку, і ўсё будзе нармальна."

# game/scripts/scene/scene_day_5.rpy:19079
translate belarusian event_m_katya_after_game_459a277d:

    # voice "voice/kate/5day/207da.ogg"
    # Kate "Да-да-да!"
    voice "voice/kate/5day/207da.ogg"
    Kate "Так-так-так!"

# game/scripts/scene/scene_day_5.rpy:19086
translate belarusian event_m_katya_after_game_ca4b5b4b:

    # voice "voice/olya/5day/17 Ant.ogg"
    # Oly "Антон, услышь меня!"
    voice "voice/olya/5day/17 Ant.ogg"
    Oly "Антон, пачуй мяне!"

# game/scripts/scene/scene_day_5.rpy:19123
translate belarusian event_m_katya_after_game_afterdev_e7bca60f:

    # "Я вынул из кармана пилюли."
    "Я выняў з кішэні пілюлі."

# game/scripts/scene/scene_day_5.rpy:19223
translate belarusian event_m_katya_accept_4ce077f5:

    # "Я разжевал таблетку и зажмурился, слушая шум метели и дыхание Кати..."
    "Я разжаваў таблетку і зажмурыўся, слухаючы шум завірухі і дыханне Каці..."

# game/scripts/scene/scene_day_5.rpy:19229
translate belarusian event_m_katya_accept_767a3b47:

    # "... но не плач вымышленного ребёнка."
    "... але не плач выдуманага дзіцяці."

# game/scripts/scene/scene_day_5.rpy:19230
translate belarusian event_m_katya_accept_b45b2a34:

    # "Меня бросало в жар."
    "Мяне кідала ў жар."

# game/scripts/scene/scene_day_5.rpy:19242
translate belarusian event_m_katya_accept_9b0f0dd1:

    # "Я почувствовал губы Кати на лбу, а потом — её ладонь, заботливо гладящую меня по щеке."
    "Я адчуў вусны Каці на лбе, а потым — яе далонь, што клапатліва гладзіла мяне па шчацэ."

# game/scripts/scene/scene_day_5.rpy:19243
translate belarusian event_m_katya_accept_b11f39f4:

    # voice "voice/kate/5day/208sp.ogg"
    # Kate "Спи, тебе станет лучше."
    voice "voice/kate/5day/208sp.ogg"
    Kate "Спі, табе стане лепш."

# game/scripts/scene/scene_day_5.rpy:19249
translate belarusian event_m_katya_accept_b8e6e3b0:

    # "Я позволил тёплой волне подхватить меня."
    "Я дазволіў цёплай хвалі падхапіць мяне."

# game/scripts/scene/scene_day_5.rpy:19253
translate belarusian event_m_katya_accept_31495008:

    # voice "voice/kate/5day/209z.ogg"
    # Kate "Засыпай, мама позвонит твоим родителям."
    voice "voice/kate/5day/209z.ogg"
    Kate "Засынай, мама патэлефануе тваім бацькам."

# game/scripts/scene/scene_day_5.rpy:19263
translate belarusian event_m_katya_accept_5f000982:

    # "Я проваливался в пустоту..."
    "Я правальваўся ў пустэчу..."

# game/scripts/scene/scene_day_5.rpy:19264
translate belarusian event_m_katya_accept_566df08a:

    # voice "voice/kate/5day/210s.ogg"
    # Kate "Спи, я с тобой..."
    voice "voice/kate/5day/210s.ogg"
    Kate "Спі, я з табой..."

# game/scripts/scene/scene_day_5.rpy:19266
translate belarusian event_m_katya_accept_2bad8766:

    # voice "voice/kate/5day/210 sp.ogg"
    # Kate "Спи..."
    voice "voice/kate/5day/210 sp.ogg"
    Kate "Спі..."

# game/scripts/scene/scene_day_5.rpy:19281
translate belarusian event_m_katya_refuse_2ddcf4ae:

    # voice "voice/Anton/5day/247 Ya.ogg"
    # Ant "Я и так принял их слишком много."
    voice "voice/Anton/5day/247 Ya.ogg"
    Ant "Я і так прыняў іх занадта шмат."

# game/scripts/scene/scene_day_5.rpy:19317
translate belarusian event_m_katya_refuse_464d296c:

    # voice "voice/Anton/5day/248 H.ogg"
    # Ant "Хватит. Не хочу умереть от передозировки."
    voice "voice/Anton/5day/248 H.ogg"
    Ant "Хопіць. Не хачу памерці ад перадазіроўкі."

# game/scripts/scene/scene_day_5.rpy:19337
translate belarusian event_m_katya_refuse_2e5af574:

    # voice "voice/Anton/5day/249 Ka.ogg"
    # Ant "Кать?"
    voice "voice/Anton/5day/249 Ka.ogg"
    Ant "Каць?"

# game/scripts/scene/scene_day_5.rpy:19342
translate belarusian event_m_katya_refuse_4b7c2d9e:

    # voice "voice/kate/5day/211hn.ogg"
    # "Под боком я услышал сдавленные рыдания."
    voice "voice/kate/5day/211hn.ogg"
    "Пад бокам я пачуў здаўленыя рыданні."

# game/scripts/scene/scene_day_5.rpy:19344
translate belarusian event_m_katya_refuse_8e37a14b:

    # voice "voice/Anton/5day/250 K.ogg"
    # Ant "Катюш, что случилось?"
    voice "voice/Anton/5day/250 K.ogg"
    Ant "Кацюш, што здарылася?"

# game/scripts/scene/scene_day_5.rpy:19349
translate belarusian event_m_katya_refuse_d1c18d5e:

    # "В непроглядной темноте комнаты что-то тихонько причмокнуло."
    "У непрагляднай цемры пакоя нешта ціхенька прыцмокнула."

# game/scripts/scene/scene_day_5.rpy:19353
translate belarusian event_m_katya_refuse_d0e91a19:

    # "Звук отрывающегося от кожи лейкопластыря."
    "Гук лейкапластыру, што адрываецца ад скуры."

# game/scripts/scene/scene_day_5.rpy:19363
translate belarusian event_m_katya_refuse_e2755dbd:

    # "Я почувствовал, как стремительно сыреет и напитывается липкой влагой мой носок."
    "Я адчуў, як імкліва сырэе і насычаецца ліпкай вільгаццю мая шкарпэтка."

# game/scripts/scene/scene_day_5.rpy:19364
translate belarusian event_m_katya_refuse_2a7c2b73:

    # "Моя задрожавшая рука нащупала выключатель."
    "Мая дрыготкая рука намацала выключальнік."

# game/scripts/scene/scene_day_5.rpy:19374
translate belarusian event_m_katya_refuse_ba2621d8:

    # "Свет вспыхнул. Красные пятна расползались по одеялу."
    "Святло ўспыхнула. Чырвоныя плямы распаўзаліся па коўдры."

# game/scripts/scene/scene_day_5.rpy:19380
translate belarusian event_m_katya_refuse_3c25a380:

    # "Я отшатнулся к стене."
    "Я адхіснуўся да сцяны."

# game/scripts/scene/scene_day_5.rpy:19385
translate belarusian event_m_katya_refuse_c7c9c516:

    # voice "voice/Anton/5day/251 Ka.ogg"
    # Ant "Кать, у тебя рана открылась!"
    voice "voice/Anton/5day/251 Ka.ogg"
    Ant "Каць, у цябе рана адкрылася!"

# game/scripts/scene/scene_day_5.rpy:19395
translate belarusian event_m_katya_refuse_72c18cf2:

    # "В панике я сдёрнул одеяло."
    "У паніцы я сарваў коўдру."

# game/scripts/scene/scene_day_5.rpy:19396
translate belarusian event_m_katya_refuse_43db9a03:

    # "Я готов был увидеть пропитавшиеся кровью бинты. Но не то, что увидел на самом деле."
    "Я гатовы быў убачыць прасякнутыя крывёю бінты. Але не тое, што ўбачыў насамрэч."

# game/scripts/scene/scene_day_5.rpy:19397
translate belarusian event_m_katya_refuse_318412cc:

    # "Ниже колена нога Кати отсутствовала."
    "Ніжэй за калена нага Каці адсутнічала."

# game/scripts/scene/scene_day_5.rpy:19404
translate belarusian event_m_katya_refuse_41b3a2f7:

    # "В алой луже копошились жирные грязные крысы."
    "У пунсовай лужыне капашыліся тлустыя брудныя пацукі."

# game/scripts/scene/scene_day_5.rpy:19408
translate belarusian event_m_katya_refuse_7c511a23:

    # "Они жрали Катю, утопив жадные мордочки в пузырящемся мясе обрубка."
    "Яны жэрлі Кацю, утапіўшы прагныя пыскі ў мясе абрубка, што пухірылася."

# game/scripts/scene/scene_day_5.rpy:19413
translate belarusian event_m_katya_refuse_3036fd95:

    # "Самая здоровенная крыса пыталась сосать костный мозг из осколка, белеющего в месиве."
    "Самы здаравенны пацук спрабаваў смактаць касцявы мозг з аскепка, што бялеў у месіве."

# game/scripts/scene/scene_day_5.rpy:19422
translate belarusian event_m_katya_refuse_3b769688:

    # voice "voice/kate/5day/212A.ogg"
    # "Катя завизжала."
    voice "voice/kate/5day/212A.ogg"
    "Каця завішчала."

# game/scripts/scene/scene_day_5.rpy:19453
translate belarusian event_m_katya_refuse_b8a9f644:

    # voice "voice/kate/5day/212 A.ogg"
    # "Катя резко села и повернула в мою сторону бледное лицо. Под кожей вздулись вены, зрачки закатились."
    voice "voice/kate/5day/212 A.ogg"
    "Каця рэзка села і павярнула ў мой бок бледны твар. Пад скурай уздуліся вены, зрэнкі закаціліся."

# game/scripts/scene/scene_day_5.rpy:19481
translate belarusian event_m_katya_refuse_0509b520:

    # voice "voice/kate/5day/213 ti.ogg"
    # Kate "Ты!!!"
    voice "voice/kate/5day/213 ti.ogg"
    Kate "Ты!!!"

# game/scripts/scene/scene_day_5.rpy:19486
translate belarusian event_m_katya_refuse_36fd4860:

    # "Она рычала, комкая простыни."
    "Яна гарчала, камячачы прасціны."

# game/scripts/scene/scene_day_5.rpy:19487
translate belarusian event_m_katya_refuse_8d0b31df:

    # voice "voice/kate/5day/214et.ogg"
    # Kate "Это ты виноват!"
    voice "voice/kate/5day/214et.ogg"
    Kate "Гэта ты вінаваты!"

# game/scripts/scene/scene_day_5.rpy:19532
translate belarusian event_m_katya_refuse_715a3a14:

    # "Катя дёрнулась, и до меня дошло, что происходит."
    "Каця тузанулася, і да мяне дайшло, што адбываецца."

# game/scripts/scene/scene_day_5.rpy:19533
translate belarusian event_m_katya_refuse_a29fe50e:

    # "Её тело проваливалось между половинками дивана."
    "Яе цела правальвалася між палоўкамі канапы."

# game/scripts/scene/scene_day_5.rpy:19534
translate belarusian event_m_katya_refuse_7d27515f:

    # "Откуда-то из бельевого отсека, из недр мебели донёсся рёв мотора."
    "Аднекуль з бялізнавага адсека, з нетраў мэблі данёсся роў матора."

# game/scripts/scene/scene_day_5.rpy:19536
translate belarusian event_m_katya_refuse_6a929d2f:

    # voice "voice/kate/5day/215ku.ogg"
    # Kate "Куда ты собрался?!"
    voice "voice/kate/5day/215ku.ogg"
    Kate "Куды ты сабраўся?!"

# game/scripts/scene/scene_day_5.rpy:19538
translate belarusian event_m_katya_refuse_a06b2d3d:

    # "Ненависть и боль исказили до неузнаваемости Катино лицо."
    "Нянавісць і боль сказілі да непазнавальнасці Кацін твар."

# game/scripts/scene/scene_day_5.rpy:19598
translate belarusian event_m_katya_refuse_4fcd5d2d:

    # "Створки дивана приподнялись, ножки оторвались от пола."
    "Створкі канапы прыўзняліся, ножкі адарваліся ад падлогі."

# game/scripts/scene/scene_day_5.rpy:19599
translate belarusian event_m_katya_refuse_7d6888f3:

    # voice "voice/kate/5day/216ni.ogg"
    # Kate "Никто тебя не ждёт!"
    voice "voice/kate/5day/216ni.ogg"
    Kate "Ніхто цябе не чакае!"

# game/scripts/scene/scene_day_5.rpy:19601
translate belarusian event_m_katya_refuse_be0fd65c:

    # voice "voice/kate/5day/217 ti.ogg"
    # Kate "Ты слабый и гадкий, ты никому не нужен!"
    voice "voice/kate/5day/217 ti.ogg"
    Kate "Ты слабы і брыдкі, ты нікому не патрэбны!"

# game/scripts/scene/scene_day_5.rpy:19604
translate belarusian event_m_katya_refuse_13f56563:

    # voice "voice/kate/5day/220ou.ogg"
    # "Вместе со словами изо рта Кати полилась чёрная кровь."
    voice "voice/kate/5day/220ou.ogg"
    "Разам са словамі з рота Каці палілася чорная кроў."

# game/scripts/scene/scene_day_5.rpy:19606
translate belarusian event_m_katya_refuse_1eac2aa5:

    # "Дёргаясь, как тряпичная кукла, Катя погружалась в мясорубку."
    "Тузаючыся, як анучная лялька, Каця пагружалася ў мясарубку."

# game/scripts/scene/scene_day_5.rpy:19607
translate belarusian event_m_katya_refuse_d4bbc5d1:

    # voice "voice/kate/5day/220ou2.ogg"
    # "Я слышал хруст костей и приглушённый плач ребёнка."
    voice "voice/kate/5day/220ou2.ogg"
    "Я чуў хруст касцей і прыглушаны плач дзіцяці."

# game/scripts/scene/scene_day_5.rpy:19617
translate belarusian event_m_katya_refuse_cbf6de13:

    # voice "voice/olya/5day/18 Pr.ogg"
    # Oly "Приди в себя! Очнись!"
    voice "voice/olya/5day/18 Pr.ogg"
    Oly "Прыйдзі ў сябе! Апрытомней!"

# game/scripts/scene/scene_day_5.rpy:19620
translate belarusian event_m_katya_refuse_bf09f1d6:

    # voice "voice/kate/5day/220ou3.ogg"
    # "Диван проглотил Катю по пояс. Она барахталась, изрыгая кровь и проклятия."
    voice "voice/kate/5day/220ou3.ogg"
    "Канапа праглынула Кацю па пояс. Яна борсалася, вывяргаючы кроў і праклёны."

# game/scripts/scene/scene_day_5.rpy:19623
translate belarusian event_m_katya_refuse_60c0556b:

    # voice "voice/kate/5day/221ne.ogg"
    # Kate "Не отворачивайся! Смотри, что ты наделал, слабак!"
    voice "voice/kate/5day/221ne.ogg"
    Kate "Не адварочвайся! Глядзі, што ты нарабіў, слабак!"

# game/scripts/scene/scene_day_5.rpy:19628
translate belarusian event_m_katya_refuse_be576032:

    # voice "voice/Anton/5day/252 Vzz.ogg"
    voice "voice/Anton/5day/252 Vzz.ogg"

# game/scripts/scene/scene_day_5.rpy:19630
translate belarusian event_m_katya_refuse_ebed5c77:

    # "Фонтан крови ударил в потолок и мне в лицо."
    "Фантан крыві ўдарыў у столь і мне ў твар."

# game/scripts/scene/scene_day_5.rpy:19631
translate belarusian event_m_katya_refuse_9dc99ac1:

    # "Мебель таяла, с дивана слезала обшивка, обнажая чугунные бока."
    "Мэбля раставала, з канапы злазіла абшыўка, агаляючы чыгунныя бакі."

# game/scripts/scene/scene_day_5.rpy:19683
translate belarusian event_m_katya_refuse_781fbe9d:

    # "Под обоями проступали металлические стены. Спальня превращалась в Чёрный гараж."
    "Пад шпалерамі праступалі металічныя сцены. Спальня ператваралася ў Чорны гараж."

# game/scripts/scene/scene_day_5.rpy:19684
translate belarusian event_m_katya_refuse_c31dfcc6:

    # "Я не сбежал из него. Я никогда его не покину."
    "Я не ўцёк з яго. Я ніколі яго не пакіну."

# game/scripts/scene/scene_day_5.rpy:19698
translate belarusian event_m_katya_refuse_805edf10:

    # "Мясорубка полностью проглотила Катю. На поддон внизу хлынуло перемолотое мясо."
    "Мясарубка цалкам праглынула Кацю. На паддон унізе хлынула перамолатае мяса."

# game/scripts/scene/scene_day_5.rpy:19718
translate belarusian event_m_katya_refuse_4a996bb6:

    # "Из юшки всплыло содранное с костей лицо."
    "З юшкі ўсплыў садраны з касцей твар."

# game/scripts/scene/scene_day_5.rpy:19719
translate belarusian event_m_katya_refuse_58df46a0:

    # "Побелевшие губы шевельнулись. Останки Кати обратились ко мне:"
    "Пабялелыя вусны варухнуліся. Парэшткі Каці звярнуліся да мяне:"

# game/scripts/scene/scene_day_5.rpy:19721
translate belarusian event_m_katya_refuse_d403f961:

    # voice "voice/kate/5day/222 t.ogg"
    # Kate "Ты обречён! Ни в одной из вселенных ты не сможешь меня спасти, ничтожество!"
    voice "voice/kate/5day/222 t.ogg"
    Kate "Ты асуджаны! Ні ў адным з сусветаў ты не зможаш мяне выратаваць, нікчэмнасць!"

# game/scripts/scene/scene_day_5.rpy:19756
translate belarusian event_m_katya_refuse_43fa3cab:

    # "Крича, я бросился прочь от этого кошмара."
    "Крычучы, я кінуўся прэч ад гэтага кашмару."

# game/scripts/scene/scene_day_5.rpy:19757
translate belarusian event_m_katya_refuse_8846a894:

    # "Ветер выл в открытые двери."
    "Вецер выў у адчыненыя дзверы."

# game/scripts/scene/scene_day_5.rpy:19772
translate belarusian event_m_katya_refuse_6d6547df:

    # "На пороге возвышался великан с громоздкой головой, увенчанной длинными ушами."
    "На парозе ўзвышаўся волат з грувасткай галавой, увянчанай доўгімі вушамі."

# game/scripts/scene/scene_day_5.rpy:19788
translate belarusian event_m_katya_refuse_4aa60575:

    # "И оскалом, напоминающим гноящийся шрам."
    "І выскалам, што нагадваў гнаісты шнар."

# game/scripts/scene/scene_day_5.rpy:19799
translate belarusian event_m_katya_refuse_0fa3eb2c:

    # voice "voice/bunny/13 Ez.ogg"
    # Bunny "Из-за таких, как ты, мы изгои!"
    voice "voice/bunny/13 Ez.ogg"
    Bunny "Праз такіх, як ты, мы ізгоі!"

# game/scripts/scene/scene_day_5.rpy:19801
translate belarusian event_m_katya_refuse_11f6ad30:

    # voice "voice/bunny/14 Vs.ogg"
    # Bunny "Вся стая уже укусила луну..."
    voice "voice/bunny/14 Vs.ogg"
    Bunny "Уся зграя ўжо ўкусіла месяц..."

# game/scripts/scene/scene_day_5.rpy:19821
translate belarusian event_m_katya_refuse_7f3458cb:

    # voice "voice/bunny/15 As.ogg"
    # Bunny "А с тобой приходится цацкаться!"
    voice "voice/bunny/15 As.ogg"
    Bunny "А з табой даводзіцца цацкацца!"

# game/scripts/scene/scene_day_5.rpy:19829
translate belarusian event_m_katya_refuse_1837a01b:

    # voice "voice/bunny/16Tv .ogg"
    # Bunny "Твоё мясо растворится в желудочных соках."
    voice "voice/bunny/16Tv .ogg"
    Bunny "Тваё мяса растворыцца ў страўнікавых соках."

# game/scripts/scene/scene_day_5.rpy:19837
translate belarusian event_m_katya_refuse_dc3e1303:

    # voice "voice/bunny/17Tv.ogg"
    # Bunny "Твоя душа достанется лесу."
    voice "voice/bunny/17Tv.ogg"
    Bunny "Твая душа дастанецца лесу."

# game/scripts/scene/scene_day_5.rpy:19845
translate belarusian event_m_katya_refuse_f23bc9d5:

    # voice "voice/bunny/18 Tv.ogg"
    # Bunny "Твоё имя забудут."
    voice "voice/bunny/18 Tv.ogg"
    Bunny "Тваё імя забудуць."

# game/scripts/scene/scene_day_5.rpy:19852
translate belarusian event_m_katya_refuse_a1d80300:

    # voice "voice/Anton/5day/252 Vz.ogg"
    # "Холодные руки чудовища легли на мои плечи. Когти впились в мышцы."
    voice "voice/Anton/5day/252 Vz.ogg"
    "Халодныя рукі пачвары леглі на мае плечы. Кіпцюры ўпіліся ў цягліцы."

# game/scripts/scene/scene_day_5.rpy:19898
translate belarusian event_m_katya_refuse_104a02dd:

    # "Гигант оторвал меня от пола и сунул головой в раструб."
    "Гігант адарваў мяне ад падлогі і сунуў галавой у раструб."

# game/scripts/scene/scene_day_5.rpy:19924
translate belarusian event_m_katya_refuse_38822dcb:

    # voice "voice/kate/5day/223tc.ogg"
    # Kate "Тщательнее перемалывай мясо!"
    voice "voice/kate/5day/223tc.ogg"
    Kate "Старанней перамолвай мяса!"

# game/scripts/scene/scene_day_5.rpy:19926
translate belarusian event_m_katya_refuse_da88a3d8:

    # voice "voice/kate/5day/224 ne.ogg"
    # Kate "Не бойся, эта мясорубка никогда не сломается!"
    voice "voice/kate/5day/224 ne.ogg"
    Kate "Не бойся, гэтая мясарубка ніколі не зламаецца!"

# game/scripts/scene/scene_day_5.rpy:19995
translate belarusian event_m_katya_refuse_36d3d831:

    # "Мои руки были вытянуты вперёд, и они первыми угодили меж лезвий."
    "Мае рукі былі выцягнуты наперад, і яны першымі трапілі між лёзаў."

# game/scripts/scene/scene_day_5.rpy:20006
translate belarusian event_m_katya_refuse_5e6cb425:

    # voice "voice/kate/5day/225be.ogg"
    # Kate "Береги пальчики!"
    voice "voice/kate/5day/225be.ogg"
    Kate "Беражы пальчыкі!"

# game/scripts/scene/scene_day_5.rpy:20009
translate belarusian event_m_katya_refuse_86dfc461:

    # "Кисти упали в поддон."
    "Кісці ўпалі ў паддон."

# game/scripts/scene/scene_day_5.rpy:20010
translate belarusian event_m_katya_refuse_ec4f694a:

    # "Через миг ножи отсекли мои руки по локти. Из культей хлестала кровь."
    "Праз імгненне нажы адсеклі мае рукі па локці. З кульцяў хлістала кроў."

# game/scripts/scene/scene_day_5.rpy:20029
translate belarusian event_m_katya_refuse_0b5d75ed:

    # "Лезвия приближались."
    "Лёзы набліжаліся."

# game/scripts/scene/scene_day_5.rpy:20083
translate belarusian event_m_katya_refuse_34b87ee6:

    # "Я почувствовал, как сталь врезается в моё лицо."
    "Я адчуў, як сталь уразаецца ў мой твар."

# game/scripts/scene/scene_day_5.rpy:20085
translate belarusian event_m_katya_refuse_d4180be1:

    # "Последним звуком, услышанным мною, был пронзительный вопль Оли."
    "Апошнім гукам, які я пачуў, быў пранізлівы крык Олі."

# game/scripts/scene/scene_day_5.rpy:20132
translate belarusian event_m_katya_refuse_05692390:

    # voice "voice/olya/5day/12 A.ogg"
    # Oly "А-а-а-а-а-а-а!"
    voice "voice/olya/5day/12 A.ogg"
    Oly "А-а-а-а-а-а-а!"

# game/scripts/scene/scene_day_5.rpy:20135
translate belarusian event_m_katya_refuse_47da6755:

    # "Я захрипел и открыл глаза."
    "Я захрыпеў і расплюшчыў вочы."

# game/scripts/scene/scene_day_5.rpy:20165
translate belarusian event_m_katya_refuse_f4e85280:

    # "Крик Оли оборвался, но эхо ещё звучало в голове."
    "Крык Олі абарваўся, але рэха яшчэ гучала ў галаве."

# game/scripts/scene/scene_day_5.rpy:20187
translate belarusian event_m_katya_refuse_8b7ec864:

    # "Боль прошла."
    "Боль прайшоў."

# game/scripts/scene/scene_day_5.rpy:20188
translate belarusian event_m_katya_refuse_08ec73c6:

    # "Омерзительный заяц, лезвия, кровь — всё это исчезло."
    "Мярзотны заяц, лёзы, кроў — усё гэта знікла."

# game/scripts/scene/scene_day_5.rpy:20189
translate belarusian event_m_katya_refuse_dbcb81ab:

    # "Из Чёрного гаража я перенёсся в собственную прихожую. Так это всё был сон?"
    "З Чорнага гаража я перанёсся ва ўласную пярэднюю. Дык гэта ўсё быў сон?"

# game/scripts/scene/scene_day_5.rpy:20223
translate belarusian event_m_katya_refuse_1fc6e354:

    # "Пошевелил целёхонькими руками."
    "Паварушыў цалюткімі рукамі."

# game/scripts/scene/scene_day_5.rpy:20242
translate belarusian event_m_katya_refuse_24a4e53f:

    # "Не только Гараж, но и весь последний месяц, и раненая Катя, и побег от маньяка..."
    "Не толькі Гараж, але і ўвесь апошні месяц, і параненая Каця, і ўцёкі ад маньяка..."

# game/scripts/scene/scene_day_5.rpy:20248
translate belarusian event_m_end_ba286577:

    # "... всё вымысел воспалённого мозга?"
    "... усё выдумка запалёнага мозгу?"

# game/scripts/scene/scene_day_5.rpy:20261
translate belarusian event_m_end_0f6e05aa:

    # "Оля всё ещё была со мной, на полу, но не там, где я её оставил. Теперь она лежала у меня на груди."
    "Оля ўсё яшчэ была са мной, на падлозе, але не там, дзе я яе пакінуў. Цяпер яна ляжала ў мяне на грудзях."

# game/scripts/scene/scene_day_5.rpy:20262
translate belarusian event_m_end_a7182061:

    # "Словно, пока я находился в беспамятстве, она пришла в чувство и подошла ко мне, чтобы спасти..."
    "Нібыта, пакуль я знаходзіўся ў непрытомнасці, яна прыйшла ў сябе і падышла да мяне, каб выратаваць..."

# game/scripts/scene/scene_day_5.rpy:20263
translate belarusian event_m_end_592c496a:

    # "Позвать..."
    "Паклікаць..."

# game/scripts/scene/scene_day_5.rpy:20264
translate belarusian event_m_end_ca909110:

    # "Вынуть из клешней кошмара..."
    "Выняць з клюшняў кашмару..."

# game/scripts/scene/scene_day_5.rpy:20265
translate belarusian event_m_end_e57e28e6:

    # "А потом снова потеряла сознание."
    "А потым зноў страціла прытомнасць."

# game/scripts/scene/scene_day_5.rpy:20283
translate belarusian event_m_end_aa49c34e:

    # "Я провёл пальцами по её теплой щеке."
    "Я правёў пальцамі па яе цёплай шчацэ."

# game/scripts/scene/scene_day_5.rpy:20284
translate belarusian event_m_end_4818aff1:

    # "Метель обрушивалась на окна. Стёкла громко дрожали в рамах."
    "Завіруха абрыналася на вокны. Шыбы гучна дрыжалі ў рамах."

# game/scripts/scene/scene_day_5.rpy:20314
translate belarusian phase2_phonecall_devend_7be28c5a:

    # "Во тьме к дому двигались чёрные фигуры."
    "У цемры да дома рухаліся чорныя постаці."

# game/scripts/scene/scene_day_5.rpy:20315
translate belarusian phase2_phonecall_devend_888691b0:

    # "Они были голодны."
    "Яны былі галодныя."

# game/scripts/scene/scene_day_5.rpy:20316
translate belarusian phase2_phonecall_devend_dffffb8f:

    # "Они всё ещё ждали угощение."
    "Яны ўсё яшчэ чакалі гасцінца."

# game/scripts/scene/scene_day_5.rpy:20327
translate belarusian phase2_phonecall_devend_4f2041b1:

    # "Мне требовалась помощь, и я побежал, поскальзываясь, в прихожую."
    "Мне патрэбна была дапамога, і я пабег, паслізгваючыся, у пярэдні пакой."

# game/scripts/scene/scene_day_5.rpy:20357
translate belarusian phase2_phonecall_devend_0aab65f6:

    # "Вцепился в телефон."
    "Учапіўся ў тэлефон."

# game/scripts/scene/scene_day_5.rpy:20361
translate belarusian phase2_phonecall_devend_4586c98a:

    # "Сначала динамики безмолвствовали. Потом проклюнулись тихие гудки."
    "Спачатку дынамікі маўчалі. Потым праклюнуліся ціхія гудкі."

# game/scripts/scene/scene_day_5.rpy:20362
translate belarusian phase2_phonecall_devend_cd4bf15e:

    # "Я представил, как шатаются столбы в метели, как звенят провода, которые вот-вот перекусят прожорливые пасти."
    "Я ўявіў, як хістаюцца слупы ў завірусе, як звіняць драты, якія вось-вось перакусяць пражэрлівыя пашчы."

# game/scripts/scene/scene_day_5.rpy:20366
translate belarusian phase2_phonecall_devend_5bd1f972:

    # "Пальцы крутанули диск."
    "Пальцы крутанулі дыск."

# game/scripts/scene/scene_day_5.rpy:20379
translate belarusian phone_roma_3c64434e:

    # voice "voice/romka/5day/282 Allo.ogg" 
    # Rom "Алло?"
    voice "voice/romka/5day/282 Allo.ogg" 
    Rom "Алё?"

# game/scripts/scene/scene_day_5.rpy:20382
translate belarusian phone_roma_867bd62f:

    # voice "voice/anton/5day/056.R.ogg"
    # Ant "Рома! Рома! Это я!"
    voice "voice/anton/5day/056.R.ogg"
    Ant "Рома! Рома! Гэта я!"

# game/scripts/scene/scene_day_5.rpy:20385
translate belarusian phone_roma_dbb49840:

    # voice "voice/romka/5day/282 Allo2.ogg" 
    # Rom "Алло!"
    voice "voice/romka/5day/282 Allo2.ogg" 
    Rom "Алё!"

# game/scripts/scene/scene_day_5.rpy:20387
translate belarusian phone_roma_61d1855b:

    # "Он не слышал. Я закричал отчаянно:"
    "Ён не чуў. Я закрычаў адчайна:"

# game/scripts/scene/scene_day_5.rpy:20389
translate belarusian phone_roma_5348684a:

    # voice "voice/anton/5day/057.Ro.ogg"
    # Ant "Рома!"
    voice "voice/anton/5day/057.Ro.ogg"
    Ant "Рома!"

# game/scripts/scene/scene_day_5.rpy:20395
translate belarusian phone_roma_c49e01cd:

    # "Ответом были частые гудки."
    "Адказам былі частыя гудкі."

# game/scripts/scene/scene_day_5.rpy:20400
translate belarusian phone_roma_c16134f1:

    # "Поднялся тревожный шелест, словно дом швырнуло в лес, и лапы сосен заелозили по нему, выискивая способ отворить шкатулку с мясом."
    "Узнялося трывожнае шамаценне, быццам дом шпурнула ў лес, і лапы соснаў зашоргалі па ім, вышукваючы спосаб адчыніць шкатулку з мясам."

# game/scripts/scene/scene_day_5.rpy:20406
translate belarusian phone_polina_5e0d0647:

    # "Я набрал номер Полины. Телефон вибрировал прерывистыми, как моё дыхание, гудками."
    "Я набраў нумар Паліны. Тэлефон вібрыраваў перарывістымі, як маё дыханне, гудкамі."

# game/scripts/scene/scene_day_5.rpy:20431
translate belarusian phonecall_fail_78089a6f:

    # "Наконец я позвонил в милицию, но сухой женский голос на том конце неустанно повторял зацикленные слова:"
    "Нарэшце я патэлефанаваў у міліцыю, але сухі жаночы голас на тым канцы нястомна паўтараў зацыкленыя словы:"

# game/scripts/scene/scene_day_5.rpy:20492
translate belarusian phonecall_fail_eb21477d:

    # voice "voice/episod/DANNOE.ogg" 
    # Operator "Данное направление перегружено. Данное направление перегружено. Данное направление..."
    voice "voice/episod/DANNOE.ogg" 
    Operator "Гэты напрамак перагружаны. Гэты напрамак перагружаны. Гэты напрамак..."

# game/scripts/scene/scene_day_5.rpy:20525
translate belarusian phonecall_fail_039641a0:

    # "Трубка брякнулась о рычажки."
    "Слухаўка бразнулася аб рычажкі."

# game/scripts/scene/scene_day_5.rpy:20536
translate belarusian phonecall_ok_7285e22b:

    # "Пригодилась записка с номером Тихонова, что я спрятал однажды. Заскрипел диск, отмеряя цифры."
    "Прыдалася запіска з нумарам Ціханава, якую я аднойчы схаваў. Заскрыпеў дыск, адмяраючы лічбы."

# game/scripts/scene/scene_day_5.rpy:20538
translate belarusian phonecall_ok_818df189:

    # "Накручивая на руку провод, я молил о том, чтоб участковый был на месте."
    "Накручваючы на руку шнур, я маліўся, каб участковы быў на месцы."

# game/scripts/scene/scene_day_5.rpy:20539
translate belarusian phonecall_ok_13f0337a:

    # voice "voice/tihonov/5day/107 St.ogg"
    # Tikhonov "Старший лейтенант Тихонов слушает."
    voice "voice/tihonov/5day/107 St.ogg"
    Tikhonov "Старшы лейтэнант Ціханаў слухае."

# game/scripts/scene/scene_day_5.rpy:20541
translate belarusian phonecall_ok_16b17f83:

    # "Голос прорывался сквозь рёв стихии. Тёк по обледеневшей проволоке."
    "Голас прарываўся скрозь роў стыхіі. Цёк па абледзянелым дроце."

# game/scripts/scene/scene_day_5.rpy:20542
translate belarusian phonecall_ok_f0a26cf2:

    # voice "voice/anton/5day/058.E.ogg"
    # Ant "Это Антон! Антон Петров!"
    voice "voice/anton/5day/058.E.ogg"
    Ant "Гэта Антон! Антон Пятроў!"

# game/scripts/scene/scene_day_5.rpy:20583
translate belarusian witness_ok_fb051e3a:

    # voice "voice/tihonov/5day/108 A.ogg"
    # Tikhonov "А, молодое дарование! Помню такого."
    voice "voice/tihonov/5day/108 A.ogg"
    Tikhonov "А, малады талент! Памятаю такога."

# game/scripts/scene/scene_day_5.rpy:20591
translate belarusian witness_ok_a52c7980:

    # voice "voice/anton/5day/059.pr.ogg"
    # Ant "Правда?"
    voice "voice/anton/5day/059.pr.ogg"
    Ant "Праўда?"

# game/scripts/scene/scene_day_5.rpy:20594
translate belarusian witness_ok_6c88a255:

    # voice "voice/tihonov/5day/109 Ato.ogg"
    # Tikhonov "А то!"
    voice "voice/tihonov/5day/109 Ato.ogg"
    Tikhonov "А то ж!"

# game/scripts/scene/scene_day_5.rpy:20596
translate belarusian witness_ok_b6b226db:

    # voice "voice/tihonov/5day/110 Mi.ogg"
    # Tikhonov "Мы ж благодаря тебе задержали подозреваемого в похищениях."
    voice "voice/tihonov/5day/110 Mi.ogg"
    Tikhonov "Мы ж дзякуючы табе затрымалі падазраванага ў выкраданнях."

# game/scripts/scene/scene_day_5.rpy:20598
translate belarusian witness_ok_21bfa4f3:

    # "Моё лицо вытянулось от изумления."
    "Мой твар выцягнуўся ад здзіўлення."

# game/scripts/scene/scene_day_5.rpy:20600
translate belarusian witness_ok_5d869a47:

    # voice "voice/anton/5day/060.Za.ogg"
    # Ant "Задержали? Когда?"
    voice "voice/anton/5day/060.Za.ogg"
    Ant "Затрымалі? Калі?"

# game/scripts/scene/scene_day_5.rpy:20603
translate belarusian witness_ok_c06bb3ad:

    # voice "voice/tihonov/5day/111 Se.ogg"
    # Tikhonov "Сегодня днём."
    voice "voice/tihonov/5day/111 Se.ogg"
    Tikhonov "Сёння ўдзень."

# game/scripts/scene/scene_day_5.rpy:20605
translate belarusian witness_ok_3f208a90:

    # voice "voice/tihonov/5day/112 Sha.ogg"
    # Tikhonov "Шастал, голубчик, неподалёку от кладбища, как заправский маньяк."
    voice "voice/tihonov/5day/112 Sha.ogg"
    Tikhonov "Швэндаўся, галубок, непадалёк ад могілак, як сапраўдны маньяк."

# game/scripts/scene/scene_day_5.rpy:20607
translate belarusian witness_ok_cf73053d:

    # voice "voice/tihonov/5day/113 A.ogg"
    # Tikhonov "А главное — точная копия твоего фоторобота. Безбровый, с заячьей губой."
    voice "voice/tihonov/5day/113 A.ogg"
    Tikhonov "А галоўнае — дакладная копія твайго фотаробата. Бязбровы, з заячай губой."

# game/scripts/scene/scene_day_5.rpy:20609
translate belarusian witness_ok_d3ae07c5:

    # voice "voice/tihonov/5day/114 Vi.ogg"
    # Tikhonov "Выясняем, кто он и откуда."
    voice "voice/tihonov/5day/114 Vi.ogg"
    Tikhonov "Высвятляем, хто ён і адкуль."

# game/scripts/scene/scene_day_5.rpy:20611
translate belarusian witness_ok_b791ad9a:

    # "Сердце ёкнуло."
    "Сэрца ёкнула."

# game/scripts/scene/scene_day_5.rpy:20612
translate belarusian witness_ok_8b7e33c3:

    # "Выходит, нарисовав портрет этого верзилы, я повёл милицию по ложному следу."
    "Выходзіць, намаляваўшы партрэт гэтага здаравякі, я павёў міліцыю па хібным следзе."

# game/scripts/scene/scene_day_5.rpy:20613
translate belarusian witness_ok_bd64dabd:

    # "И пока его допрашивают, настоящие душегубы крадутся к нашему дому."
    "І пакуль яго дапытваюць, сапраўдныя душагубы крадуцца да нашага дома."

# game/scripts/scene/scene_day_5.rpy:20615
translate belarusian witness_ok_860233e1:

    # voice "voice/anton/5day/061.Vdrug.ogg"
    # Ant "Вдруг это не он?"
    voice "voice/anton/5day/061.Vdrug.ogg"
    Ant "А раптам гэта не ён?"

# game/scripts/scene/scene_day_5.rpy:20618
translate belarusian witness_ok_0c02da90:

    # voice "voice/tihonov/5day/115 On.ogg"
    # Tikhonov "Он, он, родимый."
    voice "voice/tihonov/5day/115 On.ogg"
    Tikhonov "Ён, ён, родненькі."

# game/scripts/scene/scene_day_5.rpy:20620
translate belarusian witness_ok_7be2ad89:

    # voice "voice/tihonov/5day/116 Pi.ogg"
    # Tikhonov "Пистолет при нём был с глушителем, ещё мясницкий тесак, да строительный скотч."
    voice "voice/tihonov/5day/116 Pi.ogg"
    Tikhonov "Пісталет пры ім быў з глушыцелем, яшчэ мясніцкі цясак ды будаўнічы скотч."

# game/scripts/scene/scene_day_5.rpy:20622
translate belarusian witness_ok_301f1d58:

    # voice "voice/tihonov/5day/117 Pr.ogg"
    # Tikhonov "Прям всё как по учебнику."
    voice "voice/tihonov/5day/117 Pr.ogg"
    Tikhonov "Проста ўсё як па падручніку."

# game/scripts/scene/scene_day_5.rpy:20624
translate belarusian witness_ok_db248d87:

    # "«Как же так?», — изумился я. А вслух зачастил:"
    "«Як жа так?» — здзівіўся я. А ўголас зачасціў:"

# game/scripts/scene/scene_day_5.rpy:20626
translate belarusian witness_ok_c5e48be2:

    # voice "voice/anton/5day/062.Tpv.ogg"
    # Ant "Товарищ милиционер, мои родители пропали."
    voice "voice/anton/5day/062.Tpv.ogg"
    Ant "Таварыш міліцыянер, мае бацькі зніклі."

# game/scripts/scene/scene_day_5.rpy:20630
translate belarusian witness_ok_5913ae4a:

    # voice "voice/anton/5day/062.Vi.ogg"
    # Ant "Вы обязаны приехать и забрать меня с сестрой в участок."
    voice "voice/anton/5day/062.Vi.ogg"
    Ant "Вы абавязаны прыехаць і забраць мяне з сястрой у пастарунак."

# game/scripts/scene/scene_day_5.rpy:20634
translate belarusian witness_ok_b799f14e:

    # voice "voice/anton/5day/063.Nam.ogg"
    # Ant "Нам угрожает опасность!"
    voice "voice/anton/5day/063.Nam.ogg"
    Ant "Нам пагражае небяспека!"

# game/scripts/scene/scene_day_5.rpy:20637
translate belarusian witness_ok_07634559:

    # voice "voice/tihonov/5day/118 Sl.ogg"
    # Tikhonov "Слушай, пацан, в данный момент опасность сидит за решёткой."
    voice "voice/tihonov/5day/118 Sl.ogg"
    Tikhonov "Слухай, пацан, у гэты момант небяспека сядзіць за кратамі."

# game/scripts/scene/scene_day_5.rpy:20639
translate belarusian witness_ok_4810ae12:

    # voice "voice/tihonov/5day/119 Ya.ogg"
    # Tikhonov "Я её сам скрутил мордой в пол."
    voice "voice/tihonov/5day/119 Ya.ogg"
    Tikhonov "Я яе сам скруціў мордай у падлогу."

# game/scripts/scene/scene_day_5.rpy:20642
translate belarusian witness_ok_09f2d73a:

    # voice "voice/anton/5day/064.No.ogg"
    # Ant "Но я видел..."
    voice "voice/anton/5day/064.No.ogg"
    Ant "Але я бачыў..."

# game/scripts/scene/scene_day_5.rpy:20749
translate belarusian witness_ok_d7a426cf:

    # "Как из мёртвой собаки вылезает огромное насекомое."
    "Як з мёртвага сабакі вылазіць велізарнае насякомае."

# game/scripts/scene/scene_day_5.rpy:20777
translate belarusian witness_ok_31a558b7:

    # "Как Катю перемалывают лезвия мясорубки."
    "Як Кацю перамолваюць лязы мясарубкі."

# game/scripts/scene/scene_day_5.rpy:20779
translate belarusian witness_ok_89b780a1:

    # voice "voice/tihonov/5day/129 Vi.ogg"
    # Tikhonov "Видел что?"
    voice "voice/tihonov/5day/129 Vi.ogg"
    Tikhonov "Бачыў што?"

# game/scripts/scene/scene_day_5.rpy:20783
translate belarusian witness_ok_498ccdc4:

    # voice "voice/anton/5day/065.Ch.ogg"
    # Ant "Чудовищ в звериных масках."
    voice "voice/anton/5day/065.Ch.ogg"
    Ant "Пачвар у звярыных масках."

# game/scripts/scene/scene_day_5.rpy:20787
translate belarusian witness_ok_1634d85c:

    # voice "voice/anton/5day/065.Pr.ogg"
    # Ant "Приезжайте, умоляю вас!"
    voice "voice/anton/5day/065.Pr.ogg"
    Ant "Прыязджайце, малю вас!"

# game/scripts/scene/scene_day_5.rpy:20794
translate belarusian witness_ok_7cd8134b:

    # "Повисла пауза."
    "Завісла паўза."

# game/scripts/scene/scene_day_5.rpy:20796
translate belarusian witness_ok_f22d2fd7:

    # voice "voice/tihonov/5day/121 Da.ogg"
    # Tikhonov "Да ты вообще представляешь, сколько мне бумажной волокиты предстоит?"
    voice "voice/tihonov/5day/121 Da.ogg"
    Tikhonov "Ды ты наогул уяўляеш, колькі мяне чакае папяровай цяганіны?"

# game/scripts/scene/scene_day_5.rpy:20798
translate belarusian witness_ok_b525a13b:

    # voice "voice/tihonov/5day/122 Za.ogg"
    # Tikhonov "Задержание — это тебе не хухры-мухры! А у меня всего два сотрудника, да и те еле на ногах держатся."
    voice "voice/tihonov/5day/122 Za.ogg"
    Tikhonov "Затрыманне — гэта табе не абы-што! А ў мяне ўсяго два супрацоўнікі, ды і тыя ледзь на нагах трымаюцца."

# game/scripts/scene/scene_day_5.rpy:20800
translate belarusian witness_ok_9acef59d:

    # voice "voice/tihonov/5day/123 K.ogg"
    # Tikhonov "К тому же урод этот пока ни в чём не сознался."
    voice "voice/tihonov/5day/123 K.ogg"
    Tikhonov "Да таго ж вырадак гэты пакуль ні ў чым не прызнаўся."

# game/scripts/scene/scene_day_5.rpy:20802
translate belarusian witness_ok_42388ac3:

    # voice "voice/tihonov/5day/124 Ti.ogg"
