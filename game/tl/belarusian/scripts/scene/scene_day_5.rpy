# game/scripts/scene/scene_day_5.rpy:1109
translate belarusian begin_refuse_517c7722:

    # voice "voice/karina/5day/151Tishe.ogg"
    # Mam "Тише, милый. Всё будет хорошо."
    voice "voice/karina/5day/151Tishe.ogg"
    Mam "Цішэй, мілы. Усё будзе добра."

# game/scripts/scene/scene_day_5.rpy:1113
translate belarusian begin_refuse_be9223d6:

    # "Она устало улыбнулась. И эту её улыбку я бы не променял ни на какие сладости в мире."
    "Яна стомлена ўсміхнулася. І гэтую яе ўсмешку я б не прамяняў ні на якія ласункі ў свеце."

# game/scripts/scene/scene_day_5.rpy:1114
translate belarusian begin_refuse_73e804d8:

    # voice "voice/anton/5day/017.obe.ogg"
    # Ant "Обещаешь?"
    voice "voice/anton/5day/017.obe.ogg"
    Ant "Абяцаеш?"

# game/scripts/scene/scene_day_5.rpy:1116
translate belarusian begin_refuse_8b5cea1e:

    # voice "voice/karina/5day/152 Ya.ogg"
    # Mam "Я вернусь, чего бы мне это ни стоило."
    voice "voice/karina/5day/152 Ya.ogg"
    Mam "Я вярнуся, чаго б мне гэта ні каштавала."

# game/scripts/scene/scene_day_5.rpy:1120
translate belarusian begin_refuse_48aa965a:

    # voice "voice/karina/5day/153 Atep.ogg"
