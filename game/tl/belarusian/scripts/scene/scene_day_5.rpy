# game/scripts/scene/scene_day_5.rpy:845
translate belarusian begin_refuse_6da17000:

    # voice "voice/father/day5/5ne.ogg"
    # Pap "Не стоило бросать вас без присмотра."
    voice "voice/father/day5/5ne.ogg"
    Pap "Не варта было кідаць вас без нагляду."

# game/scripts/scene/scene_day_5.rpy:851
translate belarusian begin_refuse_615f491b:

    # "Я растерялся."
    "Я разгубіўся."

# game/scripts/scene/scene_day_5.rpy:852
translate belarusian begin_refuse_2b475ad8:

    # "Уже забыл, когда родители разговаривали таким тоном."
