    Oly "Тошанька, выратуй мяне."

# game/scripts/scene/scene_day_5.rpy:1047
translate belarusian begin_refuse_85c47713:

    # "Папа нахмурился."
    "Тата нахмурыўся."

# game/scripts/scene/scene_day_5.rpy:1048
