    # voice "voice/father/day5/12Anton.ogg"
    # Pap "Антон, мы туда и обратно."
    voice "voice/father/day5/12Anton.ogg"
    Pap "Антон, мы туды і назад."

# game/scripts/scene/scene_day_5.rpy:1050
