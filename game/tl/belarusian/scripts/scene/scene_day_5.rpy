# game/scripts/scene/scene_day_5.rpy:1011
translate belarusian begin_refuse_31d4ae12:

    # "Я представил, как родители едут через лес, а чащоба загорается алыми глазками, похожими на лампочки генераторов."
    "Я ўявіў, як бацькі едуць праз лес, а гушчар загараецца пунсовымі вочкамі, падобнымі да лямпачак генератараў."

# game/scripts/scene/scene_day_5.rpy:1029
translate belarusian begin_refuse_5b03c5f0:

    # voice "voice/anton/5day/003.Ne.ogg"
    # Ant "Не ходите!"
    voice "voice/anton/5day/003.Ne.ogg"
    Ant "Не хадзіце!"

# game/scripts/scene/scene_day_5.rpy:1035
translate belarusian begin_refuse_4c7e9965:

    # "Крик слетел с моих губ. Оля дрогнула под одеялом и прошептала."
    "Крык зляцеў з маіх вуснаў. Оля здрыганулася пад коўдрай і прашаптала."

# game/scripts/scene/scene_day_5.rpy:1039
