    voice "voice/anton/5day/007.Av.ogg"
    Ant "А раптам яна прачнецца, а вас няма?"

# game/scripts/scene/scene_day_5.rpy:1101
translate belarusian begin_refuse_41a08f61:

    # voice "voice/anton/5day/009.vd.ogg"
