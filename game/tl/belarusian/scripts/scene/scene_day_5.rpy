    # voice "voice/karina/5day/142 Gos.ogg"
    # Mam "Господи, что же делать?"
    voice "voice/karina/5day/142 Gos.ogg"
    Mam "Госпадзі, што ж рабіць?"

# game/scripts/scene/scene_day_5.rpy:823
translate belarusian begin_refuse_21f5b4cf:

    # "Папа положил ладонь на мамино плечо."
    "Тата паклаў далонь на маміна плячо."

# game/scripts/scene/scene_day_5.rpy:827
translate belarusian begin_refuse_a339ce80:

    # voice "voice/karina/5day/143 Pros.ogg"
    # Mam "Прости нас, солнышко."
    voice "voice/karina/5day/143 Pros.ogg"
    Mam "Прабач нам, сонейка."

# game/scripts/scene/scene_day_5.rpy:829
translate belarusian begin_refuse_18c30e1e:

    # "Слеза скатилась по щеке мамы."
    "Сляза скацілася па шчацэ мамы."

# game/scripts/scene/scene_day_5.rpy:836
translate belarusian begin_refuse_53dd4839:

    # "Она всхлипнула и посмотрела на меня, ссутулившегося у дверей."
    "Яна ўсхліпнула і паглядзела на мяне, згорбленага каля дзвярэй."

# game/scripts/scene/scene_day_5.rpy:837
translate belarusian begin_refuse_954168c1:

    # voice "voice/karina/5day/145 Eti.ogg"
