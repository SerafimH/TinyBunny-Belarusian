# Belarusian translation of Chapter 5: scripts/scene/scene_day_5.rpy

# game/scripts/scene/scene_day_5.rpy:78
translate belarusian 7fa4cb7f:

    # "[msg]"
    "[msg]"

# game/scripts/scene/scene_day_5.rpy:467
translate belarusian begin_refuse_a9494688:

    # "Захлёбываясь, я сбросил с себя одеяло."
    "Захлынаючыся, я скінуў з сябе коўдру."

# game/scripts/scene/scene_day_5.rpy:473
translate belarusian begin_refuse_4f59f291:

    # "Кое-как признал свои картинки на стенах, экран окна, транслирующий всё тот же лес."
    "Ледзь-ледзь пазнаў свае карцінкі на сценах, экран акна, што транслюе ўсё той жа лес."

# game/scripts/scene/scene_day_5.rpy:474
translate belarusian begin_refuse_6dc5e35e:

    # "Холодная жидкость текла по груди, и я затрясся, подумав, что это сочится слюна из распахнутой надо мной пасти."
    "Халодная вадкасць цякла па грудзях, і я затросся, падумаўшы, што гэта сочыцца сліна з разяўленай нада мной пашчы."

# game/scripts/scene/scene_day_5.rpy:475
translate belarusian begin_refuse_10b9b2de:

    # "Но это был лишь пот."
    "Але гэта быў толькі пот."

# game/scripts/scene/scene_day_5.rpy:476
translate belarusian begin_refuse_3979e42d:

    # "Всё это был лишь сон."
    "Усё гэта быў толькі сон."

# game/scripts/scene/scene_day_5.rpy:480
translate belarusian begin_refuse_3f7a3b23:

    # "Я машинально утёрся одеялом."
    "Я машынальна выцерся коўдрай."

# game/scripts/scene/scene_day_5.rpy:481
translate belarusian begin_refuse_904ff583:

    # "Как я вернулся домой? Когда уснул?"
    "Як я вярнуўся дадому? Калі заснуў?"

# game/scripts/scene/scene_day_5.rpy:482
translate belarusian begin_refuse_0a08fcc6:

    # "Мысли спотыкались, врезались друг в друга, хромали на костылях беспамятства."
    "Думкі спатыкаліся, уразаліся адна ў адну, кульгалі на мыліцах забыцця."

# game/scripts/scene/scene_day_5.rpy:483
translate belarusian begin_refuse_7c95169a:

    # "Развешанные рисунки казались плоской и пустой мазнёй."
    "Развешаныя малюнкі здаваліся плоскай і пустой мазанінай."

# game/scripts/scene/scene_day_5.rpy:484
translate belarusian begin_refuse_0683f561:

    # "Сумрак ползал по спальне на брюхе. А дряхлые стены кряхтели и поскрипывали."
    "Змрок поўзаў па спальні на бруху. А трухлявыя сцены крахталі і парыпвалі."

# game/scripts/scene/scene_day_5.rpy:487
translate belarusian begin_refuse_10b65c9d:

    # "Ветер бодал фасад, намереваясь проникнуть в дом и растерзать жильцов кривыми когтями."
    "Вецер бадаў фасад, маючы намер пранікнуць у дом і раздзерці жыхароў крывымі кіпцюрамі."

# game/scripts/scene/scene_day_5.rpy:535
translate belarusian begin_refuse_4962f2d2:

    # "Я выглянул в окно, опасаясь."
    "Я выглянуў у акно, асцерагаючыся."

# game/scripts/scene/scene_day_5.rpy:536
translate belarusian begin_refuse_026ae380:

    # "Завеса пурги скрыла солнце. Метель вздымала белые флаги в небо, но при этом не думала отступать."
    "Заслона завірухі схавала сонца. Мяцеліца ўздымала белыя сцягі ў неба, але пры гэтым не думала адступаць."

# game/scripts/scene/scene_day_5.rpy:537
translate belarusian begin_refuse_e78a2542:

    # "Поле и лес терялись во мгле, а возле исчезнувшей дороги слабо мерцал рыбий глаз фонаря."
    "Поле і лес губляліся ў імгле, а каля зніклай дарогі слаба мігцела рыбінае вока ліхтара."

# game/scripts/scene/scene_day_5.rpy:538
translate belarusian begin_refuse_1ace06b7:

    # "День стал ночью, нескончаемой полярной жутью, которая выла и шепталась..."
    "Дзень стаў ноччу, бясконцай палярнай жудасцю, якая выла і шапталася..."

# game/scripts/scene/scene_day_5.rpy:539
translate belarusian begin_refuse_e43e0618:

    # "... и ходила вокруг дома."
    "... і хадзіла вакол дома."

# game/scripts/scene/scene_day_5.rpy:581
translate belarusian begin_refuse_f9051ee3:

    # voice "voice/anton/5day/018.Myaso.ogg"
    # "{i}«Мясо»{/i}, — прозвучало в голове."
    voice "voice/anton/5day/018.Myaso.ogg"
    "{i}«Мяса»{/i}, — прагучала ў галаве."

# game/scripts/scene/scene_day_5.rpy:587
translate belarusian begin_refuse_ab83080a:

    # "Я шлёпнул себя по щеке."
    "Я пляснуў сябе па шчацэ."

# game/scripts/scene/scene_day_5.rpy:630
translate belarusian begin_refuse_9760d0bd:

    # "И выскочил в коридор убедиться, что с Олей всё в порядке, что кошмар — мой личный кошмар — не навредил ей."
    "І выскачыў у калідор пераканацца, што з Оляй усё ў парадку, што кашмар — мой асабісты кашмар — не нашкодзіў ёй."

# game/scripts/scene/scene_day_5.rpy:694
translate belarusian begin_refuse_b4ae3ec9:

    # "Сестра лежала в кровати, над ней хлопотали родители."
    "Сястра ляжала ў ложку, над ёй завіхаліся бацькі."

# game/scripts/scene/scene_day_5.rpy:695
translate belarusian begin_refuse_2ba4dd84:

    # "Олино лицо посерело, а губы приняли пугающий голубоватый оттенок."
    "Олін твар пашарэў, а вусны набылі страшнае блакітнаватае адценне."

# game/scripts/scene/scene_day_5.rpy:696
translate belarusian begin_refuse_fec8932f:

    # "Я глянул на её укутанные одеялом ноги, ожидая, что ткань окрасится багровым."
    "Я глянуў на яе ногі, ахутаныя коўдрай, чакаючы, што тканіна афарбуецца барвовым."

# game/scripts/scene/scene_day_5.rpy:697
translate belarusian begin_refuse_c09f8903:

    # "На миг ко мне вернулось спокойствие — ноги были на месте."
    "На імгненне да мяне вярнуўся спакой — ногі былі на месцы."

# game/scripts/scene/scene_day_5.rpy:699
translate belarusian begin_refuse_f8a25399:

    # voice "voice/anton/5day/001.Chto.ogg"
    # Ant "Что случилось?"
    voice "voice/anton/5day/001.Chto.ogg"
    Ant "Што здарылася?"

# game/scripts/scene/scene_day_5.rpy:701
translate belarusian begin_refuse_b27e3341:

    # voice "voice/karina/5day/137 Tem.ogg"
    # Mam "Температура подскочила."
    voice "voice/karina/5day/137 Tem.ogg"
    Mam "Тэмпература падскочыла."

# game/scripts/scene/scene_day_5.rpy:703
translate belarusian begin_refuse_3913c3a7:

    # voice "voice/karina/5day/138 Gov.ogg"
    # Mam "Говорила я тебе окна не открывать."
    voice "voice/karina/5day/138 Gov.ogg"
    Mam "Казала я табе вокны не адчыняць."

# game/scripts/scene/scene_day_5.rpy:705
translate belarusian begin_refuse_e3572fd5:

    # voice "voice/karina/5day/139 Be.ogg"
    # Mam "Да без толку сейчас ругаться. Спасать её надо."
    voice "voice/karina/5day/139 Be.ogg"
    Mam "Ды дарэмна цяпер сварыцца. Ратаваць яе трэба."

# game/scripts/scene/scene_day_5.rpy:716
translate belarusian begin_refuse_413d2bde:

    # "Оля закашляла."
    "Оля закашляла."

# game/scripts/scene/scene_day_5.rpy:717
translate belarusian begin_refuse_3dc19a24:

    # "Ей было тяжело держать веки поднятыми. Ресницы слипались."
    "Ёй было цяжка трымаць павекі паднятымі. Вейкі зліпаліся."

# game/scripts/scene/scene_day_5.rpy:720
translate belarusian begin_refuse_1821c82d:

    # "Грудь вибрировала от чахоточного дыхания."
    "Грудзі вібравалі ад сухотнага дыхання."

# game/scripts/scene/scene_day_5.rpy:731
translate belarusian begin_refuse_738402c3:

    # voice "voice/Bear/5day/Tvoi.ogg"
    # Oly_glitch "{sc=3}Твой черёд кормить нас.{/sc}"
    voice "voice/Bear/5day/Tvoi.ogg"
    Oly_glitch "{sc=3}Твая чарга карміць нас.{/sc}"

# game/scripts/scene/scene_day_5.rpy:748
translate belarusian begin_refuse_fcfb8022:

    # "Я тряхнул головой, пытаясь отогнать навязчивый шёпот. Образы танцующих в Гараже чудовищ, гнилых, червивых и мёртвых."
    "Я трасянуў галавой, спрабуючы адагнаць назойлівы шэпт. Вобразы пачвар, што танчаць у Гаражы, гнілых, чарвівых і мёртвых."

# game/scripts/scene/scene_day_5.rpy:752
translate belarusian begin_refuse_6f5db475:

    # voice "voice/father/day5/1a.ogg"
    # Pap "А вдруг инфекция?"
    voice "voice/father/day5/1a.ogg"
    Pap "А раптам інфекцыя?"

# game/scripts/scene/scene_day_5.rpy:755
translate belarusian begin_refuse_d4474b98:

    # "Папа кусал ногти, нервничая."
    "Тата кусаў пазногці, нервуючыся."

# game/scripts/scene/scene_day_5.rpy:756
translate belarusian begin_refuse_5339c9e9:

    # voice "voice/karina/5day/140 Pr.ogg"
    # Mam "Принеси сироп."
    voice "voice/karina/5day/140 Pr.ogg"
    Mam "Прынясі сіроп."

# game/scripts/scene/scene_day_5.rpy:758
translate belarusian begin_refuse_fdbb5cda:

    # voice "voice/father/day5/2uz.ogg"
    # Pap "Уже принёс. Тут на донышке."
    voice "voice/father/day5/2uz.ogg"
    Pap "Ужо прынёс. Тут на донцы."

# game/scripts/scene/scene_day_5.rpy:765
translate belarusian begin_refuse_bc66fef1:

    # "Он передал бутылочку."
    "Ён перадаў бутэлечку."

# game/scripts/scene/scene_day_5.rpy:772
translate belarusian begin_refuse_d978aa34:

    # "Я заметил, как мамина рука задержалась над папиной, легонько сжала её и отпустила."
    "Я заўважыў, як маміна рука затрымалася над татавай, легенька сціснула яе і адпусціла."

# game/scripts/scene/scene_day_5.rpy:777
translate belarusian begin_refuse_7acbd4e9:

    # "Метель за окнами набирала силу, но непогода, царящая между моими родителями, на время утихла."
    "Мяцеліца за вокнамі набірала сілу, але непагадзь, што панавала паміж маімі бацькамі, на нейкі час сціхла."

# game/scripts/scene/scene_day_5.rpy:778
translate belarusian begin_refuse_79fc7067:

    # "Будто Олина болезнь заставила их остановиться и осмыслить своё поведение."
    "Нібы Оліна хвароба прымусіла іх спыніцца і асэнсаваць свае паводзіны."

# game/scripts/scene/scene_day_5.rpy:779
translate belarusian begin_refuse_b738f2e2:

    # voice "voice/father/day5/3gre.ogg"
    # Pap "Грелка вот."
    voice "voice/father/day5/3gre.ogg"
    Pap "Грэлка вось."

# game/scripts/scene/scene_day_5.rpy:787
translate belarusian begin_refuse_b1e0e54d:

    # voice "voice/olya/5day/03 Ne.ogg"
    # Oly "Не буду, не возьму, вы плохие."
    voice "voice/olya/5day/03 Ne.ogg"
    Oly "Не буду, не вазьму, вы дрэнныя."

# game/scripts/scene/scene_day_5.rpy:791
translate belarusian begin_refuse_b9a00d8f:

    # "Она бредила. Зрачки закатывались, заплетался язык."
    "Яна трызніла. Зрэнкі закочваліся, заплятаўся язык."

# game/scripts/scene/scene_day_5.rpy:795
translate belarusian begin_refuse_809e2052:

    # voice "voice/olya/5day/04 Ya.ogg"
    # Oly "Я знаю! Вы под масками страшные!"
    voice "voice/olya/5day/04 Ya.ogg"
    Oly "Я ведаю! Вы пад маскамі страшныя!"

# game/scripts/scene/scene_day_5.rpy:812
translate belarusian begin_refuse_85c0c2c5:

    # "От её слов меня точно током ударило."
    "Ад яе слоў мяне нібы токам ударыла."

# game/scripts/scene/scene_day_5.rpy:813
translate belarusian begin_refuse_f268abef:

    # voice "voice/karina/5day/141 Tishe.ogg"
    # Mam "Тише, доченька, перестань."
    voice "voice/karina/5day/141 Tishe.ogg"
    Mam "Цішэй, дачушка, перастань."

# game/scripts/scene/scene_day_5.rpy:818
