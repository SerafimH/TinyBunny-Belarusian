    # voice "voice/Bear/5day/3 za.ogg"
    # Noname "{i}Зайчик, мясо нам достань...{/i}"
    voice "voice/Bear/5day/3 za.ogg"
    Noname "{i}Зайчык, мяса нам дастань...{/i}"

# game/scripts/scene/scene_day_5.rpy:1361
translate belarusian begin_refuse_168a661f:

    # voice "voice/Bear/5day/4 eli.ogg"
    # Noname "{i}... или мясом сочным стань.{/i}"
    voice "voice/Bear/5day/4 eli.ogg"
    Noname "{i}... альбо мясам сочным стань.{/i}"

# game/scripts/scene/scene_day_5.rpy:1384
translate belarusian begin_refuse_11893cb7:

    # "Я вырвался из объятий наваждения, как из паучьих сетей."
    "Я вырваўся з абдымкаў наслання, як з павучыных сетак."

# game/scripts/scene/scene_day_5.rpy:1389
translate belarusian begin_refuse_0d90bfb2:

    # "Выскочил из комнаты, чуть ли не кубарем скатился с лестницы."
    "Выскачыў з пакоя, ледзь не кулем скаціўся з лесвіцы."

# game/scripts/scene/scene_day_5.rpy:1398
translate belarusian begin_refuse_95e2919f:

    # "Чтобы выбежать на улицу, броситься к родителям на шею и сказать, как сильно мы с Олей любим их."
    "Каб выбегчы на вуліцу, кінуцца бацькам на шыю і сказаць, як моцна мы з Оляй любім іх."

# game/scripts/scene/scene_day_5.rpy:1399
translate belarusian begin_refuse_9cd56edf:

    # "Что мы никогда не будем больше ругаться или спорить..."
    "Што мы ніколі больш не будзем сварыцца ці спрачацца..."

# game/scripts/scene/scene_day_5.rpy:1400
translate belarusian begin_refuse_43736a56:

    # "Всё что угодно, лишь бы они не бросили нас одних в этот страшный час."
    "Усё што заўгодна, абы толькі яны не кінулі нас адных у гэтую страшную гадзіну."

# game/scripts/scene/scene_day_5.rpy:1438
translate belarusian begin_refuse_6ffbc080:

    # "Я распахнул дверь, но бушующая пурга уже скрыла след папиной машины."
    "Я расчыніў дзверы, але шалёная завея ўжо схавала след татавай машыны."

# game/scripts/scene/scene_day_5.rpy:1455
translate belarusian begin_refuse_5791522f:

    # "Вселенная сузилась до крохотного пятачка перед крыльцом."
    "Сусвет звузіўся да малюсенькага пятачка перад ганкам."

# game/scripts/scene/scene_day_5.rpy:1481
translate belarusian begin_refuse_6e9ba8d5:

    # "В доме разом стало темнее и прохладнее."
    "У доме ўраз стала цямней і прахаладней."

# game/scripts/scene/scene_day_5.rpy:1485
translate belarusian begin_refuse_5873108a:

    # "Что-то зашуршало на чердаке. Мыши? Лисий хвост?"
    "Нешта зашамацела на гарышчы. Мышы? Лісіны хвост?"

# game/scripts/scene/scene_day_5.rpy:1486
translate belarusian begin_refuse_3b01cf6e:

    # "Тени карабкались по стенам."
    "Цені караскаліся па сценах."

# game/scripts/scene/scene_day_5.rpy:1487
translate belarusian begin_refuse_4c22804c:

    # "В пустых комнатах поскрипывали половицы."
    "У пустых пакоях парыпвалі масніцы."

# game/scripts/scene/scene_day_5.rpy:1491
translate belarusian begin_refuse_43c8784a:

    # "Часы безжалостно считали минуты. Ночь не заставит себя ждать, и тогда..."
    "Гадзіннік бязлітасна лічыў хвіліны. Ноч не прымусіць сябе чакаць, і тады..."

# game/scripts/scene/scene_day_5.rpy:1497
translate belarusian begin_refuse_4e2f730a:

    # "Я вспомнил наказ родителей — присмотреть за Олей."
    "Я ўспомніў наказ бацькоў — прыгледзець за Оляй."

# game/scripts/scene/scene_day_5.rpy:1498
translate belarusian begin_refuse_28734e52:

    # "Сделаю всё, что в моих силах."
    "Зраблю ўсё, што ў маіх сілах."

# game/scripts/scene/scene_day_5.rpy:1499
translate belarusian begin_refuse_6c183af1:

    # "А вдруг Оля проснётся голодной?"
    "А раптам Оля прачнецца галоднай?"

# game/scripts/scene/scene_day_5.rpy:1525
translate belarusian begin_accept_19f320b8:

    # "Дом заволокло снегом. Приближалась буря."
    "Дом завалакло снегам. Набліжалася бура."

# game/scripts/scene/scene_day_5.rpy:1589
translate belarusian begin_accept_0fca7023:

    # "Я вошёл в сумеречный коридор, а дверь сама собой захлопнулась, хрястнув."
    "Я ўвайшоў у змрочны калідор, а дзверы самі сабой захлопнуліся, храснуўшы."

# game/scripts/scene/scene_day_5.rpy:1590
translate belarusian begin_accept_5ee41898:

    # "Робкий свет, только недавно просочившийся в окна, торопливо отступал."
    "Нясмелае святло, якое толькі нядаўна прасачылася ў вокны, паспешліва адступала."

# game/scripts/scene/scene_day_5.rpy:1623
translate belarusian begin_accept_026ae380:

    # "Завеса пурги скрыла солнце. Метель вздымала белые флаги в небо, но при этом не думала отступать."
    "Заслона завірухі схавала сонца. Мяцеліца ўздымала белыя сцягі ў неба, але пры гэтым не думала адступаць."

# game/scripts/scene/scene_day_5.rpy:1624
translate belarusian begin_accept_e78a2542:

    # "Поле и лес терялись во мгле, а возле исчезнувшей дороги слабо мерцал рыбий глаз фонаря."
    "Поле і лес губляліся ў імгле, а каля зніклай дарогі слаба мігцела рыбінае вока ліхтара."

# game/scripts/scene/scene_day_5.rpy:1625
translate belarusian begin_accept_fddd84ab:

    # "День стал ночью — нескончаемой жутью, которая выла и шепталась..."
    "Дзень стаў ноччу — бясконцай жудасцю, якая выла і шапталася..."

# game/scripts/scene/scene_day_5.rpy:1626
translate belarusian begin_accept_e43e0618:

    # "... и ходила вокруг дома."
    "... і хадзіла вакол дома."

# game/scripts/scene/scene_day_5.rpy:1668
translate belarusian begin_accept_c43c3b5a:

    # voice "voice/anton/5day/018.Myaso.ogg"
    # "{i}«Мясо»{/i}, — прозвучало в голове."
    voice "voice/anton/5day/018.Myaso.ogg"
    "{i}«Мяса»{/i}, — прагучала ў галаве."

# game/scripts/scene/scene_day_5.rpy:1674
translate belarusian begin_accept_ab83080a:

    # "Я шлёпнул себя по щеке."
    "Я пляснуў сябе па шчацэ."

# game/scripts/scene/scene_day_5.rpy:1700
translate belarusian begin_accept_44203a8d:

    # voice "voice/anton/5day/010.Mama.ogg"
    voice "voice/anton/5day/010.Mama.ogg"

# game/scripts/scene/scene_day_5.rpy:1704
translate belarusian begin_accept_18b2ca59:

    # voice "voice/Anton/5day/00 Mam.ogg"
    # Ant "Мама? Папа?"
    voice "voice/Anton/5day/00 Mam.ogg"
    Ant "Мама? Тата?"

# game/scripts/scene/scene_day_5.rpy:1707
translate belarusian begin_accept_32f3e86f:

    # "Пустой дом насмешливо скрипел."
    "Пусты дом насмешліва рыпеў."

# game/scripts/scene/scene_day_5.rpy:1713
translate belarusian begin_accept_5545448f:

    # "Никого не было ни на кухне, ни в ванной, ни в чулане."
    "Нікога не было ні на кухні, ні ў ваннай, ні ў каморы."

# game/scripts/scene/scene_day_5.rpy:1723
translate belarusian begin_accept_9e161bb8:

    # "Я взбежал по лестнице, жалея, что не присматривался к трепещущим на ветру объявлениям о розыске."
    "Я ўзбег па лесвіцы, шкадуючы, што не прыглядаўся да аб'яў пра вышук, якія трапяталі на ветры."

# game/scripts/scene/scene_day_5.rpy:1731
translate belarusian begin_accept_f024bb58:

    # "Вдруг родительские лица были среди пропавших?"
    "Раптам бацькоўскія твары былі сярод зніклых?"

# game/scripts/scene/scene_day_5.rpy:1732
translate belarusian begin_accept_f82a22f1:

    # "Я сунулся в мамину комнату."
    "Я сунуўся ў мамін пакой."

# game/scripts/scene/scene_day_5.rpy:1733
translate belarusian begin_accept_3e5f806b:

    # "За окном ползла пепельная туча."
    "За акном паўзла попельная хмара."

# game/scripts/scene/scene_day_5.rpy:1734
translate belarusian begin_accept_63560745:

    # voice "voice/anton/5day/011.Mama.ogg"
    # Ant "Где же вы?"
    voice "voice/anton/5day/011.Mama.ogg"
    Ant "Дзе ж вы?"

# game/scripts/scene/scene_day_5.rpy:1770
translate belarusian begin_accept_a7beb501:

    # "Я не надеялся найти Олю в детской, но она лежала в своей кровати."
    "Я не спадзяваўся знайсці Олю ў дзіцячай, але яна ляжала ў сваім ложку."

# game/scripts/scene/scene_day_5.rpy:1771
translate belarusian begin_accept_452db753:

    # "Будто всё, что случилось ночью, было обыкновенным сном."
    "Нібы ўсё, што здарылася ноччу, было звычайным сном."

# game/scripts/scene/scene_day_5.rpy:1775
translate belarusian begin_accept_3881f72d:

    # voice "voice/anton/5day/012.Slava.ogg"
    # Ant "Слава Богу, ты здесь!"
    voice "voice/anton/5day/012.Slava.ogg"
    Ant "Дзякуй Богу, ты тут!"

# game/scripts/scene/scene_day_5.rpy:1777
translate belarusian begin_accept_bc03ff86:

    # voice "voice/anton/5day/013.Slava.ogg"
    # Ant "Где мама с папой?"
    voice "voice/anton/5day/013.Slava.ogg"
    Ant "Дзе мама з татам?"

# game/scripts/scene/scene_day_5.rpy:1780
translate belarusian begin_accept_93b845bb:

    # "Она молчала, видимо, спала."
    "Яна маўчала, відаць, спала."

# game/scripts/scene/scene_day_5.rpy:1798
translate belarusian begin_accept_5ed3960c:

    # "Около подушки валялась сложенная записка — немного в сторонке, словно её и не должны были найти:"
    "Каля падушкі валялася складзеная запіска — трохі ўбаку, быццам яе і не павінны былі знайсці:"

# game/scripts/scene/scene_day_5.rpy:1799
translate belarusian begin_accept_9389a8c6:

    # "«Уехали за лекарствами. Присмотри за Олей. Надеемся на тебя»."
    "«Паехалі па лекі. Прыгледзь за Оляй. Спадзяёмся на цябе»."

# game/scripts/scene/scene_day_5.rpy:1800
translate belarusian begin_accept_7b6c26e3:

    # "«Мама и Папа»."
    "«Мама і Тата»."

# game/scripts/scene/scene_day_5.rpy:1804
translate belarusian begin_accept_00ef2ae3:

    # "Оля не открывала глаз."
    "Оля не расплюшчвала вачэй."

# game/scripts/scene/scene_day_5.rpy:1805
translate belarusian begin_accept_e72522dd:

    # "Компресс на её лбу нагрелся от температуры. Похоже, родители ухаживали за сестрой, прежде чем отлучиться."
    "Кампрэс на яе лбе нагрэўся ад тэмпературы. Падобна, бацькі даглядалі сястру, перш чым адлучыцца."

# game/scripts/scene/scene_day_5.rpy:1809
translate belarusian begin_accept_be48cb78:

    # "Голова её моталась по подушке. Глазные яблоки вращались под веками."
    "Галава яе маталася па падушцы. Вочныя яблыкі круціліся пад павекамі."

# game/scripts/scene/scene_day_5.rpy:1812
translate belarusian begin_accept_054f75b8:

    # voice "voice/olya/5day/83 Aya.ogg"
    # Oly "А я могу прыгнуть к звёздам, как ты?"
    voice "voice/olya/5day/83 Aya.ogg"
    Oly "А я магу скокнуць да зорак, як ты?"

# game/scripts/scene/scene_day_5.rpy:1820
translate belarusian begin_accept_7012ee07:

    # "Я обомлел."
    "Я абамлеў."

# game/scripts/scene/scene_day_5.rpy:1821
translate belarusian begin_accept_295924bc:

    # "Она видела во сне новогодние танцы с маскарадом."
    "Яна бачыла ў сне навагоднія танцы з маскарадам."

# game/scripts/scene/scene_day_5.rpy:1822
translate belarusian begin_accept_64668cab:

    # voice "voice/anton/5day/014.net.ogg"
    # Ant "Нет, не можешь! Не смей, это всё обман!"
    voice "voice/anton/5day/014.net.ogg"
    Ant "Не, не можаш! Не смей, гэта ўсё падман!"

# game/scripts/scene/scene_day_5.rpy:1841
translate belarusian begin_accept_cf8d2996:

    # voice "voice/olya/5day/84 Zai.ogg"
    # Oly "Зайчик, твой черёд угощать нас!"
    voice "voice/olya/5day/84 Zai.ogg"
    Oly "Зайчык, твая чарга частаваць нас!"

# game/scripts/scene/scene_day_5.rpy:1843
translate belarusian begin_accept_64f055dc:

    # "Оля улыбнулась. Её зубки были перепачканы в шоколаде."
    "Оля ўсміхнулася. Яе зубкі былі перапэцканыя ў шакаладзе."

# game/scripts/scene/scene_day_5.rpy:1866
translate belarusian begin_accept_3e223cfe:

    # Oly_glitch "{sc=3}Мясо...{/sc}"
    Oly_glitch "{sc=3}Мяса...{/sc}"

# game/scripts/scene/scene_day_5.rpy:1882
translate belarusian begin_accept_9ea4c7fc:

    # "Я тряхнул головой, пытаясь отогнать навязчивый шёпот, образы исполинских чудовищ — гнилых, червивых и мёртвых."
    "Я трасянуў галавой, спрабуючы адагнаць назойлівы шэпт, вобразы велічэзных пачвар — гнілых, чарвівых і мёртвых."

# game/scripts/scene/scene_day_5.rpy:1892
translate belarusian begin_accept_d8e30cb8:

    # voice "voice/olya/5day/85 Gos.ogg"
    # Oly "Гости скоро будут здесь."
    voice "voice/olya/5day/85 Gos.ogg"
    Oly "Госці хутка будуць тут."

# game/scripts/scene/scene_day_5.rpy:1899
translate belarusian begin_accept_713b80f6:

    # voice "voice/olya/5day/86 Emi.ogg"
    # Oly "И мы сможем с ними играть всю ночь!"
    voice "voice/olya/5day/86 Emi.ogg"
    Oly "І мы зможам з імі гуляць усю ноч!"

# game/scripts/scene/scene_day_5.rpy:1940
translate belarusian begin_accept_47df8713:

    # "Я думал о голодных зверях. О флейте, чей зов неумолим. О дохлых тварях, скачущих над соснами."
    "Я думаў пра галодных звяроў. Пра флейту, чый покліч няўмольны. Пра дохлых пачвар, што скачуць над соснамі."

# game/scripts/scene/scene_day_5.rpy:1946
translate belarusian begin_accept_6e9ba8d5:

    # "В доме разом стало темнее и прохладнее."
    "У доме ўраз стала цямней і прахаладней."

# game/scripts/scene/scene_day_5.rpy:1951
translate belarusian begin_accept_5873108a:

    # "Что-то зашуршало на чердаке. Мыши? Лисий хвост?"
    "Нешта зашамацела на гарышчы. Мышы? Лісіны хвост?"

# game/scripts/scene/scene_day_5.rpy:1952
translate belarusian begin_accept_3b01cf6e:

    # "Тени карабкались по стенам."
    "Цені караскаліся па сценах."

# game/scripts/scene/scene_day_5.rpy:1953
translate belarusian begin_accept_4c22804c:

    # "В пустых комнатах поскрипывали половицы."
    "У пустых пакоях парыпвалі масніцы."

# game/scripts/scene/scene_day_5.rpy:1954
translate belarusian begin_accept_e84e11d8:

    # "Оля в бреду описывала образы из моего сна. Вещи, о которых она не могла знать."
    "Оля ў трызненні апісвала вобразы з майго сну. Рэчы, пра якія яна не магла ведаць."

# game/scripts/scene/scene_day_5.rpy:1960
translate belarusian begin_accept_ecbb9a86:

    # voice "voice/olya/5day/87 Ya.ogg"
    # Oly "Я перепробую все конфеты!"
    voice "voice/olya/5day/87 Ya.ogg"
    Oly "Я перакаштую ўсе цукеркі!"

# game/scripts/scene/scene_day_5.rpy:1970
translate belarusian begin_accept_459a3cb0:

    # voice "voice/anton/5day/016.Yane.ogg"
    # Ant "Я не позволю!"
    voice "voice/anton/5day/016.Yane.ogg"
    Ant "Я не дазволю!"

# game/scripts/scene/scene_day_5.rpy:2067
translate belarusian begin_accept_f48edb00:

    # voice "voice/anton/5day/40 Po.ogg"
    # "«{sc=2}{i}Позволишь, ещё как позволишь{/i}{/sc}», — голос раздавался в моей голове и в то же время струился из углов и щелей."
    voice "voice/anton/5day/40 Po.ogg"
    "«{sc=2}{i}Дазволіш, яшчэ як дазволіш{/i}{/sc}», — голас гучаў у маёй галаве і ў той жа час струменіўся з кутоў і шчылін."

# game/scripts/scene/scene_day_5.rpy:2084
translate belarusian begin_accept_7139e5fd:

    # voice "voice/Bear/5day/2 mi.ogg"
    # Noname "{i}Мы придём, как только настанет ночь.{/i}"
    voice "voice/Bear/5day/2 mi.ogg"
    Noname "{i}Мы прыйдзем, як толькі надыдзе ноч.{/i}"

# game/scripts/scene/scene_day_5.rpy:2099
translate belarusian begin_accept_4084531c:

    # voice "voice/Bear/5day/3 za.ogg"
    # Noname "{i}Зайчик, мясо нам достань...{/i}"
    voice "voice/Bear/5day/3 za.ogg"
    Noname "{i}Зайчык, мяса нам дастань...{/i}"

# game/scripts/scene/scene_day_5.rpy:2114
translate belarusian begin_accept_168a661f:

    # voice "voice/Bear/5day/4 eli.ogg"
    # Noname "{i}... или мясом сочным стань.{/i}"
    voice "voice/Bear/5day/4 eli.ogg"
    Noname "{i}... альбо мясам сочным стань.{/i}"

# game/scripts/scene/scene_day_5.rpy:2134
translate belarusian begin_accept_11893cb7:

    # "Я вырвался из объятий наваждения, как из паучьих сетей."
    "Я вырваўся з абдымкаў наслання, як з павучыных сетак."

# game/scripts/scene/scene_day_5.rpy:2139
translate belarusian begin_accept_0d90bfb2:

    # "Выскочил из комнаты, чуть ли не кубарем скатился с лестницы."
    "Выскачыў з пакоя, ледзь не кулем скаціўся з лесвіцы."

# game/scripts/scene/scene_day_5.rpy:2142
translate belarusian begin_accept_43c8784a:

    # "Часы безжалостно считали минуты. Ночь не заставит себя ждать, и тогда..."
    "Гадзіннік бязлітасна лічыў хвіліны. Ноч не прымусіць сябе чакаць, і тады..."

# game/scripts/scene/scene_day_5.rpy:2151
translate belarusian begin_accept_4f0a4f73:

    # "Нужно перестать думать только о себе. А вдруг Оля проснётся голодной?"
    "Трэба перастаць думаць толькі пра сябе. А раптам Оля прачнецца галоднай?"

# game/scripts/scene/scene_day_5.rpy:2177
translate belarusian phase1_zhulka_devend_ebe73051:

    # "В холодильнике томились остатки сгущёнки. Я нарезал буханку хлеба, как любит Оля, четвертинками."
    "У халадзільніку таміліся рэшткі згушчонкі. Я нарэзаў бохан хлеба, як любіць Оля, чвэрткамі."

# game/scripts/scene/scene_day_5.rpy:2187
translate belarusian phase1_zhulka_devend_3ffce3a1:

    # "И тут к песне ветра за окном добавился какой-то пронзительный вой."
    "І тут да песні ветру за акном дадалося нейкае пранізлівае выццё."

# game/scripts/scene/scene_day_5.rpy:2205
translate belarusian phase1_zhulka_devend_0fbd2f00:

    # "Во дворе что-то темнело в объятиях вьюги. Живое, метавшееся по снегу."
    "У двары нешта цямнела ў абдымках завірухі. Жывое, што кідалася па снезе."

# game/scripts/scene/scene_day_5.rpy:2206
translate belarusian phase1_zhulka_devend_400f5c37:

    # voice "voice/anton/5day/019.net.ogg"
    # Ant "Нет, нет, до ночи ещё далеко!"
    voice "voice/anton/5day/019.net.ogg"
    Ant "Не, не, да ночы яшчэ далёка!"

# game/scripts/scene/scene_day_5.rpy:2208
translate belarusian phase1_zhulka_devend_1bf74b73:

    # voice "voice/anton/5day/019.Vi.ogg"
    # Ant "Вы обещали дать мне шанс!"
    voice "voice/anton/5day/019.Vi.ogg"
    Ant "Вы абяцалі даць мне шанс!"

# game/scripts/scene/scene_day_5.rpy:2213
translate belarusian phase1_zhulka_devend_961ad777:

    # "До моего уха донеслось жалобное тявканье."
    "Да майго вуха данеслася жаласнае цяўканне."

# game/scripts/scene/scene_day_5.rpy:2219
translate belarusian phase1_zhulka_devend_7d646efc:

    # "На мгновение метель улеглась, разогнав рой снежных мух, и я признал в дрожащем комочке знакомую собачонку."
    "На імгненне мяцеліца сціхла, разагнаўшы рой снежных мух, і я пазнаў у дрыготкім камячку знаёмага сабачку."

# game/scripts/scene/scene_day_5.rpy:2220
translate belarusian phase1_zhulka_devend_23ef5f03:

    # "Возможно, это и был тот самый шанс."
    "Магчыма, гэта і быў той самы шанс."

# game/scripts/scene/scene_day_5.rpy:2221
translate belarusian phase1_zhulka_devend_52c50f22:

    # voice "voice/anton/5day/019.Zul.ogg"
    # Ant "Жулька!"
    voice "voice/anton/5day/019.Zul.ogg"
    Ant "Жулька!"

# game/scripts/scene/scene_day_5.rpy:2224
translate belarusian phase1_zhulka_devend_2c52ac7e:

    # "Дворняжка вильнула хвостом, словно услышала мой выкрик, и бросилась к входной двери."
    "Дварняжка вільнула хвастом, быццам пачула мой выкрык, і кінулася да ўваходных дзвярэй."

# game/scripts/scene/scene_day_5.rpy:2235
translate belarusian phase1_zhulka_devend_b04b4a5b:

    # "Поскуливая, она царапала деревянное полотно маленькими лапками, выпрашивала впустить её."
    "Паскугольваючы, яна драпала драўлянае палатно маленькімі лапкамі, выпрошвала ўпусціць яе."

# game/scripts/scene/scene_day_5.rpy:2276
translate belarusian phase1_zhulka_devend_a5923897:

    # voice "voice/anton/5day/019P.ogg"
    # Ant "Приветик."
    voice "voice/anton/5day/019P.ogg"
    Ant "Прывітаннечка."

# game/scripts/scene/scene_day_5.rpy:2281
translate belarusian phase1_zhulka_devend_2b55ac27:

    # "Я нагнулся и потеребил собачку за ухом. Хвост завилял быстрее."
    "Я нахіліўся і пацерабіў сабачку за вухам. Хвост завіляў хутчэй."

# game/scripts/scene/scene_day_5.rpy:2282
translate belarusian phase1_zhulka_devend_e98d68c1:

    # "{i}Собака... Мясо... Еда...{/i}"
    "{i}Сабака... Мяса... Ежа...{/i}"

# game/scripts/scene/scene_day_5.rpy:2283
translate belarusian phase1_zhulka_devend_d597d289:

    # "Что, если я предложу собачатину этим чудищам из чёрного леса?"
    "Што, калі я прапаную сабачаціну гэтым пачварам з чорнага лесу?"

# game/scripts/scene/scene_day_5.rpy:2284
translate belarusian phase1_zhulka_devend_df9fab77:

    # "Сможет ли она утолить их голод?"
    "Ці зможа яна спатоліць іх голад?"

# game/scripts/scene/scene_day_5.rpy:2288
translate belarusian phase1_zhulka_devend_02d65fc1:

    # "Не задумываясь о том, как буду убивать бедное животное, я попятился, присвистывая."
    "Не задумваючыся пра тое, як буду забіваць бедную жывёліну, я папяціўся, пасвістваючы."

# game/scripts/scene/scene_day_5.rpy:2289
translate belarusian phase1_zhulka_devend_af74c1d5:

    # "Буря свистела в унисон, словно поддерживая мой дьявольский план."
    "Бура свістала ва ўнісон, быццам падтрымліваючы мой д'ябальскі план."

# game/scripts/scene/scene_day_5.rpy:2305
translate belarusian phase1_zhulka_devend_182d022b:

    # "Дрожащая дворняга просеменила в коридор."
    "Дрыготкая дварняга дробна пратупала ў калідор."

# game/scripts/scene/scene_day_5.rpy:2315
translate belarusian phase1_zhulka_devend_e520b3bf:

    # "Я быстро закрыл дверь, боясь, что она почует неладное и попытается сбежать."
    "Я хутка зачыніў дзверы, баючыся, што яна зачуе нядобрае і паспрабуе ўцячы."

# game/scripts/scene/scene_day_5.rpy:2319
translate belarusian phase1_zhulka_devend_9409ba01:

    # "Радостный собачий лай разразился на весь дом."
    "Радасны сабачы брэх разнёсся на ўвесь дом."

# game/scripts/scene/scene_day_5.rpy:2320
translate belarusian phase1_zhulka_devend_1dbf0c2e:

    # voice "voice/anton/5day/020.ti.ogg"
    # Ant "Тише, дурочка, Олю разбудишь."
    voice "voice/anton/5day/020.ti.ogg"
    Ant "Цішэй, дурнічка, Олю разбудзіш."

# game/scripts/scene/scene_day_5.rpy:2322
translate belarusian phase1_zhulka_devend_80d4067d:

    # "Но не резать же её в прихожей. Лучше на кухне."
    "Але не рэзаць жа яе ў пярэднім пакоі. Лепш на кухні."

# game/scripts/scene/scene_day_5.rpy:2345
translate belarusian phase1_zhulka_devend_13cd5d1a:

    # "Жулька попыталась облизать мне лицо, когда я подхватил её на руки, но я увернулся."
    "Жулька паспрабавала аблізаць мне твар, калі я падхапіў яе на рукі, але я ўхіліўся."

# game/scripts/scene/scene_day_5.rpy:2358
translate belarusian phase1_zhulka_devend_3954762c:

    # voice "voice/anton/5day/020Tina.ogg"
    # Ant "Ты, наверное, проголодалась, девочка?"
    voice "voice/anton/5day/020Tina.ogg"
    Ant "Ты, напэўна, прагаладалася, дзяўчынка?"

# game/scripts/scene/scene_day_5.rpy:2392
translate belarusian phase1_zhulka_devend_a6360303:

    # "Я выпотрошил морозильник."
    "Я выпатрашыў маразільнік."

# game/scripts/scene/scene_day_5.rpy:2403
translate belarusian phase1_zhulka_devend_7ef0830e:

    # "Разорвал пакет с суповым набором и бросил собаке содержимое."
    "Разарваў пакет з супавым наборам і кінуў сабаку змесціва."

# game/scripts/scene/scene_day_5.rpy:2420
translate belarusian phase1_zhulka_devend_fbdfe3c9:

    # "Она недоверчиво обнюхала заледеневшие кости. Посмотрела на меня, чуя подвох."
    "Яна недаверліва абнюхала заледзянелыя косці. Паглядзела на мяне, чуючы падступства."

# game/scripts/scene/scene_day_5.rpy:2421
translate belarusian phase1_zhulka_devend_ef5cc566:

    # voice "voice/anton/5day/021esh.ogg"
    # Ant "Ешь, давай."
    voice "voice/anton/5day/021esh.ogg"
    Ant "Еш, давай."

# game/scripts/scene/scene_day_5.rpy:2428
translate belarusian phase1_zhulka_devend_9c3cd7b1:

    # "Газеты с мамиными кроссвордами послужили чем-то вроде клеёнки — я расстелил их на полу, чтобы его не испачкать."
    "Газеты з мамінымі красвордамі паслужылі чымсьці накшталт цыраты — я рассцяліў іх на падлозе, каб яе не запэцкаць."

# game/scripts/scene/scene_day_5.rpy:2432
translate belarusian phase1_zhulka_devend_ea067aa4:

    # "А вот вечно занятый папа так и не удосужился наточить ножи."
    "А вось вечна заняты тата так і не парупіўся навастрыць нажы."

# game/scripts/scene/scene_day_5.rpy:2439
translate belarusian phase1_zhulka_devend_6e9cc073:

    # "От мыслей, что извивающуюся Жульку придётся закалывать как свинью, мигом закружилась голова."
    "Ад думак, што Жульку, якая звіваецца, давядзецца заколваць як свінню, уміг закружылася галава."

# game/scripts/scene/scene_day_5.rpy:2443
translate belarusian phase1_zhulka_devend_11db1bf5:

    # voice "voice/anton/5day/022.ch.ogg"
    # Ant "Чем бы тебя таким, чтобы не мучилась..."
    voice "voice/anton/5day/022.ch.ogg"
    Ant "Чым бы цябе такім, каб не мучылася..."

# game/scripts/scene/scene_day_5.rpy:2445
translate belarusian phase1_zhulka_devend_05359f7b:

    # "Кто-то ухмыльнулся внутри меня."
    "Хтосьці пасміхнуўся ўнутры мяне."

# game/scripts/scene/scene_day_5.rpy:2449
translate belarusian phase1_zhulka_devend_3e1698bc:

    # voice "voice/anton/5day/023Tieto.ogg"
    # Ant "Ты это... постой тут."
    voice "voice/anton/5day/023Tieto.ogg"
    Ant "Ты гэта... пастой тут."

# game/scripts/scene/scene_day_5.rpy:2451
translate belarusian phase1_zhulka_devend_76aa69e8:

    # voice "voice/anton/5day/023po.ogg"
    # Ant "Я за топором схожу и убью тебя, хорошо?"
    voice "voice/anton/5day/023po.ogg"
    Ant "Я па сякеру схаджу і заб'ю цябе, добра?"

# game/scripts/scene/scene_day_5.rpy:2457
translate belarusian phase1_zhulka_devend_4f9c4ab0:

    # "Собака обречённо приступила к последнему ужину."
    "Сабака асуджана ўзяўся за апошнюю вячэру."

# game/scripts/scene/scene_day_5.rpy:2472
translate belarusian phase1_zhulka_devend_a011756c:

    # "Ноги прибавили по десяток кило каждая, пока я шаркал к чулану."
    "Ногі пацяжэлі на дзясятак кіло кожная, пакуль я шаргаў да каморы."

# game/scripts/scene/scene_day_5.rpy:2486
translate belarusian phase1_zhulka_devend_b451e4af:

    # "Вглядываясь в темноту, я боялся увидеть козлиное рыло перед собой, почуять вонь грязной шерсти, ощутить ледяные пальцы на шее."
    "Узіраючыся ў цемру, я баяўся ўбачыць казлінае рыла перад сабой, пачуць смурод бруднай поўсці, адчуць ледзяныя пальцы на шыі."

# game/scripts/scene/scene_day_5.rpy:2487
translate belarusian phase1_zhulka_devend_d10866c5:

    # "Чулан был пуст."
    "Камора была пустая."

# game/scripts/scene/scene_day_5.rpy:2488
translate belarusian phase1_zhulka_devend_6bd95844:

    # "Топор лежал остриём в мою сторону, отбрасывая зловещую тень."
    "Сякера ляжала вастрыём у мой бок, адкідаючы злавесны цень."

# game/scripts/scene/scene_day_5.rpy:2534
translate belarusian phase1_zhulka_devend_d43b38eb:

    # "Пальцы обхватили рукоять."
    "Пальцы абхапілі рукаяць."

# game/scripts/scene/scene_day_5.rpy:2535
translate belarusian phase1_zhulka_devend_5e81563e:

    # voice "voice/anton/5day/023.pom.ogg"
    # Ant "Помни... Собака или сестра."
    voice "voice/anton/5day/023.pom.ogg"
    Ant "Памятай... Сабака ці сястра."

# game/scripts/scene/scene_day_5.rpy:2557
translate belarusian phase1_zhulka_devend_3a17c4f7:

    # voice "voice/anton/5day/023.so.ogg"
    # Ant "Собака или я сам."
    voice "voice/anton/5day/023.so.ogg"
    Ant "Сабака ці я сам."

# game/scripts/scene/scene_day_5.rpy:2564
translate belarusian phase1_zhulka_devend_3d8c89fb:

    # "Как же я ненавидел себя, эту псину, которая была ни в чём не виновата, родителей, что уехали и бросили нас одних, зверей, которые не оставили выбора..."
    "Як жа я ненавідзеў сябе, гэтую псіну, якая была ні ў чым не вінаватая, бацькоў, што паехалі і кінулі нас адных, звяроў, якія не пакінулі выбару..."

# game/scripts/scene/scene_day_5.rpy:2565
translate belarusian phase1_zhulka_devend_ecfa8b48:

    # "Я ненавидел весь мир."
    "Я ненавідзеў увесь свет."

# game/scripts/scene/scene_day_5.rpy:2590
translate belarusian phase1_zhulka_devend_3fe29fef:

    # "С этой злостью и топором наперевес я вошёл на кухню совершить задуманное."
    "З гэтай злосцю і сякерай наперавес я ўвайшоў на кухню здзейсніць задуманае."

# game/scripts/scene/scene_day_5.rpy:2605
translate belarusian phase1_zhulka_devend_d3f930ec:

    # "Жулька привстала на задние лапы, когда Оля погладила её по загривку."
    "Жулька прыўстала на заднія лапы, калі Оля пагладзіла яе па загрыўку."

# game/scripts/scene/scene_day_5.rpy:2606
translate belarusian phase1_zhulka_devend_75ff9d28:

    # "При этом сестра опиралась на стол, чтобы не свалиться."
    "Пры гэтым сястра абапіралася на стол, каб не зваліцца."

# game/scripts/scene/scene_day_5.rpy:2613
translate belarusian phase1_zhulka_devend_a779352c:

    # "Я выронил инструмент и кинулся к обессиленной Оле."
    "Я ўпусціў інструмент і кінуўся да знясіленай Олі."

# game/scripts/scene/scene_day_5.rpy:2622
translate belarusian phase1_zhulka_devend_bb751df3:

    # voice "voice/anton/5day/026.ti.ogg"
    # Ant "Ты зачем встала?"
    voice "voice/anton/5day/026.ti.ogg"
    Ant "Ты навошта ўстала?"

# game/scripts/scene/scene_day_5.rpy:2626
translate belarusian phase1_zhulka_devend_9d5cd8e5:

    # voice "voice/olya/5day/08 Us.ogg"
    # Oly "Услышала... как собачка залаяла."
    voice "voice/olya/5day/08 Us.ogg"
    Oly "Пачула... як сабачка забрахаў."

# game/scripts/scene/scene_day_5.rpy:2630
translate belarusian phase1_zhulka_devend_64d06d04:

    # voice "voice/olya/5day/09 Mne.ogg"
    # Oly "Мне уже лучше."
    voice "voice/olya/5day/09 Mne.ogg"
    Oly "Мне ўжо лепш."

# game/scripts/scene/scene_day_5.rpy:2634
translate belarusian phase1_zhulka_devend_a8ab68d3:

    # voice "voice/anton/5day/027.ne.ogg"
    # Ant "Не обманывай! Скорее иди в кровать!"
    voice "voice/anton/5day/027.ne.ogg"
    Ant "Не падманвай! Хутчэй ідзі ў ложак!"

# game/scripts/scene/scene_day_5.rpy:2637
translate belarusian phase1_zhulka_devend_22936750:

    # voice "voice/olya/5day/10 Pr.ogg"
    # Oly "Правда лучше."
    voice "voice/olya/5day/10 Pr.ogg"
    Oly "Праўда лепш."

# game/scripts/scene/scene_day_5.rpy:2641
translate belarusian phase1_zhulka_devend_5d1f3ca1:

    # "Она отпустила край столешницы и улыбнулась, доказывая, что не собирается грохнуться в обморок."
    "Яна адпусціла край стальніцы і ўсміхнулася, даказваючы, што не збіраецца грымнуцца без прытомнасці."

# game/scripts/scene/scene_day_5.rpy:2642
translate belarusian phase1_zhulka_devend_0240b449:

    # "Щёки её порозовели."
    "Шчокі яе паружавелі."

# game/scripts/scene/scene_day_5.rpy:2665
translate belarusian phase1_zhulka_devend_7c2cbc4d:

    # voice "voice/anton/5day/028.Ya.ogg"
    # "Я вздохнул, касаясь прохладного лба сестры."
    voice "voice/anton/5day/028.Ya.ogg"
    "Я ўздыхнуў, дакранаючыся да прахалоднага лба сястры."

# game/scripts/scene/scene_day_5.rpy:2668
translate belarusian phase1_zhulka_devend_c1a77f11:

    # "Понял, что убью кого угодно, лишь бы её обезопасить."
    "Зразумеў, што заб'ю каго заўгодна, абы яе ўбяспечыць."

# game/scripts/scene/scene_day_5.rpy:2674
translate belarusian phase1_zhulka_devend_f9ff7081:

    # voice "voice/olya/5day/11 Aot.ogg"
    # Oly "А откуда взялась собачка? Она теперь наша?"
    voice "voice/olya/5day/11 Aot.ogg"
    Oly "А адкуль узяўся сабачка? Ён цяпер наш?"

# game/scripts/scene/scene_day_5.rpy:2679
translate belarusian phase1_zhulka_devend_c71ae78d:

    # "Я стыдливо загородил собой брошенный топор."
    "Я сарамліва засланіў сабой кінутую сякеру."

# game/scripts/scene/scene_day_5.rpy:2681
translate belarusian phase1_zhulka_devend_3d73a987:

    # voice "voice/anton/5day/029.Za.ogg"
    # Ant "Забежала погреться. Погреется и уйдёт."
    voice "voice/anton/5day/029.Za.ogg"
    Ant "Яна забегла пагрэцца. Пагрэецца і пойдзе."

# game/scripts/scene/scene_day_5.rpy:2683
translate belarusian phase1_zhulka_devend_4be77b97:

    # voice "voice/anton/5day/030.un.ogg"
    # Ant "У неё щенки, ей нужно к ним возвращаться."
    voice "voice/anton/5day/030.un.ogg"
    Ant "У яе шчаняты, ёй трэба да іх вяртацца."

# game/scripts/scene/scene_day_5.rpy:2695
translate belarusian phase1_zhulka_devend_486afaa5:

    # voice "voice/olya/5day/12 Mi.ogg"
    # Oly "Мы и щенков можем к себе взять. Будет классно!"
    voice "voice/olya/5day/12 Mi.ogg"
    Oly "Мы і шчанят можам да сябе ўзяць. Будзе класна!"

# game/scripts/scene/scene_day_5.rpy:2698
translate belarusian phase1_zhulka_devend_4bc66adf:

    # voice "voice/anton/5day/030.ne.ogg"
    # Ant "Не думаю, что маме понравится эта идея."
    voice "voice/anton/5day/030.ne.ogg"
    Ant "Не думаю, што маме спадабаецца гэтая ідэя."

# game/scripts/scene/scene_day_5.rpy:2701
translate belarusian phase1_zhulka_devend_d2fe6edc:

    # voice "voice/olya/5day/13 Am.ogg"
    # Oly "А мы её сильно попросим."
    voice "voice/olya/5day/13 Am.ogg"
    Oly "А мы яе вельмі папросім."

# game/scripts/scene/scene_day_5.rpy:2711
translate belarusian phase1_zhulka_devend_09ddd1b6:

    # "Дворняга льнула к Олиным ногам."
    "Дварняга тулілася да Оліных ног."

# game/scripts/scene/scene_day_5.rpy:2712
translate belarusian phase1_zhulka_devend_4ee2fd40:

    # voice "voice/anton/5day/031.da.ogg"
    # Ant "Да она блохастая. Фу, Жулька!"
    voice "voice/anton/5day/031.da.ogg"
    Ant "Ды яна блахастая. Фу, Жулька!"

# game/scripts/scene/scene_day_5.rpy:2714
translate belarusian phase1_zhulka_devend_bd4b49e8:

    # voice "voice/olya/5day/14 Ee.ogg"
    # Oly "Её Жулька зовут?"
    voice "voice/olya/5day/14 Ee.ogg"
    Oly "Яе Жулька завуць?"

# game/scripts/scene/scene_day_5.rpy:2721
translate belarusian phase1_zhulka_devend_a3612b8e:

    # voice "voice/olya/5day/15 Zu.ogg"
    # Oly "Жулечка! Ты теперь наша."
    voice "voice/olya/5day/15 Zu.ogg"
    Oly "Жулечка! Ты цяпер наша."

# game/scripts/scene/scene_day_5.rpy:2737
translate belarusian phase1_zhulka_devend_20e6d0a7:

    # voice "voice/olya/5day/16 Ne.ogg"
    # Oly "Не бойся, маленькая, тебя у нас никто не обидит."
    voice "voice/olya/5day/16 Ne.ogg"
    Oly "Не бойся, маленькая, цябе ў нас ніхто не пакрыўдзіць."

# game/scripts/scene/scene_day_5.rpy:2759
translate belarusian phase1_zhulka_devend_704f6290:

    # "Оля вытащила из холодильника сосиску и бросила собаке. {nw}"
    "Оля выцягнула з халадзільніка сасіску і кінула сабаку. {nw}"

# game/scripts/scene/scene_day_5.rpy:2763
translate belarusian phase1_zhulka_devend_f5fb0317:

    # extend "Та живо зачавкала угощением, хотя я уже скормил ей целый суповой набор."
    extend "Тая жвава заплямкала пачастункам, хоць я ўжо скарміў ёй цэлы супавы набор."

# game/scripts/scene/scene_day_5.rpy:2770
translate belarusian phase1_zhulka_devend_1a38b88a:

    # voice "voice/anton/5day/032.ya.ogg"
    # Ant "Я бы на твоём месте всё-таки подремал."
    voice "voice/anton/5day/032.ya.ogg"
    Ant "Я б на тваім месцы ўсё ж такі падрамаў."

# game/scripts/scene/scene_day_5.rpy:2772
translate belarusian phase1_zhulka_devend_d3235530:

    # voice "voice/anton/5day/032.ma.ogg"
    # Ant "Скоро папа врача привезёт, а мама — лекарства."
    voice "voice/anton/5day/032.ma.ogg"
    Ant "Хутка тата доктара прывязе, а мама — лекі."

# game/scripts/scene/scene_day_5.rpy:2776
translate belarusian phase1_zhulka_devend_1ff4dbfe:

    # voice "voice/olya/5day/17 Ya.ogg"
    # Oly "Я больше не хочу спать. Мне кошмар снился."
    voice "voice/olya/5day/17 Ya.ogg"
    Oly "Я больш не хачу спаць. Мне кашмар сніўся."

# game/scripts/scene/scene_day_5.rpy:2779
translate belarusian phase1_zhulka_devend_958c039c:

    # "Она говорила медленно, потупившись."
    "Яна гаварыла павольна, патупіўшыся."

# game/scripts/scene/scene_day_5.rpy:2780
translate belarusian phase1_zhulka_devend_7176bf8c:

    # voice "voice/anton/5day/033.da.ogg"
    # Ant "Да, знаю."
    voice "voice/anton/5day/033.da.ogg"
    Ant "Так, ведаю."

# game/scripts/scene/scene_day_5.rpy:2783
translate belarusian phase1_zhulka_devend_103a3348:

    # voice "voice/olya/5day/18 Av.ogg"
    # Oly "А вот и не знаешь!"
    voice "voice/olya/5day/18 Av.ogg"
    Oly "А вось і не ведаеш!"

# game/scripts/scene/scene_day_5.rpy:2787
translate belarusian phase1_zhulka_devend_6d52db11:

    # voice "voice/olya/5day/19 Ti.ogg"
    # Oly "Ты хоть и был в этом сне, но откуда тебе знать?"
    voice "voice/olya/5day/19 Ti.ogg"
    Oly "Ты хоць і быў у гэтым сне, але адкуль табе ведаць?"

# game/scripts/scene/scene_day_5.rpy:2791
translate belarusian phase1_zhulka_devend_425ae92c:

    # voice "voice/olya/5day/20 Aya.ogg"
    # Oly "А я про него рассказывать не буду."
    voice "voice/olya/5day/20 Aya.ogg"
    Oly "А я пра яго расказваць не буду."

# game/scripts/scene/scene_day_5.rpy:2795
translate belarusian phase1_zhulka_devend_b13ed5e4:

    # voice "voice/olya/5day/21 Po.ogg"
    # Oly "Потому что сон был очень плохим. Но теперь..."
    voice "voice/olya/5day/21 Po.ogg"
    Oly "Таму што сон быў вельмі дрэнны. Але цяпер..."

# game/scripts/scene/scene_day_5.rpy:2799
translate belarusian phase1_zhulka_devend_bd84fa16:

    # "Лицо Оли просветлело, на губах возникла улыбка."
    "Твар Олі прасвятлеў, на вуснах з'явілася ўсмешка."

# game/scripts/scene/scene_day_5.rpy:2810
translate belarusian phase1_zhulka_devend_0dce5dd3:

    # voice "voice/olya/5day/22 Tep.ogg"
    # Oly "Теперь у меня есть Жулька, и всё будет хорошо."
    voice "voice/olya/5day/22 Tep.ogg"
    Oly "Цяпер у мяне ёсць Жулька, і ўсё будзе добра."

# game/scripts/scene/scene_day_5.rpy:2814
translate belarusian phase1_zhulka_devend_a7f2d217:

    # voice "voice/olya/5day/23 Ona.ogg"
    # Oly "Она залает, если прилетит страшная сова, а мы проснёмся и спрячемся."
    voice "voice/olya/5day/23 Ona.ogg"
    Oly "Яна забрэша, калі прыляціць страшная сава, а мы прачнёмся і схаваемся."

# game/scripts/scene/scene_day_5.rpy:2818
translate belarusian phase1_zhulka_devend_a36051ef:

    # voice "voice/olya/5day/24 E.ogg"
    # Oly "И тогда нас не найдут."
    voice "voice/olya/5day/24 E.ogg"
    Oly "І тады нас не знойдуць."

# game/scripts/scene/scene_day_5.rpy:2821
translate belarusian phase1_zhulka_devend_52ad5b71:

    # voice "voice/anton/5day/034.ol.ogg"
    # Ant "Оль, вряд ли эта шавка нас защитит."
    voice "voice/anton/5day/034.ol.ogg"
    Ant "Оль, наўрад ці гэтая шаўка нас абароніць."

# game/scripts/scene/scene_day_5.rpy:2823
translate belarusian phase1_zhulka_devend_f98de6cd:

    # "Но переубедить сестру было уже невозможно."
    "Але пераканаць сястру было ўжо немагчыма."

# game/scripts/scene/scene_day_5.rpy:2825
translate belarusian phase1_zhulka_devend_c3cd3c89:

    # voice "voice/olya/5day/25 Es.ogg"
    # Oly "Ещё как защитит!"
    voice "voice/olya/5day/25 Es.ogg"
    Oly "Яшчэ як абароніць!"

# game/scripts/scene/scene_day_5.rpy:2829
translate belarusian phase1_zhulka_devend_bd41e5ea:

    # voice "voice/olya/5day/26 Ti.ogg"
    # Oly "Ты же защитишь, правда? Правда, маленькая?!"
    voice "voice/olya/5day/26 Ti.ogg"
    Oly "Ты ж абароніш, праўда? Праўда, маленькая?!"

# game/scripts/scene/scene_day_5.rpy:2838
translate belarusian phase1_zhulka_devend_50aa8006:

    # "Дворняжка одобрительно залаяла."
    "Дварняжка ўхвальна забрахала."

# game/scripts/scene/scene_day_5.rpy:2848
translate belarusian phase1_zhulka_devend_c4815def:

    # voice "voice/olya/5day/28 Um.ogg"
    # Oly "У меня для тебя кое-что есть. Я сейчас!"
    voice "voice/olya/5day/28 Um.ogg"
    Oly "У мяне для цябе сёе-тое ёсць. Я зараз!"

# game/scripts/scene/scene_day_5.rpy:2874
translate belarusian phase1_zhulka_devend_75d5bca4:

    # "Оля побежала к лестнице. Заскрипели ступеньки."
    "Оля пабегла да лесвіцы. Зарыпелі прыступкі."

# game/scripts/scene/scene_day_5.rpy:2875
translate belarusian phase1_zhulka_devend_76f88768:

    # voice "voice/anton/5day/035.ost.ogg"
    # Ant "Осторожнее!"
    voice "voice/anton/5day/035.ost.ogg"
    Ant "Асцярожней!"

# game/scripts/scene/scene_day_5.rpy:2877
translate belarusian phase1_zhulka_devend_372ec0bc:

    # voice "voice/olya/5day/29 Ya.ogg"
    # Oly "Я скоро! Присмотри за Жулькой!"
    voice "voice/olya/5day/29 Ya.ogg"
    Oly "Я хутка! Прыгледзь за Жулькай!"

# game/scripts/scene/scene_day_5.rpy:2885
translate belarusian phase1_zhulka_devend_a08bc342:

    # "Поражённый тем, какой бодрой была Оля, бредившая совсем недавно, я покосился на псину."
    "Уражаны тым, якая бадзёрая была Оля, што зусім нядаўна трызніла, я скасавурыўся на псіну."

# game/scripts/scene/scene_day_5.rpy:2889
translate belarusian phase1_zhulka_devend_2f111f60:

    # "Жулька доела сосиску и теперь вылизывала пол."
    "Жулька даела сасіску і цяпер вылізвала падлогу."

# game/scripts/scene/scene_day_5.rpy:2904
translate belarusian phase1_zhulka_devend_dfc8a6f3:

    # voice "voice/anton/5day/036.vdr.ogg"
    # Ant "В друзья набиваешься, да?"
    voice "voice/anton/5day/036.vdr.ogg"
    Ant "У сябры набіваешся, так?"

# game/scripts/scene/scene_day_5.rpy:2907
translate belarusian phase1_zhulka_devend_37034086:

    # "Я был единственным другом Оли."
    "Я быў адзіным сябрам Олі."

# game/scripts/scene/scene_day_5.rpy:2908
translate belarusian phase1_zhulka_devend_ebd22219:

    # "Тем, кто мог её спасти. Хотя бы попытаться."
    "Тым, хто мог яе выратаваць. Хаця б паспрабаваць."

# game/scripts/scene/scene_day_5.rpy:2909
translate belarusian phase1_zhulka_devend_60ed276e:

    # "Но для этого..."
    "Але для гэтага..."

# game/scripts/scene/scene_day_5.rpy:2911
translate belarusian phase1_zhulka_devend_8923f3f3:

    # "Я поднял топор с пола."
    "Я падняў сякеру з падлогі."

# game/scripts/scene/scene_day_5.rpy:2919
translate belarusian phase1_zhulka_devend_399449b6:

    # "Жулька словно что-то почуяла и со всех ног рванула вслед за Олей. Но я преградил ей путь к лестнице."
    "Жулька быццам нешта зачула і з усіх ног рванула следам за Оляй. Але я перагарадзіў ёй шлях да лесвіцы."

# game/scripts/scene/scene_day_5.rpy:2931
translate belarusian phase1_zhulka_devend_7ac512f7:

    # voice "voice/anton/5day/037.Un.ogg"
    # Ant "У нас мало времени. Оля скоро вернётся."
    voice "voice/anton/5day/037.Un.ogg"
    Ant "У нас мала часу. Оля хутка вернецца."

# game/scripts/scene/scene_day_5.rpy:2948
translate belarusian phase1_zhulka_devend_d3f80f23:

    # "Я сжал покрепче топор. Казалось, он весил тонну."
    "Я сціснуў мацней сякеру. Здавалася, яна важыла тону."

# game/scripts/scene/scene_day_5.rpy:2949
translate belarusian phase1_zhulka_devend_daf7f0d3:

    # "Собачонка следила за моими действиями."
    "Сабачка сачыў за маімі дзеяннямі."

# game/scripts/scene/scene_day_5.rpy:2959
translate belarusian phase1_zhulka_devend_f3f68e1f:

    # voice "voice/anton/5day/038.ne.ogg"
    # Ant "Не бойся..."
    voice "voice/anton/5day/038.ne.ogg"
    Ant "Не бойся..."

# game/scripts/scene/scene_day_5.rpy:2961
translate belarusian phase1_zhulka_devend_6b429c3c:

    # voice "voice/anton/5day/038.Ya.ogg"
    # Ant "Я знаю, что все собаки попадают в рай."
    voice "voice/anton/5day/038.Ya.ogg"
    Ant "Я ведаю, што ўсе сабакі трапляюць у рай."

# game/scripts/scene/scene_day_5.rpy:2983
translate belarusian phase1_zhulka_devend_26c422af:

    # "Хвост прыгал из стороны в сторону."
    "Хвост скакаў з боку ў бок."

# game/scripts/scene/scene_day_5.rpy:2984
translate belarusian phase1_zhulka_devend_0b5ab561:

    # voice "voice/anton/5day/039.Da.ogg"
    # Ant "Да не будь же ты такой милой!"
    voice "voice/anton/5day/039.Da.ogg"
    Ant "Ды не будзь жа ты такой мілай!"

# game/scripts/scene/scene_day_5.rpy:3040
translate belarusian zhulka_mercy_12e586a9:

    # "Что я делаю?"
    "Што я раблю?"

# game/scripts/scene/scene_day_5.rpy:3042
translate belarusian zhulka_mercy_e1d9b438:

    # "Чем я буду лучше школьных садистов, если причиню вред невинной собачонке? Когда она смотрит такими умными глазками..."
    "Чым я буду лепшы за школьных садзістаў, калі прычыню шкоду нявіннаму сабачку? Калі яна глядзіць такімі разумнымі вочкамі..."

# game/scripts/scene/scene_day_5.rpy:3043
translate belarusian zhulka_mercy_c29b5b3f:

    # voice "voice/anton/5day/040.Ne.ogg"
    # Ant "Не могу!"
    voice "voice/anton/5day/040.Ne.ogg"
    Ant "Не магу!"

# game/scripts/scene/scene_day_5.rpy:3081
translate belarusian zhulka_mercy_b4f0c4e2:

    # "Я устало обронил топор."
    "Я стомлена ўпусціў сякеру."

# game/scripts/scene/scene_day_5.rpy:3083
translate belarusian zhulka_mercy_4127f68e:

    # "Пот струился под одеждой, дыхание сбилось, будто я пробежал стометровку."
    "Пот струменіўся пад вопраткай, дыханне збілася, быццам я прабег стаметроўку."

# game/scripts/scene/scene_day_5.rpy:3084
translate belarusian zhulka_mercy_a4aa3b06:

    # voice "voice/anton/5day/043.Yane.ogg"
    # Ant "Я не убийца."
    voice "voice/anton/5day/043.Yane.ogg"
    Ant "Я не забойца."

# game/scripts/scene/scene_day_5.rpy:3098
translate belarusian zhulka_mercy_b7200c39:

    # "Жулька тявкнула, как бы одобряя моё решение."
    "Жулька цяўкнула, нібыта ўхваляючы маё рашэнне."

# game/scripts/scene/scene_day_5.rpy:3115
translate belarusian zhulka_mercy_bca7ab6f:

    # voice "voice/olya/5day/30 Y.ogg"
    # Oly "Я принесла игрушки для собачки!"
    voice "voice/olya/5day/30 Y.ogg"
    Oly "Я прынесла цацкі для сабачкі!"

# game/scripts/scene/scene_day_5.rpy:3118
translate belarusian zhulka_mercy_c9f4542f:

    # "Оля вприпрыжку спускалась с лестницы. В одном кулачке зажата пёстрая лента, в другом резиновый мячик."
    "Оля ўпадскокі спускалася з лесвіцы. У адным кулачку заціснута пярэстая стужка, у другім — гумавы мячык."

# game/scripts/scene/scene_day_5.rpy:3122
translate belarusian zhulka_mercy_4b7e1f01:

    # "Ступнёй я задвинул топор под телефонную тумбу и наблюдал с горькой усмешкой, как сестра ахает умилённо."
    "Ступнёй я засунуў сякеру пад тэлефонную тумбу і назіраў з горкай усмешкай, як сястра разчулена ахае."

# game/scripts/scene/scene_day_5.rpy:3128
translate belarusian zhulka_mercy_31db493e:

    # voice "voice/olya/5day/31 Ti.ogg"
    # Oly "Ты теперь в безопасности!"
    voice "voice/olya/5day/31 Ti.ogg"
    Oly "Ты цяпер у бяспецы!"

# game/scripts/scene/scene_day_5.rpy:3145
translate belarusian zhulka_mercy_4e612dc2:

    # "А как же мы?"
    "А як жа мы?"

# game/scripts/scene/scene_day_5.rpy:3146
translate belarusian zhulka_mercy_d6bd749d:

    # "Стёкла казались такими хрупкими, тени снаружи — такими живыми."
    "Шыбы здаваліся такімі крохкімі, цені звонку — такімі жывымі."

# game/scripts/scene/scene_day_5.rpy:3155
translate belarusian zhulka_mercy_a109a9d0:

    # "Оля повязала вокруг собачьей шеи ленту, как импровизированный ошейник."
    "Оля павязала вакол сабачай шыі стужку, як імправізаваны ашыйнік."

# game/scripts/scene/scene_day_5.rpy:3159
translate belarusian zhulka_mercy_1f36344e:

    # "Затем Жулька догоняла мячик, скаля в собачьей радости пасть, а Оля смеялась."
    "Потым Жулька даганяла мячык, шчэрачы ў сабачай радасці пашчу, а Оля смяялася."

# game/scripts/scene/scene_day_5.rpy:3161
translate belarusian zhulka_mercy_cf1673e8:

    # "И смех сестры для меня был бесценен даже сейчас."
    "І смех сястры для мяне быў бясцэнны нават цяпер."

# game/scripts/scene/scene_day_5.rpy:3169
translate belarusian zhulka_mercy_d80f1dc5:

    # "Словно ничего не произошло, а родители вот-вот вернутся, и температура отступит…"
    "Быццам нічога не здарылася, а бацькі вось-вось вернуцца, і тэмпература адступіць..."

# game/scripts/scene/scene_day_5.rpy:3170
translate belarusian zhulka_mercy_8b663e0e:

    # "И никакого Чёрного гаража нет и в помине."
    "І ніякага Чорнага гаража і ў паміне няма."

# game/scripts/scene/scene_day_5.rpy:3173
translate belarusian zhulka_mercy_c315e2f6:

    # voice "voice/olya/5day/33 Poc.ogg"
    # Oly "Почему нельзя превращаться в собак?"
    voice "voice/olya/5day/33 Poc.ogg"
    Oly "Чаму нельга ператварацца ў сабак?"

# game/scripts/scene/scene_day_5.rpy:3177
translate belarusian zhulka_mercy_dbfbc337:

    # voice "voice/olya/5day/34 El.ogg"
    # Oly "Или в других зверюшек. Гулять, резвиться!"
    voice "voice/olya/5day/34 El.ogg"
    Oly "Ці ў іншых звярушак. Гуляць, гарэзаваць!"

# game/scripts/scene/scene_day_5.rpy:3180
translate belarusian zhulka_mercy_56e3ce73:

    # "Дурное чувство шевельнулось под сердцем."
    "Нядобрае пачуццё варухнулася пад сэрцам."

# game/scripts/scene/scene_day_5.rpy:3181
translate belarusian zhulka_mercy_b4a5fcee:

    # voice "voice/anton/5day/044.Po.ogg"
    # Ant "Потому что мы — люди."
    voice "voice/anton/5day/044.Po.ogg"
    Ant "Таму што мы — людзі."

# game/scripts/scene/scene_day_5.rpy:3185
translate belarusian zhulka_mercy_d0567841:

    # voice "voice/olya/5day/36 Scu.ogg"
    # Oly "Скучно!"
    voice "voice/olya/5day/36 Scu.ogg"
    Oly "Нудна!"

# game/scripts/scene/scene_day_5.rpy:3200
translate belarusian zhulka_mercy_f69c0773:

    # "Оля похлопала по полу."
    "Оля папляскала па падлозе."

# game/scripts/scene/scene_day_5.rpy:3202
translate belarusian zhulka_mercy_aa36408a:

    # voice "voice/olya/5day/37 Sid.ogg"
    # Oly "Сидеть!"
    voice "voice/olya/5day/37 Sid.ogg"
    Oly "Сядзець!"

# game/scripts/scene/scene_day_5.rpy:3216
translate belarusian zhulka_mercy_221a317f:

    # "Жулька непонимающе тявкнула."
    "Жулька неўразумела цяўкнула."

# game/scripts/scene/scene_day_5.rpy:3217
translate belarusian zhulka_mercy_3a63f5dd:

    # voice "voice/anton/5day/045.Ne.ogg"
    # Ant "Не работать ей в цирке."
    voice "voice/anton/5day/045.Ne.ogg"
    Ant "Не працаваць ёй у цырку."

# game/scripts/scene/scene_day_5.rpy:3219
translate belarusian zhulka_mercy_4be75f5b:

    # voice "voice/olya/5day/38 Ya.ogg"
    # Oly "Я её всем командам обучу, вот увидишь!"
    voice "voice/olya/5day/38 Ya.ogg"
    Oly "Я яе ўсім камандам навучу, вось пабачыш!"

# game/scripts/scene/scene_day_5.rpy:3233
translate belarusian zhulka_mercy_4151b1bc:

    # "Сестра зевнула и легла на бок, прямо на пол. Мячик медленно покатился, приманивая глупую собачонку."
    "Сястра пазяхнула і лягла на бок, проста на падлогу. Мячык павольна пакаціўся, прыманьваючы дурнога сабачку."

# game/scripts/scene/scene_day_5.rpy:3239
translate belarusian zhulka_mercy_16c41143:

    # voice "voice/olya/5day/39 Kak.ogg"
    # Oly "Как спать... хочется."
    voice "voice/olya/5day/39 Kak.ogg"
    Oly "Як спаць... хочацца."

# game/scripts/scene/scene_day_5.rpy:3241
translate belarusian zhulka_mercy_eb2b9cae:

    # "Она смежила веки и тут же уснула."
    "Яна заплюшчыла павекі і тут жа заснула."

# game/scripts/scene/scene_day_5.rpy:3245
translate belarusian zhulka_mercy_807a2ad6:

    # "Я склонился, потрогал лоб. Снова горячий."
    "Я схіліўся, памацаў лоб. Зноў гарачы."

# game/scripts/scene/scene_day_5.rpy:3251
translate belarusian zhulka_mercy_6679f1a9:

    # voice "voice/anton/5day/046.St.ogg"
    # Ant "Сторожи свою хозяйку. Ты ей жизнью обязана."
    voice "voice/anton/5day/046.St.ogg"
    Ant "Сцеражы сваю гаспадыню. Ты ёй жыццём абавязана."

# game/scripts/scene/scene_day_5.rpy:3253
translate belarusian zhulka_mercy_f16cebfa:

    # "Команда адресовалась Жульке."
    "Каманда адрасавалася Жульцы."

# game/scripts/scene/scene_day_5.rpy:3259
translate belarusian zhulka_mercy_04827643:

    # "Собака легкомысленно обнюхивала мою штанину. Не догадывалась, что была на волоске от смерти."
    "Сабака легкадумна абнюхваў маю калашыну. Не здагадваўся, што быў на валасок ад смерці."

# game/scripts/scene/scene_day_5.rpy:3270
translate belarusian zhulka_mercy_3c117547:

    # "Я сбегал на второй этаж, притащил одеяло и подушку."
    "Я збегаў на другі паверх, прыцягнуў коўдру і падушку."

# game/scripts/scene/scene_day_5.rpy:3277
translate belarusian zhulka_mercy_fe271b9e:

    # "Пускай сестра спит здесь, под моим присмотром, а я покараулю."
    "Няхай сястра спіць тут, пад маім наглядам, а я павартую."

# game/scripts/scene/scene_day_5.rpy:3278
translate belarusian zhulka_mercy_6f1bd1c5:

    # "Мало ли, кто может постучать к ней в детскую..."
    "Ці мала хто можа пагрукаць да яе ў дзіцячую..."

# game/scripts/scene/scene_day_5.rpy:3286
translate belarusian zhulka_mercy_4451b171:

    # "Я укрыл сестру — она зачмокала во сне."
    "Я накрыў сястру — яна зацмокала ў сне."

# game/scripts/scene/scene_day_5.rpy:3287
translate belarusian zhulka_mercy_155e9f54:

    # "Погладил по тонкому предплечью."
    "Пагладзіў па тонкім перадплеччы."

# game/scripts/scene/scene_day_5.rpy:3291
translate belarusian zhulka_mercy_be4bf7d0:

    # "Рядом свернулась калачиком Жулька и громко засопела."
    "Побач згарнулася калачыкам Жулька і гучна засапла."

# game/scripts/scene/scene_day_5.rpy:3292
translate belarusian zhulka_mercy_e0d5df3f:

    # voice "voice/anton/5day/45 no.ogg"
    # "Внутренний голос шепнул: {i}«Ночь будет долгой».{/i}"
    voice "voice/anton/5day/45 no.ogg"
    "Унутраны голас шапнуў: {i}«Ноч будзе доўгай».{/i}"

# game/scripts/scene/scene_day_5.rpy:3329
translate belarusian zhulka_kill_6473e209:

    # "Я занёс топор."
    "Я занёс сякеру."

# game/scripts/scene/scene_day_5.rpy:3330
translate belarusian zhulka_kill_ad73f050:

    # "Представил чаши весов, где на одной — безродная псина, на другой — жизни моих родных."
    "Уявіў чашы вагаў, дзе на адной — бязродная псіна, на другой — жыцці маіх родных."

# game/scripts/scene/scene_day_5.rpy:3332
translate belarusian zhulka_kill_ab0415f0:

    # "Фантазия рисовала картину: буран отрезал нас от цивилизации, и теперь придётся выживать самостоятельно, как Робинзону Крузо на необитаемом острове."
    "Фантазія малявала карціну: буран адрэзаў нас ад цывілізацыі, і цяпер давядзецца выжываць самастойна, як Рабінзону Круза на бязлюдным востраве."

# game/scripts/scene/scene_day_5.rpy:3333
translate belarusian zhulka_kill_ff66ffc9:

    # "Он бы не мешкая убил животное, чтобы себя прокормить."
    "Ён бы не марудзячы забіў жывёліну, каб сябе пракарміць."

# game/scripts/scene/scene_day_5.rpy:3334
translate belarusian zhulka_kill_519c454d:

    # "Жулька... просто еда."
    "Жулька... проста ежа."

# game/scripts/scene/scene_day_5.rpy:3335
translate belarusian zhulka_kill_54e4e715:

    # voice "voice/anton/5day/048.Myaso.ogg"
    # Ant "МЯСО!"
    voice "voice/anton/5day/048.Myaso.ogg"
    Ant "МЯСА!"

# game/scripts/scene/scene_day_5.rpy:3337
translate belarusian zhulka_kill_b4ad1ff2:

    # "Топор описал дугу."
    "Сякера апісала дугу."

# game/scripts/scene/scene_day_5.rpy:3359
translate belarusian zhulka_kill_aff2c614:

    # "Хрустнуло."
    "Хруснула."

# game/scripts/scene/scene_day_5.rpy:3375
translate belarusian zhulka_kill_f3196286:

    # "Горячие капли оросили моё лицо, а собачонка не успела завыть."
    "Гарачыя кроплі арасілі мой твар, а сабачка не паспеў завыць."

# game/scripts/scene/scene_day_5.rpy:3388
translate belarusian zhulka_kill_b5deed44:

    # "Зато завыла Оля."
    "Затое завыла Оля."

# game/scripts/scene/scene_day_5.rpy:3411
translate belarusian zhulka_kill_675d8394:

    # "Страшно, скрипуче, она вопила, прижав к щекам кулачки."
    "Страшна, скрыпуча, яна лямантавала, прыціснуўшы да шчок кулачкі."

# game/scripts/scene/scene_day_5.rpy:3412
translate belarusian zhulka_kill_3edb3575:

    # "В одном из них был зажата пёстрая лента — импровизированный ошейник."
    "У адным з іх была заціснута пярэстая стужка — імправізаваны ашыйнік."

# game/scripts/scene/scene_day_5.rpy:3413
translate belarusian zhulka_kill_808ed111:

    # "Подарок, предназначавшийся собаке, нынче утративший надобность."
    "Падарунак, які прызначаўся сабаку, а цяпер стаў непатрэбным."

# game/scripts/scene/scene_day_5.rpy:3414
translate belarusian zhulka_kill_295e6b5c:

    # "Сердце кольнула досада."
    "Сэрца кальнула прыкрасць."

# game/scripts/scene/scene_day_5.rpy:3438
translate belarusian zhulka_kill_00229394:

    # voice "voice/anton/5day/049.Ol.ogg"
    # Ant "Оль!"
    voice "voice/anton/5day/049.Ol.ogg"
    Ant "Оль!"

# game/scripts/scene/scene_day_5.rpy:3449
translate belarusian zhulka_kill_30604f9e:

    # "Я шагнул к сестре, которая стояла за моей спиной и всё видела."
    "Я ступіў да сястры, якая стаяла за маёй спінай і ўсё бачыла."

# game/scripts/scene/scene_day_5.rpy:3450
translate belarusian zhulka_kill_191db680:

    # "Видела бессмысленное убийство четвероногого друга."
    "Бачыла бессэнсоўнае забойства чатырохногага сябра."

# game/scripts/scene/scene_day_5.rpy:3457
translate belarusian zhulka_kill_76a515f6:

    # "Лента выпала из её руки."
    "Стужка выпала з яе рукі."

# game/scripts/scene/scene_day_5.rpy:3459
translate belarusian zhulka_kill_266d065b:

    # voice "voice/olya/5day/44 Tie.ogg"
    # Oly "Ты... её... топором."
    voice "voice/olya/5day/44 Tie.ogg"
    Oly "Ты... яе... сякерай."

# game/scripts/scene/scene_day_5.rpy:3463
translate belarusian zhulka_kill_5c9edf3e:

    # "Она сморщилась. Слёзы заволокли глаза."
    "Яна зморшчылася. Слёзы заслалі вочы."

# game/scripts/scene/scene_day_5.rpy:3466
translate belarusian zhulka_kill_b25120bb:

    # "Взгляд Оли был полон удивления и ужаса. Она боялась."
    "Позірк Олі быў поўны здзіўлення і жаху. Яна баялася."

# game/scripts/scene/scene_day_5.rpy:3467
translate belarusian zhulka_kill_5e7a7cd0:

    # "Боялась меня, словно я был маньяком, психом, убивающим животных ради развлечения."
    "Баялася мяне, быццам я быў маньякам, псіхам, які забівае жывёл дзеля забавы."

# game/scripts/scene/scene_day_5.rpy:3469
translate belarusian zhulka_kill_3954d529:

    # voice "voice/olya/5day/45 Za.ogg"
    # Oly "Зачем?!"
    voice "voice/olya/5day/45 Za.ogg"
    Oly "Навошта?!"

# game/scripts/scene/scene_day_5.rpy:3475
translate belarusian zhulka_kill_d0d9bb87:

    # "Я провёл по липкому лицу пятернёй."
    "Я правёў па ліпкім твары пяцярнёй."

# game/scripts/scene/scene_day_5.rpy:3476
translate belarusian zhulka_kill_1bc34948:

    # voice "voice/anton/5day/050.Da.ogg"
    # Ant "Да пойми ты."
    voice "voice/anton/5day/050.Da.ogg"
    Ant "Ды зразумей ты."

# game/scripts/scene/scene_day_5.rpy:3482
translate belarusian zhulka_kill_37574d5d:

    # voice "voice/olya/5day/46 Ne.ogg"
    # Oly "Не тронь меня!"
    voice "voice/olya/5day/46 Ne.ogg"
    Oly "Не чапай мяне!"

# game/scripts/scene/scene_day_5.rpy:3485
translate belarusian zhulka_kill_dffb685a:

    # "Она буквально захлёбывалась слезами."
    "Яна літаральна захлыналася слязамі."

# game/scripts/scene/scene_day_5.rpy:3486
translate belarusian zhulka_kill_05518e7b:

    # voice "voice/anton/5day/051Ol.ogg"
    # Ant "Оленька."
    voice "voice/anton/5day/051Ol.ogg"
    Ant "Оленька."

# game/scripts/scene/scene_day_5.rpy:3489
translate belarusian zhulka_kill_2d410520:

    # voice "voice/olya/5day/47 T.ogg"
    # Oly "Ты чудовище! Такой же, как те, которые ночью придут!"
    voice "voice/olya/5day/47 T.ogg"
    Oly "Ты пачвара! Такі ж, як тыя, што ноччу прыйдуць!"

# game/scripts/scene/scene_day_5.rpy:3524
translate belarusian zhulka_kill_241da6b2:

    # "Я потянулся к сестре, но та лишь сильнее заверещала, заметив кровь на моих руках."
    "Я пацягнуўся да сястры, але тая толькі мацней заверашчала, заўважыўшы кроў на маіх руках."

# game/scripts/scene/scene_day_5.rpy:3531
translate belarusian zhulka_kill_a2ef6abc:

    # "Сдёрнув висящее на крючке полотенце, я судорожно пытался стереть кровавые брызги."
    "Сарваўшы ручнік, што вісеў на кручку, я сутаргава спрабаваў сцерці крывавыя пырскі."

# game/scripts/scene/scene_day_5.rpy:3533
translate belarusian zhulka_kill_19b278f0:

    # "Внезапно Оля взвизгнула и бросилась к гадкой луже посреди прихожей."
    "Раптам Оля віскнула і кінулася да брыдкай лужыны пасярод пярэдняй."

# game/scripts/scene/scene_day_5.rpy:3590
translate belarusian zhulka_kill_ced9b0de:

    # voice "voice/olya/5day/49 Ziv.ogg"
    # Oly "Живая!"
    voice "voice/olya/5day/49 Ziv.ogg"
    Oly "Жывая!"

# game/scripts/scene/scene_day_5.rpy:3594
translate belarusian zhulka_kill_47c5fd13:

    # voice "voice/olya/5day/49 Dok.ogg"
    # Oly "Доктор придёт и зашьёт её!"
    voice "voice/olya/5day/49 Dok.ogg"
    Oly "Доктар прыйдзе і зашые яе!"

# game/scripts/scene/scene_day_5.rpy:3597
translate belarusian zhulka_kill_f8a20e6a:

    # voice "voice/anton/5day/052.ne.ogg"
    # Ant "Не может быть!"
    voice "voice/anton/5day/052.ne.ogg"
    Ant "Не можа быць!"

# game/scripts/scene/scene_day_5.rpy:3608
translate belarusian zhulka_kill_601e4fb0:

    # "Я уставился на собачонку."
    "Я ўтаропіўся на сабачку."

# game/scripts/scene/scene_day_5.rpy:3611
translate belarusian zhulka_kill_83ef0dd3:

    # "Красное тельце вздрагивало и вспучивалось. Что-то серое лезло из плоти."
    "Чырвонае цельца ўздрыгвала і ўспучвалася. Нешта шэрае лезла з плоці."

# game/scripts/scene/scene_day_5.rpy:3635
translate belarusian zhulka_kill_fa7dd0c1:

    # voice "voice/anton/5day/054.Na.ogg"
    # Ant "Назад!"
    voice "voice/anton/5day/054.Na.ogg"
    Ant "Назад!"

# game/scripts/scene/scene_day_5.rpy:3648
translate belarusian zhulka_kill_7f20acfb:

    # "Я отпихнул сестру к лестнице."
    "Я адпіхнуў сястру да лесвіцы."

# game/scripts/scene/scene_day_5.rpy:3655
translate belarusian zhulka_kill_350085ff:

    # "Тело собаки оказалось полым, как выгнивший фрукт."
    "Цела сабакі аказалася пустым, як выгнілы фрукт."

# game/scripts/scene/scene_day_5.rpy:3662
translate belarusian zhulka_kill_c1d5433f:

    # "Вот почему оно так легко разломилось под тычком лезвия."
    "Вось чаму яно так лёгка разламалася пад штуршком ляза."

# game/scripts/scene/scene_day_5.rpy:3687
translate belarusian zhulka_kill_06484baa:

    # "Внутри псины сидела некая зараза."
    "Унутры псіны сядзела нейкая зараза."

# game/scripts/scene/scene_day_5.rpy:3688
translate belarusian zhulka_kill_25b58f6e:

    # "Вероятно, управляла ей. Привела её в дом."
    "Верагодна, кіравала ёй. Прывяла яе ў дом."

# game/scripts/scene/scene_day_5.rpy:3689
translate belarusian zhulka_kill_4b91d8f2:

    # "Склизкая мерзость вылезала наружу."
    "Слізкая мярзота вылазіла вонкі."

# game/scripts/scene/scene_day_5.rpy:3690
translate belarusian zhulka_kill_6e94283e:

    # "Мгновение, и огромное насекомое уже извивалось на полу. Выгнутые паучьи лапы щупали деревянные половицы."
    "Імгненне — і вялізнае насякомае ўжо звівалася на падлозе. Выгнутыя павучыныя лапы мацалі драўляныя маснічыны."

# game/scripts/scene/scene_day_5.rpy:3691
translate belarusian zhulka_kill_d3f632ad:

    # "Прозрачные крылья распахнулись и затрепетали, взбрызнув кровавую росу."
    "Празрыстыя крылы расхінуліся і затрымцелі, пырснуўшы крывавай расой."

# game/scripts/scene/scene_day_5.rpy:3699
translate belarusian zhulka_kill_877f091c:

    # "Мутант, смесь сколопендры, паука и бабочки, поволочил ко мне волосатое тельце."
    "Мутант, сумесь скалапендры, павука і матыля, павалок да мяне валасатае цельца."

# game/scripts/scene/scene_day_5.rpy:3721
translate belarusian zhulka_kill_969766a5:

    # "Когтистые лапы цокали всё быстрее, и тонкая струйка сиропа стекала из крошечной пасти."
    "Кіпцюрыстыя лапы цокалі ўсё хутчэй, і тонкі струменьчык сіропу сцякаў з малюсенькай пашчы."

# game/scripts/scene/scene_day_5.rpy:3739
translate belarusian zhulka_kill_1c6ba7cf:

    # "Я закричал и рубанул, рассекая паразита надвое."
    "Я закрычаў і рубануў, рассякаючы паразіта надвое."

# game/scripts/scene/scene_day_5.rpy:3766
translate belarusian zhulka_kill_d2e8229e:

    # "Жёлтый гной выплеснулся из лопнувшей твари. Лапки дёрнулись и опали."
    "Жоўты гной выплюхнуўся з пачвары, што лопнула. Лапкі тузануліся і апалі."

# game/scripts/scene/scene_day_5.rpy:3779
translate belarusian zhulka_kill_455c8bfa:

    # "А следом упала к моим ногам лишившаяся чувств Оля."
    "А следам, страціўшы прытомнасць, упала да маіх ног Оля."

# game/scripts/scene/scene_day_5.rpy:3784
translate belarusian zhulka_kill_ba8bea3a:

    # "Топор торчал из гнусного месива."
    "Сякера тырчала з агіднага месіва."

# game/scripts/scene/scene_day_5.rpy:3787
translate belarusian zhulka_kill_48863e5e:

    # "Насекомое пряталось в собаке, как матрёшка внутри ещё одной матрёшки."
    "Насякомае хавалася ў сабаку, як матрошка ўнутры яшчэ адной матрошкі."

# game/scripts/scene/scene_day_5.rpy:3805
translate belarusian zhulka_kill_50efdbe4:

    # "Вспомнилось, как Алиса чем-то угощала собаку в день нашей встречи."
    "Успомнілася, як Аліса нечым частавала сабаку ў дзень нашай сустрэчы."

# game/scripts/scene/scene_day_5.rpy:3827
translate belarusian zhulka_kill_ddbb4cdc:

    # "Я сполз по стене, закрыл глаза руками."
    "Я споўз па сцяне, закрыў вочы рукамі."

# game/scripts/scene/scene_day_5.rpy:3829
translate belarusian zhulka_kill_637e406e:

    # "Меня замутило, но я глубоко вдохнул, справился с рвотным позывом."
    "Мяне замлоіла, але я глыбока ўдыхнуў, справіўся з ванітным позывам."

# game/scripts/scene/scene_day_5.rpy:3860
translate belarusian zhulka_kill_a129a511:

    # "Под окнами заскрипел снег, словно кто-то подошёл заглянуть к нам."
    "Пад вокнамі зарыпеў снег, быццам нехта падышоў зазірнуць да нас."

# game/scripts/scene/scene_day_5.rpy:3861
translate belarusian zhulka_kill_54d79312:

    # "Я целиком превратился в слух."
    "Я цалкам ператварыўся ў слых."

# game/scripts/scene/scene_day_5.rpy:3862
translate belarusian zhulka_kill_7ac8a6f4:

    # "Кажется, привиделось."
    "Здаецца, прывідзелася."

# game/scripts/scene/scene_day_5.rpy:3866
translate belarusian zhulka_kill_63ea7de2:

    # "Нервы, как сказал бы папа."
    "Нервы, як сказаў бы тата."

# game/scripts/scene/scene_day_5.rpy:3868
translate belarusian zhulka_kill_c6bdc362:

    # "И мама обязательно бы добавила, что нервные клетки не восстанавливаются."
    "І мама абавязкова б дадала, што нервовыя клеткі не аднаўляюцца."

# game/scripts/scene/scene_day_5.rpy:3869
translate belarusian zhulka_kill_39b2f64d:

    # "Мне нужно быть сильным, пока они не вернутся."
    "Мне трэба быць моцным, пакуль яны не вернуцца."

# game/scripts/scene/scene_day_5.rpy:3870
translate belarusian zhulka_kill_0f78f613:

    # "Вот уже совсем скоро. С секунды на секунду."
    "Вось ужо зусім хутка. З секунды на секунду."

# game/scripts/scene/scene_day_5.rpy:3872
translate belarusian zhulka_kill_22914c27:

    # "Я осмотрел прихожую, походившую на мясницкую бойню, посредине которой лежала бледная Оля."
    "Я агледзеў пярэднюю, падобную да мясніцкай бойні, пасярэдзіне якой ляжала бледная Оля."

# game/scripts/scene/scene_day_5.rpy:3878
translate belarusian zhulka_kill_3b79a616:

    # "Нельзя встречать родителей таким «подарком»."
    "Нельга сустракаць бацькоў такім «падарункам»."

# game/scripts/scene/scene_day_5.rpy:3886
translate belarusian zhulka_kill_2d8539fd:

    # "Из спальни я принёс одеяло и подушку."
    "Са спальні я прынёс коўдру і падушку."

# game/scripts/scene/scene_day_5.rpy:3891
translate belarusian zhulka_kill_a74a676c:

    # "Укутал Олю, пододвинув её к лестнице. Подальше от разделанной твари, засевшей в дворняге."
    "Ухутаў Олю, падсунуўшы яе да лесвіцы. Падалей ад пасечанай пачвары, што засела ў дварнязе."

# game/scripts/scene/scene_day_5.rpy:3892
translate belarusian zhulka_kill_8f52f764:

    # "Пусть сестра будет здесь, под моим присмотром. Мало ли, кто постучит в окошко детской..."
    "Няхай сястра будзе тут, пад маім наглядам. Ці мала хто пагрукае ў акенца дзіцячай..."

# game/scripts/scene/scene_day_5.rpy:3893
translate belarusian zhulka_kill_f409970d:

    # "Румянец вновь покинул Олины щёки. Кожа была серой, как пепел."
    "Румянец зноў пакінуў Оліны шчокі. Скура была шэрай, як попел."

# game/scripts/scene/scene_day_5.rpy:3901
translate belarusian zhulka_kill_dbcc7cd3:

    # "Я дотронулся губами до её лба. Не нужен градусник, чтобы определить — температура подскочила."
    "Я дакрануўся вуснамі да яе ілба. Не патрэбны градуснік, каб вызначыць — тэмпература падскочыла."

# game/scripts/scene/scene_day_5.rpy:3930
translate belarusian zhulka_kill_362ce968:

    # "Порубленная туша мерзопакостного жука вместе со шкуркой от Жульки угодила в наволочку, а следом в морозилку."
    "Пасечаная туша мярзотнага жука разам са шкуркай ад Жулькі трапіла ў навалачку, а следам у маразілку."

# game/scripts/scene/scene_day_5.rpy:3935
translate belarusian zhulka_kill_983ba487:

    # "Слабо верилось, что она не испарится к приезду взрослых, но попытаться всё же стоило."
    "Слаба верылася, што яна не выпарыцца да прыезду дарослых, але паспрабаваць усё ж варта было."

# game/scripts/scene/scene_day_5.rpy:3940
translate belarusian zhulka_kill_d197ee47:

    # "Хоть бы они поверили в этот раз..."
    "Хоць бы яны паверылі гэтым разам..."

# game/scripts/scene/scene_day_5.rpy:3957
translate belarusian zhulka_kill_99bd531e:

    # "Собачью кровь удалось стереть с помощью полотенца, а вот с остатками липкой слизи пришлось повозиться."
    "Сабачую кроў удалося сцерці з дапамогай ручніка, а вось з рэшткамі ліпкай слізі давялося павазіцца."

# game/scripts/scene/scene_day_5.rpy:3963
translate belarusian zhulka_kill_539fe5d3:

    # "В конце концов, я соскрёб их ножом, которым раздумывал прирезать собаку."
    "У рэшце рэшт, я саскроб іх нажом, якім раздумваў прырэзаць сабаку."

# game/scripts/scene/scene_day_5.rpy:3981
translate belarusian zhulka_kill_c0cb2830:

    # "За окном валил густой снегопад."
    "За акном валіў густы снегапад."

# game/scripts/scene/scene_day_5.rpy:3986
translate belarusian zhulka_kill_79a15a3e:

    # "Дом потряхивало. Казалось, он отрывается от земли, подхваченный ураганом."
    "Дом патрэсвала. Здавалася, ён адрываецца ад зямлі, падхоплены ўраганам."

# game/scripts/scene/scene_day_5.rpy:3996
translate belarusian zhulka_kill_acdb55a3:

    # "Как домик Элли, летящий в изумрудный город, где вместо доброго волшебника Гудвина рука об руку правят безумие и смерть."
    "Як домік Элі, што ляціць у ізумрудны горад, дзе замест добрага чараўніка Гудвіна рука аб руку правяць вар'яцтва і смерць."

# game/scripts/scene/scene_day_5.rpy:3997
translate belarusian zhulka_kill_af95b872:

    # "За окнами снежные призраки хохотали и хороводили."
    "За вокнамі снежныя прывіды рагаталі і вадзілі карагоды."

# game/scripts/scene/scene_day_5.rpy:3999
translate belarusian zhulka_kill_ef8d6126:

    # "Стемнело."
    "Сцямнела."

# game/scripts/scene/scene_day_5.rpy:4000
translate belarusian zhulka_kill_33652477:

    # "Вечер и метель замазали все окна в доме."
    "Вечар і мяцеліца замазалі ўсе вокны ў доме."

# game/scripts/scene/scene_day_5.rpy:4001
translate belarusian zhulka_kill_caf7f1f5:

    # "Даже если б кто-то и смотрел на нас снаружи, припав к подоконнику, я бы не различил его."
    "Нават калі б нехта і глядзеў на нас знадворку, прыпаўшы да падаконніка, я б не разгледзеў яго."

# game/scripts/scene/scene_day_5.rpy:4009
translate belarusian zhulka_kill_2cdc7a50:

    # "Насколько крепки засовы на дверях?"
    "Наколькі моцныя засовы на дзвярах?"

# game/scripts/scene/scene_day_5.rpy:4010
translate belarusian zhulka_kill_5d454b6c:

    # "Насколько голодна подбирающаяся тьма?"
    "Наколькі галодная цемра, што падступае?"

# game/scripts/scene/scene_day_5.rpy:4048
translate belarusian event_medication_afterdev_839d3504:

    # "Я сжался, услышав, как что-то яростно завопило в окружающем нас мраке."
    "Я скуліўся, пачуўшы, як нешта люта залямантавала ў змроку вакол нас."

# game/scripts/scene/scene_day_5.rpy:4049
translate belarusian event_medication_afterdev_a92498ab:

    # "Это ветер. Это муки голода."
    "Гэта вецер. Гэта пакуты голаду."

# game/scripts/scene/scene_day_5.rpy:4050
translate belarusian event_medication_afterdev_b63b1bd4:

    # "Чудовищная музыка урагана лилась в мои уши."
    "Жудасная музыка ўрагану лілася ў мае вушы."

# game/scripts/scene/scene_day_5.rpy:4055
translate belarusian event_medication_afterdev_d85074e1:

    # "Она состояла из скрежета, воя и быстрых ударов моего собственного сердца."
    "Яна складалася са скрыгату, выцця і хуткіх удараў майго ўласнага сэрца."

# game/scripts/scene/scene_day_5.rpy:4059
translate belarusian event_medication_afterdev_b0937d75:

    # "Ветер таранил стёкла."
    "Вецер тараніў шыбы."

# game/scripts/scene/scene_day_5.rpy:4069
translate belarusian event_medication_afterdev_4216a0e9:

    # "Где-то наверху лихорадочно хлопала форточка."
    "Дзесьці наверсе ліхаманкава ляскала фортка."

# game/scripts/scene/scene_day_5.rpy:4070
translate belarusian event_medication_afterdev_a2bd0922:

    # "Словно заразившийся бешенством зверь клацал челюстями."
    "Быццам звер, што заразіўся шаленствам, клацаў сківіцамі."

# game/scripts/scene/scene_day_5.rpy:4075
translate belarusian event_medication_afterdev_8599d439:

    # "Гости уже здесь? Это они ходят по второму этажу? Перебегают из угла в угол в прихожей и хихикают..."
    "Госці ўжо тут? Гэта яны ходзяць па другім паверсе? Перабягаюць з кута ў кут у пярэдняй і хіхікаюць..."

# game/scripts/scene/scene_day_5.rpy:4077
translate belarusian event_medication_afterdev_49e89c9b:

    # "Лучше бы я накормил их Жулькой."
    "Лепш бы я накарміў іх Жулькай."

# game/scripts/scene/scene_day_5.rpy:4078
translate belarusian event_medication_afterdev_ee1fa077:

    # "Они злы. Как безгранична их ярость!"
    "Яны злыя. Якая бязмежная іх лютасць!"

# game/scripts/scene/scene_day_5.rpy:4094
translate belarusian event_medication_afterdev_70120310:

    # "Я вжался в холодильник, ожидая, что в любой момент тьма дверного проёма выпустит когтистые лапы."
    "Я ўціснуўся ў халадзільнік, чакаючы, што ў любы момант цемра дзвярнога праёма выпусціць кіпцюрыстыя лапы."

# game/scripts/scene/scene_day_5.rpy:4095
translate belarusian event_medication_afterdev_525fc63c:

    # "И оскаленные морды сунутся на кухню, оросив пол слюной."
    "І выскаленыя пысы сунуцца на кухню, арасіўшы падлогу слінай."

# game/scripts/scene/scene_day_5.rpy:4096
translate belarusian event_medication_afterdev_d42dd0f9:

    # "Мне нужно успокоиться."
    "Мне трэба супакоіцца."

# game/scripts/scene/scene_day_5.rpy:4097
translate belarusian event_medication_afterdev_a752d5de:

    # "Принять таблетки..."
    "Прыняць таблеткі..."

# game/scripts/scene/scene_day_5.rpy:4113
translate belarusian event_medication_afterdev_adaa5196:

    # "Я выхватил их с полки холодильника, выдавил на язык пилюлю и запил водой из-под крана."
    "Я выхапіў іх з паліцы халадзільніка, выціснуў на язык пілюлю і запіў вадой з-пад крана."

# game/scripts/scene/scene_day_5.rpy:4118
translate belarusian event_medication_afterdev_aa75c76b:

    # "Набрал ещё воды, умылся."
    "Набраў яшчэ вады, умыўся."

# game/scripts/scene/scene_day_5.rpy:4152
translate belarusian event_medication_afterdev_104c13fb:

    # "Метели будто бы не понравилось то, что я сделал."
    "Мяцеліцы быццам бы не спадабалася тое, што я зрабіў."

# game/scripts/scene/scene_day_5.rpy:4156
translate belarusian event_medication_afterdev_df610b66:

    # "Она с двойной силой набросилась на внешние стены, заголосила."
    "Яна з падвойнай сілай накінулася на вонкавыя сцены, загаласіла."

# game/scripts/scene/scene_day_5.rpy:4157
translate belarusian event_medication_afterdev_0b74f5b6:

    # "Буря чувствовала, как напуганы дети в хрупком домике."
    "Бура адчувала, як напалоханы дзеці ў крохкім доміку."

# game/scripts/scene/scene_day_5.rpy:4166
translate belarusian event_medication_afterdev_3be709a2:

    # "Я понял, что тени, пока не смотришь на них, приближаются к Оле."
    "Я зразумеў, што цені, пакуль не глядзіш на іх, набліжаюцца да Олі."

# game/scripts/scene/scene_day_5.rpy:4213
translate belarusian event_medication_afterdev_cdea5153:

    # "Вон сгусток, выползший из угла, но растаявший от прямого взгляда. Вон зыбкая фигура под столом."
    "Вунь згустак, што выпаўз з кута, але растаў ад прамога позірку. Вунь хісткая постаць пад сталом."

# game/scripts/scene/scene_day_5.rpy:4230
translate belarusian event_medication_afterdev_86472306:

    # "Я вертел головой, отбивая атаки."
    "Я круціў галавой, адбіваючы атакі."

# game/scripts/scene/scene_day_5.rpy:4255
translate belarusian event_medication_afterdev_7c4d51e5:

    # "Потом увидел лужу крови на досках. Такую же, как ту, которую только что вытер."
    "Потым убачыў лужыну крыві на дошках. Такую ж, як тую, што толькі што выцер."

# game/scripts/scene/scene_day_5.rpy:4277
translate belarusian event_medication_afterdev_04dbfb83:

    # "Раздался выворачивающий наизнанку скрип, словно кто-то провёл когтем по оконному стеклу."
    "Раздаўся скрып, ад якога выварочвала навыварат, быццам нехта правёў кіпцюром па аконнай шыбе."

# game/scripts/scene/scene_day_5.rpy:4291
translate belarusian event_medication_afterdev_9ae29b57:

    # voice "voice/Anton/5day/04 net.ogg"
    # Ant "Нет, нет, нет..."
    voice "voice/Anton/5day/04 net.ogg"
    Ant "Не, не, не..."

# game/scripts/scene/scene_day_5.rpy:4316
translate belarusian event_medication_afterdev_84ed49a9:

    # voice "voice/Anton/5day/05 V.ogg"    
    # Ant "Вы не настоящие!"
    voice "voice/Anton/5day/05 V.ogg"    
    Ant "Вы не сапраўдныя!"

# game/scripts/scene/scene_day_5.rpy:4329
translate belarusian event_medication_afterdev_94a8f14c:

    # "Но если тени не настоящие..."
    "Але калі цені не сапраўдныя..."

# game/scripts/scene/scene_day_5.rpy:4330
translate belarusian event_medication_afterdev_13193d55:

    # "Если никого нет в урагане..."
    "Калі нікога няма ва ўрагане..."

# game/scripts/scene/scene_day_5.rpy:4331
translate belarusian event_medication_afterdev_3166d33f:

    # "Выходит, я просто псих..."
    "Выходзіць, я проста псіх..."

# game/scripts/scene/scene_day_5.rpy:4334
translate belarusian event_medication_afterdev_25fc782d:

    # "Живодёр... Маньяки начинали с мелких зверушек, разве нет?"
    "Жывадзёр... Маньякі пачыналі з дробных звяркоў, хіба не?"

# game/scripts/scene/scene_day_5.rpy:4354
translate belarusian event_medication_afterdev_a75b9353:

    # "Я посмотрел на упаковку в руке."
    "Я паглядзеў на ўпакоўку ў руцэ."

# game/scripts/scene/scene_day_5.rpy:4355
translate belarusian event_medication_afterdev_b5b7ce31:

    # "Что я вообще пью? Дети не обязаны читать инструкции, для этого есть мама."
    "Што я наогул п'ю? Дзеці не абавязаны чытаць інструкцыі, для гэтага ёсць мама."

# game/scripts/scene/scene_day_5.rpy:4372
translate belarusian event_medication_afterdev_00590d59:

    # "Я впился глазами в мелкий шрифт."
    "Я ўпіўся вачыма ў дробны шрыфт."

# game/scripts/scene/scene_day_5.rpy:4373
translate belarusian event_medication_afterdev_7c3567e0:

    # "«Снимает неконтролируемую агрессию, тревогу»."
    "«Здымае некантраляваную агрэсію, трывогу»."

# game/scripts/scene/scene_day_5.rpy:4374
translate belarusian event_medication_afterdev_f51dfdb4:

    # "«Помогает при поведенческих аномалиях, маниях, деструктивном поведении...»"
    "«Дапамагае пры паводніцкіх анамаліях, маніях, дэструктыўных паводзінах...»"

# game/scripts/scene/scene_day_5.rpy:4375
translate belarusian event_medication_afterdev_9bfd8282:

    # "«Вызывает зависимость!»"
    "«Выклікае залежнасць!»"

# game/scripts/scene/scene_day_5.rpy:4376
translate belarusian event_medication_afterdev_382bb2e4:

    # "«Побочные эффекты: головокружение, повышение двигательной активности...»"
    "«Пабочныя эфекты: галавакружэнне, павышэнне рухальнай актыўнасці...»"

# game/scripts/scene/scene_day_5.rpy:4377
translate belarusian event_medication_afterdev_bd12a271:

    # "«... нарушение терморегуляции, бессонница»."
    "«... парушэнне тэрмарэгуляцыі, бяссонніца»."

# game/scripts/scene/scene_day_5.rpy:4378
translate belarusian event_medication_afterdev_3087e3de:

    # "«Неправильная дозировка может привести к летальному исходу»."
    "«Няправільная дазіроўка можа прывесці да летальнага зыходу»."

# game/scripts/scene/scene_day_5.rpy:4430
translate belarusian event_medication_afterdev_9326c866:

    # "Я засомневался."
    "Я засумняваўся."

# game/scripts/scene/scene_day_5.rpy:4454
translate belarusian event_medication_afterdev_07392d50:

    # voice "voice/Alisa/5day/Tabll.ogg"
    # "В памяти зазвучали вкрадчивые слова Алисы: те таблетки... уводят тебя со снежной тропинки..."
    voice "voice/Alisa/5day/Tabll.ogg"
    "У памяці загучалі ўкрадлівыя словы Алісы: тыя таблеткі... зводзяць цябе са снежнай сцяжынкі..."

# game/scripts/scene/scene_day_5.rpy:4500
translate belarusian event_medication_afterdev_7c5d708a:

    # "Но, может быть, мне не нужна никакая тропа?"
    "Але, можа быць, мне не патрэбна ніякая сцежка?"

# game/scripts/scene/scene_day_5.rpy:4501
translate belarusian event_medication_afterdev_5e8cb775:

    # "Пора остановиться..."
    "Пара спыніцца..."

# game/scripts/scene/scene_day_5.rpy:4505
translate belarusian event_medication_afterdev_2040e9c3:

    # "Где же правда? Как отличить её от гадкой лжи?"
    "Дзе ж праўда? Як адрозніць яе ад брыдкай хлусні?"

# game/scripts/scene/scene_day_5.rpy:4526
translate belarusian event_medicated_8352f16b:

    # "Я рискнул. Будет хуже, если я не смогу внятно соображать."
    "Я рызыкнуў. Будзе горш, калі я не змагу выразна разважаць."

# game/scripts/scene/scene_day_5.rpy:4532
translate belarusian event_medicated_d39027df:

    # "Я ждал, но лекарство так и не подействовало."
    "Я чакаў, але лекі так і не падзейнічалі."

# game/scripts/scene/scene_day_5.rpy:4533
translate belarusian event_medicated_a1d2d918:

    # "Зловещий мир за окном не думал меняться, становиться менее враждебным."
    "Злавесны свет за акном не думаў мяняцца, станавіцца менш варожым."

# game/scripts/scene/scene_day_5.rpy:4534
translate belarusian event_medicated_76cfa358:

    # "Даже наоборот, казалось, деревья ожили хищными тварями, что затаились в темноте, подстерегая жертву."
    "Нават наадварот, здавалася, дрэвы ажылі драпежнымі пачварамі, што затаіліся ў цемры, падпільноўваючы ахвяру."

# game/scripts/scene/scene_day_5.rpy:4535
translate belarusian event_medicated_fc6731ff:

    # "Скрюченные ветви то гнулись низко, рыская в поисках добычи по снежным дорожкам, то вздымались к небу, пытаясь схватить зазевавшуюся птицу."
    "Скручаныя галіны то гнуліся нізка, рыскаючы ў пошуках здабычы па снежных дарожках, то ўздымаліся да неба, спрабуючы схапіць птушку, што зазявалася."

# game/scripts/scene/scene_day_5.rpy:4536
translate belarusian event_medicated_35a03dc4:

    # "Однако, стоило упереться в них взглядом, как маскирующиеся твари замирали."
    "Аднак варта было ўперціся ў іх позіркам, як пачвары, што маскіраваліся, заміралі."

# game/scripts/scene/scene_day_5.rpy:4537
translate belarusian event_medicated_6a74fd6b:

    # "И снова ничем не отличались от множества других мёртвых деревьев среди проклятого таёжного леса."
    "І зноў нічым не адрозніваліся ад мноства іншых мёртвых дрэў сярод праклятага таёжнага лесу."

# game/scripts/scene/scene_day_5.rpy:4538
translate belarusian event_medicated_282248c2:

    # "А может, виной тому был всего лишь ветер… Но нет!"
    "А можа, віной таму быў усяго толькі вецер... Але не!"

# game/scripts/scene/scene_day_5.rpy:4549
translate belarusian event_medicated_intro_d7691eee:

    # "Наглотавшись воды и закрутив кран, я обнаружил, что лужа исчезла без следа."
    "Наглытаўшыся вады і закруціўшы кран, я выявіў, што лужына знікла без следу."

# game/scripts/scene/scene_day_5.rpy:4551
translate belarusian event_medicated_intro_994efaf8:

    # "И тени перестали притворяться мыслящими существами."
    "І цені перасталі прыкідвацца разумнымі істотамі."

# game/scripts/scene/scene_day_5.rpy:4557
translate belarusian event_medicated_intro_e2749a7d:

    # "Тени постепенно перестали притворяться мыслящими существами. Умолкли скрипы."
    "Цені паступова перасталі прыкідвацца разумнымі істотамі. Змоўклі скрыпы."

# game/scripts/scene/scene_day_5.rpy:4562
translate belarusian event_medicated_intro_29ed593d:

    # "Да и в шуме непогоды не было никакой угрозы, ведь мы дома."
    "Ды і ў шуме непагадзі не было ніякай пагрозы, бо мы дома."

# game/scripts/scene/scene_day_5.rpy:4613
translate belarusian event_medicated_intro_ec3e19f1:

    # voice "voice/karina/5day/01 Vi.ogg" 
    # Mam "Вы дома?"
    voice "voice/karina/5day/01 Vi.ogg" 
    Mam "Вы дома?"

# game/scripts/scene/scene_day_5.rpy:4615
translate belarusian event_medicated_intro_7a745af0:

    # voice "voice/father/day5/01 Na.ogg"
    # Pap "На улице чёрт-те что."
    voice "voice/father/day5/01 Na.ogg"
    Pap "На вуліцы чорт ведае што."

# game/scripts/scene/scene_day_5.rpy:4617
translate belarusian event_medicated_intro_cc392a1e:

    # voice "voice/father/day5/02 Ant.ogg"
    # Pap "Антон, поставь чайник."
    voice "voice/father/day5/02 Ant.ogg"
    Pap "Антон, пастаў чайнік."

# game/scripts/scene/scene_day_5.rpy:4695
translate belarusian event_medicated_intro_0a0fee4b:

    # "В коридоре затопали, сбивая снег с подошв, сапоги."
    "У калідоры затупалі, збіваючы снег з падэшваў, боты."

# game/scripts/scene/scene_day_5.rpy:4703
translate belarusian event_medicated_intro_0369fb4e:

    # "На пороге появились родители."
    "На парозе з'явіліся бацькі."

# game/scripts/scene/scene_day_5.rpy:4713
translate belarusian event_medicated_intro_a7f20a01:

    # "Оля слабо шевельнулась и открыла глаза."
    "Оля слаба варухнулася і расплюшчыла вочы."

# game/scripts/scene/scene_day_5.rpy:4719
translate belarusian event_medicated_intro_1b1fc6a2:

    # voice "voice/olya/5day/04 Ma.ogg"
    # Oly "Мамочка... папочка..."
    voice "voice/olya/5day/04 Ma.ogg"
    Oly "Мамачка... татачка..."

# game/scripts/scene/scene_day_5.rpy:4723
translate belarusian event_medicated_intro_6d33499f:

    # voice "voice/karina/5day/02 Ti.ogg"
    # Mam "Ты чего на полу разлеглась? У тебя же температура."
    voice "voice/karina/5day/02 Ti.ogg"
    Mam "Ты чаго на падлозе разляглася? У цябе ж тэмпература."

# game/scripts/scene/scene_day_5.rpy:4725
translate belarusian event_medicated_intro_b8a091a9:

    # "Папа оглядывал беспорядок, творившийся на кухне, и его лицо становилось всё мрачнее."
    "Тата аглядаў беспарадак, што рабіўся на кухні, і яго твар станавіўся ўсё больш пахмурным."

# game/scripts/scene/scene_day_5.rpy:4740
translate belarusian event_medicated_intro_01a3c5ad:

    # "Мама нежно обняла Олю."
    "Мама пяшчотна абняла Олю."

# game/scripts/scene/scene_day_5.rpy:4741
translate belarusian event_medicated_intro_65fbbcc0:

    # voice "voice/karina/5day/03 Go.ogg"
    # Mam "Господи, какой горячий лоб."
    voice "voice/karina/5day/03 Go.ogg"
    Mam "Госпадзі, які гарачы лоб."

# game/scripts/scene/scene_day_5.rpy:4743
translate belarusian event_medicated_intro_c5a76af1:

    # voice "voice/karina/5day/04 Ni.ogg" 
    # Mam "Ничего, потерпи, мы привезли лекарства. Сейчас станет лучше."
    voice "voice/karina/5day/04 Ni.ogg" 
    Mam "Нічога, пацярпі, мы прывезлі лекі. Зараз стане лепш."

# game/scripts/scene/scene_day_5.rpy:4747
translate belarusian event_medicated_intro_19803a28:

    # voice "voice/olya/5day/05 Mne.ogg"
    # Oly "Мне снилось, что собачку убили."
    voice "voice/olya/5day/05 Mne.ogg"
    Oly "Мне снілася, што сабачку забілі."

# game/scripts/scene/scene_day_5.rpy:4750
translate belarusian event_medicated_intro_e0985cb2:

    # voice "voice/olya/5day/06 Mnes.ogg"
    # Oly "Мне снилось, что Антон стал монстром."
    voice "voice/olya/5day/06 Mnes.ogg"
    Oly "Мне снілася, што Антон стаў монстрам."

# game/scripts/scene/scene_day_5.rpy:4759
translate belarusian event_medicated_intro_268f9ae9:

    # "Мама одарила меня сердитым взглядом."
    "Мама адарыла мяне сярдзітым позіркам."

# game/scripts/scene/scene_day_5.rpy:4760
translate belarusian event_medicated_intro_18f05953:

    # voice "voice/karina/5day/05 Na.ogg"
    # Mam "На пять минут нельзя оставить."
    voice "voice/karina/5day/05 Na.ogg"
    Mam "На пяць хвілін нельга пакінуць."

# game/scripts/scene/scene_day_5.rpy:4770
translate belarusian event_medicated_intro_6456395a:

    # "Я почувствовал, что краснею."
    "Я адчуў, што чырванею."

# game/scripts/scene/scene_day_5.rpy:4771
translate belarusian event_medicated_intro_d3b4d645:

    # voice "voice/karina/5day/06 Vs.ogg"
    # Mam "Всё хорошо, маленькая, я отнесу тебя в постель."
    voice "voice/karina/5day/06 Vs.ogg"
    Mam "Усё добра, маленькая, я аднясу цябе ў пасцель."

# game/scripts/scene/scene_day_5.rpy:4773
translate belarusian event_medicated_intro_1acbd116:

    # voice "voice/olya/5day/07 Ant.ogg"
    # Oly "Антон..."
    voice "voice/olya/5day/07 Ant.ogg"
    Oly "Антон..."

# game/scripts/scene/scene_day_5.rpy:4778
translate belarusian event_medicated_intro_c0544272:

    # "Наши взгляды встретились. В глазах Оли читалось отчаянье."
    "Нашы позіркі сустрэліся. У вачах Олі чытаўся адчай."

# game/scripts/scene/scene_day_5.rpy:4795
translate belarusian event_medicated_intro_af1df198:

    # voice "voice/olya/5day/08 Ant.ogg"
    # Oly "Антон, прошу тебя, останься со мной."
    voice "voice/olya/5day/08 Ant.ogg"
    Oly "Антон, прашу цябе, застанься са мной."

# game/scripts/scene/scene_day_5.rpy:4806
translate belarusian event_medicated_intro_3e1d592b:

    # voice "voice/karina/5day/07 Tv.ogg"
    # Mam "Твоему брату нужно убраться."
    voice "voice/karina/5day/07 Tv.ogg"
    Mam "Твайму брату трэба ўбрацца."

# game/scripts/scene/scene_day_5.rpy:4814
translate belarusian event_medicated_intro_f3bb5529:

    # "Убраться? В смысле — уйти прочь, вон отсюда, во мрак?"
    "Убрацца? У сэнсе — сысці прэч, вон адсюль, у змрок?"

# game/scripts/scene/scene_day_5.rpy:4815
translate belarusian event_medicated_intro_aa422153:

    # "Нет же, мама говорит о бардаке на кухонном столе. Там я неаккуратно резал бутерброды со сгущенкой."
    "Ды не, мама кажа пра бардак на кухонным стале. Там я неакуратна рэзаў бутэрброды са згушчанкай."

# game/scripts/scene/scene_day_5.rpy:4833
translate belarusian event_medicated_intro_d227f2e1:

    # "Перед тем, как позволить себя увести, Оля обернулась и посмотрела на меня растерянно."
    "Перад тым, як дазволіць сябе адвесці, Оля азірнулася і паглядзела на мяне разгублена."

# game/scripts/scene/scene_day_5.rpy:4834
translate belarusian event_medicated_intro_089a1d48:

    # "Хотелось схватить её и прижать к груди. Но мама вынесла сестру в коридор."
    "Хацелася схапіць яе і прыціснуць да грудзей. Але мама вынесла сястру ў калідор."

# game/scripts/scene/scene_day_5.rpy:4850
translate belarusian event_medicated_intro_f12bd1d9:

    # "Казалось, без неё на кухне стало ещё гаже, а ветер завыл громче и отчаяннее."
    "Здавалася, без яе на кухні стала яшчэ паганей, а вецер завыў гучней і адчайней."

# game/scripts/scene/scene_day_5.rpy:4858
translate belarusian event_medicated_intro_a3a7a680:

    # voice "voice/father/day5/03 Da.ogg"
    # Pap "Да уж... не радуешь ты нас, Антон."
    voice "voice/father/day5/03 Da.ogg"
    Pap "Ды ўжо... не радуеш ты нас, Антон."

# game/scripts/scene/scene_day_5.rpy:4867
translate belarusian event_medicated_intro_ce5e9a37:

    # voice "voice/Anton/5day/06 Ya.ogg"
    # Ant "Я всё объясню."
    voice "voice/Anton/5day/06 Ya.ogg"
    Ant "Я ўсё растлумачу."

# game/scripts/scene/scene_day_5.rpy:4870
translate belarusian event_medicated_intro_463b7639:

    # "Папа прервал меня жестом."
    "Тата перапыніў мяне жэстам."

# game/scripts/scene/scene_day_5.rpy:4890
translate belarusian event_medicated_intro_226873c9:

    # voice "voice/father/day5/04 Ne.ogg"
    # Pap "Не сейчас."
    voice "voice/father/day5/04 Ne.ogg"
    Pap "Не зараз."

# game/scripts/scene/scene_day_5.rpy:4902
translate belarusian event_medicated_intro_483dfc83:

    # voice "voice/father/day5/05 Ya.ogg"
    # Pap "Я голоден как волк..."
    voice "voice/father/day5/05 Ya.ogg"
    Pap "Я галодны як воўк..."

# game/scripts/scene/scene_day_5.rpy:4911
translate belarusian event_medicated_meat_268f91bc:

    # voice "voice/Anton/5day/07 pod.ogg"
    # Ant "Подожди!"
    voice "voice/Anton/5day/07 pod.ogg"
    Ant "Пачакай!"

# game/scripts/scene/scene_day_5.rpy:4913
translate belarusian event_medicated_meat_be5baa92:

    # "Но было поздно."
    "Але было позна."

# game/scripts/scene/scene_day_5.rpy:4918
translate belarusian event_medicated_meat_d9794f5a:

    # "Папа открыл морозильник. Мёртвый электрический свет озарил его вытягивающееся лицо."
    "Тата адчыніў маразільнік. Мёртвае электрычнае святло азарыла яго твар, што выцягваўся."

# game/scripts/scene/scene_day_5.rpy:4924
translate belarusian event_medicated_meat_65ab057e:

    # "Я смотрел, затаив дыхание, как он вытаскивает из камеры наволочку, и пол уходил у меня из-под ног."
    "Я глядзеў, затаіўшы дыханне, як ён выцягвае з камеры навалачку, і падлога сыходзіла ў мяне з-пад ног."

# game/scripts/scene/scene_day_5.rpy:4931
translate belarusian event_medicated_meat_13b0374a:

    # voice "voice/father/day5/06 Vot.ogg"
    # Pap "Вот оно что."
    voice "voice/father/day5/06 Vot.ogg"
    Pap "Вось яно што."

# game/scripts/scene/scene_day_5.rpy:4933
translate belarusian event_medicated_meat_b7abe5dc:

    # voice "voice/father/day5/07 Mne.ogg"
    # Pap "Мне говорили, что такое может произойти."
    voice "voice/father/day5/07 Mne.ogg"
    Pap "Мне казалі, што такое можа здарыцца."

# game/scripts/scene/scene_day_5.rpy:4935
translate belarusian event_medicated_meat_d97ad776:

    # "Папа не кричал на меня. А лучше бы кричал!"
    "Тата не крычаў на мяне. А лепш бы крычаў!"

# game/scripts/scene/scene_day_5.rpy:4936
translate belarusian event_medicated_meat_d3f86028:

    # "Он выглядел страшно вымотанным и подавленным."
    "Ён выглядаў страшна выматаным і прыгнечаным."

# game/scripts/scene/scene_day_5.rpy:4937
translate belarusian event_medicated_meat_9416f376:

    # voice "voice/Anton/5day/09 Ya.ogg"
    # Ant "Я пытался защитить Олю."
    voice "voice/Anton/5day/09 Ya.ogg"
    Ant "Я спрабаваў абараніць Олю."

# game/scripts/scene/scene_day_5.rpy:4939
translate belarusian event_medicated_meat_75af61e6:

    # voice "voice/father/day5/08 hor.ogg"
    # Pap "Хорошо. Помолчи, пожалуйста. Помолчи и послушай меня."
    voice "voice/father/day5/08 hor.ogg"
    Pap "Добра. Памаўчы, калі ласка. Памаўчы і паслухай мяне."

# game/scripts/scene/scene_day_5.rpy:4942
translate belarusian event_medicated_meat_2258ef4f:

    # "Он брезгливо посмотрел в наволочку, ставшую мешком для трупов."
    "Ён грэбліва паглядзеў у навалачку, якая стала мяшком для трупаў."

# game/scripts/scene/scene_day_5.rpy:4943
translate belarusian event_medicated_meat_232bfdd1:

    # voice "voice/father/day5/10 Tv.ogg"
    # Pap "Твоя мама не должна об этом узнать. Ты понял меня?"
    voice "voice/father/day5/10 Tv.ogg"
    Pap "Твая мама не павінна пра гэта даведацца. Ты зразумеў мяне?"

# game/scripts/scene/scene_day_5.rpy:4946
translate belarusian event_medicated_meat_71e470a7:

    # "Я сглотнул."
    "Я глынуў сліну."

# game/scripts/scene/scene_day_5.rpy:4947
translate belarusian event_medicated_meat_37d56fae:

    # voice "voice/father/day5/11 Po.ogg"
    # Pap "Понял?"
    voice "voice/father/day5/11 Po.ogg"
    Pap "Зразумеў?"

# game/scripts/scene/scene_day_5.rpy:4949
translate belarusian event_medicated_meat_b0f41e99:

    # voice "voice/Anton/5day/11 Da.ogg"
    # Ant "Д-да."
    voice "voice/Anton/5day/11 Da.ogg"
    Ant "Т-так."

# game/scripts/scene/scene_day_5.rpy:4951
translate belarusian event_medicated_meat_587f0d4e:

    # voice "voice/father/day5/12 Un.ogg"
    # Pap "У неё и так забот полон рот..."
    voice "voice/father/day5/12 Un.ogg"
    Pap "У яе і так клопатаў поўны рот..."

# game/scripts/scene/scene_day_5.rpy:4953
translate belarusian event_medicated_meat_3d19fa73:

    # voice "voice/father/day5/13 Ya.ogg"
    # Pap "Я очень тебя прошу, выкинь эту гадость."
    voice "voice/father/day5/13 Ya.ogg"
    Pap "Я вельмі цябе прашу, выкінь гэтую брыдоту."

# game/scripts/scene/scene_day_5.rpy:4955
translate belarusian event_medicated_meat_c535ed0a:

    # voice "voice/father/day5/14 Tak.ogg"
    # Pap "Так, чтобы Оля не нашла случайно."
    voice "voice/father/day5/14 Tak.ogg"
    Pap "Так, каб Оля не знайшла выпадкова."

# game/scripts/scene/scene_day_5.rpy:4957
translate belarusian event_medicated_meat_1d740679:

    # voice "voice/Anton/5day/12 No.ogg"
    # Ant "Но..."
    voice "voice/Anton/5day/12 No.ogg"
    Ant "Але..."

# game/scripts/scene/scene_day_5.rpy:4962
translate belarusian event_medicated_meat_6154a2cb:

    # voice "voice/father/day5/15 Se.ogg"
    # Pap "Сейчас же."
    voice "voice/father/day5/15 Se.ogg"
    Pap "Зараз жа."

# game/scripts/scene/scene_day_5.rpy:4970
translate belarusian event_medicated_meat_9b8ad5ec:

    # voice "voice/father/day5/16 Ya.ogg"
    # Pap "Я пока всё тут уберу и скрою следы."
    voice "voice/father/day5/16 Ya.ogg"
    Pap "Я пакуль усё тут прыбяру і схаваю сляды."

# game/scripts/scene/scene_day_5.rpy:4980
translate belarusian event_medicated_meat_36094adb:

    # "Я кивнул обречённо, взял наволочку и вышел в коридор."
    "Я кіўнуў асуджана, узяў навалачку і выйшаў у калідор."

# game/scripts/scene/scene_day_5.rpy:4981
translate belarusian event_medicated_meat_5fda604d:

    # "Выкинуть? Но она же не мусор какой-то. Живое существо, которое я сделал мёртвым..."
    "Выкінуць? Але ж яна не смецце нейкае. Жывая істота, якую я зрабіў мёртвай..."

# game/scripts/scene/scene_day_5.rpy:4988
translate belarusian event_medicated_meat_d631353b:

    # "Я подавил всхлип и поднял стоящую в углу лопату."
    "Я стрымаў усхліп і падняў лапату, што стаяла ў куце."

# game/scripts/scene/scene_day_5.rpy:5000
translate belarusian event_medicated_zhulka_40d237b9:

    # "Папа наклонился, чтобы поднять с пола топор. Возле холодильника тявкнула Жулька."
    "Тата нахіліўся, каб падняць з падлогі сякеру. Каля халадзільніка цяўкнула Жулька."

# game/scripts/scene/scene_day_5.rpy:5001
translate belarusian event_medicated_zhulka_12330c08:

    # voice "voice/father/day5/20 Cha.ogg"
    # Pap "Час от часу не легче. Где ты его откопал?"
    voice "voice/father/day5/20 Cha.ogg"
    Pap "Што далей, то не лягчэй. Дзе ты яго адкапаў?"

# game/scripts/scene/scene_day_5.rpy:5003
translate belarusian event_medicated_zhulka_e7a50994:

    # voice "voice/Anton/5day/14 Eto.ogg"
    # Ant "Это девочка. Её зовут..."
    voice "voice/Anton/5day/14 Eto.ogg"
    Ant "Гэта дзяўчынка. Яе завуць..."

# game/scripts/scene/scene_day_5.rpy:5012
translate belarusian event_medicated_zhulka_c697269e:

    # "Папа не дал мне договорить."
    "Тата не даў мне дагаварыць."

# game/scripts/scene/scene_day_5.rpy:5015
translate belarusian event_medicated_zhulka_cb1981bf:

    # voice "voice/father/day5/21 Tak.ogg"
    # Pap "Так значит, это она устроила тут бардак?"
    voice "voice/father/day5/21 Tak.ogg"
    Pap "Дык значыць, гэта яна ўчыніла тут бардак?"

# game/scripts/scene/scene_day_5.rpy:5017
translate belarusian event_medicated_zhulka_552f3f8c:

    # voice "voice/Anton/5day/15 Ne.ogg"
    # Ant "Не совсем, но..."
    voice "voice/Anton/5day/15 Ne.ogg"
    Ant "Не зусім, але..."

# game/scripts/scene/scene_day_5.rpy:5019
translate belarusian event_medicated_zhulka_4b835b90:

    # voice "voice/father/day5/22 Ya.ogg"
    # Pap "Я не желаю пререкаться. Выгони её."
    voice "voice/father/day5/22 Ya.ogg"
    Pap "Я не жадаю спрачацца. Выгані яе."

# game/scripts/scene/scene_day_5.rpy:5021
translate belarusian event_medicated_zhulka_4dc924b5:

    # voice "voice/Anton/5day/16 Pa.ogg"
    # Ant "Пап!.."
    voice "voice/Anton/5day/16 Pa.ogg"
    Ant "Тата!.."

# game/scripts/scene/scene_day_5.rpy:5023
translate belarusian event_medicated_zhulka_010e8c1c:

    # voice "voice/father/day5/23 To.ogg"
    # Pap "Тоша, твоя мама сейчас на взводе."
    voice "voice/father/day5/23 To.ogg"
    Pap "Тоша, твая мама зараз на ўзводзе."

# game/scripts/scene/scene_day_5.rpy:5025
translate belarusian event_medicated_zhulka_e66ceb65:

    # voice "voice/father/day5/24 Um.ogg"
    # Pap "Умоляю, уведи собачонку, пока мама не увидела."
    voice "voice/father/day5/24 Um.ogg"
    Pap "Умаляю, адвядзі сабачку, пакуль мама не ўбачыла."

# game/scripts/scene/scene_day_5.rpy:5027
translate belarusian event_medicated_zhulka_3f07fb69:

    # voice "voice/father/day5/25 Ti.ogg"
    # Pap "Ты её знаешь. Она ни за что не разрешит нам оставить эту моську."
    voice "voice/father/day5/25 Ti.ogg"
    Pap "Ты яе ведаеш. Яна ні за што не дазволіць нам пакінуць гэтую моську."

# game/scripts/scene/scene_day_5.rpy:5031
translate belarusian event_medicated_zhulka_5509c9bc:

    # voice "voice/father/day5/26 Po.ogg"
    # Pap "По крайней мере, пока Оля больна. А там..."
    voice "voice/father/day5/26 Po.ogg"
    Pap "Прынамсі, пакуль Оля хворая. А там..."

# game/scripts/scene/scene_day_5.rpy:5033
translate belarusian event_medicated_zhulka_4b43e606:

    # voice "voice/father/day5/27 Ch.ogg"
    # Pap "... что-нибудь придумаем."
    voice "voice/father/day5/27 Ch.ogg"
    Pap "... што-небудзь прыдумаем."

# game/scripts/scene/scene_day_5.rpy:5036
translate belarusian event_medicated_zhulka_0b4ccb3b:

    # "Я обречённо вздохнул."
    "Я асуджана ўздыхнуў."

# game/scripts/scene/scene_day_5.rpy:5041
translate belarusian event_medicated_zhulka_f00338f0:

    # "Отец грустно улыбнулся и протянул пару сосисок из морозилки."
    "Бацька сумна ўсміхнуўся і працягнуў пару сасісак з маразілкі."

# game/scripts/scene/scene_day_5.rpy:5046
translate belarusian event_medicated_zhulka_dbd481dd:

    # voice "voice/father/day5/28 Na.ogg"
    # Pap "На. Покормишь по дороге."
    voice "voice/father/day5/28 Na.ogg"
    Pap "На. Пакорміш па дарозе."

# game/scripts/scene/scene_day_5.rpy:5052
translate belarusian event_medicated_zhulka_8f3cfbaf:

    # voice "voice/Anton/5day/18 poi.ogg"
    # Ant "Пойдём, Жулька."
    voice "voice/Anton/5day/18 poi.ogg"
    Ant "Хадзем, Жулька."

# game/scripts/scene/scene_day_5.rpy:5069
translate belarusian event_medicated_zhulka_3b0c8a8c:

    # "Вместе с довольной собачонкой, грызущей холодную сосиску, мы вышли в коридор."
    "Разам з задаволеным сабачкам, які грыз халодную сасіску, мы выйшлі ў калідор."

# game/scripts/scene/scene_day_5.rpy:5078
translate belarusian event_medicated_story_d465e3b8:

    # "Я прислушался, чтобы уловить разговор из детской, но разгулявшаяся стихия заглушала голоса."
    "Я прыслухаўся, каб улавіць размову з дзіцячай, але стыхія, што разгулялася, заглушала галасы."

# game/scripts/scene/scene_day_5.rpy:5144
translate belarusian event_medicated_story_9314fa0f:

    # "Накинув куртку, я обулся и вынес Жульку в метель."
    "Накінуўшы куртку, я абуўся і вынес Жульку ў завіруху."

# game/scripts/scene/scene_day_5.rpy:5150
translate belarusian event_medicated_story_f657e523:

    # "Накинув куртку, я свистнул собаке, и мы отправились в метель."
    "Накінуўшы куртку, я свіснуў сабаку, і мы выправіліся ў завіруху."

# game/scripts/scene/scene_day_5.rpy:5152
translate belarusian event_medicated_story_c31751cf:

    # "Утешало, что Жулька — уличная шавка и, наверное, научилась выживать зимой."
    "Суцяшала, што Жулька — вулічная шаўка і, напэўна, навучылася выжываць зімой."

# game/scripts/scene/scene_day_5.rpy:5166
translate belarusian event_medicated_story_5322b1e0:

    # "Я скормил ей последнее угощение, и та радостно принялась лизать мне руки."
    "Я скарміў ёй апошні гасцінец, і тая радасна ўзялася лізаць мне рукі."

# game/scripts/scene/scene_day_5.rpy:5169
translate belarusian event_medicated_story_54f64e78:

    # "Ветер толкал в спину, словно конвоировал меня к частоколу деревьев."
    "Вецер штурхаў у спіну, нібы канваіраваў мяне да частаколу дрэў."

# game/scripts/scene/scene_day_5.rpy:5186
translate belarusian event_medicated_story_ea75aac1:

    # "Они сгорбились в пурге, как уродливые палачи, замыслившие казнить меня за моё преступление."
    "Яны згорбіліся ў пурзе, як выродлівыя каты, што задумалі пакараць мяне смерцю за маё злачынства."

# game/scripts/scene/scene_day_5.rpy:5187
translate belarusian event_medicated_story_30ddde9a:

    # "Скопления елей походили на утёсы. В ущельях между ними гуляли ветра и седые призраки."
    "Купы ялін былі падобныя да ўцёсаў. У цяснінах паміж імі гулялі вятры і сівыя прывіды."

# game/scripts/scene/scene_day_5.rpy:5188
translate belarusian event_medicated_story_e140d865:

    # "Наверняка прошлые жертвы этого леса."
    "Напэўна, мінулыя ахвяры гэтага лесу."

# game/scripts/scene/scene_day_5.rpy:5189
translate belarusian event_medicated_story_bb9ce639:

    # "Нет. Это просто пороша..."
    "Не. Гэта проста пароша..."

# game/scripts/scene/scene_day_5.rpy:5190
translate belarusian event_medicated_story_6133023d:

    # "Но если на поляне так страшно, что творится в чаще?"
    "Але калі на паляне так страшна, што дзеецца ў гушчары?"

# game/scripts/scene/scene_day_5.rpy:5191
translate belarusian event_medicated_story_0802e13e:

    # "Не думай об этом..."
    "Не думай пра гэта..."

# game/scripts/scene/scene_day_5.rpy:5192
translate belarusian event_medicated_story_3d334354:

    # "Сделай, что велено, и беги обратно."
    "Зрабі, што загадана, і бяжы назад."

# game/scripts/scene/scene_day_5.rpy:5193
translate belarusian event_medicated_story_2b3a59fe:

    # "Я шёл, проваливаясь в сугробы."
    "Я ішоў, правальваючыся ў сумёты."

# game/scripts/scene/scene_day_5.rpy:5194
translate belarusian event_medicated_story_1ac71267:

    # "Чем ближе были сосны, тем темнее становилось."
    "Чым бліжэй былі сосны, тым цямней станавілася."

# game/scripts/scene/scene_day_5.rpy:5205
translate belarusian event_medicated_story_5d2eb265:

    # "Я оглянулся на дом."
    "Я азірнуўся на дом."

# game/scripts/scene/scene_day_5.rpy:5206
translate belarusian event_medicated_story_7f22d560:

    # "Свет в окнах дрожал, как пламя свечей, которые вот-вот задует ветер."
    "Святло ў вокнах дрыжала, як полымя свечак, якія вось-вось задзьме вецер."

# game/scripts/scene/scene_day_5.rpy:5207
translate belarusian event_medicated_story_4fc22d77:

    # "И мне почему-то подумалось, что никто не зажжёт их вновь."
    "І мне чамусьці падумалася, што ніхто не запаліць іх зноў."

# game/scripts/scene/scene_day_5.rpy:5215
translate belarusian event_medicated_story_6312dd79:

    # "Я опустил наволочку на снег и пробил лопатой ледяную корку."
    "Я апусціў навалачку на снег і прабіў лапатай ледзяную корку."

# game/scripts/scene/scene_day_5.rpy:5216
translate belarusian event_medicated_story_36205ea7:

    # "Земля под ней была твёрже камня."
    "Зямля пад ёй была цвярдзейшая за камень."

# game/scripts/scene/scene_day_5.rpy:5217
translate belarusian event_medicated_story_127783db:

    # "Тут не лопата нужна, а экскаватор. Значит, похороны отменяются."
    "Тут не лапата патрэбна, а экскаватар. Значыць, пахаванне адмяняецца."

# game/scripts/scene/scene_day_5.rpy:5218
translate belarusian event_medicated_story_8a232369:

    # "Как гробовщик, застигнутый дьявольской ночью на кладбище, я оглянулся."
    "Як трунар, заспеты д'ябальскай ноччу на могілках, я азірнуўся."

# game/scripts/scene/scene_day_5.rpy:5219
translate belarusian event_medicated_story_d0fa3900:

    # "На древесных палачей и слепленных из снега чудовищ."
    "На драўняных катоў і злепленых са снегу пачвар."

# game/scripts/scene/scene_day_5.rpy:5233
translate belarusian event_medicated_story_1cf85662:

    # voice "voice/Anton/5day/19 Be.ogg"
    # Ant "Беги, Жулька. Здесь тебе не рады."
    voice "voice/Anton/5day/19 Be.ogg"
    Ant "Бяжы, Жулька. Тут табе не рады."

# game/scripts/scene/scene_day_5.rpy:5240
translate belarusian event_medicated_story_a8e42407:

    # "Собака навострила уши."
    "Сабака навастрыў вушы."

# game/scripts/scene/scene_day_5.rpy:5277
translate belarusian event_medicated_story_bad91c65:

    # "Кусты шуршали, потрескивая."
    "Кусты шамацелі, патрэскваючы."

# game/scripts/scene/scene_day_5.rpy:5289
translate belarusian event_medicated_story_1eacac72:

    # "Во мраке заухало."
    "У змроку завухкала."

# game/scripts/scene/scene_day_5.rpy:5293
translate belarusian event_medicated_story_9c3ce84c:

    # "Хрустнула ветка."
    "Хруснула галінка."

# game/scripts/scene/scene_day_5.rpy:5313
translate belarusian event_medicated_story_8e43205e:

    # "Кто-то прошёл у кромки леса."
    "Хтосьці прайшоў ля ўскрайку лесу."

# game/scripts/scene/scene_day_5.rpy:5329
translate belarusian event_medicated_story_6f5da817:

    # "Жулька отрывисто гавкнула."
    "Жулька адрывіста гаўкнула."

# game/scripts/scene/scene_day_5.rpy:5343
translate belarusian event_medicated_story_594ee1bc:

    # "В панике я опять обернулся, но на этот раз не увидел дом."
    "У паніцы я зноў абярнуўся, але гэтым разам не ўбачыў дом."

# game/scripts/scene/scene_day_5.rpy:5344
translate belarusian event_medicated_story_8b115302:

    # "Метель окружила меня непроглядным хаосом."
    "Завіруха акружыла мяне непраглядным хаосам."

# game/scripts/scene/scene_day_5.rpy:5381
translate belarusian event_medicated_story_c0fab469:

    # "Между стволов свистело, снежинки летели в лицо."
    "Паміж ствалоў свісцела, сняжынкі ляцелі ў твар."

# game/scripts/scene/scene_day_5.rpy:5382
translate belarusian event_medicated_story_660991a4:

    # "Хруп. Хруп. Хруп."
    "Хруп. Хруп. Хруп."

# game/scripts/scene/scene_day_5.rpy:5383
translate belarusian event_medicated_story_760b5d1a:

    # "Почти как «труп» — так звучали шаги, приближающиеся из темноты."
    "Амаль як «труп» — так гучалі крокі, што набліжаліся з цемры."

# game/scripts/scene/scene_day_5.rpy:5386
translate belarusian event_medicated_story_4648938a:

    # "Я попятился и споткнулся о падаль. Жульку."
    "Я папяціўся і спатыкнуўся аб падаль. Жульку."

# game/scripts/scene/scene_day_5.rpy:5387
translate belarusian event_medicated_story_379d1d9e:

    # "Это просто папа пожалел меня и решил помочь с похоронами."
    "Гэта проста тата пашкадаваў мяне і вырашыў дапамагчы з пахаваннем."

# game/scripts/scene/scene_day_5.rpy:5403
translate belarusian event_medicated_story_16462eb1:

    # "Я попятился. Залаяла Жулька."
    "Я папяціўся. Забрахала Жулька."

# game/scripts/scene/scene_day_5.rpy:5404
translate belarusian event_medicated_story_e65e0eb5:

    # "Это просто папа пожалел собачонку и решил вернуть её в тепло."
    "Гэта проста тата пашкадаваў сабачку і вырашыў вярнуць яго ў цяпло."

# game/scripts/scene/scene_day_5.rpy:5442
translate belarusian event_medicated_story_c220626e:

    # voice "voice/Anton/5day/20 Pap.ogg"
    # Ant "Пап?"
    voice "voice/Anton/5day/20 Pap.ogg"
    Ant "Тат?"

# game/scripts/scene/scene_day_5.rpy:5444
translate belarusian event_medicated_story_b37b48be:

    # "Хруп. Хруп."
    "Хруп. Хруп."

# game/scripts/scene/scene_day_5.rpy:5448
translate belarusian event_medicated_story_9e5d42ef:

    # "Шаги остановились в нескольких метрах от меня."
    "Крокі спыніліся за некалькі метраў ад мяне."

# game/scripts/scene/scene_day_5.rpy:5449
translate belarusian event_medicated_story_01228812:

    # "Я напряг зрение."
    "Я напружыў зрок."

# game/scripts/scene/scene_day_5.rpy:5466
translate belarusian event_medicated_story_d781929e:

    # "Там никого нет. Это куст, гнущийся под порывами метели."
    "Там нікога няма. Гэта куст, што гнецца пад парывамі завірухі."

# game/scripts/scene/scene_day_5.rpy:5468
translate belarusian event_medicated_story_ce6a29c9:

    # voice "voice/Anton/5day/21 Vid.ogg"
    # "Я выдохнул."
    voice "voice/Anton/5day/21 Vid.ogg"
    "Я выдыхнуў."

# game/scripts/scene/scene_day_5.rpy:5486
translate belarusian event_medicated_story_c0cd9ea4:

    # "Чьи-то руки обхватили меня сзади..."
    "Чыесьці рукі абхапілі мяне ззаду..."

# game/scripts/scene/scene_day_5.rpy:5508
translate belarusian event_medicated_story_a68b46bf:

    # "... оторвали от земли..."
    "... адарвалі ад зямлі..."

# game/scripts/scene/scene_day_5.rpy:5511
translate belarusian event_medicated_story_fb47d848:

    # "И швырнули во мрак!"
    "І шпурнулі ў змрок!"

# game/scripts/scene/scene_day_5.rpy:5536
translate belarusian event_m_story_b88b1bd0:

    # "Беспамятство казалось колодцем, полным густого варева. Я медленно опускался на дно."
    "Бяспамяцтва здавалася калодзежам, поўным густога варыва. Я павольна апускаўся на дно."

# game/scripts/scene/scene_day_5.rpy:5537
translate belarusian event_m_story_e95af77c:

    # "Это было даже приятно — от меня ничего не зависело, я абсолютно расслабился в обволакивающей жиже."
    "Гэта было нават прыемна — ад мяне нічога не залежала, я цалкам расслабіўся ў жыжы, што ахінала мяне."

# game/scripts/scene/scene_day_5.rpy:5538
translate belarusian event_m_story_29e4b2e4:

    # "Как аквалангист, отдавшийся течению."
    "Як аквалангіст, што аддаўся плыні."

# game/scripts/scene/scene_day_5.rpy:5539
translate belarusian event_m_story_f6233667:

    # "Но даже тогда я знал, что колодец не бесконечен."
    "Але нават тады я ведаў, што калодзеж не бясконцы."

# game/scripts/scene/scene_day_5.rpy:5540
translate belarusian event_m_story_bf02c759:

    # "Я вряд ли проснусь в постели, рядом с взволнованными родителями."
    "Я наўрад ці прачнуся ў ложку, побач з усхваляванымі бацькамі."

# game/scripts/scene/scene_day_5.rpy:5561
translate belarusian event_m_story_cb4af3e9:

    # "Первой пришла боль."
    "Першым прыйшоў боль."

# game/scripts/scene/scene_day_5.rpy:5562
translate belarusian event_m_story_12a50854:

    # "Болели руки, словно по ним проехался автомобиль."
    "Балелі рукі, нібы па іх праехаўся аўтамабіль."

# game/scripts/scene/scene_day_5.rpy:5564
translate belarusian event_m_story_f9391824:

    # "Затем тусклый свет проник под затрепетавшие веки."
    "Потым цьмянае святло пранікла пад павекі, што затрымцелі."

# game/scripts/scene/scene_day_5.rpy:5565
translate belarusian event_m_story_0f1f63c4:

    # "Я открыл глаза и очутился в кошмаре."
    "Я расплюшчыў вочы і апынуўся ў кашмары."

# game/scripts/scene/scene_day_5.rpy:5598
translate belarusian event_m_story_542b8bd0:

    # "Реальность бросилась на меня фрагментами, как озверелая собачья свора."
    "Рэальнасць кінулася на мяне фрагментамі, як азвярэлая сабачая зграя."

# game/scripts/scene/scene_day_5.rpy:5603
translate belarusian event_m_story_7f9a1c31:

    # "Стеллажи. Железные стены. Лампочка на проводе. Клёпаный пол."
    "Стэлажы. Жалезныя сцены. Лямпачка на провадзе. Кляпаная падлога."

# game/scripts/scene/scene_day_5.rpy:5605
translate belarusian event_m_story_2251945c:

    # "Я очнулся внутри гаража."
    "Я апрытомнеў унутры гаража."

# game/scripts/scene/scene_day_5.rpy:5607
translate belarusian event_m_story_c794fd27:

    # "Ужас сковал меня надёжнее, чем верёвки, которые окольцовывали запястья."
    "Жах скаваў мяне надзейней за вяроўкі, якія абвівалі запясці."

# game/scripts/scene/scene_day_5.rpy:5627
translate belarusian event_m_story_0561133f:

    # "Я задёргался и замычал. Клейкая лента не позволяла позвать на помощь."
    "Я затузаўся і замычаў. Клейкая стужка не дазваляла паклікаць на дапамогу."

# game/scripts/scene/scene_day_5.rpy:5630
translate belarusian event_m_story_7891b130:

    # "Я висел в полуметре от грязного настила."
    "Я вісеў за паўметра ад бруднага насцілу."

# game/scripts/scene/scene_day_5.rpy:5631
translate belarusian event_m_story_5fce9896:

    # "Верёвки, закреплённые на ввинченном в потолок крюке, удерживали меня в горизонтальном положении."
    "Вяроўкі, замацаваныя на ўкручаным у столь круку, утрымлівалі мяне ў гарызантальным становішчы."

# game/scripts/scene/scene_day_5.rpy:5632
translate belarusian event_m_story_57ef63ee:

    # "Ноги были задраны назад."
    "Ногі былі задраны назад."

# game/scripts/scene/scene_day_5.rpy:5633
translate belarusian event_m_story_40104ed3:

    # "Онемевшие пальцы сжимались и разжимались. Путы впились в кожу."
    "Анямелыя пальцы сціскаліся і расціскаліся. Путы ўпіліся ў скуру."

# game/scripts/scene/scene_day_5.rpy:5635
translate belarusian event_m_story_6a9909ef:

    # "Во рту было сухо, язык прилип к нёбу."
    "У роце было суха, язык прыліп да паднябення."

# game/scripts/scene/scene_day_5.rpy:5636
translate belarusian event_m_story_d900e741:

    # "Это конец."
    "Гэта канец."

# game/scripts/scene/scene_day_5.rpy:5637
translate belarusian event_m_story_bcefa486:

    # "Точнее, начало конца, потому что умирать я буду долго."
    "Дакладней, пачатак канца, бо паміраць я буду доўга."

# game/scripts/scene/scene_day_5.rpy:5638
translate belarusian event_m_story_1e6a2870:

    # "Страшная действительность собралась по кускам в единую картину."
    "Страшная рэчаіснасць сабралася па кавалках у адзіную карціну."

# game/scripts/scene/scene_day_5.rpy:5639
translate belarusian event_m_story_a39116ad:

    # "Я постарался успокоиться и не калечить руки."
    "Я пастараўся супакоіцца і не калечыць рукі."

# game/scripts/scene/scene_day_5.rpy:5640
translate belarusian event_m_story_cb40bd65:

    # "По крайней мере, тот, кто пленил меня, куда-то отлучился. В железной коробке я был один."
    "Прынамсі, той, хто ўзяў мяне ў палон, кудысьці адышоў. У жалезнай скрынцы я быў адзін."

# game/scripts/scene/scene_day_5.rpy:5641
translate belarusian event_m_story_2228dd16:

    # "Может, я сумею освободиться?"
    "Можа, я здолею вызваліцца?"

# game/scripts/scene/scene_day_5.rpy:5649
translate belarusian event_m_story_9b13d3eb:

    # "Но через миг я снова дёргался, как муха в паучьей ловушке."
    "Але праз імгненне я зноў тузаўся, як муха ў павуковай пастцы."

# game/scripts/scene/scene_day_5.rpy:5650
translate belarusian event_m_story_874b901a:

    # "Вместо гаечных ключей и лебёдок — щипцы, скальпели, хирургические пилы."
    "Замест гаечных ключоў і лябёдак — шчыпцы, скальпелі, хірургічныя пілы."

# game/scripts/scene/scene_day_5.rpy:5654
translate belarusian event_m_story_2d088057:

    # "Всё грязное, в рыжей ржавчине."
    "Усё бруднае, у рудой іржы."

# game/scripts/scene/scene_day_5.rpy:5655
translate belarusian event_m_story_c1f4a103:

    # "Пол был заляпан бурыми пятнами."
    "Падлога была заляпана бурымі плямамі."

# game/scripts/scene/scene_day_5.rpy:5678
translate belarusian event_m_story_46047a8d:

    # "В углу лежала груда какой-то ветоши — когда я понял, на что смотрю, силы покинули меня."
    "У куце ляжала груда нейкага рыззя — калі я зразумеў, на што гляджу, сілы пакінулі мяне."

# game/scripts/scene/scene_day_5.rpy:5679
translate belarusian event_m_story_14e7b7cc:

    # "Это была одежда и детская обувь."
    "Гэта было адзенне і дзіцячы абутак."

# game/scripts/scene/scene_day_5.rpy:5680
translate belarusian event_m_story_d82a799d:

    # "Вещи жертв, моих предшественников, тех, кто погиб в логове маньяка."
    "Рэчы ахвяр, маіх папярэднікаў, тых, хто загінуў у логаве маньяка."

# game/scripts/scene/scene_day_5.rpy:5695
translate belarusian event_m_story_fb37fe66:

    # "Я сморгнул тяжёлые слёзы."
    "Я зміргнуў цяжкія слёзы."

# game/scripts/scene/scene_day_5.rpy:5696
translate belarusian event_m_story_eeec4065:

    # "Справа от меня находилось что-то большое, укутанное брезентом."
    "Справа ад мяне знаходзілася нешта вялікае, ахутанае брызентам."

# game/scripts/scene/scene_day_5.rpy:5697
translate belarusian event_m_story_d7488b32:

    # "А ещё левее сидел ребёнок."
    "А яшчэ лявей сядзела дзіця."

# game/scripts/scene/scene_day_5.rpy:5702
translate belarusian event_m_story_9fe6809e:

    # "Он сгорбился у штуковины, которая наверняка была генератором, питавшим лампочку."
    "Яно згорбілася каля штуковіны, якая, напэўна, была генератарам, што сілкаваў лямпачку."

# game/scripts/scene/scene_day_5.rpy:5704
translate belarusian event_m_story_1e224625:

    # "Перестав плакать, я замычал, привлекая к себе внимание."
    "Перастаўшы плакаць, я замычаў, прыцягваючы да сябе ўвагу."

# game/scripts/scene/scene_day_5.rpy:5705
translate belarusian event_m_story_1ae80075:

    # "Ребёнок повернулся ко мне спиной, затылком, закрытым капюшоном."
    "Дзіця павярнулася да мяне спінай, патыліцай, закрытай капюшонам."

# game/scripts/scene/scene_day_5.rpy:5706
translate belarusian event_m_story_81b703b9:

    # "Не определить, девочка это или мальчик."
    "Не вызначыць, дзяўчынка гэта ці хлопчык."

# game/scripts/scene/scene_day_5.rpy:5707
translate belarusian event_m_story_60a52934:

    # "Малыш... или малышка обнимала себя руками и монотонно раскачивалась из стороны в сторону."
    "Малы... ці малая абдымала сябе рукамі і манатонна гайдалася з боку ў бок."

# game/scripts/scene/scene_day_5.rpy:5708
translate belarusian event_m_story_08172496:

    # "В тишине, разбавленной гулом ветра снаружи, тень скользила по металлу."
    "У цішыні, разбаўленай гулам ветру звонку, цень слізгаў па метале."

# game/scripts/scene/scene_day_5.rpy:5709
translate belarusian event_m_story_a10629ab:

    # "А если это Оля?"
    "А калі гэта Оля?"

# game/scripts/scene/scene_day_5.rpy:5720
translate belarusian event_m_story_7a7dc20f:

    # "Мысль, что моя сестра тоже попала в Чёрный гараж, ошпарила кипятком."
    "Думка, што мая сястра таксама трапіла ў Чорны гараж, ашпарыла кіпнем."

# game/scripts/scene/scene_day_5.rpy:5731
translate belarusian event_m_story_bf3c5a18:

    # "Запрокинув голову и вывернув кисти, я попробовал достать пальцами до узлов."
    "Закінуўшы галаву і вывернуўшы кісці, я паспрабаваў дастаць пальцамі да вузлоў."

# game/scripts/scene/scene_day_5.rpy:5732
translate belarusian event_m_story_f745764c:

    # "Естественно, попытки потерпели крах."
    "Натуральна, спробы пацярпелі крах."

# game/scripts/scene/scene_day_5.rpy:5745
translate belarusian event_m_story_eaf1e89c:

    # "Я снова посмотрел на генератор."
    "Я зноў паглядзеў на генератар."

# game/scripts/scene/scene_day_5.rpy:5746
translate belarusian event_m_story_17e37fb1:

    # "Ребёнок исчез. Или вовсе померещился мне."
    "Дзіця знікла. Ці ўвогуле прымроілася мне."

# game/scripts/scene/scene_day_5.rpy:5747
translate belarusian event_m_story_f3a2bc55:

    # "Завертевшись, я поискал пропажу."
    "Завярцеўшыся, я пашукаў прапажу."

# game/scripts/scene/scene_day_5.rpy:5749
translate belarusian event_m_story_020d8ce4:

    # "Из-под брезента донёсся сдавленный хрип."
    "З-пад брызенту данёсся здушаны хрып."

# game/scripts/scene/scene_day_5.rpy:5750
translate belarusian event_m_story_81dd3e45:

    # "Снова галлюцинации?"
    "Зноў галюцынацыі?"

# game/scripts/scene/scene_day_5.rpy:5768
translate belarusian event_m_story_2dec2bac:

    # "Я уставился в источник еле слышного звука."
    "Я ўтаропіўся ў крыніцу ледзь чутнага гуку."

# game/scripts/scene/scene_day_5.rpy:5783
translate belarusian event_m_story_99baef2b:

    # "В этот миг стальная камера затряслась, да так, что моё тело, как на качелях, мотнуло к стеллажу."
    "У гэтае імгненне стальная камера затраслася, ды так, што маё цела, як на арэлях, матнула да стэлажа."

# game/scripts/scene/scene_day_5.rpy:5784
translate belarusian event_m_story_2277fae8:

    # "Задребезжали инструменты для пыток, закачалась лампочка, елозя световым пятном по жуткому логову."
    "Забразгалі інструменты для катаванняў, загайдалася лямпачка, соўгаючы светлавой плямай па жудасным логаве."

# game/scripts/scene/scene_day_5.rpy:5785
translate belarusian event_m_story_a049e7b4:

    # "Чёрный гараж стал театром теней."
    "Чорны гараж стаў тэатрам ценяў."

# game/scripts/scene/scene_day_5.rpy:5795
translate belarusian event_m_story_3117acff:

    # "Землетрясение?"
    "Землятрус?"

# game/scripts/scene/scene_day_5.rpy:5798
translate belarusian event_m_story_ba8b5433:

    # "Скорее, избушка Бабы Яги отрастила курьи ножки и пошла гулять."
    "Хутчэй, хатка Бабы Ягі адрасціла курыныя ножкі і пайшла гуляць."

# game/scripts/scene/scene_day_5.rpy:5802
translate belarusian event_m_story_4c814574:

    # "Гараж двигался. Да, меня точно куда-то везли."
    "Гараж рухаўся. Так, мяне дакладна кудысьці везлі."

# game/scripts/scene/scene_day_5.rpy:5806
translate belarusian event_m_story_32f94101:

    # "В рокоте ветра за стенами раздался шум мотора."
    "У рокаце ветру за сценамі пачуўся шум матора."

# game/scripts/scene/scene_day_5.rpy:5825
translate belarusian event_m_story_97825cc7:

    # "Лампочка замигала, на мгновение погасла и снова вспыхнула."
    "Лямпачка заміргала, на імгненне згасла і зноў успыхнула."

# game/scripts/scene/scene_day_5.rpy:5852
translate belarusian event_m_story_378a92fd:

    # "Это что, собачий лай?"
    "Гэта што, сабачы брэх?"

# game/scripts/scene/scene_day_5.rpy:5853
translate belarusian event_m_story_cdb20576:

    # "Меня мотнуло к генератору."
    "Мяне матнула да генератара."

# game/scripts/scene/scene_day_5.rpy:5877
translate belarusian event_m_story_9f22070d:

    # "Верёвка соскользнула с крюка, я рухнул на спину, выпучив от боли глаза."
    "Вяроўка саслізнула з крука, я зваліўся на спіну, вылупіўшы ад болю вочы."

# game/scripts/scene/scene_day_5.rpy:5931
translate belarusian event_m_story_627408c6:

    # "Дверь распахнулась, подтвердив мою догадку."
    "Дзверы расчыніліся насцеж, пацвердзіўшы маю здагадку."

# game/scripts/scene/scene_day_5.rpy:5932
translate belarusian event_m_story_416e3a5d:

    # "В метели проносились стволы деревьев. Мы двигались, вероятно, на буксире."
    "У завеі праносіліся ствалы дрэў. Мы рухаліся, відаць, на буксіры."

# game/scripts/scene/scene_day_5.rpy:5938
translate belarusian event_m_story_b4cd0c3f:

    # voice "voice/romka/5day/01 est.ogg"
    # Rom "Есть кто живой? Бяшка, ау!"
    voice "voice/romka/5day/01 est.ogg"
    Rom "Ёсць хто жывы? Бяшка, агу!"

# game/scripts/scene/scene_day_5.rpy:5952
translate belarusian event_m_story_4cc8e322:

    # "Ромка! Неужели это не глюк?"
    "Ромка! Няўжо гэта не глюк?"

# game/scripts/scene/scene_day_5.rpy:5956
translate belarusian event_m_story_932c0fb1:

    # "Я засучил ногами."
    "Я задрыгаў нагамі."

# game/scripts/scene/scene_day_5.rpy:5974
translate belarusian event_m_story_560066a5:

    # "Ромка запрыгнул в гараж, как опоздавший пассажир в отъехавший трамвай."
    "Ромка заскочыў у гараж, як запознены пасажыр у трамвай, што ад'ехаў."

# game/scripts/scene/scene_day_5.rpy:5978
translate belarusian event_m_story_ac35b4c1:

    # "Он нахмурился на миг и ринулся ко мне, первым делом сорвав кляп."
    "Ён нахмурыўся на імгненне і кінуўся да мяне, найперш сарваўшы кляп."

# game/scripts/scene/scene_day_5.rpy:5981
translate belarusian event_m_story_6db0662d:

    # voice "voice/romka/5day/03 bra.ogg"
    # Rom "Братуха! Цел?"
    voice "voice/romka/5day/03 bra.ogg"
    Rom "Братуха! Цэлы?"

# game/scripts/scene/scene_day_5.rpy:5983
translate belarusian event_m_story_e6bd3c62:

    # "У меня не было твёрдого ответа на этот вопрос."
    "У мяне не было цвёрдага адказу на гэтае пытанне."

# game/scripts/scene/scene_day_5.rpy:5984
translate belarusian event_m_story_7d929641:

    # voice "voice/romka/5day/04 Sha.ogg"
    # Rom "Щас, погоди..."
    voice "voice/romka/5day/04 Sha.ogg"
    Rom "Зараз, пачакай..."

# game/scripts/scene/scene_day_5.rpy:5997
translate belarusian event_m_story_43783d6e:

    # "Рома выхватил нож-бабочку и рассёк верёвки."
    "Рома выхапіў нож-матылёк і рассек вяроўкі."

# game/scripts/scene/scene_day_5.rpy:6000
translate belarusian event_m_story_165ecc75:

    # "Я застонал от боли в пережатых запястьях. Рома дал мне руку, и я встал."
    "Я застагнаў ад болю ў пераціснутых запясцях. Рома падаў мне руку, і я ўстаў."

# game/scripts/scene/scene_day_5.rpy:6068
translate belarusian event_m_story_f0d67c4d:

    # "Пол под нами ходил ходуном, мы балансировали, чтобы не соскользнуть к стенам."
    "Падлога пад намі хадзіла ходырам, мы балансавалі, каб не саслізнуць да сцен."

# game/scripts/scene/scene_day_5.rpy:6069
translate belarusian event_m_story_3aa27fe4:

    # voice "voice/romka/5day/06 Ya.ogg"
    # Rom "Я смотрю, фартовый ты пацан."
    voice "voice/romka/5day/06 Ya.ogg"
    Rom "Я гляджу, фартовы ты пацан."

# game/scripts/scene/scene_day_5.rpy:6073
translate belarusian event_m_story_a9fc512d:

    # voice "voice/romka/5day/20 Petrov.ogg"
    # Rom "Петров? А хер ли ты тут забыл?"
    voice "voice/romka/5day/20 Petrov.ogg"
    Rom "Пятроў? А якога хера ты тут забыў?"

# game/scripts/scene/scene_day_5.rpy:6075
translate belarusian event_m_story_c33e6734:

    # "У меня не было ответа на этот вопрос."
    "У мяне не было адказу на гэтае пытанне."

# game/scripts/scene/scene_day_5.rpy:6076
translate belarusian event_m_story_a1213ce8:

    # voice "voice/romka/5day/21 Os.ogg"
    # Rom "Оставить бы тебя тут помирать, лошара."
    voice "voice/romka/5day/21 Os.ogg"
    Rom "Пакінуць бы цябе тут паміраць, лашара."

# game/scripts/scene/scene_day_5.rpy:6078
translate belarusian event_m_story_7d9a2184:

    # "Его слова заставили меня окаменеть."
    "Яго словы прымусілі мяне акамянець."

# game/scripts/scene/scene_day_5.rpy:6079
translate belarusian event_m_story_737ec566:

    # voice "voice/romka/5day/22 Da.ogg"
    # Rom "Да прикалываюсь. Что я, нелюдь? Ща, погоди."
    voice "voice/romka/5day/22 Da.ogg"
    Rom "Ды прыкольваюся. Што я, нелюдзь? Зараз, пачакай."

# game/scripts/scene/scene_day_5.rpy:6092
translate belarusian event_m_story_43783d6e_1:

    # "Рома выхватил нож-бабочку и рассёк верёвки."
    "Рома выхапіў нож-матылёк і рассек вяроўкі."

# game/scripts/scene/scene_day_5.rpy:6096
translate belarusian event_m_story_f2179d11:

    # "Я застонал от боли в пережатых запястьях. Рома смотрел на меня с ухмылкой, пока я поднимался."
    "Я застагнаў ад болю ў пераціснутых запясцях. Рома глядзеў на мяне з ухмылкай, пакуль я падымаўся."

# game/scripts/scene/scene_day_5.rpy:6097
translate belarusian event_m_story_e022346f:

    # voice "voice/romka/5day/24 bu.ogg"
    # Rom "Будешь должен, обсос."
    voice "voice/romka/5day/24 bu.ogg"
    Rom "Будзеш вінен, абсос."

# game/scripts/scene/scene_day_5.rpy:6167
translate belarusian event_m_story_f0d67c4d_1:

    # "Пол под нами ходил ходуном, мы балансировали, чтобы не соскользнуть к стенам."
    "Падлога пад намі хадзіла ходырам, мы балансавалі, каб не саслізнуць да сцен."

# game/scripts/scene/scene_day_5.rpy:6168
translate belarusian event_m_story_67e8dfed:

    # voice "voice/romka/5day/25 Poz.ogg"
    # Rom "Поздравляю, Петров, ты не убийца."
    voice "voice/romka/5day/25 Poz.ogg"
    Rom "Віншую, Пятроў, ты не забойца."

# game/scripts/scene/scene_day_5.rpy:6170
translate belarusian event_m_story_e0ad1769:

    # "Что ж, подумал я, за это тоже спасибо."
    "Што ж, падумаў я, за гэта таксама дзякуй."

# game/scripts/scene/scene_day_5.rpy:6172
translate belarusian event_m_story_85744e7f:

    # voice "voice/Anton/5day/28 Kak.ogg"
    # Ant "Как ты здесь оказался?"
    voice "voice/Anton/5day/28 Kak.ogg"
    Ant "Як ты тут апынуўся?"

# game/scripts/scene/scene_day_5.rpy:6174
translate belarusian event_m_story_556876db:

    # voice "voice/romka/5day/07 Ka.ogg"
    # Rom "Как в боевике, прикинь."
    voice "voice/romka/5day/07 Ka.ogg"
    Rom "Як у баевіку, прыкінь."

# game/scripts/scene/scene_day_5.rpy:6176
translate belarusian event_m_story_752cb646:

    # voice "voice/romka/5day/08 By.ogg"
    # Rom "Бяша же пропал. Менты ко мне нагрянули, я ж его кореш закадычный."
    voice "voice/romka/5day/08 By.ogg"
    Rom "Бяша ж знік. Мянты да мяне наляцелі, я ж яго кораш закадычны."

# game/scripts/scene/scene_day_5.rpy:6178
translate belarusian event_m_story_d500ac4a:

    # voice "voice/romka/5day/09 Ti.ogg"
    # Rom "Тихонов то-сё, с нами, грит, поедешь."
    voice "voice/romka/5day/09 Ti.ogg"
    Rom "Ціханаў тое-сёе, з намі, кажа, паедзеш."

# game/scripts/scene/scene_day_5.rpy:6180
translate belarusian event_m_story_eeb25562:

    # voice "voice/romka/5day/10 On.ogg"
    # Rom "Они меня в бобик посадили и давай по окрестностям кататься."
    voice "voice/romka/5day/10 On.ogg"
    Rom "Яны мяне ў бобік пасадзілі і давай па ваколіцах катацца."

# game/scripts/scene/scene_day_5.rpy:6184
translate belarusian event_m_story_84ada17e:

    # voice "voice/romka/5day/11 Sch.ogg"
    # Rom "Считай, повезло. Маньячина гараж вёз, мы — за ним."
    voice "voice/romka/5day/11 Sch.ogg"
    Rom "Лічы, пашанцавала. Маньячына гараж вёз, мы — за ім."

# game/scripts/scene/scene_day_5.rpy:6190
translate belarusian event_m_story_3b9c18c4:

    # "Снаружи захлопали выстрелы, донёсся собачий лай."
    "Звонку заляскалі стрэлы, данёсся сабачы брэх."

# game/scripts/scene/scene_day_5.rpy:6191
translate belarusian event_m_story_1e8e4025:

    # voice "voice/Anton/5day/29 A.ogg"
    # Ant "А кто?.. Кто маньяк?"
    voice "voice/Anton/5day/29 A.ogg"
    Ant "А хто?.. Хто маньяк?"

# game/scripts/scene/scene_day_5.rpy:6194
translate belarusian event_m_story_2534ae1e:

    # "Рома открыл было рот, но из-под брезента снова раздался хрип."
    "Рома раскрыў быў рот, але з-пад брызенту зноў пачуўся хрып."

# game/scripts/scene/scene_day_5.rpy:6195
translate belarusian event_m_story_05da2de7:

    # voice "voice/romka/5day/12 B.ogg"
    # Rom "Бяша!"
    voice "voice/romka/5day/12 B.ogg"
    Rom "Бяша!"

# game/scripts/scene/scene_day_5.rpy:6200
translate belarusian event_m_story_6ebf4524:

    # "Мы кинулись на звук и в четыре руки потянули брезент."
    "Мы кінуліся на гук і ў чатыры рукі пацягнулі брызент."

# game/scripts/scene/scene_day_5.rpy:6256
translate belarusian event_m_story_3b0a46f1:

    # "От увиденного у меня запекло в голове."
    "Ад убачанага ў мяне запякло ў галаве."

# game/scripts/scene/scene_day_5.rpy:6257
translate belarusian event_m_story_7fc3c147:

    # "Под брезентом находилась промышленная мясорубка."
    "Пад брызентам знаходзілася прамысловая мясарубка."

# game/scripts/scene/scene_day_5.rpy:6292
translate belarusian event_m_story_89c7a0e4:

    # "В её воняющем машинным маслом раструбе лежала связанная Катя."
    "У яе раструбе, ад якога смярдзела машынным маслам, ляжала звязаная Каця."

# game/scripts/scene/scene_day_5.rpy:6293
translate belarusian event_m_story_f0c8b8a3:

    # "Глаза, полные отчаянья и слёз, уставились на нас."
    "Вочы, поўныя роспачы і слёз, утаропіліся на нас."

# game/scripts/scene/scene_day_5.rpy:6295
translate belarusian event_m_story_3b4d47bd:

    # "Катя замычала в кляп."
    "Каця замычала ў кляп."

# game/scripts/scene/scene_day_5.rpy:6296
translate belarusian event_m_story_832faf49:

    # voice "voice/Anton/5day/30 mi.ogg"
    # Ant "Мы тебя вытащим!"
    voice "voice/Anton/5day/30 mi.ogg"
    Ant "Мы цябе выцягнем!"

# game/scripts/scene/scene_day_5.rpy:6298
translate belarusian event_m_story_74c2cd6e:

    # voice "voice/Anton/5day/31 ost.ogg"
    # Ant "Осторожно, Ром!"
    voice "voice/Anton/5day/31 ost.ogg"
    Ant "Асцярожна, Ром!"

# game/scripts/scene/scene_day_5.rpy:6301
translate belarusian event_m_story_bf219383:

    # "Ромка меня услышал, но поделать уже ничего не мог."
    "Ромка мяне пачуў, але зрабіць ужо нічога не мог."

# game/scripts/scene/scene_day_5.rpy:6329
translate belarusian event_m_story_b032e9d6:

    # "Гараж тряхнуло, и хулигана бросило на борт мясорубки. Рычаг под раструбом сломался."
    "Гараж страсянула, і хулігана кінула на борт мясарубкі. Рычаг пад раструбам зламаўся."

# game/scripts/scene/scene_day_5.rpy:6343
translate belarusian event_m_story_f14fc841:

    # voice "voice/romka/5day/14 Bl.ogg"
    # Rom "Бля!"
    voice "voice/romka/5day/14 Bl.ogg"
    Rom "Бля!"

# game/scripts/scene/scene_day_5.rpy:6365
translate belarusian event_m_story_04b7e316:

    # "Махина прожорливо заворчала."
    "Махіна пражэрліва забурчала."

# game/scripts/scene/scene_day_5.rpy:6373
translate belarusian event_m_story_1441b08d:

    # "Ножи задвигались в чугунном жерле, ускоряясь."
    "Нажы зарухаліся ў чыгунным жарале, паскараючыся."

# game/scripts/scene/scene_day_5.rpy:6409
translate belarusian event_m_story_9795596d:

    # "Стали ещё больше Катины глаза."
    "Сталі яшчэ большымі Каціны вочы."

# game/scripts/scene/scene_day_5.rpy:6410
translate belarusian event_m_story_32f7665d:

    # "Я понял, что она соскальзывает в глотку мясорубки. Несколько секунд, и лезвия срежут её ступни."
    "Я зразумеў, што яна саслізгвае ў глотку мясарубкі. Некалькі секунд, і лязы зрэжуць яе ступні."

# game/scripts/scene/scene_day_5.rpy:6411
translate belarusian event_m_story_d5f4ba67:

    # "Ромка, корчась от боли, пытался сдвинуть рычаг руками."
    "Ромка, корчачыся ад болю, спрабаваў зрушыць рычаг рукамі."

# game/scripts/scene/scene_day_5.rpy:6415
translate belarusian event_m_story_5d90d149:

    # "Я сунул руки в раструб и схватил Катю за плечи."
    "Я сунуў рукі ў раструб і схапіў Кацю за плечы."

# game/scripts/scene/scene_day_5.rpy:6416
translate belarusian event_m_story_bf873c1f:

    # "Мои пальцы соскользнули."
    "Мае пальцы саслізнулі."

# game/scripts/scene/scene_day_5.rpy:6422
translate belarusian event_m_story_0764ed5d:

    # "Ноги девчонки соприкоснулись с лезвиями."
    "Ногі дзяўчынкі дакрануліся да лязоў."

# game/scripts/scene/scene_day_5.rpy:6443
translate belarusian event_m_story_7b1bb830:

    # "Адская спираль окрасилась в красный, а лицо Кати побагровело."
    "Пякельная спіраль афарбавалася ў чырвоны, а твар Каці пабагравеў."

# game/scripts/scene/scene_day_5.rpy:6444
translate belarusian event_m_story_d0722128:

    # "Я подумал, она теряет сознание."
    "Я падумаў, яна траціць прытомнасць."

# game/scripts/scene/scene_day_5.rpy:6488
translate belarusian event_m_story_f449faa6:

    # "Вцепившись в ворот Катиной куртки, я изо всех сил потянул девочку на себя."
    "Учапіўшыся ў каўнер Кацінай курткі, я з усіх сіл пацягнуў дзяўчынку на сябе."

# game/scripts/scene/scene_day_5.rpy:6498
translate belarusian event_m_story_1e08bcc6:

    # "На подмогу пришёл Ромка, не давая однокласснице провалиться в раструб."
    "На падмогу прыйшоў Ромка, не даючы аднакласніцы праваліцца ў раструб."

# game/scripts/scene/scene_day_5.rpy:6564
translate belarusian event_m_story_2697e7c4:

    # voice "voice/tihonov/5day/10 k.ogg"
    # Tikhonov "Кто здесь?"
    voice "voice/tihonov/5day/10 k.ogg"
    Tikhonov "Хто тут?"

# game/scripts/scene/scene_day_5.rpy:6597
translate belarusian event_m_story_28ef3c4f:

    # "Запыхавшийся лейтенант ввалился внутрь. Я не заметил, как гараж остановился."
    "Задыханы лейтэнант уваліўся ўнутр. Я не заўважыў, як гараж спыніўся."

# game/scripts/scene/scene_day_5.rpy:6600
translate belarusian event_m_story_6a787180:

    # "Снаружи продолжали трещать выстрелы."
    "Звонку працягвалі трашчаць стрэлы."

# game/scripts/scene/scene_day_5.rpy:6644
translate belarusian event_m_story_df0252ca:

    # voice "voice/Anton/5day/32 Let.ogg"
    # Ant "Лейтенант! На помощь!"
    voice "voice/Anton/5day/32 Let.ogg"
    Ant "Лейтэнант! На дапамогу!"

# game/scripts/scene/scene_day_5.rpy:6646
translate belarusian event_m_story_b8761ce1:

    # "Мой взгляд зацепился за место, где сидел призрак."
    "Мой погляд зачапіўся за месца, дзе сядзеў прывід."

# game/scripts/scene/scene_day_5.rpy:6683
translate belarusian event_m_story_c445ccaa:

    # voice "voice/Anton/5day/33 Ge.ogg"
    # Ant "Генератор!"
    voice "voice/Anton/5day/33 Ge.ogg"
    Ant "Генератар!"

# game/scripts/scene/scene_day_5.rpy:6747
translate belarusian event_m_story_96f92253:

    # voice "voice/kate/5day/06 m.ogg"
    # "Тихонов не спрашивал дважды."
    voice "voice/kate/5day/06 m.ogg"
    "Ціханаў не пытаўся двойчы."

# game/scripts/scene/scene_day_5.rpy:6763
translate belarusian event_m_story_00f0e230:

    # "Он бросился к генератору, пока мы с пришедшим на помощь Ромкой удерживали Катю."
    "Ён кінуўся да генератара, пакуль мы з Ромкам, які прыйшоў на дапамогу, утрымлівалі Кацю."

# game/scripts/scene/scene_day_5.rpy:6767
translate belarusian event_m_story_99b2966f:

    # "Милиционер в момент выключил зажигание."
    "Міліцыянер у момант выключыў запальванне."

# game/scripts/scene/scene_day_5.rpy:6795
translate belarusian event_m_story_78deb5bf:

    # voice "voice/kate/5day/07 m.ogg"
    # "Махина буркнула своей чугунной утробой и затихла."
    voice "voice/kate/5day/07 m.ogg"
    "Махіна буркнула сваім чыгунным чэравам і сціхла."

# game/scripts/scene/scene_day_5.rpy:6798
translate belarusian event_m_story_a413cf34:

    # "Лезвия повращались вхолостую и остановились. С них сочилась кровь."
    "Лязы пакруціліся ўхаластую і спыніліся. З іх сачылася кроў."

# game/scripts/scene/scene_day_5.rpy:6851
translate belarusian event_m_story_047398a1:

    # voice "voice/romka/5day/15 Toh .ogg"
    # Rom "Тоха, ты, по-братски, не говори, что я задел рычаг."
    voice "voice/romka/5day/15 Toh .ogg"
    Rom "Тоха, ты, па-брацку, не кажы, што я зачапіў рычаг."

# game/scripts/scene/scene_day_5.rpy:6853
translate belarusian event_m_story_7e822078:

    # "Я ответил коротким кивком, и он расслабился, поверив мне."
    "Я адказаў кароткім кіўком, і ён расслабіўся, паверыўшы мне."

# game/scripts/scene/scene_day_5.rpy:6854
translate belarusian event_m_story_d63d2e3a:

    # voice "voice/romka/5day/16 Sp.ogg"
    # Rom "Спасибо. Ты настоящий друг."
    voice "voice/romka/5day/16 Sp.ogg"
    Rom "Дзякуй. Ты сапраўдны сябар."

# game/scripts/scene/scene_day_5.rpy:6858
translate belarusian event_m_story_9b1d4449:

    # voice "voice/romka/5day/26 Pe.ogg"
    # Rom "Петров, мы с тобой, конечно, не кенты, но я всё-таки тебя освободил."
    voice "voice/romka/5day/26 Pe.ogg"
    Rom "Пятроў, мы з табой, вядома, не кенты, але я ўсё ж такі цябе вызваліў."

# game/scripts/scene/scene_day_5.rpy:6860
translate belarusian event_m_story_8513f8ae:

    # voice "voice/romka/5day/27 A.ogg"
    # Rom "А значит, ты мне должен..."
    voice "voice/romka/5day/27 A.ogg"
    Rom "А значыць, ты мне вінен..."

# game/scripts/scene/scene_day_5.rpy:6862
translate belarusian event_m_story_8e796f7f:

    # voice "voice/romka/5day/28 Ne.ogg"
    # Rom "Не говори, что я задел рычаг."
    voice "voice/romka/5day/28 Ne.ogg"
    Rom "Не кажы, што я зачапіў рычаг."

# game/scripts/scene/scene_day_5.rpy:6864
translate belarusian event_m_story_7e822078_1:

    # "Я ответил коротким кивком, и он расслабился, поверив мне."
    "Я адказаў кароткім кіўком, і ён расслабіўся, паверыўшы мне."

# game/scripts/scene/scene_day_5.rpy:6865
translate belarusian event_m_story_cddff1c6:

    # voice "voice/romka/5day/29 Kv.ogg"
    # Rom "Квиты."
    voice "voice/romka/5day/29 Kv.ogg"
    Rom "Квіты."

# game/scripts/scene/scene_day_5.rpy:6915
translate belarusian event_m_story_3caa5848:

    # "Мы достали Катю из мясорубки, и она обмякла на руках Тихонова."
    "Мы дасталі Кацю з мясарубкі, і яна абмякла на руках Ціханава."

# game/scripts/scene/scene_day_5.rpy:6932
translate belarusian event_m_story_1fe75970:

    # "Лишилась чувств, и это было для неё лучшим исходом."
    "Страціла прытомнасць, і гэта было для яе найлепшым выйсцем."

# game/scripts/scene/scene_day_5.rpy:6936
translate belarusian event_m_story_27f9a84f:

    # "В открытую дверь свистел ветер."
    "У адчыненыя дзверы свістаў вецер."

# game/scripts/scene/scene_day_5.rpy:6937
translate belarusian event_m_story_9d1eeabc:

    # "Меня затошнило при виде окровавленной ступни одноклассницы."
    "Мяне замлоіла ад выгляду скрываўленай ступні аднакласніцы."

# game/scripts/scene/scene_day_5.rpy:6938
translate belarusian event_m_story_a44a20c6:

    # "Большой палец отсутствовал, а его сосед болтался, соединённый с ногой тоненьким лоскутом кожи."
    "Вялікага пальца не было, а яго сусед боўтаўся, злучаны з нагой тоненькім шматком скуры."

# game/scripts/scene/scene_day_5.rpy:6939
translate belarusian event_m_story_5eefb965:

    # "Больше Катя не перегонит девчонок на физкультуре."
    "Больш Каця не перагоніць дзяўчат на фізкультуры."

# game/scripts/scene/scene_day_5.rpy:6940
translate belarusian event_m_story_52324cc8:

    # "От этой мысли захотелось плакать, но я собрался."
    "Ад гэтай думкі захацелася плакаць, але я сабраўся."

# game/scripts/scene/scene_day_5.rpy:6944
translate belarusian event_m_story_e70881c7:

    # voice "voice/romka/5day/17 Ne.ogg"
    # Rom "Нет... твою мать... нет..."
    voice "voice/romka/5day/17 Ne.ogg"
    Rom "Не... тваю маць... не..."

# game/scripts/scene/scene_day_5.rpy:6955
translate belarusian event_m_story_ce0e923b:

    # "Я обернулся на Рому. Он держал в руке кроссовок, извлечённый из груды обуви."
    "Я азірнуўся на Рому. Ён трымаў у руцэ красоўку, выцягнутую з груды абутку."

# game/scripts/scene/scene_day_5.rpy:6959
translate belarusian event_m_story_0133ea37:

    # voice "voice/romka/5day/32 By.ogg"
    # Rom "Бяша, братан..."
    voice "voice/romka/5day/32 By.ogg"
    Rom "Бяша, братан..."

# game/scripts/scene/scene_day_5.rpy:6972
translate belarusian event_m_story_720fbf61:

    # "Я положил ладонь на плечо Ромки."
    "Я паклаў далонь на плячо Ромкі."

# game/scripts/scene/scene_day_5.rpy:6973
translate belarusian event_m_story_f548f298:

    # voice "voice/Anton/5day/34 Ti.ogg"
    # Ant "Ты уверен? Это его?"
    voice "voice/Anton/5day/34 Ti.ogg"
    Ant "Ты ўпэўнены? Гэта яго?"

# game/scripts/scene/scene_day_5.rpy:6975
translate belarusian event_m_story_685ca273:

    # voice "voice/romka/5day/18 Eg.ogg"
    # Rom "Его... А раньше мой был... Я ему свои вещи давал донашивать..."
    voice "voice/romka/5day/18 Eg.ogg"
    Rom "Яго... А раней мая была... Я яму свае рэчы даваў даношваць..."

# game/scripts/scene/scene_day_5.rpy:6977
translate belarusian event_m_story_29299eca:

    # voice "voice/Anton/5day/35 Mne.ogg"
    # Ant "Мне жаль, друг."
    voice "voice/Anton/5day/35 Mne.ogg"
    Ant "Мне шкада, сябра."

# game/scripts/scene/scene_day_5.rpy:6981
translate belarusian event_m_story_0e46a17f:

    # "Мы не были друзьями, даже напротив."
    "Мы не былі сябрамі, нават наадварот."

# game/scripts/scene/scene_day_5.rpy:6982
translate belarusian event_m_story_5ef76643:

    # "Но обездоленный, потерянный вид Ромки вызвал во мне жалость."
    "Але абяздолены, разгублены выгляд Ромкі выклікаў у мяне жаль."

# game/scripts/scene/scene_day_5.rpy:6983
translate belarusian event_m_story_27257ac7:

    # "Я мог лишь представить, каково это — потерять друга."
    "Я мог толькі ўявіць, як гэта — страціць сябра."

# game/scripts/scene/scene_day_5.rpy:7034
translate belarusian event_m_story_6595a624:

    # voice "voice/tihonov/5day/12 Uho.ogg"
    # Tikhonov "Уходим отсюда."
    voice "voice/tihonov/5day/12 Uho.ogg"
    Tikhonov "Сыходзім адсюль."

# game/scripts/scene/scene_day_5.rpy:7065
translate belarusian event_m_story_d7cb8c72:

    # "Ромка обронил кроссовок."
    "Ромка выпусціў красоўку."

# game/scripts/scene/scene_day_5.rpy:7104
translate belarusian event_m_story_7b3ff4d8:

    # "Один за другим мы вышли в беснующуюся метель."
    "Адзін за адным мы выйшлі ў шалёную завею."

# game/scripts/scene/scene_day_5.rpy:7115
translate belarusian event_m_story_409f4a87:

    # "Вокруг вздымались сосны. Они напоминали полые кости, в которые дул погребальный ветер."
    "Вакол уздымаліся сосны. Яны нагадвалі полыя косці, у якія дзьмуў пахавальны вецер."

# game/scripts/scene/scene_day_5.rpy:7126
translate belarusian event_m_story_54127452:

    # "Снег засыпал кабину перевёрнутого трактора. Гараж уткнулся в сугроб."
    "Снег засыпаў кабіну перакуленага трактара. Гараж уткнуўся ў сумёт."

# game/scripts/scene/scene_day_5.rpy:7127
translate belarusian event_m_story_cf82f2e3:

    # "Здесь же припарковался милицейский автомобиль."
    "Тут жа прыпаркаваўся міліцэйскі аўтамабіль."

# game/scripts/scene/scene_day_5.rpy:7128
translate belarusian event_m_story_d577f05c:

    # "Отсвет мигалок, жуткие деревья и белая пустошь — эту картину я запомню навсегда."
    "Водсвет мігалак, жудасныя дрэвы і белая пустка — гэтую карціну я запомню назаўжды."

# game/scripts/scene/scene_day_5.rpy:7132
translate belarusian event_m_story_d1abd1fd:

    # "Вдали кто-то выстрелил."
    "Удалечыні нехта стрэліў."

# game/scripts/scene/scene_day_5.rpy:7133
translate belarusian event_m_story_cedf20ac:

    # "До меня дошло."
    "Да мяне дайшло."

# game/scripts/scene/scene_day_5.rpy:7134
translate belarusian event_m_story_ecd0641e:

    # "Тракторист!"
    "Трактарыст!"

# game/scripts/scene/scene_day_5.rpy:7135
translate belarusian event_m_story_fecbd5da:

    # "Это он транспортировал гараж с места на место. Он был убийцей!"
    "Гэта ён транспартаваў гараж з месца на месца. Ён быў забойцам!"

# game/scripts/scene/scene_day_5.rpy:7139
translate belarusian event_m_story_ca82bac7:

    # voice "voice/tihonov/5day/13 Dor.ogg"
    # Tikhonov "Доронин... и остальные... пошли за похитителем."
    voice "voice/tihonov/5day/13 Dor.ogg"
    Tikhonov "Даронін... і астатнія... пайшлі за выкрадальнікам."

# game/scripts/scene/scene_day_5.rpy:7175
translate belarusian event_m_story_6051a29a:

    # "К моим ногам подбежала, виляя хвостом, Жулька."
    "Да маіх ног падбегла, віляючы хвастом, Жулька."

# game/scripts/scene/scene_day_5.rpy:7177
translate belarusian event_m_story_8d5caa87:

    # voice "voice/tihonov/5day/14 Agero.ogg"
    # Tikhonov "А, героиня наша?"
    voice "voice/tihonov/5day/14 Agero.ogg"
    Tikhonov "А, гераіня наша?"

# game/scripts/scene/scene_day_5.rpy:7179
translate belarusian event_m_story_f8af5641:

    # voice "voice/Anton/5day/36 Ger.ogg"
    # Ant "Героиня?"
    voice "voice/Anton/5day/36 Ger.ogg"
    Ant "Гераіня?"

# game/scripts/scene/scene_day_5.rpy:7182
translate belarusian event_m_story_177df244:

    # voice "voice/tihonov/5day/15 Eto.ogg"
    # Tikhonov "Это она нас на гараж вывела. Получается, твой запах поймала."
    voice "voice/tihonov/5day/15 Eto.ogg"
    Tikhonov "Гэта яна нас на гараж вывела. Атрымліваецца, твой пах злавіла."

# game/scripts/scene/scene_day_5.rpy:7184
translate belarusian event_m_story_98ccb25e:

    # voice "voice/tihonov/5day/16 Po.ogg"
    # Tikhonov "Пойдёшь в милицию служить, нюхач?"
    voice "voice/tihonov/5day/16 Po.ogg"
    Tikhonov "Пойдзеш у міліцыю служыць, нюхач?"

# game/scripts/scene/scene_day_5.rpy:7189
translate belarusian event_m_story_8bb946af:

    # "Жулька тявкнула, словно соглашаясь."
    "Жулька цяўкнула, нібыта згаджаючыся."

# game/scripts/scene/scene_day_5.rpy:7193
translate belarusian event_m_story_956588dc:

    # "Я почесал собачку за ухом."
    "Я пачухаў сабачку за вухам."

# game/scripts/scene/scene_day_5.rpy:7197
translate belarusian event_m_story_d0da99e0:

    # voice "voice/Anton/5day/37 Kak.ogg"
    # Ant "Как вы меня нашли?"
    voice "voice/Anton/5day/37 Kak.ogg"
    Ant "Як вы мяне знайшлі?"

# game/scripts/scene/scene_day_5.rpy:7199
translate belarusian event_m_story_8fddf710:

    # voice "voice/tihonov/5day/17 Slu.ogg"
    # Tikhonov "Служебные овчарки кое-как на след вывели."
    voice "voice/tihonov/5day/17 Slu.ogg"
    Tikhonov "Службовыя аўчаркі сяк-так на след вывелі."

# game/scripts/scene/scene_day_5.rpy:7201
translate belarusian event_m_story_28ec03ea:

    # voice "voice/tihonov/5day/18 Sch.ogg"
    # Tikhonov "Считай, повезло."
    voice "voice/tihonov/5day/18 Sch.ogg"
    Tikhonov "Лічы, пашанцавала."

# game/scripts/scene/scene_day_5.rpy:7206
translate belarusian event_m_story_863ba5fc:

    # "Вдали за деревьями надсадно лаяло несколько собак."
    "Удалечыні за дрэвамі надрыўна брахала некалькі сабак."

# game/scripts/scene/scene_day_5.rpy:7207
translate belarusian event_m_story_1ce6d117:

    # voice "voice/tihonov/5day/19 pog.ogg"
    # Tikhonov "Погнались за уродом этим. Надеюсь, погрызут при задержании."
    voice "voice/tihonov/5day/19 pog.ogg"
    Tikhonov "Пагналіся за вырадкам гэтым. Спадзяюся, пагрызуць пры затрыманні."

# game/scripts/scene/scene_day_5.rpy:7241
translate belarusian event_m_story_1d1f82c8:

    # "В лесу становилось невыносимо холодно."
    "У лесе рабілася невыносна холадна."

# game/scripts/scene/scene_day_5.rpy:7242
translate belarusian event_m_story_5596f627:

    # "Тихонов посмотрел на безвольную Катю с отцовской нежностью и распорядился:"
    "Ціханаў паглядзеў на бязвольную Кацю з бацькоўскай пяшчотай і распарадзіўся:"

# game/scripts/scene/scene_day_5.rpy:7243
translate belarusian event_m_story_7d6f68a6:

    # voice "voice/tihonov/5day/20 A.ogg"
    # Tikhonov "Аптечка под бардачком. Пацан... Антон... притащи-ка бинты."
    voice "voice/tihonov/5day/20 A.ogg"
    Tikhonov "Аптэчка пад бардачком. Пацан... Антон... прынясі-тка бінты."

# game/scripts/scene/scene_day_5.rpy:7250
translate belarusian event_m_story_7c9a41d2:

    # "Я мигом исполнил поручение."
    "Я мігам выканаў даручэнне."

# game/scripts/scene/scene_day_5.rpy:7256
translate belarusian event_m_story_ac9e914a:

    # "Тихонов придерживал ногу Кати. На снег падали крупные красные капли."
    "Ціханаў прытрымліваў нагу Каці. На снег падалі буйныя чырвоныя кроплі."

# game/scripts/scene/scene_day_5.rpy:7261
translate belarusian event_m_story_c63fe806:

    # "Я перебинтовал стопу, то и дело поглядывая на капитана, мимикой спрашивая, всё ли правильно делаю."
    "Я перабінтаваў стапу, раз-пораз пазіраючы на капітана, мімікай пытаючыся, ці ўсё правільна раблю."

# game/scripts/scene/scene_day_5.rpy:7273
translate belarusian event_m_story_dabaa60b:

    # voice "voice/tihonov/5day/22 tep.ogg"
    # Tikhonov "Теперь узел... отлично."
    voice "voice/tihonov/5day/22 tep.ogg"
    Tikhonov "Цяпер вузел... выдатна."

# game/scripts/scene/scene_day_5.rpy:7276
translate belarusian event_m_story_9df7e50d:

    # "Сквозь белые нитки проступило пятнышко, похожее на иней. Только не бывает инея алого цвета."
    "Праз белыя ніткі праступіла плямка, падобная на шэрань. Толькі не бывае шэрані пунсовага колеру."

# game/scripts/scene/scene_day_5.rpy:7313
translate belarusian event_m_story_29d094ae:

    # "Я с трудом оторвал от него взор."
    "Я з цяжкасцю адарваў ад яе позірк."

# game/scripts/scene/scene_day_5.rpy:7317
translate belarusian event_m_story_592fe227:

    # voice "voice/tihonov/5day/23 Mu.ogg"
    # Tikhonov "Пацаны, побудьте с ней в машине."
    voice "voice/tihonov/5day/23 Mu.ogg"
    Tikhonov "Пацаны, пабудзьце з ёй у машыне."

# game/scripts/scene/scene_day_5.rpy:7319
translate belarusian event_m_story_2360b642:

    # voice "voice/tihonov/5day/24 Ya.ogg"
    # Tikhonov "Я найду Доронина."
    voice "voice/tihonov/5day/24 Ya.ogg"
    Tikhonov "Я знайду Дароніна."

# game/scripts/scene/scene_day_5.rpy:7336
translate belarusian event_m_story_7c9d47f9:

    # "Лейтенант отнёс Катю в салон."
    "Лейтэнант аднёс Кацю ў салон."

# game/scripts/scene/scene_day_5.rpy:7351
translate belarusian event_m_story_85a3b1a1:

    # voice "voice/tihonov/5day/25 Sl.ogg"
    # Tikhonov "Следи, чтоб у неё ноги были выше от земли."
    voice "voice/tihonov/5day/25 Sl.ogg"
    Tikhonov "Сачы, каб у яе ногі былі вышэй ад зямлі."

# game/scripts/scene/scene_day_5.rpy:7353
translate belarusian event_m_story_0964bed2:

    # voice "voice/tihonov/5day/26 A.ogg"
    # Tikhonov "А то, не дай бог, от потери крови помрёт..."
    voice "voice/tihonov/5day/26 A.ogg"
    Tikhonov "А то, не дай бог, ад страты крыві памрэ..."

# game/scripts/scene/scene_day_5.rpy:7388
translate belarusian event_m_story_2cf6c772:

    # "С этими словами милиционер удалился."
    "З гэтымі словамі міліцыянер аддаліўся."

# game/scripts/scene/scene_day_5.rpy:7439
translate belarusian event_m_story_39bcd3a1:

    # "Погружённый в себя Рома сел на переднее сидение и прижался виском к стеклу."
    "Пагружаны ў сябе Рома сеў на пярэдняе сядзенне і прытуліўся скроняй да шкла."

# game/scripts/scene/scene_day_5.rpy:7440
translate belarusian event_m_story_c6db0554:

    # "Со мной он больше не разговаривал."
    "Са мной ён больш не размаўляў."

# game/scripts/scene/scene_day_5.rpy:7442
translate belarusian event_m_story_decc5576:

    # "Я устроился позади, рядом с Катей."
    "Я ўладкаваўся ззаду, побач з Кацяй."

# game/scripts/scene/scene_day_5.rpy:7453
translate belarusian event_m_story_9d622f45:

    # "Она была слабой, бледной, как гипс, и какой-то пронзительно красивой."
    "Яна была слабай, бледнай, як гіпс, і нейкай пранізліва прыгожай."

# game/scripts/scene/scene_day_5.rpy:7454
translate belarusian event_m_story_5b67de37:

    # "Она больше не походила на хитрую бестию, а скорее была умирающим лебедем на моих руках."
    "Яна больш не нагадвала хітрую бестыю, а хутчэй была лебедзем, які памірае на маіх руках."

# game/scripts/scene/scene_day_5.rpy:7455
translate belarusian event_m_story_dd3c9c31:

    # "В тепле до меня начало доходить, что я выжил."
    "У цяпле да мяне пачало даходзіць, што я выжыў."

# game/scripts/scene/scene_day_5.rpy:7456
translate belarusian event_m_story_cfbdcff5:

    # "И эта глава кошмара осталась позади."
    "І гэты раздзел кашмару застаўся пазаду."

# game/scripts/scene/scene_day_5.rpy:7457
translate belarusian event_m_story_af26bc0a:

    # "Я оторвался от бушующей за окном метели и удивлённо посмотрел вниз."
    "Я адарваўся ад завеі, што бушавала за акном, і здзіўлена паглядзеў уніз."

# game/scripts/scene/scene_day_5.rpy:7463
translate belarusian event_m_story_9afb16e1:

    # voice "voice/kate/5day/09 dih.ogg"
    # "Катины пальцы стиснули мою руку."
    voice "voice/kate/5day/09 dih.ogg"
    "Каціны пальцы сціснулі маю руку."

# game/scripts/scene/scene_day_5.rpy:7467
translate belarusian event_m_story_396c0539:

    # "Катя смотрела на меня из-под полуопущенных век."
    "Каця глядзела на мяне з-пад паўапушчаных павек."

# game/scripts/scene/scene_day_5.rpy:7470
translate belarusian event_m_story_08fafa8e:

    # voice "voice/kate/5day/010 eto.ogg"
    # Kate "Это ты... Ты спас меня..."
    voice "voice/kate/5day/010 eto.ogg"
    Kate "Гэта ты... Ты выратаваў мяне..."

# game/scripts/scene/scene_day_5.rpy:7474
translate belarusian event_m_story_6c93cdcf:

    # "Я собирался сказать, что со мной Ромка, а где-то рядом — милиционеры во главе с Тихоновым."
    "Я збіраўся сказаць, што са мной Ромка, а недзе побач — міліцыянеры на чале з Ціханавым."

# game/scripts/scene/scene_day_5.rpy:7475
translate belarusian event_m_story_5eb55148:

    # "Но почему-то промолчал."
    "Але чамусьці прамаўчаў."

# game/scripts/scene/scene_day_5.rpy:7478
translate belarusian event_m_story_3b62d865:

    # voice "voice/kate/5day/011 spa.ogg"
    # Kate "Спасибо."
    voice "voice/kate/5day/011 spa.ogg"
    Kate "Дзякуй."

# game/scripts/scene/scene_day_5.rpy:7482
translate belarusian event_m_story_0b97dece:

    # "Я улыбнулся устало."
    "Я ўсміхнуўся стомлена."

# game/scripts/scene/scene_day_5.rpy:7487
translate belarusian event_m_story_a9f102f9:

    # voice "voice/Anton/5day/38 Otd.ogg"
    # Ant "Отдыхай. Нам всем нужно отдохнуть."
    voice "voice/Anton/5day/38 Otd.ogg"
    Ant "Адпачывай. Нам усім трэба адпачыць."

# game/scripts/scene/scene_day_5.rpy:7491
translate belarusian event_m_story_1f1d83bd:

    # "Я отвернулся к окну и продолжал ощущать пальцы Кати на руке."
    "Я адвярнуўся да акна і працягваў адчуваць пальцы Каці на руцэ."

# game/scripts/scene/scene_day_5.rpy:7546
translate belarusian event_m_story2_afterdev_8f4ce4ee:

    # "Зазвенел звонок. Ученики вывалились из классов."
    "Зазвінеў званок. Вучні вываліліся з класаў."

# game/scripts/scene/scene_day_5.rpy:7556
translate belarusian event_m_story2_afterdev_f13a0cf2:

    # "Ветер заметал школьный двор. Стаявший с обуви снег пачкал половицы."
    "Вецер замятаў школьны двор. Расталы снег з абутку пэцкаў масніцы."

# game/scripts/scene/scene_day_5.rpy:7558
translate belarusian event_m_story2_afterdev_54c2358c:

    # "Прошло две недели с тех пор, как мы выбрались из гнезда серийного убийцы."
    "Мінула два тыдні з таго часу, як мы выбраліся з гнязда серыйнага забойцы."

# game/scripts/scene/scene_day_5.rpy:7559
translate belarusian event_m_story2_afterdev_22a29f9d:

    # "Ромка почти не появлялся на занятиях, и у меня не было возможности поговорить с ним."
    "Ромка амаль не з'яўляўся на занятках, і ў мяне не было магчымасці пагаварыць з ім."

# game/scripts/scene/scene_day_5.rpy:7560
translate belarusian event_m_story2_afterdev_842ca1ca:

    # "Катю в последний раз я видел в милицейском бобике."
    "Кацю апошні раз я бачыў у міліцэйскім бобіку."

# game/scripts/scene/scene_day_5.rpy:7561
translate belarusian event_m_story2_afterdev_362bc2cb:

    # "Лилия Павловна взяла больничный по уходу за дочерью — её заменяла классная 6-А."
    "Лілія Паўлаўна ўзяла бальнічны па доглядзе за дачкой — яе замяняла класная 6-А."

# game/scripts/scene/scene_day_5.rpy:7562
translate belarusian event_m_story2_afterdev_54e273bd:

    # "Если бы папа не убедил маму, меня бы тоже заперли дома."
    "Калі б тата не пераканаў маму, мяне б таксама замкнулі дома."

# game/scripts/scene/scene_day_5.rpy:7563
translate belarusian event_m_story2_afterdev_7072f026:

    # "После случившегося родители глаз с меня не спускали."
    "Пасля таго, што здарылася, бацькі вачэй з мяне не спускалі."

# game/scripts/scene/scene_day_5.rpy:7564
translate belarusian event_m_story2_afterdev_b560681e:

    # "И одноклассники смотрели как-то иначе. Словно разглядели во мне пришельца с далёкой галактики."
    "І аднакласнікі глядзелі неяк інакш. Нібыта разгледзелі ўва мне прышэльца з далёкай галактыкі."

# game/scripts/scene/scene_day_5.rpy:7565
translate belarusian event_m_story2_afterdev_2b0faab7:

    # "Я не мог понять, что это за пришелец."
    "Я не мог зразумець, што гэта за прышэлец."

# game/scripts/scene/scene_day_5.rpy:7566
translate belarusian event_m_story2_afterdev_6d8d7587:

    # "Дружелюбный инопланетянин из фильма Спилберга или Чужой?"
    "Дружалюбны іншапланецянін з фільма Спілберга ці Чужы?"

# game/scripts/scene/scene_day_5.rpy:7567
translate belarusian event_m_story2_afterdev_212b7c3f:

    # "Стоя у окна, я всматривался в затянутый белой дымкой двор."
    "Стоячы каля акна, я ўглядаўся ў зацягнуты белай дымкай двор."

# game/scripts/scene/scene_day_5.rpy:7568
translate belarusian event_m_story2_afterdev_a94e04e8:

    # "Мир сузился до пришкольной территории, ограждённой вихрящимся мраком."
    "Свет звузіўся да прышкольнай тэрыторыі, агароджанай віхрыстым змрокам."

# game/scripts/scene/scene_day_5.rpy:7569
translate belarusian event_m_story2_afterdev_f72f1862:

    # "Убийце удалось сбежать..."
    "Забойцу ўдалося збегчы..."

# game/scripts/scene/scene_day_5.rpy:7570
translate belarusian event_m_story2_afterdev_9c74f4c5:

    # "Он всё ещё там..."
    "Ён усё яшчэ там..."

# game/scripts/scene/scene_day_5.rpy:7571
translate belarusian event_m_story2_afterdev_ea96bdd0:

    # "Возможно, обустраивает новый гараж, ещё чернее, ещё страшнее предыдущего."
    "Магчыма, уладкоўвае новы гараж, яшчэ чарнейшы, яшчэ страшнейшы за папярэдні."

# game/scripts/scene/scene_day_5.rpy:7586
translate belarusian event_m_story2_afterdev_8ee64e0f:

    # voice "voice/Polina/5day/23 Pr.ogg" 
    # Pol "Привет, мой герой."
    voice "voice/Polina/5day/23 Pr.ogg" 
    Pol "Прывітанне, мой герой."

# game/scripts/scene/scene_day_5.rpy:7590
translate belarusian event_m_story2_afterdev_3a5cf7a7:

    # "Полина улыбалась мне, спрятав за спину руки."
    "Паліна ўсміхалася мне, схаваўшы за спіну рукі."

# game/scripts/scene/scene_day_5.rpy:7593
translate belarusian event_m_story2_afterdev_08452c95:

    # voice "voice/Polina/5day/24 kak.ogg" 
    # Pol "Как же мы давно не общались!"
    voice "voice/Polina/5day/24 kak.ogg" 
    Pol "Як жа мы даўно не размаўлялі!"

# game/scripts/scene/scene_day_5.rpy:7596
translate belarusian event_m_story2_afterdev_a6d0b0b0:

    # voice "voice/Anton/5day/39 Po.ogg"
    # Ant "По телефону общались вчера."
    voice "voice/Anton/5day/39 Po.ogg"
    Ant "Па тэлефоне размаўлялі ўчора."

# game/scripts/scene/scene_day_5.rpy:7599
translate belarusian event_m_story2_afterdev_8be1c2fa:

    # voice "voice/Polina/5day/25 Te.ogg" 
    # Pol "Телефон не считается."
    voice "voice/Polina/5day/25 Te.ogg" 
    Pol "Тэлефон не лічыцца."

# game/scripts/scene/scene_day_5.rpy:7603
translate belarusian event_m_story2_afterdev_981277cb:

    # voice "voice/Polina/5day/26 Av.ogg" 
    # Pol "А вживую не болтали целую вечность!"
    voice "voice/Polina/5day/26 Av.ogg" 
    Pol "А ўжывую не балбаталі цэлую вечнасць!"

# game/scripts/scene/scene_day_5.rpy:7608
translate belarusian event_m_story2_afterdev_c20532e3:

    # voice "voice/Polina/5day/27 kak.ogg" 
    # Pol "Как поживаешь?"
    voice "voice/Polina/5day/27 kak.ogg" 
    Pol "Як пажываеш?"

# game/scripts/scene/scene_day_5.rpy:7612
translate belarusian event_m_story2_afterdev_b70014a2:

    # "А как я поживал?"
    "А як я пажываў?"

# game/scripts/scene/scene_day_5.rpy:7613
translate belarusian event_m_story2_afterdev_00e7d791:

    # "Как человек, на глазах которого лезвия отрезали девчонке два пальца — вот как."
    "Як чалавек, на вачах якога лёзы адрэзалі дзяўчынцы два пальцы — вось як."

# game/scripts/scene/scene_day_5.rpy:7614
translate belarusian event_m_story2_afterdev_ad5a6a80:

    # voice "voice/Anton/5day/40 Vse.ogg"
    # Ant "Всё в порядке... вроде."
    voice "voice/Anton/5day/40 Vse.ogg"
    Ant "Усё ў парадку... здаецца."

# game/scripts/scene/scene_day_5.rpy:7618
translate belarusian event_m_story2_afterdev_cafb2ce6:

    # voice "voice/Polina/5day/28 Ti.ogg" 
    # Pol "Ты изменился. Повзрослел."
    voice "voice/Polina/5day/28 Ti.ogg" 
    Pol "Ты змяніўся. Пасталеў."

# game/scripts/scene/scene_day_5.rpy:7623
translate belarusian event_m_story2_afterdev_5d021d0b:

    # voice "voice/Polina/5day/29 Do.ogg" 
    # Pol "До сих пор поверить не могу, что наш Петров спас человека из мясорубки."
    voice "voice/Polina/5day/29 Do.ogg" 
    Pol "Дагэтуль паверыць не магу, што наш Пятроў выратаваў чалавека з мясарубкі."

# game/scripts/scene/scene_day_5.rpy:7626
translate belarusian event_m_story2_afterdev_5ae6061d:

    # voice "voice/Anton/5day/41 Mi.ogg"
    # Ant "Мы с Ромкой..."
    voice "voice/Anton/5day/41 Mi.ogg"
    Ant "Мы з Ромкам..."

# game/scripts/scene/scene_day_5.rpy:7632
translate belarusian event_m_story2_afterdev_71341171:

    # voice "voice/Polina/5day/30 Ro.ogg" 
    # Pol "Ромка..."
    voice "voice/Polina/5day/30 Ro.ogg" 
    Pol "Ромка..."

# game/scripts/scene/scene_day_5.rpy:7636
translate belarusian event_m_story2_afterdev_cb5ae6d4:

    # voice "voice/Polina/5day/31 St.ogg" 
    # Pol "Странно, что он никого случайно не убил. С его везением..."
    voice "voice/Polina/5day/31 St.ogg" 
    Pol "Дзіўна, што ён нікога выпадкова не забіў. З ягоным шанцаваннем..."

# game/scripts/scene/scene_day_5.rpy:7641
translate belarusian event_m_story2_afterdev_c825317a:

    # "Полина поморщилась."
    "Паліна паморшчылася."

# game/scripts/scene/scene_day_5.rpy:7645
translate belarusian event_m_story2_afterdev_3c014ca5:

    # voice "voice/Polina/5day/32 A.ogg" 
    # Pol "А вот ты — совсем другое дело. Рядом с тобой безопасно."
    voice "voice/Polina/5day/32 A.ogg" 
    Pol "А вось ты — зусім іншая справа. Побач з табой бяспечна."

# game/scripts/scene/scene_day_5.rpy:7649
translate belarusian event_m_story2_afterdev_fbfc7cc0:

    # voice "voice/Polina/5day/33 De.ogg" 
    # Pol "Девушки такое чувствуют."
    voice "voice/Polina/5day/33 De.ogg" 
    Pol "Дзяўчаты такое адчуваюць."

# game/scripts/scene/scene_day_5.rpy:7653
translate belarusian event_m_story2_afterdev_f108d335:

    # "Я совсем растерялся."
    "Я зусім разгубіўся."

# game/scripts/scene/scene_day_5.rpy:7654
translate belarusian event_m_story2_afterdev_9f22d5df:

    # voice "voice/Anton/5day/43 Nu.ogg"
    # Ant "Ну не знаю..."
    voice "voice/Anton/5day/43 Nu.ogg"
    Ant "Ну не ведаю..."

# game/scripts/scene/scene_day_5.rpy:7658
translate belarusian event_m_story2_afterdev_0561646a:

    # voice "voice/Polina/5day/34 ne.ogg" 
    # Pol "Не скромничай! Хотя ты такой милый, когда краснеешь!"
    voice "voice/Polina/5day/34 ne.ogg" 
    Pol "Не будзь такім сціплым! Хоць ты такі мілы, калі чырванееш!"

# game/scripts/scene/scene_day_5.rpy:7666
translate belarusian event_m_story2_afterdev_a03dbc06:

    # voice "voice/Polina/5day/10 Vot.ogg"
    # Pol "Вот бы таких рыцарей, как ты, в мире было больше."
    voice "voice/Polina/5day/10 Vot.ogg"
    Pol "Вось бы такіх рыцараў, як ты, у свеце было больш."

# game/scripts/scene/scene_day_5.rpy:7670
translate belarusian event_m_story2_afterdev_1f072daf:

    # voice "voice/Polina/5day/11 Eto.ogg" 
    # Pol "Это бы решило многие проблемы, да?"
    voice "voice/Polina/5day/11 Eto.ogg" 
    Pol "Гэта б вырашыла многія праблемы, праўда?"

# game/scripts/scene/scene_day_5.rpy:7674
translate belarusian event_m_story2_afterdev_bcfe65b2:

    # "Она назвала меня рыцарем?"
    "Яна назвала мяне рыцарам?"

# game/scripts/scene/scene_day_5.rpy:7676
translate belarusian event_m_story2_afterdev_a6de9f2a:

    # "Я невнятно закряхтел, краснея, мысленно ругая себя за скованность."
    "Я невыразна закрактаў, чырванеючы, у думках лаючы сябе за скаванасць."

# game/scripts/scene/scene_day_5.rpy:7682
translate belarusian event_m_story2_afterdev_46c1bfc3:

    # "Полина бросила взгляд в окно, на летающие по ветру покрывала из снега."
    "Паліна кінула позірк у акно, на пакрывалы са снегу, што лёталі па ветры."

# game/scripts/scene/scene_day_5.rpy:7683
translate belarusian event_m_story2_afterdev_37a32b82:

    # "Дальше клумб — сплошная стена мглы."
    "Далей за клумбы — суцэльная сцяна імглы."

# game/scripts/scene/scene_day_5.rpy:7689
translate belarusian event_m_story2_afterdev_e06e297f:

    # voice "voice/Polina/5day/12 Du.ogg" 
    # Pol "Думаешь, этот псих ещё в посёлке?"
    voice "voice/Polina/5day/12 Du.ogg" 
    Pol "Думаеш, гэты псіх яшчэ ў пасёлку?"

# game/scripts/scene/scene_day_5.rpy:7692
translate belarusian event_m_story2_afterdev_2f1f8d97:

    # voice "voice/Anton/5day/45 Na.ogg"
    # Ant "Надеюсь, нет."
    voice "voice/Anton/5day/45 Na.ogg"
    Ant "Спадзяюся, не."

# game/scripts/scene/scene_day_5.rpy:7694
translate belarusian event_m_story2_afterdev_ad2cbac8:

    # voice "voice/Anton/5day/46 Mi.ogg"
    # Ant "Милиция прочесала всё вдоль и поперёк."
    voice "voice/Anton/5day/46 Mi.ogg"
    Ant "Міліцыя прачасала ўсё ўздоўж і ўпоперак."

# game/scripts/scene/scene_day_5.rpy:7703
translate belarusian event_m_story2_afterdev_7e9581be:

    # voice "voice/Polina/5day/13 U.ogg" 
    # Pol "У меня к тебе просьба, Антон."
    voice "voice/Polina/5day/13 U.ogg" 
    Pol "У мяне да цябе просьба, Антон."

# game/scripts/scene/scene_day_5.rpy:7707
translate belarusian event_m_story2_afterdev_8cb6c5fe:

    # voice "voice/Polina/5day/14 De.ogg" 
    # Pol "Дедушка сейчас в больнице."
    voice "voice/Polina/5day/14 De.ogg" 
    Pol "Дзядуля зараз у бальніцы."

# game/scripts/scene/scene_day_5.rpy:7710
translate belarusian event_m_story2_afterdev_3df6cb72:

    # voice "voice/Anton/5day/47 Ch.ogg"
    # Ant "Что-то серьёзное?"
    voice "voice/Anton/5day/47 Ch.ogg"
    Ant "Нешта сур'ёзнае?"

# game/scripts/scene/scene_day_5.rpy:7714
translate belarusian event_m_story2_afterdev_1c0513d3:

    # voice "voice/Polina/5day/39 V.ogg" 
    # Pol "В его возрасте всё серьёзно..."
    voice "voice/Polina/5day/39 V.ogg" 
    Pol "У ягоным узросце ўсё сур'ёзна..."

# game/scripts/scene/scene_day_5.rpy:7719
translate belarusian event_m_story2_afterdev_64b33a0b:

    # voice "voice/Polina/5day/40 Zn.ogg" 
    # Pol "Знаешь... мне страшно даже за закрытыми дверями..."
    voice "voice/Polina/5day/40 Zn.ogg" 
    Pol "Ведаеш... мне страшна нават за зачыненымі дзвярыма..."

# game/scripts/scene/scene_day_5.rpy:7723
translate belarusian event_m_story2_afterdev_dfd0567d:

    # voice "voice/Polina/5day/41 A.ogg" 
    # Pol "А на улице... в метели... сегодня по дороге в школу я расплакалась."
    voice "voice/Polina/5day/41 A.ogg" 
    Pol "А на вуліцы... у завеі... сёння па дарозе ў школу я расплакалася."

# game/scripts/scene/scene_day_5.rpy:7727
translate belarusian event_m_story2_afterdev_319aa4ac:

    # voice "voice/Polina/5day/42 G.ogg" 
    # Pol "Глупо, да?"
    voice "voice/Polina/5day/42 G.ogg" 
    Pol "Глупства, праўда?"

# game/scripts/scene/scene_day_5.rpy:7730
translate belarusian event_m_story2_afterdev_68957e96:

    # voice "voice/Anton/5day/48 Vo.ogg"
    # Ant "Вовсе не глупо."
    voice "voice/Anton/5day/48 Vo.ogg"
    Ant "Зусім не глупства."

# game/scripts/scene/scene_day_5.rpy:7732
translate belarusian event_m_story2_afterdev_42b4acfd:

    # "Мне казалось, она никогда не была так откровенна со мной."
    "Мне здавалася, яна ніколі не была такой шчырай са мной."

# game/scripts/scene/scene_day_5.rpy:7733
translate belarusian event_m_story2_afterdev_78bb9c1a:

    # "Прямота шла Полине, украшала и без того прекрасное лицо."
    "Прамата пасавала Паліне, упрыгожвала і без таго цудоўны твар."

# game/scripts/scene/scene_day_5.rpy:7734
translate belarusian event_m_story2_afterdev_11c996a7:

    # "А эти волшебные глаза... настороженные и в то же время доверчивые."
    "А гэтыя чароўныя вочы... насцярожаныя і ў той жа час даверлівыя."

# game/scripts/scene/scene_day_5.rpy:7735
translate belarusian event_m_story2_afterdev_62e31fe0:

    # "Под их внимательным взглядом хотелось быть рыцарем, настоящим."
    "Пад іх уважлівым позіркам хацелася быць рыцарам, сапраўдным."

# game/scripts/scene/scene_day_5.rpy:7738
translate belarusian event_m_story2_afterdev_1698ceb1:

    # voice "voice/Polina/5day/19 Ti.ogg" 
    # Pol "Ты бы мог проводить меня домой после уроков?"
    voice "voice/Polina/5day/19 Ti.ogg" 
    Pol "Ты б мог правесці мяне дадому пасля ўрокаў?"

# game/scripts/scene/scene_day_5.rpy:7742
translate belarusian event_m_story2_afterdev_fb799476:

    # voice "voice/Polina/5day/20 Dr.ogg" 
    # Pol "Другие мальчики мне предлагали, но что они сделают, если появится убийца?"
    voice "voice/Polina/5day/20 Dr.ogg" 
    Pol "Іншыя хлопчыкі мне прапаноўвалі, але што яны зробяць, калі з'явіцца забойца?"

# game/scripts/scene/scene_day_5.rpy:7745
translate belarusian event_m_story2_afterdev_60782d60:

    # "Я был польщён, и всё же не мог не задаться вопросом: а что сделаю я?"
    "Я быў уцешаны, і ўсё ж не мог не задацца пытаннем: а што зраблю я?"

# game/scripts/scene/scene_day_5.rpy:7746
translate belarusian event_m_story2_afterdev_8e8d43e1:

    # "Как Чак Норрис, достану автомат Узи?"
    "Як Чак Норыс, дастану аўтамат Узі?"

# game/scripts/scene/scene_day_5.rpy:7747
translate belarusian event_m_story2_afterdev_924aea35:

    # "Полина смотрела на меня так, словно не сомневалась, что этот автомат лежит в моём портфеле, и не один."
    "Паліна глядзела на мяне так, нібыта не сумнявалася, што гэты аўтамат ляжыць у маім партфелі, і не адзін."

# game/scripts/scene/scene_day_5.rpy:7750
translate belarusian event_m_story2_afterdev_b4685d32:

    # voice "voice/Polina/5day/21 Mi.ogg" 
    # Pol "Мы договорились?"
    voice "voice/Polina/5day/21 Mi.ogg" 
    Pol "Мы дамовіліся?"

# game/scripts/scene/scene_day_5.rpy:7763
translate belarusian event_m_story2_afterdev_80a2ac91:

    # "Я хотел ответить, но в этот момент у лестницы появились двое."
    "Я хацеў адказаць, але ў гэты момант каля лесвіцы з'явіліся двое."

# game/scripts/scene/scene_day_5.rpy:7809
translate belarusian event_m_story2_afterdev_550ee75d:

    # "Лилия Павловна и Катя на костылях."
    "Лілія Паўлаўна і Каця на мыліцах."

# game/scripts/scene/scene_day_5.rpy:7810
translate belarusian event_m_story2_afterdev_f196be23:

    # "За недели отсутствия она похудела — выглядела очень хрупкой."
    "За тыдні адсутнасці яна схуднела — выглядала вельмі крохкай."

# game/scripts/scene/scene_day_5.rpy:7826
translate belarusian event_m_story2_afterdev_136b3986:

    # "Я вспомнил, как Катя смотрела на меня в бобике: источая нежность во взгляде."
    "Я ўспомніў, як Каця глядзела на мяне ў бобіку: выпраменьваючы пяшчоту ў позірку."

# game/scripts/scene/scene_day_5.rpy:7827
translate belarusian event_m_story2_afterdev_1e2f28b7:

    # "Тот ужасный день стал чуточку светлее благодаря мгновению близости двух сбежавших от смерти людей."
    "Той жудасны дзень стаў крышачку святлейшым дзякуючы імгненню блізкасці двух людзей, якія ўцяклі ад смерці."

# game/scripts/scene/scene_day_5.rpy:7868
translate belarusian event_m_story2_afterdev_973cebd9:

    # "Звонок заставил меня поёжиться."
    "Званок прымусіў мяне здрыгануцца."

# game/scripts/scene/scene_day_5.rpy:7875
translate belarusian event_m_story2_afterdev_3ddd0c9a:

    # voice "voice/Polina/5day/22 Vs.ogg"
    # Pol "Встретимся после уроков."
    voice "voice/Polina/5day/22 Vs.ogg"
    Pol "Сустрэнемся пасля ўрокаў."

# game/scripts/scene/scene_day_5.rpy:7927
translate belarusian event_m_story2_afterdev_2c8c7034:

    # "Мы вошли в класс."
    "Мы ўвайшлі ў клас."

# game/scripts/scene/scene_day_5.rpy:7931
translate belarusian event_m_story2_afterdev_5ee8214d:

    # "Слух о возвращении Лилии Павловны опередил учительницу."
    "Чутка пра вяртанне Ліліі Паўлаўны апярэдзіла настаўніцу."

# game/scripts/scene/scene_day_5.rpy:7936
translate belarusian event_m_story2_afterdev_0957ca5f:

    # "К её приходу дети стояли по стойке смирно."
    "Да яе прыходу дзеці стаялі навыцяжку."

# game/scripts/scene/scene_day_5.rpy:7946
translate belarusian event_m_story2_afterdev_ed9e335b:

    # voice "voice/lydia/5day/02 sa.ogg"
    # Lilia_P "Садитесь."
    voice "voice/lydia/5day/02 sa.ogg"
    Lilia_P "Сядайце."

# game/scripts/scene/scene_day_5.rpy:7953
translate belarusian event_m_story2_afterdev_b132c251:

    # voice "voice/lydia/5day/03 ka.ogg"
    # Lilia_P "Катюш, дойти сама сможешь?"
    voice "voice/lydia/5day/03 ka.ogg"
    Lilia_P "Кацюш, дайсці сама зможаш?"

# game/scripts/scene/scene_day_5.rpy:7980
translate belarusian event_m_story2_afterdev_fbf66b84:

    # voice "voice/kate/5day/08 smog.ogg"
    # Kate "Смогу, мам."
    voice "voice/kate/5day/08 smog.ogg"
    Kate "Змагу, мам."

# game/scripts/scene/scene_day_5.rpy:7999
translate belarusian event_m_story2_afterdev_7cfa946f:

    # voice "voice/kate/5day/013 hod.ogg"
    # "Катя поковыляла по проходу, в то время как одноклассники буравили её взглядами."
    voice "voice/kate/5day/013 hod.ogg"
    "Каця пашкутыльгала па праходзе, у той час як аднакласнікі свідравалі яе позіркамі."

# game/scripts/scene/scene_day_5.rpy:8002
translate belarusian event_m_story2_afterdev_b6ce582c:

    # "Может быть, они воображали себя на её месте, в гараже психопата."
    "Можа быць, яны ўяўлялі сябе на яе месцы, у гаражы псіхапата."

# game/scripts/scene/scene_day_5.rpy:8004
translate belarusian event_m_story2_afterdev_0cc519c8:

    # voice "voice/kate/5day/014 hod.ogg"
    # "Или размышляли, каково это — передвигаться без двух пальцев на ноге."
    voice "voice/kate/5day/014 hod.ogg"
    "Ці разважалі, як гэта — перасоўвацца без двух пальцаў на назе."

# game/scripts/scene/scene_day_5.rpy:8015
translate belarusian event_m_story2_afterdev_6a0b8e02:

    # "Пропустив своё место, словно забыв за время больничного, где сидит, она поравнялась с моей партой."
    "Прапусціўшы сваё месца, нібыта забыўшы за час бальнічнага, дзе сядзіць, яна параўнялася з маёй партай."

# game/scripts/scene/scene_day_5.rpy:8021
translate belarusian event_m_story2_afterdev_f8419676:

    # "Встала, потупившись."
    "Стала, патупіўшыся."

# game/scripts/scene/scene_day_5.rpy:8022
translate belarusian event_m_story2_afterdev_8f0584ec:

    # "Я опешил."
    "Я аслупянеў."

# game/scripts/scene/scene_day_5.rpy:8027
translate belarusian event_m_story2_afterdev_7208f390:

    # "Вдвойне огорошенный тем, что за нами, повернувшись вполоборота, напряжённо следила Полина."
    "Удвая агаломшаны тым, што за намі, павярнуўшыся ўпаўабарота, напружана сачыла Паліна."

# game/scripts/scene/scene_day_5.rpy:8030
translate belarusian event_m_story2_afterdev_6e6b94e4:

    # voice "voice/kate/5day/015 pod.ogg"
    # Kate "Подвинешься?"
    voice "voice/kate/5day/015 pod.ogg"
    Kate "Пасунешся?"

# game/scripts/scene/scene_day_5.rpy:8039
translate belarusian event_m_story2_afterdev_4543926f:

    # "Я не знал, что мне делать."
    "Я не ведаў, што мне рабіць."

# game/scripts/scene/scene_day_5.rpy:8041
translate belarusian event_m_story2_afterdev_d69934d9:

    # "«Меж двух огней» — словосочетание, которое частенько использовал папа."
    "«Паміж двух агнёў» — словазлучэнне, якое часцяком ужываў тата."

# game/scripts/scene/scene_day_5.rpy:8042
translate belarusian event_m_story2_afterdev_483c3113:

    # "Полина сжала в пальцах карандаш. Мне казалось, он сейчас треснет."
    "Паліна сціснула ў пальцах аловак. Мне здавалася, ён зараз трэсне."

# game/scripts/scene/scene_day_5.rpy:8043
translate belarusian event_m_story2_afterdev_58bf02e5:

    # "Давление передавалось и моему позвоночнику."
    "Ціск перадаваўся і майму хрыбетніку."

# game/scripts/scene/scene_day_5.rpy:8056
translate belarusian event_m_story2_afterdev_c32e634f:

    # voice "voice/kate/5day/015 mne.ogg"
    # Kate "Мне долго ждать?"
    voice "voice/kate/5day/015 mne.ogg"
    Kate "Мне доўга чакаць?"

# game/scripts/scene/scene_day_5.rpy:8059
translate belarusian event_m_story2_afterdev_610d45cf:

    # voice "voice/Anton/5day/49 Ch2.ogg"
    # Ant "Что?"
    voice "voice/Anton/5day/49 Ch2.ogg"
    Ant "Што?"

# game/scripts/scene/scene_day_5.rpy:8066
translate belarusian event_m_story2_afterdev_45fad262:

    # voice "voice/kate/5day/011 ti.ogg"
    # Kate "Ты тормоз?"
    voice "voice/kate/5day/011 ti.ogg"
    Kate "Ты тормаз?"

# game/scripts/scene/scene_day_5.rpy:8069
translate belarusian event_m_story2_afterdev_cdc1a2b3:

    # "Она наконец посмотрела на меня. Я не особо скучал по этому колючему взгляду."
    "Яна нарэшце паглядзела на мяне. Я не асабліва сумаваў па гэтым калючым позірку."

# game/scripts/scene/scene_day_5.rpy:8083
translate belarusian event_m_story2_afterdev_306e60d6:

    # voice "voice/kate/5day/016 k.ogg"
    # Kate "К шкафу подвинулся, очкарик."
    voice "voice/kate/5day/016 k.ogg"
    Kate "Да шафы пасунуўся, акулярнік."

# game/scripts/scene/scene_day_5.rpy:8096
translate belarusian event_m_story2_afterdev_a82f4a02:

    # "От обиды у меня спёрло дыхание."
    "Ад крыўды ў мяне заняло дыханне."

# game/scripts/scene/scene_day_5.rpy:8097
translate belarusian event_m_story2_afterdev_e9be34a6:

    # "Очкарик?"
    "Акулярнік?"

# game/scripts/scene/scene_day_5.rpy:8098
translate belarusian event_m_story2_afterdev_8179914a:

    # "После всего, что случилось?"
    "Пасля ўсяго, што здарылася?"

# game/scripts/scene/scene_day_5.rpy:8109
translate belarusian event_m_story2_afterdev_cb11dc04:

    # "С пылающими щеками я повиновался приказу."
    "З палаючымі шчокамі я падпарадкаваўся загаду."

# game/scripts/scene/scene_day_5.rpy:8115
translate belarusian event_m_story2_afterdev_697dcc81:

    # voice "voice/kate/5day/017 na.ogg"
    # Kate "На полу."
    voice "voice/kate/5day/017 na.ogg"
    Kate "На падлозе."

# game/scripts/scene/scene_day_5.rpy:8118
translate belarusian event_m_story2_afterdev_80164e43:

    # voice "voice/Anton/5day/49 Ch.ogg"
    # Ant "Что?"
    voice "voice/Anton/5day/49 Ch.ogg"
    Ant "Што?"

# game/scripts/scene/scene_day_5.rpy:8125
translate belarusian event_m_story2_afterdev_ce1aa1ec:

    # voice "voice/kate/5day/018 na.ogg"
    # Kate "На полу грязь."
    voice "voice/kate/5day/018 na.ogg"
    Kate "На падлозе бруд."

# game/scripts/scene/scene_day_5.rpy:8128
translate belarusian event_m_story2_afterdev_ae021562:

    # voice "voice/Anton/5day/50 Ya.ogg"
    # Ant "Я не дежурный сегодня."
    voice "voice/Anton/5day/50 Ya.ogg"
    Ant "Я не дзяжурны сёння."

# game/scripts/scene/scene_day_5.rpy:8151
translate belarusian event_m_story2_afterdev_9187fde8:

    # voice "voice/kate/5day/019 eto.ogg"
    # Kate "Это грязь с твоих копыт. Убрал!"
    voice "voice/kate/5day/019 eto.ogg"
    Kate "Гэта бруд з тваіх капытоў. Прыбраў!"

# game/scripts/scene/scene_day_5.rpy:8163
translate belarusian event_m_story2_afterdev_d1ff0359:

    # "Я сглотнул, не глядя на одноклассников, надеясь, что и они не смотрят в нашу сторону."
    "Я глытнуў сліну, не гледзячы на аднакласнікаў, спадзяючыся, што і яны не глядзяць у наш бок."

# game/scripts/scene/scene_day_5.rpy:8166
translate belarusian event_m_story2_afterdev_c0e179e7:

    # "И не наслаждаются этим унизительным спектаклем."
    "І не насалоджваюцца гэтым прыніжальным спектаклем."

# game/scripts/scene/scene_day_5.rpy:8175
translate belarusian event_m_story2_afterdev_d700fa59:

    # voice "voice/Anton/5day/52 Hor.ogg"
    # Ant "Хорошо."
    voice "voice/Anton/5day/52 Hor.ogg"
    Ant "Добра."

# game/scripts/scene/scene_day_5.rpy:8206
translate belarusian event_m_story2_afterdev_66e693d0:

    # "Не сводя с Кати глаз, я подошвой растёр крошечную лужицу под партой."
    "Не зводзячы з Каці вачэй, я падэшвай расцёр маленечкую лужынку пад партай."

# game/scripts/scene/scene_day_5.rpy:8211
translate belarusian event_m_story2_afterdev_246464d4:

    # voice "voice/lydia/5day/04 ti.ogg"
    # Lilia_P "Ты почему стоишь, Кать?"
    voice "voice/lydia/5day/04 ti.ogg"
    Lilia_P "Ты чаму стаіш, Каць?"

# game/scripts/scene/scene_day_5.rpy:8219
translate belarusian event_m_story2_afterdev_34472f65:

    # voice "voice/kate/5day/020 Lil.ogg"
    # Kate "Лилия Павловна, Лилия Павловна, тут Петров насвинячил!"
    voice "voice/kate/5day/020 Lil.ogg"
    Kate "Лілія Паўлаўна, Лілія Паўлаўна, тут Пятроў насвінячыў!"

# game/scripts/scene/scene_day_5.rpy:8229
translate belarusian event_m_story2_afterdev_d5f8911c:

    # voice "voice/kate/5day/021 da.ogg"
    # Kate "Да-да!"
    voice "voice/kate/5day/021 da.ogg"
    Kate "Так-так!"

# game/scripts/scene/scene_day_5.rpy:8233
translate belarusian event_m_story2_afterdev_a772766d:

    # voice "voice/kate/5day/022 vot.ogg"
    # Kate "Вот жду, пока он за собой уберётся."
    voice "voice/kate/5day/022 vot.ogg"
    Kate "Вось чакаю, пакуль ён за сабой прыбярэ."

# game/scripts/scene/scene_day_5.rpy:8240
translate belarusian event_m_story2_afterdev_325398e2:

    # voice "voice/lydia/5day/05 pe.ogg"
    # Lilia_P "Петров, быстрее, пожалуйста, не задерживай урок."
    voice "voice/lydia/5day/05 pe.ogg"
    Lilia_P "Пятроў, хутчэй, калі ласка, не затрымлівай урок."

# game/scripts/scene/scene_day_5.rpy:8247
translate belarusian event_m_story2_afterdev_b9f37c04:

    # "Теперь казалось, что вся моя голова горит."
    "Цяпер здавалася, што ўся мая галава гарыць."

# game/scripts/scene/scene_day_5.rpy:8248
translate belarusian event_m_story2_afterdev_73a3cada:

    # "И слова, которые сорвались у меня с губ, были сгустками пламени."
    "І словы, што сарваліся ў мяне з вуснаў, былі згусткамі полымя."

# game/scripts/scene/scene_day_5.rpy:8249
translate belarusian event_m_story2_afterdev_83113041:

    # voice "voice/Anton/5day/53 Ser.ogg"
    # Ant "Серьёзно? «Убери»?"
    voice "voice/Anton/5day/53 Ser.ogg"
    Ant "Сур'ёзна? «Прыбяры»?"

# game/scripts/scene/scene_day_5.rpy:8258
translate belarusian event_m_story2_afterdev_ee6d168a:

    # voice "voice/Anton/5day/54 Eto.ogg"
    # Ant "Это твоё «спасибо»?"
    voice "voice/Anton/5day/54 Eto.ogg"
    Ant "Гэта тваё «дзякуй»?"

# game/scripts/scene/scene_day_5.rpy:8276
translate belarusian event_m_story2_afterdev_2fa398fa:

    # "Катя побагровела, но продолжала играть в заносчивые гляделки."
    "Каця пабагравела, але працягвала гуляць у пыхлівыя глядзелкі."

# game/scripts/scene/scene_day_5.rpy:8277
translate belarusian event_m_story2_afterdev_c22959f7:

    # "Я уже не мог остановиться, нёсся, как с горки. Меня прорвало."
    "Я ўжо не мог спыніцца, нёсся, як з горкі. Мяне прарвала."

# game/scripts/scene/scene_day_5.rpy:8278
translate belarusian event_m_story2_afterdev_79d6bb50:

    # "Наверное, это страх, не находивший выхода в течение месяца, выплеснулся наружу."
    "Напэўна, гэта страх, які не знаходзіў выйсця цягам месяца, выплюхнуўся вонкі."

# game/scripts/scene/scene_day_5.rpy:8294
translate belarusian event_m_story2_afterdev_44472747:

    # "Я оттолкнул стул и, согнувшись, стал яростно тереть пол рукавом."
    "Я адштурхнуў крэсла і, сагнуўшыся, пачаў люта церці падлогу рукавом."

# game/scripts/scene/scene_day_5.rpy:8306
translate belarusian event_m_story2_afterdev_99e32ae8:

    # voice "voice/Anton/5day/55 Chis.ogg"
    # Ant "Чисто? Может ваше величество уже сесть?"
    voice "voice/Anton/5day/55 Chis.ogg"
    Ant "Чыста? Можа ваша вялікасць ужо сесці?"

# game/scripts/scene/scene_day_5.rpy:8314
translate belarusian event_m_story2_afterdev_012d5afb:

    # voice "voice/kate/5day/023 pf.ogg"
    # "Катя высокомерно фыркнула."
    voice "voice/kate/5day/023 pf.ogg"
    "Каця ганарыста фыркнула."

# game/scripts/scene/scene_day_5.rpy:8318
translate belarusian event_m_story2_afterdev_95dd6adc:

    # voice "voice/kate/5day/023 cto.ogg"
    # Kate "Что ж, хорошая работа."
    voice "voice/kate/5day/023 cto.ogg"
    Kate "Што ж, добрая работа."

# game/scripts/scene/scene_day_5.rpy:8329
translate belarusian event_m_story2_afterdev_5f8ab9a4:

    # voice "voice/Anton/5day/56 Ks.ogg"
    # Ant "Кстати..."
    voice "voice/Anton/5day/56 Ks.ogg"
    Ant "Дарэчы..."

# game/scripts/scene/scene_day_5.rpy:8359
translate belarusian event_m_story2_afterdev_cd3ee2e5:

    # voice "voice/Anton/5day/57 Sama.ogg"
    # Ant "Сама себя вытаскивай в следующий раз! Дура!"
    voice "voice/Anton/5day/57 Sama.ogg"
    Ant "Сама сябе выцягвай наступным разам! Дурніца!"

# game/scripts/scene/scene_day_5.rpy:8368
translate belarusian event_m_story2_afterdev_acce1f81:

    # voice "voice/lydia/5day/06 pet.ogg"
    # Lilia_P "Петров!"
    voice "voice/lydia/5day/06 pet.ogg"
    Lilia_P "Пятроў!"

# game/scripts/scene/scene_day_5.rpy:8377
translate belarusian event_m_story2_afterdev_9fa69d80:

    # "Глаза учительницы полезли на лоб от ярости."
    "Вочы настаўніцы палезлі на лоб ад лютасці."

# game/scripts/scene/scene_day_5.rpy:8378
translate belarusian event_m_story2_afterdev_5472a0d0:

    # voice "voice/lydia/5day/07 Cht.ogg"
    # Lilia_P "Что ты себе позволяешь! К директору! Быстро!"
    voice "voice/lydia/5day/07 Cht.ogg"
    Lilia_P "Што ты сабе дазваляеш! Да дырэктара! Хутка!"

# game/scripts/scene/scene_day_5.rpy:8404
translate belarusian event_m_story2_afterdev_3b9dbc13:

    # "Я вскочил, негодуя."
    "Я ўскочыў, абураючыся."

# game/scripts/scene/scene_day_5.rpy:8408
translate belarusian event_m_story2_afterdev_7abbfaaa:

    # voice "voice/Polina/5day/43 Ta.ogg" 
    # Pol "Так-то он прав. Могла бы и поблагодарить."
    voice "voice/Polina/5day/43 Ta.ogg" 
    Pol "Па праўдзе, ён мае рацыю. Магла б і падзякаваць."

# game/scripts/scene/scene_day_5.rpy:8410
translate belarusian event_m_story2_afterdev_b0bdb47c:

    # voice "voice/Polina/5day/44 on.ogg" 
    # Pol "Он ей вообще-то жизнь спас."
    voice "voice/Polina/5day/44 on.ogg" 
    Pol "Ён ёй увогуле жыццё выратаваў."

# game/scripts/scene/scene_day_5.rpy:8412
translate belarusian event_m_story2_afterdev_5ad68ce4:

    # "Ребята согласно загалдели. Они были на моей стороне."
    "Дзеці згодна зашумелі. Яны былі на маім баку."

# game/scripts/scene/scene_day_5.rpy:8413
translate belarusian event_m_story2_afterdev_6468c2c9:

    # "Не успел я осмыслить это, как день преподнёс очередной сюрприз."
    "Не паспеў я асэнсаваць гэта, як дзень паднёс чарговы сюрпрыз."

# game/scripts/scene/scene_day_5.rpy:8444
translate belarusian event_m_story2_afterdev_d7f5bf99:

    # voice "voice/kate/5day/023pad.ogg"
    voice "voice/kate/5day/023pad.ogg"

# game/scripts/scene/scene_day_5.rpy:8450
translate belarusian event_m_story2_afterdev_e9a0a7dc:

    # "Катя качнулась, я автоматически приобнял её, не давая упасть, и усадил на свой стул."
    "Каця хіснулася, я аўтаматычна прыабняў яе, не даючы ўпасці, і пасадзіў на сваё крэсла."

# game/scripts/scene/scene_day_5.rpy:8467
translate belarusian event_m_story2_afterdev_4be644d8:

    # voice "voice/kate/5day/06 pr.ogg"
    # Kate "Прости меня, Антон."
    voice "voice/kate/5day/06 pr.ogg"
    Kate "Прабач мне, Антон."

# game/scripts/scene/scene_day_5.rpy:8471
translate belarusian event_m_story2_afterdev_d3d3aaa1:

    # "Будто маска спала с её лица."
    "Нібыта маска спала з яе твару."

# game/scripts/scene/scene_day_5.rpy:8472
translate belarusian event_m_story2_afterdev_25f4013a:

    # "Явив ту Катю, которая держала меня за руку на заднем сидении милицейской машины."
    "Адкрыўшы тую Кацю, якая трымала мяне за руку на заднім сядзенні міліцэйскай машыны."

# game/scripts/scene/scene_day_5.rpy:8475
translate belarusian event_m_story2_afterdev_9ee51ad9:

    # voice "voice/kate/5day/024 Ya.ogg"
    # Kate "Я злюсь на свою ногу, а не на тебя."
    voice "voice/kate/5day/024 Ya.ogg"
    Kate "Я злуюся на сваю нагу, а не на цябе."

# game/scripts/scene/scene_day_5.rpy:8480
translate belarusian event_m_story2_afterdev_5ca63b63:

    # voice "voice/kate/5day/025 Pr.ogg"
    # Kate "Прости, я и правда... дура."
    voice "voice/kate/5day/025 Pr.ogg"
    Kate "Прабач, я і праўда... дурніца."

# game/scripts/scene/scene_day_5.rpy:8483
translate belarusian event_m_story2_afterdev_0e741821:

    # "Я промычал что-то нечленораздельное, потрясённый признанием."
    "Я прамычаў нешта неразборлівае, узрушаны прызнаннем."

# game/scripts/scene/scene_day_5.rpy:8486
translate belarusian event_m_story2_afterdev_918f6c42:

    # voice "voice/kate/5day/026 m.ogg"
    # Kate "Может, сядешь уже?"
    voice "voice/kate/5day/026 m.ogg"
    Kate "Можа, сядзеш ужо?"

# game/scripts/scene/scene_day_5.rpy:8489
translate belarusian event_m_story2_afterdev_e58d406d:

    # voice "voice/Anton/5day/58 No.ogg"
    # Ant "Но Лилия Павловна..."
    voice "voice/Anton/5day/58 No.ogg"
    Ant "Але Лілія Паўлаўна..."

# game/scripts/scene/scene_day_5.rpy:8495
translate belarusian event_m_story2_afterdev_cab62222:

    # voice "voice/lydia/5day/08 Lad.ogg"
    # Lilia_P "Ладно, садись, Петров."
    voice "voice/lydia/5day/08 Lad.ogg"
    Lilia_P "Добра, сядай, Пятроў."

# game/scripts/scene/scene_day_5.rpy:8500
translate belarusian event_m_story2_afterdev_9c44c71a:

    # voice "voice/lydia/5day/09 Da.ogg"
    # Lilia_P "Давайте уже начнём урок."
    voice "voice/lydia/5day/09 Da.ogg"
    Lilia_P "Давайце ўжо пачнём урок."

# game/scripts/scene/scene_day_5.rpy:8514
translate belarusian event_m_story2_afterdev_d40067e5:

    # "Я занял своё место. Было щекотно от того, как Катя на меня смотрит."
    "Я заняў сваё месца. Было казытна ад таго, як Каця на мяне глядзіць."

# game/scripts/scene/scene_day_5.rpy:8519
translate belarusian event_m_story2_afterdev_90b3cad9:

    # "А обернувшись, я перехватил и взгляд Полины."
    "А азірнуўшыся, я перахапіў і позірк Паліны."

# game/scripts/scene/scene_day_5.rpy:8520
translate belarusian event_m_story2_afterdev_1e396f10:

    # "Та словно хотела понять, что творится между мной и Катей."
    "Тая нібыта хацела зразумець, што дзеецца паміж мной і Кацяй."

# game/scripts/scene/scene_day_5.rpy:8524
translate belarusian event_m_story2_afterdev_3fd02895:

    # "Но этого не понимал я сам."
    "Але гэтага не разумеў я сам."

# game/scripts/scene/scene_day_5.rpy:8536
translate belarusian event_m_story2_afterdev_862859e9:

    # voice "voice/kate/5day/027 z.ogg"
    # Kate "Знаешь, в больнице я много думала."
    voice "voice/kate/5day/027 z.ogg"
    Kate "Ведаеш, у бальніцы я шмат думала."

# game/scripts/scene/scene_day_5.rpy:8540
translate belarusian event_m_story2_afterdev_59cf963d:

    # voice "voice/kate/5day/028 Ya.ogg"
    # Kate "Я была несправедлива к людям."
    voice "voice/kate/5day/028 Ya.ogg"
    Kate "Я была несправядлівай да людзей."

# game/scripts/scene/scene_day_5.rpy:8544
translate belarusian event_m_story2_afterdev_85d1b6ec:

    # voice "voice/kate/5day/029 a.ogg"
    # Kate "А сильнее всего — к тебе."
    voice "voice/kate/5day/029 a.ogg"
    Kate "А мацней за ўсё — да цябе."

# game/scripts/scene/scene_day_5.rpy:8549
translate belarusian event_m_story2_afterdev_a4b16879:

    # voice "voice/Anton/5day/59 Ya.ogg"
    # Ant "Я уже и забыл..."
    voice "voice/Anton/5day/59 Ya.ogg"
    Ant "Я ўжо і забыўся..."

# game/scripts/scene/scene_day_5.rpy:8556
translate belarusian event_m_story2_afterdev_610bd101:

    # voice "voice/kate/5day/030 A.ogg"
    # Kate "Ага, забыл. Врун."
    voice "voice/kate/5day/030 A.ogg"
    Kate "Ага, забыўся. Хлус."

# game/scripts/scene/scene_day_5.rpy:8567
translate belarusian event_m_story2_afterdev_3d91507e:

    # "Локтем она нечаянно спихнула с парты мой чёрный пенал-конструктор с гоночной машиной."
    "Локцем яна незнарок спіхнула з парты мой чорны пенал-канструктар з гоначнай машынай."

# game/scripts/scene/scene_day_5.rpy:8572
translate belarusian event_m_story2_afterdev_dca664bd:

    # "Я наклонился, чтобы подобрать его."
    "Я нахіліўся, каб падабраць яго."

# game/scripts/scene/scene_day_5.rpy:8592
translate belarusian event_m_story2_afterdev_7c112525:

    # "Задержал взгляд на Катиной забинтованной ноге. Потом выпрямился."
    "Затрымаў позірк на Кацінай забінтаванай назе. Потым выпрастаўся."

# game/scripts/scene/scene_day_5.rpy:8602
translate belarusian event_m_story2_afterdev_89300093:

    # "Катя пододвинула ко мне записку."
    "Каця падсунула да мяне запіску."

# game/scripts/scene/scene_day_5.rpy:8603
translate belarusian event_m_story2_afterdev_148a518f:

    # "«Обещай никогда не врать»."
    "«Абяцай ніколі не хлусіць»."

# game/scripts/scene/scene_day_5.rpy:8604
translate belarusian event_m_story2_afterdev_423e20e0:

    # "Я улыбнулся ей, взял карандаш и дописал:"
    "Я ўсміхнуўся ёй, узяў аловак і дапісаў:"

# game/scripts/scene/scene_day_5.rpy:8610
translate belarusian event_m_story2_afterdev_660aad47:

    # "«Постараюсь»."
    "«Пастараюся»."

# game/scripts/scene/scene_day_5.rpy:8611
translate belarusian event_m_story2_afterdev_8e9a116b:

    # "Катя вынула из пенала красную ручку."
    "Каця выняла з пенала чырвоную ручку."

# game/scripts/scene/scene_day_5.rpy:8617
translate belarusian event_m_story2_afterdev_4ff5d37d:

    # "Внимательно проверила каждую букву, затем хитро прищурилась и вывела внизу: «4+»."
    "Уважліва праверыла кожную літару, затым хітра прыжмурылася і вывела ўнізе: «4+»."

# game/scripts/scene/scene_day_5.rpy:8618
translate belarusian event_m_story2_afterdev_ef303ae1:

    # voice "voice/kate/5day/031 da.ogg"
    # Kate "Да-да! За чистописание. Почерк больно кривоват."
    voice "voice/kate/5day/031 da.ogg"
    Kate "Так-так! За чыстапісанне. Почырк дужа крываваты."

# game/scripts/scene/scene_day_5.rpy:8634
translate belarusian event_m_story2_afterdev_b5a30c93:

    # "Я фыркнул."
    "Я фыркнуў."

# game/scripts/scene/scene_day_5.rpy:8636
translate belarusian event_m_story2_afterdev_cc23e3c0:

    # voice "voice/kate/5day/032 o.ogg"
    # Kate "Оценку можно исправить."
    voice "voice/kate/5day/032 o.ogg"
    Kate "Адзнаку можна выправіць."

# game/scripts/scene/scene_day_5.rpy:8645
translate belarusian event_m_story2_afterdev_8dd095e6:

    # "Я чувствовал, как Полина поглядывает на нас."
    "Я адчуваў, як Паліна паглядвае на нас."

# game/scripts/scene/scene_day_5.rpy:8646
translate belarusian event_m_story2_afterdev_baa84bbd:

    # "Мне было неловко, волнительно и приятно — всё сразу, буря эмоций."
    "Мне было няёмка, хвалююча і прыемна — усё адразу, бура эмоцый."

# game/scripts/scene/scene_day_5.rpy:8660
translate belarusian event_m_story2_afterdev_90213b43:

    # voice "voice/Anton/5day/61 Dop.ogg"
    # Ant "Допустим, я хочу пятёрку."
    voice "voice/Anton/5day/61 Dop.ogg"
    Ant "Дапусцім, я хачу пяцёрку."

# game/scripts/scene/scene_day_5.rpy:8665
translate belarusian event_m_story2_afterdev_c5bafeed:

    # voice "voice/kate/5day/033 t.ogg"
    # Kate "Тогда разрешаю проводить меня после уроков."
    voice "voice/kate/5day/033 t.ogg"
    Kate "Тады дазваляю правесці мяне пасля ўрокаў."

# game/scripts/scene/scene_day_5.rpy:8670
translate belarusian event_m_story2_afterdev_b7d93f90:

    # voice "voice/kate/5day/034 to.ogg"
    # Kate "То есть нет..."
    voice "voice/kate/5day/034 to.ogg"
    Kate "То бок не..."

# game/scripts/scene/scene_day_5.rpy:8673
translate belarusian event_m_story2_afterdev_05d70552:

    # "Она виновато улыбнулась, прогоняя тень себя прежней."
    "Яна вінавата ўсміхнулася, праганяючы цень сябе ранейшай."

# game/scripts/scene/scene_day_5.rpy:8676
translate belarusian event_m_story2_afterdev_4ff794e5:

    # voice "voice/kate/5day/034 Ya .ogg"
    # Kate "Я очень прошу тебя меня проводить."
    voice "voice/kate/5day/034 Ya .ogg"
    Kate "Я вельмі прашу цябе мяне правесці."

# game/scripts/scene/scene_day_5.rpy:8683
translate belarusian event_m_story2_afterdev_da950bf4:

    # "Ну и ну... я переваривал свалившуюся информацию."
    "Ну і ну... я пераварваў інфармацыю, што звалілася на мяне."

# game/scripts/scene/scene_day_5.rpy:8684
translate belarusian event_m_story2_afterdev_98d65761:

    # "Две самые клёвые девчонки в классе просят проводить их?"
    "Дзве самыя клёвыя дзяўчынкі ў класе просяць правесці іх?"

# game/scripts/scene/scene_day_5.rpy:8685
translate belarusian event_m_story2_afterdev_181f0891:

    # "Я точно не брежу? Может, выпить таблетки?"
    "Я дакладна не трызню? Можа, выпіць таблеткі?"

# game/scripts/scene/scene_day_5.rpy:8715
translate belarusian event_m_story2_afterdev_3d64a051:

    # voice "voice/Anton/5day/62 Vd.ogg"
    # "Я открыл рот и тут же заметил, что за партой Ромки и Бяши сидит ребёнок, явно младше всех нас."
    voice "voice/Anton/5day/62 Vd.ogg"
    "Я адкрыў рот і адразу ж заўважыў, што за партай Ромкі і Бяшы сядзіць дзіця, відавочна маладзейшае за ўсіх нас."

# game/scripts/scene/scene_day_5.rpy:8717
translate belarusian event_m_story2_afterdev_8ca85787:

    # "Капюшон, закрывающий лицо..."
    "Капюшон, што закрывае твар..."

# game/scripts/scene/scene_day_5.rpy:8733
translate belarusian event_m_story2_afterdev_ed7e4aa5:

    # "Ужас затопил пустоту в моей груди. Горло сузилось, не пропуская кислород."
    "Жах затапіў пустату ў маіх грудзях. Горла звузілася, не прапускаючы кісларод."

# game/scripts/scene/scene_day_5.rpy:8734
translate belarusian event_m_story2_afterdev_cfa55fc2:

    # "Я уже видел эту фигуру. В гараже маньяка, возле генератора!"
    "Я ўжо бачыў гэтую постаць. У гаражы маньяка, каля генератара!"

# game/scripts/scene/scene_day_5.rpy:8735
translate belarusian event_m_story2_afterdev_4c5509f9:

    # "Мой рот раскрылся ещё шире."
    "Мой рот раскрыўся яшчэ шырэй."

# game/scripts/scene/scene_day_5.rpy:8736
translate belarusian event_m_story2_afterdev_8bc43730:

    # voice "voice/Anton/5day/63 Ka.ogg"
    # Ant "Кать..."
    voice "voice/Anton/5day/63 Ka.ogg"
    Ant "Каць..."

# game/scripts/scene/scene_day_5.rpy:8738
translate belarusian event_m_story2_afterdev_5cb9cb7e:

    # voice "voice/kate/5day/35 da.ogg"
    # Kate "Да?"
    voice "voice/kate/5day/35 da.ogg"
    Kate "Так?"

# game/scripts/scene/scene_day_5.rpy:8764
translate belarusian event_m_story2_afterdev_0bd3f6c9:

    # "Я оторвал взгляд от странной фигуры, сунул руку в карман и выдавил из упаковки пилюлю."
    "Я адарваў позірк ад дзіўнай постаці, сунуў руку ў кішэню і выціснуў з упакоўкі пілюлю."

# game/scripts/scene/scene_day_5.rpy:8784
translate belarusian event_m_story2_afterdev_45f33762:

    # "Быстро разжевал её."
    "Хутка разжаваў яе."

# game/scripts/scene/scene_day_5.rpy:8785
translate belarusian event_m_story2_afterdev_46ab39ba:

    # voice "voice/Anton/5day/65 K.ogg"
    # Ant "Кать, парта Ромы..."
    voice "voice/Anton/5day/65 K.ogg"
    Ant "Каць, парта Ромы..."

# game/scripts/scene/scene_day_5.rpy:8795
translate belarusian event_m_story2_afterdev_a2c8c894:

    # "Я посмотрел на ребёнка, но его там не было. Два пустых стула и столешница, изрезанная перочинным ножом."
    "Я паглядзеў на дзіця, але яго там не было. Два пустыя крэслы і стальніца, парэзаная складаным нажом."

# game/scripts/scene/scene_day_5.rpy:8796
translate belarusian event_m_story2_afterdev_2503f0bc:

    # voice "voice/kate/5day/36 E.ogg"
    # Kate "И... что с ней не так?"
    voice "voice/kate/5day/36 E.ogg"
    Kate "І... што з ёй не так?"

# game/scripts/scene/scene_day_5.rpy:8808
translate belarusian event_m_story2_afterdev_f58212c7:

    # "Что со мной не так?"
    "Што са мной не так?"

# game/scripts/scene/scene_day_5.rpy:8811
translate belarusian event_m_story2_afterdev_3e9ca716:

    # voice "voice/Anton/5day/66 Nich.ogg"
    # Ant "Ничего, забудь."
    voice "voice/Anton/5day/66 Nich.ogg"
    Ant "Нічога, забудзь."

# game/scripts/scene/scene_day_5.rpy:8823
translate belarusian event_m_story2_afterdev_87ac732d:

    # voice "voice/tihonov/5day/27 Pro.ogg"
    # Tikhonov "Простите, что прерываю..."
    voice "voice/tihonov/5day/27 Pro.ogg"
    Tikhonov "Прабачце, што перапыняю..."

# game/scripts/scene/scene_day_5.rpy:8851
translate belarusian event_m_story2_afterdev_a7c2a81e:

    # "Лейтенант Тихонов вошёл в класс и снял шапку."
    "Лейтэнант Ціханаў увайшоў у клас і зняў шапку."

# game/scripts/scene/scene_day_5.rpy:8855
translate belarusian event_m_story2_afterdev_c0ce8c47:

    # voice "voice/lydia/5day/10 Nu.ogg"
    # Lilia_P "Ну что вы. Всегда вам рады."
    voice "voice/lydia/5day/10 Nu.ogg"
    Lilia_P "Ну што вы. Заўсёды вам рады."

# game/scripts/scene/scene_day_5.rpy:8857
translate belarusian event_m_story2_afterdev_cedda014:

    # voice "voice/tihonov/5day/28 M.ogg"
    # Tikhonov "Меня интересуют ученики по имени Петров и Пятифанов."
    voice "voice/tihonov/5day/28 M.ogg"
    Tikhonov "Мяне цікавяць вучні па імені Пятроў і Пяціфанаў."

# game/scripts/scene/scene_day_5.rpy:8862
translate belarusian event_m_story2_afterdev_6ce7709d:

    # voice "voice/lydia/5day/11 Pya.ogg"
    # Lilia_P "Пятифанов, насколько я понимаю, болеет."
    voice "voice/lydia/5day/11 Pya.ogg"
    Lilia_P "Пяціфанаў, наколькі я разумею, хварэе."

# game/scripts/scene/scene_day_5.rpy:8864
translate belarusian event_m_story2_afterdev_b5fbd12c:

    # voice "voice/lydia/5day/12 A.ogg"
    # Lilia_P "А Петров вон. Мозолит глаза."
    voice "voice/lydia/5day/12 A.ogg"
    Lilia_P "А Пятроў вунь. Муляе вочы."

# game/scripts/scene/scene_day_5.rpy:8877
translate belarusian event_m_story2_afterdev_9c6c2553:

    # "Тихонов нашёл меня взглядом и откашлялся. Вынул из папки грамоту и зачитал."
    "Ціханаў знайшоў мяне позіркам і адкашляўся. Выняў з тэчкі грамату і зачытаў."

# game/scripts/scene/scene_day_5.rpy:8878
translate belarusian event_m_story2_afterdev_3c43fc1a:

    # voice "voice/tihonov/5day/30 Za.ogg"
    # Tikhonov "За храбрость, неравнодушие и мужество, проявленное при спасении жизни..."
    voice "voice/tihonov/5day/30 Za.ogg"
    Tikhonov "За адвагу, неабыякавасць і мужнасць, праяўленую пры выратаванні жыцця..."

# game/scripts/scene/scene_day_5.rpy:8893
translate belarusian event_m_story2_afterdev_2da06d83:

    # voice "voice/kate/5day/37 Nu.ogg"
    # Kate "Ну, встань же. Тебе говорят."
    voice "voice/kate/5day/37 Nu.ogg"
    Kate "Ну, устань жа. Табе кажуць."

# game/scripts/scene/scene_day_5.rpy:8916
translate belarusian event_m_story2_afterdev_0207ef18:

    # "Я подчинился, загипнотизированный официальным языком грамоты."
    "Я падпарадкаваўся, загіпнатызаваны афіцыйнай мовай граматы."

# game/scripts/scene/scene_day_5.rpy:8920
translate belarusian event_m_story2_afterdev_512eb2f3:

    # voice "voice/tihonov/5day/31 Ad.ogg"
    # Tikhonov "... администрация посёлка и уполномоченный области по правам детей выносят благодарность!"
    voice "voice/tihonov/5day/31 Ad.ogg"
    Tikhonov "... адміністрацыя пасёлка і ўпаўнаважаны вобласці па правах дзяцей выносяць падзяку!"

# game/scripts/scene/scene_day_5.rpy:8940
translate belarusian event_m_story2_afterdev_e20beb3d:

    # "Класс разразился аплодисментами."
    "Клас выбухнуў апладысментамі."

# game/scripts/scene/scene_day_5.rpy:8941
translate belarusian event_m_story2_afterdev_63446c93:

    # voice "voice/kate/5day/38 Hi.ogg"
    # "Катя сияла от счастья. Полина смотрела на меня блестящими глазами и улыбалась."
    voice "voice/kate/5day/38 Hi.ogg"
    "Каця ззяла ад шчасця. Паліна глядзела на мяне бліскучымі вачыма і ўсміхалася."

# game/scripts/scene/scene_day_5.rpy:8951
translate belarusian event_m_story2_afterdev_14b5c249:

    # voice "voice/kate/5day/39 Nash.ogg"
    # Childs "Наш Петров!"
    voice "voice/kate/5day/39 Nash.ogg"
    Childs "Наш Пятроў!"

# game/scripts/scene/scene_day_5.rpy:8959
translate belarusian event_m_story2_afterdev_ba9599c4:

    # voice "voice/kate/5day/40 Ura.ogg"
    # Childs "Ура!"
    voice "voice/kate/5day/40 Ura.ogg"
    Childs "Ура!"

# game/scripts/scene/scene_day_5.rpy:8961
translate belarusian event_m_story2_afterdev_7a5b89da:

    # "Лилия Павловна подняла очки и платком промокнула глаза."
    "Лілія Паўлаўна падняла акуляры і хусцінкай прамакнула вочы."

# game/scripts/scene/scene_day_5.rpy:8974
translate belarusian event_m_story2_afterdev_01d35ef1:

    # voice "voice/lydia/5day/13 St.ogg"
    # Lilia_P "Стыдно, товарищи."
    voice "voice/lydia/5day/13 St.ogg"
    Lilia_P "Сорамна, таварышы."

# game/scripts/scene/scene_day_5.rpy:8976
translate belarusian event_m_story2_afterdev_673f7483:

    # voice "voice/lydia/5day/14 Sv.ogg"
    # Lilia_P "Я-то думала, Катеньке померещилось всё в бреду... А оказывается, правда..."
    voice "voice/lydia/5day/14 Sv.ogg"
    Lilia_P "Я ж думала, Каценьцы прымроілася ўсё ў трызненні... А выяўляецца, праўда..."

# game/scripts/scene/scene_day_5.rpy:8978
translate belarusian event_m_story2_afterdev_6cd2e490:

    # voice "voice/lydia/5day/15 Pet.ogg"
    # Lilia_P "Петров, значит, моего ребёнка спас, а я ему: к директору..."
    voice "voice/lydia/5day/15 Pet.ogg"
    Lilia_P "Пятроў, значыць, маё дзіця выратаваў, а я яму: да дырэктара..."

# game/scripts/scene/scene_day_5.rpy:8983
translate belarusian event_m_story2_afterdev_b28063c7:

    # voice "voice/tihonov/5day/32 Ot.ogg"
    # Tikhonov "Отставить — к директору! На доску почёта — вот это я понимаю."
    voice "voice/tihonov/5day/32 Ot.ogg"
    Tikhonov "Адставіць — да дырэктара! На дошку гонару — вось гэта я разумею."

# game/scripts/scene/scene_day_5.rpy:9010
translate belarusian event_m_story2_afterdev_0f7868f4:

    # "В эту секунду я представил своё фото, но не на доске почёта, а на стенде, по соседству с пропавшими детьми."
    "У гэтую секунду я ўявіў сваё фота, але не на дошцы гонару, а на стэндзе, па суседстве са зніклымі дзецьмі."

# game/scripts/scene/scene_day_5.rpy:9038
translate belarusian event_m_story2_afterdev_504538b3:

    # "Образ придал горчинки моему триумфу."
    "Вобраз дадаў гарчынкі майму трыумфу."

# game/scripts/scene/scene_day_5.rpy:9055
translate belarusian event_m_story2_afterdev_5f096b94:

    # "После уроков я помог Кате спуститься с лестницы. Нёс её костыли и придерживал под локоть."
    "Пасля ўрокаў я дапамог Каці спусціцца па лесвіцы. Нёс яе мыліцы і прытрымліваў пад локаць."

# game/scripts/scene/scene_day_5.rpy:9096
translate belarusian event_m_story2_afterdev_6e734674:

    # "Вместе мы вышли на школьный двор."
    "Разам мы выйшлі на школьны двор."

# game/scripts/scene/scene_day_5.rpy:9117
translate belarusian event_m_story2_afterdev_fcc82b01:

    # voice "voice/kate/5day/41 Zna.ogg"
    # Kate "Знаешь, что самое странное?"
    voice "voice/kate/5day/41 Zna.ogg"
    Kate "Ведаеш, што самае дзіўнае?"

# game/scripts/scene/scene_day_5.rpy:9121
translate belarusian event_m_story2_afterdev_fe99f1b4:

    # voice "voice/kate/5day/42 Ya.ogg"
    # Kate "Я до сих пор чувствую пальцы."
    voice "voice/kate/5day/42 Ya.ogg"
    Kate "Я дагэтуль адчуваю пальцы."

# game/scripts/scene/scene_day_5.rpy:9125
translate belarusian event_m_story2_afterdev_a80fb6db:

    # voice "voice/kate/5day/42 Eh.ogg"
    # Kate "Их нет, но я их чувствую..."
    voice "voice/kate/5day/42 Eh.ogg"
    Kate "Іх няма, але я іх адчуваю..."

# game/scripts/scene/scene_day_5.rpy:9165
translate belarusian event_m_story2_afterdev_f5089fdf:

    # voice "voice/Anton/5day/67 Bil.ogg"
    # Ant "Был бы я порасторопнее..."
    voice "voice/Anton/5day/67 Bil.ogg"
    Ant "Быў бы я спрытнейшы..."

# game/scripts/scene/scene_day_5.rpy:9203
translate belarusian event_m_story2_afterdev_640decaf:

    # voice "voice/kate/5day/43 B.ogg"
    # Kate "Брось. Даже супермен бы не справился."
    voice "voice/kate/5day/43 B.ogg"
    Kate "Кінь. Нават супермен не справіўся б."

# game/scripts/scene/scene_day_5.rpy:9207
translate belarusian event_m_story2_afterdev_b3537bdf:

    # voice "voice/kate/5day/44 T.ogg"
    # Kate "Тихонов сказал, я легко отделалась, и он прав..."
    voice "voice/kate/5day/44 T.ogg"
    Kate "Ціханаў сказаў, я лёгка адкараскалася, і ён мае рацыю..."

# game/scripts/scene/scene_day_5.rpy:9212
translate belarusian event_m_story2_afterdev_41de0bee:

    # voice "voice/Polina/5day/45 s.ogg" 
    # Pol "С выздоровлением, Кать."
    voice "voice/Polina/5day/45 s.ogg" 
    Pol "З выздараўленнем, Каць."

# game/scripts/scene/scene_day_5.rpy:9224
translate belarusian event_m_story2_afterdev_42a5ef55:

    # "Полина вышла из-за угла, внимательно глядя на одноклассницу."
    "Паліна выйшла з-за рога, уважліва гледзячы на аднакласніцу."

# game/scripts/scene/scene_day_5.rpy:9272
translate belarusian event_m_story2_afterdev_27735082:

    # "Катя с достоинством выдержала прожигающий взгляд."
    "Каця з годнасцю вытрымала пякучы позірк."

# game/scripts/scene/scene_day_5.rpy:9275
translate belarusian event_m_story2_afterdev_fb54b666:

    # voice "voice/kate/5day/45 S.ogg"
    # Kate "Спасибо, Полин."
    voice "voice/kate/5day/45 S.ogg"
    Kate "Дзякуй, Палін."

# game/scripts/scene/scene_day_5.rpy:9279
translate belarusian event_m_story2_afterdev_5560eaf7:

    # voice "voice/kate/5day/46 E.ogg"
    # Kate "И тебе, и твоему парню. Он тоже молодец."
    voice "voice/kate/5day/46 E.ogg"
    Kate "І табе, і твайму хлопцу. Ён таксама малайчына."

# game/scripts/scene/scene_day_5.rpy:9283
translate belarusian event_m_story2_afterdev_5840f8da:

    # "Кате словно было важно напомнить мне, кем приходится Ромка Полине."
    "Каці нібыта было важна нагадаць мне, кім даводзіцца Ромка Паліне."

# game/scripts/scene/scene_day_5.rpy:9286
translate belarusian event_m_story2_afterdev_2e34c55d:

    # voice "voice/Polina/5day/46 Es.ogg"
    # Pol "Если ты о Пятифанове, то между нами ничего нет. Он определённо молодец, но..."
    voice "voice/Polina/5day/46 Es.ogg"
    Pol "Калі ты пра Пяціфанава, то паміж намі нічога няма. Ён безумоўна малайчына, але..."

# game/scripts/scene/scene_day_5.rpy:9290
translate belarusian event_m_story2_afterdev_308adca2:

    # voice "voice/Polina/5day/47 Vi.ogg" 
    # Pol "Вы... куда-то собираетесь?"
    voice "voice/Polina/5day/47 Vi.ogg" 
    Pol "Вы... кудысьці збіраецеся?"

# game/scripts/scene/scene_day_5.rpy:9294
translate belarusian event_m_story2_afterdev_fd5a34fb:

    # "Катя не дала мне ответить."
    "Каця не дала мне адказаць."

# game/scripts/scene/scene_day_5.rpy:9296
translate belarusian event_m_story2_afterdev_16e9240a:

    # voice "voice/kate/5day/47 Ya.ogg"
    # Kate "Я до сих пор хромаю. Вот, уговорила нашего героя проводить меня."
    voice "voice/kate/5day/47 Ya.ogg"
    Kate "Я дагэтуль кульгаю. Вось, угаварыла нашага героя правесці мяне."

# game/scripts/scene/scene_day_5.rpy:9300
translate belarusian event_m_story2_afterdev_37a65f7a:

    # voice "voice/kate/5day/48 Da.ogg"
    # Kate "Да-да-да!"
    voice "voice/kate/5day/48 Da.ogg"
    Kate "Так-так-так!"

# game/scripts/scene/scene_day_5.rpy:9336
translate belarusian event_m_story2_afterdev_53009b32:

    # "Как же неловко..."
    "Як жа няёмка..."

# game/scripts/scene/scene_day_5.rpy:9340
translate belarusian event_m_story2_afterdev_e3823326:

    # voice "voice/Anton/5day/68 polin.ogg"
    # Ant "Полин..."
    voice "voice/Anton/5day/68 polin.ogg"
    Ant "Палін..."

# game/scripts/scene/scene_day_5.rpy:9382
translate belarusian d5_polkatya_dev_205e6eb6:

    # voice "voice/Polina/5day/48 Ya.ogg"
    # Pol "Я же не идиотка. Всё понимаю."
    voice "voice/Polina/5day/48 Ya.ogg"
    Pol "Я ж не ідыётка. Усё разумею."

# game/scripts/scene/scene_day_5.rpy:9385
translate belarusian d5_polkatya_dev_faceff7b:

    # "В глазах Полины мелькнула грусть, но она улыбнулась, примиряясь с судьбой."
    "У вачах Паліны мільгнуў сум, але яна ўсміхнулася, зміраючыся з лёсам."

# game/scripts/scene/scene_day_5.rpy:9388
translate belarusian d5_polkatya_dev_dc82d5d8:

    # voice "voice/Polina/5day/49 Ti.ogg" 
    # Pol "Ты — джентльмен. Как говорит дедушка, вымирающий вид."
    voice "voice/Polina/5day/49 Ti.ogg" 
    Pol "Ты — джэнтльмен. Як кажа дзядуля, від, што вымірае."

# game/scripts/scene/scene_day_5.rpy:9393
translate belarusian d5_polkatya_dev_4807d004:

    # voice "voice/Polina/5day/50 Ne.ogg" 
    # Pol "Не каждой повезёт..."
    voice "voice/Polina/5day/50 Ne.ogg" 
    Pol "Не кожнай пашанцуе..."

# game/scripts/scene/scene_day_5.rpy:9396
translate belarusian d5_polkatya_dev_0abfeff8:

    # "Метель заносила двор снегом."
    "Завея заносіла двор снегам."

# game/scripts/scene/scene_day_5.rpy:9398
translate belarusian d5_polkatya_dev_9256156a:

    # "Полина повернулась и встревоженно вгляделась во мглу, совершенно потерянная."
    "Паліна павярнулася і стрывожана ўгледзелася ў імглу, зусім разгубленая."

# game/scripts/scene/scene_day_5.rpy:9402
translate belarusian d5_polkatya_dev_6173c80e:

    # voice "voice/kate/5day/49 Za.ogg"
    # Kate "Задолбала строить из себя жертву."
    voice "voice/kate/5day/49 Za.ogg"
    Kate "Задзяўбла рабіць з сябе ахвяру."

# game/scripts/scene/scene_day_5.rpy:9407
translate belarusian d5_polkatya_dev_49e6aa3a:

    # "Последняя реплика, произнесённая шёпотом, адресовалась только мне."
    "Апошняя рэпліка, прамоўленая шэптам, адрасавалася толькі мне."

# game/scripts/scene/scene_day_5.rpy:9410
translate belarusian d5_polkatya_dev_aba416d3:

    # voice "voice/kate/5day/51 T.ogg"
    # Kate "Такое чувство, что она мечтала бы поменяться со мной местами, лишь бы все её жалели."
    voice "voice/kate/5day/51 T.ogg"
    Kate "Такое адчуванне, што яна марыла б памяняцца са мной месцамі, абы ўсе яе шкадавалі."

# game/scripts/scene/scene_day_5.rpy:9418
translate belarusian d5_polkatya_dev_2d4333e6:

    # "В темноте зашуршало, и Жулька выбежала к школе."
    "У цемры зашамацела, і Жулька выбегла да школы."

# game/scripts/scene/scene_day_5.rpy:9448
translate belarusian d5_polkatya_dev_606dafe2:

    # voice "voice/kate/5day/52 oi.ogg"
    # Kate "Ой, пёсик!"
    voice "voice/kate/5day/52 oi.ogg"
    Kate "Ой, пёсік!"

# game/scripts/scene/scene_day_5.rpy:9454
translate belarusian d5_polkatya_dev_7d018b82:

    # "Жулька заметила Полину и тихонько зарычала."
    "Жулька заўважыла Паліну і ціхенька загырчала."

# game/scripts/scene/scene_day_5.rpy:9455
translate belarusian d5_polkatya_dev_6b5a6fa7:

    # "Полина моргнула. Две слезинки скатились по её щекам, замёрзли и заблестели."
    "Паліна міргнула. Дзве слязінкі скаціліся па яе шчоках, замёрзлі і заблішчалі."

# game/scripts/scene/scene_day_5.rpy:9456
translate belarusian d5_polkatya_dev_ae039e0f:

    # voice "voice/Polina/5day/51 Ti.ogg" 
    # Pol "Ты тоже не хочешь меня проводить?"
    voice "voice/Polina/5day/51 Ti.ogg" 
    Pol "Ты таксама не хочаш мяне правесці?"

# game/scripts/scene/scene_day_5.rpy:9461
translate belarusian d5_polkatya_dev_0dc46ef8:

    # "Жулька залаяла звонко."
    "Жулька забрахала звонка."

# game/scripts/scene/scene_day_5.rpy:9497
translate belarusian d5_polkatya_dev_c24368ed:

    # voice "voice/kate/5day/53 nu.ogg"
    # Kate "Ну что? Идём?"
    voice "voice/kate/5day/53 nu.ogg"
    Kate "Ну што? Ідзём?"

# game/scripts/scene/scene_day_5.rpy:9501
translate belarusian d5_polkatya_dev_a5513a74:

    # voice "voice/kate/5day/54 Pu.ogg"
    # Kate "Пусть эта квашня сама до дома добирается, пока не стемнело."
    voice "voice/kate/5day/54 Pu.ogg"
    Kate "Няхай гэтая квашня сама дадому дабіраецца, пакуль не сцямнела."

# game/scripts/scene/scene_day_5.rpy:9562
translate belarusian event_m_polina_devend_16fe57e4:

    # "Я задержал на Полине взгляд, а затем повернулся к Кате."
    "Я затрымаў на Паліне погляд, а потым павярнуўся да Каці."

# game/scripts/scene/scene_day_5.rpy:9565
translate belarusian event_m_polina_devend_7fa5d009:

    # "Это было сложно."
    "Гэта было складана."

# game/scripts/scene/scene_day_5.rpy:9566
translate belarusian event_m_polina_devend_d5215e28:

    # "Не так сложно, как сбежать из комнаты пыток, но приятного мало."
    "Не так складана, як уцячы з пакоя катаванняў, але прыемнага мала."

# game/scripts/scene/scene_day_5.rpy:9569
translate belarusian event_m_polina_devend_88cea688:

    # "Я не хотел обижать Катю. И было печально признавать, что потеря пальцев ничего не изменила."
    "Я не хацеў крыўдзіць Кацю. І было сумна прызнаваць, што страта пальцаў нічога не змяніла."

# game/scripts/scene/scene_day_5.rpy:9570
translate belarusian event_m_polina_devend_ff2dd467:

    # "Передо мной всё тот же человек, умеющий манипулировать людьми."
    "Перада мной усё той жа чалавек, які ўмее маніпуляваць людзьмі."

# game/scripts/scene/scene_day_5.rpy:9575
translate belarusian event_m_polina_devend_f3bbd593:

    # voice "voice/Anton/5day/69 Kat.ogg"
    # Ant "Кать, я уже пообещал Полине."
    voice "voice/Anton/5day/69 Kat.ogg"
    Ant "Каць, я ўжо паабяцаў Паліне."

# game/scripts/scene/scene_day_5.rpy:9580
translate belarusian event_m_polina_devend_914bc47e:

    # voice "voice/kate/5day/54 no.ogg"
    # Kate "Но..."
    voice "voice/kate/5day/54 no.ogg"
    Kate "Але..."

# game/scripts/scene/scene_day_5.rpy:9583
translate belarusian event_m_polina_devend_222c53a5:

    # voice "voice/Anton/5day/70 mi.ogg"
    # Ant "Мы сейчас что-нибудь придумаем."
    voice "voice/Anton/5day/70 mi.ogg"
    Ant "Мы зараз што-небудзь прыдумаем."

# game/scripts/scene/scene_day_5.rpy:9613
translate belarusian event_m_polina_devend_533c08c3:

    # "Я задрал голову:"
    "Я задраў галаву:"

# game/scripts/scene/scene_day_5.rpy:9615
translate belarusian event_m_polina_devend_9f9d94d6:

    # voice "voice/Anton/5day/71 Liliya.ogg"
    # Ant "Лилия Павловна!"
    voice "voice/Anton/5day/71 Liliya.ogg"
    Ant "Лілія Паўлаўна!"

# game/scripts/scene/scene_day_5.rpy:9624
translate belarusian event_m_polina_devend_9e2fdf12:

    # "Учительница высунулась из окна."
    "Настаўніца высунулася з акна."

# game/scripts/scene/scene_day_5.rpy:9625
translate belarusian event_m_polina_devend_559231b0:

    # voice "voice/Anton/5day/72 ya.ogg"
    # Ant "Я помог Кате спуститься. Заберёте её?"
    voice "voice/Anton/5day/72 ya.ogg"
    Ant "Я дапамог Каці спусціцца. Забераце яе?"

# game/scripts/scene/scene_day_5.rpy:9627
translate belarusian event_m_polina_devend_26ceccaa:

    # voice "voice/lydia/5day/16 Kon.ogg"
    # Lilia_P "Конечно! Подожди, Катюш, я уже одеваюсь."
    voice "voice/lydia/5day/16 Kon.ogg"
    Lilia_P "Вядома! Пачакай, Кацюш, я ўжо апранаюся."

# game/scripts/scene/scene_day_5.rpy:9629
translate belarusian event_m_polina_devend_44cb4472:

    # voice "voice/lydia/5day/17 Sp.ogg"
    # Lilia_P "Спасибо, Антон, снова нас выручил."
    voice "voice/lydia/5day/17 Sp.ogg"
    Lilia_P "Дзякуй, Антон, зноў нас выручыў."

# game/scripts/scene/scene_day_5.rpy:9664
translate belarusian event_m_polina_devend_f4cb8d92:

    # "Катя всё это время молчала, побледнев. Я испугался, что ей стало плохо."
    "Каця ўвесь гэты час маўчала, збялеўшы. Я спалохаўся, што ёй стала дрэнна."

# game/scripts/scene/scene_day_5.rpy:9702
translate belarusian event_m_polina_devend_c6f73762:

    # voice "voice/Anton/5day/73 Ti.ogg"
    # Ant "Ты в порядке? Голова не кружится?"
    voice "voice/Anton/5day/73 Ti.ogg"
    Ant "Ты ў парадку? Галава не кружыцца?"

# game/scripts/scene/scene_day_5.rpy:9708
translate belarusian event_m_polina_devend_7e691b8e:

    # voice "voice/kate/5day/55 k.ogg"
    # Kate "Кружится."
    voice "voice/kate/5day/55 k.ogg"
    Kate "Кружыцца."

# game/scripts/scene/scene_day_5.rpy:9710
translate belarusian event_m_polina_devend_b2f5541f:

    # "В голосе прорезались злые нотки."
    "У голасе прарэзаліся злыя ноткі."

# game/scripts/scene/scene_day_5.rpy:9746
translate belarusian event_m_polina_devend_042c15d5:

    # voice "voice/kate/5day/56 te.ogg"
    # Kate "Тебе какое дело? Обещал правду говорить?"
    voice "voice/kate/5day/56 te.ogg"
    Kate "Табе якая справа? Абяцаў праўду казаць?"

# game/scripts/scene/scene_day_5.rpy:9753
translate belarusian event_m_polina_devend_62790fbc:

    # voice "voice/kate/5day/57 L.ogg"
    # Kate "Лжец."
    voice "voice/kate/5day/57 L.ogg"
    Kate "Хлус."

# game/scripts/scene/scene_day_5.rpy:9758
translate belarusian event_m_polina_devend_f0cc53a7:

    # voice "voice/kate/5day/58 K.ogg"
    # Kate "Кол с минусом, Петров."
    voice "voice/kate/5day/58 K.ogg"
    Kate "Кол з мінусам, Пятроў."

# game/scripts/scene/scene_day_5.rpy:9762
translate belarusian event_m_polina_devend_8f58cb20:

    # "Полина покраснела на морозе, и было бы легко дорисовать молнии, стреляющие из её глаз."
    "Паліна пачырванела на марозе, і было б лёгка дамаляваць маланкі, што страляюць з яе вачэй."

# game/scripts/scene/scene_day_5.rpy:9764
translate belarusian event_m_polina_devend_eb47e86b:

    # voice "voice/Polina/5day/52 Pr.ogg" 
    # Pol "Прекращай истерику, Кать."
    voice "voice/Polina/5day/52 Pr.ogg" 
    Pol "Спыняй істэрыку, Каць."

# game/scripts/scene/scene_day_5.rpy:9768
translate belarusian event_m_polina_devend_4ff784bd:

    # voice "voice/Polina/5day/53 Mi.ogg" 
    # Pol "Мы с Антоном могли бы довести тебя до дома, а потом пойти ко мне."
    voice "voice/Polina/5day/53 Mi.ogg" 
    Pol "Мы з Антонам маглі б давесці цябе дадому, а потым пайсці да мяне."

# game/scripts/scene/scene_day_5.rpy:9773
translate belarusian event_m_polina_devend_b93a17ca:

    # voice "voice/kate/5day/59 kon.ogg"
    # Kate "Конечно-конечно!"
    voice "voice/kate/5day/59 kon.ogg"
    Kate "Вядома-вядома!"

# game/scripts/scene/scene_day_5.rpy:9780
translate belarusian event_m_polina_devend_79213504:

    # voice "voice/kate/5day/60 Lu.ogg"
    # Kate "Лучше к чёрту сходите. Оба!"
    voice "voice/kate/5day/60 Lu.ogg"
    Kate "Лепш да чорта схадзіце. Абое!"

# game/scripts/scene/scene_day_5.rpy:9785
translate belarusian event_m_polina_devend_07b02fa5:

    # voice "voice/kate/5day/61 S.ogg"
    # Kate "Скатертью дорога!"
    voice "voice/kate/5day/61 S.ogg"
    Kate "Абрусам дарога!"

# game/scripts/scene/scene_day_5.rpy:9822
translate belarusian event_m_polina_devend_91206902:

    # "Опешивший от этой атаки, я предпочёл не вступать в конфликт."
    "Агаломшаны гэтай атакай, я палічыў за лепшае не ўступаць у канфлікт."

# game/scripts/scene/scene_day_5.rpy:9823
translate belarusian event_m_polina_devend_c0da4da0:

    # "К чёрту — так к чёрту."
    "Да чорта — дык да чорта."

# game/scripts/scene/scene_day_5.rpy:9875
translate belarusian event_m_polina_devend_a97a5703:

    # "Я увлёк Полину, и мы двинулись по двору. Катя, стоя у крыльца, испепеляла нас ненавидящим взором."
    "Я павёў за сабой Паліну, і мы рушылі па двары. Каця, стоячы ля ганка, спапяляла нас позіркам, поўным нянавісці."

# game/scripts/scene/scene_day_5.rpy:9945
translate belarusian event_m_polina_devend_7957799a:

    # "Я заметил, как Полина бросает через плечо торжествующий взгляд и улыбается."
    "Я заўважыў, як Паліна кідае цераз плячо пераможны погляд і ўсміхаецца."

# game/scripts/scene/scene_day_5.rpy:9946
translate belarusian event_m_polina_devend_fa0793e3:

    # "Неужели все девочки такие? Парни им важнее подруг?"
    "Няўжо ўсе дзяўчынкі такія? Хлопцы ім важнейшыя за сябровак?"

# game/scripts/scene/scene_day_5.rpy:9947
translate belarusian event_m_polina_devend_d4ce4020:

    # "Впрочем, Катя с Полиной и не подруги совсем..."
    "Зрэшты, Каця з Палінай і не сяброўкі зусім..."

# game/scripts/scene/scene_day_5.rpy:9997
translate belarusian event_m_polina_devend_c34bf287:

    # "Я тоже обернулся, но мгла уже скрыла одинокую фигуру, сиротливо опирающуюся на костыли."
    "Я таксама азірнуўся, але імгла ўжо схавала самотную постаць, якая сіратліва абапіралася на мыліцы."

# game/scripts/scene/scene_day_5.rpy:9998
translate belarusian event_m_polina_devend_a603945a:

    # voice "voice/Polina/5day/54 Da.ogg"
    # Pol "Давит на жалость, актриса."
    voice "voice/Polina/5day/54 Da.ogg"
    Pol "Цісне на жаль, актрыса."

# game/scripts/scene/scene_day_5.rpy:10000
translate belarusian event_m_polina_devend_5e6f1899:

    # voice "voice/Anton/5day/74 Ei.ogg"
    # Ant "Ей действительно очень плохо сейчас."
    voice "voice/Anton/5day/74 Ei.ogg"
    Ant "Ёй сапраўды вельмі дрэнна зараз."

# game/scripts/scene/scene_day_5.rpy:10042
translate belarusian event_m_polina_devend_10a37993:

    # voice "voice/Polina/5day/55 Vs.ogg" 
    # Pol "Вспомни, как она настраивала всех против тебя."
    voice "voice/Polina/5day/55 Vs.ogg" 
    Pol "Згадай, як яна настройвала ўсіх супраць цябе."

# game/scripts/scene/scene_day_5.rpy:10046
translate belarusian event_m_polina_devend_4c2e57da:

    # voice "voice/Polina/5day/56 Ta.ogg" 
    # Pol "Такие люди не меняются."
    voice "voice/Polina/5day/56 Ta.ogg" 
    Pol "Такія людзі не мяняюцца."

# game/scripts/scene/scene_day_5.rpy:10050
translate belarusian event_m_polina_devend_8d57fc4a:

    # voice "voice/Polina/5day/57 Ho.ogg" 
    # Pol "Хотя она и не заслужила того, что случилось."
    voice "voice/Polina/5day/57 Ho.ogg" 
    Pol "Хоць яна і не заслужыла таго, што здарылася."

# game/scripts/scene/scene_day_5.rpy:10056
translate belarusian event_m_polina_devend_acbbf943:

    # voice "voice/Anton/5day/75 N.ogg"
    # Ant "Никто не заслужил."
    voice "voice/Anton/5day/75 N.ogg"
    Ant "Ніхто не заслужыў."

# game/scripts/scene/scene_day_5.rpy:10116
translate belarusian event_m_polina_devend_08d4f21b:

    # "Я вздохнул, и мы пошли по занесённой свежим снегом тропе."
    "Я ўздыхнуў, і мы пайшлі па занесенай свежым снегам сцежцы."

# game/scripts/scene/scene_day_5.rpy:10118
translate belarusian event_m_polina_devend_75ab219e:

    # "Полина хихикала, уклоняясь от летящего в лицо снега."
    "Паліна хіхікала, ухіляючыся ад снегу, які ляцеў у твар."

# game/scripts/scene/scene_day_5.rpy:10120
translate belarusian event_m_polina_devend_21d95bfa:

    # voice "voice/Polina/5day/59 na.ogg" 
    # Pol "На коньках умеешь?"
    voice "voice/Polina/5day/59 na.ogg" 
    Pol "На каньках умееш?"

# game/scripts/scene/scene_day_5.rpy:10122
translate belarusian event_m_polina_devend_fe6bbddf:

    # voice "voice/Anton/5day/76 Ne.ogg"
    # Ant "Немного."
    voice "voice/Anton/5day/76 Ne.ogg"
    Ant "Крыху."

# game/scripts/scene/scene_day_5.rpy:10124
translate belarusian event_m_polina_devend_b799303f:

    # voice "voice/Polina/5day/60 sho.ogg" 
    # Pol "Сходим как-нибудь на каток?"
    voice "voice/Polina/5day/60 sho.ogg" 
    Pol "Сходзім як-небудзь на каток?"

# game/scripts/scene/scene_day_5.rpy:10128
translate belarusian event_m_polina_devend_3e172822:

    # voice "voice/Anton/5day/77 La.ogg"
    # Ant "Ладно..."
    voice "voice/Anton/5day/77 La.ogg"
    Ant "Добра..."

# game/scripts/scene/scene_day_5.rpy:10130
translate belarusian event_m_polina_devend_c52bdf1a:

    # voice "voice/Polina/5day/62 da.ogg"
    # Pol "Давай как черепахи."
    voice "voice/Polina/5day/62 da.ogg"
    Pol "Давай як чарапахі."

# game/scripts/scene/scene_day_5.rpy:10165
translate belarusian event_m_polina_devend_178842e7:

    # voice "voice/Polina/5day/61 hah.ogg" 
    # "Мы повернулись к ветру спинами и пошли задом-наперёд."
    voice "voice/Polina/5day/61 hah.ogg" 
    "Мы павярнуліся да ветру спінамі і пайшлі задам наперад."

# game/scripts/scene/scene_day_5.rpy:10167
translate belarusian event_m_polina_devend_86e1d397:

    # voice "voice/Anton/5day/78 Pod.ogg"
    # Ant "Под ноги смотри, упадёшь."
    voice "voice/Anton/5day/78 Pod.ogg"
    Ant "Пад ногі глядзі, упадзеш."

# game/scripts/scene/scene_day_5.rpy:10169
translate belarusian event_m_polina_devend_c5571182:

    # voice "voice/Polina/5day/63 ku.ogg" 
    # Pol "Куда хочу, туда и смотрю."
    voice "voice/Polina/5day/63 ku.ogg" 
    Pol "Куды хачу, туды і гляджу."

# game/scripts/scene/scene_day_5.rpy:10172
translate belarusian event_m_polina_devend_a957b887:

    # "Получается, смотреть она хотела на меня. Тёплый, контрастирующий с погодой взгляд."
    "Выходзіць, глядзець яна хацела на мяне. Цёплы погляд, які кантраставаў з надвор'ем."

# game/scripts/scene/scene_day_5.rpy:10200
translate belarusian event_m_polina_devend_22c0dbd0:

    # "Вдруг Полина поскользнулась и со смехом шлёпнулась в сугроб."
    "Раптам Паліна паслізнулася і са смехам шлёпнулася ў сумёт."

# game/scripts/scene/scene_day_5.rpy:10205
translate belarusian event_m_polina_devend_f6992674:

    # "Я пришёл на помощь, поднял её, хихикающую, и отряхнул пальто от снега."
    "Я прыйшоў на дапамогу, падняў яе — яна хіхікала — і абтрос паліто ад снегу."

# game/scripts/scene/scene_day_5.rpy:10221
translate belarusian event_m_polina_devend_53ac929e:

    # "Как раз в эту секунду Ромка выскользнул из-за угла."
    "Якраз у гэтую секунду Ромка выслізнуў з-за рога."

# game/scripts/scene/scene_day_5.rpy:10242
translate belarusian event_m_polina_devend_d03367be:

    # "Моё сердце сжалось."
    "Маё сэрца сціснулася."

# game/scripts/scene/scene_day_5.rpy:10243
translate belarusian event_m_polina_devend_b836722e:

    # "Что Ромка подумает?"
    "Што Ромка падумае?"

# game/scripts/scene/scene_day_5.rpy:10244
translate belarusian event_m_polina_devend_abcc14a6:

    # "Он развязал меня в Гараже, мы столько испытали вместе, а я — друг, называется! — трусь с его девчонкой!"
    "Ён развязаў мяне ў Гаражы, мы столькі перажылі разам, а я — сябар, называецца! — труся з яго дзяўчынай!"

# game/scripts/scene/scene_day_5.rpy:10261
translate belarusian event_m_polina_devend_16496c67:

    # "Я завис, ожидая скандала, самой неприятной разборки в моей жизни."
    "Я завіс, чакаючы скандалу, самай непрыемнай разборкі ў маім жыцці."

# game/scripts/scene/scene_day_5.rpy:10262
translate belarusian event_m_polina_devend_92098648:

    # "Полина втянула голову в шею, как настоящая черепаха."
    "Паліна ўцягнула галаву ў шыю, як сапраўдная чарапаха."

# game/scripts/scene/scene_day_5.rpy:10282
translate belarusian event_m_polina_devend_0b962542:

    # "Я замер, хлопая глазами, понимая, что не готов к драке, но стычки не избежать."
    "Я замер, лыпаючы вачыма, разумеючы, што не гатовы да бойкі, але сутычкі не пазбегнуць."

# game/scripts/scene/scene_day_5.rpy:10283
translate belarusian event_m_polina_devend_4d3298f8:

    # "Ромке достаточно увидеть нас вместе с Полиной, чтобы потерять разум."
    "Ромку дастаткова ўбачыць нас разам з Палінай, каб страціць розум."

# game/scripts/scene/scene_day_5.rpy:10284
translate belarusian event_m_polina_devend_a43e738a:

    # "Судя по напряжённой позе, Полина боялась того же самого."
    "Мяркуючы па напружанай позе, Паліна баялася таго ж самага."

# game/scripts/scene/scene_day_5.rpy:10285
translate belarusian event_m_polina_devend_1242559f:

    # "В голове всплыли все его угрозы."
    "У галаве ўсплылі ўсе яго пагрозы."

# game/scripts/scene/scene_day_5.rpy:10336
translate belarusian event_m_polina_devend_58d08279:

    # "Они обрели новый вес, учитывая, как плохо выглядел Ромка после визита в Гараж."
    "Яны набылі новую вагу, улічваючы, як дрэнна выглядаў Ромка пасля візіту ў Гараж."

# game/scripts/scene/scene_day_5.rpy:10337
translate belarusian event_m_polina_devend_262b4f23:

    # "Бледный, осунувшийся, ходит, словно во сне..."
    "Бледны, змарнелы, ходзіць, нібы ў сне..."

# game/scripts/scene/scene_day_5.rpy:10339
translate belarusian event_m_polina_devend_270d2160:

    # "Я набрал в грудь воздух, но Ромка прервал меня."
    "Я набраў у грудзі паветра, але Ромка перапыніў мяне."

# game/scripts/scene/scene_day_5.rpy:10342
translate belarusian event_m_polina_devend_08ddb9c4:

    # voice "voice/romka/5day/30 B.ogg"
    # Rom "Были на уроках?"
    voice "voice/romka/5day/30 B.ogg"
    Rom "Былі на ўроках?"

# game/scripts/scene/scene_day_5.rpy:10345
translate belarusian event_m_polina_devend_0c6d7506:

    # "В вопросе не ощущалось угрозы. Голос был лишён эмоций, словно говорил робот."
    "У пытанні не адчувалася пагрозы. Голас быў пазбаўлены эмоцый, нібы гаварыў робат."

# game/scripts/scene/scene_day_5.rpy:10346
translate belarusian event_m_polina_devend_7452d74b:

    # voice "voice/Anton/5day/79 Aga.ogg"
    # Ant "Ага."
    voice "voice/Anton/5day/79 Aga.ogg"
    Ant "Ага."

# game/scripts/scene/scene_day_5.rpy:10349
translate belarusian event_m_polina_devend_878ae9e8:

    # voice "voice/romka/5day/31 B.ogg"
    # Rom "Бяша объявлялся?"
    voice "voice/romka/5day/31 B.ogg"
    Rom "Бяша аб'яўляўся?"

# game/scripts/scene/scene_day_5.rpy:10360
translate belarusian event_m_polina_devend_ba2f83fb:

    # "Я качнул головой, про себя удивившись."
    "Я хітнуў галавой, пра сябе здзівіўшыся."

# game/scripts/scene/scene_day_5.rpy:10394
translate belarusian event_m_polina_devend_3b02b3bb:

    # "Мы же оба прекрасно видели кроссовок. И Ромка подтвердил, что он его друга."
    "Мы ж абодва выдатна бачылі красоўку. І Ромка пацвердзіў, што яна яго сябра."

# game/scripts/scene/scene_day_5.rpy:10395
translate belarusian event_m_polina_devend_10ef62ad:

    # "Вряд ли Бяша сам подарил обувь маньяку и бродит по посёлку босиком."
    "Наўрад ці Бяша сам падарыў абутак маньяку і бадзяецца па пасёлку басанож."

# game/scripts/scene/scene_day_5.rpy:10418
translate belarusian event_m_polina_devend_070cce4d:

    # voice "voice/Anton/5day/80 Rom.ogg"
    # Ant "Ром, Бяша был в Гараже."
    voice "voice/Anton/5day/80 Rom.ogg"
    Ant "Ром, Бяша быў у Гаражы."

# game/scripts/scene/scene_day_5.rpy:10435
translate belarusian event_m_polina_devend_99491493:

    # voice "voice/romka/5day/33 Bil.ogg"
    # Rom "Был, и что? Мы тоже были — живы-здоровы."
    voice "voice/romka/5day/33 Bil.ogg"
    Rom "Быў, і што? Мы таксама былі — жывыя-здаровыя."

# game/scripts/scene/scene_day_5.rpy:10438
translate belarusian event_m_polina_devend_9230fad2:

    # "Он не казался мне здоровым."
    "Ён не падаваўся мне здаровым."

# game/scripts/scene/scene_day_5.rpy:10440
translate belarusian event_m_polina_devend_34c002fe:

    # voice "voice/romka/5day/34 Ya.ogg"
    # Rom "Я не успокоюсь, пока не выясню, что с Бяшей."
    voice "voice/romka/5day/34 Ya.ogg"
    Rom "Я не супакоюся, пакуль не высветлю, што з Бяшам."

# game/scripts/scene/scene_day_5.rpy:10443
translate belarusian event_m_polina_devend_3af65eee:

    # "Ромины желваки ходили ходуном, а щёки, несмотря на мороз, были белы, как снег."
    "Ромавы жаўлакі хадзілі хадуном, а шчокі, нягледзячы на мароз, былі белыя, як снег."

# game/scripts/scene/scene_day_5.rpy:10446
translate belarusian event_m_polina_devend_4f56c0a6:

    # voice "voice/romka/5day/35 B.ogg"
    # Rom "Бяша столько раз из дома сбегал."
    voice "voice/romka/5day/35 B.ogg"
    Rom "Бяша столькі разоў з дому ўцякаў."

# game/scripts/scene/scene_day_5.rpy:10450
translate belarusian event_m_polina_devend_6a36c310:

    # voice "voice/romka/5day/36 Bi.ogg"
    # Rom "Бывает, кинет камушек мне в стекло, я окно открою, чтоб он залез..."
    voice "voice/romka/5day/36 Bi.ogg"
    Rom "Бывае, кіне каменьчык мне ў шыбу, я акно адчыню, каб ён залез..."

# game/scripts/scene/scene_day_5.rpy:10454
translate belarusian event_m_polina_devend_5eed3294:

    # voice "voice/romka/5day/37 Na.ogg"
    # Rom "На полу ему постелю, он вертится всю ночь, как юла, спать мешает."
    voice "voice/romka/5day/37 Na.ogg"
    Rom "На падлозе яму пасцялю, ён круціцца ўсю ноч, як дзыга, спаць замінае."

# game/scripts/scene/scene_day_5.rpy:10458
translate belarusian event_m_polina_devend_575e1846:

    # voice "voice/romka/5day/38 Za.ogg"
    # Rom "Зато я знаю, случись у меня какое несчастье, и он всегда на помощь придёт."
    voice "voice/romka/5day/38 Za.ogg"
    Rom "Затое я ведаю, здарыся ў мяне якое няшчасце, і ён заўсёды на дапамогу прыйдзе."

# game/scripts/scene/scene_day_5.rpy:10462
translate belarusian event_m_polina_devend_8cf4bd47:

    # "Рома посмотрел заторможенно на падающие снежинки."
    "Рома затарможана паглядзеў на сняжынкі, што падалі."

# game/scripts/scene/scene_day_5.rpy:10464
translate belarusian event_m_polina_devend_d79741ed:

    # voice "voice/romka/5day/39 Vs.ogg"
    # Rom "Всё жду, когда Бяша снова камушек бросит."
    voice "voice/romka/5day/39 Vs.ogg"
    Rom "Усё чакаю, калі Бяша зноў каменьчык кіне."

# game/scripts/scene/scene_day_5.rpy:10467
translate belarusian event_m_polina_devend_646cb257:

    # "Последние слова Рома произнёс так тихо, что я едва их услышал."
    "Апошнія словы Рома прамовіў так ціха, што я ледзь іх пачуў."

# game/scripts/scene/scene_day_5.rpy:10468
translate belarusian event_m_polina_devend_f3f6299b:

    # "Признание стало облачком пара, сорвавшимся с бледных губ мальчишки."
    "Прызнанне стала воблачкам пары, што сарвалася з бледных вуснаў хлапчука."

# game/scripts/scene/scene_day_5.rpy:10471
translate belarusian event_m_polina_devend_f6b026f9:

    # "Оно растаяло в морозном воздухе короткого дня."
    "Яно растала ў марозным паветры кароткага дня."

# game/scripts/scene/scene_day_5.rpy:10485
translate belarusian event_m_polina_devend_32398a2b:

    # "Рома вынул из куртки пачку распечаток, отделил несколько бумажек и ткнул их мне."
    "Рома выняў з курткі пачак раздруковак, аддзяліў некалькі паперак і тыцнуў іх мне."

# game/scripts/scene/scene_day_5.rpy:10486
translate belarusian event_m_polina_devend_9cd46182:

    # "Это было объявление о пропаже Игоря Будаева. Фотография Бяши и его приметы."
    "Гэта была аб'ява пра знікненне Ігара Будаева. Фотаздымак Бяшы і яго прыкметы."

# game/scripts/scene/scene_day_5.rpy:10488
translate belarusian event_m_polina_devend_a5ee074a:

    # voice "voice/romka/5day/40 Ra.ogg"
    # Rom "Развесь вдоль дороги."
    voice "voice/romka/5day/40 Ra.ogg"
    Rom "Развесь уздоўж дарогі."

# game/scripts/scene/scene_day_5.rpy:10506
translate belarusian event_m_polina_devend_60e7109d:

    # "И, не ожидая ответа, погружённый в мысли, как в зыбучие пески, он пошёл прочь."
    "І, не чакаючы адказу, пагружаны ў думкі, як у зыбучыя пяскі, ён пайшоў прэч."

# game/scripts/scene/scene_day_5.rpy:10507
translate belarusian event_m_polina_devend_94211521:

    # "Может, вовсе не заметил Полину, а может, ему было плевать."
    "Можа, зусім не заўважыў Паліну, а можа, яму было напляваць."

# game/scripts/scene/scene_day_5.rpy:10508
translate belarusian event_m_polina_devend_26110a40:

    # "Черты его лица заострились, как после продолжительной болезни, остекленевшие глаза смотрели в пустоту."
    "Рысы яго твару завастрыліся, як пасля працяглай хваробы, ашклянелыя вочы глядзелі ў пустэчу."

# game/scripts/scene/scene_day_5.rpy:10511
translate belarusian event_m_polina_devend_fab3093b:

    # "Секунда, и он исчез в метели, а мы продолжили путь."
    "Секунда, і ён знік у завеі, а мы працягнулі шлях."

# game/scripts/scene/scene_day_5.rpy:10531
translate belarusian event_m_polina_devend_186a4f64:

    # voice "voice/Polina/5day/66 on.ogg"
    # Pol "Он теперь постоянно такой. Я пыталась с ним поговорить — ни черта он не слышит."
    voice "voice/Polina/5day/66 on.ogg"
    Pol "Ён цяпер пастаянна такі. Я спрабавала з ім пагаварыць — ні чорта ён не чуе."

# game/scripts/scene/scene_day_5.rpy:10535
translate belarusian event_m_polina_devend_7694c59a:

    # voice "voice/Polina/5day/67 zn.ogg" 
    # Pol "Знаешь, он как скрипка с порванными струнами."
    voice "voice/Polina/5day/67 zn.ogg" 
    Pol "Ведаеш, ён як скрыпка з парванымі струнамі."

# game/scripts/scene/scene_day_5.rpy:10539
translate belarusian event_m_polina_devend_b50b7a04:

    # voice "voice/Polina/5day/68 e.ogg" 
    # Pol "Его мелодия угасает."
    voice "voice/Polina/5day/68 e.ogg" 
    Pol "Яго мелодыя згасае."

# game/scripts/scene/scene_day_5.rpy:10544
translate belarusian event_m_polina_devend_6613ea4b:

    # voice "voice/Anton/5day/81 on.ogg"
    # Ant "Он потерял друга."
    voice "voice/Anton/5day/81 on.ogg"
    Ant "Ён страціў сябра."

# game/scripts/scene/scene_day_5.rpy:10549
translate belarusian event_m_polina_devend_c62a7de3:

    # voice "voice/Polina/5day/69 d.ogg" 
    # Pol "Даже это не повод превращаться в зомби."
    voice "voice/Polina/5day/69 d.ogg" 
    Pol "Нават гэта не нагода ператварацца ў зомбі."

# game/scripts/scene/scene_day_5.rpy:10553
translate belarusian event_m_polina_devend_9704f512:

    # voice "voice/Polina/5day/70 on.ogg" 
    # Pol "Он забил на школу."
    voice "voice/Polina/5day/70 on.ogg" 
    Pol "Ён забіў на школу."

# game/scripts/scene/scene_day_5.rpy:10557
translate belarusian event_m_polina_devend_bebbcaf5:

    # voice "voice/Polina/5day/71 bo.ogg" 
    # Pol "Боюсь, как бы не начудил чего..."
    voice "voice/Polina/5day/71 bo.ogg" 
    Pol "Баюся, каб не начудзіў чаго..."

# game/scripts/scene/scene_day_5.rpy:10572
translate belarusian event_m_polina_devend_78967cef:

    # voice "voice/Anton/5day/82 ka.ogg"
    # Ant "Каждый переживает трагедию по-своему."
    voice "voice/Anton/5day/82 ka.ogg"
    Ant "Кожны перажывае трагедыю па-свойму."

# game/scripts/scene/scene_day_5.rpy:10582
translate belarusian event_m_polina_devend_ac06c4ea:

    # voice "voice/Polina/5day/72 a.ogg" 
    # Pol "А как переживаешь ты?"
    voice "voice/Polina/5day/72 a.ogg" 
    Pol "А як перажываеш ты?"

# game/scripts/scene/scene_day_5.rpy:10584
translate belarusian event_m_polina_devend_f1bcb81e:

    # voice "voice/Anton/5day/83 A.ogg"
    # Ant "А я не терял никого настолько близкого."
    voice "voice/Anton/5day/83 A.ogg"
    Ant "А я не губляў нікога настолькі блізкага."

# game/scripts/scene/scene_day_5.rpy:10591
translate belarusian event_m_polina_devend_87f0932a:

    # voice "voice/Polina/5day/73 an.ogg"
    # Pol "Антон, ты сам чуть не потерялся. Мы с девочками об этом всё время говорим."
    voice "voice/Polina/5day/73 an.ogg"
    Pol "Антон, ты сам ледзь не згубіўся. Мы з дзяўчатамі пра гэта ўвесь час гаворым."

# game/scripts/scene/scene_day_5.rpy:10594
translate belarusian event_m_polina_devend_40b3c881:

    # voice "voice/Anton/5day/84 O.ogg"
    # Ant "О чём?"
    voice "voice/Anton/5day/84 O.ogg"
    Ant "Пра што?"

# game/scripts/scene/scene_day_5.rpy:10597
translate belarusian event_m_polina_devend_5df7e2dd:

    # voice "voice/Polina/5day/74 on.ogg" 
    # Pol "Они считают, что у тебя железные нервы, и я..."
    voice "voice/Polina/5day/74 on.ogg" 
    Pol "Яны лічаць, што ў цябе жалезныя нервы, і я..."

# game/scripts/scene/scene_day_5.rpy:10601
translate belarusian event_m_polina_devend_8a8fec37:

    # voice "voice/Polina/5day/75 ta.ogg" 
    # Pol "... так считаю тоже."
    voice "voice/Polina/5day/75 ta.ogg" 
    Pol "... таксама так лічу."

# game/scripts/scene/scene_day_5.rpy:10615
translate belarusian event_m_polina_devend_8f0ef77b:

    # "Я поймал странное ощущение. Мне хотелось сгореть от стыда и рассмеяться."
    "Я злавіў дзіўнае адчуванне. Мне хацелася згарэць ад сораму і рассмяяцца."

# game/scripts/scene/scene_day_5.rpy:10629
translate belarusian event_m_polina_devend_ec9ce04d:

    # "Полина опасливо посмотрела в бушующий буран, куда-то за пределы видимости."
    "Паліна з апаскай паглядзела ў шалёны буран, кудысьці за межы бачнасці."

# game/scripts/scene/scene_day_5.rpy:10634
translate belarusian event_m_polina_devend_1888f2c2:

    # voice "voice/Polina/5day/76 tebe.ogg"
    # Pol "Тебе совсем не было страшно?"
    voice "voice/Polina/5day/76 tebe.ogg"
    Pol "Табе зусім не было страшна?"

# game/scripts/scene/scene_day_5.rpy:10638
translate belarusian event_m_polina_devend_37a09f09:

    # voice "voice/Anton/5day/85 Sh.ogg"
    # Ant "Шутишь? Я думал, поседею."
    voice "voice/Anton/5day/85 Sh.ogg"
    Ant "Жартуеш? Я думаў, пасівею."

# game/scripts/scene/scene_day_5.rpy:10648
translate belarusian event_m_polina_devend_f7440a1b:

    # voice "voice/Polina/5day/77  ti.ogg" 
    # Pol "Ты и так белобрысый."
    voice "voice/Polina/5day/77  ti.ogg" 
    Pol "Ты і так бялявы."

# game/scripts/scene/scene_day_5.rpy:10654
translate belarusian event_m_polina_devend_625e63b9:

    # "Полина хмыкнула, но тут же стала серьёзной."
    "Паліна хмыкнула, але тут жа стала сур'ёзнай."

# game/scripts/scene/scene_day_5.rpy:10658
translate belarusian event_m_polina_devend_22b5dae3:

    # voice "voice/Polina/5day/79 mi.ogg" 
    # Pol "Мы же встречали его каждый день... этого тракториста..."
    voice "voice/Polina/5day/79 mi.ogg" 
    Pol "Мы ж сустракалі яго кожны дзень... гэтага трактарыста..."

# game/scripts/scene/scene_day_5.rpy:10662
translate belarusian event_m_polina_devend_4f919412:

    # voice "voice/Polina/5day/80 Ya.ogg"
    # Pol "Я постоянно об этом думаю."
    voice "voice/Polina/5day/80 Ya.ogg"
    Pol "Я пастаянна пра гэта думаю."

# game/scripts/scene/scene_day_5.rpy:10666
translate belarusian event_m_polina_devend_0699568b:

    # voice "voice/Polina/5day/81 on.ogg" 
    # Pol "Он выглядел таким нормальным."
    voice "voice/Polina/5day/81 on.ogg" 
    Pol "Ён выглядаў такім нармальным."

# game/scripts/scene/scene_day_5.rpy:10670
translate belarusian event_m_polina_devend_4675f77f:

    # voice "voice/Polina/5day/82 po.ogg" 
    # Pol "Полный псих..."
    voice "voice/Polina/5day/82 po.ogg" 
    Pol "Поўны псіх..."

# game/scripts/scene/scene_day_5.rpy:10685
translate belarusian event_m_polina_devend_0ecee69c:

    # voice "voice/Anton/5day/86 P.ogg"
    # Ant "Псих-то псих, но осторожный."
    voice "voice/Anton/5day/86 P.ogg"
    Ant "Псіх-та псіх, але асцярожны."

# game/scripts/scene/scene_day_5.rpy:10689
translate belarusian event_m_polina_devend_b92e5f97:

    # voice "voice/Anton/5day/87 Pe.ogg"
    # Ant "Перевозил гараж в метель, чтобы к утру не оставалось следов."
    voice "voice/Anton/5day/87 Pe.ogg"
    Ant "Перавозіў гараж у завею, каб да раніцы не заставалася слядоў."

# game/scripts/scene/scene_day_5.rpy:10709
translate belarusian event_m_polina_devend_27ce84c7:

    # voice "voice/Polina/5day/83 Mne.ogg"
    # Pol "Мне ночами снится, что я выглядываю в окно, а там эта чёрная гадость."
    voice "voice/Polina/5day/83 Mne.ogg"
    Pol "Мне начамі сніцца, што я выглядаю ў акно, а там гэтая чорная гідота."

# game/scripts/scene/scene_day_5.rpy:10713
translate belarusian event_m_polina_devend_d6637ec0:

    # voice "voice/Polina/5day/84 Pa.ogg" 
    # Pol "Пару раз будила дедушку криками спросонку."
    voice "voice/Polina/5day/84 Pa.ogg" 
    Pol "Пару разоў будзіла дзядулю крыкамі спрасонку."

# game/scripts/scene/scene_day_5.rpy:10720
translate belarusian event_m_polina_devend_38af2889:

    # voice "voice/Polina/5day/85 A.ogg" 
    # Pol "А теперь и будить некого. Деда в больницу положили."
    voice "voice/Polina/5day/85 A.ogg" 
    Pol "А цяпер і будзіць няма каго. Дзеда ў бальніцу паклалі."

# game/scripts/scene/scene_day_5.rpy:10724
translate belarusian event_m_polina_devend_e4f1af4c:

    # voice "voice/Polina/5day/86 V.ogg" 
    # Pol "В родной спальне дрожу от теней."
    voice "voice/Polina/5day/86 V.ogg" 
    Pol "У роднай спальні дрыжу ад ценяў."

# game/scripts/scene/scene_day_5.rpy:10742
translate belarusian event_m_polina_devend_2ebad870:

    # "Мы поравнялись с калиткой Полины."
    "Мы параўняліся з брамкай Паліны."

# game/scripts/scene/scene_day_5.rpy:10751
translate belarusian event_m_polina_devend_421307c3:

    # voice "voice/Polina/5day/87 Ti.ogg"
    # Pol "Ты и так для меня столько всего сделал. Но у меня ещё одна просьба."
    voice "voice/Polina/5day/87 Ti.ogg"
    Pol "Ты і так для мяне столькі ўсяго зрабіў. Але ў мяне яшчэ адна просьба."

# game/scripts/scene/scene_day_5.rpy:10755
translate belarusian event_m_polina_devend_c1ff5e20:

    # voice "voice/Polina/5day/88 ne.ogg" 
    # Pol "Не мог бы ты сегодня остаться?"
    voice "voice/Polina/5day/88 ne.ogg" 
    Pol "Не мог бы ты сёння застацца?"

# game/scripts/scene/scene_day_5.rpy:10758
translate belarusian event_m_polina_devend_44cfc671:

    # voice "voice/Anton/5day/88 Ne.ogg"
    # Ant "Не знаю... двух недель не прошло, я у родителей на жёстком контроле..."
    voice "voice/Anton/5day/88 Ne.ogg"
    Ant "Не ведаю... двух тыдняў не прайшло, я ў бацькоў на жорсткім кантролі..."

# game/scripts/scene/scene_day_5.rpy:10762
translate belarusian event_m_polina_devend_a68294ba:

    # voice "voice/Polina/5day/89 Nu.ogg" 
    # Pol "Ну придумай что-нибудь!"
    voice "voice/Polina/5day/89 Nu.ogg" 
    Pol "Ну прыдумай што-небудзь!"

# game/scripts/scene/scene_day_5.rpy:10773
translate belarusian event_m_polina_devend_2008a2dd:

    # voice "voice/Polina/5day/90 Po.ogg" 
    # Pol "Пожалуйста-пожалуйста-пожалуйста!"
    voice "voice/Polina/5day/90 Po.ogg" 
    Pol "Калі ласка, калі ласка, калі ласка!"

# game/scripts/scene/scene_day_5.rpy:10798
translate belarusian event_m_polina_devend_59903854:

    # voice "voice/Polina/5day/91 Ya.ogg"
    # Pol "Я правда буду чувствовать себя в безопасности."
    voice "voice/Polina/5day/91 Ya.ogg"
    Pol "Я праўда буду адчуваць сябе ў бяспецы."

# game/scripts/scene/scene_day_5.rpy:10805
translate belarusian event_m_polina_devend_40095e75:

    # voice "voice/Anton/5day/89 Es.ogg"
    # Ant "Если мама разрешит. Она сейчас на нервах."
    voice "voice/Anton/5day/89 Es.ogg"
    Ant "Калі мама дазволіць. Яна зараз на нервах."

# game/scripts/scene/scene_day_5.rpy:10829
translate belarusian event_m_polina_devend_58312be0:

    # voice "voice/Polina/5day/82 bu.ogg" 
    # Pol "Буду держать кулачки. И приберусь быстро, пока ты звонишь."
    voice "voice/Polina/5day/82 bu.ogg" 
    Pol "Буду трымаць кулачкі. І прыбяруся хутка, пакуль ты тэлефануеш."

# game/scripts/scene/scene_day_5.rpy:10834
translate belarusian event_m_polina_devend_c78e2685:

    # "Мы вошли в дом. Коридор действительно выглядел холодно и неприветливо."
    "Мы зайшлі ў дом. Калідор сапраўды выглядаў холадна і непрыветна."

# game/scripts/scene/scene_day_5.rpy:10847
translate belarusian event_m_polina_devend_65237108:

    # "И вспыхнувший свет не сильно улучшил его угрюмый вид."
    "І святло, што ўспыхнула, не надта палепшыла яго пануры выгляд."

# game/scripts/scene/scene_day_5.rpy:10879
translate belarusian event_m_polina_devend_6c37afc4:

    # "Полина указала на телефон и сбежала в комнату."
    "Паліна паказала на тэлефон і ўцякла ў пакой."

# game/scripts/scene/scene_day_5.rpy:10942
translate belarusian event_m_polina_phone_wrong_9ea1c75b:

    # Operator "Неправильно набран номер. Неправильно набран номер. Неправильно набран..."
    Operator "Няправільна набраны нумар. Няправільна набраны нумар. Няправільна набраны..."

# game/scripts/scene/scene_day_5.rpy:10949
translate belarusian event_m_polina_phone_overused_eb21477d:

    # voice "voice/episod/DANNOE.ogg" 
    # Operator "Данное направление перегружено. Данное направление перегружено. Данное направление..."
    voice "voice/episod/DANNOE.ogg" 
    Operator "Гэты напрамак перагружаны. Гэты напрамак перагружаны. Гэты напрамак..."

# game/scripts/scene/scene_day_5.rpy:10961
translate belarusian event_m_polina_phone_roma_45f562e0:

    # "Интересно, как там Ромка? Не наделал бы он глупостей."
    "Цікава, як там Ромка? Не нарабіў бы ён глупстваў."

# game/scripts/scene/scene_day_5.rpy:10962
translate belarusian event_m_polina_phone_roma_d1217a09:

    # "Нельзя оставлять его без поддержки."
    "Нельга пакідаць яго без падтрымкі."

# game/scripts/scene/scene_day_5.rpy:10966
translate belarusian event_m_polina_phone_roma_3e769153:

    # voice "voice/Anton/5day/90 A.ogg"
    # Ant "Алло."
    voice "voice/Anton/5day/90 A.ogg"
    Ant "Алё."

# game/scripts/scene/scene_day_5.rpy:10968
translate belarusian event_m_polina_phone_roma_7f70c8ef:

    # voice "voice/romka/5day/59 D.ogg"
    # Rom "Дружище! Ты где был?"
    voice "voice/romka/5day/59 D.ogg"
    Rom "Сябрук! Ты дзе быў?"

# game/scripts/scene/scene_day_5.rpy:10970
translate belarusian event_m_polina_phone_roma_452bb6ed:

    # "Слово «дружище» из Ромкиных уст окрылило меня. Забывшись, я выпалил без раздумий:"
    "Слова «сябрук» з Ромкавых вуснаў акрыліла мяне. Забыўшыся, я выпаліў без роздуму:"

# game/scripts/scene/scene_day_5.rpy:10972
translate belarusian event_m_polina_phone_roma_9acab3b5:

    # voice "voice/Anton/5day/91 Nig.ogg"
    # Ant "Нигде... провожал Полину."
    voice "voice/Anton/5day/91 Nig.ogg"
    Ant "Нідзе... праводзіў Паліну."

# game/scripts/scene/scene_day_5.rpy:10974
translate belarusian event_m_polina_phone_roma_59e12c68:

    # voice "voice/romka/5day/60 To.ogg"
    # Rom "Тоха, ты?"
    voice "voice/romka/5day/60 To.ogg"
    Rom "Тоха, ты?"

# game/scripts/scene/scene_day_5.rpy:10976
translate belarusian event_m_polina_phone_roma_b6f88d93:

    # voice "voice/romka/5day/61 Mn.ogg"
    # Rom "Мне показалось, Бяша звонит..."
    voice "voice/romka/5day/61 Mn.ogg"
    Rom "Мне падалося, Бяша тэлефануе..."

# game/scripts/scene/scene_day_5.rpy:10978
translate belarusian event_m_polina_phone_roma_c1f4cbce:

    # voice "voice/romka/5day/62 Za.ogg"
    # Rom "Забей! Как там Полинка?"
    voice "voice/romka/5day/62 Za.ogg"
    Rom "Плюнь! Як там Палінка?"

# game/scripts/scene/scene_day_5.rpy:10980
translate belarusian event_m_polina_phone_roma_9356569c:

    # voice "voice/Anton/5day/92 V.ogg"
    # Ant "Вроде нормально..."
    voice "voice/Anton/5day/92 V.ogg"
    Ant "Нібыта нармальна..."

# game/scripts/scene/scene_day_5.rpy:10982
translate belarusian event_m_polina_phone_roma_e9778a65:

    # voice "voice/romka/5day/63 Kr.ogg"
    # Rom "Красава, что позаботился о ней. Ты настоящий кореш."
    voice "voice/romka/5day/63 Kr.ogg"
    Rom "Красава, што паклапаціўся пра яе. Ты сапраўдны кораш."

# game/scripts/scene/scene_day_5.rpy:10984
translate belarusian event_m_polina_phone_roma_30d6c3f7:

    # voice "voice/romka/5day/64 Zn.ogg"
    # Rom "Знаешь, я сейчас немного расклеился."
    voice "voice/romka/5day/64 Zn.ogg"
    Rom "Ведаеш, я зараз трохі расклеіўся."

# game/scripts/scene/scene_day_5.rpy:10986
translate belarusian event_m_polina_phone_roma_44fbd3c8:

    # voice "voice/romka/5day/65 A.ogg"
    # Rom "А ты..."
    voice "voice/romka/5day/65 A.ogg"
    Rom "А ты..."

# game/scripts/scene/scene_day_5.rpy:10988
translate belarusian event_m_polina_phone_roma_2936eb6d:

    # voice "voice/romka/5day/66 Po.ogg"
    # Rom "Постой, ты откуда звонишь?"
    voice "voice/romka/5day/66 Po.ogg"
    Rom "Пастой, ты адкуль тэлефануеш?"

# game/scripts/scene/scene_day_5.rpy:10990
translate belarusian event_m_polina_phone_roma_e1bc7822:

    # voice "voice/Anton/5day/93 Ne.ogg"
    # Ant "Ну от неё. От Полины..."
    voice "voice/Anton/5day/93 Ne.ogg"
    Ant "Ну ад яе. Ад Паліны..."

# game/scripts/scene/scene_day_5.rpy:10992
translate belarusian event_m_polina_phone_roma_f6340d50:

    # voice "voice/romka/5day/67 Ta.ogg"
    # Rom "Так, я не понял. А зачем ты к ней зашёл?"
    voice "voice/romka/5day/67 Ta.ogg"
    Rom "Так, я не зразумеў. А навошта ты да яе зайшоў?"

# game/scripts/scene/scene_day_5.rpy:10994
translate belarusian event_m_polina_phone_roma_e686250e:

    # voice "voice/romka/5day/68 Pog.ogg"
    # Rom "Погоди! Ты что..."
    voice "voice/romka/5day/68 Pog.ogg"
    Rom "Пачакай! Ты што..."

# game/scripts/scene/scene_day_5.rpy:10996
translate belarusian event_m_polina_phone_roma_407694d0:

    # voice "voice/romka/5day/69 Re.ogg"
    # Rom "Решил за тёлкой моей приударить?!"
    voice "voice/romka/5day/69 Re.ogg"
    Rom "Вырашыў за цёлкай маёй прыўдарыць?!"

# game/scripts/scene/scene_day_5.rpy:10998
translate belarusian event_m_polina_phone_roma_daeddc5c:

    # voice "voice/Anton/5day/94 T.ogg"
    # Ant "Ты чего, Ромка. Я же как друг..."
    voice "voice/Anton/5day/94 T.ogg"
    Ant "Ты чаго, Ромка. Я ж як сябар..."

# game/scripts/scene/scene_day_5.rpy:11000
translate belarusian event_m_polina_phone_roma_e1a57d3d:

    # voice "voice/romka/5day/70 D.ogg"
    # Rom "Друг? Тереться около чужой бабы — это, по-твоему, дружба?"
    voice "voice/romka/5day/70 D.ogg"
    Rom "Сябар? Церціся каля чужой бабы — гэта, па-твойму, сяброўства?"

# game/scripts/scene/scene_day_5.rpy:11002
translate belarusian event_m_polina_phone_roma_4670f3d0:

    # voice "voice/romka/5day/71 Lad.ogg"
    # Rom "Ладно, я щас приду."
    voice "voice/romka/5day/71 Lad.ogg"
    Rom "Добра, я зара прыйду."

# game/scripts/scene/scene_day_5.rpy:11004
translate belarusian event_m_polina_phone_roma_4a974562:

    # voice "voice/Anton/5day/95 Ne.ogg"
    # Ant "Необязательно."
    voice "voice/Anton/5day/95 Ne.ogg"
    Ant "Неабавязкова."

# game/scripts/scene/scene_day_5.rpy:11006
translate belarusian event_m_polina_phone_roma_40ee2b03:

    # voice "voice/romka/5day/72 Sha.ogg"
    # Rom "Ща мы побазарим."
    voice "voice/romka/5day/72 Sha.ogg"
    Rom "Зара мы пабазарым."

# game/scripts/scene/scene_day_5.rpy:11008
translate belarusian event_m_polina_phone_roma_9b36a777:

    # voice "voice/romka/5day/73 Ta.ogg"
    # Rom "Так побазарим, что ты больше никого провожать не сможешь!"
    voice "voice/romka/5day/73 Ta.ogg"
    Rom "Так пабазарым, што ты больш нікога праводзіць не зможаш!"

# game/scripts/scene/scene_day_5.rpy:11010
translate belarusian event_m_polina_phone_roma_58d7f661:

    # voice "voice/romka/5day/74 Ya.ogg"
    # Rom "Я вас на куски порежу. Слышишь?"
    voice "voice/romka/5day/74 Ya.ogg"
    Rom "Я вас на кавалкі парэжу. Чуеш?"

# game/scripts/scene/scene_day_5.rpy:11012
translate belarusian event_m_polina_phone_roma_55c5b5f5:

    # voice "voice/romka/5day/75 T.ogg"
    # Rom "Ты слышишь меня, гондон?!"
    voice "voice/romka/5day/75 T.ogg"
    Rom "Ты чуеш мяне, гандон?!"

# game/scripts/scene/scene_day_5.rpy:11014
translate belarusian event_m_polina_phone_roma_ba5a50da:

    # "Крик Ромы рвался из динамика."
    "Крык Ромы рваўся з дынаміка."

# game/scripts/scene/scene_day_5.rpy:11020
translate belarusian event_m_polina_phone_roma_82f1b679:

    # "Я бросил трубку на рычажки, испуганно уставившись на телефонный аппарат."
    "Я кінуў слухаўку на рычажкі, спалохана ўтаропіўшыся на тэлефонны апарат."

# game/scripts/scene/scene_day_5.rpy:11021
translate belarusian event_m_polina_phone_roma_171fab1b:

    # "Как я мог так облажаться? Звонил поддержать друга — и обрёл врага."
    "Як я мог так аблажацца? Тэлефанаваў падтрымаць сябра — і нажыў ворага."

# game/scripts/scene/scene_day_5.rpy:11022
translate belarusian event_m_polina_phone_roma_7c1ee7ee:

    # "Он ведь такой взрывной... он и правда может исполнить угрозу."
    "Ён жа такі запальчывы... ён і праўда можа выканаць пагрозу."

# game/scripts/scene/scene_day_5.rpy:11023
translate belarusian event_m_polina_phone_roma_5fe97f99:

    # "Что теперь будет? Страх замораживал изнутри."
    "Што цяпер будзе? Страх замарожваў знутры."

# game/scripts/scene/scene_day_5.rpy:11024
translate belarusian event_m_polina_phone_roma_2c1ec3f6:

    # "Зачем я отключился? Надо было объясниться."
    "Навошта я адключыўся? Трэба было растлумачыцца."

# game/scripts/scene/scene_day_5.rpy:11033
translate belarusian event_m_polina_phone_roma_1d1036d4:

    # "Интересно, чем занят сейчас Ромка? Не наделал бы он глупостей."
    "Цікава, чым заняты зараз Ромка? Не нарабіў бы ён глупстваў."

# game/scripts/scene/scene_day_5.rpy:11034
translate belarusian event_m_polina_phone_roma_27ca03f1:

    # "Что бы там между нами ни случилось, он заслуживает поддержки. Всё-таки он спас меня из логова маньяка."
    "Што б там паміж намі ні здарылася, ён заслугоўвае падтрымкі. Усё ж такі ён выратаваў мяне з логава маньяка."

# game/scripts/scene/scene_day_5.rpy:11038
translate belarusian event_m_polina_phone_roma_c3a4b1e9:

    # voice "voice/Anton/5day/96 Al.ogg"
    # Ant "Алло."
    voice "voice/Anton/5day/96 Al.ogg"
    Ant "Алё."

# game/scripts/scene/scene_day_5.rpy:11040
translate belarusian event_m_polina_phone_roma_312687c7:

    # voice "voice/romka/5day/59Dd.ogg"
    # Rom "Дружище! Ты где был?"
    voice "voice/romka/5day/59Dd.ogg"
    Rom "Сябрук! Ты дзе быў?"

# game/scripts/scene/scene_day_5.rpy:11042
translate belarusian event_m_polina_phone_roma_287c48bb:

    # "Слово «дружище», произнесённое Ромкой, окрылило меня. Я не раздумывая выпалил:"
    "Слова «сябрук», прамоўленае Ромкам, акрыліла мяне. Я не раздумваючы выпаліў:"

# game/scripts/scene/scene_day_5.rpy:11043
translate belarusian event_m_polina_phone_roma_32936609:

    # voice "voice/Anton/5day/97 ya.ogg"
    # Ant "Я... я у Полины..."
    voice "voice/Anton/5day/97 ya.ogg"
    Ant "Я... я ў Паліны..."

# game/scripts/scene/scene_day_5.rpy:11045
translate belarusian event_m_polina_phone_roma_20d6a780:

    # voice "voice/romka/5day/76 B.ogg"
    # Rom "Бляха, это ты..."
    voice "voice/romka/5day/76 B.ogg"
    Rom "Бляха, гэта ты..."

# game/scripts/scene/scene_day_5.rpy:11047
translate belarusian event_m_polina_phone_roma_e96573c5:

    # voice "voice/romka/5day/77 mn.ogg"
    # Rom "Мне показалось, Бяша звонит."
    voice "voice/romka/5day/77 mn.ogg"
    Rom "Мне падалося, Бяша тэлефануе."

# game/scripts/scene/scene_day_5.rpy:11049
translate belarusian event_m_polina_phone_roma_880e4b94:

    # voice "voice/romka/5day/78 ch.ogg"
    # Rom "Что ты там вякнул? У Полины?"
    voice "voice/romka/5day/78 ch.ogg"
    Rom "Што ты там вякнуў? У Паліны?"

# game/scripts/scene/scene_day_5.rpy:11051
translate belarusian event_m_polina_phone_roma_0d9220bc:

    # voice "voice/Anton/5day/98 Eto.ogg"
    # Ant "Это не то, что ты думаешь..."
    voice "voice/Anton/5day/98 Eto.ogg"
    Ant "Гэта не тое, што ты думаеш..."

# game/scripts/scene/scene_day_5.rpy:11053
translate belarusian event_m_polina_phone_roma_846b3fb1:

    # voice "voice/romka/5day/79 Ya.ogg"
    # Rom "Я понял."
    voice "voice/romka/5day/79 Ya.ogg"
    Rom "Я зразумеў."

# game/scripts/scene/scene_day_5.rpy:11055
translate belarusian event_m_polina_phone_roma_bbf4939d:

    # voice "voice/romka/5day/80 T.ogg"
    # Rom "Ты, козлина, решил, что я совсем раскис, и теперь всё можно?"
    voice "voice/romka/5day/80 T.ogg"
    Rom "Ты, казліна, вырашыў, што я зусім раскіс, і цяпер усё можна?"

# game/scripts/scene/scene_day_5.rpy:11057
translate belarusian event_m_polina_phone_roma_aaf57867:

    # voice "voice/romka/5day/81 Po.ogg"
    # Rom "Поиздеваться вздумал?"
    voice "voice/romka/5day/81 Po.ogg"
    Rom "Паздзекавацца надумаў?"

# game/scripts/scene/scene_day_5.rpy:11059
translate belarusian event_m_polina_phone_roma_58c47b58:

    # voice "voice/Anton/5day/99 Vs.ogg"
    # Ant "Всё не так!"
    voice "voice/Anton/5day/99 Vs.ogg"
    Ant "Усё не так!"

# game/scripts/scene/scene_day_5.rpy:11061
translate belarusian event_m_polina_phone_roma_32c5773e:

    # voice "voice/romka/5day/82 Z.ogg"
    # Rom "Запомни — ты покойник!"
    voice "voice/romka/5day/82 Z.ogg"
    Rom "Запомні — ты нябожчык!"

# game/scripts/scene/scene_day_5.rpy:11063
translate belarusian event_m_polina_phone_roma_1cd7e0d5:

    # voice "voice/romka/5day/83 H.ogg"
    # Rom "Ходи и оглядывайся. У меня глаза везде, понял?"
    voice "voice/romka/5day/83 H.ogg"
    Rom "Хадзі і азірайся. У мяне вочы паўсюль, зразумеў?"

# game/scripts/scene/scene_day_5.rpy:11065
translate belarusian event_m_polina_phone_roma_a9ce40f0:

    # voice "voice/romka/5day/84 p.ogg"
    # Rom "Прощайся с близкими. Посёлок маленький, бежать некуда."
    voice "voice/romka/5day/84 p.ogg"
    Rom "Развітвайся з блізкімі. Пасёлак маленькі, уцякаць няма куды."

# game/scripts/scene/scene_day_5.rpy:11067
translate belarusian event_m_polina_phone_roma_14acb68a:

    # voice "voice/romka/5day/85 y.ogg"
    # Rom "Я тебя достану."
    voice "voice/romka/5day/85 y.ogg"
    Rom "Я цябе дастану."

# game/scripts/scene/scene_day_5.rpy:11069
translate belarusian event_m_polina_phone_roma_0f68054f:

    # voice "voice/Anton/5day/100 Rom.ogg"
    # Ant "Ром, глупо..."
    voice "voice/Anton/5day/100 Rom.ogg"
    Ant "Ром, глупства..."

# game/scripts/scene/scene_day_5.rpy:11071
translate belarusian event_m_polina_phone_roma_1d55aa01:

    # voice "voice/romka/5day/86 o.ogg"
    # Rom "Она моя! Мне обещали! Они дали слово!"
    voice "voice/romka/5day/86 o.ogg"
    Rom "Яна мая! Мне абяцалі! Яны далі слова!"

# game/scripts/scene/scene_day_5.rpy:11073
translate belarusian event_m_polina_phone_roma_e00f35c3:

    # voice "voice/romka/5day/87 a.ogg"
    # Rom "А тебя я уничтожу!"
    voice "voice/romka/5day/87 a.ogg"
    Rom "А цябе я знішчу!"

# game/scripts/scene/scene_day_5.rpy:11075
translate belarusian event_m_polina_phone_roma_ac5eeda9:

    # voice "voice/romka/5day/88 s.ogg"
    # Rom "Сниму с тебя шкуру и стану спать в твоём мясе!!!"
    voice "voice/romka/5day/88 s.ogg"
    Rom "Здыму з цябе скуру і стану спаць у тваім мясе!!!"

# game/scripts/scene/scene_day_5.rpy:11077
translate belarusian event_m_polina_phone_roma_fbdb334b:

    # voice "voice/romka/5day/89 b.ogg"
    # Rom "Буду как собака барахтаться в твоих кишках..."
    voice "voice/romka/5day/89 b.ogg"
    Rom "Буду як сабака барахтацца ў тваіх кішках..."

# game/scripts/scene/scene_day_5.rpy:11079
translate belarusian event_m_polina_phone_roma_5368224e:

    # voice "voice/romka/5day/90 z.ogg"
    # Rom "Залитый твоей кр-р-ровью!"
    voice "voice/romka/5day/90 z.ogg"
    Rom "Заліты тваёй кр-р-роўю!"

# game/scripts/scene/scene_day_5.rpy:11081
translate belarusian event_m_polina_phone_roma_a1997acd:

    # voice "voice/romka/5day/91 K.ogg"
    # Rom "Красный! КР-Р-РАСНЫЙ!"
    voice "voice/romka/5day/91 K.ogg"
    Rom "Чырвоны! ЧЫР-Р-РВОНЫ!"

# game/scripts/scene/scene_day_5.rpy:11095
translate belarusian event_m_polina_phone_roma_61588cdc:

    # "Пальцы боязливо пробежали по кнопкам."
    "Пальцы баязліва прабеглі па кнопках."

# game/scripts/scene/scene_day_5.rpy:11099
translate belarusian event_m_polina_phone_roma_ff2d616a:

    # "Короткие гудки. Почему от них бросает в пот? Угрозы Ромки... он это серьёзно?"
    "Кароткія гудкі. Чаму ад іх кідае ў пот? Пагрозы Ромкі... ён гэта сур'ёзна?"

# game/scripts/scene/scene_day_5.rpy:11100
translate belarusian event_m_polina_phone_roma_a1b3b666:

    # "Мысль о ноже, который я часто видел у одноклассника, холодила кровь."
    "Думка пра нож, які я часта бачыў у аднакласніка, халадзіла кроў."

# game/scripts/scene/scene_day_5.rpy:11107
translate belarusian event_m_polina_phone_roma_cdc86a0e:

    # "Занято... Короткие гудки оставили меня наедине с тревожными мыслями."
    "Занята... Кароткія гудкі пакінулі мяне сам-насам з трывожнымі думкамі."

# game/scripts/scene/scene_day_5.rpy:11119
translate belarusian event_m_polina_phone_roma_d99caa58:

    # "Третья попытка. Вряд ли она к чему-нибудь приведёт, но..."
    "Трэцяя спроба. Наўрад ці яна да чаго-небудзь прывядзе, але..."

# game/scripts/scene/scene_day_5.rpy:11123
translate belarusian event_m_polina_phone_roma_523bcec1:

    # voice "voice/Wolf/116 P.ogg"
    # Wolf "Пр-р-ривет!"
    voice "voice/Wolf/116 P.ogg"
    Wolf "Пр-р-рывітанне!"

# game/scripts/scene/scene_day_5.rpy:11125
translate belarusian event_m_polina_phone_roma_03183d0c:

    # "Искажённый голос проник в ушной канал дуновением ледяного ветра."
    "Скажоны голас пранік у вушны канал подыхам ледзянога ветру."

# game/scripts/scene/scene_day_5.rpy:11126
translate belarusian event_m_polina_phone_roma_dbe2f3a3:

    # voice "voice/Wolf/117 dr.ogg"
    # Wolf "Др-р-ружок, а я ждал, что ты позвонишь."
    voice "voice/Wolf/117 dr.ogg"
    Wolf "Др-р-ружок, а я чакаў, што ты патэлефануеш."

# game/scripts/scene/scene_day_5.rpy:11128
translate belarusian event_m_polina_phone_roma_faba906a:

    # voice "voice/Wolf/118 D.ogg"
    # Wolf "Долго ждал, совсем загр-р-рустил..."
    voice "voice/Wolf/118 D.ogg"
    Wolf "Доўга чакаў, зусім зажур-р-рыўся..."

# game/scripts/scene/scene_day_5.rpy:11130
translate belarusian event_m_polina_phone_roma_af79599c:

    # "В трубке повисла тишина, прерываемая стонами вьюги. А потом обледеневшие провода принесли полушёпот."
    "У слухаўцы павісла цішыня, якую перапынялі стогны завірухі. А потым абледзянелыя правады прынеслі паўшэпт."

# game/scripts/scene/scene_day_5.rpy:11131
translate belarusian event_m_polina_phone_roma_18a58895:

    # voice "voice/Wolf/119 Raz.ogg"
    # Wolf "Раз, два, в поисках родства."
    voice "voice/Wolf/119 Raz.ogg"
    Wolf "Раз, два, шукаць радню пара."

# game/scripts/scene/scene_day_5.rpy:11133
translate belarusian event_m_polina_phone_roma_465d060d:

    # voice "voice/Wolf/120 Ya.ogg"
    # Wolf "Я зову во тьме тех, кто нужен мне."
    voice "voice/Wolf/120 Ya.ogg"
    Wolf "Я гукаю ў цьме тых, хто трэба мне."

# game/scripts/scene/scene_day_5.rpy:11135
translate belarusian event_m_polina_phone_roma_dccf3abc:

    # voice "voice/Wolf/121 P.ogg"
    # Wolf "Прячет кто внутри зверя, раз-два-три."
    voice "voice/Wolf/121 P.ogg"
    Wolf "Хто хавае ўнутры звера, раз-два-тры."

# game/scripts/scene/scene_day_5.rpy:11137
translate belarusian event_m_polina_phone_roma_6896c875:

    # voice "voice/Wolf/122 Na.ogg"
    # Wolf "На твою беду я тебя найду."
    voice "voice/Wolf/122 Na.ogg"
    Wolf "На тваю бяду я цябе знайду."

# game/scripts/scene/scene_day_5.rpy:11139
translate belarusian event_m_polina_phone_roma_c3d5b037:

    # voice "voice/Wolf/123 G.ogg"
    # Wolf "Где ты? Я иду."
    voice "voice/Wolf/123 G.ogg"
    Wolf "Дзе ты? Я іду."

# game/scripts/scene/scene_day_5.rpy:11141
translate belarusian event_m_polina_phone_roma_0cd243d5:

    # "Истерический хохот грянул из динамиков."
    "Істэрычны рогат грымнуў з дынамікаў."

# game/scripts/scene/scene_day_5.rpy:11145
translate belarusian event_m_polina_phone_roma_bc262924:

    # "Я выронил трубку, и она закачалась на проводе, ударяясь о стену и отбрасывая тень висельника, болтающегося в петле."
    "Я выпусціў слухаўку, і яна загайдалася на провадзе, удараючыся аб сцяну і адкідаючы цень вісельніка, што матляецца ў пятлі."

# game/scripts/scene/scene_day_5.rpy:11150
translate belarusian event_m_polina_phone_roma_707f320c:

    # "Не мог же я слышать всё это в реальности? Не иначе, мой мозг порождает слуховые галлюцинации..."
    "Не мог жа я чуць усё гэта ў рэальнасці? Не інакш, мой мозг спараджае слыхавыя галюцынацыі..."

# game/scripts/scene/scene_day_5.rpy:11162
translate belarusian event_m_polina_phone_matuhin_343b52ab:

    # "Я вспомнил Вовин телефон с мрачного объявления, навсегда оставшегося в моей памяти."
    "Я ўспомніў Воваў тэлефон са змрочнай аб'явы, якая назаўсёды засталася ў маёй памяці."

# game/scripts/scene/scene_day_5.rpy:11166
translate belarusian event_m_polina_phone_matuhin_847e661c:

    # "Захотелось узнать, не появились ли новости."
    "Захацелася даведацца, ці не з'явіліся навіны."

# game/scripts/scene/scene_day_5.rpy:11170
translate belarusian event_m_polina_phone_matuhin_e32e48fa:

    # voice "voice/episod/01 Sl.ogg" 
    # MatMom "Слушаю."
    voice "voice/episod/01 Sl.ogg" 
    MatMom "Слухаю."

# game/scripts/scene/scene_day_5.rpy:11172
translate belarusian event_m_polina_phone_matuhin_e69a8871:

    # voice "voice/Anton/5day/101 Zd.ogg"
    # Ant "Здравствуйте. Меня зовут Антон Петров."
    voice "voice/Anton/5day/101 Zd.ogg"
    Ant "Добры дзень. Мяне завуць Антон Пятроў."

# game/scripts/scene/scene_day_5.rpy:11174
translate belarusian event_m_polina_phone_matuhin_ff2d28aa:

    # voice "voice/Anton/5day/102 Ya.ogg"
    # Ant "Я насчёт Вовы..."
    voice "voice/Anton/5day/102 Ya.ogg"
    Ant "Я наконт Вовы..."

# game/scripts/scene/scene_day_5.rpy:11176
translate belarusian event_m_polina_phone_matuhin_df3ca398:

    # voice "voice/episod/02 An.ogg" 
    # MatMom "Антон? Господи, ты что-то знаешь о моём сыне?"
    voice "voice/episod/02 An.ogg" 
    MatMom "Антон? Госпадзі, ты нешта ведаеш пра майго сына?"

# game/scripts/scene/scene_day_5.rpy:11178
translate belarusian event_m_polina_phone_matuhin_260bcd59:

    # "Надежда в её голосе рвала мне сердце. Я сказал, накручивая провод на палец."
    "Надзея ў яе голасе рвала мне сэрца. Я сказаў, накручваючы провад на палец."

# game/scripts/scene/scene_day_5.rpy:11179
translate belarusian event_m_polina_phone_matuhin_ec8ca4b3:

    # voice "voice/Anton/5day/103 V.ogg"
    # Ant "В лесу я нашёл варежку."
    voice "voice/Anton/5day/103 V.ogg"
    Ant "У лесе я знайшоў рукавічку."

# game/scripts/scene/scene_day_5.rpy:11181
translate belarusian event_m_polina_phone_matuhin_9d777b00:

    # voice "voice/Anton/5day/104 Mo.ogg"
    # Ant "Может, она принадлежала Вове?"
    voice "voice/Anton/5day/104 Mo.ogg"
    Ant "Можа, яна належала Вову?"

# game/scripts/scene/scene_day_5.rpy:11183
translate belarusian event_m_polina_phone_matuhin_da4af47e:

    # voice "voice/Anton/5day/105 Po.ogg"
    # Ant "Понимаете, я помогаю следствию..."
    voice "voice/Anton/5day/105 Po.ogg"
    Ant "Разумееце, я дапамагаю следству..."

# game/scripts/scene/scene_day_5.rpy:11185
translate belarusian event_m_polina_phone_matuhin_d755ecd2:

    # voice "voice/Anton/5day/106 E.ogg"
    # Ant "... и любая информация может пригодиться."
    voice "voice/Anton/5day/106 E.ogg"
    Ant "... і любая інфармацыя можа спатрэбіцца."

# game/scripts/scene/scene_day_5.rpy:11187
translate belarusian event_m_polina_phone_matuhin_6ad14358:

    # voice "voice/episod/03 Sl.ogg" 
    # MatMom "Расследование? Мальчик, мне не до шуток."
    voice "voice/episod/03 Sl.ogg" 
    MatMom "Расследаванне? Хлопчык, мне не да жартаў."

# game/scripts/scene/scene_day_5.rpy:11189
translate belarusian event_m_polina_phone_matuhin_0f1c7327:

    # voice "voice/episod/04 U.ogg" 
    # MatMom "Ужасно издеваться над людьми, оказавшимися в такой ситуации!"
    voice "voice/episod/04 U.ogg" 
    MatMom "Жахліва здзекавацца з людзей, якія апынуліся ў такой сітуацыі!"

# game/scripts/scene/scene_day_5.rpy:11191
translate belarusian event_m_polina_phone_matuhin_f388c2a5:

    # voice "voice/episod/05 U.ogg" 
    # MatMom "У тебя вообще нет души!"
    voice "voice/episod/05 U.ogg" 
    MatMom "У цябе ўвогуле няма душы!"

# game/scripts/scene/scene_day_5.rpy:11196
translate belarusian event_m_polina_phone_matuhin_8e9c13ea:

    # "Я не успел оправдаться. Вовина Мама повесила трубку, оставив меня наедине с короткими гудками и сумерками, сгущающимися в прихожей."
    "Я не паспеў апраўдацца. Вовава Мама паклала слухаўку, пакінуўшы мяне сам-насам з кароткімі гудкамі і прыцемкамі, што згушчаліся ў пярэдняй."

# game/scripts/scene/scene_day_5.rpy:11204
translate belarusian event_m_polina_phone_matuhin_ec88718c:

    # "Номер был занят. Короткие гудки измывались над моей попыткой оправдаться."
    "Нумар быў заняты. Кароткія гудкі здзекаваліся з маёй спробы апраўдацца."

# game/scripts/scene/scene_day_5.rpy:11213
translate belarusian event_m_polina_phone_matuhin_14af7911:

    # "После нескольких гудков трубку сняли."
    "Пасля некалькіх гудкоў слухаўку знялі."

# game/scripts/scene/scene_day_5.rpy:11217
translate belarusian event_m_polina_phone_matuhin_2fa4c90c:

    # voice "voice/Anton/5day/107 A.ogg"
    # Ant "Алло, это опять я!"
    voice "voice/Anton/5day/107 A.ogg"
    Ant "Ало, гэта зноў я!"

# game/scripts/scene/scene_day_5.rpy:11219
translate belarusian event_m_polina_phone_matuhin_e48e2111:

    # voice "voice/Anton/5day/108 P.ogg"
    # Ant "Послушайте, я не обманул, я правда нашёл варежку..."
    voice "voice/Anton/5day/108 P.ogg"
    Ant "Паслухайце, я не падмануў, я праўда знайшоў рукавічку..."

# game/scripts/scene/scene_day_5.rpy:11221
translate belarusian event_m_polina_phone_matuhin_94ed5475:

    # voice "voice/episod/01 Vi.ogg"  
    # MatVova "Вы мне поможете?"
    voice "voice/episod/01 Vi.ogg"  
    MatVova "Вы мне дапаможаце?"

# game/scripts/scene/scene_day_5.rpy:11223
translate belarusian event_m_polina_phone_matuhin_a961b290:

    # "Меня будто ошпарило кипятком."
    "Мяне нібыта апарыла кіпнем."

# game/scripts/scene/scene_day_5.rpy:11224
translate belarusian event_m_polina_phone_matuhin_8837da85:

    # voice "voice/Anton/5day/109 V.ogg"
    # Ant "Вова?"
    voice "voice/Anton/5day/109 V.ogg"
    Ant "Вова?"

# game/scripts/scene/scene_day_5.rpy:11226
translate belarusian event_m_polina_phone_matuhin_50b4c7d5:

    # voice "voice/episod/03 Vi.ogg"  
    # MatVova "Вы отведёте меня к маме?"
    voice "voice/episod/03 Vi.ogg"  
    MatVova "Вы адведзяце мяне да мамы?"

# game/scripts/scene/scene_day_5.rpy:11228
translate belarusian event_m_polina_phone_matuhin_327f1acb:

    # voice "voice/Anton/5day/110 V.ogg"
    # Ant "Вова, послушай, ты дома."
    voice "voice/Anton/5day/110 V.ogg"
    Ant "Вова, паслухай, ты дома."

# game/scripts/scene/scene_day_5.rpy:11230
translate belarusian event_m_polina_phone_matuhin_18fc91f1:

    # voice "voice/Anton/5day/111 M.ogg"
    # Ant "Мама сейчас придёт, главное — никуда не уходи."
    voice "voice/Anton/5day/111 M.ogg"
    Ant "Мама зараз прыйдзе, галоўнае — нікуды не сыходзь."

# game/scripts/scene/scene_day_5.rpy:11232
translate belarusian event_m_polina_phone_matuhin_e4ac5d64:

    # voice "voice/episod/04 Vi.ogg"
    # MatVova "Это не мой дом. Это лес."
    voice "voice/episod/04 Vi.ogg"
    MatVova "Гэта не мой дом. Гэта лес."

# game/scripts/scene/scene_day_5.rpy:11234
translate belarusian event_m_polina_phone_matuhin_2003ad0a:

    # voice "voice/Anton/5day/112 l.ogg"
    # Ant "Лес?"
    voice "voice/Anton/5day/112 l.ogg"
    Ant "Лес?"

# game/scripts/scene/scene_day_5.rpy:11236
translate belarusian event_m_polina_phone_matuhin_a5f1bb06:

    # voice "voice/episod/05 Vi.ogg"  
    # MatVova "Послушай, как он скрипит."
    voice "voice/episod/05 Vi.ogg"  
    MatVova "Паслухай, як ён рыпіць."

# game/scripts/scene/scene_day_5.rpy:11238
translate belarusian event_m_polina_phone_matuhin_7cdf3d28:

    # voice "voice/episod/06 Vi.ogg"  
    # MatVova "И луна над лесом чёрная."
    voice "voice/episod/06 Vi.ogg"  
    MatVova "І месяц над лесам чорны."

# game/scripts/scene/scene_day_5.rpy:11240
translate belarusian event_m_polina_phone_matuhin_31c57f2e:

    # voice "voice/episod/07 Vi.ogg"
    # MatVova "Кто-то идёт в темноте."
    voice "voice/episod/07 Vi.ogg"
    MatVova "Нехта ідзе ў цемры."

# game/scripts/scene/scene_day_5.rpy:11242
translate belarusian event_m_polina_phone_matuhin_078bc6f4:

    # voice "voice/episod/08 Vi.ogg"  
    # MatVova "За деревьями из косточек."
    voice "voice/episod/08 Vi.ogg"  
    MatVova "За дрэвамі з костачак."

# game/scripts/scene/scene_day_5.rpy:11244
translate belarusian event_m_polina_phone_matuhin_b0f73cdb:

    # voice "voice/Anton/5day/113 A.ogg"
    # Ant "Алло!"
    voice "voice/Anton/5day/113 A.ogg"
    Ant "Ало!"

# game/scripts/scene/scene_day_5.rpy:11246
translate belarusian event_m_polina_phone_matuhin_41ee8d22:

    # voice "voice/episod/09 Vi.ogg" 
    # MatVova "Кто-то приближается."
    voice "voice/episod/09 Vi.ogg" 
    MatVova "Нехта набліжаецца."

# game/scripts/scene/scene_day_5.rpy:11248
translate belarusian event_m_polina_phone_matuhin_c51b7722:

    # voice "voice/episod/10 Vi.ogg"
    # MatVova "Он такой большой..."
    voice "voice/episod/10 Vi.ogg"
    MatVova "Ён такі вялікі..."

# game/scripts/scene/scene_day_5.rpy:11250
translate belarusian event_m_polina_phone_matuhin_a411ac90:

    # voice "voice/Anton/5day/114 A.ogg"
    # Ant "Алло, Вова!"
    voice "voice/Anton/5day/114 A.ogg"
    Ant "Ало, Вова!"

# game/scripts/scene/scene_day_5.rpy:11252
translate belarusian event_m_polina_phone_matuhin_9f8bf972:

    # voice "voice/episod/11 Vi.ogg"
    # MatVova "Такой голодный..."
    voice "voice/episod/11 Vi.ogg"
    MatVova "Такі галодны..."

# game/scripts/scene/scene_day_5.rpy:11257
translate belarusian event_m_polina_phone_matuhin_060860d4:

    # "Связь прервалась. С колотящимся сердцем я таращился на телефон. Какое-то недоразумение... безумие..."
    "Сувязь абарвалася. Сэрца калацілася, я вытарашчыўся на тэлефон. Нейкае непаразуменне... вар'яцтва..."

# game/scripts/scene/scene_day_5.rpy:11258
translate belarusian event_m_polina_phone_matuhin_3e4af103:

    # "Я не мог дозвониться в лесную чащу..."
    "Я не мог дазваніцца ў лясны гушчар..."

# game/scripts/scene/scene_day_5.rpy:11259
translate belarusian event_m_polina_phone_matuhin_2dd16482:

    # "Я схожу с ума..."
    "Я вар'яцею..."

# game/scripts/scene/scene_day_5.rpy:11260
translate belarusian event_m_polina_phone_matuhin_861da228:

    # "Это слуховые галлюцинации, мне всё померещилось..."
    "Гэта слыхавыя галюцынацыі, мне ўсё прымроілася..."

# game/scripts/scene/scene_day_5.rpy:11273
translate belarusian event_m_polina_phone_byash_ce9cdd8d:

    # "Завывание ветра за окнами навело меня на мысли о Бяше."
    "Завыванне ветру за вокнамі навяло мяне на думкі пра Бяшу."

# game/scripts/scene/scene_day_5.rpy:11274
translate belarusian event_m_polina_phone_byash_fadf31fa:

    # "Я так отчётливо представил его, сиротливо бродящего в темноте..."
    "Я так выразна ўявіў, як ён сіратліва блукае ў цемры..."

# game/scripts/scene/scene_day_5.rpy:11275
translate belarusian event_m_polina_phone_byash_2bb5762d:

    # "Может, он вернулся, пока я провожал Полину?"
    "Можа, ён вярнуўся, пакуль я праводзіў Паліну?"

# game/scripts/scene/scene_day_5.rpy:11276
translate belarusian event_m_polina_phone_byash_19658455:

    # "Нужно проверить."
    "Трэба праверыць."

# game/scripts/scene/scene_day_5.rpy:11280
translate belarusian event_m_polina_phone_byash_193903a6:

    # voice "voice/episod/Dulgar/00 al.ogg"
    # Dul "Алло, чего?"
    voice "voice/episod/Dulgar/00 al.ogg"
    Dul "Ало, чаго?"

# game/scripts/scene/scene_day_5.rpy:11282
translate belarusian event_m_polina_phone_byash_7410243c:

    # "Это Бяшин папа. Я замялся, вспоминая его имя."
    "Гэта Бяшаў тата. Я замяўся, прыгадваючы яго імя."

# game/scripts/scene/scene_day_5.rpy:11283
translate belarusian event_m_polina_phone_byash_5d326b33:

    # voice "voice/Anton/5day/115 D.ogg"
    # Ant "Добрый вечер, дядя..."
    voice "voice/Anton/5day/115 D.ogg"
    Ant "Добры вечар, дзядзька..."

# game/scripts/scene/scene_day_5.rpy:11285
translate belarusian event_m_polina_phone_byash_d3a57a2c:

    # "Я бросил взгляд на листовку с объявлением о пропаже Бяши: «В случае появления какой-либо информации связаться с Дулгаром»."
    "Я кінуў позірк на ўлётку з аб'явай пра знікненне Бяшы: «У выпадку з'яўлення якой-небудзь інфармацыі звязацца з Дулгарам»."

# game/scripts/scene/scene_day_5.rpy:11286
translate belarusian event_m_polina_phone_byash_6a04c96d:

    # voice "voice/Anton/5day/116 D.ogg"
    # Ant "... дядя Дулгар."
    voice "voice/Anton/5day/116 D.ogg"
    Ant "... дзядзька Дулгар."

# game/scripts/scene/scene_day_5.rpy:11288
translate belarusian event_m_polina_phone_byash_81574820:

    # voice "voice/episod/Dulgar/01 t.ogg"
    # Dul "Ты откуда звонишь, а? Слышишь, тебя весь посёлок ищет, да?"
    voice "voice/episod/Dulgar/01 t.ogg"
    Dul "Ты адкуль звоніш, а? Чуеш, цябе ўвесь пасёлак шукае, так?"

# game/scripts/scene/scene_day_5.rpy:11290
translate belarusian event_m_polina_phone_byash_88c77272:

    # voice "voice/episod/Dulgar/02 po.ogg"
    # Dul "Позор на мою седую голову!"
    voice "voice/episod/Dulgar/02 po.ogg"
    Dul "Ганьба на маю сівую галаву!"

# game/scripts/scene/scene_day_5.rpy:11292
translate belarusian event_m_polina_phone_byash_71e70253:

    # voice "voice/episod/Dulgar/03 e.ogg"
    # Dul "Из-за тебя, шакал, папка у ментов день просидел."
    voice "voice/episod/Dulgar/03 e.ogg"
    Dul "Праз цябе, шакал, татка ў мянтоў дзень праседзеў."

# game/scripts/scene/scene_day_5.rpy:11294
translate belarusian event_m_polina_phone_byash_3148d0da:

    # voice "voice/Anton/5day/117 Ya.ogg"
    # Ant "Я не..."
    voice "voice/Anton/5day/117 Ya.ogg"
    Ant "Я не..."

# game/scripts/scene/scene_day_5.rpy:11297
translate belarusian event_m_polina_phone_byash_b6ba5d75:

    # voice "voice/episod/Dulgar/04 ne.ogg"
    # Dul "Нэрэ бузарлалга! Иди домой, я тебе устрою нагоняй."
    voice "voice/episod/Dulgar/04 ne.ogg"
    Dul "Нэрэ бузарлалга! Ідзі дадому, я табе задам прачуханку."

# game/scripts/scene/scene_day_5.rpy:11299
translate belarusian event_m_polina_phone_byash_d209a371:

    # voice "voice/episod/Dulgar/05 s.ogg"
    # Dul "Совсем страх потерял, забыл вкус ремня?"
    voice "voice/episod/Dulgar/05 s.ogg"
    Dul "Зусім страх згубіў, забыў смак рамяня?"

# game/scripts/scene/scene_day_5.rpy:11301
translate belarusian event_m_polina_phone_byash_8a23d0d1:

    # voice "voice/episod/Dulgar/06 b.ogg"
    # Dul "Башку откручу, слышишь?"
    voice "voice/episod/Dulgar/06 b.ogg"
    Dul "Башку адкручу, чуеш?"

# game/scripts/scene/scene_day_5.rpy:11303
translate belarusian event_m_polina_phone_byash_c0d827f9:

    # voice "voice/Anton/5day/118 S.ogg"
    # Ant "Слышу..."
    voice "voice/Anton/5day/118 S.ogg"
    Ant "Чую..."

# game/scripts/scene/scene_day_5.rpy:11305
translate belarusian event_m_polina_phone_byash_0959c96e:

    # "Я сжал зубы, чувствуя себя в шкуре Бяши, одиноким и никому не нужным."
    "Я сціснуў зубы, адчуваючы сябе ў скуры Бяшы, самотным і нікому не патрэбным."

# game/scripts/scene/scene_day_5.rpy:11306
translate belarusian event_m_polina_phone_byash_49171e04:

    # voice "voice/Anton/5day/119 T.ogg"
    # Ant "Только это не..."
    voice "voice/Anton/5day/119 T.ogg"
    Ant "Толькі гэта не..."

# game/scripts/scene/scene_day_5.rpy:11308
translate belarusian event_m_polina_phone_byash_a6cdc83e:

    # voice "voice/episod/Dulgar/07 a.ogg"
    # Dul "А если не вернёшься..."
    voice "voice/episod/Dulgar/07 a.ogg"
    Dul "А калі не вернешся..."

# game/scripts/scene/scene_day_5.rpy:11310
translate belarusian event_m_polina_phone_byash_d1a2d2a6:

    # voice "voice/episod/Dulgar/08 h.ogg"
    # Dul "Хубуун... как я жить без тебя буду?"
    voice "voice/episod/Dulgar/08 h.ogg"
    Dul "Хубуун... як я жыць без цябе буду?"

# game/scripts/scene/scene_day_5.rpy:11312
translate belarusian event_m_polina_phone_byash_3a33fb15:

    # voice "voice/episod/Dulgar/09 s.ogg"
    # Dul "Сыночек, мне же приснилось, что я тебя хороню... своими руками."
    voice "voice/episod/Dulgar/09 s.ogg"
    Dul "Сыночак, мне ж прыснілася, што я цябе хаваю... сваімі рукамі."

# game/scripts/scene/scene_day_5.rpy:11314
translate belarusian event_m_polina_phone_byash_91637480:

    # voice "voice/episod/Dulgar/10 y.ogg"
    # Dul "Я уже терял семью. Когда твою мамку в... в больницу отправили."
    voice "voice/episod/Dulgar/10 y.ogg"
    Dul "Я ўжо губляў сям'ю. Калі тваю мамку ў... у бальніцу адправілі."

# game/scripts/scene/scene_day_5.rpy:11316
translate belarusian event_m_polina_phone_byash_0986d575:

    # voice "voice/episod/Dulgar/11 ya.ogg"
    # Dul "Я ж не кинул тебя одного, вернулся воспитывать..."
    voice "voice/episod/Dulgar/11 ya.ogg"
    Dul "Я ж не кінуў цябе аднаго, вярнуўся выхоўваць..."

# game/scripts/scene/scene_day_5.rpy:11318
translate belarusian event_m_polina_phone_byash_8b74e5e4:

    # voice "voice/episod/Dulgar/12 t.ogg"
    # Dul "Так и ты не бросай старика..."
    voice "voice/episod/Dulgar/12 t.ogg"
    Dul "Дык і ты не кідай старога..."

# game/scripts/scene/scene_day_5.rpy:11320
translate belarusian event_m_polina_phone_byash_893cfd92:

    # voice "voice/episod/Dulgar/13 s.ogg"
    # Dul "Слышишь, не бросай..."
    voice "voice/episod/Dulgar/13 s.ogg"
    Dul "Чуеш, не кідай..."

# game/scripts/scene/scene_day_5.rpy:11325
translate belarusian event_m_polina_phone_byash_38a029b6:

    # "Бормотания пьяного дяди Дулгара сделались совсем неразборчивыми. Я осторожно повесил трубку."
    "Мармытанне п'янага дзядзькі Дулгара зрабілася зусім неразборлівым. Я асцярожна паклаў слухаўку."

# game/scripts/scene/scene_day_5.rpy:11329
translate belarusian event_m_polina_phone_byash_bae116a1:

    # "Бедный, бедный Бяша..."
    "Бедны, бедны Бяша..."

# game/scripts/scene/scene_day_5.rpy:11330
translate belarusian event_m_polina_phone_byash_0198b6a6:

    # "Пьющий отец, мать, судя по всему, в психушке, и, наверное, весь посёлок об этом знает."
    "Бацька п'е, маці, мяркуючы па ўсім, у псіхушцы, і, напэўна, увесь пасёлак пра гэта ведае."

# game/scripts/scene/scene_day_5.rpy:11331
translate belarusian event_m_polina_phone_byash_a7917f37:

    # "Неудивительно, что раньше он уже сбегал из дома. Но не в этот раз."
    "Нядзіўна, што раней ён ужо ўцякаў з дому. Але не гэтым разам."

# game/scripts/scene/scene_day_5.rpy:11337
translate belarusian event_m_polina_phone_byash_4b1d2f77:

    # "Но почему я не спросил, как продвигаются поиски? Бяшин папа был в милиции, может, что узнал?"
    "Але чаму я не спытаў, як прасоўваюцца пошукі? Бяшаў тата быў у міліцыі, можа, што даведаўся?"

# game/scripts/scene/scene_day_5.rpy:11341
translate belarusian event_m_polina_phone_byash_ba2acd41:

    # "Я снова набрал пятизначный номер."
    "Я зноў набраў пяцізначны нумар."

# game/scripts/scene/scene_day_5.rpy:11346
translate belarusian event_m_polina_phone_byash_c697f6c9:

    # "Короткие гудки."
    "Кароткія гудкі."

# game/scripts/scene/scene_day_5.rpy:11347
translate belarusian event_m_polina_phone_byash_aa80ac6d:

    # "Дядя Дулгар, наверное, неправильно повесил трубку."
    "Дзядзька Дулгар, напэўна, няправільна паклаў слухаўку."

# game/scripts/scene/scene_day_5.rpy:11357
translate belarusian event_m_polina_phone_byash_c53c533c:

    # "Минуту я смотрел на «Панасоник», прежде чем попробовать в третий раз."
    "Хвіліну я глядзеў на «Панасонік», перш чым паспрабаваць трэці раз."

# game/scripts/scene/scene_day_5.rpy:11361
translate belarusian event_m_polina_phone_byash_3a291ce3:

    # voice "voice/Owl/24 Uh.ogg" 
    # Owl "Ух-ух-ух ты! Кто-то звонит."
    voice "voice/Owl/24 Uh.ogg" 
    Owl "Ух-ух-ух ты! Нехта звоніць."

# game/scripts/scene/scene_day_5.rpy:11363
translate belarusian event_m_polina_phone_byash_d4791fce:

    # voice "voice/Owl/25 Ya.ogg" 
    # Owl "Я напрягла слух-ух-ух."
    voice "voice/Owl/25 Ya.ogg" 
    Owl "Я напружыла слых-ух-ух."

# game/scripts/scene/scene_day_5.rpy:11365
translate belarusian event_m_polina_phone_byash_d95113c7:

    # voice "voice/Anton/5day/120 K.ogg"
    # Ant "Кто это?"
    voice "voice/Anton/5day/120 K.ogg"
    Ant "Хто гэта?"

# game/scripts/scene/scene_day_5.rpy:11367
translate belarusian event_m_polina_phone_byash_7cd8134b:

    # "Повисла пауза."
    "Павісла паўза."

# game/scripts/scene/scene_day_5.rpy:11368
translate belarusian event_m_polina_phone_byash_9a9052ac:

    # "Я уже собирался прервать звонок, но из глубин динамика донёсся замогильный голос."
    "Я ўжо збіраўся перапыніць званок, але з глыбінь дынаміка данёсся замагільны голас."

# game/scripts/scene/scene_day_5.rpy:11369
translate belarusian event_m_polina_phone_byash_083c107a:

    # voice "voice/Owl/26 Raz.ogg" 
    # Owl "Раз, два. Плоть давно мертва."
    voice "voice/Owl/26 Raz.ogg" 
    Owl "Раз, два. Плоць даўно не жыва."

# game/scripts/scene/scene_day_5.rpy:11371
translate belarusian event_m_polina_phone_byash_4e68f141:

    # voice "voice/Owl/27 Ti.ogg" 
    # Owl "Ты моя добыча, ты моя еда."
    voice "voice/Owl/27 Ti.ogg" 
    Owl "Ты мая здабыча, ты мая ежа."

# game/scripts/scene/scene_day_5.rpy:11373
translate belarusian event_m_polina_phone_byash_e216dd3f:

    # voice "voice/Owl/28 Vi.ogg" 
    # Owl "Выслежу-схвачу, в небо улечу."
    voice "voice/Owl/28 Vi.ogg" 
    Owl "Высачу-цапну, у неба шугану."

# game/scripts/scene/scene_day_5.rpy:11375
translate belarusian event_m_polina_phone_byash_9597e8af:

    # voice "voice/Owl/29 Tr.ogg" 
    # Owl "Три-четыре-сто! Не спасёт никто."
    voice "voice/Owl/29 Tr.ogg" 
    Owl "Тры-чатыры-сто! Не ўратуе ніхто."

# game/scripts/scene/scene_day_5.rpy:11383
translate belarusian event_m_polina_phone_byash_b23e46a8:

    # "Я подпрыгнул от ужаса и грохнул трубкой по аппарату, прерывая хохот злобной насмешницы."
    "Я падскочыў ад жаху і грукнуў слухаўкай па апараце, перарываючы рогат зласлівай насмешніцы."

# game/scripts/scene/scene_day_5.rpy:11384
translate belarusian event_m_polina_phone_byash_899d0922:

    # "Это всё не взаправду. У меня явно что-то с головой..."
    "Гэта ўсё не па-сапраўднаму. У мяне відавочна нешта з галавой..."

# game/scripts/scene/scene_day_5.rpy:11395
translate belarusian event_m_polina_phone_katya_c40fa729:

    # "Образ Кати, понуро стоящей у школьного крыльца, не выветривался из головы."
    "Вобраз Каці, якая панура стаяла каля школьнага ганка, не выветрываўся з галавы."

# game/scripts/scene/scene_day_5.rpy:11399
translate belarusian event_m_polina_phone_katya_b45e4c78:

    # "Я поколебался и набрал её номер."
    "Я павагаўся і набраў яе нумар."

# game/scripts/scene/scene_day_5.rpy:11400
translate belarusian event_m_polina_phone_katya_49ee3d0b:

    # "Катя словно ждала у телефона."
    "Каця нібыта чакала каля тэлефона."

# game/scripts/scene/scene_day_5.rpy:11404
translate belarusian event_m_polina_phone_katya_6e6f6982:

    # voice "voice/kate/5day/07 nu.ogg"
    # Kate "Ну и?.."
    voice "voice/kate/5day/07 nu.ogg"
    Kate "Ну і?.."

# game/scripts/scene/scene_day_5.rpy:11406
translate belarusian event_m_polina_phone_katya_dad60a7d:

    # voice "voice/Anton/5day/121 P.ogg"
    # Ant "Привет. Как ты себя чувствуешь?"
    voice "voice/Anton/5day/121 P.ogg"
    Ant "Прывітанне. Як ты пачуваешся?"

# game/scripts/scene/scene_day_5.rpy:11408
translate belarusian event_m_polina_phone_katya_4e0e856e:

    # voice "voice/kate/5day/08 te.ogg"
    # Kate "Тебе-то какое дело? Ты что у нас, мать Тереза?"
    voice "voice/kate/5day/08 te.ogg"
    Kate "Табе якая справа? Ты што ў нас, маці Тэрэза?"

# game/scripts/scene/scene_day_5.rpy:11410
translate belarusian event_m_polina_phone_katya_4165763c:

    # voice "voice/Anton/5day/122 M.ogg"
    # Ant "Мы с Полиной переживаем..."
    voice "voice/Anton/5day/122 M.ogg"
    Ant "Мы з Палінай перажываем..."

# game/scripts/scene/scene_day_5.rpy:11412
translate belarusian event_m_polina_phone_katya_0de41701:

    # voice "voice/kate/5day/09 ah.ogg"
    # Kate "Ах, с Полиной! Конечно, конечно!"
    voice "voice/kate/5day/09 ah.ogg"
    Kate "Ах, з Палінай! Вядома, вядома!"

# game/scripts/scene/scene_day_5.rpy:11414
translate belarusian event_m_polina_phone_katya_99f2e017:

    # voice "voice/kate/5day/10 ot.ogg"
    # Kate "От неё, значит, звонишь?"
    voice "voice/kate/5day/10 ot.ogg"
    Kate "Ад яе, значыць, звоніш?"

# game/scripts/scene/scene_day_5.rpy:11416
translate belarusian event_m_polina_phone_katya_82616d43:

    # voice "voice/kate/5day/11 A.ogg"
    # Kate "А она рядом стоит и в кулачок хихикает?"
    voice "voice/kate/5day/11 A.ogg"
    Kate "А яна побач стаіць і ў кулачок хіхікае?"

# game/scripts/scene/scene_day_5.rpy:11418
translate belarusian event_m_polina_phone_katya_5b8a2242:

    # voice "voice/Anton/5day/123 O.ogg"
    # Ant "Обязательно быть такой злюкой?"
    voice "voice/Anton/5day/123 O.ogg"
    Ant "Абавязкова быць такой злюкай?"

# game/scripts/scene/scene_day_5.rpy:11420
translate belarusian event_m_polina_phone_katya_ff79f8ed:

    # voice "voice/kate/5day/12 ya.ogg"
    # Kate "Я даже не начинала, дружочек."
    voice "voice/kate/5day/12 ya.ogg"
    Kate "Я нават не пачынала, сябручок."

# game/scripts/scene/scene_day_5.rpy:11422
translate belarusian event_m_polina_phone_katya_13fb4049:

    # voice "voice/kate/5day/13 no.ogg"
    # Kate "Но теперь тебя ждёт сладкая жизнь."
    voice "voice/kate/5day/13 no.ogg"
    Kate "Але цяпер цябе чакае салодкае жыццё."

# game/scripts/scene/scene_day_5.rpy:11424
translate belarusian event_m_polina_phone_katya_85015c33:

    # voice "voice/kate/5day/14 ya.ogg"
    # Kate "Я такого про тебя маме наговорю..."
    voice "voice/kate/5day/14 ya.ogg"
    Kate "Я такога пра цябе маме нагавару..."

# game/scripts/scene/scene_day_5.rpy:11426
translate belarusian event_m_polina_phone_katya_c1271265:

    # voice "voice/kate/5day/15 d.ogg"
    # Kate "Да-да-да! Вовек не отмоешься."
    voice "voice/kate/5day/15 d.ogg"
    Kate "Так-так-так! Павек не адмыешся."

# game/scripts/scene/scene_day_5.rpy:11428
translate belarusian event_m_polina_phone_katya_ed3f1873:

    # voice "voice/kate/5day/16 ch.ogg"
    # Kate "Чао какао!"
    voice "voice/kate/5day/16 ch.ogg"
    Kate "Чаа какаа!"

# game/scripts/scene/scene_day_5.rpy:11433
translate belarusian event_m_polina_phone_katya_65b39b78:

    # "В трубке запиликали короткие гудки."
    "У слухаўцы запілікалі кароткія гудкі."

# game/scripts/scene/scene_day_5.rpy:11434
translate belarusian event_m_polina_phone_katya_67009136:

    # "Они словно телеграфировали мне: Катя не поменялась."
    "Яны нібыта тэлеграфавалі мне: Каця не змянілася."

# game/scripts/scene/scene_day_5.rpy:11438
translate belarusian event_m_polina_phone_katya_b5f9794c:

    # "Прежняя заноза в заднице."
    "Ранейшая стрэмка ў задніцы."

# game/scripts/scene/scene_day_5.rpy:11444
translate belarusian event_m_polina_phone_katya_2f18160f:

    # "Занято. Интересно, кому она звонит? И какие небылицы обо мне рассказывает?"
    "Занята. Цікава, каму яна звоніць? І якія небыліцы пра мяне расказвае?"

# game/scripts/scene/scene_day_5.rpy:11453
translate belarusian event_m_polina_phone_katya_36a3f552:

    # "После третьего гудка в динамике раздался сиплый от рыданий голос Кати."
    "Пасля трэцяга гудка ў дынаміку пачуўся сіплы ад рыданняў голас Каці."

# game/scripts/scene/scene_day_5.rpy:11457
translate belarusian event_m_polina_phone_katya_32963254:

    # "Я стиснул пластмассу трубки."
    "Я сціснуў пластмасу слухаўкі."

# game/scripts/scene/scene_day_5.rpy:11458
translate belarusian event_m_polina_phone_katya_3b4a469c:

    # voice "voice/kate/5day/17 Ant.ogg"
    # Kate "Антоша, это ты?"
    voice "voice/kate/5day/17 Ant.ogg"
    Kate "Антоша, гэта ты?"

# game/scripts/scene/scene_day_5.rpy:11460
translate belarusian event_m_polina_phone_katya_816e870b:

    # voice "voice/kate/5day/18 sk.ogg"
    # Kate "Скорее сюда! Спаси меня, пожалуйста."
    voice "voice/kate/5day/18 sk.ogg"
    Kate "Хутчэй сюды! Выратуй мяне, калі ласка."

# game/scripts/scene/scene_day_5.rpy:11462
translate belarusian event_m_polina_phone_katya_4cb97242:

    # voice "voice/Anton/5day/124 Pro.ogg"
    # Ant "Что случилось?"
    voice "voice/Anton/5day/124 Pro.ogg"
    Ant "Што здарылася?"

# game/scripts/scene/scene_day_5.rpy:11464
translate belarusian event_m_polina_phone_katya_40c680c5:

    # voice "voice/kate/5day/19 ya.ogg"
    # Kate "Я не знаю... не знаю, где я..."
    voice "voice/kate/5day/19 ya.ogg"
    Kate "Я не ведаю... не ведаю, дзе я..."

# game/scripts/scene/scene_day_5.rpy:11466
translate belarusian event_m_polina_phone_katya_660e3724:

    # voice "voice/Anton/5day/125 Ka.ogg"
    # Ant "Как это — где? Я звоню тебе, значит, ты дома."
    voice "voice/Anton/5day/125 Ka.ogg"
    Ant "Як гэта — дзе? Я званю табе, значыць, ты дома."

# game/scripts/scene/scene_day_5.rpy:11468
translate belarusian event_m_polina_phone_katya_f5672ce4:

    # voice "voice/kate/5day/20 et.ogg"
    # Kate "Это не мой дом... здесь железные стены... вещи, накрытые чёрной тканью."
    voice "voice/kate/5day/20 et.ogg"
    Kate "Гэта не мой дом... тут жалезныя сцены... рэчы, накрытыя чорнай тканінай."

# game/scripts/scene/scene_day_5.rpy:11470
translate belarusian event_m_polina_phone_katya_af790144:

    # voice "voice/kate/5day/21 ya.ogg"
    # Kate "Я сняла тряпку с зеркала и не увидела своё отражение."
    voice "voice/kate/5day/21 ya.ogg"
    Kate "Я зняла анучу з люстэрка і не ўбачыла свайго адлюстравання."

# game/scripts/scene/scene_day_5.rpy:11472
translate belarusian event_m_polina_phone_katya_3f200aad:

    # voice "voice/kate/5day/22 v.ogg"
    # Kate "В зеркале кто-то ходит."
    voice "voice/kate/5day/22 v.ogg"
    Kate "У люстэрку нехта ходзіць."

# game/scripts/scene/scene_day_5.rpy:11474
translate belarusian event_m_polina_phone_katya_48d83064:

    # voice "voice/kate/5day/23 m.ogg"
    # Kate "Мне так страшно, Антоша!"
    voice "voice/kate/5day/23 m.ogg"
    Kate "Мне так страшна, Антоша!"

# game/scripts/scene/scene_day_5.rpy:11476
translate belarusian event_m_polina_phone_katya_efddc1bd:

    # "Я приоткрыл от изумления рот. Катя сошла с ума? У неё истерика? Или это очередной спектакль?"
    "Я прыадкрыў ад здзіўлення рот. Каця звар'яцела? У яе істэрыка? Ці гэта чарговы спектакль?"

# game/scripts/scene/scene_day_5.rpy:11477
translate belarusian event_m_polina_phone_katya_9a2b866f:

    # voice "voice/kate/5day/24 oni.ogg"
    # Kate "Они меня украли. Пытали, Антон! Мне было так больно!"
    voice "voice/kate/5day/24 oni.ogg"
    Kate "Яны мяне выкралі. Катавалі, Антон! Мне было так балюча!"

# game/scripts/scene/scene_day_5.rpy:11479
translate belarusian event_m_polina_phone_katya_bc27f513:

    # "В трубке заскрежетало, будто ожил какой-то ржавый механизм."
    "У слухаўцы заскрыгатала, быццам ажыў нейкі іржавы механізм."

# game/scripts/scene/scene_day_5.rpy:11480
translate belarusian event_m_polina_phone_katya_18b15e70:

    # "Голос Кати прерывался."
    "Голас Каці перарываўся."

# game/scripts/scene/scene_day_5.rpy:11481
translate belarusian event_m_polina_phone_katya_fef5b500:

    # voice "voice/Anton/5day/126 A.ogg"
    # Ant "Алло! Ты исчезаешь!"
    voice "voice/Anton/5day/126 A.ogg"
    Ant "Ало! Ты знікаеш!"

# game/scripts/scene/scene_day_5.rpy:11483
translate belarusian event_m_polina_phone_katya_9431c27e:

    # voice "voice/kate/5day/25 gd.ogg"
    # Kate "Где мои ноги?"
    voice "voice/kate/5day/25 gd.ogg"
    Kate "Дзе мае ногі?"

# game/scripts/scene/scene_day_5.rpy:11485
translate belarusian event_m_polina_phone_katya_d85b3a28:

    # voice "voice/kate/5day/26 ne.ogg"
    # Kate "Нет! Я не хочу исчезать! Пожа..."
    voice "voice/kate/5day/26 ne.ogg"
    Kate "Не! Я не хачу знікаць! Калі ла..."

# game/scripts/scene/scene_day_5.rpy:11490
translate belarusian event_m_polina_phone_katya_45b013c3:

    # "Какое-то время я слышал только скрежет и вой ветра. Потом короткие гудки."
    "Нейкі час я чуў толькі скрыгат і выццё ветру. Потым кароткія гудкі."

# game/scripts/scene/scene_day_5.rpy:11491
translate belarusian event_m_polina_phone_katya_f0c30f12:

    # "Катино болезненное воображение сыграло с ней злую шутку."
    "Каціна хваравітае ўяўленне згуляла з ёй злы жарт."

# game/scripts/scene/scene_day_5.rpy:11492
translate belarusian event_m_polina_phone_katya_a727f985:

    # "Со мной, кажется, тоже."
    "Са мной, здаецца, таксама."

# game/scripts/scene/scene_day_5.rpy:11505
translate belarusian event_m_polina_phone_polina_46bc5052:

    # "Занято."
    "Занята."

# game/scripts/scene/scene_day_5.rpy:11506
translate belarusian event_m_polina_phone_polina_059f3771:

    # "А чего ещё я ждал? Нельзя дозвониться на номер, с которого звонишь."
    "А чаго яшчэ я чакаў? Нельга дазваніцца на нумар, з якога звоніш."

# game/scripts/scene/scene_day_5.rpy:11512
translate belarusian event_m_polina_phone_polina_adfdc3c8:

    # voice "voice/Alisa/5day/01 K.ogg" 
    # Alis "Кто звонит в столь поздний час?"
    voice "voice/Alisa/5day/01 K.ogg" 
    Alis "Хто ж у позні звоніць час?"

# game/scripts/scene/scene_day_5.rpy:11514
translate belarusian event_m_polina_phone_polina_aff742fc:

    # voice "voice/Alisa/5day/02 Che.ogg" 
    # Alis "Чей я слышу грозный бас?"
    voice "voice/Alisa/5day/02 Che.ogg" 
    Alis "Чый я чую грозны бас?"

# game/scripts/scene/scene_day_5.rpy:11516
translate belarusian event_m_polina_phone_polina_dda75c92:

    # voice "voice/Anton/5day/08 eto.ogg"
    # Ant "Это я звоню... самому себе..."
    voice "voice/Anton/5day/08 eto.ogg"
    Ant "Гэта я званю... самому сабе..."

# game/scripts/scene/scene_day_5.rpy:11518
translate belarusian event_m_polina_phone_polina_ae0acb89:

    # voice "voice/Alisa/5day/03 Chto.ogg"
    # Alis "Что за грустная история!"
    voice "voice/Alisa/5day/03 Chto.ogg"
    Alis "Што за сумная гісторыя!"

# game/scripts/scene/scene_day_5.rpy:11520
translate belarusian event_m_polina_phone_polina_4e5a760c:

    # voice "voice/Alisa/5day/04 Tebe.ogg" 
    # Alis "Тебе, наверное, так одиноко, что ты закольцевал звонок."
    voice "voice/Alisa/5day/04 Tebe.ogg" 
    Alis "Табе, напэўна, так самотна, што ты закальцаваў званок."

# game/scripts/scene/scene_day_5.rpy:11522
translate belarusian event_m_polina_phone_polina_47ddf35f:

    # voice "voice/Alisa/5day/05 Ko.ogg" 
    # Alis "Колечко, колечко, попади в сердечко!"
    voice "voice/Alisa/5day/05 Ko.ogg" 
    Alis "Калечка, калечка, патрап у сардэчка!"

# game/scripts/scene/scene_day_5.rpy:11524
translate belarusian event_m_polina_phone_polina_9d838c17:

    # voice "voice/Alisa/5day/06 Ha.ogg" 
    # Alis "А-ха-ха-ха-ха!"
    voice "voice/Alisa/5day/06 Ha.ogg" 
    Alis "А-ха-ха-ха-ха!"

# game/scripts/scene/scene_day_5.rpy:11526
translate belarusian event_m_polina_phone_polina_629c8984:

    # voice "voice/Alisa/5day/07 El.ogg"
    # Alis "Или вот."
    voice "voice/Alisa/5day/07 El.ogg"
    Alis "Або вось."

# game/scripts/scene/scene_day_5.rpy:11528
translate belarusian event_m_polina_phone_polina_dd19bed0:

    # voice "voice/Alisa/5day/08 To.ogg"
    # Alis "Тоже очень хороший стишок."
    voice "voice/Alisa/5day/08 To.ogg"
    Alis "Таксама вельмі добры вершык."

# game/scripts/scene/scene_day_5.rpy:11530
translate belarusian event_m_polina_phone_polina_694f75a7:

    # voice "voice/Alisa/5day/09 Ra.ogg"
    # Alis "Раз, два — время колдовства!"
    voice "voice/Alisa/5day/09 Ra.ogg"
    Alis "Раз, два — прыйшла варажба!"

# game/scripts/scene/scene_day_5.rpy:11532
translate belarusian event_m_polina_phone_polina_019f8a52:

    # voice "voice/Alisa/5day/10 Go.ogg" 
    # Alis "Гостя поселю, разум ослеплю."
    voice "voice/Alisa/5day/10 Go.ogg" 
    Alis "Госця пасялю, розум асляплю."

# game/scripts/scene/scene_day_5.rpy:11534
translate belarusian event_m_polina_phone_polina_1c945f43:

    # voice "voice/Alisa/5day/11 Tr.ogg"
    # Alis "Три-четыре-пять, не узнаешь мать."
    voice "voice/Alisa/5day/11 Tr.ogg"
    Alis "Тры-чатыры-пяць, маці не пазнаць."

# game/scripts/scene/scene_day_5.rpy:11536
translate belarusian event_m_polina_phone_polina_9b19910e:

    # voice "voice/Alisa/5day/12 Sta.ogg" 
    # Alis "Станешь мне гнездом и умрёшь потом."
    voice "voice/Alisa/5day/12 Sta.ogg" 
    Alis "Станеш ты гняздом маім і памрэш затым."

# game/scripts/scene/scene_day_5.rpy:11539
translate belarusian event_m_polina_phone_polina_6e7699a9:

    # "Звонкий хохот казался кусками льда, бьющимися о своды моего черепа."
    "Звонкі рогат здаваўся кавалкамі лёду, што біліся аб скляпенні майго чэрапа."

# game/scripts/scene/scene_day_5.rpy:11546
translate belarusian event_m_polina_phone_polina_4b0caba3:

    # "Я стукнул кулаком по рычажкам телефонного аппарата и прислонился к стене, тяжело дыша."
    "Я стукнуў кулаком па рычажках тэлефоннага апарата і прыхінуўся да сцяны, цяжка дыхаючы."

# game/scripts/scene/scene_day_5.rpy:11547
translate belarusian event_m_polina_phone_polina_a9bd8ecc:

    # "Что со мной? Почему я слышу то, чего никак не может быть в действительности?"
    "Што са мной? Чаму я чую тое, чаго ніяк не можа быць у рэчаіснасці?"

# game/scripts/scene/scene_day_5.rpy:11562
translate belarusian event_m_polina_phone_ksenia_5248d4d5:

    # "Номер Сенечки в телефонном справочнике был залит кофе. Не прочесть последнюю цифру. Я набрал наугад."
    "Нумар Сенечкі ў тэлефонным даведніку быў заліты кавай. Не прачытаць апошнюю лічбу. Я набраў наўздагад."

# game/scripts/scene/scene_day_5.rpy:11566
translate belarusian event_m_polina_phone_ksenia_9bd7d99d:

    # voice "voice/episod/02 Na.ogg"
    # Noname "На проводе."
    voice "voice/episod/02 Na.ogg"
    Noname "На провадзе."

# game/scripts/scene/scene_day_5.rpy:11568
translate belarusian event_m_polina_phone_ksenia_66e71195:

    # voice "voice/Anton/5day/127 z.ogg"
    # Ant "Здравствуйте. Я звоню по поводу Ксюши..."
    voice "voice/Anton/5day/127 z.ogg"
    Ant "Добры дзень. Я званю наконт Ксюшы..."

# game/scripts/scene/scene_day_5.rpy:11570
translate belarusian event_m_polina_phone_ksenia_c044ea5a:

    # voice "voice/episod/03 Ne.ogg"
    # Noname "Нет, тут такие не живут."
    voice "voice/episod/03 Ne.ogg"
    Noname "Не, тут такія не жывуць."

# game/scripts/scene/scene_day_5.rpy:11572
translate belarusian event_m_polina_phone_ksenia_bee003a7:

    # voice "voice/Anton/5day/128 P.ogg"
    # Ant "Простите, ошибся номером."
    voice "voice/Anton/5day/128 P.ogg"
    Ant "Прабачце, памыліўся нумарам."

# game/scripts/scene/scene_day_5.rpy:11574
translate belarusian event_m_polina_phone_ksenia_2481c4c6:

    # voice "voice/episod/04 S.ogg"
    # Noname "Ну, скорее всего. У хозяев квартиры вроде не было детей."
    voice "voice/episod/04 S.ogg"
    Noname "Ну, хутчэй за ўсё. У гаспадароў кватэры нібыта не было дзяцей."

# game/scripts/scene/scene_day_5.rpy:11576
translate belarusian event_m_polina_phone_ksenia_0efc0620:

    # voice "voice/Anton/5day/129 t.ogg"
    # Ant "Талалаевы?"
    voice "voice/Anton/5day/129 t.ogg"
    Ant "Талалаевы?"

# game/scripts/scene/scene_day_5.rpy:11578
translate belarusian event_m_polina_phone_ksenia_1c085188:

    # voice "voice/episod/05 Nu.ogg" 
    # Noname "Ну да."
    voice "voice/episod/05 Nu.ogg" 
    Noname "Ну так."

# game/scripts/scene/scene_day_5.rpy:11580
translate belarusian event_m_polina_phone_ksenia_0685c50a:

    # voice "voice/Anton/5day/130 A.ogg"
    # Ant "А они не дома?"
    voice "voice/Anton/5day/130 A.ogg"
    Ant "А яны не дома?"

# game/scripts/scene/scene_day_5.rpy:11582
translate belarusian event_m_polina_phone_ksenia_fb49c48c:

    # voice "voice/episod/06 n.ogg" 
    # Noname "Нет. Сдали квартиру и переехали."
    voice "voice/episod/06 n.ogg" 
    Noname "Не. Здалі кватэру і пераехалі."

# game/scripts/scene/scene_day_5.rpy:11584
translate belarusian event_m_polina_phone_ksenia_e4c1249e:

    # voice "voice/Anton/5day/131 E.ogg"
    # Ant "Ещё раз простите. До свидания."
    voice "voice/Anton/5day/131 E.ogg"
    Ant "Яшчэ раз прабачце. Да пабачэння."

# game/scripts/scene/scene_day_5.rpy:11586
translate belarusian event_m_polina_phone_ksenia_4f9da0d1:

    # voice "voice/episod/07 b.ogg" 
    # Noname "Бывай."
    voice "voice/episod/07 b.ogg" 
    Noname "Бывай."

# game/scripts/scene/scene_day_5.rpy:11594
translate belarusian event_m_polina_phone_ksenia_97c48f84:

    # "Я повесил трубку, размышляя, куда отправились потерявшие всякую надежду люди, чья дочь исчезла без следа."
    "Я паклаў слухаўку, разважаючы, куды падаліся людзі, што страцілі ўсялякую надзею, чыя дачка знікла без следу."

# game/scripts/scene/scene_day_5.rpy:11600
translate belarusian event_m_polina_phone_ksenia_e274ebbe:

    # "Если тот человек — квартирант, то, может, он знает, как связаться с арендодателями. Он же платит за квартиру."
    "Калі той чалавек — кватарант, то, можа, ён ведае, як звязацца з арэндадаўцамі. Ён жа плаціць за кватэру."

# game/scripts/scene/scene_day_5.rpy:11604
translate belarusian event_m_polina_phone_ksenia_01ea1729:

    # "Я набрал тот же номер. Занято. Человек кому-то звонил."
    "Я набраў той самы нумар. Занята. Чалавек камусьці званіў."

# game/scripts/scene/scene_day_5.rpy:11610
translate belarusian event_m_polina_phone_ksenia_bc171fbb:

    # voice "voice/episod/12 Al.ogg"
    # Ksenia "Алло! Алло, мамочка, это ты?"
    voice "voice/episod/12 Al.ogg"
    Ksenia "Ало! Ало, мамачка, гэта ты?"

# game/scripts/scene/scene_day_5.rpy:11612
translate belarusian event_m_polina_phone_ksenia_6c798ae3:

    # voice "voice/Anton/5day/132 Se.ogg"
    # Ant "Сеня?"
    voice "voice/Anton/5day/132 Se.ogg"
    Ant "Сеня?"

# game/scripts/scene/scene_day_5.rpy:11614
translate belarusian event_m_polina_phone_ksenia_4f59664f:

    # voice "voice/episod/13 D.ogg" 
    # Ksenia "Дяденька, заберите меня! Вы из милиции?"
    voice "voice/episod/13 D.ogg" 
    Ksenia "Дзядзечка, забярыце мяне! Вы з міліцыі?"

# game/scripts/scene/scene_day_5.rpy:11616
translate belarusian event_m_polina_phone_ksenia_d2e78f77:

    # voice "voice/Anton/5day/133 Ne.ogg"
    # Ant "Нет..."
    voice "voice/Anton/5day/133 Ne.ogg"
    Ant "Не..."

# game/scripts/scene/scene_day_5.rpy:11618
translate belarusian event_m_polina_phone_ksenia_37c8bf80:

    # voice "voice/Anton/5day/134 P.ogg"
    # Ant "Постой, ты где? Сеня, тебя весь посёлок ищет."
    voice "voice/Anton/5day/134 P.ogg"
    Ant "Пачакай, ты дзе? Сеня, цябе ўвесь пасёлак шукае."

# game/scripts/scene/scene_day_5.rpy:11620
translate belarusian event_m_polina_phone_ksenia_ca095975:

    # voice "voice/episod/14 E.ogg" 
    # Ksenia "Ищут... они меня ищут..."
    voice "voice/episod/14 E.ogg" 
    Ksenia "Шукаюць... яны мяне шукаюць..."

# game/scripts/scene/scene_day_5.rpy:11622
translate belarusian event_m_polina_phone_ksenia_40a92ceb:

    # voice "voice/episod/15 t.ogg" 
    # Ksenia "Тёмные люди..."
    voice "voice/episod/15 t.ogg" 
    Ksenia "Цёмныя людзі..."

# game/scripts/scene/scene_day_5.rpy:11624
translate belarusian event_m_polina_phone_ksenia_bf09e385:

    # voice "voice/episod/16 ch.ogg" 
    # Ksenia "Чёрные звери..."
    voice "voice/episod/16 ch.ogg" 
    Ksenia "Чорныя звяры..."

# game/scripts/scene/scene_day_5.rpy:11626
translate belarusian event_m_polina_phone_ksenia_a5210b0b:

    # voice "voice/episod/17 v.ogg" 
    # Ksenia "Вы не дадите им меня съесть?"
    voice "voice/episod/17 v.ogg" 
    Ksenia "Вы не дасце ім мяне з'есці?"

# game/scripts/scene/scene_day_5.rpy:11628
translate belarusian event_m_polina_phone_ksenia_4cbad751:

    # voice "voice/episod/18 Z.ogg"
    # Ksenia "Здесь так плохо. Всё липкое и старое. Непонятно, где пол, а где потолок."
    voice "voice/episod/18 Z.ogg"
    Ksenia "Тут так дрэнна. Усё ліпкае і старое. Незразумела, дзе падлога, а дзе столь."

# game/scripts/scene/scene_day_5.rpy:11630
translate belarusian event_m_polina_phone_ksenia_8a3d5ff5:

    # voice "voice/Anton/5day/135 A.ogg"
    # Ant "Алло... ты прерываешься..."
    voice "voice/Anton/5day/135 A.ogg"
    Ant "Ало... ты перарываешся..."

# game/scripts/scene/scene_day_5.rpy:11632
translate belarusian event_m_polina_phone_ksenia_2a7c701e:

    # voice "voice/episod/19 ne.ogg" 
    # Ksenia "Не дайте холодным зверям съесть меня!!!"
    voice "voice/episod/19 ne.ogg" 
    Ksenia "Не дайце халодным звярам з'есці мяне!!!"

# game/scripts/scene/scene_day_5.rpy:11634
translate belarusian event_m_polina_phone_ksenia_4c9f5425:

    # voice "voice/episod/20 on.ogg" 
    # Ksenia "Они хотят со мной играться."
    voice "voice/episod/20 on.ogg" 
    Ksenia "Яны хочуць са мной гуляцца."

# game/scripts/scene/scene_day_5.rpy:11636
translate belarusian event_m_polina_phone_ksenia_5bab290b:

    # voice "voice/episod/21 on.ogg" 
    # Ksenia "Они меня кормят."
    voice "voice/episod/21 on.ogg" 
    Ksenia "Яны мяне кормяць."

# game/scripts/scene/scene_day_5.rpy:11638
translate belarusian event_m_polina_phone_ksenia_f302b29c:

    # voice "voice/episod/22 za.ogg" 
    # Ksenia "Заставляют кушать плохие вещи!"
    voice "voice/episod/22 za.ogg" 
    Ksenia "Прымушаюць есці дрэнныя рэчы!"

# game/scripts/scene/scene_day_5.rpy:11640
translate belarusian event_m_polina_phone_ksenia_fa2acfe3:

    # voice "voice/episod/23 gde.ogg" 
    # Ksenia "Где тут выход???"
    voice "voice/episod/23 gde.ogg" 
    Ksenia "Дзе тут выхад???"

# game/scripts/scene/scene_day_5.rpy:11645
translate belarusian event_m_polina_phone_ksenia_027b7971:

    # "Звонок прервался."
    "Званок абарваўся."

# game/scripts/scene/scene_day_5.rpy:11646
translate belarusian event_m_polina_phone_ksenia_864f33ed:

    # "Бред... если бы Сеня действительно вернулась домой, тот человек, квартиросъёмщик, уже вызвал бы милицию..."
    "Трызненне... калі б Сеня сапраўды вярнулася дадому, той чалавек, кватэраздымшчык, ужо выклікаў бы міліцыю..."

# game/scripts/scene/scene_day_5.rpy:11647
translate belarusian event_m_polina_phone_ksenia_aa3327e2:

    # "Это всё моё воображение. Не было никакой девочки, взывающей о помощи..."
    "Гэта ўсё маё ўяўленне. Не было ніякай дзяўчынкі, якая клікала на дапамогу..."

# game/scripts/scene/scene_day_5.rpy:11648
translate belarusian event_m_polina_phone_ksenia_12681e5c:

    # "Голоса, несущегося по проводам вдоль древнего леса..."
    "Голасу, які нёсся па правадах уздоўж спрадвечнага лесу..."

# game/scripts/scene/scene_day_5.rpy:11658
translate belarusian event_m_polina_phone_semen_f3a468b8:

    # "Я рассеянно полистал справочник, лежащий возле телефонного аппарата."
    "Я рассеяна пагартаў даведнік, які ляжаў каля тэлефоннага апарата."

# game/scripts/scene/scene_day_5.rpy:11659
translate belarusian event_m_polina_phone_semen_9c058b2b:

    # "Издание девяносто третьего года."
    "Выданне дзевяноста трэцяга года."

# game/scripts/scene/scene_day_5.rpy:11660
translate belarusian event_m_polina_phone_semen_3351eba1:

    # "Сколько абонентов из списка живы, а сколько больше не ответят на звонки?"
    "Колькі абанентаў са спіса жывыя, а колькі больш не адкажуць на званкі?"

# game/scripts/scene/scene_day_5.rpy:11661
translate belarusian event_m_polina_phone_semen_b752bd70:

    # "Мёртвые..."
    "Мёртвыя..."

# game/scripts/scene/scene_day_5.rpy:11662
translate belarusian event_m_polina_phone_semen_4cca76fd:

    # "Или пропавшие без вести..."
    "Ці зніклыя без вестак..."

# game/scripts/scene/scene_day_5.rpy:11663
translate belarusian event_m_polina_phone_semen_1492649d:

    # "Как Семён."
    "Як Сямён."

# game/scripts/scene/scene_day_5.rpy:11664
translate belarusian event_m_polina_phone_semen_300ce4f8:

    # "Я уставился на фамилию одноклассника. Бабурин."
    "Я ўтаропіўся ў прозвішча аднакласніка. Бабурын."

# game/scripts/scene/scene_day_5.rpy:11668
translate belarusian event_m_polina_phone_semen_b3d12538:

    # "Рука сама потянулась к кнопкам, трубка прижалась к уху."
    "Рука сама пацягнулася да кнопак, слухаўка прыціснулася да вуха."

# game/scripts/scene/scene_day_5.rpy:11669
translate belarusian event_m_polina_phone_semen_445433e4:

    # "Не жду же я впрямь, что Семён ответит?"
    "Не чакаю ж я насамрэч, што Сямён адкажа?"

# game/scripts/scene/scene_day_5.rpy:11673
translate belarusian event_m_polina_phone_semen_64003262:

    # voice "voice/episod/01 n.ogg"
    # Gran "На проводе. Кто это?"
    voice "voice/episod/01 n.ogg"
    Gran "На провадзе. Хто гэта?"

# game/scripts/scene/scene_day_5.rpy:11675
translate belarusian event_m_polina_phone_semen_f92bfe7c:

    # voice "voice/Anton/5day/136 A.ogg"
    # Ant "Антон... Петров, одноклассник Сёмы."
    voice "voice/Anton/5day/136 A.ogg"
    Ant "Антон... Пятроў, аднакласнік Сёмы."

# game/scripts/scene/scene_day_5.rpy:11677
translate belarusian event_m_polina_phone_semen_33961477:

    # voice "voice/episod/02 pe.ogg"
    # Gran "Петров? Конечно..."
    voice "voice/episod/02 pe.ogg"
    Gran "Пятроў? Вядома..."

# game/scripts/scene/scene_day_5.rpy:11679
translate belarusian event_m_polina_phone_semen_b138ffa3:

    # voice "voice/episod/03 ti.ogg"
    # Gran "Ты не видел моего внучка, Петров?"
    voice "voice/episod/03 ti.ogg"
    Gran "Ты не бачыў майго ўнучка, Пятроў?"

# game/scripts/scene/scene_day_5.rpy:11681
translate belarusian event_m_polina_phone_semen_bd6139d2:

    # voice "voice/Anton/5day/137 N.ogg"
    # Ant "Нет. Но к нам в школу приходил милиционер..."
    voice "voice/Anton/5day/137 N.ogg"
    Ant "Не. Але да нас у школу прыходзіў міліцыянер..."

# game/scripts/scene/scene_day_5.rpy:11683
translate belarusian event_m_polina_phone_semen_0ce974e4:

    # voice "voice/episod/04 v.ogg"
    # Gran "Всё бесполезно..."
    voice "voice/episod/04 v.ogg"
    Gran "Усё марна..."

# game/scripts/scene/scene_day_5.rpy:11685
translate belarusian event_m_polina_phone_semen_584bc0e2:

    # voice "voice/episod/05 y.ogg"
    # Gran "Я жду его, жду... Все глаза выплакала."
    voice "voice/episod/05 y.ogg"
    Gran "Я чакаю яго, чакаю... Усе вочы выплакала."

# game/scripts/scene/scene_day_5.rpy:11687
translate belarusian event_m_polina_phone_semen_780b210a:

    # voice "voice/episod/06 b.ogg"
    # Gran "Боженька, за что ты так со мной?"
    voice "voice/episod/06 b.ogg"
    Gran "Божачка, за што ты так са мной?"

# game/scripts/scene/scene_day_5.rpy:11689
translate belarusian event_m_polina_phone_semen_86aa1b61:

    # "Плач пожилой женщины рвал сердце."
    "Плач пажылой жанчыны рваў сэрца."

# game/scripts/scene/scene_day_5.rpy:11690
translate belarusian event_m_polina_phone_semen_75de9e51:

    # voice "voice/Anton/5day/138 Ne.ogg"
    # Ant "Не надо. Не терзайте себя."
    voice "voice/Anton/5day/138 Ne.ogg"
    Ant "Не трэба. Не мучце сябе."

# game/scripts/scene/scene_day_5.rpy:11692
translate belarusian event_m_polina_phone_semen_3d096dce:

    # voice "voice/episod/07 V.ogg"
    # Gran "В гроб лягу, его не увидев."
    voice "voice/episod/07 V.ogg"
    Gran "У труну лягу, яго не ўбачыўшы."

# game/scripts/scene/scene_day_5.rpy:11694
translate belarusian event_m_polina_phone_semen_510cd882:

    # voice "voice/episod/08 ne.ogg"
    # Gran "Не сберегла... сама виновата во всём, сама!"
    voice "voice/episod/08 ne.ogg"
    Gran "Не зберагла... сама вінаватая ва ўсім, сама!"

# game/scripts/scene/scene_day_5.rpy:11696
translate belarusian event_m_polina_phone_semen_264d602f:

    # "Она почти кричала."
    "Яна амаль крычала."

# game/scripts/scene/scene_day_5.rpy:11703
translate belarusian event_m_polina_phone_semen_2b515efe:

    # "Я механически надавил на рычажки телефонного аппарата, перебивая причитания женщины ровным, как пульс покойника, гудком."
    "Я механічна націснуў на рычажкі тэлефоннага апарата, перабіваючы галашэнні жанчыны роўным, як пульс нябожчыка, гудком."

# game/scripts/scene/scene_day_5.rpy:11709
translate belarusian event_m_polina_phone_semen_6b2a84be:

    # "Что я за человек? Надо было успокоить бабушку Семёна. Подобрать правильные слова."
    "Што я за чалавек? Трэба было супакоіць бабулю Сямёна. Падабраць правільныя словы."

# game/scripts/scene/scene_day_5.rpy:11713
translate belarusian event_m_polina_phone_semen_65d24e1d:

    # "Короткие гудки звучали, как всхлипы отчаяния. Занято."
    "Кароткія гудкі гучалі, як усхліпы роспачы. Занята."

# game/scripts/scene/scene_day_5.rpy:11722
translate belarusian event_m_polina_phone_semen_d86ba3bf:

    # "Я в третий раз набрал номер из телефонного справочника."
    "Я трэці раз набраў нумар з тэлефоннага даведніка."

# game/scripts/scene/scene_day_5.rpy:11726
translate belarusian event_m_polina_phone_semen_46d8bb26:

    # voice "voice/Bear/5day/01Kt.ogg"
    # Bear "Кто звонит в мою берлогу?"
    voice "voice/Bear/5day/01Kt.ogg"
    Bear "Хто звоніць у маю бярлогу?"

# game/scripts/scene/scene_day_5.rpy:11728
translate belarusian event_m_polina_phone_semen_7ec5f9c6:

    # voice "voice/Bear/5day/02 ne.ogg"
    # Bear "Не стыдно вам? Сейчас зима..."
    voice "voice/Bear/5day/02 ne.ogg"
    Bear "Не сорамна вам? Зараз зіма..."

# game/scripts/scene/scene_day_5.rpy:11730
translate belarusian event_m_polina_phone_semen_dc174bc3:

    # voice "voice/Bear/5day/03 na.ogg"
    # Bear "Надо спать, а вы меня из постели вытянули."
    voice "voice/Bear/5day/03 na.ogg"
    Bear "Трэба спаць, а вы мяне з пасцелі выцягнулі."

# game/scripts/scene/scene_day_5.rpy:11732
translate belarusian event_m_polina_phone_semen_10d92b6f:

    # "Я замер от ужаса, не веря собственным ушам."
    "Я замёр ад жаху, не верачы ўласным вушам."

# game/scripts/scene/scene_day_5.rpy:11733
translate belarusian event_m_polina_phone_semen_b0992e9a:

    # voice "voice/Bear/5day/04 zvo.ogg"
    # Bear "Звонят... молчат..."
    voice "voice/Bear/5day/04 zvo.ogg"
    Bear "Звоняць... маўчаць..."

# game/scripts/scene/scene_day_5.rpy:11735
translate belarusian event_m_polina_phone_semen_2bee2bfa:

    # voice "voice/Anton/5day/139 K.ogg"
    # Ant "Кто говорит?"
    voice "voice/Anton/5day/139 K.ogg"
    Ant "Хто гаворыць?"

# game/scripts/scene/scene_day_5.rpy:11737
translate belarusian event_m_polina_phone_semen_1fbf06ee:

    # voice "voice/Bear/5day/05 Raz.ogg"
    # Bear "Раз, два, три, четыре, пять."
    voice "voice/Bear/5day/05 Raz.ogg"
    Bear "Раз, два, тры, чатыры, пяць."

# game/scripts/scene/scene_day_5.rpy:11739
translate belarusian event_m_polina_phone_semen_7b3a23b3:

    # voice "voice/Bear/5day/06 mir.ogg"
    # Bear "Мир на части буду драть."
    voice "voice/Bear/5day/06 mir.ogg"
    Bear "Свет на часткі буду драць."

# game/scripts/scene/scene_day_5.rpy:11741
translate belarusian event_m_polina_phone_semen_3cb8db7b:

    # voice "voice/Bear/5day/07 sk.ogg"
    # Bear "Сквозь дыру домой уйду,"
    voice "voice/Bear/5day/07 sk.ogg"
    Bear "Скрозь дзірку я дамоў знікаю,"

# game/scripts/scene/scene_day_5.rpy:11743
translate belarusian event_m_polina_phone_semen_2235b76f:

    # voice "voice/Bear/5day/08 bu.ogg"
    # Bear "Буду ждать тебя в аду!"
    voice "voice/Bear/5day/08 bu.ogg"
    Bear "Цябе я ў пекле пачакаю!"

# game/scripts/scene/scene_day_5.rpy:11748
translate belarusian event_m_polina_phone_semen_e200c7c4:

    # "Трубка выпала из моей руки. Телефонный аппарат двоился в глазах, и пол, казалось, ходил ходуном."
    "Слухаўка выпала з маёй рукі. Тэлефонны апарат дваіўся ў вачах, і падлога, здавалася, хадзіла хадуном."

# game/scripts/scene/scene_day_5.rpy:11749
translate belarusian event_m_polina_phone_semen_2cff97e7:

    # "Что со мной творится? Почему я слышу то, чего нет и никак не может быть?"
    "Што са мной робіцца? Чаму я чую тое, чаго няма і ніяк не можа быць?"

# game/scripts/scene/scene_day_5.rpy:11750
translate belarusian event_m_polina_phone_semen_85f2ed9e:

    # "Похоже, у меня едет крыша..."
    "Падобна, у мяне едзе дах..."

# game/scripts/scene/scene_day_5.rpy:11769
translate belarusian event_m_polina_phone_tikhonov_36602668:

    # "Тревожные раздумья об Оле навели меня на совсем другую, удивительно прагматичную мысль."
    "Трывожныя роздумы пра Олю навялі мяне на зусім іншую, на дзіва прагматычную думку."

# game/scripts/scene/scene_day_5.rpy:11770
translate belarusian event_m_polina_phone_tikhonov_2c13710a:

    # "За поимку маньяка полагается награда. Деньги решили бы проблемы семьи... Мама с папой были бы счастливы."
    "За затрыманне маньяка належыць узнагарода. Грошы вырашылі б праблемы сям'і... Мама з татам былі б шчаслівыя."

# game/scripts/scene/scene_day_5.rpy:11771
translate belarusian event_m_polina_phone_tikhonov_65860a7c:

    # "Я напрягся, судорожно вспоминая номер, который дал мне Тихонов."
    "Я напружыўся, сутаргава ўспамінаючы нумар, які даў мне Ціханаў."

# game/scripts/scene/scene_day_5.rpy:11772
translate belarusian event_m_polina_phone_tikhonov_b14f1834:

    # "Кажется, так. Два-ноль-три..."
    "Здаецца, так. Два-нуль-тры..."

# game/scripts/scene/scene_day_5.rpy:11778
translate belarusian event_m_polina_phone_tikhonov_80979d6a:

    # "В трубке залаяло."
    "У слухаўцы забрахала."

# game/scripts/scene/scene_day_5.rpy:11782
translate belarusian event_m_polina_phone_tikhonov_1696dbac:

    # voice "voice/tihonov/5day/33 Le.ogg"
    # Tikhonov "Лейтенант Тихонов слушает."
    voice "voice/tihonov/5day/33 Le.ogg"
    Tikhonov "Лейтэнант Ціханаў слухае."

# game/scripts/scene/scene_day_5.rpy:11789
translate belarusian event_m_polina_phone_tikhonov_b29f31f3:

    # voice "voice/tihonov/5day/34 Ti.ogg"
    # Tikhonov "Тихо ты, угомонись."
    voice "voice/tihonov/5day/34 Ti.ogg"
    Tikhonov "Ціха ты, суніміся."

# game/scripts/scene/scene_day_5.rpy:11791
translate belarusian event_m_polina_phone_tikhonov_9d36d748:

    # voice "voice/Anton/5day/140 D.ogg"
    # Ant "Добрый вечер, лейтенант."
    voice "voice/Anton/5day/140 D.ogg"
    Ant "Добры вечар, лейтэнант."

# game/scripts/scene/scene_day_5.rpy:11793
translate belarusian event_m_polina_phone_tikhonov_90462d1a:

    # voice "voice/tihonov/5day/35 A.ogg"
    # Tikhonov "А! Петров, кажется. Рад тебя слышать, Петров."
    voice "voice/tihonov/5day/35 A.ogg"
    Tikhonov "А! Пятроў, здаецца. Рады цябе чуць, Пятроў."

# game/scripts/scene/scene_day_5.rpy:11800
translate belarusian event_m_polina_phone_tikhonov_9211c229:

    # voice "voice/tihonov/5day/36 Da.ogg"
    # Tikhonov "Да угомонись, кому говорю."
    voice "voice/tihonov/5day/36 Da.ogg"
    Tikhonov "Ды суніміся, каму кажу."

# game/scripts/scene/scene_day_5.rpy:11802
translate belarusian event_m_polina_phone_tikhonov_992822b0:

    # voice "voice/tihonov/5day/37 Ch.ogg"
    # Tikhonov "Что-то случилось?"
    voice "voice/tihonov/5day/37 Ch.ogg"
    Tikhonov "Нешта здарылася?"

# game/scripts/scene/scene_day_5.rpy:11804
translate belarusian event_m_polina_phone_tikhonov_b6dbae8c:

    # voice "voice/Anton/5day/141 ne.ogg"
    # Ant "Нет... я тут подумал... ведь за помощь в поимке убийцы должны хорошо заплатить?"
    voice "voice/Anton/5day/141 ne.ogg"
    Ant "Не... я тут падумаў... за дапамогу ў затрыманні забойцы павінны ж добра заплаціць?"

# game/scripts/scene/scene_day_5.rpy:11806
translate belarusian event_m_polina_phone_tikhonov_9ee3081a:

    # voice "voice/tihonov/5day/38 Nu.ogg"
    # Tikhonov "Ну как сказать «должны»..."
    voice "voice/tihonov/5day/38 Nu.ogg"
    Tikhonov "Ну як сказаць «павінны»..."

# game/scripts/scene/scene_day_5.rpy:11808
translate belarusian event_m_polina_phone_tikhonov_4b7af91b:

    # voice "voice/tihonov/5day/39 T.ogg"
    # Tikhonov "Ты знаешь, парень, какой у нашего посёлка бюджет? Нам бы автопарк милицейский обновить да решётки на окнах поменять..."
    voice "voice/tihonov/5day/39 T.ogg"
    Tikhonov "Ты ведаеш, хлопец, які ў нашага пасёлка бюджэт? Нам бы аўтапарк міліцэйскі абнавіць ды краты на вокнах памяняць..."

# game/scripts/scene/scene_day_5.rpy:11813
translate belarusian event_m_polina_phone_tikhonov_303e9e92:

    # "Надрывный собачий лай резал слух."
    "Надрыўны сабачы брэх рэзаў слых."

# game/scripts/scene/scene_day_5.rpy:11817
translate belarusian event_m_polina_phone_tikhonov_1b5aa492:

    # voice "voice/tihonov/5day/40 Da.ogg"
    # Tikhonov "Ну что за зверюга такая? Цыц!"
    voice "voice/tihonov/5day/40 Da.ogg"
    Tikhonov "Ну што за звяруга такая? Цыц!"

# game/scripts/scene/scene_day_5.rpy:11819
translate belarusian event_m_polina_phone_tikhonov_062d413c:

    # voice "voice/tihonov/5day/41 Alo.ogg"
    # Tikhonov "Алло."
    voice "voice/tihonov/5day/41 Alo.ogg"
    Tikhonov "Алё."

# game/scripts/scene/scene_day_5.rpy:11821
translate belarusian event_m_polina_phone_tikhonov_9cea0e54:

    # voice "voice/tihonov/5day/42 A.ogg"
    # Tikhonov "А знаешь что... не в деньгах счастье."
    voice "voice/tihonov/5day/42 A.ogg"
    Tikhonov "А ведаеш што... не ў грошах шчасце."

# game/scripts/scene/scene_day_5.rpy:11823
translate belarusian event_m_polina_phone_tikhonov_baae762b:

    # voice "voice/tihonov/5day/43 Ya.ogg"
    # Tikhonov "Я б тебе за помощь устроил попадание на телек. Да, серьёзно. Областное телевидение. Представляешь?"
    voice "voice/tihonov/5day/43 Ya.ogg"
    Tikhonov "Я б табе за дапамогу арганізаваў траплянне на тэлік. Так, сур'ёзна. Абласное тэлебачанне. Уяўляеш?"

# game/scripts/scene/scene_day_5.rpy:11825
translate belarusian event_m_polina_phone_tikhonov_73dd0460:

    # "Я поник. На тэвэ, конечно, хотелось, но как это поможет семье?"
    "Я панік. На ТБ, вядома, хацелася, але як гэта дапаможа сям'і?"

# game/scripts/scene/scene_day_5.rpy:11826
translate belarusian event_m_polina_phone_tikhonov_2d15eadc:

    # "Словно угадав мои мысли, Тихонов продолжил с ещё большим энтузиазмом."
    "Нібы адгадаўшы мае думкі, Ціханаў працягнуў з яшчэ большым энтузіязмам."

# game/scripts/scene/scene_day_5.rpy:11828
translate belarusian event_m_polina_phone_tikhonov_750222f1:

    # voice "voice/tihonov/5day/44 A.ogg"
    # Tikhonov "А хочешь, Петров, я тебе билет лотерейный куплю, «Спортлото»? Наверняка и миллион можно выиграть..."
    voice "voice/tihonov/5day/44 A.ogg"
    Tikhonov "А хочаш, Пятроў, я табе білет латарэйны куплю, «Спортлато»? Напэўна, і мільён можна выйграць..."

# game/scripts/scene/scene_day_5.rpy:11830
translate belarusian event_m_polina_phone_tikhonov_b562bea0:

    # voice "voice/Anton/5day/142 p.ogg"
    # Ant "Понятно..."
    voice "voice/Anton/5day/142 p.ogg"
    Ant "Зразумела..."

# game/scripts/scene/scene_day_5.rpy:11832
translate belarusian event_m_polina_phone_tikhonov_9c9be800:

    # voice "voice/Anton/5day/143 Ne.ogg"
    # Ant "Не надо мне никакого билета..."
    voice "voice/Anton/5day/143 Ne.ogg"
    Ant "Не трэба мне ніякага білета..."

# game/scripts/scene/scene_day_5.rpy:11834
translate belarusian event_m_polina_phone_tikhonov_f43c4fa0:

    # "Я не скрывал разочарования."
    "Я не хаваў расчаравання."

# game/scripts/scene/scene_day_5.rpy:11840
translate belarusian event_m_polina_phone_tikhonov_677b4932:

    # voice "voice/tihonov/5day/45 S.ogg"
    # Tikhonov "Сидеть! Спокойно, псина!"
    voice "voice/tihonov/5day/45 S.ogg"
    Tikhonov "Сядзець! Спакойна, псіна!"

# game/scripts/scene/scene_day_5.rpy:11842
translate belarusian event_m_polina_phone_tikhonov_86924fdb:

    # voice "voice/tihonov/5day/46 Nu.ogg"
    # Tikhonov "Ну ты чего, Петров? Не раскисай. Держи хвост пистолетом, всё же тип-топ, да? А я побегу, дел невпроворот. Звони, если что. Договорились?"
    voice "voice/tihonov/5day/46 Nu.ogg"
    Tikhonov "Ну ты чаго, Пятроў? Не раскісай. Трымай хвост пісталетам, усё ж ціп-топ, так? А я пабягу, спраў процьма. Тэлефануй, калі што. Дамовіліся?"

# game/scripts/scene/scene_day_5.rpy:11844
translate belarusian event_m_polina_phone_tikhonov_7e8ad837:

    # voice "voice/Anton/5day/144 D.ogg"
    # Ant "До свидания."
    voice "voice/Anton/5day/144 D.ogg"
    Ant "Да пабачэння."

# game/scripts/scene/scene_day_5.rpy:11852
translate belarusian event_m_polina_phone_tikhonov_728eb85b:

    # "Я повесил трубку, но лай ещё несколько секунд отзывался в голове."
    "Я паклаў слухаўку, але брэх яшчэ некалькі секунд адгукаўся ў галаве."

# game/scripts/scene/scene_day_5.rpy:11859
translate belarusian event_m_polina_phone_tikhonov_af2cd08b:

    # "Попробую ещё раз. Лучше уж пропуск на телек и лотерейный билет, чем совсем ничего."
    "Паспрабую яшчэ раз. Лепш ужо пропуск на тэлік і латарэйны білет, чым зусім нічога."

# game/scripts/scene/scene_day_5.rpy:11863
translate belarusian event_m_polina_phone_tikhonov_f0bcd46f:

    # "Короткие гудки. С кем разговаривает Тихонов? Что-то случилось в посёлке? Я бросил боязливый взгляд на окно, но темнота и ветер не дали подсказок."
    "Кароткія гудкі. З кім размаўляе Ціханаў? Нешта здарылася ў пасёлку? Я кінуў баязлівы позірк на акно, але цемра і вецер не далі падказак."

# game/scripts/scene/scene_day_5.rpy:11872
translate belarusian event_m_polina_phone_tikhonov_c4c26fe9:

    # "Попытаю счастья. Может, лейтенант уже закончил разговор."
    "Паспрабую шчасця. Можа, лейтэнант ужо скончыў размову."

# game/scripts/scene/scene_day_5.rpy:11877
translate belarusian event_m_polina_phone_tikhonov_a8310c71:

    # Dots "Гав! Гав! Р-Р-Р!"
    Dots "Гаў! Гаў! Р-Р-Р!"

# game/scripts/scene/scene_day_5.rpy:11878
translate belarusian event_m_polina_phone_tikhonov_d777c1fa:

    # "Пёс лаял и рычал мне прямо в ухо. Судя по всему, огромная зверюга. Неужели сама, зубами, сняла трубку?"
    "Пёс брахаў і рыкаў мне проста ў вуха. Мяркуючы па ўсім, вялізная звяруга. Няўжо сама, зубамі, зняла слухаўку?"

# game/scripts/scene/scene_day_5.rpy:11882
translate belarusian event_m_polina_phone_tikhonov_77b1aba7:

    # voice "voice/Anton/5day/145 A.ogg"
    # Ant "Алло! Лейтенант, вы там?"
    voice "voice/Anton/5day/145 A.ogg"
    Ant "Алё! Лейтэнант, вы там?"

# game/scripts/scene/scene_day_5.rpy:11888
translate belarusian event_m_polina_phone_tikhonov_21d58add:

    # Dots "Р-р-р-р-р!"
    Dots "Р-р-р-р-р!"

# game/scripts/scene/scene_day_5.rpy:11889
translate belarusian event_m_polina_phone_tikhonov_a538fee7:

    # "Я собирался прервать звонок."
    "Я збіраўся перапыніць званок."

# game/scripts/scene/scene_day_5.rpy:11893
translate belarusian event_m_polina_phone_tikhonov_628e24c1:

    # voice "voice/tihonov/5day/48 Chu.ogg"
    # Tikhonov "Чую! Чую!"
    voice "voice/tihonov/5day/48 Chu.ogg"
    Tikhonov "Чую! Чую!"

# game/scripts/scene/scene_day_5.rpy:11895
translate belarusian event_m_polina_phone_tikhonov_58ef1325:

    # voice "voice/tihonov/5day/49 Sv.ogg"
    # Tikhonov "Свежая кровь! Молодая сладкая кровь!"
    voice "voice/tihonov/5day/49 Sv.ogg"
    Tikhonov "Свежая кроў! Маладая салодкая кроў!"

# game/scripts/scene/scene_day_5.rpy:11897
translate belarusian event_m_polina_phone_tikhonov_89dee088:

    # voice "voice/tihonov/5day/50 Ti.ogg"
    # Tikhonov "Ты пахнешь жертвой!"
    voice "voice/tihonov/5day/50 Ti.ogg"
    Tikhonov "Ты пахнеш ахвярай!"

# game/scripts/scene/scene_day_5.rpy:11899
translate belarusian event_m_polina_phone_tikhonov_72c1dd50:

    # voice "voice/tihonov/5day/51 Gd.ogg"
    # Tikhonov "Где ты, мальчик? Не вешай трубку, чтобы мы могли выследить тебя!"
    voice "voice/tihonov/5day/51 Gd.ogg"
    Tikhonov "Дзе ты, хлопчык? Не кладзі слухаўку, каб мы маглі высачыць цябе!"

# game/scripts/scene/scene_day_5.rpy:11907
translate belarusian event_m_polina_phone_tikhonov_3d2ce402:

    # "Я стукнул кулаком по пластику «Панасоника»."
    "Я стукнуў кулаком па пластыку «Панасоніка»."

# game/scripts/scene/scene_day_5.rpy:11908
translate belarusian event_m_polina_phone_tikhonov_d50ba1c1:

    # "Офигеть, я правда слышал, как Тихонов рычит и лает, и повторяет какую-то жуткую белиберду?"
    "Афігець, я сапраўды чуў, як Ціханаў рыкае і брэша, і паўтарае нейкую жудасную бязглуздзіцу?"

# game/scripts/scene/scene_day_5.rpy:11909
translate belarusian event_m_polina_phone_tikhonov_99a3bad8:

    # "Нет, это шум в проводах обманул мой слух. Или хуже того — неполадки не на линии, а у меня в мозгах..."
    "Не, гэта шум у правадах падмануў мой слых. Ці горш за тое — непаладкі не на лініі, а ў мяне ў мазгах..."

# game/scripts/scene/scene_day_5.rpy:11920
translate belarusian event_m_polina_phone_fire_dep_bba71faf:

    # voice "voice/episod/po.ogg"
    # FDep "Пожарная часть слушает. Где горит?"
    voice "voice/episod/po.ogg"
    FDep "Пажарная часць слухае. Дзе гарыць?"

# game/scripts/scene/scene_day_5.rpy:11922
translate belarusian event_m_polina_phone_fire_dep_f25ac71f:

    # voice "voice/Anton/5day/146 Oi.ogg"
    # Ant "Ой, я вообще-то в службу газа звонил. Простите."
    voice "voice/Anton/5day/146 Oi.ogg"
    Ant "Ой, я ўвогуле ў службу газу тэлефанаваў. Прабачце."

# game/scripts/scene/scene_day_5.rpy:11926
translate belarusian event_m_polina_phone_fire_dep_aa610650:

    # "Пожарная дружина состоит из добровольцев. Буду им надоедать — вляпаюсь в неприятности."
    "Пажарная дружына складаецца з добраахвотнікаў. Буду ім надакучаць — уляпаюся ў непрыемнасці."

# game/scripts/scene/scene_day_5.rpy:11933
translate belarusian event_m_polina_phone_militia_d64d76f4:

    # voice "voice/episod/milisia.ogg"
    # Militia "Милиция. Что у вас случилось?"
    voice "voice/episod/milisia.ogg"
    Militia "Міліцыя. Што ў вас здарылася?"

# game/scripts/scene/scene_day_5.rpy:11935
translate belarusian event_m_polina_phone_militia_1ce245a8:

    # voice "voice/Anton/5day/147 Ni.ogg"
    # Ant "Ничего, простите. Ошибся цифрой."
    voice "voice/Anton/5day/147 Ni.ogg"
    Ant "Нічога, прабачце. Памыліўся лічбай."

# game/scripts/scene/scene_day_5.rpy:11939
translate belarusian event_m_polina_phone_militia_3ad87d47:

    # "За телефонное хулиганство полагается большой штраф."
    "За тэлефоннае хуліганства належыць вялікі штраф."

# game/scripts/scene/scene_day_5.rpy:11946
translate belarusian event_m_polina_phone_ambulance_5aa79279:

    # voice "voice/episod/skor.ogg"
    # Ambu "Скорая помощь, говорите."
    voice "voice/episod/skor.ogg"
    Ambu "Хуткая дапамога, кажыце."

# game/scripts/scene/scene_day_5.rpy:11948
translate belarusian event_m_polina_phone_ambulance_6d2ee7dd:

    # voice "voice/Anton/5day/148 Iz.ogg"
    # Ant "Извините, я случайно набрал."
    voice "voice/Anton/5day/148 Iz.ogg"
    Ant "Прабачце, я выпадкова набраў."

# game/scripts/scene/scene_day_5.rpy:11951
translate belarusian event_m_polina_phone_ambulance_1b0e87ef:

    # "Не стоит отрывать докторов от работы."
    "Не варта адрываць дактароў ад працы."

# game/scripts/scene/scene_day_5.rpy:11958
translate belarusian event_m_polina_phone_gas_8453cffc:

    # voice "voice/episod/Gaz1.ogg"
    # Gas "Газовая служба, говорите."
    voice "voice/episod/Gaz1.ogg"
    Gas "Газавая служба, кажыце."

